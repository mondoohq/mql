    {
      "pattern": "^https:\\/\\/platform\\.openai\\.com\\/"
    },
    {
      "pattern": "^https:\\/\\/console\\.mistral\\.ai"
    },
    {
      "pattern": "^https:\\/\\/nmap\\.org\\/"
    },
    {
      "pattern": "^https:\\/\\/docs\\.ansible\\.com\\/"
    },
    {
      "pattern": "^https:\\/\\/docs\\.aws\\.amazon\\.com\\/"
    },
    {
      "pattern": "^https:\\/\\/developers\\.zoom\\.us\\/"
    },
    {
