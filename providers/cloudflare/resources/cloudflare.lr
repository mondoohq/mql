	// Requested validity in days
	requestValidity int
	// Time the certificate expires
	expiresAt time
	// Time the certificate was revoked
	revokedAt time
}

// Cloudflare mTLS certificate
//
// CA certificate uploaded to a Cloudflare account for mutual TLS
// authentication, where Cloudflare validates the client certificate a
// connecting device presents against the CA on file. Reviewing these
// certificates surfaces which certificate authorities are trusted for
// client authentication, whether any are self-signed (the ca flag),
// and when each expires so an mTLS enforcement gap can be caught before
// the certificate lapses.
private cloudflare.mtlsCertificate @defaults("name id") {
	// Certificate identifier
	id string
	// Certificate name
	name string
	// Certificate issuer
	issuer string
	// Signature type
	signature string
	// Serial number
	serialNumber string
	// Whether this is a CA certificate
	ca bool
	// Time the certificate was uploaded
	uploadedOn time
	// Time the certificate was last updated
	//
	// Always null. The Cloudflare API response for an mTLS certificate
	// no longer carries a separate last-updated timestamp.
	updatedAt time
	// Time the certificate expires
	expiresAt time
}

// Cloudflare custom hostname
private cloudflare.zone.customHostname @defaults("hostname status") {
	// Custom hostname identifier
	id string
	// The custom hostname
	hostname string
	// Custom origin server
	customOriginServer string
	// Custom origin SNI
	customOriginSni string
	// Custom hostname status
	status string
	// SSL certificate status
	sslStatus string
	// SSL validation method
	sslMethod string
	// SSL certificate type
	sslType string
	// Time the custom hostname was created
	createdAt time
}

// Cloudflare zone logpush job
private cloudflare.zone.logpushJob @defaults("name dataset") {
	// Job identifier
	id int
	// Job name
	name string
	// Dataset being pushed
	dataset string
	// Logpull options string
	logpullOptions string
	// Destination configuration URI
	destinationConf string
	// Push frequency (high, low)
	frequency string
	// Last error message
	errorMessage string
	// Whether the job is enabled
	enabled bool
	// Time of last successful push
	lastComplete time
	// Time of last error
	lastError time
}

// Cloudflare Log Explorer dataset
//
// A log stream Log Explorer retains so it can be queried after the fact.
// `dataset` names the stream, such as `http_requests`, and `objectType`
// reports whether the dataset is scoped to the whole account or to a single
// zone, with `objectId` naming that account or zone. `enabled` reports
// whether the dataset is still ingesting, and `deletionProtection` whether
// it is guarded against removal, which is what keeps retained logs
// available while an investigation is open. `filter` carries the expression
// limiting which entries are kept.
private cloudflare.logExplorerDataset @defaults("dataset objectType enabled deletionProtection") {
	// Dataset identifier
	datasetId string
	// Name of the log stream this dataset retains, such as `http_requests`
	dataset string
	// Whether the dataset is protected against deletion
	deletionProtection bool
	// Whether the dataset is currently ingesting logs
	enabled bool
	// Scope the dataset belongs to
	//
	// One of `account` or `zone`.
	objectType string
	// Identifier of the account or zone the dataset belongs to
	objectId string
	// Zone the dataset is scoped to
	//
	// Null for an account-scoped dataset, and for a zone the calling token
	// cannot list.
	zone() cloudflare.zone
	// Expression limiting which log entries the dataset retains
	//
	// Empty when the dataset retains every entry for its stream.
	filter() string
	// Time the dataset was created
	createdAt time
	// Time the dataset was last updated
	updatedAt time
}

// Cloudflare zone bot management settings
private cloudflare.zone.botManagement {
	// Whether JavaScript detections are enabled
	enableJs bool
	// Whether bot fight mode is enabled
	fightMode bool
	// Action for definitely automated requests (block, managed_challenge, etc.)
	sbfmDefinitelyAutomated string
	// Action for likely automated requests
	sbfmLikelyAutomated string
	// Action for verified bots
	sbfmVerifiedBots string
	// Whether static resource protection is enabled
	sbfmStaticResourceProtection bool
	// Whether WordPress optimization is enabled
	optimizeWordpress bool
	// Whether the model auto-updates
	autoUpdateModel bool
	// Whether the latest model is being used
	usingLatestModel bool
	// AI bots protection setting (block, disabled)
	aiBotsProtection string
}

// Cloudflare account role
//
// Named permission role defined in a Cloudflare account. Roles group the
// privileges that can be granted to account members. Query `name` and
// `description` to review what each role confers during an access review.
private cloudflare.account.role @defaults("name") {
	// Role identifier
	id string
	// Role name
	name string
	// Role description
	description string
}

// Cloudflare account member
//
// User (member) of a Cloudflare account, exposing their identity (`email`,
// `firstName`, `lastName`), enrollment `status` (`accepted`, `pending`,
// `rejected`), whether `twoFactorAuthenticationEnabled` is on, and the
// `roles` they hold. Use for access reviews ("who can administer this
// account?"), 2FA enforcement audits, and stale-invite cleanup.
private cloudflare.account.member @defaults("email status twoFactorAuthenticationEnabled") {
	// Membership identifier
	id string
	// Member status (`accepted`, `pending`, `rejected`)
	status string
	// Member's Cloudflare user identifier
	userId string
	// Member's email address
	email string
	// Member's first name
	firstName string
	// Member's last name
	lastName string
	// Whether the member has two-factor authentication enabled on their Cloudflare account
	twoFactorAuthenticationEnabled bool
	// Roles assigned to this member
	roles []cloudflare.account.role
}

// Cloudflare audit log entry
//
// Single change recorded in the Cloudflare account audit log:
// when it happened, who performed it (`actorEmail`, `actorId`, `actorIp`,
// and `actorType`, one of `user`, `cloudflare_admin`, `account`, and others),
// what resource it affected (`resourceType`, `resourceId`), and the action's
// outcome (`actionType`, `actionResult`). `oldValue` and `newValue`
// hold structured before/after data when the API returns it. Use for
// change-detection assertions and to confirm sensitive actions are
// performed by expected actors.
private cloudflare.account.auditLog @defaults("when actorEmail actionType resourceType") {
	// Audit log entry identifier
	id string
	// Time the action was performed
	when time
	// Email of the actor that performed the action
	actorEmail string
	// Identifier of the actor that performed the action
	actorId string
	// IP address the action was performed from
	actorIp string
	// Actor classification (`user`, `cloudflare_admin`, `account`, etc.)
	actorType string
	// Action name (for example `tls.certificate.add`)
	actionType string
	// Whether the action succeeded
	actionResult bool
	// Identifier of the resource the action was performed on
	resourceId string
	// Type of the resource the action was performed on (for example `zone`, `account_member`, `dns_record`)
	resourceType string
	// Identifier of the account that owns the audit log entry
	ownerId string
	// Structured before-state of the affected resource (empty when the API does not return it)
	oldValue dict
	// Structured after-state of the affected resource (empty when the API does not return it)
	newValue dict
}

// Cloudflare notification policy
//
// Single notification (alert) policy configured on a Cloudflare
// account: which `alertType` it subscribes to (for example
// `dedicated_ssl_certificate_expiration_type`,
// `universal_ssl_event_type`, `web_analytics_metrics_update`, `dos_attack_l7`),
// whether it is `enabled`, how alerts are delivered via `mechanisms`
// (email, PagerDuty, webhook integrations), and any `conditions` or
// `filters` that narrow the firing criteria. Query it to assert that
// critical alerts (TLS expiry, DDoS, mTLS revocation, configuration
// changes) are wired up to an active destination.
private cloudflare.notificationPolicy @defaults("name alertType enabled") {
	// Policy identifier
	id string
	// Policy display name
	name string
	// Policy description
	description string
	// Whether the policy is currently active
	enabled bool
	// Alert type the policy subscribes to (see the Cloudflare Notifications API for the full enum)
	alertType string
	// Delivery destinations grouped by mechanism
	//
	// Keyed by mechanism name (`email`, `pagerduty`, `webhooks`); each
	// value is the list of configured integrations for that mechanism,
	// where each integration is an object with `id` and `name`.
	mechanisms dict
	// Conditions further narrowing when the alert fires (shape depends on `alertType`)
	conditions dict
	// Filters further scoping which entities the alert applies to (shape depends on `alertType`)
	filters dict
	// Time the policy was created
	created time
	// Time the policy was last modified
	modified time
}

// Cloudflare zone DNSSEC configuration
private cloudflare.zone.dnssec @defaults("status algorithm") {
	// DNSSEC status (active, disabled, pending)
	status string
	// DNSKEY flags
	flags int
	// DNSKEY algorithm
	algorithm string
	// DNSKEY key type
	keyType string
	// DS digest type
	digestType string
	// DS digest algorithm
	digestAlgorithm string
	// DS digest hex value
	digest string
	// DS resource record (parent-zone-ready string)
	ds string
	// DNSKEY key tag
	keyTag int
	// DNSKEY public key
	publicKey string
	// Time the configuration was last modified
	modifiedOn time
}

// Cloudflare zone rate-limit rule (legacy rate-limiting product)
private cloudflare.zone.rateLimitRule @defaults("id action.mode threshold") {
	// Rule identifier
	id string
	// Rule description
	description string
	// Whether the rule is disabled
	disabled bool
	// Number of requests allowed within `period` before the action triggers
	threshold int
	// Window over which `threshold` is measured (seconds)
	period int
	// Action taken when the threshold is exceeded ({mode, timeout, response})
	action dict
	// Request URL pattern matched by this rule
	urlPattern string
	// HTTP methods matched by this rule
	methods []string
	// HTTP schemes matched by this rule (HTTP, HTTPS, _ALL_)
	schemes []string
	// Origin response status codes matched by this rule
	responseStatuses []int
}

// Cloudflare zone WAF rule (a single rule from a managed or custom ruleset)
private cloudflare.zone.wafRule @defaults("rulesetKind action description") {
	// Rule identifier
	id string
	// Ruleset this rule belongs to
	rulesetId string
	// Ruleset name
	rulesetName string
	// Ruleset kind (managed, custom, root, zone)
	rulesetKind string
	// Ruleset phase (e.g., http_request_firewall_managed, http_request_firewall_custom)
	rulesetPhase string
	// Action (block, challenge, managed_challenge, log, skip, etc.)
	action string
	// Filter expression
	expression string
	// Rule description
	description string
	// Rule reference tag
	ref string
	// Whether the rule is enabled
	enabled bool
	// Score threshold for the rule (managed rulesets)
	scoreThreshold int
	// Rule version
	version string
	// Time the rule was last updated
	lastUpdated time

	// Whether a match on this rule is written to the security event log
	//
	// Null when the rule carries no logging block, which the API omits for
	// rules where logging is not configurable. False means matches leave no
	// entry in Security Events, so a block or a skip happens with no
	// forensic trail behind it.
	loggingEnabled bool

	// Action the override substitutes for every rule of the deployed managed ruleset
	//
	// Set when the rule deploys a managed ruleset and overrides the action of
	// every rule inside it, for example rewriting block to log so the ruleset
	// still matches but no longer stops anything. Empty when the deployment
	// carries no ruleset-wide action override.
	overrideAction string

	// Whether the override turns the deployed managed ruleset on or off as a whole
	//
	// False disables every rule of the managed ruleset while the deployment
	// rule itself still reads enabled, which is one of the commonest ways a
	// WAF is left in place but stops enforcing. Null when the deployment
	// carries no ruleset-wide enable override.
	overrideEnabled bool

	// Sensitivity level the override applies to the deployed managed ruleset
	//
	// One of default, low, medium, high, or eoff. The value eoff turns the
	// managed ruleset's detections off entirely.
	overrideSensitivityLevel string

	// Overrides applied to individual rules of the deployed managed ruleset
	//
	// Each entry names one rule of the managed ruleset and the action,
	// enablement, score threshold, or sensitivity substituted for it. A rule
	// disabled here no longer runs even though the managed ruleset it belongs
	// to is deployed and enabled.
	overriddenRules []cloudflare.zone.wafRule.override

	// Overrides applied to whole categories of the deployed managed ruleset
	//
	// Each entry names one rule category (for example wordpress or joomla)
	// and the action or enablement substituted for every rule tagged with it.
	overriddenCategories []cloudflare.zone.wafRule.categoryOverride

	// Phases a skip rule bypasses
	//
	// Set only on rules whose action is skip. Each entry names a ruleset
	// phase (for example http_request_firewall_managed or http_ratelimit)
	// that is not evaluated at all for a matching request.
	skipPhases []string

	// Security products a skip rule bypasses
	//
	// Set only on rules whose action is skip. Values include waf, uaBlock,
	// bic, hot, securityLevel, rateLimit, and zoneLockdown. A skip rule
	// naming waf turns the whole Web Application Firewall off for every
	// request its expression matches.
	skipProducts []string

	// Managed rulesets a skip rule bypasses in full
	//
	// Set only on rules whose action is skip, and carries the identifiers of
	// the managed rulesets that are skipped in their entirety.
	skipRulesets []string

	// Individual managed rules a skip rule bypasses
	//
	// Set only on rules whose action is skip. The dict maps a managed ruleset
	// identifier to the list of rule identifiers within it that are skipped.
	skipRules dict

	// Requests allowed per counting period before mitigation starts
	//
	// Null on rules that carry no rate-limit configuration. Together with
	// rateLimitPeriod this is the threshold a rate-limit rule enforces.
	rateLimitRequestsPerPeriod int

	// Rate-limit counting window in seconds
	//
	// One of 10, 60, 600, 3600, or 86400. Null on rules that carry no
	// rate-limit configuration.
	rateLimitPeriod int

	// Fields the rate-limit counter groups requests by
	//
	// For example ip.src or cf.colo.id. A counter keyed on a field an
	// attacker controls, or keyed so broadly that unrelated clients share a
	// bucket, does not hold in practice.
	rateLimitCharacteristics []string

	// Seconds a rate-limit mitigation stays in force once the threshold is crossed
	//
	// Null on rules that carry no rate-limit configuration.
	rateLimitMitigationTimeout int

	// Expression selecting which requests the rate-limit counter counts
	//
	// When set, requests are counted only while this expression matches, which
	// can be narrower than the rule's own expression. Empty when the rule
	// counts every request it matches.
	rateLimitCountingExpression string

	// Whether the rate limit counts only requests that reached the origin
	//
	// True means cached responses are not counted, so the threshold applies to
	// origin load rather than to total request volume. Null on rules that carry
	// no rate-limit configuration.
	rateLimitRequestsToOrigin bool
}

// Override applied to one rule of a deployed managed ruleset
//
// Substitution the deploying rule makes for a single rule of the managed
// ruleset it deploys, selected by `ruleId`. A managed ruleset can be deployed
// and enabled while individual rules inside it are turned off or downgraded to
// log through these entries, so the ruleset reads as active while specific
// detections no longer stop anything.
private cloudflare.zone.wafRule.override @defaults("ruleId action enabled") {
	// Identifier of the managed rule this override applies to
	ruleId string
	// Action substituted for the rule
	//
	// For example block, log, challenge, or managed_challenge. Empty when the
	// override changes only the rule's enablement or scoring.
	action string
	// Whether the rule is turned on
	//
	// False takes the rule out of evaluation entirely. Null when the override
	// changes only the action, score threshold, or sensitivity.
	enabled bool
	// Score threshold substituted for the rule
	//
	// Null when the override does not change scoring. A raised threshold
	// makes the rule match less often.
	scoreThreshold int
	// Sensitivity level substituted for the rule
	//
	// One of default, low, medium, high, or eoff. The value eoff turns the
	// rule's detections off entirely. Empty when the override does not change
	// sensitivity.
	sensitivityLevel string
	// Rule status reported alongside the override
	sensitivityStatus string
}

// Override applied to one category of a deployed managed ruleset
//
// Substitution the deploying rule makes for every rule of the managed ruleset
// tagged with a given category, selected by `category`. Disabling a category
// removes a whole class of detections while the managed ruleset itself stays
// deployed.
private cloudflare.zone.wafRule.categoryOverride @defaults("category action enabled") {
	// Rule category this override applies to
	//
	// For example wordpress, joomla, or drupal.
	category string
	// Action substituted for every rule in the category
	//
	// Empty when the override changes only enablement.
	action string
	// Whether the rules in the category are turned on
	//
	// False removes every rule of the category from evaluation. Null when the
	// override changes only the action.
	enabled bool
}

// IP Access rule
//
// Rule evaluated ahead of the WAF that matches a request by its source: a single
// IP, an IP range, an autonomous system number, or a country. The `mode` field
// carries the verdict. The dangerous value is `whitelist`: a source allowed
// there bypasses the WAF, rate limiting, and the zone's security level entirely,
// so a stale allowlist entry for an office range or a cloud provider's ASN is an
// unfiltered path to the origin. Rules exist at both zone and account scope, and
// `scopeType` reports which one a rule came from.
private cloudflare.ipAccessRule @defaults("mode target value notes") {
	// Rule identifier
	id string
	// Action applied to a matching request
	//
	// One of block, challenge, whitelist, js_challenge, or managed_challenge.
	// The value whitelist exempts the source from the WAF, rate limiting, and
	// the security level rather than allowing it through a single check.
	mode string
	// What the rule matches on
	//
	// One of ip, ip6, ip_range, asn, or country.
	target string
	// Value matched against the request source
	//
	// An IP address, a CIDR range, an AS number, or a two-letter ISO-3166-1
	// alpha-2 country code, according to `target`.
	value string
	// Summary recorded with the rule
	notes string
	// Scope the rule was defined at
	//
	// Either user or organization. An organization rule is defined on the
	// account and applies to every zone it owns.
	scopeType string
	// Actions the rule is allowed to take
	allowedModes []string
	// Time the rule was created
	createdOn time
	// Time the rule was last modified
	modifiedOn time
}

// Zone Lockdown rule
//
// Rule restricting a set of URLs to named IP addresses and ranges, used to pin
// administrative paths such as /wp-admin or a staging host to office addresses.
// A lockdown with `paused` true is defined but not enforced, and a
// `configurations` list that has drifted from the addresses actually in use
// leaves the URLs in `urls` reachable from anywhere with no other signal that
// anything changed.
private cloudflare.zone.lockdown @defaults("description paused urls") {
	// Lockdown rule identifier
	id string
	// Summary recorded with the rule
	description string
	// Whether the rule is defined but not enforced
	//
	// True means the URLs are open to every source while the rule stays in
	// the configuration looking like a control.
	paused bool
	// URL patterns the rule restricts
	//
	// Simple wildcard patterns, for example `example.com/wp-admin*`.
	urls []string
	// Addresses permitted to reach the restricted URLs
	//
	// Each entry is `{target, value}`, where `target` is `ip` or `ip_range`
	// and `value` is the address or CIDR block.
	configurations []dict
	// Time the rule was created
	createdOn time
	// Time the rule was last modified
	modifiedOn time
}

// Registrar hold on a zone
//
// Hold that stops the zone from being added to any Cloudflare account after it
// is removed from this one. Without a hold, deleting a zone frees the domain for
// anyone to re-add and start serving, which is the standard takeover path for a
// Cloudflare-fronted domain. Reported as null when the hold state cannot be
// read, so an unreadable zone is never reported as one with no hold.
private cloudflare.zone.hold @defaults("enabled includeSubdomains") {
	// Whether a hold is in force on the zone
	enabled bool
	// Time the hold takes effect
	//
	// Null when the hold is already in force or none is scheduled. A hold with
	// a future date is not protecting the zone yet.
	holdAfter time
	// Whether the hold also covers subdomains of the zone
	//
	// Reported as the API does, a string rather than a boolean. Without it a
	// hold on the apex still leaves every subdomain free to be claimed in
	// another account.
	includeSubdomains string
}

// Cloudflare email-routing configuration
private cloudflare.zone.emailRouting @defaults("enabled status") {
	// Whether email routing is enabled for the zone
	enabled bool
	// Email routing status (ready, unconfigured, misconfigured, etc.)
	status string
	// Email routing display name
	name string
	// Time the configuration was created
	createdAt time
	// Time the configuration was last modified
	modifiedAt time
	// Suggested DNS records (MX, SPF/TXT, DKIM/TXT, DMARC) required for email-routing configuration
	dnsRecords() []dict
	// Whether at least one MX record consistent with email-routing is in place
	mxConfigured() bool
	// Whether an SPF (TXT v=spf1) record consistent with email-routing is in place
	spfConfigured() bool
	// Whether a DMARC (TXT v=DMARC1) record is published for the zone
	dmarcConfigured() bool
}

// Cloudflare Workers script secret
//
// Secret binding attached to a Workers script, selected by script name and
// secret name. Metadata only: the name and secret type are exposed, never the
// value, since Cloudflare's API never returns secret values. Useful for
// inventorying which secrets each script depends on.
private cloudflare.workers.secret @defaults("scriptName name") {
	// Worker script name
	scriptName string
	// Secret name (binding identifier)
	name string
	// Secret type (e.g., secret_text)
	secretType string
}

// Cloudflare Pages environment variable (metadata only; values are intentionally not exposed)
private cloudflare.pages.envVar @defaults("projectName environment name type") {
	// Pages project name
	projectName string
	// Environment (preview, production)
	environment string
	// Variable name
	name string
	// Variable type (plain_text, secret_text)
	type string
}

// Zone client certificate
//
// Certificate issued by Cloudflare's managed certificate authority for mTLS
// authentication of clients connecting to the zone. The `status` field
// reports whether the certificate is active or revoked, with
// pending_reactivation and pending_revocation marking in-progress
// transitions, and `expiresOn` bounds its validity. The certificate signing
// request subject fields record who the certificate was issued to, and
// `fingerprintSha256` identifies it uniquely. The private key and signing
// request are never exposed.
private cloudflare.zone.clientCertificate @defaults("commonName status expiresOn") {
	// Certificate identifier
	id string
	// Common name of the client certificate
	commonName string
	// Certificate status
	//
	// One of active, pending_reactivation, pending_revocation, or revoked.
	status string
	// Date the certificate was issued by the certificate authority
	issuedOn time
	// Date the certificate expires
	expiresOn time
	// Number of days the certificate stays valid after its issue date
	validityDays int
	// SHA-256 fingerprint of the certificate
	fingerprintSha256 string
	// Serial number on the certificate
	serialNumber string
	// Type of hash used for the certificate
	signature string
	// Subject key identifier
	ski string
	// Identifier of the certificate authority that issued the certificate
	certificateAuthorityId string
	// Name of the certificate authority that issued the certificate
	certificateAuthorityName string
	// Country from the certificate signing request
	country string
	// State from the certificate signing request
	state string
	// Location from the certificate signing request
	location string
	// Organization from the certificate signing request
	organization string
	// Organizational unit from the certificate signing request
	organizationalUnit string
}

// Authenticated origin pulls
//
// Configuration for the mTLS handshake Cloudflare performs when connecting to
// the zone's origin, which proves to the origin that a request arrived
// through Cloudflare rather than directly from the internet. The `enabled`
// field reports whether zone-wide enforcement is on, `certificates` lists the
// zone-level certificates Cloudflare presents, `hostnames` covers per-hostname
// enforcement that overrides the zone-wide setting, and `hostnameCertificates`
// lists the certificates available for those per-hostname bindings.
private cloudflare.zone.authenticatedOriginPulls @defaults("enabled") {
	// Whether zone-level authenticated origin pulls is enabled
	enabled bool
	// Zone-level certificates Cloudflare presents to the origin
	certificates() []cloudflare.zone.authenticatedOriginPulls.certificate
	// Per-hostname authenticated origin pull bindings
	hostnames() []cloudflare.zone.authenticatedOriginPulls.hostname
	// Certificates available for per-hostname authenticated origin pulls
	hostnameCertificates() []cloudflare.zone.authenticatedOriginPulls.hostnameCertificate
}

// Zone-level authenticated origin pull certificate
//
// Certificate Cloudflare presents to the origin for every host in the zone.
// The `status` field reports where the certificate sits in its activation
// lifecycle and `expiresOn` bounds its validity, so a review can catch a
// certificate about to lapse and break origin connectivity.
private cloudflare.zone.authenticatedOriginPulls.certificate @defaults("id status expiresOn") {
	// Certificate identifier
	id string
	// Whether this certificate is enabled for the zone
	enabled bool
	// Certificate authority that issued the certificate
	issuer string
	// Type of hash used for the certificate
	signature string
	// Status of the certificate activation
	status string
	// Date the certificate expires
	expiresOn time
	// Time the certificate was uploaded
	uploadedOn time
}

// Per-hostname authenticated origin pull binding
//
// Binding between one origin hostname and the certificate Cloudflare presents
// when connecting to it, which overrides the zone-wide setting. The `enabled`
// field reports whether enforcement is active for that hostname, so a zone
// with zone-level enforcement on can still have individual hostnames opted
// out. The `hostname` field names the origin host, and `certificate` resolves
// the bound certificate.
private cloudflare.zone.authenticatedOriginPulls.hostname @defaults("hostname enabled status") {
	// Origin hostname the certificate is used for
	hostname string
	// Whether hostname-level authenticated origin pulls is enabled
	enabled bool
	// Certificate bound to this hostname
	certificate() cloudflare.zone.authenticatedOriginPulls.hostnameCertificate
	// Status of the binding
	status string
	// Status of the bound certificate
	certStatus string
	// Certificate authority that issued the certificate
	issuer string
	// Serial number on the uploaded certificate
	serialNumber string
	// Type of hash used for the certificate
	signature string
	// Date the certificate expires
	expiresOn time
	// Time the certificate was uploaded
	certUploadedOn time
	// Time the certificate was last updated
	certUpdatedAt time
	// Time the binding was created
	createdAt time
	// Time the binding was last updated
	updatedAt time
}

// Certificate for per-hostname authenticated origin pulls
//
// Certificate available for binding to individual origin hostnames. Listing
// these alongside the hostname bindings surfaces certificates that were
// uploaded but never bound, and reports `expiresOn` and `status` for the ones
// in use.
private cloudflare.zone.authenticatedOriginPulls.hostnameCertificate @defaults("id status expiresOn") {
	// Certificate identifier
	id string
	// Certificate authority that issued the certificate
	issuer string
	// Serial number on the uploaded certificate
	serialNumber string
	// Type of hash used for the certificate
	signature string
	// Status of the certificate
	status string
	// Date the certificate expires
	expiresOn time
	// Time the certificate was uploaded
	uploadedOn time
}

// Leaked credential checks
//
// Detection of credentials that appear in known breach corpora as they pass
// through the zone, which lets a ruleset act on the request before it reaches
// the origin. The `enabled` field reports whether the feature is switched on,
// and `detections` lists the custom expressions that tell Cloudflare where
// usernames and passwords live in request bodies it cannot parse on its own.
private cloudflare.zone.leakedCredentialChecks @defaults("enabled") {
	// Whether leaked credential checks are enabled for the zone
	enabled bool
	// Custom detection expressions
	detections() []cloudflare.zone.leakedCredentialChecks.detection
}

// Leaked credential check custom detection
//
// Pair of ruleset expressions that locate the username and password in a
// request whose shape Cloudflare cannot infer. The `username` and `password`
// fields hold the expressions themselves, never credential values.
private cloudflare.zone.leakedCredentialChecks.detection @defaults("id") {
	// Detection identifier
	id string
	// Ruleset expression matching the username in a request
	username string
	// Ruleset expression matching the password in a request
	password string
}

// Content scanning
//
// Scanning of files uploaded through the zone for malicious content, which
// lets a ruleset block a request carrying a detected object before it reaches
// the origin. The `enabled` field reports whether scanning is switched on,
// `modified` records when that status last changed, and `payloads` lists the
// custom expressions that point the scanner at content objects in request
// bodies it cannot parse on its own.
private cloudflare.zone.contentScanning @defaults("enabled") {
	// Whether content scanning is enabled for the zone
	enabled bool
	// Time the content scanning status last changed
	modified time
	// Custom scan expressions
	payloads() []cloudflare.zone.contentScanning.payload
}

// Content scanning custom expression
//
// Ruleset expression that tells the scanner where to find content objects in
// a request body Cloudflare cannot parse on its own.
private cloudflare.zone.contentScanning.payload @defaults("id payload") {
	// Expression identifier
	id string
	// Ruleset expression matching content objects in a request
	payload string
}

// AI Security for Apps
//
// Inspection of prompts and responses passing through the zone, which lets
// Cloudflare classify model traffic by topic and act on it before it reaches
// an application. The enabled field reports whether that inspection runs at
// all, so a zone fronting an AI application with it switched off is passing
// prompts through unexamined. The customTopics collection carries the
// site-specific categories added on top of the built-in ones.
private cloudflare.zone.aiSecurity @defaults("enabled") {
	// Whether AI Security for Apps is enabled on the zone
	enabled bool
	// Site-specific topic categories used for content detection
	customTopics() []cloudflare.zone.aiSecurity.customTopic
}

// AI Security custom topic category
//
// A site-specific category AI Security matches prompt and response content
// against, in addition to the built-in categories. The label selects the topic
// and the topic field carries the description the classifier matches on.
private cloudflare.zone.aiSecurity.customTopic @defaults("label topic") {
	// Unique label identifying the topic category
	label string
	// Description of the content the category matches
	topic string
}

// Crawler directives for the zone
//
// The zone's robots.txt as Cloudflare fetched and parsed it, which is what
// governs whether AI crawlers may read the site and whether its content may be
// used for model training. The robotsStatus field carries the HTTP status of
// the fetch, so a zone serving no robots.txt at all is visible as a status
// rather than as an empty rule set, and userAgents lists the parsed rules per
// crawler.
private cloudflare.zone.aiAudit @defaults("robotsStatus") {
	// HTTP status Cloudflare received fetching the zone's robots.txt
	//
	// 200 when a file was served. A 404 means the zone publishes no robots.txt,
	// which leaves every crawler undirected rather than denied.
	robotsStatus int
	// Sitemap URLs advertised in robots.txt
	sitemaps []string
	// Parsed directives, one entry per user agent named in robots.txt
	userAgents() []cloudflare.zone.aiAudit.userAgent
}

// Crawler directives for one user agent
//
// The robots.txt rules that apply to a single named crawler, selected by
// userAgent. Covers the allowed and disallowed path patterns, the requested
// crawl delay, and the content signals that state whether the site permits its
// content to be used for AI training, as AI input, or for search indexing.
private cloudflare.zone.aiAudit.userAgent @defaults("userAgent") {
	// User agent string the directives apply to, or * for the default rules
	userAgent string
	// Path patterns the crawler is allowed to fetch
	allow []string
	// Path patterns the crawler is told not to fetch
	disallow []string
	// Seconds the crawler is asked to wait between requests, 0 when unset
	crawlDelay float
	// Whether the site permits its content to be used for AI training
	//
	// Carries the ai-train content signal, empty when robots.txt states none.
	contentSignalAiTrain string
	// Whether the site permits its content to be used as AI input
	//
	// Carries the ai-input content signal, which covers retrieval and grounding
	// rather than training. Empty when robots.txt states none.
	contentSignalAiInput string
	// Whether the site permits its content to be indexed for search
	//
	// Carries the search content signal, empty when robots.txt states none.
	contentSignalSearch string
}

// Cloudflare Precursor enforcement for a zone
//
// Enforcement posture Precursor applies to requests arriving at the zone.
// `defaultMode` is the mode used for any request that matches no rule:
// `off` disables enforcement entirely, `min-friction` favors letting
// visitors through, and `max-security` favors challenging or blocking them.
// `enforcementRules` is the ordered list of overrides evaluated ahead of
// that default. Use it to find zones left with enforcement off, or rules
// that relax the posture for a subset of traffic.
private cloudflare.zone.precursor @defaults("defaultMode") {
	// Enforcement mode applied to requests matching no enforcement rule
	//
	// One of `off`, `min-friction`, or `max-security`.
	defaultMode string
	// Ordered list of rules that override the default enforcement mode
	//
	// Empty when the zone relies on `defaultMode` alone. Cloudflare
	// evaluates the rules in the order returned.
	enforcementRules []cloudflare.zone.precursor.enforcementRule
}

// Cloudflare Precursor enforcement rule
//
// A single override in a zone's Precursor rule list. `expression` is the
// filter that decides which requests the rule matches and `mode` is the
// enforcement applied to them. `enabled` reports whether the rule is
// evaluated at all, so a rule that appears to tighten the posture may be
// inert.
private cloudflare.zone.precursor.enforcementRule @defaults("mode expression enabled") {
	// Rule identifier assigned by Cloudflare
	id string
	// Filter expression deciding which requests the rule matches
	expression string
	// Enforcement mode applied to matching requests
	//
	// One of `min-friction` or `max-security`. Unlike the zone-level
	// `defaultMode`, a rule cannot set `off`.
	mode string
	// Description of the rule (empty when none was provided)
	description string
	// Whether the rule is currently evaluated
	enabled bool
}

// Vulnerability disclosure policy (security.txt)
//
// Contents of the security.txt file Cloudflare serves at
// /.well-known/security.txt for the zone, which tells researchers how to
// report a vulnerability. The `enabled` field reports whether the file is
// published at all, `contact` carries the reporting channels, and `expires`
// marks the date after which the published policy should no longer be
// trusted.
private cloudflare.zone.securityTxt @defaults("enabled expires") {
	// Whether a security.txt file is published for the zone
	enabled bool
	// Channels for reporting a vulnerability
	contact []string
	// Date after which the published policy is no longer valid
	expires time
	// Links to keys for encrypting vulnerability reports
	encryption []string
	// Links acknowledging researchers who reported vulnerabilities
	acknowledgments []string
	// Canonical URIs the security.txt file is served from
	canonical []string
	// Links to the zone's vulnerability disclosure policy
	policy []string
	// Links to security-related job openings
	hiring []string
	// Preferred languages for vulnerability reports
	preferredLanguages string
}

// Turnstile widget
//
// Challenge widget that stands in for a CAPTCHA on a site's forms and login
// pages. The `mode` field decides how much friction a visitor sees, `domains`
// bounds where the widget may be embedded, and `clearanceLevel` sets the
// challenge a visitor must pass to earn clearance when the widget sits on a
// Cloudflare-proxied site. The widget's secret key is not exposed.
private cloudflare.turnstile.widget @defaults("name mode sitekey") {
	// Widget identifier tag, embedded in the page as the site key
	sitekey string
	// Widget name
	name string
	// Widget mode
	//
	// One of managed, non-interactive, or invisible.
	mode string
	// Region where the widget can be used
	//
	// Either world or china. This cannot be changed after creation.
	region string
	// Clearance level granted when the widget sits on a Cloudflare-proxied site
	//
	// One of no_clearance, jschallenge, managed, or interactive.
	clearanceLevel string
	// Domains the widget may be embedded on
	domains []string
	// Whether Cloudflare issues computationally expensive challenges to malicious bots
	botFightMode bool
	// Whether the ephemeral ID is returned in siteverify responses
	ephemeralIdEnabled bool
	// Whether Cloudflare branding is hidden on the widget
	offlabel bool
	// Time the widget was created
	createdOn time
	// Time the widget was last modified
	modifiedOn time
}
