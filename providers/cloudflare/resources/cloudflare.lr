	// Ruleset name
	name string
	// Ruleset description
	description string
	// Ruleset kind (managed, root, zone, custom)
	kind string
	// Ruleset phase (http_request_firewall_managed, etc.)
	phase string
	// Ruleset version
	version string
	// Time the ruleset was last updated
	updatedAt time
}

// Cloudflare zone page rule
private cloudflare.zone.pageRule @defaults("id status") {
	// Page rule identifier
	id string
	// Page rule status (active, disabled)
	status string
	// Page rule priority
	priority int
	// Time the page rule was created
	createdAt time
	// Time the page rule was last modified
	updatedAt time
}

// Cloudflare load balancer
//
// Traffic director that steers requests for a hostname across one or more
// origin pools. The `steeringPolicy` selects which pool serves a request,
// `proxied` and `enabled` give its serving state, and session affinity
// configuration controls stickiness. The `fallbackPool`, `defaultPools`,
// and `pools` references resolve the backing pools, while `regionPools`,
// `popPools`, and `countryPools` hold the geo-steering maps of pool IDs.
private cloudflare.zone.loadBalancer @defaults("name steeringPolicy enabled") {
	// Load balancer identifier
	id string
	// DNS hostname the load balancer answers for
	name string
	// Description
	description string
	// Whether the load balancer is enabled
	enabled bool
	// Whether traffic is proxied through Cloudflare (orange-cloud)
	proxied bool
	// DNS record TTL, in seconds (ignored when proxied)
	ttl int
	// Pool selection logic (off, geo, dynamic_latency, random, proximity, least_outstanding_requests, least_connections)
	steeringPolicy string
	// Pool used when no other pool is healthy
	fallbackPool() cloudflare.loadBalancerPool
	// Pools used in the default (non-geo) ordering
	defaultPools() []cloudflare.loadBalancerPool
	// Every distinct pool the load balancer references (default, fallback, and geo)
	pools() []cloudflare.loadBalancerPool
	// Pool IDs keyed by region code, used under geo steering
	regionPools dict
	// Pool IDs keyed by Cloudflare PoP, used under geo steering
	popPools dict
	// Pool IDs keyed by country code, used under geo steering
	countryPools dict
	// Session affinity mode (none, cookie, ip_cookie, header)
	sessionAffinity string
	// Session affinity TTL, in seconds
	sessionAffinityTtl int
	// Session affinity cookie attributes (samesite, secure, drain_duration, zero_downtime_failover, headers, require_all_headers)
	sessionAffinityAttributes dict
	// Time the load balancer was created
	createdOn time
	// Time the load balancer was last modified
	modifiedOn time
}

// Cloudflare load balancer pool
//
// Named group of origin servers that a load balancer steers traffic
// to. The `origins` list gives each backend `address`, weight, and
// enabled state; `monitorId` and `checkRegions` describe the health
// checks; `minimumOrigins` is the healthy-origin floor below which the
// pool is considered down; `notificationEmail` receives health alerts;
// and `latitude`/`longitude` position the pool for proximity steering.
// Pools are account-scoped and may be shared by several load
// balancers.
private cloudflare.loadBalancerPool @defaults("name enabled") {
	// Pool identifier
	id string
	// Pool name
	name string
	// Description
	description string
	// Whether the pool is enabled
	enabled bool
	// Minimum number of healthy origins before the pool is considered healthy
	minimumOrigins int
	// ID of the monitor that health-checks the pool's origins
	monitorId string
	// Email address notified when the pool's health changes
	notificationEmail string
	// Origin servers in the pool (each dict: name, address, enabled, weight, virtualNetworkId)
	origins []dict
	// Regions health checks are run from; empty means all regions
	checkRegions []string
	// Latitude used for proximity steering
	latitude float
	// Longitude used for proximity steering
	longitude float
	// Time the pool was created
	createdOn time
	// Time the pool was last modified
	modifiedOn time
}

// Cloudflare origin CA certificate
private cloudflare.zone.originCACertificate @defaults("id requestType") {
	// Certificate identifier
	id string
	// Hostnames covered by the certificate
