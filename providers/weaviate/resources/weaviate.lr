import core

option provider = "go.mondoo.com/mql/providers/weaviate"
option go_package = "go.mondoo.com/mql/providers/weaviate/resources"
option root = "weaviate.instance"


// Weaviate server
//
// Server-wide configuration and security posture: version, enabled modules,
// whether anonymous access is allowed, and whether OpenID Connect and
// role-based access control are enabled. Collections, roles, users, and
// cluster nodes are reached from here.
weaviate.instance @defaults("version rbacEnabled anonymousAccessEnabled") @root {
  // Server version, for example "1.38.8"
  version @maturity("deprecated") @replaced_by("asset.version") string
  // Hostname the server reports for itself
  hostname string
  // Names of the enabled modules, for example "text2vec-openai"
  modules []string
  // Whether unauthenticated requests are accepted
  //
  // True when the server answers an unauthenticated request, meaning any
  // client that can reach the network endpoint reads data without
  // credentials.
  anonymousAccessEnabled bool
  // Whether OpenID Connect authentication is configured
  oidcEnabled bool
  // OIDC issuer discovery URL, when OIDC is configured
  oidcIssuer string
  // OIDC client id, when OIDC is configured
  oidcClientId string
  // Whether role-based access control is enabled
  rbacEnabled bool
  // Collections (classes) defined on the server
  collections() []weaviate.collection
  // Roles defined on the server
  roles() []weaviate.role
  // Database-managed users known to the server
  //
  // Only database-managed users are listed. Users authenticated through OIDC
  // are not enumerated here and appear only in role assignments.
  users() []weaviate.user
  // Identity-provider groups the server holds role assignments for
  //
  // Groups reach the server through OpenID Connect. A server without it
  // reports no groups.
  groups() []weaviate.group
  // Cluster nodes backing the server
  nodes() []weaviate.node
  // Backups held by every enabled backup backend
  //
  // A backend is enabled by a backup module such as backup-s3 or
  // backup-filesystem. A server with no backup module reports no backups.
  backups() []weaviate.backup
  // Aliases defined on the server, each naming the collection it points to
  aliases() []weaviate.alias
}

// Weaviate backup
//
// A backup held by one backup backend: its status, when it started and
// completed, its size, and the collections it contains. The id and backend
// fields select the backup, for example
// weaviate.instance.backups.where(backend == "s3" && status == "FAILED").
weaviate.backup @defaults("id backend status") {
  // Backup identifier
  id string
  // Backend that holds the backup, for example "s3", "gcs", "azure", or "filesystem"
  backend string
  // Backup status
  //
  // One of STARTED, TRANSFERRING, TRANSFERRED, FINALIZING, SUCCESS, FAILED,
  // CANCELLING, or CANCELED. A status added to the server later is reported
  // as the server names it.
  status string
  // When the backup started
  startedAt time
  // When the backup completed, successfully or not
  //
  // Null while the backup is still running.
  completedAt time
  // Size of the backup in GiB
  //
  // Null when the server reports no size.
  sizeGiB float
  // Names of the collections the backup contains
  //
  // Includes collections deleted since the backup was taken, which the
  // collections list leaves out.
  collectionNames []string
  // Collections the backup contains that still exist on the server
  collections() []weaviate.collection
}

// Weaviate collection alias
//
// An alternative name that resolves to a collection. Queries addressed to the
// alias reach the collection it points to. The name field selects the alias,
// for example weaviate.instance.aliases.where(name == "ArticleLive").
weaviate.alias @defaults("name") {
  // Alias name
  name string
  // Collection the alias points to
  collection() weaviate.collection
}

// Weaviate collection
//
// A single collection (class) and its data-governance settings: vectorizer
// module, multi-tenancy, replication, and vector index type. The name field
// selects the collection, for example
// weaviate.instance.collections.where(name == "Article").
weaviate.collection @defaults("name vectorizer multiTenancyEnabled") {
  // Collection (class) name
  name string
  // Human-readable description, when set
  description string
  // Vectorizer module, for example "none" or "text2vec-openai"
  vectorizer string
  // Names of the modules configured on the collection
  modules []string
  // Whether multi-tenancy is enabled
  //
  // When true, data is partitioned into isolated tenants. Auto-creation and
  // auto-activation weaken that isolation by materializing tenants on first
  // use.
  multiTenancyEnabled bool
  // Whether tenants are created automatically on first use
  autoTenantCreation bool
  // Whether tenants are activated automatically on first use
  autoTenantActivation bool
  // Number of replicas kept for each shard
  replicationFactor int
  // Whether asynchronous replication is enabled
  asyncReplicationEnabled bool
  // Vector index type, for example "hnsw", "flat", or "dynamic"
  vectorIndexType string
  // Generative module the collection sends retrieved data to, for example "generative-openai"
  //
  // Null when no generative module is configured. Generative search passes
  // query results to the external language model this module calls.
  generativeModule string
  // Reranker module the collection sends results to, for example "reranker-cohere"
  //
  // Null when no reranker module is configured.
  rerankerModule string
  // Endpoints the collection's modules are pointed at, keyed by module name
  //
  // Only modules whose configuration names an endpoint appear, for example
  // moduleEndpoints["generative-openai"] == "https://llm.internal.example".
  // The server can store a module's default endpoint here as well. Credentials
  // and query strings in a URL are left out.
  moduleEndpoints map[string]string
  // Vectorizer module of each named vector, keyed by vector name
  //
  // Empty for a collection without named vectors, whose single vectorizer is
  // in vectorizer. A vector without a vectorizer reads "none".
  vectorizers map[string]string
  // Whether objects expire after a time to live
  objectTtlEnabled bool
  // Seconds added to the deleteOn time to compute an object's expiry
  //
  // Null when no time-to-live configuration is set.
  objectTtlDefault int
  // Property holding the base time an object's expiry is computed from
  //
  // "_creationTimeUnix", "_lastUpdateTimeUnix", or a custom date property.
  // Null when no time-to-live configuration is set.
  objectTtlDeleteOn string
  // How replicas resolve an object deleted on one replica and present on another
  //
  // One of NoAutomatedResolution, DeleteOnConflict, or TimeBasedResolution.
  // Null when the server reports none.
  replicationDeletionStrategy string
  // Tenants of a multi-tenant collection
  //
  // Empty when multi-tenancy is not enabled.
  tenants() []weaviate.collection.tenant
}

// Weaviate collection tenant
//
// A tenant of a multi-tenant collection and whether its data is loaded. The
// name field selects the tenant, for example
// tenants.where(activityStatus != "ACTIVE").
weaviate.collection.tenant @defaults("name activityStatus") {
  // Tenant name
  name string
  // Tenant activity status, for example "ACTIVE", "INACTIVE", or "OFFLOADED"
  activityStatus string
}

// Weaviate role
//
// A role in role-based access control and the permissions it grants. The
// built-in root and viewer roles are marked with isBuiltin. The name field
// selects the role, for example
// weaviate.instance.roles.where(name == "viewer").
weaviate.role @defaults("name isBuiltin") {
  // Role name
  name string
  // Whether this is a built-in, immutable role (root or viewer)
  isBuiltin bool
  // Permissions granted by the role
  permissions() []weaviate.role.permission
  // Identifiers of the users assigned this role
  assignedUsers() []string
  // Identity-provider groups assigned this role
  //
  // A role granted to a group is held by every member of that group, so a role
  // can be in use while assignedUsers is empty.
  assignedGroups() []weaviate.group
}

// Weaviate role permission
//
// A single action a role is allowed, the permission domain it belongs to, and
// the qualifiers that domain carries: the collection, tenant, object, alias,
// shard, group, user, namespace, or role the action is limited to, and the
// scope of a role-management grant. A
// qualifier the domain does not carry reads as null, so
// permissions.where(scope == "all") selects only role-management grants that
// can hand out permissions the role does not itself hold.
weaviate.role.permission @defaults("domain action collection") {
  // Allowed action, for example "read_data", "create_roles", or "read_nodes"
  action string
  // Permission domain the action belongs to
  //
  // One of alias, backups, cluster, collections, data, groups, mcp,
  // namespaces, nodes, replicate, roles, tenants, or users. A domain added to
  // the server later is reported by the name the server gives it. Selects a
  // class of grants without matching on action names, for example
  // permissions.where(domain == "backups").
  domain string
  // Collection the action is scoped to, "*" for all, or empty when not applicable
  //
  // Carried by the alias, backups, collections, data, nodes, replicate, and
  // tenants domains. An exact collection name or a regular expression.
  collection string
  // Scope of a role-management grant
  //
  // "all" lets the role grant every permission, including permissions it does
  // not hold itself, which is a privilege-escalation path. "match" limits it
  // to permissions the role already holds. Null outside the roles domain.
  scope string
  // Role the action applies to, "*" for all
  //
  // An exact role name or a regular expression. Null outside the roles domain.
  targetRole string
  // Group the action applies to, "*" for all
  //
  // An exact group name or a regular expression. Null outside the groups
  // domain.
  group string
  // Type of the group the action applies to, for example "oidc"
  //
  // Null outside the groups domain.
  groupType string
  // Alias the action applies to, "*" for all
  //
  // An exact alias name or a regular expression. Null outside the alias
  // domain.
  alias string
  // Shard the action applies to, "*" for all
  //
  // An exact shard name or a regular expression. Null outside the replicate
  // domain.
  shard string
  // Level of node detail the action allows
  //
  // "verbose" returns shard and statistics data, "minimal" does not. Null
  // outside the nodes domain.
  verbosity string
  // Tenant the action applies to, "*" for all
  //
  // An exact tenant name or a regular expression, within the collection the
  // grant names. A grant scoped to one tenant reaches only that tenant's data.
  // Null outside the data and tenants domains.
  tenant string
  // Object the action applies to, "*" for all
  //
  // An exact object ID or a regular expression. Null outside the data domain.
  object string
  // User the action applies to, "*" for all
  //
  // An exact user name or a regular expression. Null outside the users domain.
  targetUser string
  // Namespace the action applies to, "*" for all
  //
  // An exact namespace name or a regular expression. Null outside the
  // namespaces domain.
  namespace string
}

// Weaviate user
//
// A database-managed principal known to the server, its type, and the roles
// assigned to it. Users authenticated through OIDC are not listed here and
// appear only in role assignments. The userId field selects the user, for
// example weaviate.instance.users.where(userId == "root-user").
weaviate.user @defaults("userId userType") {
  // User identifier
  userId string
  // User type, for example "db_user", "db_env_user", or "oidc"
  userType string
  // Whether the user is active
  active bool
  // When the user was created
  //
  // Null for a user defined by the server's environment rather than created
  // through the API, which the server reports without a creation time.
  createdAt time
  // When the user's API key was last used to authenticate
  //
  // Null when the key has never been used, which separates a credential that
  // is idle from one that has never been exercised at all.
  lastUsedAt time
  // Roles assigned to the user
  roles() []weaviate.role
}

// Weaviate identity-provider group
//
// A group the server holds role assignments for, and the roles granted to it.
// A role granted to a group is held by every member, which is an assignment
// path the user list does not show. The groupId field selects the group, for
// example weaviate.instance.groups.where(groupId == "platform-admins").
weaviate.group @defaults("groupId groupType") {
  // Group identifier as the identity provider reports it
  groupId string
  // Kind of group, for example "oidc"
  groupType string
  // Roles granted to the group, with their permissions
  roles() []weaviate.role
}

// Weaviate cluster node
//
// A single node in the Weaviate cluster and its health, including version,
// status, and object and shard counts. The name field selects the node.
weaviate.node @defaults("name status version") {
  // Node name
  name string
  // Node health status, for example "HEALTHY", "UNHEALTHY", or "INDEXING"
  status string
  // Weaviate version running on the node
  version string
  // Git commit the node was built from
  gitHash string
  // Number of shards hosted on the node
  shardCount int
  // Number of objects stored on the node
  objectCount int
  // Mode of operation the node runs in
  //
  // One of ReadWrite, ReadOnly, WriteOnly, or ScaleOut. A read-only node
  // rejects writes, a write-only node rejects reads. Null when the server
  // reports none.
  operationalMode string
}
