import core

option provider = "go.mondoo.com/mql/providers/weaviate"
option go_package = "go.mondoo.com/mql/providers/weaviate/resources"
option root = "weaviate.instance"


// Weaviate server
//
// Server-wide configuration and security posture: version, enabled modules,
// whether anonymous access is allowed, and whether OpenID Connect and
// role-based access control are enabled. Collections, roles, users, and
// cluster nodes are reached from here.
weaviate.instance @defaults("version rbacEnabled anonymousAccessEnabled") @root {
  // Server version, for example "1.38.8"
  version @maturity("deprecated") @replaced_by("asset.version") string
  // Hostname the server reports for itself
  hostname string
  // Names of the enabled modules, for example "text2vec-openai"
  modules []string
  // Whether unauthenticated requests are accepted
  //
  // True when the server answers an unauthenticated request, meaning any
  // client that can reach the network endpoint reads data without
  // credentials.
  anonymousAccessEnabled bool
  // Whether OpenID Connect authentication is configured
  oidcEnabled bool
  // OIDC issuer discovery URL, when OIDC is configured
  oidcIssuer string
  // OIDC client id, when OIDC is configured
  oidcClientId string
  // Whether role-based access control is enabled
  rbacEnabled bool
  // Collections (classes) defined on the server
  collections() []weaviate.collection
  // Roles defined on the server
  roles() []weaviate.role
  // Database-managed users known to the server
  //
  // Only database-managed users are listed. Users authenticated through OIDC
  // are not enumerated here and appear only in role assignments.
  users() []weaviate.user
  // Cluster nodes backing the server
  nodes() []weaviate.node
}

// Weaviate collection
//
// A single collection (class) and its data-governance settings: vectorizer
// module, multi-tenancy, replication, and vector index type. The name field
// selects the collection, for example
// weaviate.instance.collections.where(name == "Article").
weaviate.collection @defaults("name vectorizer multiTenancyEnabled") {
  // Collection (class) name
  name string
  // Human-readable description, when set
  description string
  // Vectorizer module, for example "none" or "text2vec-openai"
  vectorizer string
  // Names of the modules configured on the collection
  modules []string
  // Whether multi-tenancy is enabled
  //
  // When true, data is partitioned into isolated tenants. Auto-creation and
  // auto-activation weaken that isolation by materializing tenants on first
  // use.
  multiTenancyEnabled bool
  // Whether tenants are created automatically on first use
  autoTenantCreation bool
  // Whether tenants are activated automatically on first use
  autoTenantActivation bool
  // Number of replicas kept for each shard
  replicationFactor int
  // Whether asynchronous replication is enabled
  asyncReplicationEnabled bool
  // Vector index type, for example "hnsw", "flat", or "dynamic"
  vectorIndexType string
}

// Weaviate role
//
// A role in role-based access control and the permissions it grants. The
// built-in root and viewer roles are marked with isBuiltin. The name field
// selects the role, for example
// weaviate.instance.roles.where(name == "viewer").
weaviate.role @defaults("name isBuiltin") {
  // Role name
  name string
  // Whether this is a built-in, immutable role (root or viewer)
  isBuiltin bool
  // Permissions granted by the role
  permissions() []weaviate.role.permission
  // Identifiers of the users assigned this role
  assignedUsers() []string
}

// Weaviate role permission
//
// A single action a role is allowed, the permission domain it belongs to, and
// the qualifiers that domain carries: the collection, alias, shard, group, or
// role the action is limited to, and the scope of a role-management grant. A
// qualifier the domain does not carry reads as null, so
// permissions.where(scope == "all") selects only role-management grants that
// can hand out permissions the role does not itself hold.
weaviate.role.permission @defaults("domain action collection") {
  // Allowed action, for example "read_data", "create_roles", or "read_nodes"
  action string
  // Permission domain the action belongs to
  //
  // One of alias, backups, cluster, collections, data, groups, mcp, nodes,
  // replicate, roles, tenants, or users. Selects a class of grants without
  // matching on action names, for example
  // permissions.where(domain == "backups").
  domain string
  // Collection the action is scoped to, "*" for all, or empty when not applicable
  //
  // Carried by the alias, backups, collections, data, nodes, and replicate
  // domains. An exact collection name or a regular expression.
  collection string
  // Scope of a role-management grant
  //
  // "all" lets the role grant every permission, including permissions it does
  // not hold itself, which is a privilege-escalation path. "match" limits it
  // to permissions the role already holds. Null outside the roles domain.
  scope string
  // Role the action applies to, "*" for all
  //
  // An exact role name or a regular expression. Null outside the roles domain.
  targetRole string
  // Group the action applies to, "*" for all
  //
  // An exact group name or a regular expression. Null outside the groups
  // domain.
  group string
  // Type of the group the action applies to, for example "oidc"
  //
  // Null outside the groups domain.
  groupType string
  // Alias the action applies to, "*" for all
  //
  // An exact alias name or a regular expression. Null outside the alias
  // domain.
  alias string
  // Shard the action applies to, "*" for all
  //
  // An exact shard name or a regular expression. Null outside the replicate
  // domain.
  shard string
  // Level of node detail the action allows
  //
  // "verbose" returns shard and statistics data, "minimal" does not. Null
  // outside the nodes domain.
  verbosity string
}

// Weaviate user
//
// A database-managed principal known to the server, its type, and the roles
// assigned to it. Users authenticated through OIDC are not listed here and
// appear only in role assignments. The userId field selects the user, for
// example weaviate.instance.users.where(userId == "root-user").
weaviate.user @defaults("userId userType") {
  // User identifier
  userId string
  // User type, for example "db_user", "db_env_user", or "oidc"
  userType string
  // Whether the user is active
  active bool
  // Roles assigned to the user
  roles() []weaviate.role
}

// Weaviate cluster node
//
// A single node in the Weaviate cluster and its health, including version,
// status, and object and shard counts. The name field selects the node.
weaviate.node @defaults("name status version") {
  // Node name
  name string
  // Node health status, for example "HEALTHY", "UNHEALTHY", or "INDEXING"
  status string
  // Weaviate version running on the node
  version string
  // Git commit the node was built from
  gitHash string
  // Number of shards hosted on the node
  shardCount int
  // Number of objects stored on the node
  objectCount int
}
