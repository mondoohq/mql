# Settings before any block apply to every host.
ServerAliveInterval 30
Include config.d/*

Host bastion prod-db
  User admin
  ForwardAgent yes

Host *.internal !bastion
  ProxyJump bastion
  StrictHostKeyChecking no

Host prod-db
  # A second block for the same host: its User is never used, the first value wins.
  User other
  Port 2222

Match host build-* exec "true"
  IdentityFile ~/.ssh/build_key
