// SR-IOV network devices
//
// Single-root I/O virtualization state of the host's network hardware. The
// physicalFunctions field lists every SR-IOV capable interface with the number
// of virtual functions it has enabled against the number it supports, and
// virtualFunctions flattens every virtual function across all of them. This is
// the realised hardware inventory, so it shows the PCI address, the bound
// driver, and the per-device link settings that a Kubernetes device plugin
// only reports as an aggregate count. Empty on hosts with no SR-IOV capable
// interface.
sriov {
  // SR-IOV capable network interfaces
  physicalFunctions() []sriov.physicalFunction
  // Virtual functions across every physical function
  virtualFunctions() []sriov.virtualFunction
}

// SR-IOV physical function
//
// Network interface that supports SR-IOV, selected by its interface name. The
// numVfs and totalVfs fields report how many virtual functions are enabled
// against how many the hardware supports, so an interface with numVfs of 0 is
// capable but unused. The pciAddress, vendorId, deviceId, and driver fields
// identify the device the way a device-plugin selector does, and macAddress,
// mtu, and operationalState report the link. The virtualFunctions field
// returns the virtual functions carved out of this interface.
private sriov.physicalFunction @defaults("interface pciAddress numVfs totalVfs") {
  // Kernel name of the network interface (for example enp25s0f0)
  interface string
  // PCI address of the device (for example 0000:19:00.0)
  pciAddress string
  // Kernel driver bound to the device (for example i40e or mlx5_core)
  driver string
  // PCI vendor ID in lowercase hex without the 0x prefix (for example 8086)
  vendorId string
  // PCI device ID in lowercase hex without the 0x prefix (for example 1572)
  deviceId string
  // Number of virtual functions currently enabled
  numVfs int
  // Number of virtual functions the hardware supports
  totalVfs int
  // MAC address of the interface
  macAddress string
  // Maximum transmission unit of the interface
  mtu int
  // Link state reported by the kernel (up, down, unknown)
  operationalState string
  // NUMA node the device is attached to, or -1 when it has no affinity
  numaNode int
  // Virtual functions carved out of this physical function
  virtualFunctions() []sriov.virtualFunction
}

// SR-IOV virtual function
//
// One virtual function of an SR-IOV capable interface, selected by its PCI
// address. The driver field reports what the function is bound to, and
// usesPassthroughDriver marks a function handed to a userspace datapath such
// as DPDK, which leaves it with no kernel network interface and therefore
// outside host packet filtering. The spoofChecking, trusted, macAddress,
// vlanId, and rate fields report the configuration the physical function
// enforces on the guest, which is the part a workload cannot override.
// linkConfigured is false when the kernel reports no configuration for the
// function, so an unreported function is not read as an unprotected one.
private sriov.virtualFunction @defaults("pciAddress index driver spoofChecking") {
  // PCI address of the virtual function (for example 0000:19:02.0)
  pciAddress string
  // Index of the virtual function within its physical function
  index int
  // Physical function this virtual function belongs to
  physicalFunction() sriov.physicalFunction
  // Kernel driver bound to the virtual function (for example iavf or vfio-pci)
  driver string
  // Kernel name of the network interface, empty when no kernel driver is bound
  interface string
  // PCI vendor ID in lowercase hex without the 0x prefix
  vendorId string
  // PCI device ID in lowercase hex without the 0x prefix
  deviceId string
  // NUMA node the device is attached to, or -1 when it has no affinity
  numaNode int
  // Whether the function is bound to a userspace passthrough driver
  //
  // True for vfio-pci, uio_pci_generic, igb_uio, and vfio. Such a function has
  // no kernel network interface, so the host stack cannot filter its traffic.
  usesPassthroughDriver bool
  // Whether the kernel reports link configuration for this function
  //
  // False when the physical function's driver exposes no per-function
  // settings. The configuration fields below then carry their zero values and
  // must not be read as the enforced setting.
  linkConfigured bool
  // MAC address the physical function assigns, empty when the guest chooses it
  macAddress string
  // VLAN ID the physical function enforces, 0 when no VLAN is set
  vlanId int
  // 802.1p priority applied together with the VLAN
  qos int
  // Whether the physical function drops frames with a foreign source address
  //
  // Spoof checking is what stops a workload on the virtual function from
  // sending traffic as another MAC address.
  spoofChecking bool
  // Whether the function may change its MAC address and program multicast filters
  //
  // A trusted function can leave the address the physical function assigned,
  // and can enable promiscuous mode.
  trusted bool
  // Administrative link state (auto, enable, disable)
  linkState string
  // Guaranteed transmit rate in Mbps, 0 when unset
  minTxRate int
  // Transmit rate cap in Mbps, 0 when uncapped
  maxTxRate int
}

// Open vSwitch
//
// Software switch configured through the Open vSwitch database on this host.
// The bridges, ports, and interfaces fields report the switch as it is running
// now, joined into the topology the datapath uses, which is the dataplane a
// CNI plugin builds and Kubernetes only records as intent. Empty on hosts
// where ovs-vsctl is not installed or the database is not reachable.
ovs {
  // Open vSwitch version reported by ovs-vsctl
  version() string
  // Bridges configured on this host
  bridges() []ovs.bridge
  // Ports across every bridge
  ports() []ovs.port
  // Interfaces across every port
  interfaces() []ovs.interface
}

// Open vSwitch bridge
//
// One bridge of the local switch, selected by name. The failMode field decides
// what the bridge does when it loses its controller: `secure` keeps the
// installed flows and forwards nothing new, `standalone` falls back to acting
// as a learning switch, which forwards traffic no policy authorised. The
// datapathType, protocols, stpEnabled, and rstpEnabled fields report how the
// bridge switches, and externalIds carries the tags the CNI plugin or the
// operator wrote. The ports field returns the ports attached to the bridge.
private ovs.bridge @defaults("name datapathType failMode") {
  // Bridge name (for example br-ex)
  name string
  // Database UUID of the bridge
  uuid string
  // Datapath the bridge runs on (system, netdev)
  datapathType string
  // Behaviour when the bridge has no controller connection
  //
  // `secure` keeps the installed flows, `standalone` falls back to a learning
  // switch. Empty when no fail mode is set, which the switch treats as
  // standalone.
  failMode string
  // OpenFlow versions the bridge accepts (for example OpenFlow13)
  protocols []string
  // Whether Spanning Tree Protocol is enabled
  stpEnabled bool
  // Whether Rapid Spanning Tree Protocol is enabled
  rstpEnabled bool
  // Tags written into the external_ids column
  externalIds map[string]string
  // Settings written into the other_config column
  otherConfig map[string]string
  // Ports attached to the bridge
  ports() []ovs.port
}

// Open vSwitch port
//
// One port of a bridge, selected by name. The vlanMode and vlanTag fields
// report how the port treats VLAN tags: an access port carries a single tag,
// a trunk port carries the VLANs listed in trunks, and a port with neither
// carries every VLAN the bridge sees. tagged is false when no tag is set, so
// an untagged port is not read as VLAN 0. The interfaces field returns the
// interfaces the port is built from, which is more than one for a bond.
private ovs.port @defaults("name bridgeName vlanMode vlanTag") {
  // Port name (for example veth-pod0)
  name string
  // Database UUID of the port
  uuid string
  // Name of the bridge the port is attached to, empty when no bridge claims it
  bridgeName string
  // Bridge the port is attached to (null when no bridge claims it)
  bridge() ovs.bridge
  // VLAN handling of the port (access, native-tagged, native-untagged, trunk)
  vlanMode string
  // VLAN ID of an access port, 0 when no tag is set
  vlanTag int
  // Whether a VLAN tag is set on the port
  //
  // False means the port carries every VLAN the bridge sees, which is not the
  // same as carrying VLAN 0.
  tagged bool
  // VLAN IDs a trunk port carries
  trunks []int
  // Tags written into the external_ids column
  externalIds map[string]string
  // Settings written into the other_config column
  otherConfig map[string]string
  // Interfaces the port is built from
  interfaces() []ovs.interface
}

// Open vSwitch interface
//
// One interface of a port, selected by name. The type field reports how the
// interface reaches the network: an empty type is a system device, `internal`
// is the bridge's own device, and `vxlan`, `geneve`, or `gre` is a tunnel
// whose remote end is in options. The adminState and linkState fields report
// whether the interface is up, and error carries the reason the switch could
// not open the device, which is how a misconfigured attachment shows up.
// externalIds carries the tags the CNI plugin wrote, which is what ties the
// interface back to a pod.
private ovs.interface @defaults("name type adminState linkState") {
  // Interface name
  name string
  // Database UUID of the interface
  uuid string
  // Name of the port the interface belongs to, empty when no port claims it
  portName string
  // Port the interface belongs to (null when no port claims it)
  port() ovs.port
  // Name of the bridge the interface reaches, empty when no bridge claims it
  bridgeName string
  // Interface type, empty for a system device (internal, vxlan, geneve, gre, patch, ...)
  type string
  // Administrative state reported by the switch (up, down)
  adminState string
  // Link state reported by the switch (up, down)
  linkState string
  // MAC address the interface uses
  macAddress string
  // Maximum transmission unit of the interface
  mtu int
  // OpenFlow port number, -1 when the switch could not assign one
  ofport int
  // Reason the switch could not open the device, empty when it is healthy
  error string
  // Tags written into the external_ids column
  externalIds map[string]string
  // Type-specific settings, such as the remote_ip of a tunnel
  options map[string]string
}

// Java keystore or trust store
//
// The certificates a JVM trusts, and the ones it presents. Select a store
// with `java.keystore("/opt/java/lib/security/cacerts")`, or reach every
// trust store the asset has with `java.truststores`.
//
// The store is read straight from the file. A JKS store keeps its
// certificates unencrypted — only private keys are protected, and the
// store password guards an integrity digest rather than the contents —
// so no credential is needed and the store is readable on a container
// image or a mounted filesystem, where nothing can be executed.
java.keystore @defaults("path format entries.length") {
  init(path string)
  // Path of the keystore file
  path string
  // Keystore file, for ownership and permission checks
  file() file
  // Store format: "jks", "jceks", or "pkcs12"
  format() string
  // Entries the store holds, one per alias
  entries() []java.keystore.entry
  // Every certificate in the store, across all entries
  //
  // The flat view, for asking a question of the whole store: which
  // authorities it trusts, whether any of them has expired, what
  // algorithms they sign with.
  certificates() []network.certificate
  // Certificates in the store that could not be parsed
  //
  // A store built up over years holds certificates that no longer parse —
  // a negative serial number is the usual reason, legal when the
  // certificate was issued and rejected now. Those are left out of
  // `certificates` so one of them cannot blind every check, and counted
  // here so leaving them out is not a silent loss.
  unreadableCertificates() int
}

// One alias in a Java keystore
private java.keystore.entry @defaults("alias isTrustedCertificate") {
  // Alias the entry is filed under
  //
  // Lower-cased by keytool when the entry is written, so a store written
  // by the tool reports lower-case aliases whatever was typed.
  alias string
  // Whether the entry holds someone else's certificate, not a private key
  //
  // A trust store is made of these. An entry that is not one holds a
  // private key together with the chain that vouches for it.
  isTrustedCertificate bool
  // When the entry was added to the store
  //
  // Null when the store records no date, as PKCS#12 does not.
  createdAt time
  // Certificates the entry holds
  //
  // One for a trusted certificate entry, and the chain for a private key
  // entry. The key material itself is never exposed.
  certificates() []network.certificate
}

// Trust stores of every JVM installed on the asset
//
// Finds the `cacerts` file of each JDK or JRE on the asset and reads it,
// so a check can ask what the machine's Java runtimes trust without
// knowing where any of them is installed.
java.truststores {
  []java.keystore(paths)
  // Paths of the trust stores that were found
  paths() []string
}
