import "../../core/resources/core.lr"
import "../../network/resources/network.lr"

option provider = "go.mondoo.com/mql/providers/os"
option go_package = "go.mondoo.com/mql/providers/os/resources"

alias os.base.command = command
alias os.base.user = user
alias os.base.group = group
alias os.base.file = file
alias os.base.packages = packages
alias os.base.service = service
alias os.base.services = services
alias os.unix.sshd = sshd

extend asset {
  // Common Platform Enumeration (CPE) identifiers for the asset
  //
  // The list of CPE strings that describe the asset's platform and
  // software, used to correlate the asset against CPE-indexed
  // vulnerability data.
  cpes() []core.cpe
  // Advisory and vulnerability report
  //
  // Deprecated in favor of the `vulnmgmt` resource. Will be removed in
  // version 13.0.
  vulnerabilityReport() @maturity("deprecated") dict
  // Platform identity in package URL (purl) format
  //
  // The asset's platform expressed as a package URL rather than a CPE
  // string, for matching against purl-indexed vulnerability and
  // software-inventory data.
  purl() string
}

// Host environment for an AI agent or editor extension
//
// Runtime that hosts an AI coding agent or editor extension: the operating
// system for a standalone agent, the IDE or editor for an editor plugin, or
// the browser for a browser extension. The `package` field carries the
// host's software identity (version and package URL where known) so the
// host itself can be assessed for vulnerabilities like any other installed
// software.
private extensionRuntime @defaults("package") {
  // Host software package
  //
  // Host application or operating system represented as a package, carrying
  // its version and package URL (purl) where known so it can be looked up in
  // vulnerability data like any other installed software.
  package package
}

// Operating system end-of-life status
//
// End-of-Life metadata Mondoo publishes for the asset's detected operating
// system or platform: the EoL date itself, a product-page URL, and a
// documentation URL. Used by audits to flag hosts whose vendor has stopped
// issuing security patches and to plan migrations before unsupported
// software accumulates risk.
asset.eol @defaults("date") {
  // Documentation URL for the platform's end-of-life policy
  docsUrl string
  // Product page URL for the detected platform
  productUrl string
  // Date after which the vendor no longer provides support or patches
  date time
}

// Platform end-of-life information
private mondoo.eol {
  // Product name
  product string
  // Product version
  version string
  // End-of-life date for the product
  date() time
}

// Asset vulnerability assessment
//
// Vulnerability data Mondoo derives for an asset by joining its
// installed-package inventory and platform identity against the curated
// CVE and advisory feed. Exposes every CVE affecting the asset, every
// vendor advisory that mentions one of those CVEs, the affected packages
// with their currently-installed and patched-available versions, the
// timestamp of the last assessment run, and the rolled-up CVSS statistics:
// the surface used to score asset risk and to drive patch-status policies.
vulnmgmt {
  // List of all CVEs affecting the asset
  cves() []vuln.cve
  // List of all advisories affecting the asset
  advisories() []vuln.advisory
  // List of all packages affected by vulnerabilities
  packages() []vuln.package
  // Last time the vulnerability information was updated
  lastAssessment() time
  // Rolled-up CVSS statistics across all findings
  stats() audit.cvss
}

// CVE information
private vuln.cve @defaults("id") {
  // CVE ID (e.g., "CVE-2024-3094")
  id string
  // CVE state
  state     string
  // Summary description
  summary   string
  // Whether the CVE has no assigned CVSS score
  unscored  bool
  // Publication date
  published   time
  // Last modification date
  modified    time
  // Worst CVSS score of all assigned CVEs
  worstScore    audit.cvss
}

// Advisory information
private vuln.advisory @defaults("id") {
  // Advisory ID
  id string
  // Title of the advisory
  title string
  // Description of the advisory
  description string
  // Advisory publication date
  published   time
  // Last modification date
  modified    time
  // Worst CVSS score of all assigned CVEs
  worstScore    audit.cvss
}

// Package information relevant for vulnerability management
private vuln.package @defaults("name version") {
  // Package name
  name string
  // Currently installed package version
  version string
  // Fixed package version that resolves the vulnerability, when available
  available string
  // Architecture of this package
  arch string
}

// Platform and package advisories
//
// Consolidated list of vendor advisories that affect the asset, plus a
// worst-case CVSS roll-up across all of them and a statistical breakdown by
// severity (total, critical, high, medium, low, none, unknown). Use it to
// drive policies that require zero outstanding critical-severity advisories
// or that compare an asset's advisory load against a baseline.
platform.advisories {
  []audit.advisory
  // Worst CVSS score for all advisories
  cvss() audit.cvss
  // Statistical information: total, critical, high, medium, low, none, unknown
  stats() dict
}

// Platform and package CVEs
//
// Full list of CVEs that affect the asset's installed packages or platform,
// plus a worst-case CVSS roll-up across them and a per-severity statistical
// breakdown (total, critical, high, medium, low, none, unknown). Used to
// enforce ceilings on outstanding critical or high-severity CVEs and to
// surface the most urgent fixes.
platform.cves {
  []audit.cve
  // Worst CVSS score for all CVEs
  cvss() audit.cvss
  // Statistical information: total, critical, high, medium, low, none, unknown
  stats() dict
}

// Common Vulnerability Scoring System (CVSS) score
private audit.cvss @defaults("score") {
  // CVSS score ranging from 0.0 to 10.0
  score   float
  // CVSS score represented as a vector string
  vector  string
}

// Platform/package advisory
private audit.advisory {
  // Advisory ID
  id          string
  // Mondoo advisory identifier
  mrn         string
  // Advisory title
  title       string
  // Advisory description
  description string
  // Advisory publication date
  published   time
  // Last modification date
  modified    time
  // Worst CVSS score of all assigned CVEs
  worstScore    audit.cvss
}

// Common Vulnerabilities and Exposures (CVEs)
private audit.cve {
  // CVE ID
  id        string
  // Mondoo CVE identifier
  mrn       string
  // CVE state
  state     string
  // Summary description
  summary   string
  // Whether the CVE has no assigned CVSS score
  unscored  bool
  // Publication date
  published   time
  // Last modification date
  modified    time
  // Worst CVSS score of all assigned CVEs
  worstScore    audit.cvss
}

// Hardware identity from SMBIOS / DMI
//
// Namespace for low-level hardware identity exposed by the firmware. The
// sub-resources below (`machine.bios`, `machine.system`,
// `machine.baseboard`, `machine.chassis`, `machine.cpu`, and
// `machine.secureboot`) surface the SMBIOS / DMI tables (vendor, version,
// and release date for the BIOS; manufacturer, product, SKU, UUID, and
// serial for the system; baseboard and chassis identifiers; CPU socket and
// core counts) plus the EFI Secure Boot posture read from EFI variables on
// Linux. Used for inventory, warranty and supply-chain reviews, and
// platform-firmware compliance.
machine {}

// SMBIOS BIOS information
//
// Firmware vendor, version string, and release date as reported by SMBIOS
// Type 0 tables. Used to inventory BIOS versions across a fleet and to flag
// hosts that have not applied vendor firmware updates.
machine.bios {
  // BIOS vendor
  vendor string
  // BIOS version
  version string
  // BIOS release date
  releaseDate string
}

// SMBIOS system information
//
// Manufacturer, product name, version, serial number, UUID, SKU number, and
// family string as reported in SMBIOS Type 1 tables. Useful for asset
// inventory, warranty lookups, and supply-chain reviews.
machine.system {
  // System manufacturer name (SMBIOS Type 1)
  manufacturer string
  // System product name
  product string
  // System version string
  version string
  // System serial number
  serial string
  // System UUID
  uuid string
  // SKU number
  sku string
  // System family/series
  family string
}

// SMBIOS baseboard (or module) information
//
// Baseboard manufacturer, product name, version, serial number, and asset
// tag as reported in SMBIOS Type 2 tables. Used for hardware inventory and
// to correlate physical boards with asset-tracking systems.
machine.baseboard {
  // Baseboard manufacturer name (SMBIOS Type 2)
  manufacturer string
  // Baseboard product name
  product string
  // Baseboard version string
  version string
  // Baseboard serial number
  serial string
  // Asset tag
  assetTag string
}

// SMBIOS system enclosure or chassis
//
// Chassis manufacturer, version, serial number, and asset tag as reported
// in SMBIOS Type 3 tables. Useful for physical-hardware audits and
// correlating enclosures with asset-tracking records.
machine.chassis {
  // Manufacturer
  manufacturer string
  // Version
  version string
  // Serial number
  serial string
  // Asset tag number
  assetTag string
}

// CPU information
//
// CPU manufacturer, model name, number of physical processor packages
// (sockets), and total physical core count as reported by the system. Used
// for capacity planning, licensing audits, and hardware-baseline policies.
machine.cpu @defaults("manufacturer model processorCount coreCount") {
  // CPU manufacturer
  manufacturer string
  // CPU model name
  model string
  // Number of physical CPU packages (sockets)
  processorCount int
  // Total number of physical CPU cores
  coreCount int
}

// Secure Boot status
//
// EFI Secure Boot posture: whether the system booted in EFI/UEFI mode
// (`efi`), whether Secure Boot is currently enabled (`enabled`), and
// whether it is in setup mode (`setupMode`, meaning keys can be modified
// without authentication). Read from EFI variables on Linux and from the
// UEFI firmware on Windows; legacy-BIOS systems resolve to `efi` and
// `enabled` false rather than erroring. Used to assert that Secure Boot is
// enforced and that setup mode is not active.
machine.secureboot @defaults("enabled") {
  // Whether the system is booted in EFI/UEFI mode
  efi() bool
  // Whether Secure Boot is enabled
  enabled() bool
  // Whether Secure Boot is in setup mode (keys can be modified without authentication)
  setupMode() bool
}

// Operating system information
//
// Operating-system-level facts about the asset. Exposes the pretty
// hostname (or Windows device name), the FQDN-style hostname, the system's
// machine ID, the hypervisor it runs under (when virtualized), the running
// environment variables and the resolved PATH list, the current uptime, the
// list of available OS updates with their categories and severities,
// whether a reboot is pending after recent installs, and the current system
// date and timezone. The cross-platform anchor that audits start from when
// they need OS identity and patch state.
os {
  // Pretty hostname on macOS/Linux or device name on Windows
  name() string
  // ENV variable contents
  env() map[string]string
  // PATH variable contents
  path(env) []string
  // Current uptime
  uptime() time
  // List of available OS updates
  updates() []os.update
  // Time the most recent operating system update was installed
  //
  // Newest completed update the platform's own update mechanism recorded
  // for software the operating system vendor ships: a vendor package
  // upgrade in dnf's transaction log, a completed apt upgrade run
  // (timestamped by its End-Date), a macOS update in the install history,
  // or a Windows Update Agent entry for a Windows product. Software that
  // is not the operating system does not count, so a .NET or Office update
  // on Windows, a third-party rpm such as Docker or Grafana, and an
  // operator running `apt install` are all excluded, and so is definition
  // data (XProtect on macOS, Defender signatures on Windows) that lands
  // daily or weekly. Installing a package is not updating the operating
  // system, so a first-time install never advances this timestamp, on any
  // platform.
  //
  // Null on containers and container images, which are rebuilt rather than
  // patched, so the newest install inside one dates the image build rather
  // than any patching of the workload. Null too wherever the asset keeps
  // no record of a completed update that can be attributed to the vendor:
  // an rpm host whose package manager writes no transaction log (SUSE,
  // yum-era RHEL, Photon), image-based systems that update by swapping the
  // OS image (Bottlerocket, CoreOS), a Debian host whose apt history has
  // rotated away or whose newest history log cannot be read, a Windows
  // host whose update agent history cannot be read, apk and pacman. A
  // timestamp materially in the future (a skewed clock, a misread
  // timezone) also reads null rather than reporting the asset as freshly
  // patched. An inferred, incomplete or ambiguous answer would report a
  // different fact than the one asked for, so the field reads null instead
  // of answering loosely.
  //
  // Null is not false, so guard on it rather than comparing straight
  // through: `os.lastUpdate != null && (time.now - os.lastUpdate).days < 30`.
  lastUpdate() time
  // Time since the most recent operating system update was installed
  //
  // A duration, like `uptime`, so `os.lastUpdateAge.days` reads the patch
  // age directly. Measured once, when the field is first read, and held for
  // the rest of the scan rather than tracking the clock, the same way
  // `uptime` behaves. For an age relative to a specific moment, subtract
  // instead: `time.now - os.lastUpdate`. Null whenever `lastUpdate` is
  // null.
  lastUpdateAge() time
  // Record the last-update timestamp was read from
  //
  // One of "dnf-rpm-log", "apt-security", "apt-history",
  // "macos-install-history", or "windows-update-agent". Every one of them
  // names an exact, completed install event, so this reports provenance
  // rather than precision, and how tightly the vendor attribution holds is
  // what separates them. "apt-security" is a completed unattended-upgrades
  // run, whose default origin is the distribution's security pocket, which
  // makes it the closest an asset comes to recording a vendor security
  // advisory without an external advisory database; "apt-history" is an
  // operator-run full upgrade, which vendor packages dominate but which
  // can also carry a third-party repository. A policy that demands the
  // vendor security channel can require "apt-security", where a looser one
  // takes any non-null answer. Null whenever `lastUpdate` is null.
  lastUpdateSource() string
  // Whether a reboot is pending
  rebootpending() bool
  // Hostname for this OS
  hostname() string
  // Hypervisor for this OS
  hypervisor() string
  // Machine ID for this OS
  machineid() string
  // Current date and timezone of the system
  date() os.date
}

// Operating system date and timezone information
//
// Current system clock time and the configured timezone string (e.g.,
// "America/New_York", "UTC"). Used to verify that clocks are synchronized
// and that the correct timezone is set.
os.date @defaults("time timezone") {
  // Current system time
  time() time
  // System timezone (e.g., "America/New_York", "UTC")
  timezone() string
}

// Operating system update information
//
// Single pending OS update: its name, category, severity, whether it
// requires a restart, and the package format it belongs to. Read from
// `os.updates` to audit patch state and prioritize outstanding updates by
// severity.
os.update @defaults("name")  {
  // Name of the update
  name string
  // Category of the update (e.g., "security", "bugfix")
  category string
  // Severity of the update
  severity string
  // Whether a restart is required to complete the update
  restart bool
  // Package format for this update (e.g., "rpm", "deb")
  format string
}

// Generic operating system information common to all platforms
//
// Cross-platform OS view that embeds `machine` (firmware / SMBIOS hardware
// identity) and exposes the fields shared by every supported platform: the
// pretty hostname (or Windows device name), the FQDN-style hostname,
// environment variables and the resolved PATH list, uptime, the
// available-OS-update list, the reboot-pending flag, and the `users` and
// `groups` collections. `os.unix` and `os.linux` extend this with
// platform-specific surfaces.
os.base {
  embed machine

  // Pretty Hostname on macOS/Linux or device name on Windows
  name() string
  // ENV variable contents
  env() map[string]string
  // PATH variable contents
  path(env) []string
  // Current uptime
  uptime() time
  // List of available OS updates
  updates() []os.update
  // Time the most recent operating system update was installed, null on containers
  lastUpdate() time
  // Time since the most recent operating system update was installed, as a duration
  lastUpdateAge() time
  // Record the last-update timestamp was read from (e.g., "dnf-rpm-log", "apt-security")
  lastUpdateSource() string
  // Whether a reboot is pending
  rebootpending() bool
  // Hostname for this OS
  hostname() string
  // User groups
  groups() groups
  // Users
  users() users
}

// Operating system information for Unix-like platforms
//
// Extends `os.base` for Unix-family operating systems (macOS, Linux,
// FreeBSD, and similar). Aliases such as `os.base.user`, `os.base.group`,
// `os.base.file`, `os.base.command`, and `os.base.packages` route to
// concrete Unix resources, and `os.unix.sshd` aliases to the system-wide
// `sshd` resource so audits can express "examine sshd on the asset" without
// knowing the exact platform.
os.unix {
  embed os.base as base
}

// Operating system information for Linux platforms
//
// Extends `os.unix` (and through it, `os.base`) with Linux-only surfaces:
// the supported packet-filter stacks (`iptables`, `ip6tables`, `nftables`,
// `ufw`, `firewalld`), the `/etc/fstab` mount table, and the AppArmor
// mandatory-access-control namespace. Use it to write Linux-specific audits
// without reaching out to global resource handles.
os.linux {
  embed os.unix as unix

  // iptables firewall for IPv4
  iptables() iptables
  // iptables firewall for IPv6
  ip6tables() ip6tables
  // nftables firewall
  nftables() nftables
  // UFW (Uncomplicated Firewall)
  ufw() ufw
  // firewalld dynamic firewall manager (RHEL/CentOS/Fedora)
  firewalld() firewalld
  // /etc/fstab entries
  fstab() fstab
  // AppArmor mandatory access control
  apparmor() apparmor
}

// Operating system root certificate trust store
//
// X.509 root certificates that the asset's operating system trusts for TLS
// validation, derived from the platform-appropriate trust-store files (e.g.
// `/etc/ssl/certs/ca-certificates.crt` on Debian,
// `/etc/pki/tls/certs/ca-bundle.crt` on RHEL, the macOS SecTrust store, the
// Windows Root certificate store). Reads each trust-store file and exposes
// the parsed `network.certificate` list so audits can pin specific issuers,
// detect untrusted local additions, or count the trust-store size.
os.rootCertificates {
  []certificate(content)
  // List of files that define these certificates
  files []file
  content(files) []string
  // Number of certificates in the trust-store files that could not be parsed
  //
  // Counts the certificate blocks skipped while decoding the trust-store
  // files, for example a certificate carrying a negative serial number,
  // which older bundles still ship. Those blocks are left out of the list
  // rather than failing the whole store, so any value above zero means the
  // list is an incomplete view of what the platform trusts.
  unparseable(content) int
}

// Result of running a shell command on the system
//
// Ad-hoc command execution as an MQL resource. Initialized with a shell
// command string; the resource executes the command through the connection
// (local exec, SSH, container exec, and similar) and surfaces the captured
// `stdout`, `stderr`, and `exitcode`. Used as a fall-back when there isn't a
// more specific resource for a piece of system state, and for
// assertions on tool versions or command-line probes.
command {
  init(command string)
  // Command string that was run
  command string
  // Standard output from running the command
  stdout(command) string
  // Standard error output from running the command
  stderr(command) string
  // Exit code the command returned
  exitcode(command) int
}

// Result of running a PowerShell script on the system
//
// Ad-hoc PowerShell execution as an MQL resource. Initialized with a script
// string; the resource executes the script via PowerShell on the asset and
// surfaces the captured `stdout`, `stderr`, and `exitcode`. The Windows and
// cross-platform-PowerShell counterpart to `command` for assertions that
// need PowerShell-only surface area.
powershell {
  init(script string)
  // Script string that was run
  script string
  // Standard output from running the script
  stdout() string
  // Standard error output from running the script
  stderr() string
  // Exit code the script returned
  exitcode() int
}

// File on the system
//
// Single file referenced by absolute path. Surfaces the path itself, the
// basename and dirname, an `exists` flag, the `content` string, the file's
// size in bytes, an `empty` predicate, the owning `user` and `group` as
// references, and a structured `permissions` resource that explodes the
// POSIX mode into named user / group / other read / write / execute bits,
// the SUID / SGID / sticky bits, the `isFile` / `isDirectory` / `isSymlink`
// discriminators, and a printed mode string. The unit of file-level audits
// and the building block most config-file resources read through. Select a
// file by path, for example `file("/etc/ssh/sshd_config")`.
file @defaults("path size permissions.string") {
  init(path string)
  // Location of the file on the system
  path string
  // Filename without path prefix of this file
  basename(path) string
  // Path to the folder containing this file
  dirname(path) string
  // Contents of this file
  content(path, exists) string
  // Whether this file exists on the system
  exists(path) bool
  // Permissions for this file
  permissions(path) file.permissions
  // Size of this file on disk in bytes
  size(path) int
  // Ownership information about the user
  user() user
  // Ownership information about the group
  group() group
  // Whether the path is empty
  empty(path) bool
  // Windows access control list for this file
  //
  // Null on systems that do not use Windows security descriptors. Use it
  // together with `files.find` to answer who may write to a set of paths, for
  // example `files.find(from: "C:\\inetpub", type: "directory") { acl { ... } }`.
  // On POSIX systems read `permissions` instead.
  acl(path) windows.acl
}

// File context is a range of lines/columns in a file
private file.context @defaults("file.path range content") {
  // File referenced by this file context
  file file
  // Range of content in the file
  range range
  // Content for this range in the file, shown as an excerpt
  content(file, range) string
}

// Access permissions for a given file
private file.permissions @defaults("string") {
  // POSIX file mode as a decimal integer (e.g., 33188 = 0100644)
  mode int
  // Whether the file is readable by its owner
  user_readable bool
  // Whether the file is writeable by its owner
  user_writeable bool
  // Whether the file is executable by its owner
  user_executable bool
  // Whether the file is readable by members of the group
  group_readable bool
  // Whether the file is writeable by members of the group
  group_writeable bool
  // Whether the file is executable by members of the group
  group_executable bool
  // Whether the file is readable by others
  other_readable bool
  // Whether the file is writeable by others
  other_writeable bool
  // Whether the file is executable by others
  other_executable bool
  // Whether the set-user-ID bit is set (executable runs with the owner's privileges)
  suid bool
  // Whether the set-group-ID bit is set (executable runs with the group's privileges)
  sgid bool
  // Whether the sticky bit is set (only a file's owner may delete it from a shared directory)
  sticky bool
  // Whether the file describes a directory
  isDirectory bool
  // Whether the file describes a regular file
  isFile bool
  // Whether the file is a symlink
  isSymlink bool
  // Symbolic permission string in ls -l form (e.g., "-rw-r--r--")
  string() string
}

// File search and discovery namespace
//
// Empty namespace whose only purpose is to host `files.find`, so
// audits can write `files.find(...) {...}` to locate files on the
// asset rather than enumerating known paths.
files {}

// File search results
//
// Files discovered by a recursive filesystem walk rooted at `from`.
// Narrow the walk with `type` (file, directory, device, and so on),
// `regex` (path/name pattern), `permissions` (octal mode floor),
// `name` (filename glob), `depth` (maximum traversal depth), and
// `xdev` (whether to cross into other mounted filesystems). Resolves
// to the matching `[]file` list, so content, ownership, and permission
// checks can be layered on the result. For example
// `files.find(from: "/etc", type: "file", permissions: 0o002) { path }`
// finds every world-writable file under /etc.
files.find {
  []file
  // Directory the recursive search starts from (e.g., "/etc")
  from string
  // Whether to descend into directories on other mounted filesystems
  //
  // When false (the default) the search stays on the filesystem that
  // holds `from` (find's -xdev). Set true to cross mount points.
  xdev bool
  // Restrict results to a single file type
  //
  // One of file, directory, link, character, block, or socket. Empty
  // matches every type.
  type string
  // Regular expression matched against the full path of each candidate
  regex string
  // Octal mode floor: matches files that have at least these permission bits set
  //
  // Given as an octal literal (e.g., 0o002 for world-writable). Defaults
  // to 0o777, which matches every file.
  permissions int
  // Filename glob matched against each file's basename (e.g., "*.conf")
  name string
  // Maximum directory depth to descend (find's -maxdepth); unset means unlimited
  depth int
}

// Parse INI configuration files
//
// Sections and key-value pairs parsed from any INI-formatted file.
// Select the file with `parse.ini(path: "/etc/example.ini")`; `sections`
// exposes a map of section name to its key-value map and `params`
// exposes the top-level keys that precede any section header. The
// key-value separator can be overridden for non-standard files.
parse.ini {
  init(path string, delimiter string)
  // Symbol that separates keys and values (defaults to "=")
  delimiter string
  // File that is parsed
  file file
  // Raw content of the file that is parsed
  content(file) string
  // Map of section name to that section's key-value pairs
  sections(content, delimiter) map[string]map[string]string
  // Key-value pairs that appear before any section header
  params(sections) map[string]string
}

// Parse JSON files
//
// Parsed structure of any JSON document on disk. Select the file with
// `parse.json(path: "/etc/example.json")`; `params` holds the decoded
// document as a dict that MQL can traverse and filter.
parse.json {
  init(path string)
  // File that is parsed
  file file
  // Raw content of the file that is parsed
  content(file) string
  // Decoded JSON document as a traversable dict
  params(content) dict
}

// Parse XML files
//
// Parsed structure of any XML document on disk. Select the file with
// `parse.xml(path: "/etc/example.xml")`; `params` holds the decoded
// element tree as a dict that MQL can traverse and filter.
parse.xml {
  init(path string)
  // File that is parsed
  file file
  // Raw content of the file that is parsed
  content(file) string
  // Decoded XML element tree as a traversable dict
  params(content) dict
}

// Parse Apple property list (plist) files
//
// Parsed structure of an XML or binary plist file. Select the file with
// `parse.plist(path: "/Library/Preferences/com.apple.example.plist")`;
// `params` holds the decoded property list as a dict, so macOS
// preference and configuration audits can read individual keys.
parse.plist {
  init(path string)
  // File that is parsed
  file file
  // Raw content of the file that is parsed
  content(file) string
  // Decoded property list as a traversable dict
  params(content) dict
}

// Parse YAML files
//
// Parsed structure of single- or multi-document YAML files. Select the
// file with `parse.yaml(path: "/etc/example.yaml")`; `params` holds the
// first (or only) document as a dict and `documents` holds every
// document in a multi-document (`---` separated) file as a `[]dict`.
parse.yaml {
  init(path string)
  // File that is parsed
  file file
  // Raw content of the file that is parsed
  content(file) string
  // First (or only) YAML document as a traversable dict
  params(content) dict
  // Every document in a multi-document YAML file
  documents(content) []dict
}

// Parse X.509 certificates from files
//
// PEM-encoded certificate chains and bundles parsed into a list of
// `network.certificate` entries. Select the file with
// `parse.certificates(path: "/etc/ssl/certs/ca-bundle.crt")`; each
// resulting certificate exposes its subject, issuer, validity window,
// key usage, and fingerprints for trust-store and expiry audits.
parse.certificates {
  []network.certificate(content, path)
  init(path string)
  // Certificate file path
  path string
  // Certificate file
  file() file
  // Certificate file content
  content(file) string
}

// Parse OpenPGP keys from files
//
// OpenPGP entities (primary keys, identities, and subkeys) parsed from
// a key file. Select the file with
// `parse.openpgp(path: "/etc/pki/rpm-gpg/RPM-GPG-KEY")`; each entity
// exposes its identities and key material for validating trusted
// signing keys.
parse.openpgp {
  []network.openpgp.entity(content)
  init(path string)
  // OpenPGP file
  file file
  // OpenPGP file content
  content(file) string
}

// User account on the system
//
// Single local user account: numeric UID and primary GID (Windows SID
// where applicable), name, home directory, configured login shell, and
// an `enabled` flag. Surfaces the primary `group` reference, the
// `authorizedkeys` resource that parses the user's
// `~/.ssh/authorized_keys`, the SSH private keys discovered in the
// user's home, and a `loggedIn` predicate that reflects whether the
// user currently has an active session. Used for identity audits,
// dormant-account hygiene, and SSH-key inventories.
user @defaults("name uid gid") {
  // User ID
  uid int
  // User's primary group ID
  gid int
  // User's security identifier (Windows)
  sid string
  // Name of the user
  name string
  // Home directory path
  home string
  // Login shell configured for the user (e.g., /bin/bash, /usr/sbin/nologin)
  shell string
  // Whether the account is enabled (not locked or disabled)
  enabled bool
  // Parsed ~/.ssh/authorized_keys for this user
  authorizedkeys(home) authorizedkeys
  // Private SSH keys discovered in the user's home directory
  sshkeys() []privatekey
  // The user's primary group
  group(gid) group
  // Whether the user currently has an active login session
  loggedIn() bool
  // Path to this user's NTUSER.DAT registry hive file (Windows)
  //
  // The per-user registry hive on disk, located at `<home>\NTUSER.DAT`. Pass
  // it together with `sid` to `registrykey`/`registrykey.property` to read a
  // user's HKCU settings even when their hive is not loaded, for example a
  // SYSTEM scan running with no interactive session. Empty on non-Windows
  // platforms or when the home directory is unknown.
  ntuserDat(home) string
}

// Private key on disk
//
// PEM-encoded private key file: the `file` reference, the raw PEM `pem`
// payload, and an `encrypted` flag indicating whether the key is
// passphrase-protected. `publicKeyAlgorithm` and `publicKeyBits`
// describe the key material. Used to inventory SSH or service-account
// keys discovered on the asset and to flag unencrypted private keys
// stored in user home directories.
privatekey {
  // PEM data
  pem string
  // Path to the private key file
  //
  // Deprecated in favor of the `file` field.
  path @maturity("deprecated") string
  // File on disk for this private key
  file file
  // Whether the key material is passphrase-encrypted
  encrypted bool
  // Public key algorithm of the key material (e.g., RSA, ECDSA, Ed25519, DSA)
  publicKeyAlgorithm() string
  // Key size in bits (e.g., 2048, 256, 384, 521)
  publicKeyBits() int
}

// All user accounts configured on the system
//
// Collection of every local `user` on the asset. The entry point for
// fleet-wide identity audits, e.g. asserting that every account with
// UID < 1000 is enabled, that no account shares another's home
// directory, or that no human user has the shell set to `/bin/bash`
// outside an approved list.
users {
  []user
}

// SSH authorized_keys file
//
// Single `authorized_keys` file: its path, the `file` reference, the
// raw `content` string, and the parsed `entry` list where each entry
// surfaces the line number, key type, key material, label, and any
// `command=` / `from=` / `no-port-forwarding` SSH options. Select the
// file by absolute path, for example
// `authorizedkeys(path: "/root/.ssh/authorized_keys")`, or reach it per
// account through the `user` resource, whose `authorizedkeys` field
// resolves each user's `~/.ssh/authorized_keys` automatically (for
// example `users.where(name == "root") { authorizedkeys { list { key } } }`).
// Used to audit which keys actually grant SSH access to a given user and
// to detect entries with no source or command restrictions.
authorizedkeys {
  []authorizedkeys.entry(file, content)
  init(path string)
  // Path to the key file
  path string
  // Key file
  file file
  // Key file content
  content(file) string
}

// SSH authorized key
//
// Single entry from an `authorized_keys` file: the source line number,
// key type, key material, label, and any SSH options such as
// `command=`, `from=`, or `no-port-forwarding`. Used to audit which
// keys grant SSH access to a user and to flag entries that lack source
// or command restrictions.
authorizedkeys.entry @defaults("key") {
  // Line number of the entry in the key file
  line int
  // Key type (e.g., ssh-rsa, ssh-ed25519, ecdsa-sha2-nistp256)
  type string
  // Base64-encoded public key material
  key string
  // Key label or comment (typically user@host)
  label string
  // SSH key options (e.g., command restrictions, source IP limits)
  options []string
  // Key file
  file file
  // Key size in bits (e.g., 2048, 256, 384, 521)
  bits int
}

// Group on the system
//
// Single local group: numeric GID (or SID on Windows), group name, and
// the `members` list of users in the group. Used to audit
// privileged-group membership (`sudo`, `wheel`, `docker`, `adm`, and so
// on) and to confirm only expected accounts are present.
group @defaults("name gid") {
  init(id string)
  // Group ID
  gid int
  // Group's security identifier (Windows)
  sid string
  // Name of this group
  name string
  // Users who are members of this group
  members() []user
}

// All groups configured on the system
//
// Collection of every local `group`. The entry point for fleet-wide
// group-membership audits (every member of a privileged group, no two
// groups sharing a GID, no human user in `wheel` outside an approved
// list, and so on).
groups {
  []group
}

// Installed package on the platform or OS
//
// Single package known to the asset's native package manager (rpm, deb,
// apk, pkg, msi, nuget, pacman, and so on). Surfaces the package name,
// description, currently-installed `version`, architecture, epoch,
// package format, install status, package URL, the CPE list mapping the
// package to NVD identifiers, the package origin, the latest
// `available` version known to the package manager, the `installed` and
// `outdated` flags, the file inventory the package contributed, and the
// package vendor. The unit of asset-level package audits and the join
// key for vulnerability correlation.
package @defaults("name version") {
  // May be initialized with the name only, in which case it will look up
  // The package with the given name on the system.
  init(name string)

  // Name of the package
  name string
  // Package description
  description string
  // Currently installed version of the package
  version string
  // Architecture of this package (e.g., x86_64, arm64, noarch)
  arch string
  // Epoch of this package (version-comparison tiebreaker; empty when unset)
  epoch string

  // Format of this package (e.g., rpm, deb)
  //
  // Empty for an abstract package synthesized from a tool install (see the
  // `package` accessor on tool resources such as `cursor` or `claude.code`):
  // it has no package-manager format and does not appear in `packages`.
  format string
  // Status of this package (e.g., if it is needed)
  status() string
  // Whether the package is held at its current version
  //
  // True when the package manager is configured not to upgrade it: a
  // dpkg or opkg hold, a dnf or yum versionlock, or a zypper lock. An
  // outdated package that is pinned is a deliberate state rather than a
  // missed patch, and it will not receive a security update until the
  // pin is released.
  //
  // Read from the package manager's own files, so it answers the same
  // way on a running host, a container image and a mounted filesystem.
  // Debian's apt preferences are priorities rather than holds and do
  // not set this. False on package managers with no lock mechanism,
  // where it means there is no such thing rather than not checked.
  pinned bool

  // Package URL (purl) identifier for this package
  purl string

  // Common Platform Enumeration (CPE) for the package
  cpes []core.cpe

  // Package origin, may include version if available (optional)
  //
  // Set to "unknown" for an abstract package synthesized from a tool install
  // (see the `package` accessor on tool resources): the installing source
  // could not be identified. A known origin means the package is
  // manager-tracked and listed in `packages`.
  //
  // The exact meaning is per-backend, so compare it against values you know
  // the backend emits rather than across platforms:
  //
  //   flatpak       the remote it was installed from, e.g. "flathub"
  //   freebsd       the ports origin path, e.g. "security/sudo"
  //   netbsd        PKGPATH
  //   macOS         how the bundle was obtained, as classified by Gatekeeper:
  //                 "apple", "mac_app_store", "ios_app_store",
  //                 "identified_developer", or "unknown"
  //
  // On macOS this distinguishes App Store installs from everything else, which
  // matters when choosing an update path: an App Store app cannot be upgraded
  // with `brew upgrade`.
  origin() string

  // Latest version the package manager reports as available
  available string
  // Whether the package is installed
  installed bool
  // Whether a newer version than the installed one is available
  outdated() bool

  // Files this package installed on the asset
  files() []pkgFileInfo

  // Package vendor
  vendor string

  // Package license
  //
  // SPDX license expression (or upstream-reported license string).
  // Eagerly populated where the package manager has it inline (rpm
  // %{LICENSE}, apk APKINDEX, pacman desc); fetched on demand for dpkg
  // (parses /usr/share/doc/<pkg>/copyright). Empty when no source
  // exists (e.g. Windows registry DisplayName).
  license() string

  // Package install date
  //
  // Time the installed version of the package was placed on this asset.
  // Populated from %{INSTALLTIME} (rpm), the install-date field of the
  // xbps database, the InstallDate column of the Windows Uninstall
  // registry, and the install, upgrade and `status installed` lines of
  // the dpkg logs.
  //
  // On dpkg the answer is bounded by what logrotate kept, which
  // distributions ship as twelve monthly copies of /var/log/dpkg.log: a
  // package untouched for longer than that window carries no date. Null
  // on backends with no install-time source at all (apk, pacman, macOS)
  // and on any package whose install was not recorded.
  installDate time
}

// File installed by a package
private pkgFileInfo @defaults("path") {
  // Path to the file
  path string
}

// All packages installed on the system
//
// Collection of every `package` known to the asset's native package
// manager(s). The entry point for fleet-wide patch audits,
// banned-package checks, and inventory exports.
packages {
  []package
}

// PAM (pluggable authentication module) configuration
//
// Aggregate view of the /etc/pam.d service configuration (and the
// legacy single-file /etc/pam.conf). `entries` returns parsed service
// entries keyed by service, each carrying its type, control, and
// module; `modules` deduplicates the modules loaded across every
// service. Used to audit authentication policy, such as which services
// enforce `pam_faillock` or `pam_pwquality`.
pam.conf {
  init(path string)
  // Whether PAM configuration is present on the system
  //
  // True when either the `/etc/pam.d` directory or the `/etc/pam.conf` file
  // exists. Use it to guard PAM audits on hosts that ship no PAM
  // configuration, such as container-optimized OS images.
  exists() bool
  // List of files that make up the PAM configuration
  files() []file
  // The raw PAM configuration (across all files)
  content(files) string
  // Services configured via PAM
  //
  // Deprecated in favor of `entries`, which returns parsed, structured
  // service entries.
  services(files) @maturity("deprecated") map[string][]string
  // Parsed service entries keyed by service name
  entries(files) map[string][]pam.conf.serviceEntry
  // All PAM modules loaded across every service (deduplicated by name)
  modules(entries) []pam.module
}

// A single entry within a PAM service configuration
private pam.conf.serviceEntry @defaults("service module") {
  // Service the entry belongs to
  //
  // The `/etc/pam.d/<service>` file path the line came from, or the service
  // name in the first column when read from the single-file `/etc/pam.conf`.
  service string
  // Line number the entry was read from
  //
  // Zero-based: the first line of the file is 0. Every other lineNumber in
  // this provider counts from 1, including limits.entry, logrotate.entry,
  // crontab.entry, sudoers and modprobe, so subtract nothing here and add
  // nothing there when comparing against a text editor. The value forms part
  // of the entry's identity, so it is kept as it is rather than renumbered.
  lineNumber int
  // PAM entry type (e.g., auth, account, password, session)
  pamType string
  // Control field (e.g., required, requisite, sufficient, optional, or a bracketed [value=action] expression)
  control string
  // PAM module used
  module string
  // Configuration options for pam service entry
  options []string
  // Options parsed into key/value pairs
  //
  // `key=value` options become map entries (key lower-cased); bare flags
  // such as `use_uid` map to an empty string, so `params["use_uid"] != null`
  // works as an existence check. When the same key appears more than once
  // the last occurrence wins, matching how PAM evaluates duplicate options.
  // The raw `options` list is retained unchanged.
  params(options) map[string]string
}

// PAM service configuration
//
// PAM configuration for a single service selected by name, for example
// `pam.conf.service(name: "su")` or `pam.conf.service(name: "sshd")`.
// The service is resolved from its `/etc/pam.d/<name>` file, or from the
// lines naming it in the legacy single-file `/etc/pam.conf`. `entries`
// are the parsed lines for that service and `modules` aggregates the
// modules it loads keyed by name, so audits such as
// `pam.conf.service(name: "su").modules["pam_wheel"].params["use_uid"]`
// work without filtering `pam.conf.entries` by file path.
private pam.conf.service {
  init(name string)
  // Service name (e.g. `su`, `sshd`, `login`)
  name string
  // Path of the configuration file the service is defined in
  //
  // `/etc/pam.d/<name>` on systems that use the pam.d directory, or
  // `/etc/pam.conf` when the service comes from the legacy single file. Empty
  // when no such service is configured.
  path string
  // Parsed entries for this service, in source order
  entries []pam.conf.serviceEntry
  // Modules loaded by this service, keyed by canonical module name
  //
  // Each value aggregates every entry in this service that loads the module
  // (last-write-wins per option), so `modules["pam_wheel"].params["use_uid"]`
  // and `modules["pam_wheel"].enabled` answer module-level questions without
  // iterating `entries`.
  modules() map[string]pam.module
}

// PAM module aggregated view
//
// Single PAM module viewed across every service that loads it. The
// `params` dict merges `key=value` options from every line that uses
// this module (last-write-wins per key) so audits like
// `pam.module("pam_faillock").params["deny"]` work without iterating
// `pam.conf.entries`. `enabled` is true when any service entry loads
// the module with a non-skip control.
//
// Initialize by module name (e.g. `pam.module(name: "pam_faillock")`)
// or iterate `pam.modules` for every distinct module name seen
// across the parsed PAM configuration.
private pam.module @defaults("name enabled entries.length") {
  init(name string)
  // Module name as it appears after `<type> <control>`
  //
  // Examples: `pam_unix`, `pam_faillock`, `pam_pwquality`. The `.so`
  // suffix and any leading path are stripped so lookups by short name
  // work consistently.
  name string
  // All key=value options aggregated across every service entry that loads this module
  //
  // The same option key appearing on multiple lines is last-write-wins
  // in source order (matching how PAM itself evaluates duplicate flags,
  // where the later line wins). Bare options (no `=`) are present in the
  // map with an empty string value so `params["use_authtok"] != null`
  // works as an existence check.
  params map[string]string
  // Whether the module is loaded by any service with a non-skip control
  //
  // True when at least one service entry references this module with a
  // control of `required`, `requisite`, `sufficient`, `optional`, or a
  // bracketed control with `default=ok` / `success=ok`. Always false when
  // every reference is part of a stub or commented-out line.
  enabled bool
  // Every service entry that loads this module
  //
  // The full list across all `/etc/pam.d/*` files, in source order.
  // Each entry carries its originating `service`, `lineNumber`,
  // `pamType`, `control`, and raw `options` so callers can drill back
  // into the underlying line if `params` aggregation isn't enough.
  entries []pam.conf.serviceEntry
}

// OpenSSH server (sshd) namespace
//
// Namespace hosting `sshd.config`, the entry point for auditing the
// OpenSSH server's effective settings and Match blocks.
sshd {}

// OpenSSH server (sshd) configuration
//
// OpenSSH server settings parsed from sshd_config (and any Include
// files), plus the effective values reported by `sshd -T`. Surfaces
// `ciphers`, `macs`, `kexs`, and `hostkeyalgorithms` for cryptographic
// hardening checks, `permitRootLogin` for root-access policy, and
// `blocks` for the conditional Match blocks. Compare the configured
// values (`ciphers`) against the effective ones (`effectiveCiphers`) to
// catch overrides applied at runtime.
sshd.config {
  init(path? string)
  // File of this SSH server configuration
  file() file
  // A list of lexically sorted files making up the SSH server configuration
  files(file) []file
  // Configuration values of this SSH server
  params(file) map[string]string
  // Blocks with match conditions in this SSH server config
  blocks(file) []sshd.config.matchBlock
  // Ciphers configured for this SSH server
  ciphers(params) []string
  // MACs configured for this SSH server
  macs(params) []string
  // Key exchange algorithms configured for this SSH server
  kexs(params) []string
  // Effective ciphers reported by sshd -T
  effectiveCiphers() []string
  // Effective MACs reported by sshd -T
  effectiveMacs() []string
  // Effective key exchange algorithms reported by sshd -T
  effectiveKexs() []string
  // Host keys configured for this SSH server
  hostkeys(params) []string
  // Host key algorithms configured for this SSH server
  hostkeyalgorithms(params) []string
  // PermitRootLogin setting in SSH server
  permitRootLogin(params) []string
}

// A block of SSH server configuration
private sshd.config.matchBlock @defaults("criteria") @context("file.context") {
  // The Match criteria that gate this block (e.g., "User root", "Address 10.0.0.0/8")
  criteria string
  // Configuration values in this block
  params map[string]string
  // Ciphers configured for this SSH server
  ciphers(params) []string
  // MACs configured for this SSH server
  macs(params) []string
  // Key exchange algorithms configured for this SSH server
  kexs(params) []string
  // Host keys configured for this SSH server
  hostkeys(params) []string
  // Host key algorithms configured for this SSH server
  hostkeyalgorithms(params) []string
  // PermitRootLogin setting in SSH server
  permitRootLogin(params) []string
}

// inetd super-server namespace
//
// Namespace hosting `inetd.config`, the entry point for examining which
// network services the inetd super-server launches on demand.
inetd {}

// inetd super-server configuration
//
// Services the inetd (or compatible) super-server is configured to
// launch on demand. Each active entry pairs a service with its socket
// type, protocol, wait mode, run-as user, and server program. The
// configuration is assembled from /etc/inetd.conf together with any
// drop-in files under /etc/inetd.d. A missing configuration yields no
// entries, so audits such as serviceNames.none("ftp") hold trivially on
// systems that don't run inetd.
inetd.config {
  init(path? string)
  // Primary inetd configuration file
  file() file
  // All files making up the inetd configuration (main file and drop-ins)
  files(file) []file
  // Merged contents of all configuration files
  content(files) string
  // Active service entries
  entries(files) []inetd.config.entry
  // Names of the active services
  serviceNames(entries) []string
}

// inetd service entry
//
// Single active inetd service line: the service it exposes and how
// inetd launches it. The name field selects the service as it appears
// in the first column of inetd.conf, for example
// inetd.config.entries.where(name == "ftp"). Entries that are commented
// out with a leading # are disabled and excluded.
private inetd.config.entry @defaults("name protocol server") @context("file.context") {
  // Service name or port (first column)
  name string
  // Socket type, such as stream, dgram, or raw
  socketType string
  // Transport protocol, such as tcp, udp, tcp6, or udp6
  protocol string
  // Wait mode, either wait or nowait, with an optional max-connections suffix
  wait string
  // User the server runs as, with an optional group suffix
  user string
  // Server program path, or "internal" for built-in services
  server string
  // Arguments passed to the server program
  arguments string
}

// Net-SNMP daemon (snmpd) namespace
//
// Namespace hosting `snmpd.config`, the entry point for examining the
// effective SNMP daemon configuration.
snmpd {}

// Net-SNMP daemon (snmpd) configuration
//
// snmpd.conf settings that govern SNMP access: community strings, VACM
// users, and listen addresses. The configuration is assembled from the
// main snmpd.conf together with any drop-in files under snmpd.conf.d and
// files pulled in by includeFile and includeDir directives. A missing
// configuration yields empty accessors, so audits such as
// rwCommunities == [] hold trivially on hosts that don't run snmpd.
snmpd.config {
  init(path? string)
  // Primary snmpd configuration file
  file() file
  // All files making up the SNMP daemon configuration (main file, drop-ins, and includes)
  files(file) []file
  // Merged contents of all configuration files
  content(files) string
  // Read-only community strings, from rocommunity and rocommunity6 directives
  roCommunities(content) []string
  // Read-write community strings, from rwcommunity and rwcommunity6 directives
  rwCommunities(content) []string
  // Read-only VACM users, from rouser directives
  roUsers(content) []string
  // Read-write VACM users, from rwuser directives
  rwUsers(content) []string
  // Addresses snmpd listens on, from agentAddress directives
  agentAddresses(content) []string
}

// auditd (Linux Audit Daemon) global configuration
//
// /etc/audit/auditd.conf parameters as a key-value map, covering log
// rotation, disk-space thresholds, and failure actions. `params` keys
// such as max_log_file, space_left_action, and disk_full_action drive
// audit-logging hardening checks.
auditd.config {
  init(path? string)
  // File of this auditd configuration
  file() file
  // Configuration values of this config
  params(file) map[string]string
}

// auditd (Linux Audit Daemon) ruleset on disk
//
// Kernel audit ruleset as loaded from the on-disk rule files, broken
// out into three families: controls (daemon and buffer settings), file
// watches, and syscall rules. By default the rule files under
// /etc/audit/rules.d are read and merged in filename order; pass a path
// to point at a different file or directory. Use this to confirm that
// required watches (for example on /etc/shadow or /etc/sudoers) and
// syscall audits mandated by a hardening baseline are present.
auditd.rules {
  // Directory or file the rules are read from (defaults to /etc/audit/rules.d)
  path() string
  // Control rules (buffer size, failure mode, and other daemon settings)
  controls(path) []auditd.rule.control
  // File watch rules (-w entries)
  files(path) []auditd.rule.file
  // Syscall audit rules (-a entries)
  syscalls(path) []auditd.rule.syscall
}

// auditd (Linux Audit Daemon) rule
private auditd.rule {}

// auditd (Linux Audit Daemon) rule for a control
//
// Control setting from the ruleset, split into a flag and an optional
// value. For example `--backlog_wait_time 60000` becomes
// {flag: "--backlog_wait_time", value: "60000"}, `-b 8192` becomes
// {flag: "-b", value: "8192"}, and a valueless `-D` (delete all rules)
// becomes {flag: "-D", value: nil}.
private auditd.rule.control @defaults("flag value") {
  // Control flag, the first token including any leading `-` (e.g. "-b", "--backlog_wait_time")
  flag string
  // Value following the flag, or null for valueless controls like -D
  value string
}

// auditd (Linux Audit Daemon) rule for a file
//
// File watch rule (-w) describing a path auditd monitors, the access
// types that trigger an event, and the key that tags matching records.
// For example `-w /etc/shadow -p rw -k shadow_access` becomes
// {path: "/etc/shadow", permissions: "rw", keyname: "shadow_access"}.
private auditd.rule.file @defaults("path permissions") {
  // Watched path (the argument to -w)
  path string
  // Access types that trigger the watch (from -p): any of r, w, x, a
  permissions string
  // Key tagging records this rule produces (from -k), for filtering audit logs
  keyname string
}

// auditd (Linux Audit Daemon) rule for a syscall
//
// Syscall audit rule (-a) that fires on the listed system calls when the
// field filters match. For example
// `-a always,exit -F arch=b32 -F auid>=1000 -F auid!=unset` becomes
//  => {
//    action: "always",
//    list: "exit",
//    syscalls: [],
//    field_entries: [
//      key="arch" op="=" value="b32"
//      key="auid" op=">=" value="1000"
//      key="auid" op="!=" value="unset"
//    ],
//    keyname: nil,
// }
private auditd.rule.syscall @defaults("action list") {
  // Action taken when the rule matches (from -a): "always" or "never"
  action string
  // Rule list the action applies to (second value of -a): exit, task, user, exclude, or filesystem
  list string
  // System calls this rule matches (from -S); empty when the rule matches all syscalls
  syscalls []string
  // Raw field filters (from -F), each entry a {key, op, value} dict
  fields []dict
  // Inter-field comparisons (from -C), each entry a {key, op, value} dict
  comparisons []dict
  // Key tagging records this rule produces (from -k), for filtering audit logs
  keyname string
  // CPU architecture this rule is restricted to
  //
  // The value of the `-F arch=` filter, normally `b64` or `b32`. Empty when
  // the rule has no architecture filter and therefore applies to all
  // architectures.
  arch string
  // Minimum audit UID this rule is restricted to
  //
  // The threshold N from a `-F auid>=N` filter, commonly `1000` to target
  // interactive users above the system UID range. Null when the rule has no
  // `auid>=` filter.
  auidMin int
  // Whether the rule excludes events with an unset audit UID
  //
  // True when the rule carries a `-F auid!=unset` filter (also matching the
  // raw sentinels `4294967295` and `-1`), which drops events from daemons
  // and other processes that never had a login UID assigned.
  excludesUnsetAuid bool
}

// Apache2 HTTP Server
//
// Apache HTTP Server daemon version as reported by the apache2/httpd
// binary. Use apache2.conf for the parsed configuration, including
// directives, loaded modules, virtual hosts, and access-control blocks.
apache2 {
  // Apache2 version (e.g., "2.4.62")
  version() string
}

// Apache2 HTTP Server configuration
//
// Parsed Apache configuration covering flat directives, loaded modules,
// virtual hosts, and Directory / Location access-control blocks, merged
// across the main config and every Include fragment. Also surfaces
// hardening-relevant settings such as ServerTokens, ServerSignature,
// TraceEnable, and response security headers. Pass `init(path: "...")`
// to point at a non-default config file.
apache2.conf {
  init(path? string)
  // Primary configuration file
  file() file
  // All configuration files (main + included fragments)
  files(file) []file
  // Flat key-value directives from the configuration
  params(file) map[string]string
  // Listen addresses/ports
  listenAddresses(params) []string
  // Loaded modules (LoadModule directives)
  modules(file) []apache2.conf.module
  // VirtualHost blocks
  virtualHosts(file) []apache2.conf.virtualHost
  // Directory blocks
  directories(file) []apache2.conf.directory
  // <Location> blocks (URL-space access rules)
  locations(file) []apache2.conf.location
  // Environment variables sourced by Apache at startup (e.g. Debian's /etc/apache2/envvars)
  envvars() apache2.conf.envvars
  // ServerTokens disclosure level (Full, OS, Minimal, Minor, Major, Prod)
  serverTokens(params) string
  // ServerSignature footer mode (On, Off, EMail)
  serverSignature(params) string
  // TraceEnable directive value (on, off, extended)
  traceEnable(params) string
  // Response headers added via `Header always set NAME VALUE` (header name -> values)
  securityHeaders(file) map[string][]string
}

// Apache2 environment variables (e.g. Debian's /etc/apache2/envvars)
private apache2.conf.envvars @defaults("file.path") {
  init(path? string)
  // File defining the environment variables
  file() file
  // Parsed variable assignments (after shell expansion)
  params(file) map[string]string
}

// Apache2 loaded module
private apache2.conf.module @defaults("name") {
  // Module name (e.g., "ssl_module")
  name string
  // Shared object path (e.g., "modules/mod_ssl.so")
  path string
}

// Apache2 VirtualHost block
private apache2.conf.virtualHost @defaults("address serverName ssl") {
  // VirtualHost address (e.g., "*:443")
  address string
  // ServerName directive
  serverName string
  // ServerAlias names (one entry per name across one or more ServerAlias lines)
  serverAliases []string
  // DocumentRoot directive
  documentRoot string
  // Whether SSL is enabled (SSLEngine on)
  ssl bool
  // SSLProtocol directive value (e.g., "all -SSLv3 -TLSv1 -TLSv1.1")
  sslProtocol string
  // SSLCipherSuite directive value
  sslCipherSuite string
  // SSLHonorCipherOrder directive value (true when "on")
  sslHonorCipherOrder bool
  // Path to the server certificate (SSLCertificateFile)
  sslCertificateFile string
  // Path to the server private key (SSLCertificateKeyFile)
  sslCertificateKeyFile string
  // Path to the certificate chain (SSLCertificateChainFile, deprecated in favor of full chain in SSLCertificateFile)
  sslCertificateChainFile string
  // X.509 certificates parsed from sslCertificateFile (empty if the file is unreadable)
  certificate() []network.certificate
  // Redirect / RedirectMatch directives within this VirtualHost (target, status, match)
  redirects []dict
  // All directives within this VirtualHost
  params map[string]string
}

// Apache2 Directory block
private apache2.conf.directory @defaults("path") {
  // Directory path the <Directory> block applies to
  path string
  // Options directive value (e.g., "Indexes FollowSymLinks")
  options string
  // AllowOverride directive value (which .htaccess directives are honored, e.g. "None", "All")
  allowOverride string
  // Require directive values (one entry per Require line), the access-control grants for the block
  require []string
  // All directives within this Directory block
  params map[string]string
}

// Apache2 <Location> block: URL-space access rules
private apache2.conf.location @defaults("path") {
  // Location path or regex the block matches
  path string
  // Whether this block was defined with <LocationMatch> (regex form) instead of <Location>
  isMatch bool
  // AuthType directive value (None, Basic, Digest, ...)
  authType string
  // AuthName directive value (realm)
  authName string
  // Require directive values (one entry per Require line), the access-control grants for the block
  require []string
  // ProxyPass target, if set
  proxyPass string
  // All directives within this Location block
  params map[string]string
}

// BIND 9 DNS Server
//
// Parsed named.conf configuration with every include expanded, which is
// where distributions keep the parts worth auditing: named.conf.options
// and named.conf.local on Debian and Ubuntu, /etc/named.conf.local on
// Red Hat. Covers the global options block, every zone declared at the
// top level or inside a view, named address-match lists, and TSIG keys.
// The files field lists every file that contributed, so permission and
// ownership checks reach the whole configuration rather than the entry
// point. Pass a path, as in `bind9("/etc/named.conf")`, to read a config
// outside the default locations.
bind9 {
  init(path? string)
  // Primary configuration file
  file() file
  // Every file that contributes to the running configuration
  //
  // The primary file plus each one it pulls in, directly or through a
  // chain of includes, so ownership and permission checks cover the
  // fragments a zone or a key is actually declared in.
  files() []file
  // Whether the server answers recursive queries
  //
  // BIND defaults to recursion for a server that does not say otherwise,
  // so this reads true when the statement is absent. An authoritative
  // server that has not turned recursion off is an open resolver.
  recursion() bool
  // dnssec-validation setting ("yes", "no", or "auto"; empty when unset)
  dnssecValidation() string
  // Working directory for relative paths (directory)
  directory() string
  // Version string reported in a version.bind query
  //
  // Empty when the statement is absent, which means the real version is
  // reported. A server that hides it sets this, often to "".
  version() string
  // minimal-responses setting ("yes", "no", "no-auth", or "no-auth-recursive")
  minimalResponses() string
  // Hosts allowed to query the server (allow-query)
  allowQuery() []string
  // Hosts allowed to query recursively (allow-recursion)
  allowRecursion() []string
  // Hosts allowed to transfer zones (allow-transfer)
  //
  // An unrestricted transfer hands a copy of every zone to anyone who
  // asks, which is why hardening guidance starts here.
  allowTransfer() []string
  // Hosts allowed to submit dynamic updates (allow-update)
  allowUpdate() []string
  // Addresses the server listens on for IPv4 (listen-on)
  listenOn() []string
  // Port the IPv4 listener is bound to
  //
  // The port modifier of listen-on, as in `listen-on port 5353 { ... }`.
  // 0 when the statement does not set one, in which case BIND listens on
  // 53.
  listenOnPort() int
  // Addresses the server listens on for IPv6 (listen-on-v6)
  listenOnV6() []string
  // Port the IPv6 listener is bound to
  //
  // 0 when listen-on-v6 does not set one, in which case BIND listens on
  // 53.
  listenOnV6Port() int
  // Secondaries notified of zone changes beyond the zone NS records (also-notify)
  //
  // Notifications carry the fact that a zone changed, so the list is
  // worth checking against the secondaries that are supposed to receive
  // them.
  alsoNotify() []string
  // Servers queries are forwarded to (forwarders)
  forwarders() []string
  // Every scalar statement of the options block, as written
  //
  // Carries the settings without a field of their own here, so a check
  // can reach a statement this resource does not model. A list-valued
  // statement is not in here: its value is a block, and flattening it to
  // a string would invent a value the file does not have.
  params() map[string]string
  // Zones this server answers for
  //
  // Zones declared at the top level and inside every view. The view a
  // zone belongs to is on the zone itself, so a server that splits its
  // answers still reports one list.
  zones() []bind9.zone
  // Named address-match lists declared with acl
  acls() []bind9.acl
  // TSIG keys declared with key
  //
  // A key reports its name and algorithm. The shared secret is left
  // behind, so this field carries no key material. The file the key is
  // declared in is still a file like any other, and its content is
  // readable through it.
  keys() []bind9.key
  // Logging channels declared inside the logging block
  channels() []bind9.channel
  // DNSSEC key files found on disk
  //
  // The key pairs `dnssec-keygen` writes, looked for in the key-directory
  // option, then the working directory, then the well-known locations. No
  // named.conf statement names them individually, so they are found rather
  // than declared.
  dnssecKeys() []bind9.dnssecKey
  // Logging categories and the channels each is sent to
  //
  // The category name maps to its channel list, so `queries` mapping to
  // a channel is what says query logging is on.
  logCategories() map[string][]string
}

// BIND 9 zone
//
// One zone declaration. The name field selects the zone as it appears in
// named.conf, for example `bind9.zones.where(name == "example.com")`.
private bind9.zone @defaults("name type view") {
  // Zone name, e.g. "example.com" or "." for the root hints
  name string
  // Zone class, "IN" when the declaration omits it
  class string
  // View the zone is declared in, empty for a top-level zone
  view string
  // Zone type, e.g. "master", "primary", "slave", "secondary", "hint", "forward", or "stub"
  type string
  // Zone file as written in the declaration, relative or absolute
  path string
  // Zone file, resolved against the directory option when relative
  //
  // Null when the zone declares no file, as a forward or stub zone does.
  file() file
  // Hosts allowed to transfer this zone (allow-transfer)
  allowTransfer []string
  // Hosts allowed to submit dynamic updates for this zone (allow-update)
  allowUpdate []string
  // Hosts allowed to query this zone (allow-query)
  allowQuery []string
  // Servers this zone is transferred from (primaries, or masters on older configurations)
  primaries []string
  // Secondaries notified of changes to this zone (also-notify)
  alsoNotify []string
  // Every scalar statement in the zone declaration, as written
  params map[string]string
}

// BIND 9 address-match list
//
// A list declared with acl and referenced by name from the options block
// or a zone, so a check that resolves a name like "trusted" can see what
// it stands for.
private bind9.acl @defaults("name") {
  // ACL name
  name string
  // Entries of the list, e.g. "localhost", "10.0.0.0/8", or "!192.0.2.1"
  entries []string
}

// BIND 9 TSIG key
//
// A key used to authenticate transfers, dynamic updates, and rndc. The
// shared secret is not among the fields.
private bind9.key @defaults("name algorithm view") {
  // File the key statement was declared in
  //
  // A TSIG key is commonly kept in a file of its own that named.conf
  // includes, and that file is what an ownership or permission check reads.
  // The shared secret is still not exposed: this is the file, not its
  // contents. A key declared inline reports the configuration file it sits
  // in, which is the honest answer but is not a dedicated key file.
  file() file
  // Key name
  name string
  // View the key is declared in, empty for a top-level key
  //
  // A key statement is legal inside a view, and two views may declare
  // different keys under the same name, so the view is part of what
  // identifies a key rather than a detail of it.
  view string
  // Signing algorithm, e.g. "hmac-sha256"
  algorithm string
}

// BIND 9 logging channel
//
// One channel of the logging block, naming where records go and how much
// of them is kept.
private bind9.channel @defaults("name severity") {
  // Channel name
  name string
  // Destination file, empty when the channel logs to syslog, stderr, or null
  path string
  // Destination when it is not a file: "syslog", "stderr", or "null"
  target string
  // Rotated copies of the log file that are kept (versions)
  //
  // -1 when the channel keeps unlimited copies, and 0 when the modifier
  // is absent, which is not the same: without it BIND keeps a single file
  // and never rotates.
  versions int
  // Size at which the log file is rotated, in bytes (size)
  //
  // The k, m and g suffixes are expanded, so `size 5m` reads 5242880.
  // -1 when the channel says unlimited, 0 when the modifier is absent.
  sizeLimit int
  // Severity threshold, e.g. "info", "notice", "warning", or "debug"
  severity string
  // Syslog facility when the channel logs to syslog
  syslogFacility string
  // Whether each record carries its timestamp (print-time)
  printTime bool
  // Whether each record carries its category (print-category)
  printCategory bool
  // Whether each record carries its severity (print-severity)
  printSeverity bool
}

// A DNSSEC key pair on disk
//
// One entry per `K<zone>.+<algorithm>+<tag>.key` file `dnssec-keygen` wrote.
// The private half is reported as a file so its mode and owner can be
// checked; its contents are never read.
private bind9.dnssecKey @defaults("zone keyTag isKeySigningKey") {
  // Zone the key was generated for
  zone string
  // Key tag, the numeric id in the file name
  keyTag int
  // DNSSEC algorithm number, for example 13 for ECDSAP256SHA256
  algorithm int
  // Whether this is a key signing key rather than a zone signing key
  //
  // Read from the DNSKEY flags field: 257 is a key signing key, 256 a zone
  // signing key.
  isKeySigningKey bool
  // When the key was generated
  //
  // Null when the file records no Created: line.
  created time
  // The public key file
  file() file
  // The private key file
  //
  // Always returned, because its path is known whether or not the file is
  // there: ask `privateFile.exists`. A key signing key whose private half
  // has been moved off the server -- the state worth checking for -- reports
  // a file that does not exist, which is a different thing from a key with
  // no private half defined at all. The key material is never read.
  privateFile() file
}

// Nginx HTTP Server
//
// Nginx daemon version and the modules compiled into the binary. Use
// nginx.conf for the parsed configuration, including server blocks,
// upstream pools, and listen addresses.
nginx {
  // Nginx version (e.g., "1.25.3")
  version() string
  // Compiled-in modules from configure arguments
  modules() []string
}

// Nginx HTTP Server configuration
//
// Parsed Nginx configuration covering flat directives, per-server
// blocks, upstream backend pools, and listen addresses, merged across
// the main config and every include fragment. Surfaces TLS settings and
// response headers per server block for hardening audits. TCP and UDP
// proxying declared in the stream block is covered by streamParams,
// streamServers, and streamUpstreams. Pass `init(path: "...")` to point
// at a non-default config file.
nginx.conf {
  init(path? string)
  // Primary configuration file
  file() file
  // All configuration files (main + included fragments)
  files(file) []file
  // Flat key-value directives from main + http context
  params(file) map[string]string
  // User directive
  user(params) string
  // Worker processes setting
  workerProcesses(params) string
  // Error log path
  errorLog(params) string
  // Listen addresses/ports across the http server blocks
  listenAddresses(file) []string
  // HTTP-level directives (inside http block, outside server blocks)
  httpParams(file) map[string]string
  // Server blocks
  servers(file) []nginx.conf.server
  // Upstream blocks
  upstreams(file) []nginx.conf.upstream
  // Stream-level directives (inside stream block, outside server blocks)
  streamParams(file) map[string]string
  // Server blocks inside the stream block
  //
  // TCP and UDP proxy listeners. Each carries its own listen address and
  // TLS settings, so protocol and cipher checks reach mail, database, and
  // other non-HTTP traffic that Nginx terminates.
  streamServers(file) []nginx.conf.server
  // Upstream blocks inside the stream block
  //
  // Backend pools for TCP and UDP proxying, with the load-balancing
  // method and the per-backend weight, failure threshold, and backup or
  // down state of each member.
  streamUpstreams(file) []nginx.conf.upstream
}

// Nginx server block
private nginx.conf.server @defaults("serverName ssl") {
  // Server name(s)
  serverName string
  // Listen directives (comma-separated if multiple)
  listen string
  // Listen directives broken out per declaration (port, ssl, http2, udp, defaultServer, proxyProtocol, address, raw)
  listens []dict
  // Document root
  root string
  // Whether SSL is configured (any listen line carries `ssl`, or ssl_certificate is set)
  ssl bool
  // ssl_protocols directive value (e.g., "TLSv1.2 TLSv1.3")
  sslProtocols string
  // ssl_ciphers directive value
  sslCiphers string
  // Path to the server certificate (ssl_certificate)
  sslCertificate string
  // Path to the server private key (ssl_certificate_key)
  sslCertificateKey string
  // ssl_prefer_server_ciphers directive value (true when "on")
  sslPreferServerCiphers bool
  // ssl_session_tickets directive value ("on"/"off"; empty if unset)
  sslSessionTickets string
  // ssl_session_timeout directive value (e.g., "1d")
  sslSessionTimeout string
  // X.509 certificates parsed from sslCertificate (empty if the file is unreadable)
  certificate() []network.certificate
  // Response headers from `add_header NAME VALUE` directives (header name -> values)
  addHeaders map[string][]string
  // Location blocks
  locations []nginx.conf.location
  // server_tokens directive value (on/off/build)
  serverTokens string
  // All directives within this server block
  params map[string]string
}

// Nginx upstream block
private nginx.conf.upstream @defaults("name loadBalancingMethod") {
  // Upstream group name
  name string
  // Backend server addresses (raw `server` directive arguments)
  servers []string
  // Parsed backend entries (address, weight, maxFails, failTimeout, backup, down, slowStart, route)
  serverDetails []dict
  // Load-balancing method (round_robin, least_conn, ip_hash, hash, random, least_time)
  loadBalancingMethod string
  // keepalive directive value (idle connections per worker; 0 if unset)
  keepalive int
  // All directives within this upstream block
  params map[string]string
}

// Nginx location block
private nginx.conf.location @defaults("path") {
  // Location path or pattern (excluding modifier)
  path string
  // Location modifier ("=", "~", "~*", "^~", or "" for prefix-default)
  modifier string
  // Proxy pass target
  proxyPass string
  // Document root override
  root string
  // try_files directive value
  tryFiles string
  // return directive value
  //
  // Deprecated in favor of returnDirective, which carries the same value.
  // The name return collides with an MQL keyword, so this field cannot be
  // read from inside a block: a query such as
  // `nginx.conf.servers { locations { return } }` compiles but never reads
  // it. Only dotted access still works.
  return @maturity("deprecated") string
  // return directive value
  //
  // Status code plus the redirect URI or response text, as written in the
  // location block. For example "301 https://example.com$request_uri" for a
  // permanent redirect, or "444" for a connection that is closed without a
  // response. Empty when the location block has no return directive.
  returnDirective string
  // fastcgi_pass directive value
  fastcgiPass string
  // All directives within this location block
  params map[string]string
}

// Apache Tomcat
//
// Locates a Tomcat installation through CATALINA_HOME / CATALINA_BASE and
// exposes its on-disk configuration: server.xml, the global web.xml and
// context.xml, catalina.properties, logging.properties, tomcat-users.xml,
// and the applications deployed under each Host's appBase. Nothing here
// needs a running JVM, so it also works against container images and
// filesystem snapshots.
//
// Every nested collection (services, connectors, engines, hosts, valves,
// realms, listeners, contexts, users, webapps) is a list whenever the
// element is present — including when the XML holds exactly one — and an
// empty list when it is absent. It is never null and never a bare map, so a
// check written against a single-Connector server keeps working when a
// second Connector is added.
//
// Pass `init(home: "...", base: "...")` to point at a non-default layout.
tomcat @defaults("home version") {
  init(home? string, base? string)
  // Installation directory (CATALINA_HOME); empty when no installation is found
  home() string
  // Instance directory (CATALINA_BASE); equals home in a single-instance install
  base() string
  // Tomcat version (e.g., "10.1.34"); empty when it cannot be read from disk
  version() string
  // Parsed conf/server.xml; null when the installation has none
  server() tomcat.server
  // Parsed conf/web.xml, the global deployment descriptor; null when absent
  webXml() tomcat.webxml
  // Parsed conf/context.xml, the global context defaults; null when absent
  context() tomcat.context
  // conf/catalina.properties, with ${catalina.home} / ${catalina.base} expanded
  properties() map[string]string
  // conf/logging.properties, with ${catalina.home} / ${catalina.base} expanded
  logging() map[string]string
  // Users declared in conf/tomcat-users.xml
  users() []tomcat.user
  // Applications deployed under each Host's appBase (exploded directories)
  webapps() []tomcat.webapp
}

// Tomcat <Server> element of server.xml
private tomcat.server @defaults("port shutdown") {
  // File the server configuration was parsed from
  file file
  // Shutdown port (@port); -1 disables the shutdown listener, 0 when unset
  port int
  // Shutdown command string (@shutdown)
  shutdown string
  // <Listener> children of <Server>
  listeners []tomcat.listener
  // <Service> children of <Server>
  services []tomcat.service
}

// Tomcat <Listener> element
private tomcat.listener @defaults("className") {
  // Listener implementation class (@className)
  className string
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// Tomcat <Service> element
private tomcat.service @defaults("name") {
  // Service name (@name)
  name string
  // <Connector> children
  connectors []tomcat.connector
  // <Engine> children
  engines []tomcat.engine
}

// Tomcat <Connector> element
//
// Boolean and numeric fields carry Tomcat's documented default when the
// attribute is absent, so they describe the connector's effective behavior.
// Use `params` to tell an absent attribute from an explicitly declared one.
private tomcat.connector @defaults("port protocol sslEnabled") {
  // Listen port (@port)
  port int
  // Bind address (@address); empty binds every address
  address string
  // Protocol handler or, on older configurations, the TLS version (@protocol)
  protocol string
  // Whether TLS is enabled on this connector (@SSLEnabled); false when unset
  sslEnabled bool
  // Request scheme reported to the application (@scheme)
  scheme string
  // Whether requests are reported as secure (@secure); false when unset
  secure bool
  // Whether the TRACE method is accepted (@allowTrace); false when unset
  allowTrace bool
  // Whether an X-Powered-By response header is sent (@xpoweredBy); false when unset
  xpoweredBy bool
  // Whether remote host names are resolved via DNS (@enableLookups); false when unset
  enableLookups bool
  // Idle timeout in milliseconds (@connectionTimeout); 60000 when unset
  connectionTimeout int
  // Maximum request header size in bytes (@maxHttpHeaderSize); 8192 when unset
  maxHttpHeaderSize int
  // Server response header override (@server); empty leaves Tomcat's own value
  server string
  // Permitted cipher suites (@ciphers)
  ciphers string
  // TLS version, in the single-protocol spelling (@sslProtocol)
  sslProtocol string
  // TLS versions, in the list spelling (@sslEnabledProtocols / @SSLEnabledProtocols)
  sslEnabledProtocols string
  // Client certificate requirement (@clientAuth: true, false, want)
  clientAuth string
  // Nested <SSLHostConfig> elements
  //
  // Each entry holds the element's attributes plus a `certificates` list
  // carrying the attributes of its <Certificate> children.
  sslHostConfigs []dict
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// Tomcat <Engine> element
private tomcat.engine @defaults("name") {
  // Engine name (@name)
  name string
  // Host that serves requests for unrecognized names (@defaultHost)
  defaultHost string
  // <Host> children
  hosts []tomcat.host
  // <Realm> children
  realms []tomcat.realm
  // <Valve> children
  valves []tomcat.valve
}

// Tomcat <Host> element
//
// Boolean fields carry Tomcat's documented default when the attribute is
// absent — autoDeploy, deployOnStartup, deployXML and unpackWARs all default
// to true. Use `params` to tell an absent attribute from a declared one.
private tomcat.host @defaults("name appBase") {
  // Host name (@name)
  name string
  // Application base directory (@appBase), as written
  appBase string
  // Absolute application base directory, resolved against CATALINA_BASE
  appBaseDir string
  // Whether applications are deployed while running (@autoDeploy); true when unset
  autoDeploy bool
  // Whether applications are deployed at startup (@deployOnStartup); true when unset
  deployOnStartup bool
  // Whether an application's META-INF/context.xml is honored (@deployXML); true when unset
  deployXML bool
  // Whether WAR files are expanded on deployment (@unpackWARs); true when unset
  unpackWARs bool
  // <Valve> children
  valves []tomcat.valve
  // <Context> children declared inline on this Host
  contexts []tomcat.context
}

// Tomcat <Valve> element, wherever it is declared (Engine, Host or Context)
private tomcat.valve @defaults("className") {
  // Valve implementation class (@className)
  className string
  // Access log format (@pattern, AccessLogValve)
  pattern string
  // Log directory (@directory, AccessLogValve), with ${catalina.*} expanded
  directory string
  // Log file name prefix (@prefix, AccessLogValve)
  prefix string
  // Log file name suffix (@suffix, AccessLogValve)
  suffix string
  // Whether error pages disclose the server version (@showServerInfo, ErrorReportValve); true when unset on an ErrorReportValve
  showServerInfo bool
  // Whether error pages disclose stack traces (@showReport, ErrorReportValve); true when unset on an ErrorReportValve
  showReport bool
  // Allowed clients (@allow, RemoteAddrValve / RemoteCIDRValve / RemoteHostValve)
  allow string
  // Denied clients (@deny, RemoteAddrValve / RemoteCIDRValve / RemoteHostValve)
  deny string
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// Tomcat <Realm> element
//
// Realms nest: a LockOutRealm wraps the realm that actually authenticates,
// so `realms` walks the inner realms instead of leaving them unreachable.
private tomcat.realm @defaults("className") {
  // Realm implementation class (@className)
  className string
  // Password digest algorithm (@digest)
  digest string
  // Directory connection URL (@connectionURL, JNDIRealm / DataSourceRealm)
  connectionURL string
  // Failed attempts before lockout (@failureCount, LockOutRealm); 0 when unset
  failureCount int
  // Lockout duration in seconds (@lockOutTime, LockOutRealm); 0 when unset
  lockOutTime int
  // Nested <Realm> children
  realms []tomcat.realm
  // <CredentialHandler> children, each as its attributes
  credentialHandlers []dict
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// Tomcat <Context> element
//
// The same element appears in three places — inline on a Host in server.xml,
// as the global defaults in conf/context.xml, and as an application's
// META-INF/context.xml — and this resource gives all three one shape. `file`
// reports which of them it was parsed from.
private tomcat.context @defaults("path privileged crossContext") {
  // File the context was parsed from
  file file
  // Context path (@path), empty when the element does not declare one
  path string
  // Whether the application may use container internals (@privileged); false when unset
  privileged bool
  // Whether the application may access other contexts (@crossContext); false when unset
  crossContext bool
  // Whether the effective web.xml is written to the log (@logEffectiveWebXml); false when unset
  logEffectiveWebXml bool
  // Whether the nested <Resources> element permits symlinks (@allowLinking); false when unset
  allowLinking bool
  // <Valve> children
  valves []tomcat.valve
  // All attributes of the <Context> element, verbatim and unexpanded
  params map[string]string
}

// Tomcat deployment descriptor (conf/web.xml or an application's WEB-INF/web.xml)
//
// Nested XML is exposed as dicts whose keys are the camelCase spelling of the
// element name, so `<transport-guarantee>` reads as `transportGuarantee`.
private tomcat.webxml @defaults("file.path") {
  // File the descriptor was parsed from
  file file
  // Whether annotation scanning is disabled (web-app/@metadata-complete)
  metadataComplete bool
  // <error-page> entries (errorCode, exceptionType, location)
  errorPages []dict
  // <security-constraint> entries (displayName, webResourceCollections, authConstraint, userDataConstraint)
  securityConstraints []dict
  // <login-config> (authMethod, realmName, formLoginPage, formErrorPage); empty when the element is absent
  loginConfig dict
  // Session timeout in minutes (session-config/session-timeout); 0 when unset
  sessionTimeout int
  // Whether session cookies are HttpOnly (session-config/cookie-config/http-only); false when absent
  cookieHttpOnly bool
  // Whether session cookies are Secure (session-config/cookie-config/secure); false when absent
  cookieSecure bool
  // <servlet> entries, joined with their <servlet-mapping>
  //
  // Keys: name, class, jspFile, loadOnStartup, initParams, urlPatterns.
  // initParams is a list of {name, value} entries so that a parameter declared
  // twice is not collapsed to one.
  servlets []dict
  // <filter> entries, joined with their <filter-mapping>
  //
  // Keys: name, class, initParams, urlPatterns.
  filters []dict
}

// Tomcat user declared in conf/tomcat-users.xml
private tomcat.user @defaults("username roles") {
  // User name (@username)
  username string
  // Password or password digest as stored (@password)
  password string
  // Roles granted to the user (@roles, split on commas)
  roles []string
}

// Application deployed under a Tomcat Host's appBase
private tomcat.webapp @defaults("name path") {
  // Application directory name, which is also its context path segment
  name string
  // Absolute directory on disk
  path string
  // Name of the Host the application is deployed under
  host string
  // META-INF/context.xml, or null when the application does not ship one
  context() tomcat.context
  // WEB-INF/web.xml, or null when the application does not ship one
  webXml() tomcat.webxml
  // WEB-INF/classes/logging.properties, with ${catalina.*} expanded
  logging() map[string]string
}

// Internet Information Services web server
//
// IIS installation on a Windows host: the websites it serves, the application
// pools that run them, and the configuration in force at each level. Values
// are reported as IIS resolves them, after machine.config, the root web.config,
// applicationHost.config, location sections, a site's own web.config and a
// nested application's web.config have all been applied in order. A setting a
// site or application overrides therefore reads with the overriding value, not
// the one applicationHost.config declares.
//
// On a host that does not run IIS, `installed` is false, `config` and
// `applicationHost` are null, and `sites` and `appPools` are empty. An empty
// list satisfies `all()`, so a check that iterates sites needs a
// `iis.sites.length > 0` guard or an `iis.installed` filter to avoid passing on
// a host that serves nothing.
iis {
  // Whether the web server is present on this host
  //
  // True when the shared configuration file and the IIS management assembly are
  // both present under %windir%\system32\inetsrv. The assembly ships with the
  // web server itself, so this stays true on an installation that omits the
  // optional management scripting tools.
  installed() bool
  // Version reported by the installation, for example "10.0"
  //
  // Empty when IIS is not installed or the version cannot be read.
  version() string
  // applicationHost.config, for ownership and permission checks
  //
  // The shared configuration file as a file, so its permissions and owner can
  // be audited and its raw text read. Its contents are what IIS starts from,
  // not what it ends up with: a setting overridden by a site or an application
  // still reads here with the server-level value. Use `config`,
  // `iis.site.config` and `iis.application.config` for the values in force.
  //
  // The typed fields leave credentials behind, but this file does not: it can
  // hold encrypted application pool passwords and machine keys, so reading its
  // content returns whatever it holds. Null when IIS is not installed.
  applicationHost() file
  // Configuration in force at server scope
  //
  // The defaults every site inherits unless it overrides them, equivalent to
  // the MACHINE/WEBROOT/APPHOST configuration path. This includes the ASP.NET
  // sections: they are declared in machine.config and the root web.config, but
  // the server-scope configuration resolves the whole inheritance chain, so
  // they read here with the values a site inherits. Null when IIS is not
  // installed.
  config() iis.configuration
  // Websites hosted by this server
  //
  // Every site defined on the server, running or stopped. Empty when IIS is not
  // installed, which makes `all()` over this list vacuously true; guard on
  // `length` or on `installed`.
  sites() []iis.site
  // Application pools defined on this server
  //
  // Empty when IIS is not installed.
  appPools() []iis.appPool
}

// Website hosted by IIS
//
// A single site: its bindings, the application pool it runs under, the
// applications mounted beneath it, its log settings, and the configuration in
// force at the site root. The `name` field is the site name as IIS knows it,
// which is also what identifies the site in its configuration path.
private iis.site @defaults("name state physicalPath") {
  // Site name
  name string
  // Numeric site id, which also keys the site's log file directory
  id int
  // Runtime state
  //
  // One of "Started", "Stopped", "Starting", "Stopping" or "Unknown", the
  // members of the IIS object-state enumeration. Empty when the state cannot be
  // read at all, which happens when the world wide web publishing service is
  // not running; "Unknown" is IIS itself reporting that it cannot tell.
  state string
  // Filesystem path the site root maps to
  //
  // The physical path of the root virtual directory. Empty when the site
  // declares no root application.
  physicalPath string
  // Whether the site starts automatically with the server
  serverAutoStart bool
  // Application pool the site root runs under
  //
  // Null when the site names a pool the server does not define, so a dangling
  // reference is visible instead of reading as a pool with default settings.
  appPool() iis.appPool
  // Addresses, ports and protocols the site answers on
  bindings []iis.binding
  // Applications mounted under this site, including the root application "/"
  applications []iis.application
  // Whether request logging is enabled for this site
  logEnabled bool
  // Directory log files are written to, with environment variables unexpanded
  //
  // For example "%SystemDrive%\inetpub\logs\LogFiles". Each site writes into a
  // W3SVC<id> subdirectory of this path.
  logDirectory string
  // Log file format
  //
  // One of "W3C", "IIS", "NCSA" or "Custom". Only the W3C format supports
  // selecting which fields are recorded.
  logFormat string
  // How often a new log file is started
  //
  // One of "MaxSize", "Daily", "Weekly", "Monthly" or "Hourly". "MaxSize" rolls
  // over on logTruncateSize instead of on a schedule.
  logPeriod string
  // Size in bytes at which a log file is rolled over, when logPeriod is "MaxSize"
  logTruncateSize int
  // Fields recorded in W3C format
  //
  // Joined with a comma and a space, the way .NET renders a flags enum, for
  // example "Date, Time, ClientIP, UserName, Method, UriStem, HttpStatus". IIS
  // keeps the selection even while another log format is active, so this is
  // populated regardless of logFormat. Match on the individual field names
  // rather than comparing the whole string.
  logFields string
  // Where W3C log entries are sent
  //
  // "File", "ETW", or both as "File, ETW", joined with a comma and a space the
  // way .NET renders a flags enum. Empty on an installation that predates the
  // setting, in which case entries go to a file.
  logTarget string
  // Whether log rollover follows local time rather than UTC
  logLocalTimeRollover bool
  // HTTP Strict Transport Security settings for this site
  //
  // The attributes of the site's hsts element, carrying "enabled",
  // "max-age", "includeSubDomains", "preload" and "redirectHttpToHttps". Null on
  // an IIS version that has no built-in HSTS support, where the header is set
  // through a custom response header instead and shows up in
  // `config.customHeaders`.
  hsts dict
  // Configuration in force at the site root
  config iis.configuration
}

// Application mounted under an IIS site
//
// An application is a configuration boundary: it runs in its own application
// pool and its web.config overrides what the site and the server declare. The
// `path` field is the virtual path it is mounted at, "/" for the site root.
private iis.application @defaults("path physicalPath") {
  // Virtual path the application is mounted at, "/" for the site root
  path string
  // Filesystem path the application root maps to
  physicalPath string
  // Protocols the application is enabled for, as a comma-separated list
  //
  // For example "http" or "http,net.tcp".
  enabledProtocols string
  // Application pool this application runs under
  //
  // Null when the application names a pool the server does not define.
  appPool() iis.appPool
  // Virtual directories declared under this application
  virtualDirectories []iis.virtualDirectory
  // Configuration in force for this application
  //
  // Resolved at the application's own configuration path, so it reflects the
  // application's web.config on top of everything the site and the server
  // declare. For the root application this is the same configuration the site
  // reports.
  config iis.configuration
}

// Virtual directory of an IIS application
private iis.virtualDirectory @defaults("path physicalPath") {
  // Virtual path, "/" for the application root
  path string
  // Filesystem path the virtual directory maps to
  //
  // A path outside the site root, or on the system partition, is worth checking:
  // it puts content where the web server was not expected to reach.
  physicalPath string
  // Account used to reach the physical path, empty for pass-through authentication
  //
  // The account name only. The credential configured alongside it is not
  // reported.
  userName string
  // Logon type used for userName
  //
  // One of "Interactive", "Batch", "Network" or "ClearText".
  logonMethod string
}

// Address, port and protocol an IIS site answers on
private iis.binding @defaults("protocol bindingInformation port") {
  // Protocol, for example "http", "https" or "net.tcp"
  protocol string
  // Raw binding string as IIS stores it
  //
  // For an HTTP binding this is address:port:hostname, for example
  // "*:443:www.example.com". A binding with an empty hostname answers for every
  // name that resolves to the address.
  bindingInformation string
  // Host header the binding answers for, empty when it answers for any
  hostName string
  // Port the binding listens on, 0 for a binding with no endpoint
  port int
  // Address the binding listens on, "0.0.0.0" for every address
  ipAddress string
  // Thumbprint of the certificate bound to an HTTPS binding
  //
  // The SHA-1 hash as uppercase hex, empty for a binding with no certificate.
  // This is a public identifier, not key material.
  certificateHash string
  // Certificate store the bound certificate is held in, for example "My"
  certificateStoreName string
  // SSL binding flags
  //
  // A bit field. 1 selects the certificate by hostname (SNI) and 2 uses the
  // central certificate store. IIS 10 1809 and later add bits that disable
  // transport features rather than select a certificate: 4 disables HTTP/2, 8
  // disables OCSP stapling, 16 disables QUIC, 32 disables TLS 1.3 over TCP and
  // 64 disables legacy TLS. 0 means none of them are set, so test the
  // individual bits rather than comparing the whole value.
  sslFlags int
}

// IIS application pool
//
// The worker process configuration a site or application runs under: the
// identity it runs as, when it recycles, and how it reacts to repeated
// failures. The `name` field selects a pool, for example the "DefaultAppPool"
// that a stock installation ships.
private iis.appPool @defaults("name state identityType") {
  // Application pool name
  name string
  // Runtime state
  //
  // One of "Started", "Stopped", "Starting", "Stopping" or "Unknown", the
  // members of the IIS object-state enumeration. Empty when the state cannot be
  // read at all; "Unknown" is IIS itself reporting that it cannot tell.
  state string
  // Whether the pool starts automatically with the server
  autoStart bool
  // Start mode, either "OnDemand" or "AlwaysRunning"
  startMode string
  // Managed .NET runtime version, for example "v4.0"
  //
  // Empty for a pool that hosts no managed code.
  managedRuntimeVersion string
  // Managed pipeline mode, either "Integrated" or "Classic"
  managedPipelineMode string
  // Whether 32-bit applications are enabled on a 64-bit host
  enable32BitAppOnWin64 bool
  // Requests queued before the pool starts rejecting them
  queueLength int
  // Account the worker process runs as
  //
  // One of "ApplicationPoolIdentity", "LocalSystem", "LocalService",
  // "NetworkService" or "SpecificUser". ApplicationPoolIdentity gives the pool a
  // distinct virtual account, which is what keeps one site's worker process out
  // of another's files.
  identityType string
  // Account name used when identityType is "SpecificUser", empty otherwise
  //
  // The account name only. The password configured alongside it is not
  // reported.
  userName string
  // Seconds of inactivity after which the worker process is shut down
  //
  // 0 disables the idle timeout, which leaves a worker process resident
  // indefinitely.
  idleTimeout int
  // Worker processes the pool runs, greater than 1 for a web garden
  maxProcesses int
  // Whether the pool health-checks its worker processes
  pingingEnabled bool
  // Whether the worker process loads the user profile of its identity
  loadUserProfile bool
  // Seconds between scheduled recycles, 0 when recycling on an interval is off
  periodicRestartTime int
  // Requests served before the pool recycles, 0 when recycling on requests is off
  periodicRestartRequests int
  // Private memory in kilobytes that triggers a recycle, 0 when off
  periodicRestartPrivateMemory int
  // Virtual memory in kilobytes that triggers a recycle, 0 when off
  periodicRestartMemory int
  // Times of day the pool recycles at, as seconds past midnight
  //
  // Empty when the pool does not recycle on a schedule.
  periodicRestartSchedule []int
  // Recycle causes written to the event log
  //
  // Joined with a comma and a space, the way .NET renders a flags enum, for
  // example "Time, Requests, Schedule, Memory". A recycle trigger that is not
  // listed here recycles the pool without leaving a record of why, so match on
  // the individual cause names rather than comparing the whole string.
  logEventOnRecycle string
  // Whether a configuration change is prevented from triggering a recycle
  disallowRotationOnConfigChange bool
  // Whether overlapping recycles are prevented
  disallowOverlappingRotation bool
  // Whether the pool is disabled after repeated worker process failures
  rapidFailProtection bool
  // Seconds over which failures are counted toward rapid fail protection
  rapidFailProtectionInterval int
  // Failures within the interval that disable the pool
  rapidFailProtectionMaxCrashes int
}

// IIS configuration in force at one scope
//
// The configuration IIS applies at a single point in its hierarchy, after the
// whole machine.config, root web.config, applicationHost.config, location, site
// and application chain has been resolved. This is what the server acts on,
// which is not what any one configuration file says: reading
// applicationHost.config directly reports a value a site or application may
// override, and a check written against that file passes on exactly the
// override it exists to catch.
//
// The `path` field is the IIS configuration path the values were resolved at,
// for example "MACHINE/WEBROOT/APPHOST" for the server or
// "MACHINE/WEBROOT/APPHOST/Default Web Site" for a site.
//
// A field is null when its section is not declared at this scope. The ASP.NET
// sections are not such a case: they are declared in machine.config and the
// root web.config, and every scope here (the server's included) resolves the
// inheritance chain, so they carry the effective value at each one.
//
// Each field names the section and attribute it resolves. A setting with no
// field of its own is reachable at the same place through `sections`, which
// carries every section this scope declares under its full path.
private iis.configuration @defaults("path") {
  // IIS configuration path these values were resolved at
  path string
  // Whether a directory request returns a listing (directoryBrowse/enabled)
  //
  // A listing hands out the names of every file in the directory, including
  // ones no page links to.
  directoryBrowsingEnabled bool
  // Whether unauthenticated requests are served (anonymousAuthentication/enabled)
  anonymousAuthenticationEnabled bool
  // Account anonymous requests are served as (anonymousAuthentication/userName)
  //
  // Empty when anonymous requests run as the application pool identity, which
  // keeps one site's anonymous requests out of another site's files.
  anonymousAuthenticationUser string
  // Whether basic authentication is accepted (basicAuthentication/enabled)
  //
  // Basic authentication sends the password base64-encoded, which is plaintext
  // to anything on the path unless the binding is HTTPS.
  basicAuthenticationEnabled bool
  // Whether digest authentication is accepted (digestAuthentication/enabled)
  digestAuthenticationEnabled bool
  // Whether integrated Windows authentication is accepted
  //
  // From windowsAuthentication/enabled.
  windowsAuthenticationEnabled bool
  // Whether client certificates are mapped to local accounts
  //
  // From iisClientCertificateMappingAuthentication/enabled. The mapping lives in
  // IIS configuration and needs no directory to resolve.
  iisClientCertificateMappingAuthenticationEnabled bool
  // Whether client certificates are mapped to Active Directory accounts
  //
  // From clientCertificateMappingAuthentication/enabled, which resolves the
  // certificate against the directory rather than against IIS configuration.
  clientCertificateMappingAuthenticationEnabled bool
  // ASP.NET authentication mode (system.web/authentication/mode)
  //
  // One of "None", "Windows", "Passport", "Forms" or "Federated". The forms
  // fields below apply when this is "Forms".
  authenticationMode string
  // Whether the forms ticket is only sent over HTTPS (forms/requireSSL)
  //
  // A forms cookie sent in the clear is a replayable credential.
  formsRequireSsl bool
  // How forms authentication carries its ticket (forms/cookieless)
  //
  // One of "UseCookies", "UseUri", "AutoDetect" or "UseDeviceProfile". "UseUri"
  // puts the ticket in the URL, where it reaches proxy logs and referer headers.
  formsCookieless string
  // Protection applied to the forms ticket (forms/protection)
  //
  // One of "All", "None", "Encryption" or "Validation". "All" both encrypts the
  // ticket and validates it against tampering.
  formsProtection string
  // Seconds before a forms ticket expires (forms/timeout)
  formsTimeout int
  // Storage format of inline credentials (forms/credentials/passwordFormat)
  //
  // One of "Clear", "SHA1" or "MD5". Null when no inline credentials are
  // declared, which is the state to prefer: inline credentials put account
  // material in a configuration file whatever the format.
  formsCredentialsPasswordFormat string
  // Whether inline forms credentials are declared at this scope
  //
  // True when forms/credentials holds at least one user, which is the thing to
  // check rather than the format it stores them in.
  formsCredentialsDeclared bool
  // Transport requirements for requests (security/access/sslFlags)
  //
  // The names of the bits the attribute sets, drawn from "Ssl",
  // "SslNegotiateCert", "SslRequireCert", "SslMapCert" and "Ssl128". IIS reports
  // the attribute as a number on some installations and as names on others;
  // both resolve here to names, and a bit with no name of its own is kept as its
  // own number, one entry per bit, so it is not silently dropped. An empty list
  // means requests are accepted over plain HTTP.
  sslFlags []string
  // Largest request body accepted, in bytes (requestLimits/maxAllowedContentLength)
  maxAllowedContentLength int
  // Longest request URL accepted, in characters (requestLimits/maxUrl)
  maxUrl int
  // Longest query string accepted, in characters (requestLimits/maxQueryString)
  maxQueryString int
  // Whether non-ASCII characters are accepted in a URL
  //
  // From requestFiltering/allowHighBitCharacters.
  allowHighBitCharacters bool
  // Whether a doubly-escaped request is accepted
  //
  // From requestFiltering/allowDoubleEscaping. Double escaping is how a request
  // smuggles a path separator past a filter that only inspects the URL once.
  allowDoubleEscaping bool
  // Whether unlisted file extensions are served (fileExtensions/allowUnlisted)
  //
  // Serving unlisted extensions means a file type nobody considered, dropped
  // into the content directory, is served on request. The matching setting for
  // verbs sits under requestFiltering/verbs/allowUnlisted in `sections`, where
  // the two cannot be mistaken for each other.
  allowUnlistedFileExtensions bool
  // Whether the Server response header is suppressed
  //
  // From requestFiltering/removeServerHeader.
  removeServerHeader bool
  // Level of access handlers are allowed (handlers/accessPolicy)
  //
  // This is a **flags** attribute: it holds several names at once, joined with
  // a comma and a space in the order IIS declares them. "Read, Script" is the
  // stock value. The names are "None", "Read", "Write", "Execute", "Source",
  // "Script", "NoRemoteWrite", "NoRemoteRead", "NoRemoteExecute" and
  // "NoRemoteScript"; "None" appears alone when nothing is set. "Write"
  // combined with "Script" or "Execute" lets an upload be run, so match on the
  // names present rather than comparing the whole string.
  handlerAccessPolicy string
  // Whether unlisted ISAPI extensions may run
  //
  // From isapiCgiRestriction/notListedIsapisAllowed.
  notListedIsapisAllowed bool
  // Whether unlisted CGI programs may run
  //
  // From isapiCgiRestriction/notListedCgisAllowed, which sits on the same
  // element as the ISAPI setting above and differs only in name.
  notListedCgisAllowed bool
  // Whether ASP.NET compiles debug binaries (compilation/debug)
  //
  // Debug compilation slows every request, disables timeouts, and puts source
  // paths into error output.
  compilationDebug bool
  // Who receives detailed ASP.NET error pages (customErrors/mode)
  //
  // One of "On", "Off" or "RemoteOnly". "Off" sends the exception, its message
  // and its stack trace to every client.
  customErrorsMode string
  // Who receives detailed IIS error pages (httpErrors/errorMode)
  //
  // One of "DetailedLocalOnly", "Custom" or "Detailed". "Detailed" sends
  // physical paths and error details to remote clients.
  httpErrorsMode string
  // Whether ASP.NET request tracing is enabled (system.web/trace/enabled)
  //
  // Tracing exposes request contents, cookies and server variables through
  // trace.axd.
  traceEnabled bool
  // Whether the application is deployed in retail mode (deployment/retail)
  //
  // Retail mode overrides debug, trace and detailed errors across the whole
  // machine, whatever an individual application asks for.
  deploymentRetail bool
  // Code access security level for ASP.NET applications (trust/level)
  //
  // One of "Full", "High", "Medium", "Low" or "Minimal". "Full" places no
  // restriction on what application code may do.
  trustLevel string
  // Algorithm validating view state and forms tickets (machineKey/validation)
  //
  // One of "MD5", "SHA1", "3DES", "AES", "HMACSHA256", "HMACSHA384" or
  // "HMACSHA512". "SHA1" is the value a stock installation reports and is the
  // weakest of them. The keys on this section are dropped during collection and
  // reach neither this field nor `sections`.
  machineKeyValidation string
  // Where ASP.NET session state is kept (sessionState/mode)
  //
  // One of "Off", "InProc", "StateServer", "SQLServer" or "Custom".
  sessionStateMode string
  // How the session id is carried (sessionState/cookieless)
  //
  // One of "UseCookies", "UseUri", "AutoDetect" or "UseDeviceProfile". "UseUri"
  // puts the session id in the URL, where it is shared by every copy of the link.
  sessionStateCookieless string
  // Seconds an idle session is kept before it is abandoned (sessionState/timeout)
  sessionStateTimeout int
  // Whether cookies are marked HttpOnly (httpCookies/httpOnlyCookies)
  //
  // An HttpOnly cookie is not readable from script, which is what stops a
  // cross-site scripting flaw from becoming a stolen session.
  httpCookiesHttpOnly bool
  // Whether cookies are only sent over HTTPS (httpCookies/requireSSL)
  httpCookiesRequireSsl bool
  // Whether classic ASP keeps the session id secure over HTTPS
  //
  // From asp/session/keepSessionIdSecure.
  aspKeepSessionIdSecure bool
  // Custom response headers, by header name (httpProtocol/customHeaders)
  //
  // The section's collection flattened to a map, so both a header that should be
  // present ("Strict-Transport-Security") and one that should not
  // ("X-Powered-By", which advertises the framework version) are one lookup.
  // Empty when the section declares no headers.
  customHeaders map[string]string
  // Every resolved configuration section, keyed by section path
  //
  // The full result of the resolution, for reaching a setting that has no field
  // of its own, for example
  // `sections["system.webServer/security/dynamicIpSecurity"]["enableLoggingOnlyMode"]`.
  // Each entry holds the section's attributes and its child elements; sections
  // whose members carry the setting also hold a "collection" list of those
  // members. Durations are in seconds throughout, and machineKey's validationKey
  // and decryptionKey are dropped before the section is reported. A section that
  // is not declared at this scope has no key here, and reading through a key
  // that is absent yields null rather than an error.
  sections dict
}

// JBoss EAP / WildFly application server
//
// Locates a JBoss installation through JBOSS_HOME and exposes the server
// configuration it holds: the management section (management interfaces,
// security realms, the audit log and access control), the network interfaces
// and socket bindings, the password vault, and the subsystems declared in
// each profile. Nothing here needs a running JVM or the management CLI, so it
// also works against container images and filesystem snapshots.
//
// Both operating modes are covered. In standalone mode `config` is the
// profile the server is actually started with — which is not always
// standalone.xml, since `--server-config` selects one of the four shipped
// profiles. In domain mode `config` is domain.xml and `host` is the host
// controller's host.xml, which is where a domain keeps its management
// interfaces and security realms.
//
// Every nested collection (profiles, subsystems, interfaces, socket bindings,
// security realms, management interfaces, audit handlers, connectors, log
// handlers) is a list whenever the element is present — including when the XML
// holds exactly one — and an empty list when it is absent. It is never null
// and never a bare map, so a check written against a single-realm server keeps
// working when a second realm is added.
//
// Pass `init(home: "...")` to point at an installation the discovery does not
// find, and `init(configFile: "...")` to read a profile other than the active
// one.
jboss @defaults("home version launchType") {
  init(home? string, configFile? string)
  // Installation directory (JBOSS_HOME); empty when no installation is found
  home() string
  // Configuration file `config` reads, as a name or an absolute path
  //
  // Defaults to the profile the server is started with, which is not always
  // standalone.xml: `--server-config` selects one of the shipped profiles and
  // the others stay on disk unused.
  configFile() string
  // Product name, e.g. "JBoss EAP" or "WildFly"; empty when it cannot be read
  product() string
  // Product version, e.g. "6.4.23.GA"; empty when it cannot be read from disk
  version() string
  // Operating mode: "standalone" or "domain"; empty when it cannot be determined
  launchType() string
  // Base directory of the operating mode ($JBOSS_HOME/standalone or /domain)
  baseDir() string
  // Configuration directory of the operating mode
  configDir() string
  // Log directory of the operating mode
  logDir() string
  // Data directory of the operating mode, where the audit log lands by default
  dataDir() string
  // Deployment directory the deployment scanner watches
  deploymentDir() string
  // Password vault directory ($JBOSS_HOME/vault)
  vaultDir() string
  // Configuration the server is actually started with; null when none is found
  config() jboss.config
  // Every server configuration found in the configuration directory
  //
  // A standalone installation ships four profiles and only one of them is
  // live, so a check that must hold no matter which profile is selected
  // asserts over this list rather than over `config`.
  configs() []jboss.config
  // Host controller configuration (domain/configuration/host.xml); null in standalone mode
  host() jboss.config
  // Management section that governs this installation
  //
  // Standalone mode reads it from the server profile and domain mode from
  // host.xml, because that is where each of them declares the management
  // interfaces, the security realms and the audit log. Null when neither has one.
  management() jboss.management
  // Users declared in the management realm's properties file
  managementUsers() []jboss.user
  // Users declared in the application realm's properties file
  applicationUsers() []jboss.user
  // Startup script of the operating mode (bin/standalone.sh or bin/domain.sh); null when absent
  startupScript() file
  // Startup configuration of the operating mode (bin/standalone.conf or bin/domain.conf); null when absent
  startupConfig() file
  // JVM options the startup configuration sets, in declaration order
  javaOpts() []string
  // Whether the Java Security Manager is turned on at startup
  //
  // True when the startup configuration sets SECMGR=true or names
  // -Djava.security.manager on the JVM command line.
  securityManagerEnabled() bool
  // Java security policy named with -Djava.security.policy; empty when none is set
  securityPolicy() string
}

// A JBoss server configuration document
//
// The same resource models all three: a standalone profile (<server>),
// domain.xml (<domain>) and host.xml (<host>). Fields that belong to one of
// them are empty or an empty list on the others — domain.xml has no management
// interfaces, host.xml has no profiles — and `mode` says which document this is.
private jboss.config @defaults("name mode") {
  // File the configuration was parsed from
  file file
  // File name, e.g. "standalone-full.xml", "domain.xml" or "host.xml"
  name string
  // Root element of the document: "server", "domain" or "host"
  mode string
  // @name of the root element; host.xml names the host controller
  hostName string
  // <management> section; null when the document has none
  management jboss.management
  // <profile> elements; a standalone profile holds exactly one, unnamed
  profiles []jboss.profile
  // <interface> elements
  interfaces []jboss.interface
  // <socket-binding-group> elements
  socketBindingGroups []jboss.socketBindingGroup
  // <vault> element; null when the password vault is not configured
  vault jboss.vault
  // <deployment> entries. Keys: name, runtimeName, enabled
  deployments []dict
  // <server-group> entries of domain.xml. Keys: name, profile, socketBindingGroup, portOffset
  serverGroups []dict
  // <server> entries of host.xml. Keys: name, group, autoStart, portOffset
  servers []dict
  // Modules named by <extension module="..."/>
  extensions []string
  // <system-property> name/value pairs
  systemProperties map[string]string
  // Domain controller of a host controller: "local", "remote" or empty
  domainController string
}

// JBoss <management> section
private jboss.management @defaults("accessControlProvider") {
  // <http-interface> and <native-interface> children of <management-interfaces>
  interfaces []jboss.managementInterface
  // <security-realm> children of <security-realms>
  securityRealms []jboss.securityRealm
  // <audit-log> section; null when the element is absent
  auditLog jboss.auditLog
  // access-control/@provider
  //
  // "simple" when the element is absent, which is the default and means role
  // based access control is off.
  accessControlProvider string
  // access-control/role-mapping/<role> entries
  //
  // Keys: name, includeUsers, includeGroups, excludeUsers, excludeGroups.
  roleMappings []dict
}

// A JBoss management interface
//
// The two operating modes declare the endpoint differently: a standalone
// profile names socket bindings (<socket-binding http=.. https=..>) and a host
// controller names an interface and ports (<socket interface=.. port=..>).
// Both spellings are exposed, and the one the document does not use is empty.
private jboss.managementInterface @defaults("type securityRealm") {
  // "http" or "native"
  type string
  // @security-realm
  //
  // Empty when the interface is not bound to a realm, which means it accepts
  // unauthenticated management traffic.
  securityRealm string
  // Whether the web console is served (@console-enabled, http only); true when unset
  consoleEnabled bool
  // Whether the native protocol is upgraded over http (@http-upgrade-enabled); false when unset
  httpUpgradeEnabled bool
  // socket-binding/@http — the plaintext binding of a standalone profile
  httpBinding string
  // socket-binding/@https — the TLS binding of a standalone profile; empty when none
  httpsBinding string
  // socket-binding/@native — the native binding of a standalone profile
  nativeBinding string
  // socket/@interface of a host controller
  socketInterface string
  // socket/@port of a host controller, as written
  socketPort string
  // socket/@secure-port of a host controller, as written; empty when none
  socketSecurePort string
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// JBoss <security-realm> element
private jboss.securityRealm @defaults("name") {
  // @name
  name string
  // <authentication> block; null when the realm does not authenticate
  authentication jboss.realmAuthentication
  // authorization/properties/@path; empty when authorization is not file backed
  authorizationProperties string
  // authorization/@map-groups-to-roles; true when unset
  mapGroupsToRoles bool
  // server-identities/ssl keystore; null when the realm has no TLS identity
  serverIdentity jboss.keystore
  // Whether the realm carries a server-identities/secret
  hasSecretIdentity bool
}

// <authentication> block of a JBoss security realm
private jboss.realmAuthentication @defaults("hasLocal") {
  // Whether <local/> silent authentication is present
  //
  // It lets a client on the same host authenticate without presenting
  // credentials.
  hasLocal bool
  // local/@default-user
  localDefaultUser string
  // local/@allowed-users
  localAllowedUsers string
  // properties/@path — the user store, as written
  propertiesPath string
  // properties/@relative-to
  propertiesRelativeTo string
  // properties/@plain-text; false when unset
  plainText bool
  // <ldap> authentication; null when the realm does not use a directory
  ldap jboss.ldapAuthentication
  // <truststore> that authenticates clients by certificate; null when absent
  truststore jboss.keystore
  // jaas/@name; empty when the realm does not delegate to JAAS
  jaasName string
  // Names of users declared inline with <users><user name="..."/></users>
  inlineUsers []string
}

// <ldap> authentication of a JBoss security realm
private jboss.ldapAuthentication @defaults("connection baseDn") {
  // @connection — the outbound LDAP connection this realm authenticates against
  connection string
  // @base-dn
  baseDn string
  // @recursive; false when unset
  recursive bool
  // @user-dn
  userDn string
  // @allow-empty-passwords; false when unset
  allowEmptyPasswords bool
  // username-filter/@attribute or @username-attribute
  usernameAttribute string
  // advanced-filter/@filter
  advancedFilter string
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// A keystore or truststore referenced by a JBoss security realm
//
// The password is not exposed as a field of its own. `passwordIsVaultExpression`
// answers the question a configuration review asks — whether the password is
// held in the vault rather than written in the clear — without putting the
// secret itself into a report.
private jboss.keystore @defaults("path") {
  // @path or @keystore-path, as written
  path string
  // @relative-to
  relativeTo string
  // @provider (JKS, PKCS12, ...); empty when unset
  provider string
  // @alias
  alias string
  // Whether the password is supplied as a ${VAULT::...} expression rather than in the clear
  passwordIsVaultExpression bool
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// JBoss <audit-log> section
//
// Every attribute of the block is exposed on its own rather than folded into
// a single "auditing is on" boolean, because the record content, the boot
// coverage, the read-only coverage and the destination are separate
// requirements that a review has to be able to assert separately.
private jboss.auditLog @defaults("enabled") {
  // logger/@enabled — the master switch; false when the <logger> is absent
  enabled bool
  // <logger>, which audits the standalone server or the host controller; null when absent
  logger jboss.auditLogger
  // <server-logger>, which audits the managed servers of a domain; null when absent
  serverLogger jboss.auditLogger
  // <json-formatter> children of <formatters>
  formatters []jboss.auditFormatter
  // <file-handler> and <syslog-handler> children of <handlers>
  handlers []jboss.auditHandler
}

// <logger> or <server-logger> of a JBoss audit log
private jboss.auditLogger @defaults("type enabled") {
  // "logger" or "server-logger"
  type string
  // @enabled; false when unset, which is the shipped default
  enabled bool
  // @log-boot — whether operations performed while booting are recorded; true when unset
  logBoot bool
  // @log-read-only — whether reads are recorded, not just changes; false when unset
  logReadOnly bool
  // Names of the handlers the logger writes through (handlers/handler/@name)
  //
  // A logger with no handler is enabled but writes nowhere.
  handlers []string
}

// <json-formatter> of a JBoss audit log
private jboss.auditFormatter @defaults("name") {
  // @name — the name a handler references
  name string
  // @include-date — whether each record carries a timestamp; true when unset
  includeDate bool
  // @date-format
  dateFormat string
  // @date-separator
  dateSeparator string
  // @compact; false when unset
  compact bool
  // @escape-new-line; false when unset
  escapeNewLine bool
  // @escape-control-characters; false when unset
  escapeControlCharacters bool
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// <file-handler> or <syslog-handler> of a JBoss audit log
private jboss.auditHandler @defaults("name type") {
  // @name — the name a logger references
  name string
  // "file" or "syslog"
  type string
  // @formatter — the formatter this handler renders through
  formatter string
  // @path of a file handler, as written
  path string
  // @relative-to of a file handler, which resolves @path to a real directory
  relativeTo string
  // @rotate-at-startup of a file handler; true when unset
  rotateAtStartup bool
  // @max-failure-count; 10 when unset
  maxFailureCount int
  // @syslog-format of a syslog handler
  syslogFormat string
  // @app-name of a syslog handler
  appName string
  // Transport of a syslog handler: "udp", "tcp", "tls" or empty
  transport string
  // Destination of a syslog handler (@host of the transport element)
  host string
  // Destination port of a syslog handler (@port of the transport element), as written
  port string
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// JBoss <interface> element
private jboss.interface @defaults("name inetAddress") {
  // @name; "management" and "public" are the two the shipped profiles declare
  name string
  // inet-address/@value, as written — commonly a ${property:default} expression
  inetAddress string
  // Whether the interface matches every address (<any-address/>)
  anyAddress bool
  // Names of the other selection criteria elements present, e.g. "nic", "loopback"
  criteria []string
}

// JBoss <socket-binding-group> element
private jboss.socketBindingGroup @defaults("name defaultInterface") {
  // @name
  name string
  // @default-interface — the interface a binding that names none is attached to
  defaultInterface string
  // @port-offset, as written
  portOffset string
  // <socket-binding> children
  socketBindings []jboss.socketBinding
  // <outbound-socket-binding> and <remote-destination-outbound-socket-binding> children
  outboundSocketBindings []jboss.socketBinding
}

// JBoss <socket-binding> or outbound socket binding
private jboss.socketBinding @defaults("name port") {
  // @name
  name string
  // @interface; empty means the group's default interface applies
  interface string
  // @port, as written — commonly a ${property:default} expression
  port string
  // @multicast-address
  multicastAddress string
  // @multicast-port, as written
  multicastPort string
  // @fixed-port; false when unset
  fixedPort bool
  // Whether this is an outbound binding
  outbound bool
  // remote-destination/@host of an outbound binding
  remoteHost string
  // remote-destination/@port of an outbound binding, as written
  remotePort string
  // local-destination/@socket-binding-ref of an outbound binding
  localDestination string
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// JBoss <vault> element, the password vault
private jboss.vault @defaults("keystoreUrl") {
  // KEYSTORE_URL vault option — the keystore the vault unlocks
  keystoreUrl string
  // KEYSTORE_ALIAS vault option
  keystoreAlias string
  // ENC_FILE_DIR vault option
  encryptionDirectory string
  // @code of a custom vault implementation; empty for the built-in vault
  code string
  // @module of a custom vault implementation
  module string
  // Every <vault-option> as a name/value pair
  options map[string]string
}

// JBoss <profile> element
//
// A standalone profile holds one unnamed <profile>; domain.xml holds several,
// each named and selected by a server group.
private jboss.profile @defaults("name") {
  // @name; empty for the single unnamed profile of a standalone configuration
  name string
  // <subsystem> children
  subsystems []jboss.subsystem
  // urn:jboss:domain:logging subsystem; null when the profile has none
  logging jboss.logging
  // urn:jboss:domain:web subsystem; null when the profile has none
  //
  // This is the servlet container of JBoss AS 7 and EAP 6. WildFly 9 and later
  // replaced it with urn:jboss:domain:undertow, which is reachable through
  // `subsystems` and is deliberately not typed here.
  web jboss.web
  // urn:jboss:domain:jmx subsystem; null when the profile has none
  jmx jboss.jmx
  // <deployment-scanner> children of the urn:jboss:domain:deployment-scanner subsystem
  deploymentScanners []jboss.deploymentScanner
}

// JBoss <subsystem> element
//
// Every subsystem of a profile appears here, including the ones this resource
// does not type. `jboss.config.file` is the document they were read from, so
// `parse.xml` reaches anything that has no typed field yet — against a
// discovered path rather than a guessed one.
private jboss.subsystem @defaults("name version") {
  // Short name taken from the namespace, e.g. "logging" for urn:jboss:domain:logging:1.5
  name string
  // Namespace of the element (@xmlns)
  namespace string
  // Schema version taken from the namespace, e.g. "1.5"
  version string
  // All attributes of the <subsystem> element itself, verbatim and unexpanded
  params map[string]string
}

// JBoss logging subsystem
private jboss.logging @defaults("rootLoggerLevel") {
  // root-logger/level/@name; empty when the profile declares no root logger
  rootLoggerLevel string
  // Names of the handlers the root logger writes through
  rootLoggerHandlers []string
  // Every handler declared in the subsystem
  handlers []jboss.logHandler
  // <logger> entries. Keys: category, level, useParentHandlers, handlers
  loggers []dict
}

// A handler of the JBoss logging subsystem
private jboss.logHandler @defaults("name type") {
  // @name
  name string
  // Element name
  //
  // For example "console-handler", "periodic-rotating-file-handler",
  // "size-rotating-file-handler", "syslog-handler" or "custom-handler".
  type string
  // level/@name; empty when the handler declares none
  level string
  // file/@path of a file handler, as written
  path string
  // file/@relative-to of a file handler
  relativeTo string
  // suffix/@value of a periodic rotating handler, which is what sets its rotation period
  suffix string
  // append/@value; true when unset
  append bool
  // rotate-size/@value of a size rotating handler
  rotateSize string
  // max-backup-index/@value; 1 when unset
  maxBackupIndex int
  // formatter/named-formatter/@name, or the inline pattern when one is declared
  formatter string
  // server-address/@value of a syslog handler
  serverAddress string
  // port/@value of a syslog handler, as written
  port string
  // app-name/@value of a syslog handler
  appName string
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// JBoss web subsystem (urn:jboss:domain:web)
private jboss.web @defaults("defaultVirtualServer") {
  // @default-virtual-server
  defaultVirtualServer string
  // @native — whether the APR connectors are used; true when unset
  native bool
  // <connector> children
  connectors []jboss.connector
  // <virtual-server> children
  virtualServers []jboss.virtualServer
}

// <connector> of the JBoss web subsystem
//
// The nested <ssl> element is flattened onto the connector, because a
// connector has at most one and every TLS question is asked of the connector
// rather than of the element. `sslEnabled` tells a connector that carries the
// element from one that does not.
private jboss.connector @defaults("name protocol sslEnabled") {
  // @name
  name string
  // @protocol, e.g. "HTTP/1.1"
  protocol string
  // @scheme, "http" or "https"
  scheme string
  // @socket-binding — the binding that supplies the port
  socketBinding string
  // @secure — whether requests are reported to the application as secure; false when unset
  secure bool
  // @enabled; true when unset
  enabled bool
  // Whether the connector carries a nested <ssl> element
  sslEnabled bool
  // ssl/@protocol — the TLS versions the connector accepts
  sslProtocol string
  // ssl/@cipher-suite
  sslCipherSuite string
  // ssl/@verify-client
  sslVerifyClient string
  // ssl/@key-alias
  sslKeyAlias string
  // ssl/@certificate-key-file
  sslCertificateKeyFile string
  // ssl/@ca-certificate-file
  sslCaCertificateFile string
  // All attributes of <ssl>, verbatim and unexpanded
  sslParams map[string]string
  // All attributes of <connector>, verbatim and unexpanded
  params map[string]string
}

// <virtual-server> of the JBoss web subsystem
private jboss.virtualServer @defaults("name enableWelcomeRoot") {
  // @name
  name string
  // @enable-welcome-root — whether the Welcome application is served from "/"; true when unset
  enableWelcomeRoot bool
  // <alias name="..."> entries
  aliases []string
  // Whether an <access-log> is configured
  accessLogEnabled bool
  // access-log/@pattern
  accessLogPattern string
  // access-log/directory/@path
  accessLogDirectory string
}

// JBoss jmx subsystem (urn:jboss:domain:jmx)
private jboss.jmx @defaults("remotingConnectorEnabled") {
  // Whether <remoting-connector/> exposes the MBean server to remote clients
  remotingConnectorEnabled bool
  // remoting-connector/@use-management-endpoint; true when unset
  useManagementEndpoint bool
  // Whether <expose-resolved-model/> is present
  exposeResolvedModel bool
  // Whether <expose-expression-model/> is present
  exposeExpressionModel bool
  // sensitivity/@non-core-mbeans; false when unset
  nonCoreMbeansSensitive bool
}

// <deployment-scanner> of the JBoss deployment-scanner subsystem
private jboss.deploymentScanner @defaults("name scanEnabled") {
  // @name; "default" when unset
  name string
  // @path, as written
  path string
  // @relative-to
  relativeTo string
  // @scan-enabled — whether applications dropped into the directory are deployed
  //
  // True when the attribute is absent, which is the shipped default and means
  // an absent attribute leaves automatic deployment on.
  scanEnabled bool
  // @scan-interval in milliseconds; 5000 when unset
  scanInterval int
  // @auto-deploy-exploded; false when unset
  autoDeployExploded bool
  // @auto-deploy-zipped; true when unset
  autoDeployZipped bool
  // @auto-deploy-xml; true when unset
  autoDeployXml bool
  // @runtime-failure-causes-rollback; false when unset
  runtimeFailureCausesRollback bool
  // All attributes of the element, verbatim and unexpanded
  params map[string]string
}

// A user declared in a JBoss realm properties file
//
// The stored password hash is deliberately not exposed. `hasPassword` answers
// whether the entry carries one without copying the credential into a report.
private jboss.user @defaults("username realm") {
  // User name, as written
  username string
  // Realm the properties file belongs to, e.g. "ManagementRealm"
  realm string
  // File the entry was read from
  file file
  // Groups or roles the matching roles file grants the user
  roles []string
  // Whether the entry carries a password hash
  hasPassword bool
}

// Squid caching proxy
//
// Squid proxy server version reported by the daemon binary. Use
// `squid.conf` to inspect the full configuration including ACLs, access
// rules, listen ports, cache peers, refresh patterns, and any fragments
// pulled in by `include` directives (for example the contents of
// `/etc/squid/conf.d/*.conf`).
squid {
  // Squid version (e.g., "5.7")
  version() string
}

// Squid caching proxy configuration
//
// Parsed Squid configuration covering directives, access control lists,
// listen ports, cache peers, cache directories, refresh patterns,
// authentication parameters, and access logs from `squid.conf` together
// with every fragment pulled in by `include` directives. Files matched
// by glob patterns in include lines (e.g. `include /etc/squid/conf.d/*.conf`)
// are walked recursively and merged into a single logical configuration,
// so audits see the flattened directive set the daemon actually runs
// with.
squid.conf {
  init(path? string)
  // Primary configuration file
  file() file
  // All configuration files (main + included fragments)
  files(file) []file
  // Flat key-value directives across the merged configuration
  //
  // Directives that can repeat (acl, http_access, refresh_pattern, ...)
  // have their values comma-joined in source order.
  params(file) map[string]string
  // http_port listen entries
  httpPorts(file) []squid.conf.listen
  // https_port listen entries
  httpsPorts(file) []squid.conf.listen
  // Defined ACLs, one entry per unique acl name (values across repeated `acl NAME` lines are merged)
  acls(file) []squid.conf.acl
  // Every *_access rule in source order
  //
  // Includes http_access, http_reply_access, adapted_http_access,
  // icp_access, htcp_access, miss_access, cache, always_direct,
  // never_direct, and the other access directives. Filter by kind to
  // target one family: `.where(kind == "http_access")`.
  accessRules(file) []squid.conf.accessRule
  // cache_peer entries (parents and siblings)
  cachePeers(file) []squid.conf.cachePeer
  // cache_dir entries (on-disk cache storage)
  cacheDirs(file) []squid.conf.cacheDir
  // refresh_pattern entries (cache freshness rules) in source order
  refreshPatterns(file) []squid.conf.refreshPattern
  // auth_param entries grouped by scheme -> param -> value (e.g., authParams["basic"]["program"])
  authParams(file) map[string]map[string]string
  // access_log entries (each daemon target / format / acl pair)
  accessLogs(file) []squid.conf.accessLog
  // visible_hostname directive value
  visibleHostname(params) string
  // unique_hostname directive value
  uniqueHostname(params) string
  // cache_log directive value (path to the cache.log file)
  cacheLog(params) string
  // cache_store_log directive value (path or "none")
  cacheStoreLog(params) string
  // pid_filename directive value
  pidFilename(params) string
  // coredump_dir directive value
  coredumpDir(params) string
  // via directive value ("on" or "off")
  via(params) string
  // forwarded_for directive value (on, off, transparent, delete, truncate)
  forwardedFor(params) string
  // httpd_suppress_version_string directive value ("on" or "off")
  httpdSuppressVersionString(params) string
  // dns_v4_first directive value ("on" or "off")
  dnsV4First(params) string
  // cache_mem directive value (e.g., "256 MB")
  cacheMem(params) string
  // maximum_object_size directive value (e.g., "4 MB")
  maximumObjectSize(params) string
  // X.509 certificates parsed from cert= / tls-cert= paths declared on http_port and https_port entries
  certificates() []network.certificate
}

// Squid listen port (http_port or https_port)
//
// Single `http_port` or `https_port` directive: the bind address, port
// number, parsed mode flags (transparent, intercept, accel, ssl-bump,
// tproxy), and any `key=value` options including the TLS material
// (`cert=`, `key=`, `tls-cert=`, `tls-key=`).
private squid.conf.listen @defaults("port address tls") {
  // Directive name this entry came from ("http_port" or "https_port")
  directive string
  // Bind address ("" when none was given, IPv4/IPv6 literal, or "unix:/path")
  address string
  // Numeric port (0 when the target is a unix socket)
  port int
  // Whether this entry serves TLS (https_port, or http_port with ssl-bump / tls-cert= / cert=)
  tls bool
  // Mode flags present on the directive (e.g., transparent, intercept, accel, ssl-bump, tproxy, ssl)
  flags []string
  // Path to the server certificate when set (`cert=` or `tls-cert=`)
  cert string
  // Path to the server private key when set (`key=` or `tls-key=`)
  key string
  // All `key=value` options on the directive
  options map[string]string
  // Original directive arguments, joined by spaces
  raw string
}

// Squid Access Control List entry
//
// Single `acl` definition. ACLs are referenced by name from
// `http_access`, `icp_access`, and the other *_access rules, so the
// `values` field together with the rule list tells you which clients,
// URLs, or methods Squid will allow or deny.
private squid.conf.acl @defaults("name type") {
  // ACL name (e.g., "localnet", "Safe_ports", "CONNECT")
  name string
  // ACL type (src, dst, port, srcdomain, url_regex, proto, method, proxy_auth, ...)
  type string
  // Modifier flags present on any of the acl lines (e.g., "-i" for case-insensitive)
  flags []string
  // All match values from every `acl NAME ...` line with this name, in source order
  values []string
}

// Squid *_access rule
//
// Single allow/deny rule from any of the access directives
// (`http_access`, `http_reply_access`, `icp_access`, `miss_access`,
// `cache`, `always_direct`, `never_direct`, etc.). Rules are evaluated
// top-down by Squid, so the `index` field reflects source order across
// the merged configuration.
private squid.conf.accessRule @defaults("kind action acls") {
  // Directive name (e.g., "http_access", "icp_access", "miss_access", "cache", "always_direct", "never_direct")
  kind string
  // 0-based position of this rule within `kind`, in source order across all included files
  index int
  // "allow" or "deny"
  action string
  // ACL names referenced by this rule, in argument order. An entry starting with "!" is a negated ACL.
  acls []string
  // Original directive arguments, joined by spaces
  raw string
}

// Squid cache peer
//
// Single `cache_peer` entry, a parent or sibling cache Squid forwards
// to. The `host`, `type`, and `httpPort` together identify the peer; the
// `options` slice carries the remaining flags (`default`, `no-query`,
// `proxy-only`, `login=...`, `weight=...`, ...).
private squid.conf.cachePeer @defaults("host type httpPort") {
  // Peer hostname or IP
  host string
  // Peer relationship ("parent", "sibling", or "multicast")
  type string
  // HTTP port on the peer
  httpPort int
  // ICP/HTCP query port on the peer (0 when disabled)
  icpPort int
  // Trailing options on the directive (e.g., default, no-query, proxy-only, login=NAME)
  options []string
  // Original directive arguments, joined by spaces
  raw string
}

// Squid cache directory
//
// Single `cache_dir` entry, the on-disk cache storage backing the proxy.
// Captures the storage `type` (ufs, aufs, diskd, rock), the filesystem
// `path`, the cache size, the L1/L2 fan-out for hashed stores, and any
// trailing `key=value` options (e.g., `max-size=`).
private squid.conf.cacheDir @defaults("type path sizeMb") {
  // Storage scheme (ufs, aufs, diskd, rock, ...)
  type string
  // Filesystem path of the cache
  path string
  // Cache size in megabytes
  sizeMb int
  // L1 subdirectory count (0 for rock and other single-file stores)
  l1 int
  // L2 subdirectory count (0 for rock and other single-file stores)
  l2 int
  // Trailing options on the directive (e.g., max-size=4194304, min-size=0)
  options []string
  // Original directive arguments, joined by spaces
  raw string
}

// Squid refresh_pattern rule
//
// Single `refresh_pattern` directive: the regex Squid uses to match
// URLs, the freshness window (`min` / `percent` / `max`), and any
// trailing flags. Audit hot spots include `ignore-private`,
// `ignore-no-store`, `override-expire`, and `override-lastmod`, which
// weaken cache safety guarantees.
private squid.conf.refreshPattern @defaults("pattern min max") {
  // Regex pattern this rule applies to
  pattern string
  // Whether the rule was declared case-insensitive (-i)
  caseInsensitive bool
  // Minimum freshness in minutes
  min int
  // Percent of last-modified age used to compute freshness
  percent int
  // Maximum freshness in minutes
  max int
  // Trailing flag options
  //
  // Common entries: override-expire, override-lastmod,
  // ignore-no-store, ignore-private, ignore-reload, reload-into-ims,
  // refresh-ims, store-stale, max-stale=N.
  options []string
  // Original directive arguments, joined by spaces
  raw string
}

// Squid access_log entry
//
// Single `access_log` directive: where requests are written (file path,
// daemon module target, or "none"), which logformat is in use, and which
// ACLs gate the log line. Multiple `access_log` lines produce multiple
// entries in this list.
private squid.conf.accessLog @defaults("target format") {
  // Log target ("/var/log/squid/access.log", "daemon:/var/log/...", "stdio:/var/log/...", "syslog:...", or "none" to disable)
  target string
  // logformat name selecting the output format ("squid" when unspecified, or the name from a `logformat NAME ...` line)
  format string
  // Trailing ACL names that gate this log line, in argument order (an entry starting with "!" is a negated ACL)
  acls []string
  // Original directive arguments, joined by spaces
  raw string
}

// FRRouting
//
// FRR routing daemon version, configuration and runtime state. FRR runs
// either directly on the host or inside a Host Based Networking (HBN)
// container. Both shapes are covered by the same resources, because the
// connection decides which filesystem and which shell the scan uses.
//
// The configuration is read from frr.conf and is durable. The runtime
// fields below run vtysh and `ip` on the asset, so they need a connection
// that can execute commands, and they describe the moment of the scan.
frr {
  // FRR version string (e.g., "8.5.4")
  version() string
  // VRFs known to FRR and to the kernel at scan time
  vrfs() []frr.vrf
  // BGP sessions of the default VRF at scan time. Use `frr.vrfs` for the sessions of a VRF.
  bgpNeighbors() []frr.bgp.neighbor
  // EVPN VNIs the local VTEP knows at scan time
  evpnVnis() []frr.evpn.vni
  // EVPN routing table of the local BGP instance at scan time. Use `frr.evpn.routeTable(vni: <id>)` for one VNI.
  evpnRoutes() frr.evpn.routeTable
  // Policy routing rules of the kernel at scan time
  routingRules() []frr.routingRule
}

// FRR configuration
//
// Parsed frr.conf. The default path is /etc/frr/frr.conf, which is also
// the path inside an HBN container. When that file is absent, the
// resource falls back to the host-side paths an HBN or CRA deployment
// uses (/var/lib/hbn/etc/frr/frr.conf, /etc/cra/frr.conf). Pass
// `init(path: "...")` to read a different file.
//
// The resource models the parts of the config that carry security
// meaning: BGP routers and their neighbors, the filters applied per
// neighbor, VRF definitions with their route targets, EVPN settings and
// interfaces. Everything else stays reachable through `blocks` and
// `directives`.
frr.config {
  init(path? string)
  // Configuration file (defaults to the first frr.conf found on the asset)
  file() file
  // `hostname` value
  hostname(file) string
  // Version from the `frr version <x>` line FRR writes into a saved config
  version(file) string
  // Profile from `frr defaults <traditional|datacenter>`
  defaults(file) string
  // `service integrated-vtysh-config` is set, so vtysh writes one merged file
  integratedVtyshConfig(file) bool
  // BGP instances, one per `router bgp <asn> [vrf <name>]` block
  bgp(file) []frr.config.router
  // VRF definitions, linked to the BGP instance that serves them
  vrfs(file) []frr.config.vrf
  // Interface blocks
  interfaces(file) []frr.config.interface
  // Prefix lists, grouped by address family and name
  prefixLists(file) []frr.config.prefixList
  // Route maps, grouped by name
  routeMaps(file) []frr.config.routeMap
  // Every top-level block in source order, including bfd, pbr-map and other types without a dedicated resource
  blocks(file) []frr.config.block
  // Every top-level line outside a block, such as community lists and static routes (entries: {name, args, negated, line, file, raw})
  directives(file) []dict
}

// FRR configuration block (raw view)
//
// Arbitrary block addressed by type and name. Use it for blocks that have
// no dedicated resource, and for audits that need every line in source
// order.
private frr.config.block @defaults("type name") {
  // Block keyword (router bgp, vrf, interface, route-map, bfd, pbr-map, ...)
  type string
  // Primary identifier of the block (ASN, VRF name, interface name, map name)
  name string
  // Every token after the block keyword
  args []string
  // Source file path
  file string
  // 1-based source line of the block header
  startLine int
  // 1-based source line of the last line in the block
  endLine int
  // Lines directly inside the block (entries: {name, args, negated, line, file, raw})
  directives []dict
  // Nested blocks
  blocks []frr.config.block
  // Raw text of the block including its header line
  raw string
}

// FRR BGP instance
//
// One `router bgp <asn> [vrf <name>]` block. A fabric node runs one
// instance for the underlay plus one per VRF, so `vrf` tells tenant
// instances apart from the underlay.
private frr.config.router @defaults("asn vrf routerId") {
  // Local autonomous system number
  asn int
  // VRF this instance serves (empty for the default VRF / underlay)
  vrf string
  // `bgp router-id` value
  routerId string
  // `bgp cluster-id` value (set on route reflectors)
  clusterId string
  // eBGP sessions require an inbound and outbound policy, false only with `no bgp ebgp-requires-policy`
  ebgpRequiresPolicy bool
  // Neighbors activate IPv4 unicast automatically, false only with `no bgp default ipv4-unicast`
  defaultIpv4Unicast bool
  // Peers and peer groups of this instance
  neighbors []frr.config.router.neighbor
  // Address families of this instance
  addressFamilies []frr.config.router.addressFamily
  // Flat directive map of the router block (name -> value)
  params map[string]string
  // Source file path
  file string
  // 1-based source line of the router block header
  startLine int
  // Raw text of the router block
  raw string
}

// FRR BGP neighbor
//
// One peer or peer group, merged from every `neighbor <name> ...` line in
// the router block and in its address families. The rolled-up filter
// lists answer whether a session accepts routes without a filter.
private frr.config.router.neighbor @defaults("name remoteAs") {
  // Peer address, interface name for an unnumbered peer, or peer group name
  name string
  // Peer is unnumbered, configured with `neighbor <if> interface remote-as`
  isInterface bool
  // Name declares a peer group rather than a single peer
  isPeerGroup bool
  // Peer group this neighbor joins
  peerGroup string
  // Raw `remote-as` value, which is a number or `internal` or `external`
  remoteAs string
  // Remote AS as a number, 0 when remote-as is internal or external
  remoteAsn int
  // `local-as` value
  localAsn int
  // `description` text
  description string
  // `update-source` value
  updateSource string
  // Prefix of `bgp listen range <prefix> peer-group <name>` for a dynamic group
  listenRange string
  // `bfd` is enabled for this neighbor
  bfd bool
  // Neighbor is administratively shut down
  shutdown bool
  // An MD5 password is configured (the password itself is not exposed)
  passwordSet bool
  // `ttl-security hops` value
  ttlSecurityHops int
  // Keepalive seconds from `neighbor <n> timers <keepalive> <hold>`
  keepaliveTime int
  // Hold time seconds from `neighbor <n> timers <keepalive> <hold>`
  holdTime int
  // Per address family settings
  addressFamilies []frr.config.router.neighbor.addressFamily
  // Address families the neighbor is explicitly activated in (e.g. "ipv4 unicast")
  activatedAddressFamilies []string
  // Inbound route maps across every address family
  routeMapsIn []string
  // Outbound route maps across every address family
  routeMapsOut []string
  // Inbound prefix lists across every address family
  prefixListsIn []string
  // Outbound prefix lists across every address family
  prefixListsOut []string
  // Inbound AS path filter lists across every address family
  filterListsIn []string
  // Outbound AS path filter lists across every address family
  filterListsOut []string
  // Every `neighbor <name> ...` setting (setting -> value)
  params map[string]string
  // Source file path
  file string
  // 1-based source line where the neighbor first appears
  line int
}

// FRR BGP neighbor address family settings
//
// What one neighbor does inside one address family. The filters here
// decide which routes the session accepts and announces.
private frr.config.router.neighbor.addressFamily @defaults("afi safi activate") {
  // Address family identifier (ipv4, ipv6, l2vpn)
  afi string
  // Subsequent address family identifier (unicast, multicast, evpn, vpn)
  safi string
  // Neighbor is explicitly activated in this family, which does not cover the implicit activation of `bgp default ipv4-unicast`
  activate bool
  // Inbound route map
  routeMapIn string
  // Outbound route map
  routeMapOut string
  // Inbound prefix list
  prefixListIn string
  // Outbound prefix list
  prefixListOut string
  // Inbound AS path filter list
  filterListIn string
  // Outbound AS path filter list
  filterListOut string
  // `maximum-prefix` limit, 0 when unset
  maximumPrefix int
  // Neighbor is a route reflector client
  routeReflectorClient bool
  // `allowas-in` is set, so the peer may send back the local AS
  allowasIn bool
  // `next-hop-self` is set
  nextHopSelf bool
  // `soft-reconfiguration` is set
  softReconfiguration bool
  // `default-originate` is set, so a default route is announced
  defaultOriginate bool
  // `remove-private-AS` is set
  removePrivateAs bool
}

// FRR BGP address family
//
// One `address-family <afi> <safi>` block of a router. The EVPN family
// carries the route targets and the VRF imports that decide which VRF
// sees which routes.
private frr.config.router.addressFamily @defaults("afi safi") {
  // Address family identifier (ipv4, ipv6, l2vpn)
  afi string
  // Subsequent address family identifier (unicast, multicast, evpn, vpn)
  safi string
  // Prefixes advertised with `network <prefix>`
  networks []string
  // `redistribute <source>` entries
  redistribute []string
  // Source VRFs of every `import vrf <name>` line
  importVrfs []string
  // Route map of `import vrf route-map <name>`, which filters leaked routes
  importVrfRouteMap string
  // EVPN route targets imported into this family
  routeTargetsImport []string
  // EVPN route targets exported from this family
  routeTargetsExport []string
  // `advertise <afi> <safi> [route-map <name>]` entries
  advertise []string
  // `advertise-all-vni` is set
  advertiseAllVni bool
  // `vni <id>` blocks with their own route targets
  vnis []dict
  // Flat directive map of the address family (name -> value)
  params map[string]string
  // Source file path
  file string
  // 1-based source line of the address family header
  startLine int
  // Raw text of the address family block
  raw string
}

// FRR VRF
//
// One `vrf <name>` block. The route targets, imported VRFs and ASN come
// from the `router bgp <asn> vrf <name>` instance that serves the VRF, so
// tenant separation can be checked on a single resource.
private frr.config.vrf @defaults("name vni") {
  // VRF name
  name string
  // Layer 3 VNI bound to the VRF, 0 when the VRF is local only
  vni int
  // Static routes defined inside the VRF block
  staticRoutes []string
  // ASN of the BGP instance serving this VRF, 0 when there is none
  routerAsn int
  // EVPN route targets the VRF imports, across every address family
  routeTargetsImport []string
  // EVPN route targets the VRF exports, across every address family
  routeTargetsExport []string
  // Other VRFs pulled in with `import vrf <name>`
  importedVrfs []string
  // Flat directive map of the vrf block (name -> value)
  params map[string]string
  // Source file path
  file string
  // 1-based source line of the vrf block header
  startLine int
  // Raw text of the vrf block
  raw string
}

// FRR interface
//
// One `interface <name> [vrf <name>]` block.
private frr.config.interface @defaults("name vrf") {
  // Interface name
  name string
  // VRF the interface is bound to
  vrf string
  // `description` text
  description string
  // IPv4 addresses configured with `ip address`
  ipAddresses []string
  // IPv6 addresses configured with `ipv6 address`
  ipv6Addresses []string
  // Interface is administratively shut down
  shutdown bool
  // `pbr-policy` map applied to the interface
  pbrPolicy string
  // Flat directive map of the interface block (name -> value)
  params map[string]string
  // Source file path
  file string
  // 1-based source line of the interface block header
  startLine int
  // Raw text of the interface block
  raw string
}

// FRR prefix list
//
// Every `ip prefix-list <name> ...` or `ipv6 prefix-list <name> ...` line
// of one name, in source order.
private frr.config.prefixList @defaults("name afi") {
  // Prefix list name
  name string
  // Address family of the list (ip or ipv6)
  afi string
  // Entries in source order (entries: {seq, action, prefix, le, ge, line, raw})
  entries []dict
  // Source file path
  file string
  // 1-based source line of the first entry
  line int
}

// FRR route map
//
// Every `route-map <name> <permit|deny> <seq>` block of one name.
private frr.config.routeMap @defaults("name") {
  // Route map name
  name string
  // Clauses in source order
  entries []frr.config.routeMap.entry
  // Source file path
  file string
  // 1-based source line of the first clause
  line int
}

// FRR route map clause
//
// One `route-map <name> <permit|deny> <seq>` block with its match and set
// statements.
private frr.config.routeMap.entry @defaults("name action sequence") {
  // Route map name
  name string
  // Clause action (permit or deny)
  action string
  // Clause sequence number
  sequence int
  // `match` statements without the leading keyword
  match []string
  // `set` statements without the leading keyword
  set []string
  // `call <name>` target, which runs another route map
  call string
  // `on-match` statement without the leading keyword
  onMatch string
  // Source file path
  file string
  // 1-based source line of the clause header
  startLine int
  // Raw text of the clause
  raw string
}

// FRR vtysh configuration
//
// Parsed vtysh.conf (default /etc/frr/vtysh.conf). It holds the shell
// settings of FRR, including whether vtysh writes one integrated config
// file and which local users may reach the shell.
frr.vtysh.config {
  init(path? string)
  // Configuration file (defaults to /etc/frr/vtysh.conf)
  file() file
  // `hostname` value
  hostname(file) string
  // `service integrated-vtysh-config` is set
  integratedConfig(file) bool
  // `username <name> ...` lines (entries: {name, nopassword, privilege})
  users(file) []dict
  // Every configuration line (entries: {name, args, negated, line, file, raw})
  directives(file) []dict
  // Flat directive map (name -> value)
  params(file) map[string]string
}

// FRR VRF
//
// One VRF as it exists at scan time. The view merges what zebra reports
// with the VRF device on the asset, so a VRF that only one side knows is
// still listed. `inFrr` and `inKernel` say which side saw it.
//
// This is runtime state. It describes the moment of the scan.
private frr.vrf @defaults("name tableId up") {
  // VRF name
  name string
  // VRF id assigned by zebra, 0 when zebra does not know the VRF
  id int
  // Routing table the VRF uses
  tableId int
  // Name of that routing table from /etc/iproute2/rt_tables, empty when unnamed
  tableName string
  // Interface index of the VRF device, 0 when the device is absent
  ifindex int
  // MTU of the VRF device
  mtu int
  // Operational state of the VRF device (e.g. UP, DOWN)
  operState string
  // VRF device is up
  up bool
  // zebra reported the VRF
  inFrr bool
  // The VRF device exists on the asset
  inKernel bool
  // IPv4 routes of this VRF. Use `frr.routeTable(<name>, "ipv6")` for IPv6.
  routes() frr.routeTable
  // BGP sessions of this VRF, across every address family
  bgpNeighbors() []frr.bgp.neighbor
  // Policy routing rules that select the routing table of this VRF
  rules() []frr.routingRule
}

// FRR routing table
//
// The routes of one VRF and one address family, read with
// `show ip route [vrf <name>] json` or its IPv6 form. The VRF and the
// address family are part of the command, so FRR filters before it prints.
//
// The result is bounded. `limit` caps how many routes become resources,
// `total` counts every prefix the command reported, and `truncated` says
// whether the cap was reached. A node that holds a full table has far more
// prefixes than any policy needs to read.
//
// This is runtime state. It describes the moment of the scan.
frr.routeTable @defaults("vrf afi total truncated") {
  init(vrf? string, afi? string, limit? int)
  // VRF the routes belong to, empty for the default VRF
  vrf string
  // Address family, ipv4 (default) or ipv6
  afi string
  // Maximum number of routes turned into resources
  limit int
  // Number of prefixes the command reported, including the ones past the limit
  total() int
  // The command reported more prefixes than the limit
  truncated() bool
  // Routes, at most `limit` entries
  entries() []frr.route
}

// FRR route
//
// One route of the FRR routing information base, with the next hops it
// resolves to. `selected` marks the route FRR chose for the prefix, and
// `installed` marks the route the kernel holds.
//
// This is runtime state. It describes the moment of the scan.
private frr.route @defaults("prefix protocol vrf selected") {
  // Destination prefix in CIDR notation
  prefix string
  // Prefix length
  prefixLength int
  // Routing protocol that owns the route (e.g. bgp, static, connected, kernel)
  protocol string
  // VRF the route belongs to
  vrf string
  // Numeric routing table of the route
  table int
  // FRR chose this route for the prefix
  selected bool
  // The route is installed in the kernel
  installed bool
  // Administrative distance
  distance int
  // Route metric
  metric int
  // How long the route has been present, as reported by FRR (e.g. "01:12:40")
  uptime string
  // Next hops (entries: {ip, interface, vrf, active, fib, directlyConnected})
  nexthops []dict
}

// FRR BGP session
//
// One BGP peer of one VRF, merged from `show bgp [vrf <name>] summary json`
// and `show bgp [vrf <name>] neighbors json`. The session state and the
// prefix counters live in the address families.
//
// This is runtime state. A peer that is Established now can be down at the
// next scan, so a policy over these fields tests the moment, not the
// configuration.
private frr.bgp.neighbor @defaults("vrf name state remoteAsn") {
  // Peer address, or the interface name of an unnumbered peer
  name string
  // VRF the session belongs to, empty for the default VRF
  vrf string
  // Remote autonomous system number
  remoteAsn int
  // Local autonomous system number
  localAsn int
  // Hostname the peer announced, empty when capability hostname is off
  hostname string
  // Session state (e.g. Established, Idle, Active, Connect)
  state string
  // Session is Established
  established bool
  // How long the session has held its state, in milliseconds
  uptimeMsec int
  // BGP messages received on the session
  messagesReceived int
  // BGP messages sent on the session
  messagesSent int
  // How often the session reached Established
  connectionsEstablished int
  // How often the session dropped
  connectionsDropped int
  // How the peer is addressed (ipv4, ipv6 or interface)
  idType string
  // Per address family state of this session
  addressFamilies []frr.bgp.neighbor.addressFamily
}

// FRR BGP session address family
//
// What one session carries in one address family, including the prefix
// counters and the policy FRR is running for it. The running policy can
// differ from the saved configuration, so comparing it against
// `frr.config` finds a router that was changed without a commit.
//
// This is runtime state. It describes the moment of the scan.
private frr.bgp.neighbor.addressFamily @defaults("afi safi prefixesReceived prefixesSent") {
  // Address family identifier (ipv4, ipv6, l2vpn)
  afi string
  // Subsequent address family identifier (unicast, multicast, evpn, vpn)
  safi string
  // Prefixes FRR kept from the peer (`pfxRcd`), so after the inbound policy
  prefixesReceived int
  // Prefixes FRR sent to the peer (`pfxSnt`)
  prefixesSent int
  // Accepted prefix counter of the neighbor detail, falls back to prefixesReceived
  prefixesAccepted int
  // Prefixes the inbound policy dropped, 0 when `prefixesFilteredKnown` is false
  prefixesFiltered int
  // The FRR version reported enough counters to fill `prefixesFiltered`
  prefixesFilteredKnown bool
  // Inbound route map FRR is running for this family
  routeMapIn string
  // Outbound route map FRR is running for this family
  routeMapOut string
  // Inbound prefix list FRR is running for this family
  prefixListIn string
  // Outbound prefix list FRR is running for this family
  prefixListOut string
  // Raw address family object of `show bgp neighbors json`, which keeps the fields a given FRR version adds
  details dict
}

// FRR EVPN VNI
//
// One VNI the local VTEP knows, from `show evpn vni json`. An L2 VNI
// carries a bridge domain and its remote VTEPs. An L3 VNI carries a tenant
// VRF, so `vrf` plus `state` shows whether a tenant can route at all.
//
// This is runtime state. It describes the moment of the scan.
private frr.evpn.vni @defaults("vni type vrf state") {
  // VXLAN network identifier
  vni int
  // VNI type (L2 or L3)
  type string
  // Tenant VRF of an L3 VNI, or the VRF an L2 VNI belongs to
  vrf string
  // VXLAN interface of the VNI
  vxlanInterface string
  // SVI of an L3 VNI
  sviInterface string
  // Router MAC of an L3 VNI
  routerMac string
  // State of the VNI (e.g. Up, Down)
  state string
  // MAC entries learned in this VNI
  macCount int
  // ARP and ND entries learned in this VNI
  arpNdCount int
  // Number of remote VTEPs seen for this VNI
  remoteVtepCount int
  // Addresses of the remote VTEPs
  remoteVteps []string
  // Raw VNI object, which keeps the fields a given FRR version adds
  details dict
}

// Policy routing rule
//
// One entry of the kernel policy routing database, from `ip -j rule show`.
// The rules decide which routing table a packet uses, so a rule that sends
// one tenant's traffic to another tenant's table breaks VRF separation.
//
// This is runtime state. It describes the moment of the scan.
private frr.routingRule @defaults("priority source table") {
  // Rule priority, evaluated from low to high
  priority int
  // Source selector of the rule ("all" matches every source)
  source string
  // Destination selector of the rule
  dest string
  // Routing table the rule selects, by name when /etc/iproute2/rt_tables names it
  table string
  // Numeric id of that routing table, 0 when the rule selects no table
  tableId int
  // Input interface selector
  inputInterface string
  // Output interface selector
  outputInterface string
  // Rule resolves the table from the VRF device of the packet (l3mdev)
  l3mdev bool
  // Action of a rule that does not select a table (e.g. unreachable, blackhole)
  action string
  // Protocol that installed the rule (e.g. kernel, static)
  protocol string
  // Firewall mark the rule matches
  fwmark string
  // Rule matches everything but its selectors
  invert bool
  // `suppress_prefixlength` value, -1 when the rule does not set it
  suppressPrefixLength int
}

// FRR EVPN routing table
//
// The EVPN table of the local BGP instance, read with
// `show bgp l2vpn evpn json` or, when a VNI is given, with
// `show bgp l2vpn evpn route vni <id> json`. The VNI is part of the
// command, so FRR filters before it prints.
//
// The table holds one entry per MAC, per MAC and IP pair, and per tenant
// prefix of the whole fabric, so it is bounded the same way as the
// routing table. `limit` caps how many prefixes become resources, `total`
// counts every prefix the command reported, and `truncated` says whether
// the cap was reached.
//
// This is runtime state. It describes the moment of the scan.
frr.evpn.routeTable @defaults("vni total truncated") {
  init(vni? int, limit? int)
  // VNI the query was narrowed to, 0 for the whole table
  vni int
  // Maximum number of prefixes turned into resources
  limit int
  // Number of prefixes the command reported, including the ones past the limit
  total() int
  // The command reported more prefixes than the limit
  truncated() bool
  // Prefixes, at most `limit` entries
  entries() []frr.evpn.route
}

// FRR EVPN route
//
// One prefix of the EVPN table with the paths that carry it. The bracketed
// prefix form of FRR is read apart, so the MAC address and the IP of a
// tenant workload are addressable, and the route targets of the paths are
// collected, because they decide which VRF imports the route.
//
// This is runtime state. It describes the moment of the scan.
private frr.evpn.route @defaults("prefix routeTypeName rd") {
  // Route distinguisher section the prefix was printed under, empty in a per VNI query
  rd string
  // NLRI in the bracketed form FRR prints
  prefix string
  // EVPN route type (1 to 5)
  routeType int
  // Name of the route type (e.g. mac-ip, inclusive-multicast, ip-prefix)
  routeTypeName string
  // Ethernet tag of the route
  ethernetTag int
  // MAC address the route advertises, empty when the type carries none
  macAddress string
  // IP address or prefix the route advertises, empty when the type carries none
  ip string
  // Route targets across every path of this prefix
  routeTargets []string
  // Paths that carry the prefix
  paths []frr.bgp.route
}

// FRR BGP routes of one session
//
// The routes one session advertises or receives, read with
// `show bgp [vrf <name>] neighbor <peer> advertised-routes json` or its
// received-routes form. The peer, the VRF and the address family are part
// of the command, so FRR filters before it prints.
//
// Received routes need `soft-reconfiguration inbound` on the session.
// Without it FRR refuses the query, and `available` is false rather than
// the resource reporting an empty table.
//
// This is runtime state. It describes the moment of the scan.
frr.bgp.peerRoutes @defaults("peer direction total truncated") {
  init(peer string, direction? string, vrf? string, afi? string, limit? int)
  // Peer address, or the interface name of an unnumbered peer
  peer string
  // Direction of the query, advertised (default) or received
  direction string
  // VRF of the session, empty for the default VRF
  vrf string
  // Address family, ipv4 (default), ipv6 or l2vpn
  afi string
  // Maximum number of prefixes turned into resources
  limit int
  // FRR answered the query. It is false when received routes are asked for without inbound soft reconfiguration.
  available() bool
  // Number of prefixes the command reported, including the ones past the limit
  total() int
  // The command reported more prefixes than the limit
  truncated() bool
  // Prefixes the policy of this direction dropped, -1 when FRR does not report it
  filteredCount() int
  // Routes, at most `limit` entries
  entries() []frr.bgp.route
}

// FRR BGP route
//
// One path of one prefix. The communities carry the tags a policy matches
// on, and the route targets among the extended communities decide which
// VRF imports the route.
//
// This is runtime state. It describes the moment of the scan.
private frr.bgp.route @defaults("prefix nexthop asPath bestPath") {
  // NLRI of the path
  prefix string
  // Prefix length, 0 when the command does not report it
  prefixLength int
  // First next hop of the path
  nexthop string
  // Router the path was learned from, empty for a local path
  peer string
  // AS path of the route, empty when the path is local
  asPath string
  // Origin of the route (e.g. IGP, EGP, Incomplete)
  origin string
  // Multi exit discriminator of the path
  metric int
  // Local preference of the path
  localPreference int
  // Weight of the path
  weight int
  // Path is valid
  valid bool
  // Path is the best path for the prefix
  bestPath bool
  // Standard communities of the path
  communities []string
  // Large communities of the path
  largeCommunities []string
  // Extended communities of the path, which include the route targets
  extendedCommunities []string
  // Route targets of the path, taken from the extended communities
  routeTargets []string
}

// HAProxy load balancer
//
// HAProxy daemon version and configuration. The configuration covers
// the global section, defaults blocks, frontends, backends, listens, the
// servers behind each backend, and supporting sections (resolvers,
// userlists, peers).
haproxy {
  // HAProxy version string extracted from the haproxy binary (e.g., "2.8.4-1")
  version() string
}

// HAProxy configuration
//
// Parsed haproxy.cfg, any `<configdir>/conf.d/*.cfg` fragments next to
// it, and every file pulled in by `!include` / `!includeglob`
// directives (HAProxy 2.4+). Exposes each section as a dedicated resource,
// plus a raw view over every section for types that are not modeled.
// Pass `init(path: "...")` to point at a non-default config file.
haproxy.config {
  init(path? string)
  // Primary configuration file (defaults to /etc/haproxy/haproxy.cfg)
  file() file
  // All configuration files visited (root + conf.d/*.cfg fragments + !included files)
  files(file) []file
  // Global section
  global(file) haproxy.config.global
  // Defaults sections: one unnamed block in classic configs, possibly several named blocks in HAProxy 2.4+
  defaults(file) []haproxy.config.defaultsSection
  // Frontend sections
  frontends(file) []haproxy.config.frontend
  // Backend sections
  backends(file) []haproxy.config.backend
  // Listen sections (combined frontend + backend)
  listens(file) []haproxy.config.listen
  // Resolvers sections (DNS resolver pools)
  resolvers(file) []haproxy.config.resolversSection
  // Userlist sections (HTTP auth groups/users)
  userlists(file) []haproxy.config.userlist
  // Peers sections (stick-table replication)
  peers(file) []haproxy.config.peersSection
  // Every parsed section in source order, including types not exposed as dedicated resources
  sections(file) []haproxy.config.section
}

// HAProxy configuration section (raw view)
//
// Arbitrary section addressed by type and name. Useful for sections not
// modeled as their own resources (mailers, cache, program, ring,
// http-errors, fcgi-app, crt-store) and for low-level audits that need
// every directive in source order.
private haproxy.config.section @defaults("type name") {
  // Section keyword (global, defaults, frontend, backend, listen, resolvers, userlist, peers, mailers, cache, ...)
  type string
  // Section name (empty for global; may be empty for the classic unnamed defaults block)
  name string
  // `from <other>` argument when present on the section header (named-defaults inheritance)
  inherits string
  // Source file path
  file string
  // 1-based source line where the section header appears
  startLine int
  // 1-based source line of the last directive in the section
  endLine int
  // Flat directive map (name -> joined args; values comma-concatenated when the directive repeats)
  params map[string]string
  // Every directive in source order (entries: {name, args, line, file, raw})
  directives []dict
  // Raw text of the section including its header line
  raw string
}

// HAProxy global section
//
// Global section: process settings (daemon, user/group, chroot,
// pidfile), connection limits, threading, the runtime stats socket, the
// default SSL options applied to every bind and server, and the log
// destinations. The default-SSL fields matter for hardening because they
// set the baseline any bind or server inherits when it doesn't override
// them locally.
private haproxy.config.global @defaults("daemon maxconn nbthread") {
  // `daemon` directive present
  daemon bool
  // `master-worker` directive present
  masterWorker bool
  // `user` directive value (UNIX uid)
  user string
  // `group` directive value (UNIX gid)
  group string
  // `chroot` directory
  chroot string
  // `pidfile` path
  pidfile string
  // `maxconn` value (global connection limit)
  maxconn int
  // `nbthread` value (worker threads per process)
  nbthread int
  // `nbproc` value (legacy; replaced by nbthread in HAProxy 2.5+)
  nbproc int
  // `hard-stop-after` value (time string, e.g. "30s")
  hardStopAfter string
  // `stats socket` path (UNIX path or address)
  statsSocket string
  // `mode` arg on the stats socket line (octal as string)
  statsSocketMode string
  // `level` arg on the stats socket line (user, operator, admin)
  statsSocketLevel string
  // `user`/`group` arg on the stats socket line: UNIX uid/gid the socket is owned by
  statsSocketUser string
  // `stats timeout` value (string with time unit)
  statsTimeout string
  // `log` directives, one entry per line (e.g. "/dev/log local0")
  log []string
  // `ssl-default-bind-ciphers` value
  sslDefaultBindCiphers string
  // `ssl-default-bind-ciphersuites` value (TLS 1.3 cipher list)
  sslDefaultBindCiphersuites string
  // `ssl-default-bind-options` value (e.g., "ssl-min-ver TLSv1.2 no-tls-tickets")
  sslDefaultBindOptions string
  // `ssl-default-bind-curves` value
  sslDefaultBindCurves string
  // `ssl-default-server-ciphers` value
  sslDefaultServerCiphers string
  // `ssl-default-server-ciphersuites` value
  sslDefaultServerCiphersuites string
  // `ssl-default-server-options` value
  sslDefaultServerOptions string
  // `ssl-default-server-curves` value
  sslDefaultServerCurves string
  // `ca-base` value (base directory for `ca-file` relative paths)
  caBase string
  // `crt-base` value (base directory for `crt` relative paths)
  crtBase string
  // `tune.ssl.default-dh-param` value
  tuneSslDefaultDhParam int
  // Every `option <name> [args]` enabled in this section
  options []string
  // Every `no option <name>` disabled in this section
  disabledOptions []string
  // All directives within this section (name -> joined args, comma-concatenated when repeated)
  params map[string]string
  // Source file path
  file string
}

// HAProxy defaults section
//
// Inherited defaults applied to every frontend, backend, and listen that
// doesn't override a setting locally. HAProxy 2.4+ supports multiple
// named defaults blocks; `name` selects which one.
private haproxy.config.defaultsSection @defaults("name mode") {
  // Defaults section name (empty for the classic unnamed defaults block)
  name string
  // `from <other-defaults>` argument when present
  inherits string
  // `mode` value (tcp, http)
  mode string
  // `balance` algorithm value
  balance string
  // `retries` value
  retries int
  // `maxconn` value (per-frontend limit when inherited)
  maxconn int
  // `option <name> [args]` directives
  options []string
  // `no option <name>` directives
  disabledOptions []string
  // `timeout <kind> <value>` map keyed by kind (connect, client, server, http-request, queue, tunnel, ...)
  timeouts map[string]string
  // `log` directives, one entry per line
  log []string
  // All directives within this defaults section
  params map[string]string
  // Source file path
  file string
}

// HAProxy frontend section
//
// Inbound traffic acceptor. Exposes its `bind` listeners (with TLS
// settings), ACL definitions, request routing rules, the default backend,
// and the timeout/log/option set applied to client traffic. Useful for
// auditing which addresses and ports are exposed and whether TLS is
// enforced on them.
private haproxy.config.frontend @defaults("name mode") {
  // Frontend name
  name string
  // `from <defaults>` argument when present
  inherits string
  // `mode` value (tcp, http)
  mode string
  // `bind` directives, broken out per address form (a comma-separated address list produces one entry per address)
  binds []haproxy.config.bind
  // `default_backend` value
  defaultBackend string
  // `acl` definitions. Entries: {name, criterion, args, line, raw}
  acls []dict
  // `use_backend` rules. Entries: {backend, condition, line, raw}
  useBackends []dict
  // `http-request <rule>` lines (raw arg strings, in source order)
  httpRequestRules []string
  // `http-response <rule>` lines
  httpResponseRules []string
  // `tcp-request <rule>` lines
  tcpRequestRules []string
  // `tcp-response <rule>` lines
  tcpResponseRules []string
  // `capture` lines (raw arg strings)
  captures []string
  // `redirect` lines
  redirects []string
  // `monitor-uri` value
  monitorUri string
  // `monitor fail` condition (everything after `monitor fail`)
  monitorFail string
  // `option <name> [args]` directives
  options []string
  // `no option <name>` directives
  disabledOptions []string
  // `timeout <kind> <value>` map keyed by kind (e.g., client, connect)
  timeouts map[string]string
  // `log` directives
  log []string
  // `maxconn` value (per-frontend concurrent connection limit)
  maxconn int
  // All directives within this frontend, keyed by directive name
  params map[string]string
  // Source file path where this frontend is defined
  file string
}

// HAProxy backend section
//
// Backend server pool. Exposes the load-balancing algorithm, the servers
// behind it, their TLS posture (ssl/verify/ca-file) and health-check
// configuration (`option httpchk`/`http-check`), `default-server` defaults,
// stick-table/cookie persistence, request mutators, and timeouts. Useful
// for verifying that backend connections are encrypted and health-checked.
private haproxy.config.backend @defaults("name mode balance") {
  // Backend name
  name string
  // `from <defaults>` argument when present
  inherits string
  // `mode` value (tcp, http)
  mode string
  // `balance` algorithm (roundrobin, leastconn, source, uri, url_param, hdr, random, ...)
  balance string
  // `hash-type` value
  hashType string
  // Servers behind this backend
  servers []haproxy.config.server
  // `default-server` directive parsed as a flag bag (same shape as a server, minus name/address)
  defaultServer dict
  // `source` directive arguments (e.g., "0.0.0.0 usesrc clientip")
  source string
  // Consolidated HTTP health check. Keys: {method, uri, version, send[], expect[], disabled}
  httpCheck dict
  // `stick-table` arguments (raw string)
  stickTable string
  // `stick on` value (raw expression)
  stickOn string
  // `cookie` directive arguments (name + flags)
  cookie string
  // `acl` definitions
  acls []dict
  // `http-request <rule>` lines
  httpRequestRules []string
  // `http-response <rule>` lines
  httpResponseRules []string
  // `tcp-request <rule>` lines
  tcpRequestRules []string
  // `tcp-response <rule>` lines
  tcpResponseRules []string
  // `option <name> [args]` directives
  options []string
  // `no option <name>` directives
  disabledOptions []string
  // `timeout <kind> <value>` map keyed by kind (e.g., server, connect, check)
  timeouts map[string]string
  // `log` directives
  log []string
  // `retries` value (defaults inherited; 0 means unset locally)
  retries int
  // All directives within this backend, keyed by directive name
  params map[string]string
  // Source file path where this backend is defined
  file string
}

// HAProxy listen section
//
// Combined frontend and backend section. Exposes the same audit surface as
// a backend (servers, balance, health checks) plus the frontend's
// `bind` listeners and ACL/routing surface, for the shorthand where a
// single section both accepts client traffic and defines its server pool.
private haproxy.config.listen @defaults("name mode") {
  // Listen section name
  name string
  // `from <defaults>` argument when present
  inherits string
  // `mode` value (tcp, http)
  mode string
  // `bind` directives, broken out per address form
  binds []haproxy.config.bind
  // `balance` algorithm
  balance string
  // Backend servers
  servers []haproxy.config.server
  // `default-server` directive parsed as a flag bag
  defaultServer dict
  // `acl` definitions
  acls []dict
  // `use_backend` rules
  useBackends []dict
  // `http-request <rule>` lines
  httpRequestRules []string
  // `http-response <rule>` lines
  httpResponseRules []string
  // `tcp-request <rule>` lines
  tcpRequestRules []string
  // `tcp-response <rule>` lines
  tcpResponseRules []string
  // Consolidated HTTP health check
  httpCheck dict
  // `option <name> [args]` directives
  options []string
  // `no option <name>` directives
  disabledOptions []string
  // `timeout <kind> <value>` map keyed by kind
  timeouts map[string]string
  // `log` directives
  log []string
  // All directives within this listen, keyed by directive name
  params map[string]string
  // Source file path where this listen section is defined
  file string
}

// HAProxy bind listener
//
// Single listener address produced by a `bind` directive. A
// `bind a:1,b:2 ssl crt foo` directive expands into one of these per
// address form; the shared parameters (ssl, crt, alpn, verify, etc.)
// are copied onto each entry. Fields expose the listen address/port and
// the full TLS posture, so you can assert that exposed listeners require
// modern TLS and client verification.
private haproxy.config.bind @defaults("address port ssl") {
  // Raw argument string after the `bind` keyword
  raw string
  // Address part: "*" for the wildcard, an IP literal, "[::]" for IPv6, "unix:/path" / "unix@..." / "abns@..." for unix sockets, or a hostname
  address string
  // TCP port for a single-port bind; 0 for unix sockets or port ranges
  port int
  // Start of a port range (e.g., `bind *:80-89`); 0 if not a range
  portRangeStart int
  // End of a port range; 0 if not a range
  portRangeEnd int
  // Whether the `ssl` flag is present (TLS termination on this listener)
  ssl bool
  // `alpn` argument (comma-separated protocols; e.g., "h2,http/1.1")
  alpn string
  // `ciphers` argument (TLS 1.0-1.2 cipher list)
  ciphers string
  // `ciphersuites` argument (TLS 1.3 cipher suite list)
  ciphersuites string
  // `curves` argument (named curve list)
  curves string
  // `crt` argument (certificate path or directory)
  crt string
  // `crt-list` argument (path to a crt-list file)
  crtList string
  // `ca-file` argument (CA bundle for client cert verification)
  caFile string
  // `verify` argument (none, optional, required)
  verify string
  // `ssl-min-ver` argument (e.g., "TLSv1.2")
  sslMinVer string
  // `ssl-max-ver` argument
  sslMaxVer string
  // Whether the `no-sslv3` flag disables SSLv3
  noSslv3 bool
  // Whether the `no-tlsv10` flag disables TLS 1.0
  noTlsv10 bool
  // Whether the `no-tlsv11` flag disables TLS 1.1
  noTlsv11 bool
  // Whether the `no-tlsv12` flag disables TLS 1.2
  noTlsv12 bool
  // Whether the `no-tlsv13` flag disables TLS 1.3
  noTlsv13 bool
  // Whether the `accept-proxy` flag requires a PROXY protocol header from the client
  acceptProxy bool
  // Whether the `transparent` flag is set (bind to non-local addresses)
  transparent bool
  // `v4v6` flag (bind on both IPv4 and IPv6 when the socket supports it)
  v4v6 bool
  // Whether the `v6only` flag restricts the socket to IPv6
  v6only bool
  // All key=value attributes on this bind line (catch-all including ones not surfaced as dedicated fields)
  params map[string]string
}

// HAProxy backend server
//
// Single member of a backend server pool. Captures the server identity
// (name/address/port), TLS posture toward the backend (ssl, verify,
// ca-file, sni, alpn), the health check tuning (inter/rise/fall/observe),
// connection limits, and persistence hooks. Useful for confirming that
// upstream connections are encrypted, verified, and actively health-checked.
private haproxy.config.server @defaults("name address port check ssl") {
  // Server name
  name string
  // Server address: hostname, IPv4, "[IPv6]", "unix@/path", or "abns@..."
  address string
  // Server port (0 for unix sockets or address-only declarations)
  port int
  // Whether the `check` flag enables active health checking
  check bool
  // Whether the `ssl` flag enables TLS to reach this server
  ssl bool
  // `verify` argument for the backend TLS connection (none, required)
  verify string
  // `ca-file` argument (CA bundle for backend cert verification)
  caFile string
  // `crt` argument (client cert presented to the backend)
  crt string
  // `sni` argument (SNI value to send)
  sni string
  // `alpn` argument
  alpn string
  // `weight` value (load-balancing weight; 0 means draining)
  weight int
  // Whether the `backup` flag is set (only used when no non-backup server is up)
  backup bool
  // Whether the `disabled` flag marks the server admin-down
  disabled bool
  // `maxconn` value (per-server concurrent connection cap)
  maxconn int
  // `maxqueue` value (queue cap before failing over)
  maxqueue int
  // `inter` value (regular health-check interval, e.g. "2s")
  inter string
  // `fastinter` value (interval immediately after a state change)
  fastInter string
  // `downinter` value (interval while marked down)
  downInter string
  // `rise` value (consecutive UP checks required to mark UP)
  rise int
  // `fall` value (consecutive failed checks required to mark DOWN)
  fall int
  // `slowstart` value (ramp-up period after a server comes back up)
  slowStart string
  // `observe` value (passive observation: l4, l7)
  observe string
  // `on-error` value (action on observed errors: fastinter, fail-check, sudden-death, mark-down)
  onError string
  // `on-marked-up` value (action when the server transitions to UP)
  onMarkedUp string
  // `on-marked-down` value (action when the server transitions to DOWN)
  onMarkedDown string
  // `cookie` value (cookie identifier for stickiness)
  cookie string
  // `resolvers` name (resolvers section used for hostname resolution)
  resolvers string
  // `init-addr` value (address resolution order at startup)
  initAddr string
  // Whether the `send-proxy` flag sends a PROXY v1 header to the backend
  sendProxy bool
  // Whether the `send-proxy-v2` flag sends a PROXY v2 header to the backend
  sendProxyV2 bool
  // Whether the `agent-check` flag enables an external agent health check
  agentCheck bool
  // `agent-port` value
  agentPort int
  // `agent-addr` value
  agentAddr string
  // `agent-inter` value (agent-check interval)
  agentInter string
  // All key=value flags on the server line (catch-all)
  params map[string]string
}

// HAProxy resolvers section
//
// DNS resolver pool used by `server` directives that resolve
// hostnames at runtime via `resolvers <name>`. Exposes the configured
// nameservers, retry/timeout tuning, and caching (`hold`) policy.
private haproxy.config.resolversSection @defaults("name") {
  // Resolvers section name
  name string
  // `nameserver <name> <addr>[:<port>]` entries. Entries: {name, address, port}
  nameservers []dict
  // `resolve_retries` value (number of retries per nameserver)
  resolveRetries int
  // `timeout <kind> <value>` map (resolve, retry)
  timeouts map[string]string
  // `accepted_payload_size` value (UDP DNS payload cap in bytes)
  acceptedPayloadSize int
  // `hold <state> <duration>` map keyed by state (valid, nx, refused, timeout, obsolete, other)
  holds map[string]string
  // All directives within this resolvers section, keyed by directive name
  params map[string]string
  // Source file path where this resolvers section is defined
  file string
}

// HAProxy userlist section
//
// HTTP-auth userlist consumed by `http-request auth` /
// `http-request deny unless { http_auth(<list>) }`. Captures users
// (with a flag indicating whether the password is hashed) and groups,
// so you can audit for cleartext (`insecure-password`) credentials.
private haproxy.config.userlist @defaults("name") {
  // Userlist name
  name string
  // `user <name> (password|insecure-password) <secret> [groups <g1,g2>]` entries. Entries: {name, password, hashed, groups}
  users []dict
  // `group <name> [users <u1,u2>]` entries. Entries: {name, users}
  groups []dict
  // Source file path where this userlist is defined
  file string
}

// HAProxy peers section
//
// Peers section used for stick-table replication between
// HAProxy instances. Exposes the peer servers and the replicated
// stick-table definitions.
private haproxy.config.peersSection @defaults("name") {
  // Peers section name
  name string
  // `bind` argument (raw; peers binds are simpler than frontend binds)
  bind string
  // `server <name> <addr>:<port>` entries (same shape as backend servers)
  servers []haproxy.config.server
  // `table <name> ...` entries. Entries: {name, type, size, expire, store, raw}
  tables []dict
  // All directives within this peers section, keyed by directive name
  params map[string]string
  // Source file path where this peers section is defined
  file string
}

// PostgreSQL postgresql.conf file
//
// Settings from the main PostgreSQL configuration file on disk, useful for
// auditing directives as they are written to the file (before the server
// has been reloaded), for example to detect drift between the on-disk
// configuration and a running server. The `include`, `include_if_exists`,
// and `include_dir` directives are resolved so the fragments they pull in
// are flattened into a single `params` map. `listenAddresses`, `port`,
// `sslEnabled`, `sslCertFile`, `sslKeyFile`, `sslCaFile`, `dataDirectory`,
// `hbaFile`, and `identFile` are convenience views into common directives.
// Pair with `postgresql.hba` and `postgresql.ident` for the auxiliary
// configuration files. By default the file is located by probing the
// well-known paths for Debian/Ubuntu and RPM installations; pass an
// explicit path with `postgresql.conf("/path/to/postgresql.conf")`.
postgresql.conf {
  init(path? string)
  // Primary configuration file
  file() file
  // All configuration files (main + included fragments)
  files(file) []file
  // Flattened key/value directives across the main file and includes
  params(file) map[string]string
  // listen_addresses directive split into individual addresses
  listenAddresses(params) []string
  // Effective port the server binds to (default 5432 when unset)
  port(params) int
  // Whether `ssl` is `on`
  sslEnabled(params) bool
  // ssl_cert_file directive
  sslCertFile(params) string
  // ssl_key_file directive
  sslKeyFile(params) string
  // ssl_ca_file directive (root CA for client cert verification)
  sslCaFile(params) string
  // ssl_min_protocol_version directive (TLSv1, TLSv1.1, TLSv1.2, TLSv1.3)
  sslMinProtocolVersion(params) string
  // ssl_ciphers directive
  sslCiphers(params) string
  // password_encryption directive (md5, scram-sha-256)
  passwordEncryption(params) string
  // data_directory directive (empty when implied by environment)
  dataDirectory(params) string
  // hba_file directive (absolute path to pg_hba.conf)
  hbaFile(params) string
  // ident_file directive (absolute path to pg_ident.conf)
  identFile(params) string
  // log_destination directive (csvlog, stderr, syslog, eventlog, jsonlog)
  logDestination(params) string
  // logging_collector directive (true when "on")
  loggingCollector(params) bool
  // log_connections directive (true when "on")
  logConnections(params) bool
  // log_disconnections directive (true when "on")
  logDisconnections(params) bool
  // log_statement directive (none, ddl, mod, all)
  logStatement(params) string
  // shared_preload_libraries directive split into individual library names
  sharedPreloadLibraries(params) []string
}

// PostgreSQL pg_hba.conf file
//
// Host-based authentication rules as written on disk. Each non-blank,
// non-comment line becomes a `postgresql.hba.rule` entry with the file's
// order preserved (rule matching is first-rule-wins in PostgreSQL, so
// order is significant). Audit the entries to flag insecure `authMethod`
// values (`trust`, `password`) or overly broad client `address` ranges.
// By default the file is located by probing the well-known paths for
// Debian/Ubuntu and RPM installations; pass an explicit path with
// `postgresql.hba(path: "/path/to/pg_hba.conf")`.
postgresql.hba {
  init(path? string)
  // File backing this pg_hba.conf
  file() file
  // Rules, in file order
  rules(file) []postgresql.hba.rule
}

// PostgreSQL pg_hba.conf rule
//
// A single host-based authentication rule parsed from disk. The
// `authMethod` field flags insecure entries (`trust`, `password`) and
// `address` flags overly broad client ranges (for example `0.0.0.0/0`).
private postgresql.hba.rule @defaults("type database user address authMethod") {
  // Line number in the source file
  lineNumber int
  // Connection type (local, host, hostssl, hostnossl, hostgssenc, hostnogssenc)
  type string
  // Database token as written (may be `all`, `replication`, `sameuser`, a comma-separated list, or `@filename`)
  database string
  // User token as written (may be `all`, a group prefixed with `+`, a comma-separated list, or `@filename`)
  user string
  // Client address (CIDR, hostname, or `samehost`/`samenet`; empty for local rules)
  address string
  // Authentication method (trust, reject, md5, scram-sha-256, gss, sspi, ident, peer, ldap, radius, cert, pam, bsd)
  authMethod string
  // Authentication method options (e.g. `ldapserver`, `clientcert`)
  options map[string]string
}

// PostgreSQL pg_ident.conf file
//
// User-name mapping rules as written on disk. Mappings translate an
// external authenticated identity (Kerberos principal, SSL CN, OS
// username) into a PostgreSQL role for the `ident`, `peer`, `gss`, and
// `cert` authentication methods. By default the file is located by
// probing the well-known paths for Debian/Ubuntu and RPM installations;
// pass an explicit path with `postgresql.ident(path: "/path/to/pg_ident.conf")`.
postgresql.ident {
  init(path? string)
  // File backing this pg_ident.conf
  file() file
  // Mappings, in file order
  mappings(file) []postgresql.ident.mapping
}

// PostgreSQL pg_ident.conf mapping
//
// A single user-name mapping parsed from disk. Maps an external
// (system) identity to the PostgreSQL role it is allowed to connect as
// under the map named by `mapName`.
private postgresql.ident.mapping @defaults("mapName systemUsername pgUsername") {
  // Line number in the source file
  lineNumber int
  // Map name referenced by `map=NAME` in pg_hba.conf
  mapName string
  // External (system) username or pattern
  systemUsername string
  // PostgreSQL role the external identity maps to
  pgUsername string
}

// MySQL Server
//
// MySQL server version and distribution as reported by the installed server
// binary. Percona Server is reported here too, since it shares MySQL's
// option file layout and binary names. Use mysql.conf for the parsed option
// files, including option groups, server and client scope options, TLS
// material, and the per-user option files under home directories. MariaDB
// installations are covered by the mariadb resource.
mysql {
  // MySQL version (e.g., "8.0.46")
  version() string
  // Distribution the server binary belongs to
  //
  // Either "mysql" or "percona". Empty when no server binary could be read.
  // The binary name does not determine this: MariaDB also installs a binary
  // called mysqld, and it is excluded here.
  flavor() string
}

// MySQL option files
//
// Options from the MySQL server option file chain on disk, useful for
// auditing settings as they are written to the file before the server has
// been restarted, for example to detect drift between the on-disk
// configuration and a running server. The `!include` and `!includedir`
// directives are resolved so the fragments they pull in contribute to
// `sections`, and option names are normalized so `-` and `_` are
// interchangeable, matching how the server treats them.
//
// Options stay grouped as the server reads them. `sections` holds every
// option group, `serverOptions` merges the groups mysqld itself reads
// (`[mysqld]`, `[server]`, and version-suffixed groups such as
// `[mysqld-8.0]`), and `clientOptions` merges `[client]`, `[mysql]`, and
// `[client-server]`, where a readable `password` exposes credentials to
// every account that can read the file. Convenience views cover networking,
// TLS, authentication and password policy, filesystem privileges, logging,
// binary logging and replication, and encryption at rest. `userFiles`
// reports the per-user option files under home directories.
//
// By default the file is located by probing the well-known paths for
// Debian/Ubuntu and RPM installations, and returns nothing when the host
// runs MariaDB rather than MySQL. Pass an explicit path with
// `mysql.conf("/etc/mysql/my.cnf")` to parse a file regardless of
// which product it belongs to.
//
// Values come from the option files. A setting given on the
// command line, which is how a container usually configures MySQL,
// is not visible here, and an option no file sets reads null rather
// than zero.
mysql.conf {
  init(path? string)
  // Primary option file
  file() file
  // All option files (main plus `!include` and `!includedir` fragments)
  files(file) []file
  // Option groups, in the order the server reads them
  sections(file) []mysql.conf.section
  // Options mysqld reads, merged last-write-wins
  serverOptions(file) map[string]string
  // Options the client programs read, merged last-write-wins
  clientOptions(file) map[string]string
  // Per-user option files found under home directories
  userFiles() []mysql.conf.userOptionFile

  // Effective port the server binds to (3306 when unset)
  port(serverOptions) int
  // bind_address split into individual addresses
  //
  // Since 8.0.13 the option accepts a comma-separated list. `*` means every
  // interface, which is also the default when the option is unset.
  bindAddress(serverOptions) []string
  // socket option (path to the Unix socket file)
  socket(serverOptions) string
  // skip_networking option, which disables TCP connections entirely
  skipNetworking(serverOptions) bool
  // skip_name_resolve option, which stops the server resolving client hostnames
  skipNameResolve(serverOptions) bool
  // max_connections option (0 when unset)
  maxConnections(serverOptions) int

  // require_secure_transport option, which rejects unencrypted connections
  requireSecureTransport(serverOptions) bool
  // ssl_ca option (root CA used to verify client certificates)
  sslCaFile(serverOptions) string
  // ssl_capath option (directory of trusted CA certificates)
  sslCaPath(serverOptions) string
  // ssl_cert option (server certificate)
  sslCertFile(serverOptions) string
  // ssl_key option (server private key)
  sslKeyFile(serverOptions) string
  // ssl_crl option (certificate revocation list)
  sslCrlFile(serverOptions) string
  // ssl_cipher option (permitted ciphers for TLS 1.2 and below)
  sslCipher(serverOptions) string
  // ssl_fips_mode option (OFF, ON, or STRICT)
  sslFipsMode(serverOptions) string
  // tls_version option split into individual protocol versions
  //
  // For example TLSv1.2 and TLSv1.3. Empty when unset, in which case the
  // server's compiled-in default applies.
  tlsVersion(serverOptions) []string
  // tls_ciphersuites option (permitted TLS 1.3 cipher suites)
  tlsCiphersuites(serverOptions) string
  // X.509 certificates parsed from sslCertFile (empty if the file is unreadable)
  certificate() []network.certificate

  // default_authentication_plugin option
  //
  // For example caching_sha2_password or mysql_native_password. Superseded
  // by authenticationPolicy in 8.0.27 and later.
  defaultAuthenticationPlugin(serverOptions) string
  // authentication_policy option split into its factor entries
  authenticationPolicy(serverOptions) []string
  // skip_grant_tables option, which starts the server with all access control disabled
  skipGrantTables(serverOptions) bool
  // plugin_dir option (directory the server loads plugin libraries from)
  pluginDir(serverOptions) string
  // Plugins loaded at startup, from plugin_load and plugin_load_add
  //
  // Every `plugin_load_add` occurrence contributes, since the option
  // accumulates rather than overriding. Covers only plugins named in the
  // option files, not those built into the server or installed at runtime.
  pluginLoad(serverOptions) []string
  // early_plugin_load option split into individual library names
  earlyPluginLoad(serverOptions) []string
  // validate_password.policy option (LOW, MEDIUM, or STRONG)
  validatePasswordPolicy(serverOptions) string
  // validate_password.length option (0 when unset)
  validatePasswordLength(serverOptions) int
  // validate_password.check_user_name option
  validatePasswordCheckUserName(serverOptions) bool
  // default_password_lifetime option in days (0 when unset, meaning no expiry)
  defaultPasswordLifetime(serverOptions) int
  // password_history option (number of previous passwords that cannot be reused)
  passwordHistory(serverOptions) int
  // password_reuse_interval option in days
  passwordReuseInterval(serverOptions) int
  // password_require_current option, requiring the current password to change it
  passwordRequireCurrent(serverOptions) bool

  // Account the server drops privileges to, from the user option
  //
  // Null when the option is unset, in which case the server keeps the
  // identity of whichever account started it.
  runAsUser() user
  // datadir option (root of the data directory)
  datadir(serverOptions) string
  // basedir option (installation root)
  basedir(serverOptions) string
  // tmpdir option split into individual directories
  tmpdir(serverOptions) []string
  // secure_file_priv option
  //
  // Directory that LOAD DATA and SELECT ... INTO OUTFILE are confined to.
  // An empty value removes the restriction entirely; NULL disables the
  // statements.
  secureFilePriv(serverOptions) string
  // local_infile option, which allows LOAD DATA LOCAL from client hosts
  localInfile(serverOptions) bool
  // symbolic_links option, which lets tables be redirected outside the data directory
  symbolicLinks(serverOptions) bool
  // allow_suspicious_udfs option, which loads user-defined functions carrying only an xxx symbol
  allowSuspiciousUdfs(serverOptions) bool
  // chroot option (directory the server confines itself to)
  chroot(serverOptions) string
  // pid_file option
  pidFile(serverOptions) string
  // skip_show_database option, which restricts SHOW DATABASES to privileged accounts
  skipShowDatabase(serverOptions) bool
  // automatic_sp_privileges option, which grants routine creators access to their routines
  automaticSpPrivileges(serverOptions) bool
  // log_bin_trust_function_creators option, which drops the binary logging safety check on routines
  logBinTrustFunctionCreators(serverOptions) bool
  // sql_mode option split into individual modes
  sqlMode(serverOptions) []string

  // log_error option (error log destination)
  logError(serverOptions) string
  // log_error_verbosity option (1 errors, 2 adds warnings, 3 adds notes)
  logErrorVerbosity(serverOptions) int
  // log_output option split into destinations (FILE, TABLE, or NONE)
  logOutput(serverOptions) []string
  // general_log option, which records every statement the server receives
  generalLog(serverOptions) bool
  // general_log_file option
  generalLogFile(serverOptions) string
  // slow_query_log option
  slowQueryLog(serverOptions) bool
  // slow_query_log_file option
  slowQueryLogFile(serverOptions) string
  // audit_log_policy option (ALL, LOGINS, QUERIES, or NONE)
  auditLogPolicy(serverOptions) string
  // audit_log_file option
  auditLogFile(serverOptions) string
  // audit_log_format option (NEW, OLD, JSON, or CSV)
  auditLogFormat(serverOptions) string

  // log_bin option (base name for the binary log files)
  logBin(serverOptions) string
  // binlog_format option (ROW, STATEMENT, or MIXED)
  binlogFormat(serverOptions) string
  // binlog_expire_logs_seconds option (0 when unset, meaning no automatic purge)
  binlogExpireLogsSeconds(serverOptions) int
  // binlog_encryption option, which encrypts binary and relay log files
  binlogEncryption(serverOptions) bool
  // server_id option
  serverId(serverOptions) int
  // gtid_mode option (OFF, OFF_PERMISSIVE, ON_PERMISSIVE, or ON)
  gtidMode(serverOptions) string
  // enforce_gtid_consistency option (OFF, ON, or WARN)
  enforceGtidConsistency(serverOptions) string
  // read_only option
  readOnly(serverOptions) bool
  // super_read_only option, which extends read_only to accounts holding SUPER
  superReadOnly(serverOptions) bool

  // default_table_encryption option, applied to new schemas and tablespaces
  defaultTableEncryption(serverOptions) bool
  // table_encryption_privilege_check option
  tableEncryptionPrivilegeCheck(serverOptions) bool
  // innodb_redo_log_encrypt option
  innodbRedoLogEncrypt(serverOptions) bool
  // innodb_undo_log_encrypt option
  innodbUndoLogEncrypt(serverOptions) bool
  // keyring_file_data option (path to the keyring file holding the master keys)
  keyringFileData(serverOptions) string
}

// MySQL option group
//
// A single `[group]` from an option file, with the options declared under it
// and the files that contributed to it. The same group may be declared in
// several files across the include chain and reopened within one file, so
// `files` lists every contributor and `options` holds the merged,
// last-write-wins result.
private mysql.conf.section @defaults("name") {
  // Group name as written, without the brackets (e.g., "mysqld", "client", "mysqld-8.0")
  name string
  // Options in this group, merged last-write-wins
  options map[string]string
  // Names of the options written with no value at all
  //
  // The server treats such an option as enabled, so `options` reports them
  // with the value ON. For example `skip-name-resolve` on a line of its own.
  flags []string
  // Names of the options written with the `loose` prefix, which the server ignores when unrecognized
  looseOptions []string
  // Option files that declared this group
  files []file
}

// MySQL per-user option file
//
// An option file in a user's home directory, either `.my.cnf` or the
// obfuscated `.mylogin.cnf` credential store written by
// mysql_config_editor. The server's client programs read these in addition
// to the system option files, and they frequently hold a plaintext
// `password`, so their mode and ownership matter as much as their contents.
// Read `file.permissions` to flag files readable beyond their owner.
private mysql.conf.userOptionFile @defaults("file.path format") {
  // File backing this option file
  file file
  // Account whose home directory holds the file
  owner user
  // On-disk format
  //
  // Either "ini" for a plain-text `.my.cnf`, or "mylogin" for the
  // obfuscated `.mylogin.cnf` credential store. The contents of a
  // "mylogin" file are not decoded, so `sections` is empty for it.
  format string
  // Option groups declared in the file, empty when `format` is "mylogin"
  sections() []mysql.conf.section
}

// MariaDB Server
//
// MariaDB server version as reported by the installed server binary. Use
// mariadb.conf for the parsed option files, including option groups, server
// and client scope options, Galera cluster settings, TLS material, and the
// per-user option files under home directories.
mariadb {
  // MariaDB version (e.g., "11.8.6")
  version() string
}

// MariaDB option files
//
// Options from the MariaDB server option file chain on disk, useful for
// auditing settings as they are written to the file before the server has
// been restarted, for example to detect drift between the on-disk
// configuration and a running server. The `!include` and `!includedir`
// directives are resolved so the fragments they pull in contribute to
// `sections`, and option names are normalized so `-` and `_` are
// interchangeable, matching how the server treats them.
//
// Options stay grouped as the server reads them. `sections` holds every
// option group and `serverOptions` merges the groups mariadbd reads:
// `[mysqld]`, `[server]`, `[mariadb]`, `[mariadbd]`, `[client-server]`, and
// version-suffixed groups such as `[mariadb-11.4]`. That set is not an
// extension of MySQL's, because packaged fragments since 11.0 configure the
// server under `[mariadbd]` and ship no `[mysqld]` group at all.
// `galeraOptions` breaks out `[galera]` so cluster transport settings stay
// separable, and `clientOptions` merges the client groups, where a readable
// `password` exposes credentials to every account that can read the file.
//
// By default the file is located by probing the well-known paths for
// Debian/Ubuntu and RPM installations, and returns nothing when the host
// runs MySQL rather than MariaDB. Pass an explicit path with
// `mariadb.conf("/etc/mysql/mariadb.cnf")` to parse a file regardless
// of which product it belongs to.
//
// Values come from the option files. A setting given on the
// command line, which is how a container usually configures MariaDB,
// is not visible here, and an option no file sets reads null rather
// than zero.
mariadb.conf {
  init(path? string)
  // Primary option file
  file() file
  // All option files (main plus `!include` and `!includedir` fragments)
  files(file) []file
  // Option groups, in the order the server reads them
  sections(file) []mariadb.conf.section
  // Options mariadbd reads, merged last-write-wins
  serverOptions(file) map[string]string
  // Options the client programs read, merged last-write-wins
  clientOptions(file) map[string]string
  // Options from the `[galera]` group, which a wsrep-enabled server reads
  galeraOptions(file) map[string]string
  // Per-user option files found under home directories
  userFiles() []mariadb.conf.userOptionFile

  // Effective port the server binds to (3306 when unset)
  port(serverOptions) int
  // bind_address split into individual addresses
  bindAddress(serverOptions) []string
  // socket option (path to the Unix socket file)
  socket(serverOptions) string
  // skip_networking option, which disables TCP connections entirely
  skipNetworking(serverOptions) bool
  // skip_name_resolve option, which stops the server resolving client hostnames
  skipNameResolve(serverOptions) bool
  // max_connections option (0 when unset)
  maxConnections(serverOptions) int

  // require_secure_transport option, which rejects unencrypted connections
  requireSecureTransport(serverOptions) bool
  // ssl_ca option (root CA used to verify client certificates)
  sslCaFile(serverOptions) string
  // ssl_capath option (directory of trusted CA certificates)
  sslCaPath(serverOptions) string
  // ssl_cert option (server certificate)
  sslCertFile(serverOptions) string
  // ssl_key option (server private key)
  sslKeyFile(serverOptions) string
  // ssl_crl option (certificate revocation list)
  sslCrlFile(serverOptions) string
  // ssl_cipher option (permitted ciphers for TLS 1.2 and below)
  sslCipher(serverOptions) string
  // tls_version option split into individual protocol versions
  tlsVersion(serverOptions) []string
  // X.509 certificates parsed from sslCertFile (empty if the file is unreadable)
  certificate() []network.certificate

  // skip_grant_tables option, which starts the server with all access control disabled
  skipGrantTables(serverOptions) bool
  // plugin_dir option (directory the server loads plugin libraries from)
  pluginDir(serverOptions) string
  // Plugins loaded at startup, from plugin_load and plugin_load_add
  //
  // Every `plugin_load_add` occurrence contributes, since the option
  // accumulates rather than overriding. Debian packages install one fragment
  // per compression provider, so a stock host already names several here.
  pluginLoad(serverOptions) []string
  // simple_password_check_minimal_length option, from the simple_password_check plugin
  simplePasswordCheckMinimalLength(serverOptions) int
  // simple_password_check_digits option (digits a password must contain)
  simplePasswordCheckDigits(serverOptions) int
  // simple_password_check_letters_same_case option (letters of each case a password must contain)
  simplePasswordCheckLetters(serverOptions) int
  // simple_password_check_other_characters option (non-alphanumeric characters a password must contain)
  simplePasswordCheckOtherCharacters(serverOptions) int
  // password_reuse_check_interval option in days, from the password_reuse_check plugin
  passwordReuseCheckInterval(serverOptions) int

  // Account the server drops privileges to, from the user option
  //
  // Null when the option is unset, in which case the server keeps the
  // identity of whichever account started it.
  runAsUser() user
  // datadir option (root of the data directory)
  datadir(serverOptions) string
  // basedir option (installation root)
  basedir(serverOptions) string
  // tmpdir option split into individual directories
  tmpdir(serverOptions) []string
  // secure_file_priv option
  //
  // Directory that LOAD DATA and SELECT ... INTO OUTFILE are confined to.
  // An empty value removes the restriction entirely.
  secureFilePriv(serverOptions) string
  // local_infile option, which allows LOAD DATA LOCAL from client hosts
  localInfile(serverOptions) bool
  // symbolic_links option, which lets tables be redirected outside the data directory
  symbolicLinks(serverOptions) bool
  // allow_suspicious_udfs option, which loads user-defined functions carrying only an xxx symbol
  allowSuspiciousUdfs(serverOptions) bool
  // chroot option (directory the server confines itself to)
  chroot(serverOptions) string
  // pid_file option
  pidFile(serverOptions) string
  // skip_show_database option, which restricts SHOW DATABASES to privileged accounts
  skipShowDatabase(serverOptions) bool
  // automatic_sp_privileges option, which grants routine creators access to their routines
  automaticSpPrivileges(serverOptions) bool
  // log_bin_trust_function_creators option, which drops the binary logging safety check on routines
  logBinTrustFunctionCreators(serverOptions) bool
  // sql_mode option split into individual modes
  sqlMode(serverOptions) []string

  // log_error option (error log destination)
  logError(serverOptions) string
  // log_warnings option (verbosity of the error log)
  logWarnings(serverOptions) int
  // log_output option split into destinations (FILE, TABLE, or NONE)
  logOutput(serverOptions) []string
  // general_log option, which records every statement the server receives
  generalLog(serverOptions) bool
  // general_log_file option
  generalLogFile(serverOptions) string
  // slow_query_log option
  slowQueryLog(serverOptions) bool
  // Path the slow query log is written to
  //
  // Read from log_slow_query_file, the spelling the Debian and Ubuntu
  // packages write, falling back to the MySQL-compatible
  // slow_query_log_file. MariaDB treats the two as one setting. Empty
  // when neither is set, in which case the server derives the name from
  // the host name and writes it under datadir.
  slowQueryLogFile(serverOptions) string
  // server_audit_logging option, from the server_audit plugin
  serverAuditLogging(serverOptions) bool
  // server_audit_events option split into audited event classes
  //
  // For example CONNECT, QUERY, TABLE, and QUERY_DDL. Empty when unset.
  serverAuditEvents(serverOptions) []string
  // server_audit_file_path option
  serverAuditFilePath(serverOptions) string
  // server_audit_excl_users option split into the accounts excluded from auditing
  serverAuditExclUsers(serverOptions) []string

  // log_bin option (base name for the binary log files)
  logBin(serverOptions) string
  // binlog_format option (ROW, STATEMENT, or MIXED)
  binlogFormat(serverOptions) string
  // expire_logs_days option (0 when unset, meaning no automatic purge)
  expireLogsDays(serverOptions) int
  // server_id option
  serverId(serverOptions) int
  // gtid_strict_mode option
  gtidStrictMode(serverOptions) bool
  // read_only option
  readOnly(serverOptions) bool

  // innodb_encrypt_tables option (OFF, ON, or FORCE)
  innodbEncryptTables(serverOptions) string
  // innodb_encrypt_log option, which encrypts the InnoDB redo log
  innodbEncryptLog(serverOptions) bool
  // encrypt_tmp_disk_tables option, which encrypts on-disk temporary tables
  encryptTmpDiskTables(serverOptions) bool
  // encrypt_binlog option, which encrypts the binary and relay logs
  encryptBinlog(serverOptions) bool
  // file_key_management_filename option (path to the key file holding the encryption keys)
  fileKeyManagementFilename(serverOptions) string

  // wsrep_on option, which enables Galera cluster replication
  wsrepOn(galeraOptions) bool
  // wsrep_cluster_address option (cluster membership URL the node joins through)
  wsrepClusterAddress(galeraOptions) string
  // wsrep_cluster_name option
  wsrepClusterName(galeraOptions) string
  // wsrep_sst_method option (state snapshot transfer method, e.g. rsync or mariabackup)
  wsrepSstMethod(galeraOptions) string
  // wsrep_provider_options option
  //
  // Semicolon-separated settings passed to the Galera provider, including
  // the `socket.ssl_key`, `socket.ssl_cert`, and `socket.ssl_ca` entries
  // that secure replication traffic between nodes.
  wsrepProviderOptions(galeraOptions) string
}

// MariaDB option group
//
// A single `[group]` from an option file, with the options declared under it
// and the files that contributed to it. The same group may be declared in
// several files across the include chain and reopened within one file, so
// `files` lists every contributor and `options` holds the merged,
// last-write-wins result.
private mariadb.conf.section @defaults("name") {
  // Group name as written, without the brackets (e.g., "mariadbd", "galera", "mariadb-11.4")
  name string
  // Options in this group, merged last-write-wins
  options map[string]string
  // Names of the options written with no value at all
  //
  // The server treats such an option as enabled, so `options` reports them
  // with the value ON. For example `skip-name-resolve` on a line of its own.
  flags []string
  // Names of the options written with the `loose` prefix, which the server ignores when unrecognized
  looseOptions []string
  // Option files that declared this group
  files []file
}

// MariaDB per-user option file
//
// An option file in a user's home directory, either `.my.cnf` or the
// obfuscated `.mylogin.cnf` credential store written by
// mysql_config_editor. The server's client programs read these in addition
// to the system option files, and they frequently hold a plaintext
// `password`, so their mode and ownership matter as much as their contents.
// Read `file.permissions` to flag files readable beyond their owner.
private mariadb.conf.userOptionFile @defaults("file.path format") {
  // File backing this option file
  file file
  // Account whose home directory holds the file
  owner user
  // On-disk format
  //
  // Either "ini" for a plain-text `.my.cnf`, or "mylogin" for the
  // obfuscated `.mylogin.cnf` credential store. The contents of a
  // "mylogin" file are not decoded, so `sections` is empty for it.
  format string
  // Option groups declared in the file, empty when `format` is "mylogin"
  sections() []mariadb.conf.section
}

// MongoDB Server
//
// MongoDB server version as reported by the installed server binary. Use
// mongodb.conf for the parsed configuration file, covering network binding,
// TLS material, authentication and authorization, auditing, encryption at
// rest, replication, and query profiling.
mongodb {
  // MongoDB version (e.g., "7.0.14")
  //
  // Read by running the server binary, so it reports nothing over a
  // transport that cannot run commands. The configuration file mongodb.conf
  // reads is unaffected, since it comes off the filesystem.
  version() string
}

// MongoDB configuration file
//
// Settings from mongod.conf as written on disk, useful for auditing the
// configuration before the server has been restarted, for example to detect
// drift between the file and a running server. The file is a nested YAML
// document and has no include mechanism, so a parse reads exactly one file
// and `params` holds the whole tree as written.
//
// Convenience fields flatten the branches that carry security posture:
// network binding, TLS material, authentication and authorization, the
// setParameter block, the audit log, the system log, storage, process
// management, replication and sharding, and query profiling. Each reports
// the value the server would use, so an option left out of the file reads as
// the server default rather than as empty. That matters most where the
// default is permissive: javascriptEnabled and enableLocalhostAuthBypass are
// both on unless the file turns them off.
//
// Options written under the pre-4.2 `net.ssl` tree are reported through the
// `tls` fields, since the server still accepts them as aliases. By default
// the file is located by probing the well-known paths for Debian/Ubuntu,
// RPM, and Homebrew installations; pass an explicit path with
// `mongodb.conf("/path/to/mongod.conf")`.
mongodb.conf {
  init(path? string)
  // Configuration file
  file() file
  // Full configuration tree as written in the file
  params(file) dict

  // Effective port the server binds to (27017 when unset)
  port(params) int
  // net.bindIp option split into individual addresses
  //
  // Reports 127.0.0.1 when the option is unset, which is the server default
  // since 3.6. Both spellings the server reads are accepted: a
  // comma-delimited string and a YAML sequence. Read bindIpAll alongside it,
  // which binds every interface regardless of what this option lists.
  bindIp(params) []string
  // net.bindIpAll option, which binds every interface regardless of bindIp
  bindIpAll(params) bool
  // net.ipv6 option
  ipv6(params) bool
  // net.maxIncomingConnections option (65536 when unset)
  maxIncomingConnections(params) int
  // net.unixDomainSocket.enabled option (true when unset)
  unixDomainSocketEnabled(params) bool
  // net.unixDomainSocket.pathPrefix option
  unixDomainSocketPathPrefix(params) string
  // net.unixDomainSocket.filePermissions option as an octal string (e.g., "0700")
  unixDomainSocketFilePermissions(params) string

  // net.tls.mode option
  //
  // One of disabled, allowTLS, preferTLS, or requireTLS, and disabled when
  // no mode is set. The pre-4.2 net.ssl.mode values allowSSL, preferSSL, and
  // requireSSL are exact aliases of the last three and are reported under
  // the modern spelling.
  tlsMode(params) string
  // net.tls.certificateKeyFile option (net.ssl.PEMKeyFile before 4.2)
  tlsCertificateKeyFile(params) string
  // net.tls.CAFile option (root CA used to verify client certificates)
  tlsCaFile(params) string
  // net.tls.clusterFile option (certificate presented for membership authentication)
  tlsClusterFile(params) string
  // net.tls.clusterCAFile option (root CA used to verify other cluster members)
  tlsClusterCaFile(params) string
  // net.tls.CRLFile option
  tlsCrlFile(params) string
  // net.tls.allowConnectionsWithoutCertificates option, which admits clients that present no certificate
  tlsAllowConnectionsWithoutCertificates(params) bool
  // net.tls.allowInvalidCertificates option, which admits certificates that fail validation
  tlsAllowInvalidCertificates(params) bool
  // net.tls.allowInvalidHostnames option, which skips hostname verification
  tlsAllowInvalidHostnames(params) bool
  // net.tls.disabledProtocols option split into individual versions (TLS1_0, TLS1_1, TLS1_2, TLS1_3)
  tlsDisabledProtocols(params) []string
  // net.tls.FIPSMode option
  tlsFipsMode(params) bool
  // X.509 certificates parsed from tlsCertificateKeyFile (empty if the file is unreadable)
  certificate() []network.certificate

  // security.authorization option (enabled, disabled)
  //
  // Reported as written, and empty when unset. This stays a string rather
  // than becoming a boolean because it is not the only thing that turns
  // authorization on: setting keyFile enables client authorization by
  // itself, so an empty value here does not on its own mean access control
  // is off. Read keyFile and clusterAuthMode alongside it.
  authorization(params) string
  // security.keyFile option (shared secret for internal membership authentication)
  //
  // Setting it also enables client authorization. The mode and ownership of
  // the path it names matter as much as its contents, since any account that
  // can read the file can join the replica set.
  keyFile(params) string
  // security.clusterAuthMode option (keyFile, sendKeyFile, sendX509, x509)
  clusterAuthMode(params) string
  // security.javascriptEnabled option, which permits server-side JavaScript execution
  //
  // Reports true when unset, which is the server default.
  javascriptEnabled(params) bool
  // security.redactClientLogData option, which keeps document contents out of the logs
  redactClientLogData(params) bool
  // security.enableEncryption option (encryption at rest for the storage engine)
  enableEncryption(params) bool
  // security.encryptionKeyFile option (local key file used for encryption at rest)
  encryptionKeyFile(params) string
  // security.encryptionCipherMode option (AES256-CBC, AES256-GCM)
  encryptionCipherMode(params) string
  // security.ldap.servers option split into individual hosts
  ldapServers(params) []string
  // security.ldap.transportSecurity option
  //
  // Either "tls" or "none". A value of "none" sends LDAP credentials over an
  // unencrypted connection.
  ldapTransportSecurity(params) string

  // setParameter block as written in the file
  setParameters(params) dict
  // setParameter.enableLocalhostAuthBypass option
  //
  // Reports true when unset, which is the server default. The bypass lets a
  // connection from localhost create the first user on a server that has no
  // users yet.
  enableLocalhostAuthBypass(params) bool
  // setParameter.authenticationMechanisms option split into individual mechanisms
  authenticationMechanisms(params) []string
  // setParameter.scramIterationCount option (15000 when unset)
  scramIterationCount(params) int
  // setParameter.opensslCipherConfig option (OpenSSL cipher string)
  opensslCipherConfig(params) string
  // setParameter.auditAuthorizationSuccess option, which extends auditing to successful authorization checks
  auditAuthorizationSuccess(params) bool

  // auditLog.destination option (file, syslog, console)
  auditLogDestination(params) string
  // auditLog.format option (JSON, BSON)
  auditLogFormat(params) string
  // auditLog.path option
  auditLogPath(params) string
  // auditLog.filter option (query document restricting which events are recorded)
  auditLogFilter(params) string

  // systemLog.destination option (file, syslog)
  //
  // Empty when unset, in which case the server writes to standard output.
  logDestination(params) string
  // systemLog.path option
  logPath(params) string
  // systemLog.logAppend option, which appends to an existing log rather than replacing it
  logAppend(params) bool
  // systemLog.logRotate option (rename, reopen)
  logRotate(params) string
  // systemLog.verbosity option (0 through 5)
  logVerbosity(params) int
  // systemLog.quiet option, which reduces the events the server records
  quiet(params) bool

  // storage.dbPath option
  dbPath(params) string
  // storage.engine option (wiredTiger, inMemory)
  storageEngine(params) string
  // storage.directoryPerDB option
  directoryPerDB(params) bool

  // processManagement.fork option, which runs the server as a background daemon
  fork(params) bool
  // processManagement.pidFilePath option
  pidFilePath(params) string

  // replication.replSetName option
  replSetName(params) string
  // replication.oplogSizeMB option (0 when unset, which lets the server size the oplog)
  oplogSizeMB(params) int
  // replication.enableMajorityReadConcern option
  //
  // Reports true when unset, which is the server default.
  enableMajorityReadConcern(params) bool
  // sharding.clusterRole option (configsvr, shardsvr)
  clusterRole(params) string

  // operationProfiling.mode option (off, slowOp, all)
  profilingMode(params) string
  // operationProfiling.slowOpThresholdMs option (100 when unset)
  slowOpThresholdMs(params) int
}

// Apache Cassandra Server
//
// Cassandra server version as reported by the installed server binary. Use
// cassandra.conf for the parsed cassandra.yaml, covering authentication and
// authorization, client and internode encryption, at-rest encryption, audit
// logging, network binding, and the feature toggles that widen the query
// surface. JMX exposure lives in a shell script rather than in
// cassandra.yaml, so it is reached through cassandra.env, and the snitch
// topology through cassandra.rackdc.
cassandra {
  // Cassandra version (e.g., "5.0.2")
  //
  // Read by running the server binary, so it reports nothing over a
  // transport that cannot run commands. The configuration files the other
  // cassandra resources read are unaffected, since they come off the
  // filesystem.
  version() string
}

// Apache Cassandra cassandra.yaml file
//
// Settings from the main Cassandra configuration file on disk, useful for
// auditing the cluster's declared posture without a CQL session or
// credentials, and for detecting drift between the file and a running node
// that has not been restarted since it was edited. The file is a nested YAML
// document and has no include mechanism, so a parse reads exactly one file
// and `params` holds the whole tree as written.
//
// Convenience fields flatten the branches that carry security posture:
// authentication and authorization, client and internode encryption,
// encryption at rest, audit and full query logging, network binding, the
// feature toggles that widen the query surface, and storage durability. Each
// reports the value the server would use, so an option left out of the file
// reads as the server default rather than as empty. That matters most where
// the default is permissive: `authenticator` and `authorizer` both default to
// their AllowAll variants, which authenticate nobody and authorize everybody.
//
// Option names follow Cassandra 4.1 and later, which renamed most of
// cassandra.yaml. Settings that name an implementation class are read in both
// shapes the server accepts, a bare class name and a mapping carrying
// `class_name`. By default the file is located by probing the well-known
// paths for Debian/Ubuntu, RPM, and tarball installations; pass an explicit
// path with `cassandra.conf("/path/to/cassandra.yaml")`.
cassandra.conf {
  init(path? string)
  // Configuration file
  file() file
  // Full configuration tree as written in the file
  params(file) dict

  // cluster_name option, which every node in a ring must agree on
  clusterName(params) string
  // endpoint_snitch option, which decides how the cluster infers topology
  endpointSnitch(params) string
  // Class implementing seed discovery, from the seed_provider block
  seedProviderClass(params) string
  // Seed node addresses
  //
  // Read from the comma-delimited `seeds` parameter nested inside the
  // seed_provider block, which is where the server keeps them.
  seeds(params) []string

  // listen_address option, the address used for internode communication
  listenAddress(params) string
  // broadcast_address option, the address other nodes are told to use
  broadcastAddress(params) string
  // rpc_address option, the address the native transport binds to
  //
  // 0.0.0.0 here binds every interface, which puts the CQL port on any
  // network the host is attached to.
  rpcAddress(params) string
  // broadcast_rpc_address option, the address clients are told to use
  broadcastRpcAddress(params) string
  // start_native_transport option (true when unset)
  startNativeTransport(params) bool
  // native_transport_port option, the CQL port (9042 when unset)
  nativeTransportPort(params) int
  // native_transport_port_ssl option (0 when unset)
  //
  // When set, the server serves plaintext CQL on native_transport_port and
  // encrypted CQL on this one, so the plaintext port stays open.
  nativeTransportPortSsl(params) int
  // storage_port option, the internode port (7000 when unset)
  storagePort(params) int
  // ssl_storage_port option (7001 when unset)
  sslStoragePort(params) int

  // authenticator option (AllowAllAuthenticator when unset)
  authenticator(params) string
  // authorizer option (AllowAllAuthorizer when unset)
  authorizer(params) string
  // role_manager option (CassandraRoleManager when unset)
  roleManager(params) string
  // network_authorizer option (AllowAllNetworkAuthorizer when unset)
  networkAuthorizer(params) string
  // internode_authenticator option, empty when the server accepts any peer
  internodeAuthenticator(params) string
  // Whether clients must present credentials
  //
  // False when the authenticator is AllowAllAuthenticator, which is the
  // value the server uses when the option is absent, meaning any client that
  // can reach the CQL port connects without credentials. The class name is
  // matched on its trailing segment, so the short and fully qualified
  // spellings read the same.
  authenticationEnabled(params) bool
  // Whether permissions are enforced
  //
  // False when the authorizer is AllowAllAuthorizer, which is the value the
  // server uses when the option is absent. Enforcement is only meaningful
  // alongside authentication, since AllowAllAuthenticator leaves every
  // client authenticated as anonymous.
  authorizationEnabled(params) bool
  // Whether per-data-center role restrictions are enforced
  networkAuthorizationEnabled(params) bool

  // client_encryption_options.enabled option, TLS on the native transport
  clientEncryptionEnabled(params) bool
  // Whether the native transport still accepts unencrypted connections
  //
  // The client_encryption_options.optional default is conditional: true when
  // client encryption is disabled, false when it is enabled. A cluster
  // mid-rollout sets it true alongside enabled, which keeps the plaintext
  // path open.
  clientEncryptionOptional(params) bool
  // client_encryption_options.keystore option
  clientEncryptionKeystore(params) string
  // client_encryption_options.truststore option, verifying client certificates
  clientEncryptionTruststore(params) string
  // client_encryption_options.require_client_auth option, requiring client certificates
  clientEncryptionRequireClientAuth(params) bool
  // client_encryption_options.require_endpoint_verification option, checking the certificate hostname
  clientEncryptionRequireEndpointVerification(params) bool
  // client_encryption_options.protocol option (TLS when unset)
  clientEncryptionProtocol(params) string
  // client_encryption_options.cipher_suites option
  clientEncryptionCipherSuites(params) []string

  // server_encryption_options.internode_encryption option
  //
  // One of none, dc, rack, or all, and none when unset. Anything short of
  // all leaves some internode traffic in plaintext: dc encrypts only
  // cross-data-center links, rack only cross-rack ones.
  internodeEncryption(params) string
  // Whether the storage port still accepts unencrypted internode connections
  //
  // The server_encryption_options.optional default is conditional: true when
  // internode_encryption is none, false otherwise.
  serverEncryptionOptional(params) bool
  // server_encryption_options.keystore option
  serverEncryptionKeystore(params) string
  // server_encryption_options.outbound_keystore option
  //
  // Set to something other than the keystore to enable internode mutual TLS,
  // where outbound connections present a client certificate of their own.
  serverEncryptionOutboundKeystore(params) string
  // server_encryption_options.truststore option
  serverEncryptionTruststore(params) string
  // server_encryption_options.require_client_auth option, verifying peer certificates
  serverEncryptionRequireClientAuth(params) bool
  // server_encryption_options.require_endpoint_verification option
  serverEncryptionRequireEndpointVerification(params) bool
  // server_encryption_options.protocol option (TLS when unset)
  serverEncryptionProtocol(params) string
  // server_encryption_options.cipher_suites option
  serverEncryptionCipherSuites(params) []string
  // server_encryption_options.legacy_ssl_storage_port_enabled option
  //
  // Opens an encrypted listener on ssl_storage_port, intended only for the
  // duration of an upgrade to 4.0.
  legacySslStoragePortEnabled(params) bool

  // transparent_data_encryption_options.enabled option, encrypting commit log and hints on disk
  transparentDataEncryptionEnabled(params) bool
  // transparent_data_encryption_options.cipher option (e.g., "AES/CBC/PKCS5Padding")
  transparentDataEncryptionCipher(params) string
  // transparent_data_encryption_options.key_alias option, the key used for writes
  transparentDataEncryptionKeyAlias(params) string
  // Class supplying the at-rest encryption key, from the key_provider block
  transparentDataEncryptionKeyProvider(params) string

  // audit_logging_options.enabled option, recording CQL requests and authentication
  auditLoggingEnabled(params) bool
  // Class the audit log is written through (e.g., "BinAuditLogger")
  auditLogger(params) string
  // audit_logging_options.audit_logs_dir option
  auditLogsDir(params) string
  // audit_logging_options.included_keyspaces option, empty when every keyspace is audited
  auditIncludedKeyspaces(params) []string
  // audit_logging_options.excluded_keyspaces option
  auditExcludedKeyspaces(params) []string
  // audit_logging_options.included_categories option, empty when every category is audited
  auditIncludedCategories(params) []string
  // audit_logging_options.excluded_categories option
  auditExcludedCategories(params) []string
  // audit_logging_options.included_users option, empty when every user is audited
  auditIncludedUsers(params) []string
  // audit_logging_options.excluded_users option
  auditExcludedUsers(params) []string
  // full_query_logging_options.log_dir option
  //
  // Full query logging is switched on at runtime rather than in this file,
  // so a directory here sets the default the runtime command uses.
  fullQueryLogDir(params) string
  // full_query_logging_options.allow_nodetool_archive_command option
  //
  // When true, anyone who can reach nodetool or JMX can have the server run
  // a shell command of their choosing as the Cassandra user.
  fullQueryLogAllowNodetoolArchiveCommand(params) bool

  // user_defined_functions_enabled option, allowing user code to run in the server
  userDefinedFunctionsEnabled(params) bool
  // materialized_views_enabled option
  materializedViewsEnabled(params) bool
  // sasi_indexes_enabled option
  sasiIndexesEnabled(params) bool
  // drop_compact_storage_enabled option
  dropCompactStorageEnabled(params) bool
  // transient_replication_enabled option
  transientReplicationEnabled(params) bool

  // commitlog_sync option (periodic, group, or batch)
  //
  // periodic acknowledges a write before the commit log reaches disk, so a
  // crash can lose the writes since the last sync.
  commitlogSync(params) string
  // commitlog_directory option
  commitlogDirectory(params) string
  // data_file_directories option
  dataFileDirectories(params) []string
  // hints_directory option
  hintsDirectory(params) string
  // saved_caches_directory option
  savedCachesDirectory(params) string
  // disk_failure_policy option (die, stop_paranoid, stop, best_effort, ignore)
  diskFailurePolicy(params) string
  // commit_failure_policy option (die, stop, stop_commit, ignore)
  commitFailurePolicy(params) string
  // incremental_backups option
  incrementalBackups(params) bool
  // auto_snapshot option, snapshotting before a drop or truncate (true when unset)
  autoSnapshot(params) bool
}

// Apache Cassandra cassandra-env.sh file
//
// JMX exposure and the JVM system properties the launch script sets, read
// from cassandra-env.sh. Cassandra keeps its JMX posture in this shell script
// rather than in cassandra.yaml, and it is not reported by the running server
// either, so this file is the only place the settings can be audited. `localJmx`
// is the consequential one: Cassandra ships with JMX bound to localhost, and
// turning that off exposes a port that can read and write cluster state, run
// nodetool operations, and, with full query log archiving on, execute shell
// commands.
//
// The file is a script rather than a configuration file, and it ships with
// both a localhost-only and a remote branch of JMX settings present in the
// text. The `if [ "$LOCAL_JMX" = "yes" ]` conditional that selects between
// them is resolved, so `properties` holds only what the live branch sets and
// `jmxAuthenticate` reports the value that actually applies. Any other
// conditional in the file is treated as taken. Permissions on the files named
// by `jmxPasswordFile` and `jmxAccessFile` are worth checking alongside these,
// through the file resource. By default the script is located by probing the
// well-known paths for Debian/Ubuntu, RPM, and tarball installations; pass an
// explicit path with `cassandra.env("/path/to/cassandra-env.sh")`.
cassandra.env @defaults("localJmx jmxPort jmxAuthenticate") {
  init(path? string)
  // Environment script
  file() file
  // Shell variable assignments that survive the script
  //
  // LOCAL_JMX is reported as the value the script resolves to, which is the
  // assignment outside the unset-guard when there is one, the guard's own
  // default when there is not, and yes when the script assigns it nowhere.
  variables(file) map[string]string
  // JVM system properties the script appends to JVM_OPTS
  //
  // Keyed without the -D prefix, with $VAR references expanded and only the
  // live branch of the JMX conditional included.
  properties(file) map[string]string

  // Whether JMX is reachable from localhost only
  //
  // True when LOCAL_JMX resolves to yes, which is how Cassandra ships. False
  // means the JMX port is bound for remote access, and the authentication
  // and TLS fields decide what protects it.
  localJmx(variables) bool
  // Port JMX binds to (7199 when the script does not say)
  jmxPort(properties) int
  // Whether JMX requires authentication
  //
  // The shipped script turns authentication off for the localhost-only case
  // and on for the remote case, so this reports false on a default install.
  // That is only safe while localJmx is true.
  jmxAuthenticate(properties) bool
  // Whether JMX connections are encrypted
  jmxSsl(properties) bool
  // Whether JMX requires a client certificate
  jmxSslRequireClientAuth(properties) bool
  // Password file backing JMX authentication, empty when unset
  jmxPasswordFile(properties) string
  // Access file mapping JMX users to read or write roles, empty when unset
  jmxAccessFile(properties) string
  // Class delegating JMX authorization to the configured authorizer, empty when unset
  jmxAuthorizer(properties) string
  // JAAS login configuration entry used for JMX authentication, empty when unset
  jmxLoginConfig(properties) string
}

// Apache Cassandra cassandra-rackdc.properties file
//
// Data center and rack this node reports to the cluster, which the
// rack-aware snitches read to place replicas. A wrong or default value here
// puts replicas that were meant to be spread across failure domains onto the
// same one, and it decides which links `internodeEncryption` set to dc or
// rack considers internal. By default the file is located by probing the
// well-known paths for Debian/Ubuntu, RPM, and tarball installations; pass an
// explicit path with `cassandra.rackdc("/path/to/cassandra-rackdc.properties")`.
cassandra.rackdc @defaults("dc rack") {
  init(path? string)
  // Properties file
  file() file
  // All properties as written in the file
  params(file) map[string]string
  // dc property, the data center name this node reports
  dc(params) string
  // rack property, the rack name this node reports
  rack(params) string
  // prefer_local property, routing traffic over the private address within a data center
  preferLocal(params) bool
  // dc_suffix property, appended to the data center name the snitch derives
  dcSuffix(params) string
}

// systemd journald configuration
//
// Configuration for the systemd journal daemon parsed from
// journald.conf. Exposes the [Journal] and other sections, letting you
// audit settings such as log Storage, Compress, retention limits, and
// forwarding. Access the parsed content through `sections`.
journald.config {
  init(path? string)
  // File of this journald configuration
  file() file
  // Flattened journald configuration parameters
  //
  // Deprecated in favor of `sections`.
  params(file) @maturity("deprecated") map[string]string
  // All sections in this journald configuration
  sections(file) []journald.config.section
}

// journald configuration section
//
// Single named section (e.g., "Journal", "Upload") from the
// journald configuration, including its `params` list of key-value pairs.
// Used together with `journald.config` to audit individual journald settings
// within a specific section.
journald.config.section @defaults("name") {
  // Name of the section (e.g., "Journal", "Upload")
  name string
  // Key-value pairs in this section
  params []journald.config.section.param
}

// journald configuration parameter
//
// Single key-value directive within a journald configuration
// section: the parameter `name` (e.g., "Storage", "Compress") and its
// `value`. Iterated from `journald.config.section.params` to assert
// specific journald settings.
journald.config.section.param @defaults("name value") {
  // Configuration parameter name
  name string
  // Configuration parameter value
  value string
}

// Service on the system
//
// Single init/service-manager unit (systemd, SysV, launchd, and others),
// selected by name (e.g., `service(name: "sshd")`). Exposes install,
// enable, and run state plus the unit type and mask/static metadata, so
// you can assert that required services run and unwanted ones stay off.
service @defaults("name running enabled type") {
  init(name string)
  // Name of the service
  name string
  // Service description
  description string
  // Whether the service is installed
  installed bool
  // Whether the service is running
  running bool
  // Whether the service is enabled (start at boot)
  enabled bool
  // Service type (e.g., simple, forking, oneshot, notify)
  type string
  // Whether the service is masked (symlinked to /dev/null so it cannot start)
  masked bool
  // Whether the service is static (unit file has no [Install] section and cannot be enabled/disabled)
  static bool
}

// All services configured on the system
//
// Collection of every service across the asset's init/service manager.
// Filter it to find running-but-unwanted or disabled-but-required
// services, e.g. `services.where(running == true)`.
services {
  []service
}

// systemd timer unit
//
// Single systemd timer, selected by name (e.g.,
// `systemd.timer(name: "logrotate")`). Exposes the schedule, the unit it
// activates, enable/mask/static state, and whether it is currently
// running, so you can audit scheduled maintenance and update jobs.
systemd.timer @defaults("name enabled running") {
  init(name string)
  // Name of the timer unit (without .timer suffix)
  name string
  // Timer unit description
  description string
  // Whether the timer unit file is installed
  installed bool
  // Whether the timer is enabled (starts at boot)
  enabled bool
  // Whether the timer is masked (symlinked to /dev/null so it cannot start)
  masked bool
  // Whether the timer is static (unit file has no [Install] section)
  static bool
  // Whether the timer is currently active
  running bool
  // The unit that this timer activates (e.g., "apt-daily.service")
  activates() string
  // Calendar expression for the timer schedule (empty for monotonic timers)
  onCalendar() string
  // Whether missed runs are triggered on next start
  persistent() bool
}

// All systemd timer units on the system
//
// Collection of every timer, for filtering by schedule, activation
// target, or status.
systemd.timers {
  []systemd.timer
}

// systemd socket unit
//
// Single socket-activated unit, selected by name (e.g.,
// `systemd.socket(name: "sshd")`). Exposes the listen addresses/ports,
// the service it activates, and enable/mask/run state, so you can audit
// which sockets expose network services.
systemd.socket @defaults("name enabled running") {
  init(name string)
  // Name of the socket unit (without .socket suffix)
  name string
  // Socket unit description
  description string
  // Whether the socket unit file is installed
  installed bool
  // Whether the socket is enabled (starts at boot)
  enabled bool
  // Whether the socket is masked (symlinked to /dev/null so it cannot start)
  masked bool
  // Whether the socket is static (unit file has no [Install] section)
  static bool
  // Whether the socket is currently active
  running bool
  // The unit that this socket activates (e.g., "dbus.service")
  activates() string
  // Addresses, paths, or ports this socket listens on
  listenAddresses() []string
  // Whether the socket accepts connections (inetd-style, one service instance per connection)
  accept() bool
}

// All systemd socket units on the system
//
// Collection of every socket-activated unit, for listen-address and
// activation-target audits.
systemd.sockets {
  []systemd.socket
}

// systemd target unit
//
// Single systemd target: its load state, active state, the unit
// file's enabled/disabled state, fragment path on disk, and the
// dependency lists (`wants`, `requires`, `after`, `before`) that
// determine which other units the target pulls in or orders around.
// Iterated from `systemd.targets`.
private systemd.target @defaults("name loadState activeState") {
  // Name of the target unit (without .target suffix)
  name string
  // Target unit description
  description string
  // Load state (e.g., loaded, not-found, masked, error)
  loadState string
  // Active state (e.g., active, inactive, failed, activating, deactivating)
  activeState string
  // Sub state for the target (e.g., active, dead)
  subState string
  // Unit file state (e.g., enabled, disabled, static, masked, alias)
  unitFileState string
  // Path to the unit file on disk
  fragmentPath string
  // Units listed in Wants= (best-effort dependencies)
  wants []string
  // Units listed in Requires= (hard dependencies)
  requires []string
  // Units listed in After= (this target starts after them)
  after []string
  // Units listed in Before= (this target starts before them)
  before []string
}

// All systemd target units on the system
//
// Collection of every target unit, for auditing boot ordering, the
// default target, and dependency wiring.
systemd.targets {
  []systemd.target
}

// systemd unit execution and sandboxing settings
//
// Single systemd unit with the execution and confinement settings from its unit
// file and drop-ins, selected by full name including the suffix (e.g.
// `systemd.unit(name: "sshd.service")`). `user` and the `protect`, `private`,
// and `restrict` settings describe how much of the host the unit can reach: a
// unit running as root with `noNewPrivileges` false and `protectSystem` set to
// `no` has the whole system available to it once the service is compromised.
// `capabilityBoundingSet` and `systemCallFilter` narrow that further, and
// `fragmentPath` locates the unit file the values came from. These settings
// belong to units that start a process, so they are empty for a unit type that
// does not, such as a target.
systemd.unit @defaults("name user noNewPrivileges protectSystem") {
  init(name string)
  // Full unit name including its suffix (e.g., sshd.service)
  name string
  // Unit description
  description string
  // Whether a unit file for this name was found
  //
  // False for a name systemd does not know, in which case every other setting
  // is reported at its zero value rather than as the unit's real state.
  installed bool
  // Path to the unit file the settings were read from
  fragmentPath string
  // Load state (e.g., loaded, not-found, masked, error)
  loadState string
  // Active state (e.g., active, inactive, failed, activating)
  activeState string
  // Unit file state (e.g., enabled, disabled, static, masked)
  unitFileState string
  // Start-up type of a service unit (e.g., simple, forking, oneshot, notify)
  type string
  // Command line started by ExecStart
  execStart string

  // Account the unit runs as, empty when it runs as root
  user string
  // Group the unit runs as, empty when the account's primary group applies
  group string
  // Whether the account the unit runs as is allocated by systemd for the run (DynamicUser)
  dynamicUser bool
  // File mode creation mask the unit starts with (UMask, e.g. 0022)
  umask string

  // Whether the unit and the processes it starts can gain new privileges (NoNewPrivileges)
  //
  // When true, a setuid binary or one carrying file capabilities cannot raise
  // privileges for this unit, which closes the most direct route out of a
  // compromised service.
  noNewPrivileges bool
  // How much of the filesystem hierarchy is read-only to the unit (ProtectSystem)
  //
  // One of `no`, `yes`, `full`, or `strict`. `yes` covers /usr and /boot, `full`
  // adds /etc, and `strict` makes the whole filesystem read-only apart from the
  // paths named in `readWritePaths`.
  protectSystem string
  // How much of the home directories the unit can see (ProtectHome)
  //
  // One of `no`, `yes`, `read-only`, or `tmpfs`.
  protectHome string
  // Whether the unit gets a private /tmp and /var/tmp (PrivateTmp)
  privateTmp bool
  // Whether the unit sees only pseudo devices rather than physical ones (PrivateDevices)
  privateDevices bool
  // Whether the unit runs in its own network namespace (PrivateNetwork)
  privateNetwork bool
  // Whether the unit gets its own user namespace holding no other accounts (PrivateUsers)
  privateUsers bool
  // Whether kernel tunables under /proc/sys and /sys are read-only to the unit (ProtectKernelTunables)
  protectKernelTunables bool
  // Whether the unit is denied loading and unloading kernel modules (ProtectKernelModules)
  protectKernelModules bool
  // Whether the kernel log ring buffer is inaccessible to the unit (ProtectKernelLogs)
  protectKernelLogs bool
  // Access the unit has to the control group hierarchy (ProtectControlGroups)
  //
  // One of `no`, `yes`, `private`, or `strict`. The `private` and `strict`
  // values arrived in later systemd releases, so this is reported as written
  // rather than as a two-state flag.
  protectControlGroups string
  // Whether the unit is denied changing the system clock (ProtectClock)
  protectClock bool
  // Whether the unit is denied changing the host name (ProtectHostname)
  protectHostname bool
  // How much of /proc belonging to other users the unit can see (ProtectProc)
  //
  // One of `noaccess`, `invisible`, `ptraceable`, or `default`.
  protectProc string
  // Which /proc entries the unit can see (ProcSubset)
  //
  // Either `all` or `pid`, where `pid` hides the entries in /proc that are not
  // processes.
  procSubset string
  // Whether the setuid and setgid bits are unusable by the unit (RestrictSUIDSGID)
  restrictSUIDSGID bool
  // Whether real-time scheduling is denied to the unit (RestrictRealtime)
  restrictRealtime bool
  // Namespace types the unit may create (RestrictNamespaces)
  //
  // Either `yes`, `no`, or a space-separated list of the permitted types such
  // as `cgroup ipc net`, so this is reported as written rather than as a flag.
  restrictNamespaces string
  // Socket address families the unit may use (RestrictAddressFamilies)
  //
  // For example `AF_UNIX AF_INET AF_INET6`. A unit held to AF_UNIX cannot open
  // a network socket at all.
  restrictAddressFamilies string
  // Whether the unit is locked to its current execution domain (LockPersonality)
  lockPersonality bool
  // Whether memory that is both writable and executable is denied (MemoryDenyWriteExecute)
  memoryDenyWriteExecute bool
  // Whether the unit is detached from the host's IPC objects (RemoveIPC)
  removeIPC bool
  // Kernel keyring the unit is given (KeyringMode)
  //
  // One of `inherit`, `private`, or `shared`.
  keyringMode string

  // Linux capabilities the unit is allowed to hold (CapabilityBoundingSet)
  //
  // An empty list is the strongest setting, leaving the unit no capabilities at
  // all. A unit running as root holding `cap_sys_admin` here has effectively
  // unrestricted access to the host. Reported as the names systemd lists;
  // releases old enough to report a numeric mask instead yield that single
  // value as written.
  capabilityBoundingSet []string
  // Capabilities passed on to the unit's unprivileged processes (AmbientCapabilities)
  ambientCapabilities []string
  // System call filter applied to the unit (SystemCallFilter)
  //
  // Entries are call names or predefined sets such as `@system-service`. A
  // leading `~` on the first entry marks the filter as a deny list rather than
  // an allow list. An empty list means no filter is applied.
  systemCallFilter []string
  // Architectures the system call filter accepts (SystemCallArchitectures)
  systemCallArchitectures string
  // Paths the unit may write to despite protectSystem (ReadWritePaths)
  readWritePaths []string
  // Paths the unit may read but not write (ReadOnlyPaths)
  readOnlyPaths []string
  // Paths made entirely inaccessible to the unit (InaccessiblePaths)
  inaccessiblePaths []string
}

// All systemd service units on the system
//
// Collection of every service unit with its execution and confinement settings.
// Service units are the ones that start a process and so the ones these
// settings apply to; a socket, timer, or target is reached through
// `systemd.socket`, `systemd.timer`, and `systemd.target` instead. Filter it to
// find daemons running unconfined, for example
// `systemd.units.where(user == "" && noNewPrivileges == false)`.
systemd.units {
  []systemd.unit
}

// systemd-resolved DNS resolver state
//
// Global DNS resolution configuration provided by
// systemd-resolved: whether the daemon is `active`, the effective DNS
// servers (`dns`) and `fallbackDns`, search `domains`, DNSSEC and
// DNS-over-TLS modes, LLMNR and multicast-DNS settings, the
// resolv.conf mode, and whether caching is enabled. Backed by
// `resolvectl status` for the Global scope. Useful for asserting that
// DNSSEC or DNS-over-TLS is enforced.
systemd.resolved @defaults("active dns") {
  // Whether the systemd-resolved daemon is currently active
  active() bool
  // Effective DNS server addresses for the Global scope
  dns() []string
  // DNS server currently in use for the Global scope
  //
  // resolvectl picks one server from the configured `dns` list at a time;
  // this is that selection. Empty when no global DNS server is active or
  // the line is not emitted (e.g., when only per-link DNS is configured).
  currentDnsServer() string
  // Fallback DNS servers used when no Link or Global DNS is configured
  fallbackDns() []string
  // DNS search domains
  domains() []string
  // DNSSEC mode
  //
  // One of `yes`, `no`, or `allow-downgrade`. May appear as `no/unsupported`
  // when the upstream resolver does not support DNSSEC.
  dnssec() string
  // DNS-over-TLS mode (e.g., `yes`, `no`, `opportunistic`)
  dnsOverTls() string
  // LLMNR mode (e.g., `yes`, `no`, `resolve`)
  llmnr() string
  // Multicast DNS mode (e.g., `yes`, `no`, `resolve`)
  multicastDns() string
  // /etc/resolv.conf management mode (e.g., `stub`, `static`, `uplink`, `foreign`)
  resolvConfMode() string
  // Whether the resolver cache is enabled
  cache() bool
}

// systemd-timesyncd NTP client state
//
// SNTP client state provided by systemd-timesyncd: whether the
// daemon is `active`, whether the system clock is currently
// `synchronized`, the configured `servers` and `fallbackServers`, the
// currently selected NTP `serverName` and `serverAddress`, the current
// poll interval, and the leap-second status. Backed by `timedatectl
// show` and `timedatectl show-timesync`. Useful for asserting that time
// is synchronized to an approved source.
systemd.timesyncd @defaults("active synchronized serverName") {
  // Whether the systemd-timesyncd daemon is currently active
  active() bool
  // Whether the system clock is synchronized to a time source
  synchronized() bool
  // NTP servers from configuration (NTP= and DHCP)
  servers() []string
  // Fallback NTP servers used when none of `servers` are reachable
  fallbackServers() []string
  // Hostname of the currently selected NTP server
  serverName() string
  // IP address of the currently selected NTP server
  serverAddress() string
  // Current poll interval in microseconds
  pollIntervalUSec() int
  // Leap second status (e.g., `normal`, `insert-second`, `delete-second`, `unknown`)
  leapStatus() string
}

// Running kernel and its modules
//
// Running kernel and its configuration surface. Exposes kernel version
// info, sysctl `parameters`, `modules`, installed kernel versions, and,
// on Linux, hardening state (`cmdline`, `taint`, `lockdown`, `aslr`).
kernel @defaults("info") {
  // Active kernel information (version, path, device, arguments)
  info() dict
  // Kernel parameters map (sysctl key-value pairs)
  parameters() map[string]string
  // List of kernel modules
  modules() []kernel.module
  // Installed kernel versions
  installed() []dict
  // Kernel boot command line (Linux only)
  cmdline() kernel.cmdline
  // Kernel taint status (Linux only)
  taint() kernel.taint
  // Kernel lockdown LSM mode (Linux only)
  lockdown() kernel.lockdown
  // Address Space Layout Randomization (ASLR) state (Linux only)
  aslr() kernel.aslr
}

// System kernel module information
//
// Single kernel module: its `name`, in-memory `size`, and
// whether it is currently `loaded`. Initialize by name (e.g.,
// `kernel.module(name: "nf_conntrack")`) to check a specific module,
// or iterate from `kernel.modules` to audit the full loaded-module list.
// Use `blacklisted`, `installBypass`, and `disabled` to express CIS-style
// "module must not load" controls without falling back to raw modprobe.d
// file parsing. Use `onDisk` to tell whether a loadable module file is
// available for the running kernel even when it isn't currently loaded,
// and `builtIn` to detect functionality compiled directly into the kernel
// (which is always active and cannot be blacklisted or unloaded).
kernel.module @defaults("name loaded") {
  init(name string)

  // Name of the kernel module
  name string
  // Size of the kernel module
  size string
  // Whether the module is loaded
  loaded bool
  // Whether the module is blacklisted in modprobe configuration
  //
  // True when any modprobe configuration file declares `blacklist <name>`.
  // Blacklisted modules will not auto-load (e.g., from udev or hotplug
  // events) but root can still force-load them with `modprobe --force`
  // or by writing to `/sys/module/...`. CIS macOS/Linux benchmarks check
  // for this to ensure unused filesystems/protocols stay off.
  blacklisted() bool
  // Whether the module's load is short-circuited to /bin/true or /bin/false
  //
  // True when any modprobe configuration file declares
  // `install <name> /bin/false` (or `/bin/true`). This is stronger than
  // blacklisting: even an explicit `modprobe <name>` is replaced with
  // the no-op binary, so the module cannot be loaded without overriding
  // the install rule.
  installBypass() bool
  // Whether the module is effectively disabled
  //
  // True when the module is either blacklisted or has an install
  // short-circuit rule. Use this as the canonical "module will not load
  // without explicit override" predicate.
  disabled() bool
  // Whether a loadable module file is installed on disk for the running kernel
  //
  // True when a `.ko` (or compressed `.ko.xz` / `.ko.zst` / `.ko.gz`)
  // file for this module exists under `/lib/modules/<version>/`, as
  // listed in that kernel's `modules.dep` index. This reports presence
  // independently of `loaded`, so it answers "the module is available to
  // load but isn't loaded right now." Modules compiled into the kernel
  // have no file on disk and report false here (see `builtIn`).
  onDisk() bool
  // Whether the module is compiled into the kernel image
  //
  // True when the functionality is built directly into the kernel
  // (configured `=y`) rather than shipped as a loadable file, as listed
  // in the running kernel's `modules.builtin` index. Built-in modules
  // are always active: they never appear in `loaded`, have no file on
  // disk (`onDisk` is false), and cannot be blacklisted or unloaded.
  builtIn() bool
}

// Linux kernel boot command line
//
// Kernel command line passed by the bootloader at boot
// time (the contents of /proc/cmdline). Use `parameters` for
// `key=value` directives and `flags` for bare tokens such as `ro`,
// `quiet`, or `nosmt`. The `raw` string is preserved for direct
// inspection or for callers that need to recover duplicate tokens.
private kernel.cmdline @defaults("raw") {
  // Raw contents of /proc/cmdline
  raw string
  // Parameters parsed from `key=value` tokens
  //
  // When a parameter appears multiple times on the command line
  // (e.g. `console=tty0 console=ttyS0`), the last occurrence wins.
  // Use `raw` for full-fidelity inspection.
  parameters map[string]string
  // Bare flags on the kernel command line (tokens without `=`)
  flags []string
}

// Linux kernel taint status
//
// Kernel taint flags as reported by /proc/sys/kernel/tainted.
// A non-zero bitmask indicates that the kernel has loaded
// proprietary or out-of-tree modules, hit a hardware error, oopsed,
// or otherwise entered a state that diverges from a clean reference
// kernel. Use `tainted` for a boolean check and `reasons` for the
// human-readable list of contributing bits.
private kernel.taint @defaults("tainted reasons") {
  // Raw taint bitmask from /proc/sys/kernel/tainted
  bitmask int
  // Whether any taint bit is set
  tainted bool
  // Human-readable taint reasons in bit order
  //
  // See the kernel.org "Tainted kernels" documentation for the full
  // list of bit meanings (proprietary module, out-of-tree module,
  // unsigned module, oops, soft lockup, live-patched, etc.).
  reasons []string
}

// Linux kernel lockdown mode
//
// Kernel lockdown LSM state from
// /sys/kernel/security/lockdown. Lockdown restricts modifications to
// a running kernel even from root: `integrity` blocks features that
// could let userspace modify the kernel (kexec, /dev/mem, etc.) and
// `confidentiality` additionally blocks features that expose kernel
// memory contents. `mode` is `unavailable` when the kernel was built
// without lockdown support.
private kernel.lockdown @defaults("mode") {
  // Active lockdown mode
  //
  // One of `none`, `integrity`, `confidentiality`, or `unavailable`.
  mode string
  // Whether lockdown is enforced (mode is `integrity` or `confidentiality`)
  enabled bool
}

// Linux Address Space Layout Randomization (ASLR) state
//
// Kernel userspace ASLR setting from
// /proc/sys/kernel/randomize_va_space. ASLR randomizes memory layout
// to make memory-corruption exploits harder; CIS benchmarks require
// `mode` 2 (full randomization).
private kernel.aslr @defaults("level enabled") {
  // Raw ASLR mode value from /proc/sys/kernel/randomize_va_space
  //
  // `0` disabled, `1` conservative (stack, libraries, vdso), `2`
  // full (also heap/brk). `-1` when the file is unavailable.
  mode int
  // Human-readable level
  //
  // One of `disabled`, `conservative`, `full`, or `unknown`.
  level string
  // Whether ASLR is enabled (`mode > 0`)
  enabled bool
}

// Linux control groups (cgroup v2)
//
// cgroup hierarchy, available controllers, and the version
// of cgroups in use. Modern Linux uses cgroup v2 (a single unified
// hierarchy at /sys/fs/cgroup); v1 hosts and hybrid setups are
// detected and reported via `version`, but per-controller hierarchies
// are not modeled. Iterate `list` to query every cgroup on the host,
// or walk down from `root` to traverse the hierarchy.
cgroups @defaults("version controllers") {
  // cgroup version in use: 2 (unified), 1 (legacy v1 only), or 0 if cgroups are not available
  version() int
  // Controllers available on the host (e.g., memory, cpu, io, pids)
  controllers() []string
  // The root cgroup
  root() cgroup
  // Flat list of every cgroup on the host
  list() []cgroup
}

// Linux control group
//
// Single cgroup v2 entry: its `path` relative to the cgroup
// root, the kernel `type` (domain, threaded, etc.), the
// systemd-inferred `unitType` (slice, scope, service, or other), the
// controllers enabled on it, memory/CPU/PIDs limits and current
// usage, and the process IDs assigned to the cgroup. Iterated from
// `cgroups.list` or traversed via `children`. Limit fields use `-1`
// to mean unlimited (the kernel's `max` literal).
private cgroup @defaults("path unitType memoryMax") {
  // Path relative to the cgroup root (e.g., /system.slice/docker-<id>.scope)
  path string
  // Kernel cgroup type from `cgroup.type`
  //
  // One of `domain`, `domain_threaded`, `domain_invalid`, or
  // `threaded`. Empty when the file is unreadable (typically the root
  // cgroup, where `cgroup.type` does not exist).
  type string
  // systemd unit kind inferred from the leaf name
  //
  // One of `slice`, `scope`, `service`, `root`, or `other`.
  unitType string
  // Controllers enabled on this cgroup (from cgroup.controllers)
  controllers []string
  // Memory hard limit in bytes; `-1` means unlimited
  memoryMax int
  // Memory soft limit / throttling watermark in bytes; `-1` means unlimited
  memoryHigh int
  // Current memory usage in bytes
  memoryCurrent int
  // Swap hard limit in bytes; `-1` means unlimited
  memorySwapMax int
  // CPU quota in microseconds per period; `-1` means unlimited
  cpuMaxQuotaUSec int
  // CPU accounting period in microseconds
  cpuMaxPeriodUSec int
  // Relative CPU weight (1-10000, default 100)
  cpuWeight int
  // PID hard limit; `-1` means unlimited
  pidsMax int
  // Current number of processes in this cgroup
  pidsCurrent int
  // Process IDs assigned to this cgroup
  pids []int
  // Child cgroups directly under this one
  children() []cgroup
}

// Docker host
//
// Images and containers managed by the local Docker daemon. The `images`
// field lists every image stored on the host with its ID, tags, digests, size,
// and labels; `containers` lists running and stopped containers with their
// state, image, command, and labels. Use it to audit what is deployed on a
// Docker host, for example `docker.containers.where(status == /Up/)` for
// currently running workloads.
docker {
  // All Docker images stored on the host
  images() []docker.image
  // All Docker containers on the host, running and stopped
  containers() []docker.container
}

// Dockerfile parser
//
// Parsed contents of a Dockerfile, giving structured access to every build
// instruction rather than the raw text. The `stages` field breaks a
// multi-stage build into its `FROM`/`RUN`/`COPY`/`ENV`/`EXPOSE`/`USER`/
// `HEALTHCHECK` instructions, `instructions` returns them in file order, and
// `finalStage` points at the stage that produces the image. Select a file with
// `docker.file(path: "/path/to/Dockerfile")` and audit it, for example
// `docker.file("Dockerfile").stages.all(runsAsRoot == false)`.
docker.file @defaults("file.path instructions.length stages.length") {
  init(path string)
  // File information about this Dockerfile
  embed file
  // All instructions in the order they appear in the file
  instructions(file) dict
  // Build stages defined in this Dockerfile
  stages(file) []docker.file.stage
  // Parser directives declared at the top of the Dockerfile
  //
  // Keys include `syntax` (frontend image pin, e.g. `docker/dockerfile:1.7`),
  // `escape` (line-continuation token, default `\`), and `check` (Buildkit
  // build-check toggles).
  directives(file) map[string]string
  // Whether the Dockerfile defines more than one stage
  multiStage(file) bool
  // Whether the Dockerfile pins a frontend via the `syntax` parser directive
  //
  // Set when the file begins with `# syntax=<image>` (e.g.
  // `# syntax=docker/dockerfile:1.7`). The directive selects a specific
  // BuildKit frontend version. Note that BuildKit-only features such as
  // `RUN --mount=type=secret` work without this directive too, so `false`
  // does not mean BuildKit is unused.
  hasSyntaxDirective(file) bool
  // Final stage in this Dockerfile
  //
  // Shortcut to the last `docker.file.stage`, which is the one that produces
  // the image when the build runs without `--target`. Null for an empty file.
  finalStage(file) docker.file.stage
}

// Build stage in a Dockerfile
//
// One `FROM`-rooted stage of a Dockerfile, with every instruction it contains
// exposed as a field: base image (`from`), environment (`env`), build
// arguments (`arg`), labels, commands (`run`, `cmd`, `entrypoint`), file
// operations (`add`, `copy`), exposed ports, health checks, volumes, and the
// effective user. The `runsAsRoot`, `hasHealthcheck`, and `final` predicates
// support common hardening audits such as checking that no stage runs as root.
private docker.file.stage @defaults("from.name") {
  // Base image this stage builds on, from its `FROM` instruction
  from docker.file.from
  // Dockerfile this stage belongs to
  file docker.file
  // ENV instructions in this stage
  env []docker.file.env
  // ARG instructions in this stage
  arg []docker.file.arg
  // LABEL instructions in this stage, as key/value pairs
  labels map[string]string
  // OpenContainer image annotations parsed from this stage's labels
  oci docker.file.oci
  // RUN instructions in this stage
  run []docker.file.run
  // CMD instruction in this stage
  cmd docker.file.run
  // USER instruction in this stage
  user docker.file.user
  // ENTRYPOINT instruction in this stage
  entrypoint docker.file.run
  // ADD instructions in this stage
  add []docker.file.add
  // COPY instructions in this stage
  copy []docker.file.copy
  // EXPOSE instructions in this stage
  expose []docker.file.expose
  // HEALTHCHECK instruction in this stage
  healthcheck docker.file.healthcheck
  // VOLUME instructions in this stage
  volumes []docker.file.volume
  // SHELL instruction in this stage
  shell docker.file.shell
  // WORKDIR instructions in this stage
  workdir []docker.file.workdir
  // STOPSIGNAL instruction in this stage
  stopsignal docker.file.stopsignal
  // ONBUILD instructions in this stage
  //
  // ONBUILD instructions are deferred and run when an image built from this
  // Dockerfile is itself used as the base image of a downstream build.
  onbuild []docker.file.onbuild
  // Whether this stage runs as root
  //
  // True when no `USER` instruction is present in the stage or when the
  // declared user resolves to UID 0 (`0` or `root`). Inherited `USER` from
  // the base image is not considered, because it is not visible from the
  // Dockerfile alone.
  runsAsRoot bool
  // Whether this stage declares a HEALTHCHECK
  //
  // True for any `HEALTHCHECK` line, including `HEALTHCHECK NONE` (which
  // explicitly disables an inherited check).
  hasHealthcheck bool
  // Whether this stage is the final stage in the Dockerfile
  //
  // Only the final stage produces the image when the Dockerfile is built
  // without `--target`.
  final bool
}

// OpenContainer image annotations declared in a build stage
//
// The `org.opencontainers.image.*` labels set via `LABEL` instructions in a
// single build stage. The standard annotations defined by the OpenContainer
// image specification are surfaced as named fields so you can read provenance
// and metadata without remembering the full annotation keys, for example the
// upstream repository (`source`), the commit it was built from (`revision`),
// the release (`version`), and the SPDX license expression (`licenses`). The
// `all` field holds every `org.opencontainers.*` label found on the stage,
// including vendor-specific annotations that have no named field. A field is
// empty when its annotation is not declared in the stage. Surrounding quotes
// are removed from values, so a quoted `LABEL` reads back unquoted; the
// verbatim form remains available in the stage `labels` map.
private docker.file.oci @defaults("source version revision") {
  // Date and time the image was built, as an RFC 3339 string (`org.opencontainers.image.created`)
  created string
  // Contact details of the people or organization responsible for the image (`org.opencontainers.image.authors`)
  authors string
  // URL to find more information about the image (`org.opencontainers.image.url`)
  url string
  // URL to get documentation about the image (`org.opencontainers.image.documentation`)
  documentation string
  // URL to the source code that built the image (`org.opencontainers.image.source`)
  source string
  // Version of the packaged software (`org.opencontainers.image.version`)
  version string
  // Source control revision the image was built from (`org.opencontainers.image.revision`)
  revision string
  // Name of the distributing entity, organization, or individual (`org.opencontainers.image.vendor`)
  vendor string
  // License(s) under which the contained software is distributed (`org.opencontainers.image.licenses`)
  //
  // An SPDX license expression, for example `Apache-2.0` or `MIT OR GPL-2.0-only`.
  licenses string
  // Name of the reference for the image's target (`org.opencontainers.image.ref.name`)
  refName string
  // Human-readable title of the image (`org.opencontainers.image.title`)
  title string
  // Human-readable description of the software packaged in the image (`org.opencontainers.image.description`)
  description string
  // Image reference of the base image this image was built on (`org.opencontainers.image.base.name`)
  baseName string
  // Digest of the base image this image was built on (`org.opencontainers.image.base.digest`)
  baseDigest string
  // Every `org.opencontainers.*` label on the stage, keyed by full annotation name
  //
  // Includes the standard annotations surfaced as named fields as well as any
  // vendor-specific or non-standard annotations under the `org.opencontainers`
  // namespace.
  all map[string]string
}

// Dockerfile ARG instruction
//
// A build argument declared with `ARG`, giving its `name` and optional
// `default` value. Build arguments are commonly misused to pass secrets, so
// their names are worth auditing.
private docker.file.arg @defaults("name default") @context("file.context") {
  // Name of the variable
  name string
  // (optional) Default value of the variable
  //
  // Values are preserved as-is, without stripping quotes.
  default string
}

// Dockerfile ENV instruction
//
// An environment variable declared with `ENV`, as a `name`/`value` pair.
// Because `ENV` values persist into the running container and image history,
// they are a frequent place for accidentally baked-in secrets.
private docker.file.env @defaults("name value") @context("file.context") {
  // Name of the variable
  name string
  // Value of the variable
  //
  // Values are preserved as-is, without stripping quotes.
  value string
}

// Dockerfile USER instruction
//
// The identity a stage switches to via `USER`, split into `user` and optional
// `group`, with `isRoot` flagging containers that would run privileged.
private docker.file.user @defaults("user") @context("file.context") {
  // User name or UID the stage switches to
  user string
  // Group name or GID the stage switches to (optional)
  group string
  // Whether the declared user is root
  //
  // True when `user` is `0` or `root`. The group is not considered.
  isRoot bool
}

// Dockerfile EXPOSE instruction
//
// A network port advertised by `EXPOSE`, with its `port` number and
// `protocol`. This documents intended listening ports, useful for reconciling
// against what a container actually binds.
private docker.file.expose @defaults("port protocol") @context("file.context") {
  // Port that is exposed
  port int
  // Protocol that is exposed (evaluates to `tcp` if not specified)
  protocol string
}

// Dockerfile FROM instruction
//
// The base image a stage is built from, parsed into its `image`, `tag`,
// `digest`, and optional `platform`, plus the stage `name` when written as
// `FROM ... AS <name>`. Pinning by `digest` rather than a floating `tag` is a
// common supply-chain requirement.
private docker.file.from @defaults("name image tag") @context("file.context") {
  // Target platform for the base image (`--platform=<os>/<arch>`), empty when not set
  platform string
  // Base image repository, e.g. `alpine` or `docker.io/library/nginx`
  image string
  // Image tag, e.g. `3.19`; empty when the image is pinned by digest only
  tag string
  // Image digest, e.g. `sha256:...`; empty when referenced by tag
  digest string
  // Stage name from `FROM ... AS <name>`, empty for an unnamed stage
  name string
}

// Dockerfile RUN instruction
//
// A command executed at build time via `RUN`, with the raw `script`, its
// BuildKit flags (`mounts`, `network`, `security`), the shell-versus-exec
// form, and a parsed `commands` breakdown. Use `commands` to audit the
// programs invoked and their options, and `mountsSecret`/`mountsSsh` to spot
// build-time credential handling.
private docker.file.run @defaults("script") @context("file.context") {
  // Raw command text of the RUN instruction
  script string
  // `--mount=...` flags applied to this RUN
  //
  // Each mount exposes a build-time secret, ssh agent socket, cache directory,
  // tmpfs, or bind-mounted source.
  mounts []docker.file.run.mount
  // `--network=...` value
  //
  // One of `default`, `none`, or `host`. Empty when the flag is not set
  // (BuildKit treats that as `default`).
  network string
  // `--security=...` value
  //
  // One of `sandbox` or `insecure`. Empty when the flag is not set.
  // `insecure` runs the step with elevated privileges and is commonly
  // flagged by security policies.
  security string
  // Whether the instruction is written in shell form
  //
  // Shell form (`RUN echo hi`) wraps the command in the stage `SHELL`
  // (default `/bin/sh -c`), allowing shell expansion, pipes, and
  // variable substitution.
  isShellForm bool
  // Whether the instruction is written in exec form
  //
  // Exec form (`RUN ["echo", "hi"]`) executes the program directly without
  // a shell, so pipes, redirects, and `${VAR}` expansion are not interpreted.
  isExecForm bool
  // Whether the instruction declares a `--mount=type=secret`
  mountsSecret bool
  // Whether the instruction declares a `--mount=type=ssh`
  mountsSsh bool
  // Individual commands parsed from the instruction
  //
  // The script split on the shell operators `&&`, `||`, `;`, and `|` (and
  // newlines) into separate commands, each tokenized into its executable and
  // arguments with leading `VAR=value` assignments removed. Exec-form
  // instructions yield a single command from the argv. Use this to audit the
  // program invoked and its options instead of substring-matching the raw
  // `script`. Parsing is best-effort: it does not descend into subshells or
  // command substitutions, and redirections (`>`, `>>`, `<`, `2>&1`) appear as
  // ordinary tokens in the following command's `args`.
  commands []docker.file.run.command
}

// Single command parsed from a Dockerfile RUN, CMD, or ENTRYPOINT
//
// One entry per command in the instruction's shell pipeline. Select the
// program with `binary` and, for tools with subcommands, `subcommand`, for
// example `binary == "apt-get"` and `subcommand == "install"`, then inspect
// `flags` for required options such as `--no-install-recommends`.
private docker.file.run.command @defaults("binary subcommand") {
  // Executable invoked, e.g. "apt-get", "curl", or "npm"
  binary string
  // First non-flag argument, e.g. "install" or "add"
  //
  // Empty when the command takes no subcommand. Resolved independently of flag
  // position, so `apt-get -y install` and `apt-get install -y` both report
  // `install`.
  subcommand string
  // Dash-prefixed options, e.g. ["--no-install-recommends", "-y"]
  //
  // A flag that carries an `=`-joined value is kept as one token, so
  // `--mount=type=bind` matches `flags.contains("--mount=type=bind")` or
  // `flags.any(_.contains("--mount"))`, not `flags.contains("--mount")`.
  flags []string
  // All arguments after the executable, in the order they appear
  args []string
}

// Dockerfile RUN --mount flag
//
// One entry per `--mount=...` flag on a `RUN` instruction.
private docker.file.run.mount @defaults("type target") {
  // Mount type
  //
  // One of `bind`, `cache`, `secret`, `ssh`, or `tmpfs`.
  type string
  // Mount destination inside the build container
  target string
  // Source path or context for `bind` and `cache` mounts
  source string
  // Stage or image to bind-mount from (`--from=<name>`)
  from string
  // Identifier
  //
  // For `cache` mounts this is the cache id; for `secret` and `ssh` mounts
  // this is the secret/ssh id supplied via `id=...`.
  id string
  // Cache sharing mode
  //
  // For `cache` mounts: `shared`, `private`, or `locked`. Empty for other types.
  sharing string
  // Whether the mount is read-only
  readOnly bool
  // Whether the secret or ssh mount is required to exist at build time
  required bool
  // Tmpfs size limit in bytes
  sizeLimit int
  // File mode for secret / ssh mounts (octal)
  mode int
  // Owner UID for secret / ssh mounts
  uid int
  // Owner GID for secret / ssh mounts
  gid int
  // Environment variable that exposes the secret to the RUN command
  env string
}

// Dockerfile ADD instruction
//
// Files brought into the image with `ADD`, which unlike `COPY` can fetch
// remote URLs and auto-extract archives. The `checksum` and `excludes` flags,
// plus the remote-fetch capability, make `ADD` a frequent audit target.
private docker.file.add @defaults("src dst") @context("file.context") {
  // Source paths, URLs, or archives to add
  src []string
  // Destination path in the image
  dst string
  // Ownership applied to the copied files (`--chown=<user>:<group>`)
  chown string
  // Permissions applied to the copied files (`--chmod=<octal>`)
  chmod string
  // Whether `--link` was set, enabling cache-friendly layered copies
  link bool
  // SHA256 digest the remote download must match (`--checksum=sha256:...`)
  //
  // Empty when the flag is not set. Frequently required by audit policies
  // to prevent unverified remote tarballs from entering the image.
  checksum string
  // Patterns excluded from the copy (`--exclude=<pattern>`)
  excludes []string
}

// Dockerfile COPY instruction
//
// Files copied into the image with `COPY`, including cross-stage and
// cross-image copies via `--from`. Auditing `from` reveals which build stages
// or external images contribute files to the final image.
private docker.file.copy @defaults("src dst") @context("file.context") {
  // Optional source to copy file(s) from when not using the default build context
  src []string
  // The destination in the image for the file(s)
  dst string
  // Ownership of the file(s)
  chown string
  // Octal permissions of the file(s)
  chmod string
  // Stage or image to copy from (`--from=<name>`)
  //
  // Set when `COPY --from=<stage>` references the output of an earlier
  // multi-stage build or an external image such as `nginx:1.27`.
  from string
  // Whether `--link` was set, enabling cache-friendly layered copies
  link bool
  // Patterns excluded from the copy (`--exclude=<pattern>`)
  excludes []string
  // Whether `--parents` was set to preserve source directory structure
  parents bool
}

// Dockerfile HEALTHCHECK instruction
//
// The container health probe declared with `HEALTHCHECK`: the `test` command
// and its timing parameters (`interval`, `timeout`, `startPeriod`, `retries`).
// `none` is true for `HEALTHCHECK NONE`, which disables any inherited check.
private docker.file.healthcheck @defaults("test") @context("file.context") {
  // The health check test command (e.g., ["CMD-SHELL", "curl -f http://localhost/ || exit 1"])
  test []string
  // Time between running the check in nanoseconds
  interval int
  // Time to wait before considering the check hung in nanoseconds
  timeout int
  // Start period for the container to initialize before counting retries in nanoseconds
  startPeriod int
  // Interval between checks during start period in nanoseconds
  startInterval int
  // Number of consecutive failures needed to report unhealthy
  retries int
  // Whether HEALTHCHECK is set to NONE (disables any inherited healthcheck)
  none bool
}

// Dockerfile VOLUME instruction
//
// A mount point declared with `VOLUME`, whose contents are excluded from image
// layers and persist outside the container.
private docker.file.volume @defaults("path") @context("file.context") {
  // Volume mount path
  path string
}

// Dockerfile SHELL instruction
//
// The default shell used for shell-form `RUN`, `CMD`, and `ENTRYPOINT`
// instructions, as set by `SHELL`. Adding `-o pipefail` here is a common
// hardening step.
private docker.file.shell @defaults("command") @context("file.context") {
  // Shell executable and flags (e.g., ["/bin/bash", "-o", "pipefail", "-c"])
  command []string
}

// Dockerfile WORKDIR instruction
//
// The working directory set by `WORKDIR` for subsequent instructions and the
// container's default directory at runtime.
private docker.file.workdir @defaults("path") @context("file.context") {
  // Working directory path
  path string
}

// Dockerfile STOPSIGNAL instruction
//
// The signal Docker sends to the container's main process on stop, as declared
// by `STOPSIGNAL`.
private docker.file.stopsignal @defaults("signal") @context("file.context") {
  // Signal name or number sent to the container on stop (e.g., `SIGTERM`, `9`)
  signal string
}

// Dockerfile ONBUILD instruction
//
// A trigger instruction registered with `ONBUILD` that runs later, when an
// image built from this Dockerfile is used as the base of a downstream build.
private docker.file.onbuild @defaults("expression") @context("file.context") {
  // The triggered instruction, exactly as written after `ONBUILD`
  //
  // For example `ONBUILD COPY . /app/src` yields `COPY . /app/src`.
  expression string
}

// Single Docker image on the host
//
// An image stored on the Docker host, with its content-addressable `id`, the
// `tags` and `repoDigests` it is known by, its `size`, and its `labels`. Use
// it to inventory images and check provenance, for example
// `docker.images.where(tags.none(_ == /latest/))` to find images not pinned to
// a floating tag.
docker.image {
  // Image ID, the content-addressable digest of the image config
  id string
  // Image size in bytes, including all layers
  size int
  // Repository digests (`repo@sha256:...`) the image is published under
  repoDigests []string
  // Repository tags (`repo:tag`) referencing this image
  tags []string
  // Image labels, as key/value pairs
  labels map[string]string
}

// Single Docker container on the host
//
// A container on the Docker host, running or stopped, with its `state`,
// `status`, source `image`, startup `command`, `labels`, and the embedded
// Linux operating system running inside it (queryable through `os`).
// `hostConfig` exposes the daemon-side runtime settings such as privilege,
// capabilities, and mounts. Filter by state, for example
// `docker.containers.where(state == "running")`.
docker.container @defaults("names.first status"){
  embed os.linux as os
  // Container ID
  id string
  // Command the container runs as its main process
  command string
  // Image reference the container was created from (`repo:tag`)
  image string
  // ID of the image the container was created from
  imageid string
  // Names assigned to the container (leading `/` stripped)
  names []string
  // Container lifecycle state (e.g., created, running, paused, restarting, exited, dead)
  state string
  // Human-readable status message (e.g., "Up 3 hours", "Exited (0) 2 days ago")
  status string
  // Container labels, as key/value pairs
  labels map[string]string
  // Host-dependent runtime configuration
  //
  // The daemon-side `HostConfig` from container inspection, covering privilege
  // (`Privileged`), added/dropped Linux capabilities, `NetworkMode`, port
  // bindings, bind mounts, and restart policy. Central to container-hardening
  // audits, for example checking `hostConfig["Privileged"] == false`.
  hostConfig() dict
}

// containerd host
//
// Containers managed by the containerd runtime, gathered across all containerd
// namespaces via the `ctr` CLI. Use it to inventory workloads on hosts that
// run containerd directly (such as Kubernetes nodes) rather than through the
// Docker daemon.
containerd {
  // All containers across every containerd namespace
  containers() []containerd.container
}

// Single containerd container
//
// A container managed by containerd, identified by `id` within its
// `namespace`, with its `image` reference, lifecycle `status`, process `pid`,
// `labels`, the `runtime` handling it (e.g. `io.containerd.runc.v2`), and the
// `snapshotter` providing its filesystem.
containerd.container @defaults("id status") {
  // Container ID
  id string
  // Container image reference
  image string
  // Container status (created, running, paused, stopped, unknown)
  status string
  // Container labels
  labels map[string]string
  // Process ID of the container's task, 0 when the container is not running
  pid int
  // containerd namespace the container belongs to
  namespace string
  // Container runtime (e.g., "io.containerd.runc.v2")
  runtime string
  // Container snapshotter
  snapshotter string
}

// Podman container engine
//
// Workloads managed by Podman, together with the engine settings that apply to
// all of them. `rootless` reports whether the engine runs without root, which
// changes what a container escape is worth, and `seccompEnabled`,
// `apparmorEnabled`, and `selinuxEnabled` report which confinement mechanisms
// the host makes available. `containers`, `images`, `pods`, `volumes`, and
// `networks` inventory the workloads themselves. On RedHat-family hosts Podman
// is the default engine and Docker is often absent, so this is where those
// workloads are found.
podman @defaults("installed version rootless") {
  // Whether the podman binary is present on the system
  installed() bool
  // Podman release reported by the engine (e.g., 5.3.1)
  version() string
  // Whether the engine runs without root privileges
  //
  // A rootless engine maps container root to an unprivileged host account, so a
  // container escape lands with far less authority than under a rootful engine.
  rootless() bool
  // Cgroup manager driving resource limits (e.g., systemd, cgroupfs)
  cgroupManager() string
  // Cgroup hierarchy version in use (e.g., v1, v2)
  cgroupVersion() string
  // OCI runtime that starts containers (e.g., crun, runc)
  ociRuntime() string
  // Network backend in use (e.g., netavark, cni)
  networkBackend() string
  // Storage driver backing container filesystems (e.g., overlay, vfs)
  storageDriver() string
  // Whether seccomp filtering is available to containers
  seccompEnabled() bool
  // Path of the default seccomp profile applied to containers
  seccompProfilePath() string
  // Whether AppArmor confinement is available to containers
  apparmorEnabled() bool
  // Whether SELinux confinement is available to containers
  selinuxEnabled() bool
  // All containers, running and stopped
  containers() []podman.container
  // All images stored on the host
  images() []podman.image
  // All pods defined on the host
  pods() []podman.pod
  // All volumes defined on the host
  volumes() []podman.volume
  // All networks defined on the host
  networks() []podman.network
}

// Podman container
//
// Single container managed by Podman, selected by `id`. The privilege fields
// describe what the container can reach on the host: `privileged` disables
// nearly every confinement at once, `effectiveCapabilities` is the capability
// set the main process actually starts with, and `securityOptions` records
// where a seccomp, AppArmor, or SELinux profile was turned off. Prefer
// `effectiveCapabilities` and `boundingCapabilities` over `capAdd` and
// `capDrop` for an audit: the engine folds a dropped capability into the
// resulting set rather than echoing it back, so a dropped capability leaves
// `capDrop` empty while the effective set shrinks.
podman.container @defaults("name state imageName") {
  init(id string)
  // Container ID
  id string
  // Primary container name
  name string
  // Every name assigned to the container
  names []string
  // Image reference the container was created from (`repo:tag`)
  imageName string
  // ID of the image the container was created from
  imageId string
  // Image the container was created from
  image() podman.image
  // Command line the container runs as its main process
  command []string
  // Lifecycle state (e.g., created, running, paused, exited, stopped)
  state string
  // Human-readable status message (e.g., "Up 3 hours")
  status string
  // Container labels, as key-value pairs
  labels map[string]string
  // Whether this is a pod's infrastructure container rather than a workload
  isInfra bool
  // Exit code of the main process, 0 while the container has not exited
  exitCode int
  // Time the container was created
  createdAt time
  // Pod the container belongs to, null when it belongs to none
  pod() podman.pod
  // Names of the networks the container is attached to
  networks []string
  // Published port mappings
  //
  // One entry per mapping, each carrying `hostIp` and `protocol` as strings and
  // `hostPort`, `containerPort`, and `range` as integers, so they compare
  // numerically (e.g., `ports.where(containerPort == 5432)`). A `hostIp` of
  // `0.0.0.0` publishes the port on every host interface, and `range` counts
  // how many consecutive ports the mapping covers, `1` for a single port.
  ports []dict

  // Whether the container runs privileged
  //
  // A privileged container keeps every capability, drops the seccomp and device
  // restrictions, and can reach host devices directly, so it is close to
  // running as root on the host.
  privileged() bool
  // Capabilities requested in addition to the engine default
  capAdd() []string
  // Capabilities requested to be removed from the engine default
  //
  // Often empty even when a capability was dropped, because the engine applies
  // the removal to the resulting set rather than recording the request. Read
  // `boundingCapabilities` to see what the container is actually left with.
  capDrop() []string
  // Capabilities the main process starts with
  effectiveCapabilities() []string
  // Upper bound on capabilities the container can ever hold
  boundingCapabilities() []string
  // Security options applied to the container
  //
  // Entries such as `seccomp=unconfined`, `label=disable`, or
  // `apparmor=unconfined`, each of which turns off a confinement mechanism the
  // engine would otherwise apply.
  securityOptions() []string
  // Whether the container's root filesystem is read-only
  readOnlyRootfs() bool
  // Account the main process runs as, empty when it runs as root
  user() string
  // Network mode (e.g., bridge, host, none, container:<id>)
  networkMode() string
  // PID namespace mode (e.g., private, host)
  pidMode() string
  // User namespace mode, empty when the container shares the engine's
  usernsMode() string
  // Restart policy name (e.g., no, always, on-failure, unless-stopped)
  restartPolicy() string
}

// Podman image
//
// Single image stored by Podman, selected by `id`. `names` holds every
// reference the image is tagged with and `repoDigests` the content-addressed
// references it was pulled by, which is what pins an image to an exact build
// rather than to a moving tag.
podman.image @defaults("repository tag size") {
  init(id string)
  // Image ID
  id string
  // Every reference the image is tagged with
  names []string
  // Repository of the first reference (e.g., docker.io/library/debian)
  repository string
  // Tag of the first reference (e.g., 13, latest)
  tag string
  // Content-addressed references the image can be pulled by
  repoDigests []string
  // Manifest digest of the image
  digest string
  // Size of the image in bytes
  size int
  // Image labels, as key-value pairs
  labels map[string]string
  // Operating system the image targets (e.g., linux)
  os string
  // Processor architecture the image targets (e.g., amd64, arm64)
  architecture string
  // Time the image was built
  createdAt time
}

// Podman pod
//
// Group of containers sharing namespaces, selected by `id`. Every pod runs an
// infrastructure container that owns the shared namespaces, reported by
// `infraContainer`, and the workload containers are reported by `containers`.
podman.pod @defaults("name status") {
  init(id string)
  // Pod ID
  id string
  // Pod name
  name string
  // Pod status (e.g., Running, Degraded, Stopped, Created, Exited)
  status string
  // Time the pod was created
  createdAt time
  // Pod labels, as key-value pairs
  labels map[string]string
  // Infrastructure container owning the pod's shared namespaces
  infraContainer() podman.container
  // Containers belonging to the pod
  containers() []podman.container
}

// Podman volume
//
// Storage volume defined by Podman, selected by `name`. `mountpoint` is the
// host path backing the volume, which is what a container writing to the volume
// ultimately writes to.
podman.volume @defaults("name driver mountpoint") {
  init(name string)
  // Volume name
  name string
  // Volume driver (e.g., local)
  driver string
  // Host path backing the volume
  mountpoint string
  // Time the volume was created
  createdAt time
  // Volume labels, as key-value pairs
  labels map[string]string
  // Driver options, as key-value pairs
  options map[string]string
  // Volume scope (e.g., local)
  scope string
  // Whether the volume was created without a name and is removed with its container
  anonymous bool
}

// Podman network
//
// Network defined by Podman, selected by `name`. `internal` marks a network
// with no route to the outside, and `subnets` holds the address ranges
// containers on it receive.
podman.network @defaults("name driver internal") {
  init(name string)
  // Network ID
  id string
  // Network name
  name string
  // Network driver (e.g., bridge, macvlan, ipvlan, host)
  driver string
  // Host interface backing the network (e.g., podman0)
  networkInterface string
  // Address ranges assigned to containers, each with its subnet and gateway
  subnets []dict
  // Whether IPv6 is enabled on the network
  ipv6Enabled bool
  // Whether the network is cut off from any route to the outside
  internal bool
  // Whether the engine resolves container names on this network
  dnsEnabled bool
  // Time the network was created
  createdAt time
}

// IPv4 packet filter (iptables)
//
// The host's IPv4 iptables ruleset: every `tables` entry (filter, nat, mangle,
// raw) with its chains and rules, plus shortcuts to the filter table's
// `input`, `output`, and `forward` chains and their default policies. A
// default `inputPolicy` of `ACCEPT` with no restricting rules is a common
// firewall-hardening finding.
iptables {
  // All tables (filter, nat, mangle, raw)
  tables() []iptables.table
  // IPv4 input chain entries (filter table)
  input() []iptables.entry
  // IPv4 output chain entries (filter table)
  output() []iptables.entry
  // IPv4 forward chain entries (filter table)
  forward() []iptables.entry
  // Default policy for the INPUT chain (e.g., ACCEPT, DROP)
  inputPolicy() string
  // Default policy for the FORWARD chain (e.g., ACCEPT, DROP)
  forwardPolicy() string
  // Default policy for the OUTPUT chain (e.g., ACCEPT, DROP)
  outputPolicy() string
}

// IPv6 packet filter (ip6tables)
//
// The host's IPv6 ip6tables ruleset: every `tables` entry (filter, nat,
// mangle, raw) with its chains and rules, plus shortcuts to the filter table's
// `input`, `output`, and `forward` chains and their default policies. Audit it
// alongside `iptables` so IPv6 traffic is filtered as strictly as IPv4.
ip6tables {
  // All tables (filter, nat, mangle, raw)
  tables() []iptables.table
  // IPv6 input chain entries (filter table)
  input() []iptables.entry
  // IPv6 output chain entries (filter table)
  output() []iptables.entry
  // IPv6 forward chain entries (filter table)
  forward() []iptables.entry
  // Default policy for the INPUT chain (e.g., ACCEPT, DROP)
  inputPolicy() string
  // Default policy for the FORWARD chain (e.g., ACCEPT, DROP)
  forwardPolicy() string
  // Default policy for the OUTPUT chain (e.g., ACCEPT, DROP)
  outputPolicy() string
}

// iptables table (filter, nat, mangle, raw)
//
// One iptables table and the `chains` it contains. The `name` selects the
// table's purpose: `filter` for packet acceptance/dropping, `nat` for address
// translation, `mangle` for packet header changes, and `raw` for connection
// tracking exemptions.
private iptables.table @defaults("name") {
  // Table name (filter, nat, mangle, raw)
  name string
  // Chains in this table
  chains []iptables.chain
}

// iptables chain within a table
//
// A chain of ordered `rules` within a table, matched against packets in
// sequence. Built-in chains (INPUT, OUTPUT, FORWARD, PREROUTING, POSTROUTING)
// carry a default `policy` applied when no rule matches; user-defined chains
// have an empty policy and are reached only via a jump target.
private iptables.chain @defaults("table name policy") {
  // Table this chain belongs to (filter, nat, mangle, raw)
  table string
  // Chain name (INPUT, OUTPUT, FORWARD, PREROUTING, POSTROUTING, or user-defined)
  name string
  // Default policy (ACCEPT, DROP, REJECT) - empty for user-defined chains
  policy string
  // Rules in this chain
  rules []iptables.entry
}

// Individual iptables rule entry
//
// A single iptables rule with its packet and byte counters, target action,
// protocol, input/output interfaces, source and destination addresses,
// matched ports, conntrack state, TCP flags, and comment. Reached from
// `iptables.input`, `iptables.output`, or `iptables.forward` to audit
// individual packet-filter rules, for example finding rules that accept
// traffic from anywhere with `iptables.input.where(target == "ACCEPT" &&
// source == "0.0.0.0/0")`.
iptables.entry {
  // Line number of statistic, which is used to create the ID
  lineNumber int
  // Packets from iptable
  packets int
  // How large the packet is in octets, including headers and everything.
  bytes int
  // What to do with the packet if it matches a rule
  target string
  // Protocol of the next level layer (e.g., TCP, UDP, ICMP, etc)
  protocol string
  // IP options
  opt string
  // Input network interface the rule matches on (empty for any)
  in string
  // Output network interface the rule matches on (empty for any)
  out string
  // Source address field that tells the receiver where the packet came from
  source string
  // The destination IP address of the traffic, subnet of the traffic, or anywhere
  destination string
  // Optional settings within the header such as internet timestamps, SACK, or record route options
  options string
  // Chain and table identifier used for the resource ID
  chain string
  // Destination port
  //
  // Single port from `--dport`. Null when the rule does not match by
  // destination port, or when it matches a range or list. See
  // `dportRange` for ranges and `dports` for multi-port matches.
  dport int
  // Destination port range, e.g. "1024:65535"
  //
  // Set when the rule uses `--dport low:high`. Empty otherwise.
  dportRange string
  // Destination port list from `-m multiport --dports`
  //
  // Empty when no `--dports` match is present. Single ports are integers;
  // ranges (e.g. "1000:2000") remain as strings unchanged.
  dports []string
  // Source port
  //
  // Single port from `--sport`. Null when the rule does not match by
  // source port, or when it matches a range or list.
  sport int
  // Source port range, e.g. "1024:65535"
  sportRange string
  // Source port list from `-m multiport --sports`
  sports []string
  // Conntrack state list from `-m state --state` or `-m conntrack --ctstate`
  //
  // Values such as NEW, ESTABLISHED, RELATED, INVALID, UNTRACKED. Empty
  // when no state/ctstate match is present.
  ctstate []string
  // TCP flag match from `-m tcp --tcp-flags`
  //
  // Two-element list: [mask, comp] (e.g., ["FIN,SYN,RST,ACK", "SYN"] for
  // `--tcp-flags FIN,SYN,RST,ACK SYN`). Empty when no `--tcp-flags` match
  // is present.
  tcpFlags []string
  // Rule comment from `-m comment --comment`
  //
  // The unquoted comment text. Empty when no comment match is present.
  comment string
  // ipset name from `-m set --match-set`
  //
  // The set name used in a `--match-set` match. Empty when no `-m set`
  // match is present.
  matchSet string
  // For `-j REJECT`, the `--reject-with` value (e.g., icmp-port-unreachable)
  //
  // Empty when target is not REJECT, or when REJECT is used without
  // `--reject-with`.
  rejectWith string
  // Canonical iptables-save line for this rule
  //
  // The exact `-A CHAIN ...` line as emitted by `iptables-save -c`. Empty
  // on systems where `iptables-save` is unavailable and the legacy `-L`
  // parser is used as a fallback.
  raw string
}

// nftables firewall
//
// The host's nftables ruleset across all address families (ip, ip6, inet, arp,
// bridge, netdev). Flattened accessors return everything at once: `tables`,
// `chains` (across all tables), `rules` (across all chains), and named `sets`.
// nftables is the modern replacement for iptables, so audit it on current
// distributions to confirm chains have restrictive policies and expected
// rules.
nftables @defaults("tables") {
  // nft version string (e.g., "1.0.2")
  version() string
  // All nftables tables
  tables() []nftables.table
  // All chains across all tables
  chains() []nftables.chain
  // All rules across all tables and chains
  rules() []nftables.rule
  // All named sets across all tables
  sets() []nftables.set
}

// nftables table
//
// Top-level container in the nftables ruleset, keyed by address family
// and name. A table holds the chains, rules, and named sets that make up
// a firewall configuration. The `family` field selects which protocol the
// table governs (ip for IPv4, ip6 for IPv6, inet for both, arp, bridge,
// or netdev), and `flags` reports table attributes such as dormant (rules
// present but not evaluated), owner, or persist. Traverse `chains`, `rules`,
// and `sets` to audit the packet-filtering policy defined here.
private nftables.table @defaults("family name") {
  // Address family (ip, ip6, inet, arp, bridge, netdev)
  family string
  // Table name
  name string
  // Table handle number
  handle int
  // Table flags (e.g., dormant, owner, persist)
  flags []string
  // Chains in this table
  chains []nftables.chain
  // Rules in this table across all chains
  rules []nftables.rule
  // Named sets in this table
  sets []nftables.set
}

// nftables chain
//
// Ordered list of rules within a table. A base chain attaches to a kernel
// hook and carries a type, hook, priority, and default policy, so it decides
// the fate of packets that fall through all its rules. A regular (non-base)
// chain is only reached by an explicit jump or goto and leaves those fields
// empty. Check `isBaseChain` to distinguish the two, and `policy` (accept or
// drop) to see the default action for a base chain, which is the key setting
// for a default-deny firewall.
private nftables.chain @defaults("family table name") {
  // Address family
  family string
  // Name of the table this chain belongs to
  table string
  // Table this chain belongs to
  tableRef() nftables.table
  // Chain name
  name string
  // Chain handle number
  handle int
  // Chain type (filter, route, nat) - only for base chains
  type string
  // Hook point (input, output, forward, prerouting, postrouting, ingress, egress) - only for base chains
  hook string
  // Chain priority - only for base chains
  prio int
  // Default policy (accept, drop) - only for base chains
  policy string
  // Whether this is a base chain (has type, hook, and priority)
  isBaseChain bool
  // Rules in this chain
  rules []nftables.rule
}

// nftables rule
//
// Single rule within a chain, identified by its handle number. The matching
// criteria and the action (accept, drop, jump, log, and so on) are parsed
// into `expr` as structured expression data, and `comment` carries any inline
// rule comment. Use `chainRef` and `tableRef` to walk back to the chain and
// table that contain the rule.
private nftables.rule @defaults("family table chain handle") {
  // Address family
  family string
  // Name of the table this rule belongs to
  table string
  // Table this rule belongs to
  tableRef() nftables.table
  // Name of the chain this rule belongs to
  chain string
  // Chain this rule belongs to
  chainRef() nftables.chain
  // Rule handle number
  handle int
  // Rule expressions as structured data
  expr []dict
  // Rule comment
  comment string
}

// nftables named set or map
//
// Named collection of elements referenced by rules in a table, keyed by
// family, table, and name. A plain set holds a group of values (addresses,
// ports, MAC addresses) that rules match against, while a map (`isMap` true,
// `valueType` non-empty) associates each key with a value for verdict or NAT
// lookups. The `keyType` gives the element data type (for example ipv4_addr,
// inet_service, ether_addr), `flags` reports set attributes (constant,
// interval, timeout, dynamic), and `elements` lists the current members as
// strings.
private nftables.set @defaults("family table name") {
  // Address family
  family string
  // Name of the table this set belongs to
  table string
  // Table this set belongs to
  tableRef() nftables.table
  // Set name
  name string
  // Set handle number
  handle int
  // Element data type (e.g., "ipv4_addr", "inet_service", "ether_addr")
  keyType string
  // Value data type for maps (empty for plain sets)
  valueType string
  // Set flags (e.g., "constant", "interval", "timeout", "dynamic")
  flags []string
  // Set elements (values as strings)
  elements []string
  // Whether this is a map (has both key and value types)
  isMap bool
  // Set timeout in seconds (0 if not set)
  timeout int
}

// UFW (Uncomplicated Firewall) state and rules
//
// Uncomplicated Firewall status, default policies, configured rules, and
// application profiles on Debian and Ubuntu systems. Check `status` to
// confirm the firewall is active, and the `defaultIncoming` /
// `defaultOutgoing` / `defaultRouted` policies for the baseline stance
// (a hardened host typically denies incoming by default). Enumerate `rules`
// to audit the explicit allow/deny entries and `applications` for the
// service profiles UFW can reference by name.
ufw @defaults("status rules") {
  // Whether UFW is active ("active", "inactive", "not installed")
  status() string
  // Default policy for incoming traffic (e.g., "deny", "allow", "reject")
  defaultIncoming() string
  // Default policy for outgoing traffic (e.g., "allow", "deny", "reject")
  defaultOutgoing() string
  // Default policy for routed traffic (e.g., "deny", "allow", "reject")
  defaultRouted() string
  // Logging level (off, low, medium, high, full)
  logging() string
  // All UFW rules
  rules() []ufw.rule
  // Application profiles from /etc/ufw/applications.d/
  applications() []ufw.application
}

// Individual UFW rule
//
// Single UFW rule as reported by `ufw status`, covering the action taken,
// the traffic direction, and the addresses, ports, protocol, and interface
// it matches. The `action` (ALLOW, DENY, REJECT, LIMIT), `direction`, and
// `port`/`from`/`to` fields together describe what the rule permits or
// blocks; `ipv6` flags IPv6 rules, and `raw` preserves the original text.
private ufw.rule @defaults("action direction port") {
  // Rule number (sequential across IPv4 and IPv6 rules; may differ from `ufw status numbered`)
  number int
  // Action (ALLOW, DENY, REJECT, LIMIT)
  action string
  // Direction (IN, OUT, FWD)
  direction string
  // Protocol (tcp, udp, any)
  protocol string
  // Port or port range (e.g., "22", "6000:6007", "any")
  port string
  // Network interface (e.g., "eth0"), empty if not specified
  interface string
  // Source address or subnet (e.g., "192.168.1.0/24", "Anywhere")
  from string
  // Destination address or subnet
  to string
  // Whether this is an IPv6 rule
  ipv6 bool
  // Raw rule text as reported by ufw
  raw string
}

// UFW application profile from /etc/ufw/applications.d/
//
// Named application profile that maps a service to the ports it needs, so
// UFW rules can reference it by name instead of listing ports. Each profile
// carries a `name` (for example "Nginx Full"), a human-readable `title` and
// `description`, and the `ports` specification it opens.
private ufw.application @defaults("name ports") {
  // Profile name (e.g., "Nginx Full")
  name string
  // Short title describing the application
  title string
  // Description of the application
  description string
  // Port specification (e.g., "80/tcp", "80,443/tcp", "80,443/tcp|443/udp")
  ports string
}

// firewalld dynamic firewall manager (RHEL/CentOS/Fedora)
//
// firewalld daemon state, the default zone, and the full set of configured
// zones on RHEL, CentOS, and Fedora systems. Check `status` to confirm the
// daemon is running and `defaultZone` for the zone applied to unclassified
// interfaces and sources. Enumerate `zones` to audit the per-zone services,
// ports, and rich rules that make up the effective policy.
firewalld @defaults("status defaultZone") {
  // Whether firewalld is running ("running", "not running", "not installed")
  status() string
  // Default zone name (e.g., "public", "home", "dmz")
  defaultZone() string
  // All configured zones
  zones() []firewalld.zone
}

// firewalld zone configuration
//
// Single firewalld zone: the trust level applied to the interfaces and
// source addresses bound to it. The `target` is the default action for
// traffic not otherwise matched (default, ACCEPT, REJECT, or DROP), and
// `active` indicates whether any interfaces or sources are bound. Audit
// `services`, `ports`, and `protocols` for what the zone permits,
// `richRules` for expressive per-source rules, and `masquerade` /
// `forwardPorts` for NAT behavior. Select a zone by name with
// `firewalld.zone(name: "public")`.
private firewalld.zone @defaults("name target") {
  init(name? string)
  // Zone name (e.g., "public", "internal", "dmz")
  name string
  // Default target (default, ACCEPT, REJECT, DROP)
  target string
  // Whether ICMP block inversion is enabled
  icmpBlockInversion bool
  // Whether this zone is currently active (has bound interfaces or sources)
  active bool
  // Network interfaces bound to this zone
  interfaces []string
  // Source addresses/subnets bound to this zone
  sources []string
  // Allowed service names (e.g., "ssh", "http", "https")
  services []string
  // Allowed ports (e.g., "80/tcp", "443/tcp", "8080-8090/udp")
  ports []string
  // Whether masquerading is enabled
  masquerade bool
  // Port forwarding rules (e.g., "port=80:proto=tcp:toport=8080")
  forwardPorts []string
  // Source ports
  sourcePorts []string
  // ICMP types that are blocked
  icmpBlocks []string
  // Rich rules (expressive firewall rules)
  richRules []firewalld.richrule
  // Allowed protocols (e.g., "icmp", "ipv6-icmp")
  protocols []string
}

// firewalld rich rule
//
// Single firewalld rich rule parsed into its parts: the address family, the
// source and destination it matches (each with a negation flag for `NOT`
// address forms), and the action it takes. The full original rule text is
// kept in `rule`. Rich rules express finer-grained policy than plain
// service/port entries, so auditing `source`, `sourceInverted`, and `action`
// together shows exactly which peers are accepted, rejected, or dropped.
private firewalld.richrule @defaults("family rule") {
  // Address family ("ipv4" or "ipv6"), empty if not specified
  family string
  // Full rich rule string
  rule string
  // Source address/subnet, empty if not specified
  source string
  // True when the source address is negated (e.g., `source NOT address="..."`)
  sourceInverted bool
  // Destination address/subnet, empty if not specified
  destination string
  // True when the destination address is negated (e.g., `destination NOT address="..."`)
  destinationInverted bool
  // Action (accept, reject, drop, mark), empty if not specified
  action string
}

// fstab persistent mount table
//
// Filesystem mount table (/etc/fstab) that defines which devices are
// mounted where at boot and with what options. Each `entries` row carries
// the device, mount point, filesystem type, and mount options, so audits
// can check for hardening flags (nodev, nosuid, noexec) on sensitive mounts.
// Select an alternate file with `fstab(path: "...")`.
fstab @defaults("path") {
  init(path? string)
  path string

  // fstab entries defined in this fstab file
  entries() []fstab.entry
}

// fstab entry for a device and its mount point
//
// Single line of the fstab: the device to mount, where it mounts, its
// filesystem type, the comma-separated mount options, and the dump/fsck
// controls. The `options` field is the one audits most often assert on
// (for example requiring nosuid,nodev,noexec on /tmp or /var).
private fstab.entry @defaults("device mountpoint") {
  // Device referenced in the fstab, e.g., LABEL=rootfs
  device string
  // Mount point, e.g., '/'
  mountpoint string
  // File system type, e.g., ext4
  fstype string
  // Mount options, e.g., defaults (`man fstab` for details)
  options string
  // Dump frequency (0 for full backup or an integer above 0, incremental backup, copies all files new or modified since the last dump of a lower level)
  dump int
  // File system check order, e.g., 1
  fsck int
}

// GRUB bootloader configuration
//
// GRUB bootloader settings drawn from /etc/default/grub and the generated
// grub.cfg. The `params` map holds the key-value defaults (for example
// GRUB_TIMEOUT and GRUB_CMDLINE_LINUX), `entries` lists the boot menu
// entries with their kernel command lines, and `passwordProtected` reports
// whether superuser plus password_pbkdf2 protection is configured, a common
// boot-security check. Override the file locations with
// `grub.config(defaultsPath: "...", grubPath: "...")`.
grub.config @defaults("defaultsPath grubPath") {
  init(defaultsPath? string, grubPath? string)
  // Path to /etc/default/grub (key-value defaults)
  defaultsPath string
  // Path to grub.cfg (generated configuration)
  grubPath string
  // Configuration parameters from /etc/default/grub (e.g., GRUB_TIMEOUT, GRUB_CMDLINE_LINUX)
  params() map[string]string
  // Menu entries defined in grub.cfg
  entries() []grub.config.entry
  // Whether GRUB password protection is enabled
  //
  // True when grub.cfg names a superuser and carries a matching password or
  // password_pbkdf2 credential, including a credential kept in the user.cfg
  // file beside grub.cfg. A credential that is still an unexpanded shell
  // variable, such as the templated block many distributions emit
  // unconditionally, does not count. Null when no grub.cfg exists, since a
  // host that does not use GRUB is neither protected nor unprotected.
  passwordProtected() bool
}

// GRUB menu entry
//
// Single boot menu entry from grub.cfg: its title, the kernel command line
// it boots with (`cmdline`), and the initrd it loads. Inspect `cmdline` to
// audit kernel boot parameters such as audit=1 or console settings.
// `isSubmenu` marks entries that group other entries rather than boot
// directly.
private grub.config.entry @defaults("title") {
  // Menu entry title
  title string
  // Kernel command line (linux/linux16/linuxefi line)
  cmdline string
  // Initrd path (initrd/initrd16/initrdefi line)
  initrd string
  // Whether this is a submenu
  isSubmenu bool
}

// FreeBSD rc.conf system configuration
//
// FreeBSD service and system configuration merged from rc.conf and
// rc.conf.local. The `entries` accessor exposes each variable assignment as
// a structured name/value pair (with the file it came from), so audits can
// assert on individual settings such as sshd_enable or a firewall being
// turned on. `content` returns the concatenated raw text. Point at a
// specific file with `sysrc(path: "...")`.
sysrc @defaults("files") {
  init(path? string)
  // List of rc.conf files that make up the configuration
  files() []file
  // Raw contents of all rc.conf files
  content(files) string
  // Parsed key-value entries from all rc.conf files
  entries(files) []sysrc.entry
}

// Single rc.conf variable entry
//
// One variable assignment from an rc.conf file: its `name`, `value`, and the
// `file` it was defined in. The source file matters because a setting in
// rc.conf.local overrides the same name in rc.conf.
private sysrc.entry @defaults("name value") {
  // Variable name
  name string
  // Variable value
  value string
  // File where this entry is defined
  file string
}

// Single process on the system
//
// Running process identified by its PID. Exposes the executable path, the
// full command line it was invoked with, its current state, and a map of
// additional per-process flags. Select a process with `process(pid: 1)`.
process @defaults("executable pid state") {
  init(pid int)
  // PID (process ID)
  pid int
  // State of the process (i.e., sleeping, running, etc)
  state() string
  // Executable that is running this process
  executable() string
  // Full command used to run this process
  command() string
  // Map of additional flags
  flags() map[string]string
}

// All processes running on the system
//
// Collection of every running process, for filtering by executable,
// command line, user, or state. For example
// `processes.where(executable == "/usr/sbin/sshd")` finds all instances of
// a daemon, or filter on state to spot zombie or stopped processes.
processes {
  []process
}

// Single TCP/UDP port on the system
//
// Single network socket: its protocol, local address and port, connection
// state, and (where the OS reports it) the owning process and the remote
// peer. The `state` field distinguishes listening sockets from established
// connections, `process` links to the program holding the socket, and `tls`
// probes the endpoint for a TLS configuration. Central to exposure audits,
// for example finding listening ports bound to a non-loopback address.
port @defaults("port protocol address process.executable") {
  // Protocol of this port
  protocol string
  // Port number
  port int
  // Local address of this port
  address string
  // User configured for this port
  user user
  // Process that is connected to this port
  process() process
  // State of this open port
  state string
  // Remote address connected to this port
  remoteAddress string
  // Remote port connected to this port
  remotePort int
  // TLS on this port, if it is available
  tls(address, port, protocol) network.tls
}

// All TCP/UDP ports on the system
//
// Collection of all network sockets, both listening and connected. The
// `listening` accessor narrows the set to sockets in the listen state, which
// is the usual starting point for an exposure audit (for example
// `ports.listening.where(address != "127.0.0.1")`).
ports {
  []port
  // All listening ports
  listening() []port
}

// Windows audit policies
//
// Deprecated in favor of windows.auditPolicy, which reports subcategory
// names and categories in English regardless of the OS display language
// and supports looking up a single subcategory by name or GUID.
auditpol @maturity("deprecated") {
  []auditpol.entry
}

// Windows audit policy entry
//
// Deprecated in favor of windows.auditPolicy.subcategory, which reports
// subcategory names and categories in English regardless of the OS display
// language. This entry carries the subcategory name, GUID, inclusion
// setting, and exclusion setting as reported by the system, plus the
// `success` and `failure` booleans derived from the inclusion setting.
auditpol.entry  @defaults("subcategory inclusionsetting exclusionsetting") @maturity("deprecated") {
  // Machine name
  machinename string
  // Policy target
  policytarget string
  // Subcategory
  subcategory string
  // Subcategory GUID
  subcategoryguid string
  // Inclusive setting
  inclusionsetting string
  // Exclusive settings
  exclusionsetting string
  // Whether the inclusion setting audits success events
  //
  // True for "Success" and "Success and Failure".
  success() bool
  // Whether the inclusion setting audits failure events
  //
  // True for "Failure" and "Success and Failure".
  failure() bool
}

// Windows local security policy
//
// Windows local security policy exported via secedit, broken into four
// maps. `systemaccess` covers password and account-lockout settings (for
// example MinimumPasswordLength, LockoutBadCount); `eventaudit` holds the
// legacy audit categories; `registryvalues` exposes security-relevant
// registry-backed policies; and `privilegerights` maps each user right (for
// example SeDenyNetworkLogonRight) to the accounts granted it. These are the
// primary source for CIS-style local policy benchmarks.
secpol {
  // System access
  systemaccess() map[string]string
  // Event audit
  eventaudit() map[string]string
  // Registry values
  registryvalues() map[string]string
  // Privilege rights
  privilegerights() map[string][]string
}

// NTP daemon configuration
//
// Classic ntpd configuration parsed into structured directives. `servers`
// lists the configured upstream time sources, `restrict` reports the access
// control directives that govern which peers and clients may interact with
// the daemon, and `fudge` carries reference-clock adjustments. `settings`
// returns every effective directive line. Select a file with
// `ntp.conf("...")`.
ntp.conf {
  init(path string)
  // File of the NTP service configuration
  file() file
  // Raw contents of the NTP service configuration
  content(file) string
  // List of settings for the NTP service
  settings(content) []string
  // List of servers for the NTP service
  servers(settings) []string
  // List of access control restrictions for the NTP service
  restrict(settings) []string
  // Additional information for clock drivers
  fudge(settings) []string
}

// Chrony NTP daemon configuration
//
// Configuration of chrony, the default NTP implementation on
// modern RHEL, Fedora, SUSE, and Debian/Ubuntu systems. The parsed
// fields expose the configuration in structured form so audits can
// assert on individual directives without regex over the raw text:
// `servers`, `pools`, and `peers` enumerate the configured time sources;
// `allow` and `deny` expose the NTP-server access control lists that
// decide which clients this host serves time to (an empty `allow` means
// the daemon does not answer client requests); `bindCmdAddresses` reports
// where the control socket listens; and `keyFile`, `makeStep`, and
// `rtcSync` cover the authentication key file, clock-stepping policy, and
// real-time-clock synchronization. Select an alternate file with
// `chrony.conf("...")`; the default resolves to `/etc/chrony.conf`
// (RHEL family) or `/etc/chrony/chrony.conf` (Debian family).
chrony.conf {
  init(path string)
  // File backing the chrony configuration
  file() file
  // Raw contents of the chrony configuration
  content(file) string
  // Effective settings with comments and blank lines removed
  settings(content) []string
  // Time sources from `server` directives (host plus any options)
  servers(settings) []string
  // Time-source pools from `pool` directives (host plus any options)
  pools(settings) []string
  // Symmetric peers from `peer` directives
  peers(settings) []string
  // Hosts permitted to use this system as a time server (`allow` directives)
  allow(settings) []string
  // Hosts denied use of this system as a time server (`deny` directives)
  deny(settings) []string
  // Addresses the command/monitoring socket binds to (`bindcmdaddress`)
  bindCmdAddresses(settings) []string
  // Path to the NTP authentication key file (`keyfile`), empty when unset
  keyFile(settings) string
  // Clock-stepping policy from the `makestep` directive, empty when unset
  makeStep(settings) string
  // Whether the real-time clock is kept in sync (`rtcsync` directive present)
  rtcSync(settings) bool
}

// Postfix mail transfer agent configuration
//
// Effective Postfix configuration. `params` reports parameter
// values from `postconf` when the binary is available (which includes the
// built-in defaults for parameters not written to the file) and otherwise
// falls back to parsing main.cf directly (file values only, with `$name`
// interpolation and continuation lines). `inetInterfaces` is the parsed
// `inet_interfaces` list and `services` are the daemon definitions from
// master.cf. By default the per-distribution config locations are used;
// select an alternate main.cf with `postfix("/path/to/main.cf")`.
postfix {
  init(path? string)
  // Path to the Postfix main.cf configuration file
  mainCfPath() string
  // Path to the Postfix master.cf configuration file
  masterCfPath() string
  // Effective Postfix parameters
  //
  // Reported by `postconf` when available (so parameters left at their
  // built-in default still appear); otherwise parsed from main.cf, in which
  // case only values written to the file are present.
  params() map[string]string
  // Interfaces Postfix listens on, parsed from the inet_interfaces parameter
  inetInterfaces() []string
  // Service definitions from master.cf
  services() []postfix.service
}

// Postfix master.cf service definition
//
// Single daemon entry from the Postfix master.cf file: its service
// name and transport type, the chroot and privilege flags, the wake-up and
// process limits, and the command it runs. The flag columns carry `y`, `n`,
// or `-` (use the built-in default). Iterated from `postfix.services`.
private postfix.service @defaults("service type command") {
  // Service name (first column; a port number, socket name, or path)
  service string
  // Transport type (inet, unix, unix-dgram, fifo, or pass)
  type string
  // Whether access is restricted to the mail system (private column: y, n, or -)
  private string
  // Whether the service runs unprivileged (unpriv column: y, n, or -)
  unprivileged string
  // Whether the service runs chrooted (chroot column: y, n, or -)
  chroot string
  // Wake-up interval, or - for none (wakeup column)
  wakeup string
  // Maximum number of processes, or - for the default (maxproc column)
  maxProcesses string
  // Command, with arguments, that the service runs
  command string
}

// Exim mail transfer agent configuration
//
// Exim configuration. `params` holds the macros and main-section
// options parsed from the active config file, covering both the Debian
// `update-exim4.conf.conf` key/value form and the monolithic `exim.conf`
// main section (options before the first `begin` block). `localInterfaces`
// normalizes the local interface list, handling the Debian
// `dc_local_interfaces` `' ; '`-separated form and the Exim `local_interfaces`
// list, so policies can compare it directly. By default the per-distribution
// config location is used; select an alternate file with
// `exim("/path/to/exim.conf")`.
exim {
  init(path? string)
  // Path to the active Exim configuration file
  configPath() string
  // Parsed macros and main-section options
  params() map[string]string
  // Local interfaces parsed and normalized into a list
  localInterfaces() []string
}

// rsyslog daemon configuration
//
// Effective settings across the main file and included fragments.
// The `modules`, `inputs`, `actions`, and `rules` fields
// parse the configuration into structured form so audits can assert on
// individual statements without regex over raw text. Each entry
// carries `sourceFile` and `sourceLine` so findings can point back at the
// fragment that introduced the directive.
rsyslog.conf {
  init(path string)
  // Path for the main rsyslog file and search
  path() string
  // Files that make up this rsyslog service configuration
  files(path) []file
  // Raw contents of this rsyslog service configuration
  content(files) string
  // List of settings for this rsyslog service
  settings(content) []string
  // Legacy `$Directive value` settings parsed into key/value pairs
  //
  // The leading `$` is stripped from each key and the value is trimmed of
  // surrounding whitespace, so `params["FileCreateMode"] == "0640"` works
  // regardless of the spacing used in the file. When the same directive
  // appears more than once the last occurrence wins. The raw `settings`
  // list is retained unchanged.
  params(content) map[string]string
  // Loaded modules (modern module() and legacy $ModLoad)
  modules(files) []rsyslog.module
  // Configured inputs (modern input() and legacy $Input* directives)
  inputs(files) []rsyslog.input
  // Configured output actions (modern action() and legacy selector-with-target rules)
  actions(files) []rsyslog.action
  // Legacy selector-based routing rules (facility.severity → target)
  rules(files) []rsyslog.rule
}

// rsyslog loaded module
//
// Single module load: modern `module(load="imtcp" KeepAlive="on")`
// or legacy `$ModLoad imtcp`. Modern declarations carry their full parameter
// dict; legacy declarations carry only the module name (parameters is empty).
// The module name follows rsyslog conventions: `im*` for inputs, `om*` for
// outputs, `mm*` for message modifications, `pm*` for parsers.
private rsyslog.module @defaults("name sourceFile") {
  // Module name (e.g. imtcp, imuxsock, omfwd, mmnormalize)
  name string
  // Module-load parameters as a dict (empty for legacy $ModLoad)
  //
  // Modern `module(load="X" key1="v1" key2="v2")` declarations carry every
  // key/value pair other than `load` here. Boolean-like values are kept as
  // strings to preserve the source representation (`"on"` vs `true`).
  parameters dict
  // Absolute path of the file this directive was read from
  sourceFile string
  // 1-indexed line number within sourceFile
  sourceLine int
}

// rsyslog input source
//
// Configured input, the module instance that pulls log lines into
// rsyslog. Surfaces both legacy single-directive forms (e.g.
// `$InputTCPServerRun 514`) and modern RainerScript blocks
// (`input(type="imtcp" port="514" ruleset="…")`). Use it to audit which
// listeners are open, on what ports and addresses, and whether network
// inputs accept TLS.
private rsyslog.input @defaults("type port sourceFile") {
  // Input module type (e.g. imtcp, imudp, imuxsock, imfile)
  type string
  // Listen port for network inputs, 0 when not applicable
  port int
  // Listen address for network inputs, empty when not applicable
  address string
  // Ruleset this input feeds into, empty for the default ruleset
  ruleset string
  // TLS stream-driver mode reported by the input
  //
  // `"1"` indicates the input accepts TLS connections (paired with a
  // `$DefaultNetstreamDriver gtls` global or per-input `StreamDriverMode="1"`).
  // `"0"` or empty indicates plaintext.
  streamDriverMode string
  // All parameters as a dict, in source representation
  parameters dict
  // Absolute path of the file this directive was read from
  sourceFile string
  // 1-indexed line number within sourceFile
  sourceLine int
}

// rsyslog output action
//
// Destination where rsyslog ships matched log lines. Surfaces both modern
// `action(type="omfwd" target="…" …)` statements and the legacy
// selector-with-target form (e.g. `*.* @@host:514`). When this action came
// from a legacy selector, the `parameters` dict is empty and `target` /
// `protocol` / `tlsEnabled` are derived from the target token's syntax.
// Use it to confirm that remote forwarding uses TCP with TLS rather than
// plaintext UDP.
private rsyslog.action @defaults("type target sourceFile") {
  // Action module type (e.g. omfwd, omfile, omusrmsg, omhttp, omkafka)
  type string
  // Destination of the action
  //
  // For omfile a filesystem path; for omfwd a `host` or `host:port`; for
  // omusrmsg a comma-separated user list (or `*` for wall); for omhttp /
  // omkafka the relevant URL or broker list.
  target string
  // Transport protocol for network actions: `"tcp"`, `"udp"`, or empty
  protocol string
  // Whether TLS is configured for this action
  //
  // True when the modern form sets `StreamDriverMode="1"` (or equivalent
  // per-driver settings). False for legacy selector forms, which rely on
  // the `$DefaultNetstreamDriver` / `$ActionSendStreamDriverMode` globals.
  tlsEnabled bool
  // Template name applied to messages, empty when the default is used
  template string
  // Action-level queue configuration, empty when no queue is configured
  //
  // Carries the modern `queue.*` parameters as `{type, filename, size,
  // saveOnShutdown, ...}` (the exact key set depends on the queue type).
  queue dict
  // All parameters as a dict
  //
  // Modern actions carry every key/value pair other than `type` and
  // `target` here. Legacy selector-derived actions carry an empty dict.
  parameters dict
  // Absolute path of the file this directive was read from
  sourceFile string
  // 1-indexed line number within sourceFile
  sourceLine int
}

// rsyslog selector rule
//
// Legacy `<facility>.<severity> <target>` routing rule, the form that ships
// in every default rsyslog config. Modern `if … then … { action(…) }`
// conditionals are not surfaced here; their actions are available via
// `rsyslog.conf.actions` only.
//
// Selector grammar covered:
//   - Simple: `auth.info /var/log/auth.log`
//   - Facility list: `auth,authpriv.* /var/log/auth.log`
//   - Multi-selector: `*.info;mail.none;authpriv.none /var/log/messages`
//     (each selector becomes its own rule)
//   - Negation: `auth,authpriv.none` → `negate = true`
//   - Wildcards: `*.*` and `auth.*`
private rsyslog.rule @defaults("facilities severities target sourceFile") {
  // Facilities matched (e.g. `["auth", "authpriv"]`, or `["*"]`)
  facilities []string
  // Severities matched
  //
  // For example `["info"]`, `["*"]`, or `["none"]` (negation form).
  severities []string
  // Raw target token from the rule
  //
  // File path, `@host`, `@@host:port`, `:omusrmsg:user`, `~` (discard),
  // `|fifo`, etc.
  target string
  // Whether the severity is the negation marker (`.none`)
  negate bool
  // Resolved action for this rule
  //
  // Constructed from `target`: file-path → omfile, `@host` → omfwd/udp,
  // `@@host` → omfwd/tcp, `:omusrmsg:*` → omusrmsg, `~` → discard,
  // `|name` → ompipe. Legacy rules have no TLS information, so the action's
  // `tlsEnabled` is always false.
  action() rsyslog.action
  // Absolute path of the file this directive was read from
  sourceFile string
  // 1-indexed line number within sourceFile
  sourceLine int
}

// Shadow password suite (login.defs) configuration
//
// Password aging, UID/GID ranges, and login policy parameters parsed from
// /etc/login.defs. The params map exposes settings such as
// PASS_MAX_DAYS, PASS_MIN_DAYS, PASS_WARN_AGE, UMASK, and ENCRYPT_METHOD,
// which drive account and password-policy audits. Point at an alternate
// file with the `path` argument.
logindefs {
  init(path string)
  // Current configuration file for resource
  file() file
  // Content of the configuration file
  content(file) string
  // Parsed login.defs parameters as a name/value map (e.g. PASS_MAX_DAYS, UMASK, ENCRYPT_METHOD)
  params(content) map[string]string
}

// PAM resource limits configuration (limits.conf)
//
// Soft and hard caps on processes, open files, memory, and other per-user
// resources, parsed from /etc/security/limits.conf and every .conf file
// under /etc/security/limits.d. Iterate `entries` to audit for missing or
// overly permissive limits (e.g. unrestricted core dumps or nofile).
limits {
  // List of files that make up the limits configuration
  files() []file
  // Parsed limits entries
  entries(files) []limits.entry
}

// Resource limit entry
//
// Single line from a limits configuration file, giving one domain / type /
// item / value tuple (e.g. `* hard core 0`).
private limits.entry @defaults("domain item") {
  // File where this entry is defined
  file file
  // Line number in the file
  lineNumber int
  // Domain (username, @groupname, *, %)
  domain string
  // Limit type (soft, hard, -)
  type string
  // Resource item (core, nofile, nproc, etc.)
  item string
  // Limit value
  value string
}

// Sudo binary and runtime metadata
//
// Installed `sudo` binary: where it lives on disk, the version it reports
// under `sudo -V`, which plugins are loaded (policy, I/O, audit, approval),
// whether the build supports Python-based plugins, and the result of
// `visudo -c` against the sudoers configuration. For sudoers configuration
// parsing, use the `sudoers` resource directly, or access it via this
// resource's `sudoers` field.
sudo @defaults("version path") {
  init(path? string)
  // Path to the sudo binary
  //
  // Filesystem-resolved location of the `sudo` binary on the asset
  // (e.g., `/usr/bin/sudo`). Empty when sudo is not installed; check
  // `installed` rather than testing this field for emptiness.
  path() string
  // Whether sudo is installed and executable
  installed() bool
  // Version string reported by `sudo -V` (e.g., "1.9.5p3")
  version() string
  // All sudo plugins reported by `sudo -V`
  plugins() []sudo.plugin
  // Policy plugin (typically sudoers_policy). Null when none is loaded.
  policyPlugin(plugins) sudo.plugin
  // I/O plugins (e.g., sudoers_io for log_input / log_output)
  ioPlugins(plugins) []sudo.plugin
  // Audit plugins (sudo 1.9.3+)
  auditPlugins(plugins) []sudo.plugin
  // Approval plugins (sudo 1.9.1+)
  approvalPlugins(plugins) []sudo.plugin
  // Whether the build supports Python-based plugins
  pythonSupport() bool
  // Result of `visudo -c`. Null when sudoers files cannot be read (e.g., running unprivileged against a mode-0440 /etc/sudoers).
  validate() sudo.validation
  // Associated sudoers configuration
  sudoers() sudoers
}

// A sudo plugin reported by `sudo -V`
//
// One loaded sudo plugin, identified by name and type (policy, I/O, audit,
// or approval) with its version and, when reported, the path to the .so
// file backing it.
private sudo.plugin @defaults("name type version") {
  // Plugin name (e.g., "sudoers_policy", "sudoers_io")
  name string
  // Plugin version
  version string
  // Full path to the plugin .so file when reported
  path string
  // Plugin type: "policy", "io", "audit", or "approval"
  type string
}

// Result of validating sudoers configuration with `visudo -c`
//
// Syntax-check outcome for the sudoers files: `valid` is true when
// `visudo -c` exits cleanly, and `errors` lists every parse error
// otherwise.
private sudo.validation @defaults("valid") {
  // True if `visudo -c` exits 0 with no errors
  valid bool
  // Parse errors. Empty when valid is true.
  errors []sudo.validation.error
}

// A single sudoers parse error reported by `visudo -c`
//
// One syntax error found by `visudo -c`, locating the problem by file and
// line and giving the reported message.
private sudo.validation.error @defaults("file line") {
  // File where the error was found
  file string
  // Line number of the error
  line int
  // Error message text
  message string
}

// sudo authorization configuration
//
// User specifications, defaults, and aliases parsed across the sudoers
// files (/etc/sudoers plus /etc/sudoers.d). Use userSpecs to audit who may
// run which commands as which users, and defaults to check hardening
// settings such as env_reset, secure_path, requiretty, and NOPASSWD grants.
// Point at an alternate root file with the `path` argument.
sudoers @defaults("files") {
  init(path? string)
  // List of files that make up the sudoers configuration
  files() []file
  // Raw contents of all sudoers files
  content(files) string
  // User permission specifications
  userSpecs(files) []sudoers.userSpec
  // Default settings
  defaults(files) []sudoers.default
  // Alias definitions (User_Alias, Host_Alias, Cmnd_Alias, Runas_Alias)
  aliases(files) []sudoers.alias
}

// Sudoers user specification (permission entry)
//
// Single sudoers permission rule: which users, on which hosts, may run
// which commands, as which run-as users/groups, under which tags
// (e.g. NOPASSWD). The building block for auditing privilege grants.
private sudoers.userSpec @defaults("users hosts commands") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Users or user aliases this rule applies to
  users []string
  // Hosts or host aliases this rule applies to
  hosts []string
  // RunAs users (users the command can be run as)
  runasUsers []string
  // RunAs groups (groups the command can be run as)
  runasGroups []string
  // Commands or command aliases
  commands []string
  // Tags applied to the command (NOPASSWD, SETENV, etc.)
  tags []string
}

// Sudoers default setting
//
// One `Defaults` directive from the sudoers configuration, giving the
// parameter, its value and operation, the scope it applies at, and whether
// it is negated. Covers hardening flags such as env_reset and secure_path.
private sudoers.default @defaults("parameter") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Raw Defaults line
  raw string
  // Scope: global, user, host, command, or runas
  scope string
  // Target (user/host/command/runas this applies to, if not global)
  target string
  // Parameter name (e.g., "env_reset", "secure_path")
  parameter string
  // Value (if parameter takes a value)
  value string
  // Operation: "=", "+=", or "-="
  operation string
  // Whether parameter is negated (starts with !)
  negated bool
}

// Sudoers alias definition
//
// One alias declaration (User_Alias, Host_Alias, Cmnd_Alias, or
// Runas_Alias) and the members assigned to it, used to expand aliases
// referenced in user specifications.
private sudoers.alias @defaults("type name") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Type: user, host, cmnd, or runas
  type string
  // Alias name (e.g., "ADMINS", "WEBSERVERS")
  name string
  // Values assigned to this alias
  members []string
}

// Unix block devices (lsblk)
//
// Block devices reported by `lsblk`, each carrying its device name,
// filesystem type, label, UUID, and mount points. Iterate to audit disk
// layout, filesystem labels, and mount configuration.
lsblk {
  []lsblk.entry
}

// Unix block device
//
// Single block device reported by `lsblk`: its device `name`, filesystem
// type (`fstype`), `label`, UUID, and `mountpoints` list. Filter to audit
// disk layout and mount configuration, e.g.
// `lsblk.where(mountpoints.contains("/"))`.
lsblk.entry {
  // Device name
  name string
  // File system type
  fstype string
  // Label for the file system
  label string
  // UUID for the file system
  uuid string
  // Mount points for the device
  mountpoints  []string
}

// LUKS-encrypted volumes on the host
//
// Block devices that carry a LUKS header, exposing each volume's on-disk
// format version, cipher, key-derivation parameters, and every keyslot.
// Both LUKS1 and LUKS2 headers are reported through the same schema; the
// `version` field on each volume distinguishes them and version-specific
// fields (label, subsystem, and tokens for LUKS2; AF-splitter stripes for
// LUKS1) are populated only where they apply.
luks {
  // LUKS-formatted block devices on the host
  volumes() []luks.volume
}

// LUKS-encrypted block device
//
// Single LUKS-formatted block device: its header version, label,
// master-key size and offset, cipher, and keyslots. Select a volume by its
// `uuid` (e.g., `luks.volumes.where(uuid == "fd44f17a-...")`) or by the
// underlying block device's `name`.
luks.volume @defaults("name uuid version") {
  // Path of the underlying block device (e.g., /dev/sda3)
  name string
  // LUKS header UUID
  uuid string
  // LUKS header version (1 or 2)
  version int
  // Label assigned in the LUKS2 header (empty on LUKS1)
  label string
  // Subsystem string from the LUKS2 header (empty on LUKS1)
  subsystem string
  // Master-key size in bits
  masterKeyBits int
  // Payload offset in 512-byte sectors
  payloadOffset int
  // Underlying lsblk block device
  blockDevice() lsblk.entry
  // Cipher protecting the master key
  cipher() luks.volume.cipher
  // Keyslots defined in the header
  keyslots() []luks.keyslot
  // LUKS2 tokens attached to the header (empty on LUKS1)
  //
  // Each entry carries the token id, type (e.g., luks2-keyring,
  // systemd-tpm2, systemd-fido2, systemd-pkcs11), the keyslot indices
  // the token unlocks, and any token-type-specific metadata.
  tokens []dict
}

// LUKS cipher specification
//
// Symmetric cipher protecting a LUKS volume's master key. `name` is the
// cipher family, `mode` is the chaining mode, and `spec` is the combined
// cryptsetup string (e.g., `aes-xts-plain64`). On LUKS1, `hash` carries the
// AF-splitter hash; on LUKS2 it is the integrity hash when sector integrity
// is configured.
private luks.volume.cipher @defaults("spec keySize") {
  // Cipher family (e.g., aes, serpent, twofish)
  name string
  // Cipher mode (e.g., xts-plain64, cbc-essiv:sha256)
  mode string
  // Combined cipher spec as cryptsetup reports it
  spec string
  // Master-key size in bits
  keySize int
  // Hash used by the AF splitter (LUKS1) or sector integrity (LUKS2)
  hash string
}

// LUKS keyslot
//
// One keyslot in a LUKS header: its index, state, and the key-derivation
// parameters used to wrap the master key. Audit for weak KDFs, low
// iteration or memory costs, and unexpectedly large numbers of active slots
// (each active slot is a passphrase that can unlock the volume).
luks.keyslot @defaults("index state kdf") {
  // Slot index (0–7 on LUKS1, 0–31 on LUKS2)
  index int
  // Slot state
  //
  // ENABLED or DISABLED on LUKS1; active or inactive on LUKS2.
  state string
  // KDF used for this slot
  //
  // One of pbkdf2, argon2i, or argon2id.
  kdf string
  // PBKDF2 iteration count (pbkdf2 only)
  iterations int
  // argon2 time cost (argon2* only)
  time int
  // argon2 memory cost in KiB (argon2* only)
  memory int
  // argon2 parallelism (argon2* only)
  parallel int
  // Hash used by the KDF (pbkdf2 only; e.g., sha256, sha512)
  hash string
  // AF-splitter stripe count (LUKS1 only)
  stripes int
  // Key-material offset in 512-byte sectors
  keyMaterialOffset int
}

// AppArmor mandatory access control
//
// AppArmor status, the loaded profiles and their enforcement modes, and the
// processes currently under confinement. Use it to confirm AppArmor is
// active and that security-relevant profiles are in enforce rather than
// complain or unconfined mode.
apparmor @defaults("profiles") {
  // AppArmor status output version
  version() string
  // Loaded AppArmor profiles
  profiles() []apparmor.profile
  // Processes with AppArmor confinement
  processes() []apparmor.process
}

// AppArmor profile
//
// Loaded AppArmor profile and the mode it is running in: enforce (violations
// blocked), complain (violations logged only), or unconfined.
private apparmor.profile @defaults("name mode") {
  // Profile name
  name string
  // Profile mode: enforce, complain, or unconfined
  mode string
}

// AppArmor confined process
//
// Running process attached to an AppArmor profile, giving its executable
// path, PID, the applied profile, and the confinement status.
private apparmor.process @defaults("pid profile status") {
  // Process executable path
  executable string
  // Profile applied to this process
  profile string
  // Process ID
  pid int
  // Confinement status (e.g., enforce)
  status string
}

// SELinux mandatory access control
//
// SELinux enforcement mode, configured mode, active policy type, tunable
// booleans, and loaded policy modules. The runtime `mode` (from
// getenforce, /sys/fs/selinux/enforce, or config) may differ from
// `configMode`, which is what persists across reboot; compare the two to
// catch a system left permissive at runtime.
selinux @defaults("mode") {
  // Whether SELinux is installed on the system
  installed() bool
  // Current enforcement mode: enforcing, permissive, or disabled
  mode() string
  // Configured mode from /etc/selinux/config (persists across reboot)
  configMode() string
  // Active policy type (e.g., targeted, mls, minimum)
  policyType() string
  // Loaded SELinux booleans
  booleans() []selinux.boolean
  // Installed SELinux policy modules
  modules() []selinux.module
}

// SELinux boolean setting
//
// One tunable SELinux boolean and its current runtime value (from
// `getsebool -a` or /sys/fs/selinux/booleans), e.g.
// httpd_can_network_connect.
private selinux.boolean @defaults("name value") {
  // Boolean name (e.g., httpd_can_network_connect)
  name string
  // Current runtime value
  value bool
}

// SELinux policy module
//
// One installed SELinux policy module from `semodule -l`, with its status
// (enabled or disabled) and priority (higher priority overrides lower for
// the same module name).
private selinux.module @defaults("name status") {
  // Module name
  name string
  // Module status (e.g., enabled, disabled)
  status string
  // Module priority
  priority int
}

// Polkit authorization framework
//
// System-wide polkit (formerly PolicyKit) authorization state: the `actions`
// that privileged operations are registered under, the JavaScript `rules`
// that decide who may invoke them, the legacy local-authority grants in
// `localAuthorityRules`, and the `adminIdentities` the local authority
// treats as administrators. Polkit governs whether an unprivileged session
// may restart a unit, mount a disk, or install a package, so an over-broad
// grant is a local privilege escalation path. Read `version` before drawing
// conclusions: polkit 0.106 and later evaluate the JavaScript rules and
// ignore `.pkla` files, while earlier releases do the reverse.
polkit @defaults("installed version") {
  // Whether polkit is present on the system
  //
  // True when a polkit action directory or the pkexec binary is found. Use it
  // to guard polkit audits on images that ship no polkit at all, such as
  // minimal container bases.
  installed() bool
  // Polkit release reported by pkaction
  //
  // For example `0.105` on older distributions or `124` on current ones.
  // Requires command execution, so it is null on backends that expose only a
  // filesystem, such as an image scan.
  version() string
  // Actions registered in the polkit action directories
  actions() []polkit.action
  // JavaScript authorization rules, in the order polkit evaluates them
  rules() []polkit.rule
  // Grants from the legacy local-authority .pkla files
  localAuthorityRules() []polkit.localAuthorityRule
  // Identities the local authority treats as administrators
  //
  // AdminIdentities from /etc/polkit-1/localauthority.conf.d, for example
  // `unix-group:sudo` or `unix-user:root`. Honored only by polkit 0.105 and
  // earlier. On newer releases administrator selection moves into a rule that
  // calls polkit.addAdminRule, which `rules` reports through `adminRule`.
  adminIdentities() []string
}

// Polkit action
//
// Single privileged operation polkit can gate, parsed from a `.policy` file
// in the action directories. `id` is the reverse-DNS action name an
// application checks (for example `org.freedesktop.systemd1.manage-units`),
// and the three `allow` fields hold the implicit authorization that applies
// when no rule overrides it. `allowAny` is the weakest of the three because
// it covers subjects with no local seat, including remote sessions, so an
// action with `allowAny == "yes"` needs no authentication from anyone who
// can reach the D-Bus interface.
private polkit.action @defaults("id allowAny allowActive") {
  // Reverse-DNS action identifier (e.g., org.freedesktop.udisks2.filesystem-mount)
  id string
  // Human-readable action description
  description string
  // Message shown in the authentication prompt
  message string
  // Vendor named in the policy file
  vendor string
  // Vendor URL named in the policy file
  vendorUrl string
  // Icon name named in the policy file
  iconName string
  // Implicit authorization for subjects with no local seat, including remote sessions
  //
  // One of `no`, `yes`, `auth_self`, `auth_admin`, `auth_self_keep`, or
  // `auth_admin_keep`. The `_keep` variants cache a successful authentication
  // for a short period. Empty when the policy file omits the setting.
  allowAny string
  // Implicit authorization for local but inactive sessions
  //
  // Same value set as `allowAny`. An inactive session sits on a seat that is
  // not currently in the foreground, such as a switched-away virtual console.
  allowInactive string
  // Implicit authorization for the active local session
  //
  // Same value set as `allowAny`.
  allowActive string
  // Vendor annotations from the policy file, as key-value pairs
  //
  // For example `org.freedesktop.policykit.exec.path` names the binary a
  // pkexec action runs, and `org.freedesktop.policykit.imply` lists the
  // actions this one implies.
  annotations map[string]string
  // Policy file the action is declared in
  file file
}

// Polkit JavaScript authorization rule file
//
// Single `.rules` file from the polkit rule directories. Polkit evaluates
// these files in lexicographic order by filename and stops at the first rule
// returning a result other than NOT_HANDLED, so `order` decides which file
// wins: a file sorting ahead of the distribution defaults overrides them.
// `file` carries the path, mode, and ownership, which is what a check for a
// rule file writable by a non-root account reads. Rule bodies are JavaScript
// and are not evaluated here. `actionIds` and `results` report the
// identifiers and result values appearing in the body, so an audit can
// narrow down which files are worth reading.
private polkit.rule @defaults("file.path order adminRule") {
  // Position in the order polkit evaluates the rule files, starting at 0
  order int
  // Whether the file registers an administrator rule via polkit.addAdminRule
  //
  // An administrator rule chooses which identities count as administrators
  // when an action requires `auth_admin`, rather than granting an action
  // directly.
  adminRule bool
  // Action identifiers appearing as string literals in the rule body
  //
  // Collected lexically, so this includes prefixes used with `startsWith` or
  // a regular expression, and omits identifiers assembled at run time. A
  // starting point for locating the rules that touch a given action, not a
  // statement about what a rule ultimately returns.
  actionIds []string
  // Result values referenced in the rule body
  //
  // Any of `YES`, `NO`, `AUTH_SELF`, `AUTH_ADMIN`, `AUTH_SELF_KEEP`,
  // `AUTH_ADMIN_KEEP`, or `NOT_HANDLED`. A file mentioning `YES` grants some
  // action with no authentication on at least one code path.
  results []string
  // Rule file on disk
  file file
}

// Local-authority authorization grant (.pkla)
//
// Single section from a `.pkla` file, the ini-format grant mechanism used by
// polkit 0.105 and earlier. `identities` lists the users or groups the grant
// applies to and `actions` the action patterns it covers, while the three
// `result` fields carry the authorization it produces. Higher-numbered
// directories override lower-numbered ones, and a grant of
// `resultAny == "yes"` to a broad group such as `unix-group:users` hands that
// group the action with no authentication. Ignored outright by polkit 0.106
// and later, so read `polkit.version` alongside it.
private polkit.localAuthorityRule @defaults("name resultActive") {
  // Section name from the .pkla file header
  name string
  // Identities the grant applies to
  //
  // Each entry is a polkit identity string such as `unix-user:alice` or
  // `unix-group:wheel`.
  identities []string
  // Action patterns the grant covers
  //
  // Each entry is an action identifier, optionally ending in `*` to match a
  // prefix, for example `org.freedesktop.udisks2.*`.
  actions []string
  // Authorization for subjects with no local seat, including remote sessions
  //
  // One of `no`, `yes`, `auth_self`, `auth_admin`, `auth_self_keep`, or
  // `auth_admin_keep`. Empty when the section does not set it.
  resultAny string
  // Authorization for local but inactive sessions
  //
  // Same value set as `resultAny`. Empty when the section does not set it.
  resultInactive string
  // Authorization for the active local session
  //
  // Same value set as `resultAny`. Empty when the section does not set it.
  resultActive string
  // File the section is declared in
  file file
}

// AIDE file integrity database
//
// Configuration and database state of AIDE, the Advanced Intrusion Detection
// Environment. `params` holds the settings read from the configuration,
// `groups` the attribute group definitions, and `rules` the selection lines
// deciding which paths are watched and which attributes are compared.
// `database` points at the reference database the next check runs against, and
// its modification time is the signal worth asserting on: a reference database
// older than the last package transaction no longer describes the system, so a
// check against it cannot detect anything that changed in between. Watch for
// coverage removed by a negative rule, which silently drops a path from an
// otherwise healthy configuration.
aide @defaults("installed version") {
  // Whether AIDE is present on the system
  //
  // True when a configuration file or an AIDE binary is found. Use it to guard
  // integrity-monitoring audits on hosts that ship no AIDE at all.
  installed() bool
  // AIDE release reported by the aide binary
  //
  // Requires command execution, so it is null on backends that expose only a
  // filesystem, such as an image scan.
  version() string
  // Root configuration file the settings are read from
  configFile() file
  // Every configuration file that contributed, including resolved includes
  files() []file
  // Settings from the configuration, as key-value pairs
  //
  // Keyed by the option name as written, for example `database_in`,
  // `database_out`, `gzip_dbout`, and `report_url`. A `key = value` line whose
  // key is not a recognized AIDE option is reported in `groups` instead.
  params() map[string]string
  // Attribute group definitions, as key-value pairs
  //
  // Maps each group name to its expression exactly as written, for example
  // `NORMAL` to `R+sha512`. Referenced from a rule's `expression` and resolved
  // into its `attributes`.
  groups() map[string]string
  // Selection rules deciding which paths are checked
  rules() []aide.rule
  // Reference database the next check compares against
  //
  // Resolved from `database_in`, with the `file:` prefix stripped. Null when
  // the setting names no readable database, which is also the state before the
  // database is initialized for the first time.
  database() file
  // Database a fresh initialization writes, resolved from `database_out`
  newDatabase() file
}

// AIDE selection rule
//
// Single selection line from the AIDE configuration: the `path` it applies to,
// the `attributes` compared for matching entries, and the `selection` kind
// deciding whether the line adds or removes coverage. Macro references in the
// path are substituted, so `path` is the location AIDE actually acts on.
private aide.rule @defaults("path selection attributes") {
  // Path or path pattern the rule applies to
  path string
  // How the line affects coverage
  //
  // One of `recursive` for a plain line, `equals` for a line prefixed with `=`
  // matching the entry itself without descending into it, or `negative` for a
  // line prefixed with `!` removing the path from the check entirely.
  selection string
  // Attribute expression exactly as written on the line (e.g. `R+sha512`)
  expression string
  // Attributes compared for entries matched by this rule
  //
  // Group names defined in the configuration are resolved down to the
  // attributes they stand for, and a `-` term removes what it names. A token
  // AIDE defines internally rather than in the configuration, such as `R` or
  // `L`, is reported as written because its meaning depends on the AIDE
  // release.
  attributes []string
  // Line number of the rule in its source file
  lineNumber int
  // File the rule is declared in
  file file
}

// Kernel module configuration (modprobe.d)
//
// Install, remove, blacklist, options, alias, and softdep directives parsed
// from the modprobe configuration files. Use blacklists to verify that
// risky kernel modules are prevented from loading and options to audit
// module parameters. Point at an alternate config with the `path` argument.
modprobe @defaults("blacklists installs") {
  init(path? string)
  // List of files that make up the modprobe configuration
  files() []file
  // Install directives (custom commands for loading modules)
  installs(files) []modprobe.install
  // Remove directives (custom commands for unloading modules)
  removes(files) []modprobe.remove
  // Blacklisted modules
  blacklists(files) []modprobe.blacklist
  // Module options and parameters
  options(files) []modprobe.option
  // Module aliases
  aliases(files) []modprobe.alias
  // Soft dependencies
  softdeps(files) []modprobe.softdep
}

// Install directive for module loading
//
// One `install` directive from modprobe.d: the module it applies to and the
// command run in place of the default insmod. A blacklist technique when
// the command is `/bin/true` or `/bin/false`.
private modprobe.install @defaults("module command") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Module name
  module string
  // Command to execute instead of default insmod
  command string
}

// Remove directive for module unloading
//
// One `remove` directive from modprobe.d: the module it applies to and the
// command run in place of the default rmmod.
private modprobe.remove @defaults("module command") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Module name
  module string
  // Command to execute instead of default rmmod
  command string
}

// Kernel module blacklist directive
//
// A single `blacklist` line from a modprobe configuration file that
// stops a kernel module from being selected automatically. Auditing
// these confirms unwanted modules (for example `usb-storage`, `cramfs`,
// or unused filesystem and protocol drivers) are disabled per CIS
// hardening guidance. `module` is the blacklisted module name and
// `file`/`lineNumber` locate the declaration.
private modprobe.blacklist @defaults("module") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Module name that is blacklisted
  module string
}

// Kernel module options directive
//
// A single `options` line from a modprobe configuration file that sets
// load-time parameters for a kernel module. `parameters` is the raw
// argument string and `params` parses it into key/value pairs. Used to
// verify security-relevant module settings, for example that a driver
// is loaded with a hardened option.
private modprobe.option @defaults("module") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Module name the options apply to
  module string
  // Raw parameters string as written after the module name
  parameters string
  // Parsed parameters as key/value pairs (bare flags map to `true`)
  params() map[string]string
}

// Kernel module alias directive
//
// A single `alias` line from a modprobe configuration file mapping an
// alias name or wildcard pattern to a target module. The kernel
// resolves the alias to `module` when the pattern is requested. A
// common hardening technique points a module's alias at a no-op (for
// example aliasing an unused network protocol to `off`) to block
// on-demand loading.
private modprobe.alias @defaults("alias module") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Alias name (pattern or wildcard)
  alias string
  // Target module the alias resolves to
  module string
}

// Kernel module soft dependency directive
//
// A single `softdep` line from a modprobe configuration file declaring
// modules to load before (`pre`) and after (`post`) a given module.
// Soft dependencies are advisory, so a missing dependency does not
// block the module from loading.
private modprobe.softdep @defaults("module") {
  // File where this entry is defined
  file string
  // Line number in the file
  lineNumber int
  // Module the soft dependency is declared for
  module string
  // Modules to load before (pre: dependencies)
  pre []string
  // Modules to load after (post: dependencies)
  post []string
}

// Unix mount table
//
// Every mounted filesystem on the host as a list of `mount.point`
// entries, each with its backing device, mount path, filesystem type,
// options, and capacity. Filter it to surface findings such as
// temporary or removable-media mounts missing `nosuid`, `nodev`, or
// `noexec` options.
mount {
  []mount.point
}

// NFS service local state
//
// Local NFS service viewed from two angles: shares this host declares
// (`exports`) and NFS volumes this host has mounted (`mounts`).
// `exports` is parsed from `/etc/exports` using the platform-specific
// syntax for Linux, FreeBSD, macOS, and AIX; each row is one
// `(path, client)` pair so audits like
// `nfs.exports.where(noRootSquash)` work directly. `mounts` filters the
// system mount table for NFS file systems and parses NFS-specific
// options into fields (protocol `version`, `security` flavor,
// `hardMount`, `readOnly`).
nfs {
  // NFS exports declared on this host
  exports() []nfs.export
  // NFS mounts currently active on this host
  mounts() []nfs.mount
}

// NFS export entry for a single path and client
//
// One row of the local NFS export table: the directory being shared
// (`path`), the client specification it is shared with (`client`, a
// hostname, IP address, CIDR, wildcard, netgroup, or `*` meaning any
// client) and the effective export `options` as parsed from
// `/etc/exports`. `readOnly` is true when the share is exported
// read-only. `noRootSquash` is true when the share grants remote uid 0
// on the share, a classic NFS audit finding.
private nfs.export @defaults("path client readOnly noRootSquash") {
  // Exported directory path on the local host
  path string
  // Client specification (hostname, IP, CIDR, wildcard, netgroup, or `*`)
  client string
  // Export options as parsed from /etc/exports
  options []string
  // Whether the share is exported read-only
  readOnly bool
  // Whether the share grants remote uid 0 (`no_root_squash`, `maproot=root`, or `root=`)
  noRootSquash bool
}

// NFS client mount
//
// One NFS mount currently active on this host. `device` is the NFS
// source as the kernel sees it (`server:/remote/path`), split into
// `server` and `remotePath` for convenience. `mountpoint` is where the
// share is attached locally. `version` is the negotiated NFS protocol
// version (for example `3`, `4`, `4.1`, `4.2`); empty when the kernel
// did not report one. `security` is the authentication flavor, one of
// `sys`, `krb5`, `krb5i`, `krb5p`, or `none`; empty when unspecified.
// `hardMount` is true when the mount uses hard semantics (the `soft`
// option is not set). `readOnly` is true when the mount is `ro`.
// `options` is the full mount option list as reported by the system.
private nfs.mount @defaults("server remotePath mountpoint version") {
  // NFS source as the kernel sees it (server:/remote/path)
  device string
  // Local mount point path
  mountpoint string
  // NFS server hostname or IP
  server string
  // Remote path exported by the server
  remotePath string
  // NFS protocol version (for example `3`, `4`, `4.1`, `4.2`); empty when unknown
  version string
  // Security flavor: one of `sys`, `krb5`, `krb5i`, `krb5p`, or `none`; empty when unspecified
  security string
  // Whether the mount uses hard semantics (the `soft` option is not set)
  hardMount bool
  // Whether the mount is read-only
  readOnly bool
  // Full mount option list as reported by the system
  options []string
}

// Unix mount point
//
// A single mounted filesystem: the backing `device`, the `path` where
// it is attached, the `fstype`, mount `options`, whether it is
// currently `mounted`, and the total, used, and available bytes. Select
// a mount by path, for example `mount.point(path: "/var")`.
mount.point @defaults("device path fstype") {
  init(path string)
  // Block device or filesystem source backing the mount (e.g., /dev/sda1)
  device string
  // Mount point path where the filesystem is attached (e.g., /var)
  path string
  // File system type (e.g., ext4, xfs, tmpfs, nfs)
  fstype string
  // Mount options as a name-to-value map (flag-only options map to an empty value)
  options map[string]string
  // Whether the mount point is currently mounted
  mounted bool
  // Total size in bytes
  size() int
  // Used space in bytes
  used() int
  // Available space in bytes
  available() int
}

// Shadow password file (/etc/shadow)
//
// Per-user password aging, expiration, and lock state parsed from
// `/etc/shadow`, one `shadow.entry` per account. Audit password policy
// compliance and find accounts with no expiry, weak aging settings, or
// locked/disabled passwords.
shadow {
  []shadow.entry
}

// Shadowed password file entry
//
// A single line from `/etc/shadow`: the username, hashed password
// field, date of last change, minimum and maximum password age in days,
// warning period, inactivity period, and account expiry date. Used to
// audit password aging policy compliance and to detect accounts with no
// expiry or with locked passwords (a `!` or `*` in the password field).
shadow.entry {
  // Username from the /etc/shadow entry
  user string
  // Hashed password field (`*` or `!` marks a locked or disabled login; empty means no password)
  password string
  // Date of the last password change
  lastchanged time
  // Minimum password age in days before it may be changed again
  mindays int
  // Maximum password age in days before a change is required
  maxdays int
  // Number of days before expiry the user is warned to change the password
  warndays int
  // Days after password expiry before the account is disabled
  inactivedays int
  // Account expiration date
  expirydates string
  // Reserved field
  reserved string
}

// Yum/DNF package manager
//
// Configuration of the yum/dnf package manager on RedHat-family
// systems. `vars` exposes the variables defined across `/etc/yum.conf`
// and the `.repo` files (for example `$releasever` and `$basearch`) and
// `repos` lists every configured repository as `yum.repo` entries.
yum {
  // Variables defined in Yum configuration files (/etc/yum.conf and all .repo files in the /etc/yum.repos.d/)
  vars() map[string]string
  // List of all configured Yum repositories
  repos() []yum.repo
}

// Yum repository
//
// A single configured yum/dnf repository as reported by
// `yum -v repolist all`: its `id`, human-readable `name`, `status`,
// `baseurl` list, expiry indicator, backing configuration `file`,
// `revision`, package count, size, mirror list, and whether it is
// currently `enabled`. Select a repository by ID, for example
// `yum.repo(id: "baseos")`.
yum.repo {
  init(id string)
  // Repository ID
  id string
  // Human-readable repository name
  name string
  // Repository status (e.g., enabled or disabled)
  status string
  // URL where the repodata directory of a repository is located
  baseurl []string
  // Indicator when the repository metadata will expire
  expire string
  // Repository configuration file path
  file file
  // Repository revision
  revision string
  // Number of packages available from the repository
  pkgs string
  // Total size of the repository
  size string
  // Mirrors for this repository
  mirrors string
  // Whether the repository is used as a package source (status is enabled)
  enabled() bool
}

// Yum/DNF global configuration
//
// System-wide package manager configuration: the `[main]` section of
// `/etc/yum.conf`, or `/etc/dnf/dnf.conf` on dnf-based systems. Use
// `gpgcheck` and `localPkgGpgcheck` to assert that package signature
// verification is enforced for every repository and for locally
// installed packages, a core CIS supply-chain control; `repoGpgcheck`
// extends that to repository metadata. The bool accessors reflect the
// explicit directive and are `false` when the directive is absent.
// `params` exposes every `[main]` directive as a raw string map for
// settings without a dedicated accessor. Select an alternate file with
// `yum.config(path: "...")`.
yum.config {
  init(path string)
  // File backing the [main] configuration section
  file() file
  // Raw contents of the configuration file
  content(file) string
  // Every [main] section directive as key/value strings
  params(content) map[string]string
  // Whether package signature checking is enforced globally (gpgcheck)
  gpgcheck(params) bool
  // Whether signature checking is enforced for local packages (localpkg_gpgcheck)
  localPkgGpgcheck(params) bool
  // Whether repository metadata signature checking is enforced (repo_gpgcheck)
  repoGpgcheck(params) bool
  // Whether dependencies are removed along with packages (clean_requirements_on_remove)
  cleanRequirementsOnRemove(params) bool
}

// Advanced Package Tool (APT) configuration
//
// Debian/Ubuntu package management configuration. `repos` enumerates
// every configured APT repository across `/etc/apt/sources.list` and
// the `/etc/apt/sources.list.d/` directory, parsing both the classic
// one-line format and the deb822 `.sources` format. Audit repository
// trust from there: each `apt.repo` reports whether it is marked
// `trusted` (signature checks bypassed) and the `signedBy` keyring that
// pins which key may sign it.
apt {
  // All configured APT repositories
  repos() []apt.repo
}

// APT software repository
//
// A single configured APT repository parsed from a sources list: its
// package `type` (`deb` for binary or `deb-src` for source), the `url`
// it fetches from, the `distribution` (suite) and `components` it pulls,
// and the `file` that declares it. The security-relevant fields are
// `trusted`, true when the entry carries `[trusted=yes]`, which disables
// signature verification, and `signedBy`, the keyring path pinning which
// key may sign the repository. `enabled` is false for entries commented
// out in a one-line sources file or marked `Enabled: no` in a deb822
// file.
private apt.repo @defaults("type url distribution") {
  // Package type: `deb` (binary) or `deb-src` (source)
  type string
  // Repository URI packages are fetched from
  url string
  // Distribution / suite (e.g., `bookworm`, `noble-security`)
  distribution string
  // Components enabled for this repository (e.g., `main`, `contrib`)
  components []string
  // Whether signature verification is bypassed (`[trusted=yes]`)
  trusted bool
  // Keyring path pinning the signing key (`signed-by`), empty when unset
  signedBy string
  // Whether the repository entry is active
  enabled bool
  // Source list file that declares this repository
  file file
}

// Windows registry key
//
// A Windows registry key selected by `path`, exposing its value entries
// (`items`), child key names (`children`), and whether the key
// `exists`. Optionally read a specific user's per-user registry (HKCU)
// by supplying `userSid`, falling back to their `NTUSER.DAT` profile
// hive (`ntuserDat`) when that hive is not currently loaded. Select a
// key with `registrykey(path: "...")`.
registrykey @defaults("path") {
  init(path string, userSid? string, ntuserDat? string)
  // Registry key path
  path string
  // SID of the user whose registry hive to read
  //
  // Optional. When set, `path` is interpreted relative to that user's
  // per-user registry (HKCU): the loaded `HKEY_USERS\<sid>` hive when the
  // user is logged in, otherwise the profile's `NTUSER.DAT` (see `ntuserDat`)
  // loaded on demand. Leave empty to treat `path` as an absolute registry
  // path.
  userSid string
  // Path to the user's NTUSER.DAT hive file
  //
  // Optional. Used with `userSid` to read a user's registry when their hive
  // is not currently loaded, for example a SYSTEM scan running with no
  // interactive session. Typically populated from `user.ntuserDat`.
  ntuserDat string
  // Whether the registry key exists
  exists() bool
  // Properties of the registry key as a name-to-value map
  //
  // Deprecated in favor of `items`, which returns structured property
  // entries.
  properties() @maturity("deprecated") map[string]string
  // Value entries in this registry key
  items() []registrykey.property
  // Names of the immediate child keys under this key
  children() []string
}

// Windows registry key property
//
// A single named value within a registry key: the key `path`, value
// `name`, whether it `exists`, the registry `type` (for example
// `REG_SZ`, `REG_DWORD`, `REG_BINARY`, or `REG_MULTI_SZ`), and the
// parsed `data`. Select a specific value by path and name, or iterate
// from `registrykey.items`.
registrykey.property @defaults("path name") {
  init(path string, name string, userSid? string, ntuserDat? string)
  // Registry key path
  path string
  // Registry value name
  name string
  // SID of the user whose registry hive to read
  //
  // Optional. Forwarded to the underlying `registrykey` so `path` resolves
  // against that user's per-user registry (HKCU). See `registrykey.userSid`.
  userSid string
  // Path to the user's NTUSER.DAT hive file
  //
  // Optional. Forwarded to the underlying `registrykey`. See
  // `registrykey.ntuserDat`.
  ntuserDat string
  // Whether the property exists
  exists() bool
  // Registry property value as a string
  //
  // Deprecated in favor of `data`, the parsed structured value.
  value() @maturity("deprecated") string
  // Registry value type (e.g., REG_SZ, REG_DWORD, REG_BINARY)
  type() string
  // Parsed registry value data
  data() dict
}

// OCI/Docker container image reference
//
// A container image reference broken into its parts: the raw
// `reference`, the fully-qualified `name`, the `identifier` (the tag or
// digest portion), the `identifierType` (`tag` or `digest`), and the
// source `repository`. Records exactly which image a running container
// or scan target was built from.
container.image @defaults("name") {
  // Original image reference as provided
  reference string
  // Fully-qualified reference name
  name string
  // Type-specific portion of the image reference (the tag or digest value)
  identifier string
  // Identifier type: `tag` or `digest`
  identifierType string
  // Repository the container image is pulled from
  repository() container.repository
}

// Container registry repository
//
// The source repository of a container image, split into the `registry`
// host, the URL `scheme`, the repository `name`, and the `fullName`
// combining host and path. Identifies where an image is pulled from.
container.repository {
  // Container registry repository name (path portion, without the registry host)
  name string
  // URL scheme (e.g., https)
  scheme string
  // Full repository name including the registry host
  fullName string
  // Container registry host
  registry string
}

// Kubernetes kubelet on this node
//
// The kubelet agent running on this node, with its security-relevant
// settings resolved from the config file merged with the live process's
// CLI flags (CLI flags take precedence). The fields map to CIS
// Kubernetes benchmark controls: anonymous authentication, authorization
// mode, client CA, the read-only port, streaming timeouts, certificate
// rotation, and the TLS cipher/version floor. `configuration` returns
// the full merged configuration as a dict.
kubelet {
  // Kubelet config file
  configFile file
  // Kubelet process
  process process
  // Combination of config file parameters and CLI parameters
  configuration() dict
  // Kubelet version reported by the running binary (for example "v1.34.0")
  version() string
  // Whether the kubelet server accepts anonymous, unauthenticated requests
  anonymousAuthEnabled() bool
  // Authorization mode the kubelet enforces on incoming requests
  //
  // Either "Webhook" (delegate authorization to the API server) or
  // "AlwaysAllow" (no authorization, every authenticated request is granted).
  authorizationMode() string
  // Path to the CA bundle used to verify client certificates on the kubelet server
  clientCAFile() string
  // Read-only, unauthenticated port that serves the kubelet API; 0 disables it
  readOnlyPort() int
  // Idle timeout after which the kubelet closes streaming connections (for example "4h0m0s"); "0" disables it
  streamingConnectionIdleTimeout() string
  // Whether the kubelet refuses to start when kernel tunables differ from its expected values
  protectKernelDefaults() bool
  // Whether the kubelet manages the iptables utility chains on the node
  makeIPTablesUtilChains() bool
  // Maximum number of event creations per second the kubelet allows; 0 means unlimited
  eventRecordQPS() int
  // Path to the x509 certificate the kubelet uses to serve HTTPS
  tlsCertFile() string
  // Path to the private key matching the kubelet serving certificate
  tlsPrivateKeyFile() string
  // Whether the kubelet automatically rotates its client certificates as they near expiry
  rotateCertificates() bool
  // Whether the kubelet requests a serving certificate from the certificates API instead of self-signing
  serverTLSBootstrap() bool
  // TLS cipher suites the kubelet server accepts
  tlsCipherSuites() []string
  // Minimum TLS version the kubelet server accepts (for example "VersionTLS12")
  tlsMinVersion() string
}

// Python package inventory
//
// Installed Python packages discovered on the host. `packages` lists
// every package found and `toplevel` narrows that to packages that were
// explicitly installed rather than pulled in as dependencies. Pass
// `path` to scan a specific site-packages location instead of the
// default locations. Used for software inventory and vulnerability
// correlation.
python {
  init(path? string)
  // Path to a specific site-packages location to exclusively scan (empty means scan default locations)
  path string

  // List of all discovered packages
  packages() []python.package

  // List of all packages that were specifically installed (i.e., not auto-installed as a dependency)
  toplevel() []python.package
}

// Python package information
//
// A single installed Python package: name, version, license, author,
// summary, required Python version, project URLs, package URL (`purl`),
// CPEs, and the full transitive `dependencies` list. Used to inventory
// Python dependencies and correlate them with vulnerability data.
python.package @defaults("name version") {
  init(path? string)
  // ID is the python.package unique identifier
  id string
  // Name of the package
  name string
  // File containing the package metadata
  file file
  // Version of the package
  version string
  // License of the package
  license string
  // Author of the package
  author string
  // Author email of the package
  authorEmail string
  // Short package description
  summary string
  // Required Python version (e.g., ">=3.6")
  requiresPython string
  // Project URLs by label (e.g., Homepage, Repository, Documentation)
  projectUrls map[string]string
  // Package URL
  purl string
  // Common Platform Enumeration (CPE) for the package
  cpes []core.cpe
  // List of packages depended on
  dependencies() []python.package
}

// npm package inventory
//
// npm packages discovered under a project: the `root` package, the
// `directDependencies`, and the full transitive tree (iterated from the
// list itself). `scripts` exposes the `package.json` scripts (useful for
// spotting risky lifecycle hooks) and `files` records which manifests
// and lockfiles contributed the inventory. Pass `paths` to search
// specific locations.
npm.packages {
  []npm.package

  init(path? string)

  // Path to search for packages
  //
  // Deprecated in favor of `paths`, which accepts a list of search paths.
  path @maturity("deprecated") string

  // Optional: list of paths searched for packages
  paths() []string

  // Root Package (may not exist)
  root() npm.package

  // List of direct dependencies
  directDependencies() []npm.package

  // Files used to determine the packages
  files() []pkgFileInfo

  // Scripts defined in package.json
  scripts() map[string]string
}

// npm package dependency
//
// A single npm package: its unique `id`, `name`, `version`, `purl`,
// CPEs, and the files that contributed it. Iterated from `npm.packages`
// for the full dependency tree or from `directDependencies` for
// top-level dependencies only.
npm.package @defaults("name version purl") {
  // ID is the npm.package unique identifier
  id string
  // Name of the package
  name() string
  // Version of the package
  version() string
  // Package URL
  purl() string
  // Common Platform Enumeration (CPE) for the package
  cpes() []core.cpe
  // Package files
  files() []pkgFileInfo
  // Package description from package.json
  description string
  // Package author
  //
  // From package.json `author`. Accepts the SPDX-style string form
  // ("Name <email>") and the object form ({"name":..., "email":...,
  // "url":...}); only the name portion is surfaced.
  author string
  // Package license
  //
  // SPDX expression from package.json `license`. The deprecated
  // `licenses` array is not yet supported, so the field is empty in that
  // case.
  license string
}

// Go module inventory
//
// Go modules discovered under a path: the `root` module, the
// `directDependencies`, and the full transitive tree (iterated from the
// list itself). Parsed from module metadata such as `go.mod`. Pass
// `path` to point at a specific project.
go.packages {
  []go.package

  init(path? string)

  // Path to search for Go module files
  path string

  // Root module (may not exist)
  root() go.package

  // List of direct dependencies
  directDependencies() []go.package

  // Files used to determine the packages
  files() []pkgFileInfo
}

// Go module dependency
//
// A single Go module: its unique `id`, module path as `name`,
// `version`, `purl`, CPEs, and the files that contributed it. Iterated
// from `go.packages` for the full tree or from `directDependencies` for
// direct dependencies only.
go.package @defaults("name version purl") {
  // ID is the go.package unique identifier
  id string
  // Name of the module (module path)
  name() string
  // Version of the module
  version() string
  // Package URL
  purl() string
  // Common Platform Enumeration (CPE) for the package
  cpes() []core.cpe
  // Package files
  files() []pkgFileInfo
}

// Java package inventory (Maven, Gradle, JAR archives)
//
// Java artifacts discovered from Maven, Gradle, or JAR sources: the
// `root` project, the `directDependencies`, and the full transitive
// tree (iterated from the list itself). Point `path` at a directory, a
// JAR, a `pom.xml`, or a `gradle.lockfile`.
java.packages {
  []java.package

  init(path? string)

  // Path to search for Java packages (directory, JAR, pom.xml, or gradle.lockfile)
  path string

  // Root project (may not exist)
  root() java.package

  // List of direct dependencies
  directDependencies() []java.package

  // Files used to determine the packages
  files() []pkgFileInfo
}

// Java package (Maven, Gradle, or JAR archive)
//
// A single Java artifact: its unique `id`, `name` in
// `groupId:artifactId` form, `version`, `purl`, CPEs, and the files that
// contributed it. Iterated from `java.packages` for the full tree or
// from `directDependencies` for direct dependencies only.
java.package @defaults("name version purl") {
  // ID is the java.package unique identifier
  id string
  // Name of the package (groupId:artifactId)
  name() string
  // Version of the package
  version() string
  // Package URL
  purl() string
  // Common Platform Enumeration (CPE) for the package
  cpes() []core.cpe
  // Package files
  files() []pkgFileInfo
}

// Rust/Cargo crate inventory
//
// Rust crates discovered from Cargo sources: the `root` crate, the
// `directDependencies`, and the full transitive tree (iterated from the
// list itself). Parsed from Cargo manifests and lockfiles. Pass `path`
// to point at a specific project.
rust.packages {
  []rust.package

  init(path? string)

  // Path to search for Cargo files
  path string

  // Root crate (may not exist)
  root() rust.package

  // List of direct dependencies
  directDependencies() []rust.package

  // Files used to determine the packages
  files() []pkgFileInfo
}

// Rust/Cargo crate dependency
//
// Single Rust crate in the software inventory, exposing its unique `id`,
// crate `name`, `version`, `purl` identifier, CPE identifiers for
// vulnerability matching, and the manifest or lock files that declared it.
rust.package @defaults("name version purl") {
  // Unique identifier for the crate within the inventory
  id string
  // Name of the crate
  name() string
  // Resolved crate version
  version() string
  // Package URL (purl), a standardized identifier for the crate
  purl() string
  // Common Platform Enumeration (CPE) identifiers for matching against vulnerability advisories
  cpes() []core.cpe
  // Manifest and lock files that contributed this crate to the inventory
  files() []pkgFileInfo
}

// .NET / NuGet package inventory
//
// NuGet packages resolved from a .NET project, covering the root project,
// its direct dependencies, and the full transitive dependency tree. Set
// `path` to point at a specific project or solution directory.
dotnet.packages {
  []dotnet.package

  init(path? string)

  // Path to search for .NET package files
  path string

  // Root project (may not exist)
  root() dotnet.package

  // List of direct dependencies
  directDependencies() []dotnet.package

  // Files used to determine the packages
  files() []pkgFileInfo
}

// .NET / NuGet package dependency
//
// Single .NET package in the software inventory, exposing its unique `id`,
// `name`, `version`, `purl` identifier, CPE identifiers for vulnerability
// matching, and the manifest or lock files that declared it.
dotnet.package @defaults("name version purl") {
  // Unique identifier for the package within the inventory
  id string
  // Name of the package
  name() string
  // Resolved package version
  version() string
  // Package URL (purl), a standardized identifier for the package
  purl() string
  // Common Platform Enumeration (CPE) identifiers for matching against vulnerability advisories
  cpes() []core.cpe
  // Manifest and lock files that contributed this package to the inventory
  files() []pkgFileInfo
}

// PHP / Composer package inventory
//
// Composer packages resolved from a PHP project, covering the root project,
// its direct dependencies, and the full transitive dependency tree. Set
// `path` to point at the directory holding the Composer files.
php.packages {
  []php.package

  init(path? string)

  // Path to search for Composer files
  path string

  // Root project (may not exist)
  root() php.package

  // List of direct dependencies
  directDependencies() []php.package

  // Files used to determine the packages
  files() []pkgFileInfo
}

// PHP / Composer package dependency
//
// Single PHP package in the software inventory, exposing its unique `id`,
// `name` in `vendor/package` form, `version`, `purl` identifier, CPE
// identifiers for vulnerability matching, and the Composer files that
// declared it.
php.package @defaults("name version purl") {
  // Unique identifier for the package within the inventory
  id string
  // Name of the package in vendor/package form
  name() string
  // Resolved package version
  version() string
  // Package URL (purl), a standardized identifier for the package
  purl() string
  // Package license
  //
  // SPDX expression from the `license` field of composer.lock or
  // installed.json. Composer records the field as a list, and a list means the
  // package is offered under any one of them and the consumer chooses, so
  // several entries render as an SPDX `OR` expression such as
  // `(LGPL-2.1-only OR GPL-3.0-or-later)`. A single license passes through as
  // written. Empty when the manifest declares none.
  license() string
  // Description of the package as its manifest states it
  description() string
  // Common Platform Enumeration (CPE) identifiers for matching against vulnerability advisories
  cpes() []core.cpe
  // Composer files that contributed this package to the inventory
  files() []pkgFileInfo
}

// GitHub Actions workflow dependencies
//
// Action references (owner/repo@version) pinned across the workflow YAML
// files in a repository. Useful for auditing which third-party actions and
// versions a CI pipeline trusts. Set `path` to a workflows directory or a
// specific .yml file.
githubactions.packages {
  []githubactions.package

  init(path? string)

  // Path to search for workflow files (directory or specific .yml file)
  path string

  // Files used to determine the packages
  files() []pkgFileInfo
}

// GitHub Actions action reference
//
// Single GitHub Actions action referenced in a workflow, exposing its
// unique `id`, `name` in `owner/repo` or `owner/repo/path` form, the
// pinned `version` (a tag, branch, or commit SHA), `purl` identifier, and
// the workflow files that reference it. Pinning to a commit SHA rather than
// a mutable tag is a common supply-chain hardening check.
githubactions.package @defaults("name version purl") {
  // Unique identifier for the action within the inventory
  id string
  // Name of the action in owner/repo or owner/repo/path form
  name() string
  // Pinned version: a tag, branch, or commit SHA
  version() string
  // Package URL (purl), a standardized identifier for the action
  purl() string
  // Workflow files that reference this action
  files() []pkgFileInfo
}

// Swift package inventory (SPM and CocoaPods)
//
// Swift packages referenced by a project through Swift Package Manager or
// CocoaPods, each with its resolved version. Set `path` to point at the
// directory holding the Swift package files.
swift.packages {
  []swift.package

  init(path? string)

  // Path to search for Swift package files
  path string

  // Files used to determine the packages
  files() []pkgFileInfo
}

// Swift package dependency
//
// Single Swift package in the software inventory, exposing its unique `id`,
// `name`, `version`, `purl` identifier, CPE identifiers for vulnerability
// matching, and the package files that declared it.
swift.package @defaults("name version purl") {
  // Unique identifier for the package within the inventory
  id string
  // Name of the package
  name() string
  // Resolved package version
  version() string
  // Package URL (purl), a standardized identifier for the package
  purl() string
  // Common Platform Enumeration (CPE) identifiers for matching against vulnerability advisories
  cpes() []core.cpe
  // Package files that contributed this package to the inventory
  files() []pkgFileInfo
}

