flush ruleset
table inet filter {
  set blocklist { type ipv4_addr; flags interval; elements = { 192.0.2.0/24, 198.51.100.7 } }
  set sshports { type inet_service; elements = { 22, 2222 } }
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    iifname "lo" counter accept
    iif != lo ip saddr 127.0.0.0/8 counter drop
    iif != lo ip6 saddr ::1 drop
    ip saddr 10.0.0.1 accept
    ip6 saddr 2001:0db8:0000::/48 accept
    ip6 saddr ::ffff:127.0.0.1 drop
    ct state established,related accept
    ct state invalid drop
    ct state vmap { established : accept, related : accept, invalid : drop }
    ct state != new drop
    tcp dport 22 accept
    tcp dport { 80, 443 } accept
    udp dport 1024-65535 accept
    tcp dport < 1024 drop
    tcp dport >= 8000 drop
    tcp dport @sshports ip saddr != @blocklist accept
    ip saddr { 10.0.0.0/8, 172.16.0.1-172.16.0.9 } accept
    meta l4proto icmp accept
    meta l4proto ipv6-icmp accept
    meta l4proto { tcp, udp } th dport 53 accept
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
    icmpv6 type echo-request accept
    ip daddr != 10.0.0.0/8 tcp sport 1-1023 reject with tcp reset
    reject
    jump mychain
    goto mychain
    oifname { "eth0", "wg*" } return
    queue num 3
    tcp dport 25 counter name "smtp" continue
    ip saddr 10.0.0.0/8 ip saddr 10.1.0.0/16 accept
    meta l4proto 6 accept
    iifname . ip saddr { "lo" . 127.0.0.1 } accept
    log prefix "x"
  }
  counter smtp {}
  chain mychain { }
}
