dockerd --host=unix:///var/run/docker.sock --host=tcp://0.0.0.0:2376 --tlsverify --tlscacert /certs/server/ca.pem --tlscert /certs/server/cert.pem --tlskey /certs/server/key.pem --icc=false --live-restore --log-opt max-size=10m --log-opt max-file=3 --default-ulimit nofile=1024:2048 --insecure-registry myreg.example:5000 --userland-proxy=false
