        "/tmp"
      ],
      "env": {
        "FS_TOKEN": "<redacted>"
      },
      "transport": "stdio",
      "type": null,
      "cwd": null,
      "timeout": null,
      "keep_alive": null,
      "description": null,
      "icon": null,
      "authentication": null,
      "enabled": true
    },
    "remote": {
      "url": "https://mcp.example.com/mcp",
      "transport": "http",
