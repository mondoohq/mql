 /dev/pts$ d RecreatedDir
!/dev/pts/[0-9]{1,2}$ c

# reading Xattrs for some /dev nodes will cause unwanted actions, including
# - on-the-fly creation of other device nodes
# - reboots (!)
# - loading of kernel modules
 /dev/(btrfs-control|loop-control|net/tun|ppp|tty[[:digit:]]+|watchdog0?|vhost-net)$ c InodeData-i-X

# this matches the entire contents of /dev
 /dev/ 0 InodeData-i
