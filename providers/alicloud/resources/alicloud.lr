  networkType string
  // VPC that the CLB instance belongs to
  vpc() alicloud.vpc.network
  // vSwitch that the CLB instance belongs to
  vswitch() alicloud.vpc.vswitch
  // Metering method of internet data transfer
  //
  // One of paybybandwidth (pay-by-bandwidth) or paybytraffic
  // (pay-by-data-transfer).
  internetChargeType string
  // Metering method of the CLB instance
  //
  // One of PayBySpec or PayByCLCU. Takes effect only for pay-as-you-go
  // instances.
  instanceChargeType string
  // Specification of the CLB instance, for example slb.s1.small
  //
  // Pay-as-you-go instances are not subject to specifications and report
  // slb.lcu.elastic by default.
  loadBalancerSpec string
  // Billing method of the CLB instance
  //
  // One of PayOnDemand (pay-as-you-go) or PrePay (subscription).
  payType string
  // Maximum bandwidth of a pay-by-bandwidth internet-facing instance, in Mbit/s
  bandwidth int
  // Time when the CLB instance was created
  createTime time
  // Whether deletion protection is enabled
  //
  // One of on or off.
  deleteProtection string
  // Whether the configuration read-only (modification protection) mode is enabled
  //
  // One of NonProtection (disabled) or ConsoleProtection (enabled, instance
  // configuration cannot be changed in the console).
  modificationProtectionStatus string
  // Reason recorded when the configuration read-only mode is enabled
  modificationProtectionReason string
  // ID of the resource group that the CLB instance belongs to
  resourceGroupId string
  // Resource group that contains the load balancer
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags attached to the CLB instance, as key-value pairs
  tags map[string]string
  // Listeners configured on the CLB instance
  listeners() []alicloud.slb.listener
  // Backend server summaries
  //
  // Deprecated in favor of backends. Each entry carries the serverId, serverIp,
  // weight, type (ecs or eni), and an optional description.
  backendServers() @maturity("deprecated") @replaced_by("alicloud.slb.loadBalancer.backends") []dict
  // Backend servers attached directly to the CLB instance
  //
  // What the load balancer forwards to. An internet-facing CLB makes every one
  // of these reachable from the public internet on the listener's port,
  // whatever the backend's own security groups say about its address.
  backends() []alicloud.slb.backendServer
  // vServer groups defined on the CLB instance
  vServerGroups() []alicloud.slb.vServerGroup
  // Whether the load balancer is reachable from the internet
  //
  // True when addressType is internet, meaning the CLB has a public IP address
  // and forwards requests from the public internet to its backend servers.
  internetFacing() bool
}

// Server Load Balancer (CLB) listener
//
// A single listener configured on a CLB instance, keyed by the composite of
// loadBalancerId, protocol, and listenerPort. Exposes the protocol and port
// mapping, the scheduling algorithm, the access-control (ACL) settings, and,
// for HTTPS listeners, the TLS cipher policy and the server and CA
// certificates. Protocol-specific health-check and forwarding settings are
// available through config.
alicloud.slb.listener {
  // ID of the CLB instance that the listener belongs to
  loadBalancerId string
  // CLB instance that the listener belongs to
  loadBalancer() alicloud.slb.loadBalancer
  // Protocol used by the listener
  //
  // One of http, https, tcp, or udp.
  protocol string
  // Frontend port on which the listener accepts requests
  listenerPort int
  // Backend server port that the listener forwards requests to
  backendServerPort int
  // Status of the listener
  //
  // One of running or stopped.
  status string
  // Maximum bandwidth of the listener, in Mbit/s (-1 indicates unlimited)
  bandwidth int
  // Scheduling algorithm used to distribute requests
  //
  // One of wrr (weighted round-robin), rr (round-robin), sch (source-IP
  // consistent hashing), tch (four-tuple consistent hashing), or qch (QUIC-ID
  // consistent hashing).
  scheduler string
  // Description of the listener
  description string
  // Whether access control is enabled for the listener
  //
  // One of on or off.
  aclStatus string
  // Type of access control applied when aclStatus is on
  //
  // One of white (only requests from allowlisted addresses are forwarded) or
  // black (requests from blocklisted addresses are denied).
  aclType string
  // ID of the access control list bound to the listener
  aclId string
  // IDs of the access control lists bound to the listener
  aclIds []string
  // Access control lists bound to the listener
  //
  // Empty when the listener names no list, and when the named lists could not
  // be read. Traverse to allowsAllAddresses to tell an allowlist that
  // restricts anything from one that admits every address.
  acls() []alicloud.slb.acl
  // ID of the vServer group associated with the listener
  vServerGroupId string
  // vServer group the listener forwards to
  //
  // Null when the listener forwards to the load balancer's default backend
  // servers rather than a group.
  vServerGroup() alicloud.slb.vServerGroup
  // TLS security policy applied to an HTTPS listener
  //
  // One of tls_cipher_policy_1_0, tls_cipher_policy_1_1,
  // tls_cipher_policy_1_2, tls_cipher_policy_1_2_strict, or
  // tls_cipher_policy_1_2_strict_with_1_3, each enabling a different set of
  // TLS versions and cipher suites. Null for non-HTTPS listeners.
  tlsCipherPolicy string
  // ID of the server certificate bound to an HTTPS listener
  serverCertificateId string
  // ID of the CA certificate used for mutual TLS on an HTTPS listener
  caCertificateId string
  // Whether HTTP/2 is enabled on an HTTPS listener
  //
  // One of on or off. Null for non-HTTPS listeners.
  enableHttp2 string
  // Protocol-specific listener configuration
  //
  // The health-check, session-persistence, connection-drain, and
  // request-header settings for the listener. The available keys vary by
  // protocol (HTTP, HTTPS, TCP, or UDP).
  config dict
}

// CLB vServer group
//
// A named set of backend servers that a CLB listener or forwarding rule sends
// traffic to, keyed by vServerGroupId. A group lets one load balancer serve
// several backend sets, so the servers behind a listener are found here rather
// than on the load balancer itself.
alicloud.slb.vServerGroup @defaults("vServerGroupName vServerGroupId serverCount") {
  // vServer group ID, used as the lookup key
  vServerGroupId string
  // vServer group name
  vServerGroupName string
  // ID of the CLB instance the group belongs to
  loadBalancerId string
  // Region the group lives in
  regionId string
  // Number of backend servers in the group
  serverCount int
  // Time the group was created
  createTime time
  // Tags applied to the group
  tags map[string]string
  // Backend servers in the group
  backends() []alicloud.slb.backendServer
}

// CLB backend server
//
// One server a CLB forwards traffic to, whether attached directly to the load
// balancer or through a vServer group. An internet-facing CLB makes its
// backends reachable from the public internet on the listener's port,
// regardless of what the backend's own security groups say about its address,
// which is why the load balancer and not the instance is where that exposure
// becomes visible.
alicloud.slb.backendServer @defaults("type serverId serverIp port weight") {
  // ID of the backend server
  //
  // An ECS instance ID or an elastic network interface ID, depending on type.
  serverId string
  // IP address the load balancer forwards to
  //
  // Set when the backend is an elastic network interface or is addressed by IP.
  serverIp string
  // Port the load balancer forwards to
  //
  // Zero for a backend attached directly to the load balancer, where the port
  // comes from the listener instead.
  port int
  // Share of traffic the server receives
  //
  // A weight of 0 takes the server out of rotation without detaching it.
  weight int
  // Kind of backend
  //
  // One of ecs for an instance, eni for an elastic network interface, or eci
  // for an elastic container instance.
  type string
  // Backend server description
  description string
  // ECS instance behind the backend
  //
  // Null when the backend is an elastic network interface or the instance can
  // no longer be read.
  ecsInstance() alicloud.ecs.instance
}

// ApsaraDB RDS
//
// ApsaraDB relational database instances in an Alibaba Cloud account. Exposes
// the RDS instances discovered across every enabled region through instances,
// from which the database engine and version, the network placement, and the
// security posture (SSL/TLS, TDE encryption, public accessibility, and IP
// address whitelist) can be audited.
alicloud.rds {
  // RDS instances across all enabled regions
  instances() []alicloud.rds.instance
}

// ApsaraDB RDS instance
//
// A single ApsaraDB relational database instance, keyed by dbInstanceId (for
// example rm-uf6wjk5xxxxxxx). Exposes the database engine and version, the
// instance class and storage, the network placement and connection endpoint,
// the billing and lock state, and the security posture: whether SSL/TLS and
// TDE encryption are enabled, the IP address whitelist, and the attached ECS
// security groups.
alicloud.rds.instance {
  // Instance ID, for example rm-uf6wjk5xxxxxxx
  dbInstanceId string
  // Description of the instance
  dbInstanceDescription string
  // Database engine
  //
  // One of MySQL, SQLServer, PostgreSQL, or MariaDB.
  engine string
  // Database engine version, for example 5.7
  engineVersion string
  // Lifecycle status of the instance, for example Running or Creating
  dbInstanceStatus string
  // Role of the instance
  //
  // One of Primary (primary instance), Readonly (read-only instance),
  // Guard (disaster recovery instance), or Temp (temporary instance).
  dbInstanceType string
  // Instance type (class), for example rds.mys2.small
  dbInstanceClass string
  // Storage type of the instance
  //
  // One of local_ssd, cloud_ssd, cloud_essd, cloud_essd2, cloud_essd3, or
  // general_essd.
  dbInstanceStorageType string
  // Network connection type of the instance
  //
  // One of Internet (public) or Intranet (internal).
  dbInstanceNetType string
  // Connection mode of the instance
  //
  // One of Standard (standard mode) or Safe (database proxy mode).
  connectionMode string
  // Endpoint used to connect to the instance
  connectionString string
  // Region ID where the instance is deployed, for example cn-hangzhou
  regionId string
  // Zone ID where the instance is deployed, for example cn-hangzhou-a
  zoneId string
  // VPC that the instance belongs to
  vpc() alicloud.vpc.network
  // vSwitch that the instance belongs to
  vswitch() alicloud.vpc.vswitch
  // Network type of the instance
  //
  // One of VPC or Classic.
  instanceNetworkType string
  // Billing method of the instance
  //
  // One of Postpaid (pay-as-you-go), Prepaid (subscription), or Serverless.
  payType string
  // Time when the instance was created
  createTime time
  // Time when the instance expires (subscription instances only)
  expireTime time
  // Lock state of the instance
  //
  // One of Unlock, ManualLock, LockByExpiration, LockByRestoration, or
  // LockByDiskQuota.
  lockMode string
  // Reason the instance is locked
  lockReason string
  // RDS edition of the instance
  //
  // One of Basic, HighAvailability, cluster, AlwaysOn, Finance,
  // serverless_basic, serverless_standard, or serverless_ha.
  category string
  // Whether release (deletion) protection is enabled for the instance
  deletionProtection bool
  // Primary instance, set for read-only and disaster recovery instances
  masterInstance() alicloud.rds.instance
  // ID of the resource group the instance belongs to
  resourceGroupId string
  // Resource group that contains the instance
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Storage capacity of the instance in GB
  dbInstanceStorage() int
  // Port on which the instance listens for connections
  port() int
  // Tags attached to the instance as key-value pairs
  tags() map[string]string
  // Whether SSL/TLS encryption is enabled for client connections
  sslEnabled() bool
  // Expiration time of the server certificate used for SSL/TLS
  sslExpireTime() time
  // Whether Transparent Data Encryption (TDE) is enabled for the instance
  tdeEnabled() bool
  // Key generation method used for Transparent Data Encryption
  //
  // One of Aliyun_Generate_Key (the key is generated and held by Alibaba
  // Cloud), Customer_Provided_Key (the key is one you supply through Key
  // Management Service), or Unknown. Empty when TDE is disabled or the engine
  // does not report a mode.
  tdeMode() string
  // Key Management Service key that protects the instance under TDE
  //
  // Null when TDE is disabled, when the instance is encrypted with a key
  // Alibaba Cloud generated and holds, or when the key can no longer be read.
  // Traverse to the key to see its rotation state, deletion protection, and
  // who is allowed to use it.
  tdeEncryptionKey() alicloud.kms.key
  // Whether SQL Explorer collects the statements executed against the instance
  //
  // SQL Explorer (also called SQL audit) records each statement the instance
  // executes, which is what makes after-the-fact review of database activity
  // possible. False when the feature was never switched on, when it has been
  // switched off, or when the engine does not offer it.
  sqlAuditEnabled() bool
  // Days that SQL Explorer retains the statements it collects
  //
  // Zero when SQL Explorer is switched off or the instance reports no
  // retention setting. Configurable values are 30, 180, and 365 days.
  sqlAuditRetentionDays() int
  // Running parameter values of the instance, keyed by parameter name
  //
  // The values in effect on the running instance, so a check reads
  // parameters["log_connections"] without a nested traversal. Parameters
  // changed but not yet applied are not reflected here. For a PostgreSQL
  // instance this carries the log_connections, log_disconnections, and
  // log_duration settings that decide what the database records about the
  // sessions that connect to it.
  parameters() map[string]string
  // IP address whitelist
  //
  // The IP addresses and CIDR blocks allowed to connect to the instance. A
  // whitelist entry of 0.0.0.0/0 exposes the instance to the entire internet.
  securityIPList() []string
  // Whether the IP whitelist admits every address
  //
  // True when an entry in securityIPList admits any source address: the 0.0.0.0/0
  // block, the bare 0.0.0.0 the console writes for it, any other block with a
  // /0 prefix length, the % wildcard, an address range spanning the whole
  // space, or ::/0. An empty whitelist reports false, and an entry that cannot
  // be parsed is not counted as open.
  whitelistAllowsAllAddresses() bool
  // ECS security groups attached to the instance
  //
  // The groups whose rules govern which sources may reach the instance.
  // Traverse to permissions to see the allowed source ranges and ports
  // alongside securityIPList, which controls the database whitelist separately.
  securityGroups() []alicloud.ecs.securitygroup
  // Name of the blue-green deployment the instance takes part in
  //
  // Empty when the instance is not part of one. A blue-green deployment runs a
  // second instance holding the same data as the one serving traffic, so both
  // halves have to be hardened alike: the standby is a live copy of production
  // data that a whitelist or encryption setting applied only to the original
  // does not cover.
  blueGreenDeploymentName() string
  // Name of the blue instance in the deployment, empty when not part of one
  //
  // The blue instance is the one currently serving traffic.
  blueInstanceName() string
  // Name of the green instance in the deployment, empty when not part of one
  //
  // The green instance is the standby the deployment will switch to.
  greenInstanceName() string
  // Whether compute burst is enabled for the instance
  //
  // A burst-enabled instance may exceed its purchased compute for short
  // periods, so its effective capacity is not the class alone.
  computeBurstEnabled() bool
  // Whether the instance supports vector storage and search
  //
  // Reports the state of the vector extension, which turns the instance into a
  // store for embeddings and therefore a data surface an AI application reads
  // from. Empty when the engine does not report it.
  vectorSupportStatus() string
  // Read-only state of the instance, empty when it reports none
  readOnlyStatus() string
}

// ApsaraDB for Redis
//
// Entry point for the ApsaraDB for Redis (Tair) instances in an
// Alibaba Cloud account. Enumerates every Redis and Tair instance across
// the enabled regions through instances, each of which exposes its
// configuration and security posture.
alicloud.redis {
  // ApsaraDB for Redis (Tair) instances across all enabled regions
  instances() []alicloud.redis.instance
}

// ApsaraDB for Redis instance
//
// A single ApsaraDB for Redis or Tair instance, keyed by instanceId
// (for example r-bp1zxszhcgatnx). Exposes the instance class and
// architecture, the engine version, the network placement, and the
// security posture (TLS encryption, transparent data encryption, the IP
// whitelist, attached ECS security groups, and whether password
// authentication is enforced).
alicloud.redis.instance {
  // Instance ID, for example r-bp1zxszhcgatnx
  instanceId string
  // Instance name
  instanceName string
  // Lifecycle status
  //
  // One of Normal, Creating, Changing, Inactive, Flushing, Released,
  // Transforming, Unavailable, Error, Migrating, BackupRecovering,
  // MinorVersionUpgrading, NetworkModifying, SSLModifying, or
  // MajorVersionUpgrading.
  instanceStatus string
  // Database engine
  //
  // One of Redis (Redis Open-Source Edition), Tair (Tair Enterprise
  // Edition), or Memcache.
  instanceType string
  // Instance type, for example redis.master.small.default
  instanceClass string
  // Deployment architecture
  //
  // One of cluster (cluster architecture), standard (standard
  // architecture), or rwsplit (read/write splitting architecture).
  architectureType string
  // Database engine version, for example 4.0, 5.0, 6.0, or 7.0
  engineVersion string
  // Region ID the instance is deployed in, for example cn-hangzhou
  regionId string
  // Zone ID the instance is deployed in, for example cn-hangzhou-b
  zoneId string
  // Secondary zone ID for a zone-redundant instance
  secondaryZoneId string
  // VPC the instance belongs to
  vpc() alicloud.vpc.network
  // vSwitch the instance is attached to
  vswitch() alicloud.vpc.vswitch
  // Network type
  //
  // One of CLASSIC (classic network) or VPC (virtual private cloud).
  networkType string
  // Internal endpoint (connection domain) of the instance
  connectionDomain string
  // Service port the instance listens on, for example 6379
  port int
  // Private IP address of the instance
  privateIp string
  // Storage capacity of the instance, in MB
  capacity int
  // Maximum internal bandwidth of the instance, in Mbit/s
  bandwidth int
  // Maximum number of queries per second the instance can serve
  qps int
  // Maximum number of concurrent connections the instance supports
  connections int
  // Billing method
  //
  // One of PrePaid (subscription) or PostPaid (pay-as-you-go).
  chargeType string
  // Node type
  //
  // One of double (master-replica) or single (standalone).
  nodeType string
  // Package type
  //
  // One of standard (standard package) or customized (custom package).
  packageType string
  // Edition
  //
  // One of Community (Redis Open-Source Edition) or Enterprise (Tair
  // Enterprise Edition).
  editionType string
  // ID of the resource group the instance belongs to
  resourceGroupId string
  // Resource group that contains the instance
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the instance was created
  createTime time
  // Time the subscription instance expires
  endTime time
  // Tags attached to the instance, as key/value pairs
  tags map[string]string
  // Whether TLS (SSL) encryption is enabled for in-transit traffic
  sslEnabled() bool
  // Whether transparent data encryption (TDE) is enabled for data at rest
  tdeEnabled() bool
  // IP addresses and CIDR blocks allowed by the instance whitelists
  securityIPList() []string
  // Whether the IP whitelist admits every address
  //
  // True when an entry in securityIPList admits any source address: the 0.0.0.0/0
  // block, the bare 0.0.0.0 the console writes for it, any other block with a
  // /0 prefix length, the % wildcard, an address range spanning the whole
  // space, or ::/0. An empty whitelist reports false, and an entry that cannot
  // be parsed is not counted as open.
  whitelistAllowsAllAddresses() bool
  // ECS security groups associated with the instance
  //
  // The groups whose rules govern which sources may reach the instance.
  // Traverse to permissions to see the allowed source ranges and ports
  // alongside securityIPList, which controls the instance whitelist separately.
  securityGroups() []alicloud.ecs.securitygroup
  // Whether password authentication is enforced
  //
  // True when password authentication is required. False when
  // password-free access is enabled, allowing connections from within the
  // VPC without a password.
  authEnabled() bool
  // Whether the audit log records the commands run against the instance
  //
  // False when audit logging is off, and when the setting could not be read, so
  // an "auditing is on" check fails rather than passing on an instance nobody
  // could read. With it off there is no record of what was read or written,
  // which is the gap a fleet-wide database-activity check is looking for.
  auditLogEnabled() bool
  // Days the audit log is retained
  //
  // Zero when audit logging is off. Entries older than this are dropped, which
  // bounds how far back an investigation can reach.
  auditLogRetentionDays() int
}

// ApsaraDB for MongoDB
//
// Managed MongoDB service in an Alibaba Cloud account. Exposes the MongoDB
// instances across every enabled region through instances, spanning replica
// set, sharded cluster, and serverless deployments together with their
// security posture.
alicloud.mongodb {
  // MongoDB instances across all enabled regions
  instances() []alicloud.mongodb.instance
}

// ApsaraDB for MongoDB instance
//
// A single ApsaraDB for MongoDB instance, keyed by dbInstanceId, for example
// dds-bp199659b178cef4. Exposes the deployment architecture, engine version,
// storage and network placement, maintenance window, and the security posture
// including TLS, transparent data encryption, the IP whitelist, the bound ECS
// security groups, and audit log status.
alicloud.mongodb.instance {
  // Instance ID, for example dds-bp199659b178cef4
  dbInstanceId string
  // Instance name set by the user
  dbInstanceDescription string
  // Deployment architecture
  //
  // One of replicate (replica set or standalone), sharding (sharded cluster),
  // or serverless.
  dbInstanceType string
  // Instance type (specification), for example dds.mongo.mid
  dbInstanceClass string
  // Storage capacity in GB
  dbInstanceStorage int
  // Database engine, for example MongoDB
  engine string
  // Database engine version
  //
  // One of 8.0, 7.0, 6.0, 5.0, 4.4, 4.2, 4.0, or 3.4.
  engineVersion string
  // Lifecycle status
  //
  // Common values include Creating, Running, Deleting, Rebooting, DBInstanceClassChanging, and TransingToOthers. See the ApsaraDB for MongoDB instance state reference for the full set.
  dbInstanceStatus string
  // Region ID of the instance, for example cn-hangzhou
  regionId string
  // Primary zone ID of the instance, for example cn-hangzhou-g
  zoneId string
  // ID of the secondary zone in a multi-zone deployment
  secondaryZoneId string
  // ID of the hidden (third) zone in a multi-zone deployment
  hiddenZoneId string
  // Network type
  //
  // One of Classic (classic network) or VPC.
  networkType string
  // Billing method
  //
  // One of PrePaid (subscription) or PostPaid (pay-as-you-go).
  chargeType string
  // Disk storage type
  //
  // One of cloud_essd, cloud_essd1, cloud_essd2, cloud_essd3, cloud_auto, local_ssd, or cloud_essd_dbfs_s.
  storageType string
  // Number of nodes in a replica set instance
  replicationFactor string
  // Password-free access over VPC
  //
  // One of Open (password-free access within the VPC is enabled), Close (a password is required), or NotSupport.
  vpcAuthMode string
  // Backup retention policy applied when the instance is released
  //
  // One of 0 (all backup sets deleted immediately on release), 1 (one backup set retained long-term on release), or 2 (all backup sets retained long-term on release).
  backupRetentionPolicy int
  // I/O throughput consumed by a serverless instance
  capacityUnit string
  // Hardware kind code
  //
  // One of 0 (physical machine), 1 (ECS instance), 2 (Docker cluster), or 18 (Kubernetes cluster).
  kindCode string
  // Time when the instance was created
  createTime time
  // Time when a subscription instance expires
  expireTime time
  // Time when the released instance data is destroyed
  destroyTime time
  // Time when the instance was released
  releaseTime time
  // Date of the last downgrade operation, for example 2021-05-08
  lastDowngradeTime string
  // Lock status
  //
  // One of Unlock, ManualLock, LockByExpiration, LockByRestoration, LockByDiskQuota, or Released.
  lockMode string
  // ID of the resource group the instance belongs to
  resourceGroupId string
  // Resource group that contains the instance
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags attached to the instance, keyed by tag key
  tags map[string]string
  // VPC hosting the instance
  vpc() alicloud.vpc.network
  // vSwitch hosting the instance
  vswitch() alicloud.vpc.vswitch
  // Storage engine, for example WiredTiger or RocksDB
  storageEngine() string
  // Access protocol type of a sharded cluster instance
  //
  // One of mongodb or dynamodb. Returned only for sharded cluster instances.
  protocolType() string
  // Number of read-only nodes in the instance
  readonlyReplicas() string
  // Start of the maintenance window in UTC, for example 18:00Z
  maintainStartTime() string
  // End of the maintenance window in UTC, for example 03:00Z
  maintainEndTime() string
  // Whether disk encryption is enabled for the instance
  encrypted() bool
  // KMS key used for disk encryption, null when disk encryption is disabled
  kmsKey() alicloud.kms.key
  // Whether release protection is enabled for the instance
  releaseProtection() bool
  // Current minor kernel version of the database, for example 5.0.5-20220721143518_0
  currentKernelVersion() string
  // Whether TLS/SSL is enabled for client connections
  sslEnabled() bool
  // Time when the current SSL certificate expires
  sslExpireTime() time
  // Whether transparent data encryption (TDE) is enabled
  tdeEnabled() bool
  // IP addresses and CIDR blocks in the instance whitelist
  securityIPList() []string
  // Whether the IP whitelist admits every address
  //
  // True when an entry in securityIPList admits any source address: the 0.0.0.0/0
  // block, the bare 0.0.0.0 the console writes for it, any other block with a
  // /0 prefix length, the % wildcard, an address range spanning the whole
  // space, or ::/0. An empty whitelist reports false, and an entry that cannot
  // be parsed is not counted as open.
  whitelistAllowsAllAddresses() bool
  // ECS security groups bound to the instance
  //
  // The groups whose rules govern which sources may reach the instance.
  // Traverse to permissions to see the allowed source ranges and ports
  // alongside securityIPList, which controls the instance whitelist separately.
  securityGroups() []alicloud.ecs.securitygroup
  // Whether the audit log feature is enabled
  auditPolicyEnabled() bool
}

// PolarDB
//
// Entry point for querying ApsaraDB for PolarDB, the cloud-native relational
// database service. Exposes the PolarDB clusters provisioned across every
// enabled region through clusters, and the retrieval-augmented generation
// corpora built on them through knowledgeBases and knowledgeSpaces.
alicloud.polardb {
  // PolarDB clusters across all enabled regions
  clusters() []alicloud.polardb.cluster
  // PolarDB knowledge bases across all enabled regions
  knowledgeBases() []alicloud.polardb.knowledgeBase
  // PolarDB knowledge spaces across all enabled regions
  //
  // The spaces reached from the knowledge bases listed in each region, because
  // Alibaba Cloud offers no listing of knowledge spaces on their own. A space
  // that holds no knowledge base is absent here and has to be named directly,
  // for example alicloud.polardb.knowledgeSpace(knowledgeSpaceId: "pks-xxxxxxxx", regionId: "cn-beijing").
  knowledgeSpaces() []alicloud.polardb.knowledgeSpace
}

// PolarDB cluster
//
// A single ApsaraDB for PolarDB cluster, keyed by dbClusterId. Exposes the
// cluster lifecycle status, database engine and version, node class and count,
// storage usage, network placement, billing, and the security-posture controls
// that govern it: SSL/TLS encryption in transit, Transparent Data Encryption
// (TDE) at rest, the IP access whitelist, deletion protection, and the
// connection endpoints. Select a cluster with
// alicloud.polardb.cluster(dbClusterId: "pc-xxxxxxxx").
alicloud.polardb.cluster {
  // Cluster ID, for example pc-bp1234567890abc
  dbClusterId string
  // User-defined cluster description
  dbClusterDescription string
  // Lifecycle status
  //
  // For example Creating, Running, Deleting, Rebooting, DBNodeCreating,
  // DBNodeDeleting, ClassChanging, NetAddressCreating, NetAddressDeleting, or
  // NetAddressModifying.
  dbClusterStatus string
  // Database engine family
  //
  // One of MySQL, PostgreSQL, or Oracle.
  dbType string
  // Database engine version, for example 8.0, 5.7, 5.6, 11, or 14
  dbVersion string
  // Storage engine of the cluster
  //
  // One of POLARDB (compute-storage separated) or MySQL.
  engine string
  // Product edition
  //
  // One of Normal (Cluster Edition), Basic (Single Node Edition), ArchiveNormal
  // (X-Engine), NormalMultimaster (Multi-master Cluster Edition), or SENormal
  // (Standard Edition).
  category string
  // Product sub-edition, for example Exclusive or General
  subCategory string
  // Node specification class, for example polar.mysql.x4.medium
  dbNodeClass string
  // Number of nodes in the cluster
  dbNodeNumber int
  // Number of CPU cores per node
  cpuCores string
  // Memory size per node, in MB
  memorySize string
  // Used storage, in bytes
  storageUsed int
  // Maximum storage capacity, in bytes
  //
  // For PSL5/PSL4 (compute-storage separated) clusters this is the auto-scaling
  // ceiling. Resolved from the cluster attribute detail.
  storageMax() int
  // Storage type
  //
  // For example HighPerformance, PSL5, PSL4, or ESSDAUTOPL.
  storageType string
  // Storage billing method
  //
  // One of Prepaid (subscription) or Postpaid (pay-as-you-go).
  storagePayType string
  // Provisioned storage space, in GB (0 when storage auto-scales)
  storageSpace int
  // Region ID the cluster resides in, for example cn-hangzhou
  regionId string
  // Zone ID the primary node resides in, for example cn-hangzhou-i
  zoneId string
  // VPC the cluster is attached to
  vpc() alicloud.vpc.network
  // vSwitch the cluster is attached to
  vswitch() alicloud.vpc.vswitch
  // Billing method
  //
  // One of Prepaid (subscription) or Postpaid (pay-as-you-go).
  payType string
  // Creation time
  createTime time
  // Expiration time (null for pay-as-you-go clusters)
  expireTime time
  // Whether the subscription cluster has expired, as a string
  //
  // One of true or false. Empty for pay-as-you-go clusters.
  expired string
  // Lock state of the cluster
  //
  // One of Unlock, ManualLock, LockByExpiration, or LockByDiskQuota.
  lockMode string
  // Deletion protection flag
  //
  // 1 when release/deletion protection is enabled, 0 when it is disabled.
  deletionLock int
  // ID of the resource group the cluster belongs to
  resourceGroupId string
  // Resource group that contains the cluster
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Serverless cluster type, for example AgileServerless or SteadyServerless (empty for non-serverless clusters)
  serverlessType string
  // Network type
  //
  // One of VPC or Classic.
  dbClusterNetworkType string
  // AI feature type of the cluster
  //
  // One of SearchNode, DLNode, or an empty string when no AI node is attached.
  aiType string
  // Whether the cluster is a hot-standby (multi-zone) cluster
  //
  // One of ON or OFF.
  hotStandbyCluster string
  // Whether multi-node strict consistency is enabled
  //
  // One of ON or OFF.
  strictConsistency string
  // Tags attached to the cluster, as key-value pairs
  tags map[string]string
  // Database nodes in the cluster
  //
  // One entry per node with dbNodeId, dbNodeClass, dbNodeRole (Writer or
  // Reader), zoneId, regionId, imciSwitch (columnar index state), hotReplicaMode,
  // and serverless.
  dbNodes []dict
  // Whether SSL/TLS encryption in transit is enabled on any endpoint
  //
  // True when at least one endpoint reports SSLEnabled as Enabled. False when
  // SSL is disabled on all endpoints.
  sslEnabled() bool
  // Whether Transparent Data Encryption (TDE) at rest is enabled
  //
  // True when the cluster TDE status is Enabled. False when TDE is disabled.
  tdeEnabled() bool
  // IP access whitelist entries
  //
  // The flattened set of CIDR entries permitted to connect to the cluster,
  // gathered across every whitelist group. An entry of 0.0.0.0/0 means the
  // cluster accepts connections from any source.
  accessWhitelist() []string
  // Whether the IP whitelist admits every address
  //
  // True when an entry in accessWhitelist admits any source address: the 0.0.0.0/0
  // block, the bare 0.0.0.0 the console writes for it, any other block with a
  // /0 prefix length, the % wildcard, an address range spanning the whole
  // space, or ::/0. An empty whitelist reports false, and an entry that cannot
  // be parsed is not counted as open.
  whitelistAllowsAllAddresses() bool
  // Connection endpoints of the cluster
  //
  // One entry per network address with endpointType (Cluster, Primary, or
  // Custom), dbEndpointId, addressType (the network type, Public or Private),
  // connectionString, port, readWriteMode, and nodes.
  endpoints() []dict
  // Whether SQL audit collection is running on the cluster
  //
  // False when the collector is off, and when the setting could not be read, so
  // an "auditing is on" check fails rather than passing on a cluster nobody
  // could read. With it off there is no record of the statements run against
  // the cluster.
  auditLogEnabled() bool
  // Raw state of the SQL audit collector
  //
  // One of Enable, Enabling, Disable, Disabled, or Disabling. Only Enable means
  // statements are being recorded now.
  auditLogCollectorStatus() string
  // Applications provisioned on the cluster
  applications() []alicloud.polardb.application
}

// PolarDB application
//
// A single application provisioned on a PolarDB cluster, such as a PolarFS
// store or a vector store an AI workload reads. An application carries its own
// network endpoints and its own TLS settings, separate from the cluster ones,
// so a cluster with TLS on can still front an application that accepts
// unencrypted client connections. Exposes those endpoints, whether TLS is
// enabled and rotates automatically, and the server certificate common name,
// source, fingerprint, and expiry.
alicloud.polardb.application @defaults("applicationId applicationType status sslEnabled") {
  // Application ID, for example pa-xxxxxxxx
  applicationId string
  // Kind of application
  //
  // For example PolarFS or VectorStore. Reported as returned by the API, so a
  // kind added after this provider shipped still appears.
  applicationType string
  // Application description, empty when none is set
  description string
  // Cluster the application is provisioned on
  dbCluster() alicloud.polardb.cluster
  // Database engine version the application runs
  engineVersion string
  // Lifecycle state of the application, for example Running or Creating
  status string
  // Region ID the application resides in, for example cn-hangzhou
  regionId string
  // Zone ID the application resides in, for example cn-hangzhou-i
  zoneId string
  // Billing method
  //
  // One of Prepaid (subscription) or Postpaid (pay-as-you-go).
  payType string
  // When the application was created
  createTime time
  // When a prepaid application expires, null for postpaid
  expireTime time
  // Whether the application has passed its expiry, empty for postpaid
  expired string
  // PolarFS instance backing the application, empty when none
  polarFsInstanceId string
  // Network addresses the application is reachable on
  //
  // One entry per address with ip, netType (the network type, Public or
  // Private), and port. A Public entry means the application answers from
  // outside the VPC, so the TLS and whitelist settings are what stand between
  // it and the internet.
  endpoints []dict
  // Tags attached to the application
  tags map[string]string
  // Whether the application requires TLS on client connections
  //
  // False when TLS is off, and when the setting could not be read, so a "TLS is
  // on" check fails rather than passing on an application nobody could read.
  // With it off, client traffic to the endpoints travels in the clear.
  sslEnabled() bool
  // Whether the server certificate rotates automatically before it expires
  //
  // Null when TLS is off. With it false, the certificate has to be rotated by
  // hand and connections break when certExpireTime passes.
  sslAutoRotate() bool
  // Common Name of the server certificate
  //
  // Null when TLS is off.
  certCommonName() string
  // Where the server certificate comes from
  //
  // For example aliyun for an Alibaba Cloud issued certificate, or custom for
  // one uploaded by the account. Null when TLS is off.
  certSource() string
  // SHA-256 fingerprint of the server certificate, in lowercase hex
  //
  // The DER fingerprint, matching openssl -fingerprint -sha256, for clients
  // that pin the certificate. Null when TLS is off.
  certFingerprintSha256() string
  // When the server certificate expires
  //
  // Null when TLS is off.
  certExpireTime() time
  // When the server certificate was last installed
  //
  // Null when TLS is off.
  certModifiedTime() time
  // NAT gateway that publishes the application into the VPC
  //
  // Null when no NAT mapping is configured. When set, the application is
  // reached through the gateway's DNAT entries as well as through endpoints,
  // so an application whose endpoints are all Private can still answer callers
  // that reach the gateway.
  vpcNatGateway() alicloud.vpc.natGateway
  // SNAT address bound to the vSwitch the application resides on
  //
  // The address the control plane discovered for NAT mapping, null when the
  // application has no NAT mapping. It is a customer-managed SNAT entry and is
  // unrelated to an Internet NAT gateway SNAT entry.
  natMappingSnatIpAddress() string
  // DNAT entries that publish the application through the NAT gateway
  //
  // Empty when the application is not published through DNAT. Each entry maps a
  // port on the NAT gateway to a port on the application, which is a reachable
  // path that endpoints does not report: an application whose endpoints are all
  // Private still answers on every address listed here.
  dnatMappings() []alicloud.polardb.application.dnatMapping
}

// DNAT entry of a PolarDB application
//
// A single destination NAT entry that publishes one port of a PolarDB
// application through a VPC NAT gateway, keyed by entryId. Exposes the address
// the entry answers on, the front and backend ports it maps, the application
// port it fronts, and the entry state. Use it to find application ports that
// are reachable through the gateway even though the application's own
// endpoints are all private.
alicloud.polardb.application.dnatMapping @defaults("portName accessAddress status") {
  // DNAT entry ID, for example fwd-xxxxxxxx
  entryId string
  // Address the entry answers on
  //
  // In NatIp:FrontPort form, for example 10.64.0.10:10001.
  accessAddress string
  // Port on the NAT gateway that the entry accepts traffic on
  frontPort int
  // Port on the application that the entry forwards traffic to
  backendPort int
  // Application port the entry fronts
  //
  // For example webui, hermesagent, dashboard, or ssh. Reported as returned by
  // the API, so a port name added after this provider shipped still appears.
  portName string
  // Entry state, for example Available
  status string
}

// PolarDB knowledge space
//
// A single knowledge space, the vector store a PolarDB retrieval-augmented
// generation workload answers from, keyed by knowledgeSpaceId within its
// region. Exposes the access control mode that decides how much of the corpus a
// caller retrieves, the OSS bucket the source documents are drawn from, the
// PolarDB cluster and database that hold the vectors, and the embedding,
// generation, and reranking models in use. The knowledgeSpaceId field selects
// the space, for example
// alicloud.polardb.knowledgeSpace(knowledgeSpaceId: "pks-xxxxxxxx", regionId: "cn-beijing").
alicloud.polardb.knowledgeSpace @defaults("name knowledgeSpaceId aclMode status") {
  // Region ID the knowledge space resides in, for example cn-beijing
  regionId string
  // Knowledge space ID, used with the region as the lookup key
  knowledgeSpaceId string
  // Name of the knowledge space
  name string
  // Description of the knowledge space, empty when none is set
  description string
  // Access control applied when retrieving from the corpus
  //
  // One of DISABLED or ENFORCED. With it DISABLED, no per-document access
  // control is applied, so every caller that can query the space retrieves
  // from the whole corpus.
  aclMode string
  // Lifecycle state of the knowledge space, for example Activation
  status string
  // PolarDB cluster that stores the vectors
  //
  // Null when the space names no cluster, and when the cluster lies outside the
  // scanned regions.
  dbCluster() alicloud.polardb.cluster
  // Name of the database that holds the vectors, for example polar_rag_meta
  dbName string
  // Database engine that holds the vectors
  //
  // One of MySQL or PostgreSQL.
  dbType string
  // OSS bucket the source documents are drawn from
  //
  // Null when the space names no bucket. The bucket's own access controls
  // decide who reaches the raw documents behind the corpus, which the access
  // control on the space itself does not govern.
  ossBucket() alicloud.oss.bucket
  // Model that turns documents into vectors, for example text-embedding-v4
  embeddingModel string
  // Number of dimensions in the stored vectors, for example 1536
  embeddingDimension int
  // Model that composes answers from the retrieved documents, for example qwen3.6-plus
  llmModel string
  // Model that reorders retrieval results, for example qwen3-rerank
  rerankModel string
  // Chunking strategy applied to documents, for example hybrid
  strategy string
  // Chunk size in tokens
  shardSize int
  // Number of knowledge bases in the space
  knowledgeBaseCount int
  // Total number of documents across the space
  totalDocs int
  // Total size of the documents across the space, in bytes
  totalSizeBytes int
  // When the knowledge space was created
  createTime time
  // Knowledge bases contained in the space
  knowledgeBases() []alicloud.polardb.knowledgeBase
}

// PolarDB knowledge base
//
// A single knowledge base within a knowledge space, keyed by knowledgeBaseId
// within its region. A knowledge base groups the documents a retrieval workload
// answers from. Exposes the sharing scope that decides who reads it, the
// document and byte counts, how many AI applications are bound to it, and the
// synchronization links that pull content into it from an external messaging
// platform on a timer.
alicloud.polardb.knowledgeBase @defaults("name knowledgeBaseId knowledgeBaseType status") {
  // Region ID the knowledge base resides in, for example cn-beijing
  regionId string
  // Knowledge base ID, for example pkb-xxxxxxxx
  knowledgeBaseId string
  // Name of the knowledge base
  name string
  // Description of the knowledge base, empty when none is set
  description string
  // Sharing scope of the knowledge base
  //
  // One of PUBLIC, readable by everyone with access to the knowledge space, or
  // PERSONAL, readable only by the account that created it.
  knowledgeBaseType string
  // Lifecycle state of the knowledge base, for example Activation
  status string
  // Knowledge space that contains the knowledge base
  //
  // Null when the knowledge base names no space, and when the space could not
  // be read.
  knowledgeSpace() alicloud.polardb.knowledgeSpace
  // Number of AI applications bound to the knowledge base
  bindingAppCount int
  // Total number of documents in the knowledge base
  totalDocs int
  // Total size of the documents in the knowledge base, in bytes
  totalSizeBytes int
  // When the knowledge base was created
  createTime time
  // Synchronization links that feed content into the knowledge base
  //
  // Empty when nothing is synchronized in. Each link pulls a directory from an
  // external messaging platform on a timer, so documents reach the corpus with
  // nobody reviewing them at the moment they land.
  syncLinks() []alicloud.polardb.knowledgeBase.syncLink
}

// Synchronization link of a PolarDB knowledge base
//
// A single link that pulls documents into a knowledge base from a directory on
// an external messaging platform, keyed by linkId. Exposes the platform and the
// client identity the link authenticates as, the source directory it reads, how
// often it runs, and whether it is running. A running link is an unattended
// path for outside content to enter the corpus a retrieval workload answers
// from.
alicloud.polardb.knowledgeBase.syncLink @defaults("linkName imPlatform sourceDir syncStatus") {
  // Synchronization link ID, for example pkbl-xxxxxxxx
  linkId string
  // Name of the synchronization link
  linkName string
  // Description of the synchronization link, empty when none is set
  description string
  // Messaging platform the link pulls content from
  //
  // FEISHU is the documented source channel. Reported as returned by the API,
  // so a platform added after this provider shipped still appears.
  imPlatform string
  // Client identity the link authenticates to the platform as, for example cli_xxxxxxbe8
  clientId string
  // Source directory the link reads
  //
  // For example https://example.feishu.cn/wiki/space/xxxxxx.
  sourceDir string
  // Minutes between synchronization runs
  syncIntervalMinutes int
  // Synchronization state
  //
  // One of CREATING, RUNNING, PAUSED, or DELETING. Only RUNNING pulls content
  // in now.
  syncStatus string
  // When the synchronization link was created
  createTime time
}

// VPC flow log
//
// A single flow log that captures traffic metadata for a VPC, vSwitch, or
// elastic network interface, keyed by flowLogId within its region. Exposes the
// monitored resource, the traffic direction and path captured, and the Log
// Service project and logstore that receive the records. Use it to audit
// whether flow logging is enabled for a network and where the records are
// delivered. For example `alicloud.vpc.flowLog(flowLogId: "fl-xxx", regionId: "cn-hangzhou")`.
alicloud.vpc.flowLog {
  // Region ID the flow log resides in, for example cn-hangzhou
  regionId string
  // Flow log ID, used as the lookup key within its region
  flowLogId string
  // Flow log name
  flowLogName string
  // Description of the flow log
  description string
  // Flow log state
  //
  // One of Active, Activating, or Inactive. A flow log only captures traffic while Active.
  status string
  // Business (billing) state of the flow log
  //
  // For example Normal, or FinancialLocked when the flow log is locked for
  // overdue payment.
  businessStatus string
  // ID of the monitored resource (a VPC, vSwitch, or elastic network interface)
  resourceId string
  // Type of the monitored resource
  //
  // One of VPC, VSwitch, or NetworkInterface.
  resourceType string
  // Traffic direction captured
  //
  // One of All, Allow (accepted traffic), or Drop (rejected traffic).
  trafficType string
  // Traffic path captured
  //
  // The network paths the flow log records, for example full for all paths or
  // a subset such as internetGateway. Empty when no path filter is applied.
  trafficPath []string
  // IP version captured
  //
  // One of IPv4, IPv6, or all.
  ipVersion string
  // Interval in seconds over which records are aggregated, for example 600
  aggregationInterval int
  // Name of the Log Service project that receives the records
  projectName string
  // Log Service project that receives the records
  //
  // Null when the flow log names no project, and when the project lives in
  // another account that the scan cannot read.
  project() alicloud.log.project
  // Name of the Log Service logstore that receives the records
  logStoreName string
  // ID of the resource group the flow log belongs to
  resourceGroupId string
  // Resource group that contains the flow log
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the flow log was created
  creationTime time
  // Delivery state of the records to Log Service
  //
  // For example FlowLogDeliverStarted when records are being delivered, or a
  // failure state when delivery is not succeeding.
  deliverStatus string
  // Most recent delivery error, empty when delivery is healthy
  deliverErrorMessage string
  // Tags applied to the flow log
  tags map[string]string
  // Log Service logstore that receives the records
  logstore() alicloud.log.logstore
  // VPC network monitored by the flow log
  //
  // Null when the monitored resource is a vSwitch or an elastic network
  // interface rather than a VPC.
  network() alicloud.vpc.network
  // vSwitch monitored by the flow log
  //
  // Null when the monitored resource is a VPC or an elastic network interface
  // rather than a vSwitch.
  vswitch() alicloud.vpc.vswitch
}

// Alibaba Cloud Key Management Service
//
// Encryption keys and secrets managed for an Alibaba Cloud account. Exposes the
// customer master keys across all enabled regions, including their lifecycle
// state, cryptographic spec, rotation configuration, and protection level, and
// the secrets held in Secrets Manager along with the master key that protects
// each one. Use it to audit key rotation, deletion protection, and whether keys
// are backed by a hardware security module.
alicloud.kms {
  // Customer master keys across all enabled regions
  keys() []alicloud.kms.key
  // Secrets held in Secrets Manager across all enabled regions
  secrets() []alicloud.kms.secret
}

// Key Management Service customer master key
//
// A single customer master key (CMK), keyed by keyId within its region. Exposes
// the key lifecycle state, cryptographic spec and usage, material origin,
// protection level, and the automatic-rotation configuration, along with the
// aliases that point at the key. Use it to audit whether keys rotate, whether
// deletion protection is on, and whether the key material lives in an HSM. For
// example `alicloud.kms.key(keyId: "0d24xxxx", regionId: "cn-hangzhou")`.
alicloud.kms.key {
  // Region ID the key resides in, for example cn-hangzhou
  regionId string
  // Key ID, used as the lookup key within its region
  keyId string
  // Alibaba Cloud Resource Name of the key
  arn string
  // Key lifecycle state
  //
  // One of Enabled, Disabled, PendingDeletion, or PendingImport.
  keyState string
  // Cryptographic operations the key may perform
  //
  // Either ENCRYPT/DECRYPT for encryption keys or SIGN/VERIFY for signing keys.
  keyUsage string
  // Cryptographic specification of the key
  //
  // For example Aliyun_AES_256, Aliyun_SM4, RSA_2048, EC_P256, or EC_SM2.
  keySpec string
  // Source of the key material
  //
  // Aliyun_KMS when the material was generated by KMS, or EXTERNAL when it was
  // imported.
  origin string
  // Protection level of the key material
  //
  // SOFTWARE for software-protected keys, or HSM when the material is stored in
  // a hardware security module.
  protectionLevel string
  // Automatic key-rotation state
  //
  // One of Enabled, Disabled, or Suspended. Suspended means rotation was
  // enabled but KMS cannot rotate the key, for example after the key was
  // disabled.
  automaticRotation string
  // Interval between automatic rotations, in seconds
  //
  // For example 31536000 for a key that rotates once a year. Null when the key
  // reports no interval, which is the case while automatic rotation is
  // disabled.
  rotationInterval int
  // Time the key was created
  creationDate time
  // Time the key is scheduled for deletion, null when no deletion is scheduled
  deleteDate time
  // Time the key material was last rotated, null when never rotated
  lastRotationDate time
  // Time the key is next scheduled to rotate, null when rotation is disabled
  nextRotationDate time
  // Time imported key material expires, null when it does not expire
  materialExpireTime time
  // Identifier of the current primary key version
  primaryKeyVersion string
  // Deletion-protection state
  //
  // Enabled when the key cannot be scheduled for deletion until protection is
  // turned off.
  deletionProtection string
  // Account (UID) or service that created the key
  creator string
  // Description of the key
  description string
  // Dedicated KMS instance ID that holds the key, empty for the shared default KMS
  dkmsInstanceId string
  // Alias names that point at the key, for example alias/my-key
  aliases() []string
  // Key policy document
  //
  // The resource policy attached to the key, as a JSON string. It names the
  // identities permitted to use the key for cryptographic operations, which is
  // a grant that the RAM policies attached to those identities do not show on
  // their own. Empty when the key carries no policy, and on a key policy the
  // scan is not permitted to read.
  policy() string
  // Parsed statements of the key policy
  //
  // The key policy decoded into statements, so the principals and the actions
  // they are granted can be queried directly rather than by matching text.
  statements() []alicloud.ram.policy.statement
  // Accounts outside the key's own account that the key policy grants use of the key
  //
  // Sorted and deduplicated. A non-empty list means the key can be used to
  // decrypt from another Alibaba Cloud account, so data encrypted with it is
  // readable outside this account's control.
  externalPrincipalAccountIds() []string
  // Whether the key policy grants use of the key outside its own account
  //
  // True when an allowing statement names a principal in another account, or
  // names the wildcard `*`. Note that a key with no readable policy reports
  // false, because an unread policy must not be reported as a grant.
  allowsExternalPrincipal() bool
  // Whether the key policy names the wildcard as a principal
  //
  // True when an allowing statement grants use of the key to `*`, which admits
  // any identity the key's resource-sharing configuration reaches.
  hasWildcardPrincipal() bool
}

// Key Management Service secret
//
// A single secret held in Secrets Manager, keyed by secretName within its
// region. Exposes the secret metadata, type, rotation configuration, and the
// customer master key that encrypts the secret value. The secret value itself
// is never exposed. Use it to audit which secrets rotate and which key protects
// each one.
alicloud.kms.secret {
  // Region ID the secret resides in, for example cn-hangzhou
  regionId string
  // Secret name, used as the lookup key within its region
  secretName string
  // Alibaba Cloud Resource Name of the secret
  arn string
  // Secret type
  //
  // One of Generic, Rds, Redis, PolarDB, RAMCredentials, or ECS. Managed types (Rds, ECS,
  // RAMCredentials) are rotated by the owning service.
  secretType string
  // Automatic-rotation state
  //
  // One of Enabled, Disabled, Suspended, or Invalid.
  automaticRotation string
  // Interval between automatic rotations, in seconds
  //
  // For example 604800 for a secret that rotates once a week. Null when the
  // secret reports no interval, which is the case while automatic rotation is
  // disabled.
  rotationInterval int
  // Time the secret was last rotated, null when never rotated
  lastRotationDate time
  // Time the secret is next scheduled to rotate, null when rotation is disabled
  nextRotationDate time
  // Time the secret is scheduled for deletion, null when no deletion is scheduled
  plannedDeleteTime time
  // Service that owns the secret, empty for user-managed secrets
  owingService string
  // Description of the secret
  description string
  // Dedicated KMS instance ID that holds the secret, empty for the shared default KMS
  dkmsInstanceId string
  // Type-specific extended configuration
  //
  // Parsed from the secret's extended-config document; the shape varies by
  // secretType, for example the linked instance and account for an Rds secret.
  // Null for Generic secrets.
  extendedConfig dict
  // Time the secret was created
  createTime time
  // Time the secret was last updated
  updateTime time
  // Customer master key that encrypts the secret value
  encryptionKey() alicloud.kms.key
  // Tags applied to the secret
  tags map[string]string
}

// Alibaba Cloud ActionTrail
//
// Audit trail configuration for an Alibaba Cloud account. Exposes the trails
// that record management and data-plane API events, including where each trail
// delivers events (an OSS bucket or a Log Service project), whether it spans the
// resource directory, and its live logging and delivery health. Use it to audit
// whether API activity is being recorded and successfully delivered.
alicloud.actiontrail {
  // Trails configured in the account
  trails() []alicloud.actiontrail.trail
}

// ActionTrail trail
//
// A single audit trail, keyed by name. Exposes the event categories it captures
// (read, write, or all), the OSS bucket and Log Service project it delivers to,
// the delivery roles, whether it is an organization trail, and its live logging
// and delivery status. Use it to confirm a trail is actively logging and
// delivering events without errors.
alicloud.actiontrail.trail {
  // Trail name, used as the lookup key
  name string
  // Configuration state of the trail
  //
  // One of Enable, Disable, or Fresh. Fresh means the trail was created but has
  // never started logging.
  status string
  // Event categories the trail records
  //
  // One of Write, Read, or All.
  eventRW string
  // Region the trail was created in
  homeRegion string
  // Region whose events the trail records, or All for a multi-region trail
  trailRegion string
  // Alibaba Cloud Resource Name of the trail
  trailArn string
  // Whether the trail records events across all accounts in the resource directory
  isOrganizationTrail bool
  // Resource directory (organization) ID for an organization trail, empty otherwise
  organizationId string
  // Name of the OSS bucket that receives delivered events, empty when not delivering to OSS
  ossBucketName string
  // Region of the OSS bucket, for example oss-cn-hangzhou
  ossBucketLocation string
  // Object-name prefix applied to delivered event files
  ossKeyPrefix string
  // RAM role ARN ActionTrail assumes to write to the OSS bucket
  ossWriteRoleArn string
  // ARN of the Log Service project that receives delivered events, empty when not delivering to SLS
  slsProjectArn string
  // RAM role ARN ActionTrail assumes to write to the Log Service project
  slsWriteRoleArn string
  // Time the trail was created
  createTime time
  // Time the trail was last updated
  updateTime time
  // Time the trail most recently started logging
  startLoggingTime time
  // Time the trail most recently stopped logging, empty while logging
  stopLoggingTime time
  // OSS bucket that receives delivered events
  ossBucket() alicloud.oss.bucket
  // Log Service project that receives delivered events
  slsProject() alicloud.log.project
  // Whether the trail is actively logging events
  //
  // The live logging state reported by ActionTrail, which can differ from the
  // configured status.
  isLogging() bool
  // Time of the most recent successful event delivery, null when none
  latestDeliveryTime() time
  // Most recent event-delivery error, empty when the last delivery succeeded
  latestDeliveryError() string
  // Time of the most recent successful delivery to Log Service, null when none
  latestDeliveryLogServiceTime() time
  // Most recent Log Service delivery error, empty when the last delivery succeeded
  latestDeliveryLogServiceError() string
}

// Alibaba Cloud Log Service
//
// Log Service (SLS) projects and their logstores across an Alibaba Cloud
// account. Exposes the projects in every enabled region and, within each, the
// logstores that ingest and store logs, including their retention period and
// server-side encryption configuration. Log Service is the delivery target for
// ActionTrail trails and VPC flow logs, so these resources anchor the account's
// logging posture.
alicloud.log {
  // Log Service projects across all enabled regions
  projects() []alicloud.log.project
}

// Log Service project
//
// A single Log Service project, keyed by name within its region. A project is
// the top-level container that groups logstores, dashboards, and alerts.
// Exposes the project metadata, endpoints, and the logstores it contains. For
// example `alicloud.log.project(name: "my-project", regionId: "cn-hangzhou")`.
alicloud.log.project {
  // Region ID the project resides in, for example cn-hangzhou
  regionId string
  // Project name, globally unique and used as the lookup key
  name string
  // Description of the project
  description string
  // Project status, for example Normal
  status string
  // Account (UID) that owns the project
  owner string
  // ID of the resource group the project belongs to
  resourceGroupId string
  // Resource group that contains the project
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Data-redundancy type of the project storage, for example LRS or ZRS
  dataRedundancyType string
  // Whether the recycle bin is enabled for the project
  recycleBinEnabled bool
  // Internal endpoint for access from within Alibaba Cloud
  internalEndpoint string
  // Public endpoint for access over the Internet
  internetEndpoint string
  // Time the project was created
  createTime time
  // Time the project was last modified
  lastModifyTime time
  // Logstores contained in the project
  logstores() []alicloud.log.logstore
  // Resource policy attached to the project
  //
  // The JSON policy document that grants principals outside the owning account
  // access to the project and everything in it. Empty when no policy is
  // attached, which leaves access governed by RAM alone. Audit logs delivered
  // into a project are only as protected as this policy allows.
  policy() string
  // Whether the resource policy grants access to any principal
  //
  // True when a granting statement names a wildcard principal, which opens the
  // project's log data to callers outside the account. False when no policy is
  // attached or every grant is scoped to named principals.
  isPublic() bool
  // Alert rules defined in the project
  //
  // The rules that watch the project's logs and raise a notification when a
  // query matches. Logs being collected is only half of monitoring; without a
  // rule reading them, nothing is noticed.
  alerts() []alicloud.log.alert
  // API keys scoped to the project
  //
  // The standing credentials that reach the project's stores directly, outside
  // the RAM identities the rest of the account is audited through.
  apiKeys() []alicloud.log.apiKey
}

// Log Service API key
//
// A single standing API key of a Log Service project, keyed by the project name
// and the key name within a region. An API key is a long-lived credential for
// the logging plane, so its store scope and its state decide how much log data
// one leaked string reaches. Exposes the key state, the stores the key is
// limited to, whether that scope leaves it unrestricted, and the creation and
// last-update times. The key material is never read.
alicloud.log.apiKey @defaults("apiKeyName status allowsAllStores") {
  // Region ID of the project the key belongs to, for example cn-hangzhou
  regionId string
  // Name of the project the key is scoped to
  projectName string
  // Project the key is scoped to
  project() alicloud.log.project
  // Name of the API key, unique within the project
  apiKeyName string
  // Description of the API key, empty when none is set
  description string
  // State of the API key
  //
  // Enabled while the key authenticates requests, Disabled once it has been
  // turned off. A disabled key still exists and can be turned back on.
  status string
  // Names of the stores the key is limited to
  //
  // The logstores and metricstores named in the key scope. An empty list is not
  // "reaches nothing": it means the key carries no store restriction and
  // reaches every store in the project, which allowsAllStores reports directly.
  allowedStores []string
  // Whether the key reaches every store in the project
  //
  // True when allowedStores is empty, which leaves the key unrestricted within
  // the project.
  allowsAllStores bool
  // Logstores named in the key scope
  //
  // Empty when the key names no store, which means it is unrestricted, and
  // empty when every name in the scope is a metricstore rather than a
  // logstore. Read allowsAllStores before concluding a key is narrowly scoped.
  allowedLogstores() []alicloud.log.logstore
  // When the API key was created
  createTime time
  // When the API key was last updated
  updateTime time
}

// Log Service alert rule
//
// A single alert rule in a Log Service project, keyed by the project and the
// rule name. Exposes whether the rule is enabled, how often it is evaluated,
// and the queries it runs, each naming the store it reads and the search it
// performs. Both halves matter: a rule whose query matches nothing raises
// nothing, and so does a rule that is disabled or muted, however well written
// its query is.
alicloud.log.alert @defaults("name enabled scheduleInterval") {
  // Region of the project the rule belongs to
  regionId string
  // Name of the project the rule belongs to
  projectName string
  // Rule name, used with the project as the lookup key
  name string
  // Display name shown in the console
  displayName string
  // Description of the rule
  description string
  // Whether the rule is evaluated
  //
  // A disabled rule is kept but never runs, so it raises nothing regardless of
  // what its query would have matched.
  enabled bool
  // Status the API reports, either ENABLED or DISABLED
  status string
  // Kind of schedule the rule runs on, for example FixedRate or Cron
  scheduleType string
  // How often the rule is evaluated, for example 1m or 5m
  //
  // Empty when the rule runs on a cron expression instead, given by
  // scheduleCronExpression.
  scheduleInterval string
  // Cron expression the rule is evaluated on
  //
  // Empty when the rule runs at a fixed interval instead.
  scheduleCronExpression string
  // Time zone the schedule is interpreted in
  scheduleTimeZone string
  // Whether the schedule is currently running
  //
  // False when the rule is disabled.
  scheduleRunImmediately bool
  // Consecutive matches required before the rule fires
  //
  // A threshold above 1 means a single match does not raise anything.
  threshold int
  // Whether the rule fires when its query returns no data at all
  //
  // A rule watching for the absence of an expected event needs this, otherwise
  // a silent source is indistinguishable from a healthy one.
  noDataFire bool
  // Time until which the rule is muted
  //
  // Null when the rule is not muted. A muted rule is evaluated but raises no
  // notification, so it can read as enabled while notifying nobody.
  muteUntil time
  // Labels attached to the rule as key-value pairs
  labels map[string]string
  // Annotations attached to the rule as key-value pairs
  annotations map[string]string
  // Time the rule was created
  createTime time
  // Time the rule was last modified
  lastModifiedTime time
  // Queries the rule evaluates
  //
  // A rule can read several stores. Each entry names the store and the search
  // run against it, which is what decides whether the rule notices the events
  // it was meant to.
  queries() []alicloud.log.alert.query
  // Log Service project the rule belongs to
  project() alicloud.log.project
}

// Log Service alert rule query
//
// A single query an alert rule evaluates. Exposes the store it reads, the
// search it runs, and the time range it covers, so the events a rule can
// actually notice are readable rather than implied by the rule's name.
alicloud.log.alert.query @defaults("store query") {
  // Name of the project the query reads from
  projectName string
  // Name of the logstore or metricstore the query reads
  store string
  // Search the query runs
  //
  // The Log Service query the rule evaluates, for example a filter over an
  // ActionTrail logstore selecting a particular event name.
  query string
  // Start of the time range the query covers, relative to each evaluation
  //
  // For example -5m.
  start string
  // End of the time range the query covers, relative to each evaluation
  //
  // For example now.
  end string
  // Region the queried store resides in
  regionId string
  // RAM role assumed to read the store
  //
  // Set when the query reads a store in another account. Empty when it reads a
  // store in the account being scanned.
  roleArn string
  // Logstore the query reads
  //
  // Null when the query reads a store in another account or region, or a store
  // that can no longer be read.
  logstore() alicloud.log.logstore
}

// Log Service logstore
//
// A single logstore within a Log Service project, keyed by the owning project
// name and logstore name. A logstore ingests, stores, and indexes a stream of
// logs. Exposes the retention period, shard layout, telemetry type, and the
// server-side encryption configuration. Use it to audit log retention and
// whether logs are encrypted with a customer master key.
alicloud.log.logstore {
  // Region ID the logstore resides in, for example cn-hangzhou
  regionId string
  // Name of the project that contains the logstore
  projectName string
  // Project that contains the logstore
  project() alicloud.log.project
  // Logstore name, used with the project name as the lookup key
  name string
  // Number of days ingested logs are retained; 3650 means permanent retention
  ttl() int
  // Number of days logs are kept in hot storage before moving to cold storage
  hotTtl() int
  // Number of read/write shards the logstore is split into
  shardCount() int
  // Whether the logstore automatically splits shards under load
  autoSplit() bool
  // Maximum number of shards the logstore may auto-split into
  maxSplitShard() int
  // Whether the built-in reserved fields (for example __topic__) are recorded
  appendMeta() bool
  // Whether WebTracking ingestion is enabled for the logstore
  enableTracking() bool
  // Telemetry type stored, for example None for logs or Metrics
  telemetryType() string
  // Logstore mode, for example standard or query
  mode() string
  // Whether server-side encryption is enabled for the logstore
  encryptionEnabled() bool
  // Server-side encryption algorithm
  //
  // For example default or sm4. Empty when encryption is disabled.
  encryptionType() string
  // Customer master key used for server-side encryption
  //
  // Null when encryption is disabled or uses a service-managed key rather than
  // a specific customer master key.
  encryptionKey() alicloud.kms.key
  // Time the logstore was created
  createTime() time
  // Time the logstore was last modified
  lastModifyTime() time
}

// Alibaba Cloud Cloud Config
//
// Configuration-compliance state for an Alibaba Cloud account. Exposes the
// Config rules that continuously evaluate resource configuration, the
// account-wide compliance summary, and whether the configuration recorder and
// its delivery channels are active. Use it to audit whether configuration
// recording is enabled and how many resources are non-compliant.
alicloud.config {
  // Config rules defined in the account
  rules() []alicloud.config.rule
  // Whether the configuration recorder is registered and actively recording
  //
  // True when the recorder status is REGISTERED. When false, resource
  // configuration changes are not being captured.
  recorderEnabled() bool
  // Configuration-recorder status
  //
  // One of REGISTRABLE, BUILDING, REGISTERED, or REBUILDING. REGISTERED means
  // recording is active.
  recorderStatus() string
  // Resource types the configuration recorder captures
  recordedResourceTypes() []string
  // Account-wide compliance summary
  //
  // Counts of compliant and non-compliant rules and resources. Keys include
  // compliantRuleCount, nonCompliantRuleCount, totalRuleCount,
  // compliantResourceCount, nonCompliantResourceCount, totalResourceCount, and
  // the highRisk, mediumRisk, and lowRisk non-compliant resource counts.
  complianceSummary() dict
  // Delivery channels that export configuration data and compliance results
  //
  // A recording account that has no enabled delivery channel keeps its
  // configuration history only inside the Cloud Config console, so nothing
  // reaches the OSS bucket, logstore, or message topic an audit pipeline reads.
  // Empty when no delivery channel is configured.
  deliveryChannels() []alicloud.config.deliveryChannel
  // Compliance packs applied in the account
  //
  // A compliance pack bundles Config rules into a single evaluated set. Reports
  // the pack inventory, the risk level assigned to each, and the rules a pack
  // carries.
  compliancePacks() []alicloud.config.compliancePack
  // Account groups that aggregate configuration data from member accounts
  //
  // An aggregator collects configuration and compliance data from other
  // accounts into this one, either from the whole resource directory or from a
  // hand-picked set of accounts.
  aggregators() []alicloud.config.aggregator
  // Non-compliant evaluation results across every rule in the account
  //
  // The resources that currently fail a Config rule, each carrying the rule
  // that flagged it, the annotation explaining why, and the risk level. This is
  // the evaluated outcome, whereas rules reports only which rules exist.
  nonCompliantResults() []alicloud.config.evaluationResult
}

// Cloud Config rule
//
// A single Config rule, keyed by configRuleId. A rule continuously evaluates
// whether resources of a given type meet a configuration requirement and
// reports each resource as compliant or non-compliant. Exposes the rule
// definition, risk level, evaluation source, and current compliance result.
alicloud.config.rule {
  // Config rule ID, used as the lookup key
  configRuleId string
  // Config rule name
  configRuleName string
  // Alibaba Cloud Resource Name of the rule
  configRuleArn string
  // Rule state
  //
  // One of ACTIVE, INACTIVE, EVALUATING, or DELETING.
  configRuleState string
  // Description of the rule
  description string
  // Risk level of a non-compliant result
  //
  // 1 for high, 2 for medium, 3 for low.
  riskLevel int
  // Owner of the rule's evaluation logic
  //
  // ALIYUN for a managed rule, or a custom source such as CUSTOM_FC for a
  // Function Compute-backed rule.
  sourceOwner string
  // Identifier of the managed rule or custom evaluation function
  sourceIdentifier string
  // Automation type applied to non-compliant resources, empty when none
  automationType string
  // Resource types the rule evaluates
  resourceTypesScope []string
  // Compliance result type
  //
  // One of COMPLIANT, NON_COMPLIANT, NOT_APPLICABLE, or INSUFFICIENT_DATA.
  complianceType string
  // Number of resources in the current compliance result
  complianceCount int
  // ID of the compliance pack the rule belongs to, empty when the rule is standalone
  compliancePackId string
  // Maximum interval at which a periodic rule re-evaluates
  //
  // One of One_Hour, Three_Hours, Six_Hours, Twelve_Hours, or
  // TwentyFour_Hours. Empty for change-triggered rules.
  maximumExecutionFrequency() string
  // Time the rule was created
  createTime() time
  // Time the rule was last modified
  modifiedTime() time
  // Tags applied to the rule
  tags map[string]string
  // Resources the rule has evaluated and the verdict for each
  //
  // The evaluated outcome of the rule, one entry per resource it examined,
  // carrying the compliance verdict and the annotation explaining it.
  evaluationResults() []alicloud.config.evaluationResult
}

// Cloud Config delivery channel
//
// A destination Cloud Config writes configuration snapshots, configuration
// change notifications, and compliance results to, keyed by channelId. The
// destination is an OSS bucket, a Log Service logstore, or a Message Service
// topic, reached through ossBucket and logstore where the destination has a
// resource of its own. The enabled flag reports whether delivery is running,
// and the four notification toggles report which payload kinds are sent, so a
// channel that exists but delivers nothing an audit pipeline reads is
// distinguishable from one that is working.
alicloud.config.deliveryChannel @defaults("name type enabled") {
  // Delivery channel ID, used as the lookup key
  channelId string
  // Delivery channel name
  name string
  // Destination service
  //
  // One of OSS, MNS, or SLS.
  type string
  // ARN of the destination the channel writes to
  //
  // An OSS bucket, a Message Service topic, or a Log Service logstore. Message
  // Service topics have no resource of their own, so this is the only complete
  // view of the destination.
  targetArn string
  // OSS bucket the channel delivers to
  //
  // Null when the channel targets a Log Service logstore or a Message Service
  // topic.
  ossBucket() alicloud.oss.bucket
  // Log Service logstore the channel delivers to
  //
  // Null when the channel targets an OSS bucket or a Message Service topic.
  logstore() alicloud.log.logstore
  // RAM role Cloud Config assumes to write to the destination
  //
  // Null when the channel is configured without an assume-role ARN.
  assumeRole() alicloud.ram.role
  // Whether the channel is delivering
  //
  // False when the channel exists but is disabled, in which case nothing
  // reaches the destination.
  enabled bool
  // Delivery channel description
  description string
  // Filter that limits which resources the channel delivers
  //
  // A JSON expression evaluated against each configuration item. Empty when the
  // channel delivers every item.
  condition string
  // Delivery time of the scheduled resource snapshot
  //
  // An ISO 8601 timestamp whose hour selects the daily delivery time, for
  // example 2021-09-15T16:00:00Z. Empty when snapshot delivery is off.
  snapshotTime string
  // Whether configuration change notifications are delivered
  configurationItemChangeNotification bool
  // Whether the scheduled resource snapshot is delivered
  configurationSnapshot bool
  // Whether compliant evaluation results are delivered
  compliantSnapshot bool
  // Whether non-compliant evaluation results are delivered
  nonCompliantNotification bool
  // ARN of the OSS bucket that receives payloads too large for the channel
  //
  // Empty when no oversized-data bucket is configured, in which case an
  // oversized payload is dropped rather than delivered elsewhere.
  oversizedDataOssTargetArn string
}

// Cloud Config compliance pack
//
// A named bundle of Config rules evaluated together, keyed by compliancePackId.
// Reports the pack definition, the template it was built from, the risk level
// assigned to it, and the rules it carries, so a pack that is present but not
// yet evaluating is distinguishable from one that is active.
alicloud.config.compliancePack @defaults("compliancePackName status riskLevel") {
  // Compliance pack ID, used as the lookup key
  compliancePackId string
  // Compliance pack name
  compliancePackName string
  // ID of the template the pack was built from
  //
  // Empty for a pack assembled from individual rules rather than a template.
  compliancePackTemplateId string
  // Compliance pack description
  description string
  // Risk level assigned to the pack
  //
  // One of 1 (high), 2 (medium), or 3 (low).
  riskLevel int
  // Compliance pack status
  //
  // Either ACTIVE, meaning the pack is evaluating, or CREATING.
  status string
  // Time the pack was created
  createTime time
  // Tags applied to the pack
  tags map[string]string
  // Config rules the pack evaluates
  rules() []alicloud.config.rule
}

// Cloud Config aggregator
//
// An account group that collects configuration and compliance data from other
// accounts into this one, keyed by aggregatorId. An RD aggregator covers a
// folder of the resource directory and grows as accounts join it, while a
// CUSTOM aggregator covers a fixed list of accounts and silently omits any
// account added afterwards.
alicloud.config.aggregator @defaults("aggregatorName aggregatorType accountCount") {
  // Aggregator ID, used as the lookup key
  aggregatorId string
  // Aggregator name
  aggregatorName string
  // Aggregator type
  //
  // One of RD, covering the whole resource directory, FOLDER, covering a
  // resource directory folder, or CUSTOM, covering a fixed set of accounts.
  aggregatorType string
  // Aggregator description
  description string
  // Aggregator status
  //
  // 0 while the account group is being created, and 1 once it is created.
  status int
  // Number of member accounts the aggregator collects from
  accountCount int
  // Resource directory folder the aggregator covers
  //
  // Null for a CUSTOM aggregator, which names accounts rather than a folder.
  folder() alicloud.resourceManager.folder
  // Time the aggregator was created
  createTime time
  // Tags applied to the aggregator
  tags map[string]string
}

// Cloud Config rule evaluation result
//
// The outcome of one Config rule examining one resource. Reports the compliance
// verdict, the annotation naming what failed, the rule and compliance pack that
// produced it, and when the resource last failed and was last brought back into
// compliance. Where rules describes the checks that exist, this describes what
// they actually found.
alicloud.config.evaluationResult @defaults("resourceName resourceType complianceType riskLevel") {
  // Config rule that produced the result
  configRule() alicloud.config.rule
  // Compliance pack the rule was evaluated under
  //
  // Null when the rule does not belong to a pack.
  compliancePack() alicloud.config.compliancePack
  // Compliance verdict
  //
  // One of COMPLIANT, NON_COMPLIANT, NOT_APPLICABLE, INSUFFICIENT_DATA, or
  // IGNORED.
  complianceType string
  // Explanation of the verdict
  //
  // Names the setting that failed, such as the ports a security group leaves
  // open. Empty for a compliant resource.
  annotation string
  // Risk level of the rule that produced the result
  //
  // One of 1 (high), 2 (medium), or 3 (low).
  riskLevel int
  // Whether a remediation is configured for the rule
  //
  // False means a failing resource stays failing until someone acts on it.
  remediationEnabled bool
  // ID of the evaluated resource
  resourceId string
  // Name of the evaluated resource
  resourceName string
  // Type of the evaluated resource
  //
  // An Alibaba Cloud resource type such as ACS::ECS::Instance.
  resourceType string
  // Region the evaluated resource lives in
  regionId string
  // Resource group the evaluated resource belongs to
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the rule last evaluated the resource
  invokedTime time
  // Time the result was recorded
  resultRecordedTime time
  // Time the resource was last recorded as non-compliant
  lastNonCompliantTime time
  // Time the resource was last brought back into compliance
  lastCompliantFixedTime time
  // Date the result was set to be ignored
  //
  // Formatted as yyyy-MM-dd. Empty unless the result has been ignored, which
  // suppresses it from the compliance summary without fixing the resource.
  ignoreDate string
}

// Alibaba Cloud Resource Directory
//
// Multi-account governance structure for an Alibaba Cloud account. Exposes the
// resource directory (the organization), the management and member accounts it
// contains, the folder hierarchy that groups them, and the control policies
// available to restrict member-account permissions. Use it to audit
// organization membership and whether control policies are enabled.
alicloud.resourceManager {
  // Resource directory (organization) ID
  resourceDirectoryId() string
  // Root folder ID of the resource directory
  rootFolderId() string
  // Management (master) account ID
  masterAccountId() string
  // Management (master) account name
  masterAccountName() string
  // Member-account deletion state
  //
  // Enabled when member accounts may be deleted from the directory.
  memberDeletionStatus() string
  // Control-policy enablement state
  //
  // Enabled when control policies may be attached to restrict member-account
  // permissions.
  controlPolicyStatus() string
  // Time the resource directory was created
  createTime() time
  // Member and management accounts in the resource directory
  accounts() []alicloud.resourceManager.account
  // Folders in the resource directory
  folders() []alicloud.resourceManager.folder
  // Control policies in the resource directory, both system and custom
  controlPolicies() []alicloud.resourceManager.controlPolicy
  // Resource groups in the account
  resourceGroups() []alicloud.resourceManager.resourceGroup
}

// Resource Directory account
//
// A single member or management account in the resource directory, keyed by
// accountId. Exposes the account profile, its position in the folder hierarchy,
// how it joined the directory, and its lifecycle timestamps.
alicloud.resourceManager.account {
  // Account (UID)
  accountId string
  // Display name of the account
  displayName string
  // Account status, for example CreateSuccess or InviteSuccess
  status string
  // Account type
  //
  // ResourceAccount for an account created in the directory, or CloudAccount
  // for an existing account invited into it.
  type string
  // ID of the folder that contains the account
  folderId string
  // Resource directory (organization) ID
  resourceDirectoryId string
  // How the account joined the directory
  //
  // Either created or invited.
  joinMethod string
  // Time the account joined the directory
  joinTime time
  // Time the account was last modified
  modifyTime time
  // Folder that contains the account
  folder() alicloud.resourceManager.folder
}

// Resource Directory folder
//
// A single folder in the resource directory hierarchy, keyed by folderId. A
// folder groups member accounts and can nest other folders. Exposes the folder
// name, its parent, and creation time.
alicloud.resourceManager.folder {
  // Folder ID, used as the lookup key
  folderId string
  // Folder name
  folderName string
  // ID of the parent folder, empty for the root folder
  //
  // Deprecated in favor of parentFolder.
  parentFolderId @maturity("deprecated") @replaced_by("alicloud.resourceManager.folder.parentFolder") string
  // Parent folder in the resource directory hierarchy
  //
  // Null on the root folder, which has no parent.
  parentFolder() alicloud.resourceManager.folder
  // Time the folder was created
  createTime time
}

// Resource group
//
// A single resource group in an Alibaba Cloud account, keyed by
// resourceGroupId, for example
// `alicloud.resourceManager.resourceGroups.where(name == "production")`. A
// resource group is the ownership and billing boundary that most Alibaba Cloud
// resources are placed into, and RAM policies are commonly scoped to one.
// Exposes the group identifier, its display name, lifecycle status, owning
// account, and tags. Resources across the provider reach their group through a
// resourceGroup field, so an audit can select or exclude an environment by
// group rather than by an opaque identifier.
alicloud.resourceManager.resourceGroup @defaults("resourceGroupId name displayName status") {
  // Resource group ID, used as the lookup key
  resourceGroupId string
  // Unique identifier of the resource group within the account
  name string
  // Display name of the resource group
  displayName string
  // ID of the account that owns the resource group
  accountId string
  // Lifecycle status
  //
  // One of Creating, OK, PendingDelete, or Deleting.
  status string
  // Time the resource group was created
  createDate time
  // Tags applied to the resource group
  tags map[string]string
}

// Resource Directory control policy
//
// A single control policy in the resource directory, keyed by policyId. A
// control policy sets the maximum permissions available to the accounts and
// folders it is attached to. Exposes the policy metadata and how many entities
// it is attached to.
alicloud.resourceManager.controlPolicy {
  // Policy ID, used as the lookup key
  policyId string
  // Policy name
  policyName string
  // Policy type
  //
  // Either System for an Alibaba Cloud-managed policy or Custom for a
  // user-defined one.
  policyType string
  // Description of the policy
  description string
  // Identity types the policy governs, for example RAM
  effectScope string
  // Number of accounts and folders the policy is attached to
  attachmentCount int
  // Time the policy was created
  createDate time
  // Time the policy was last updated
  updateDate time
}

// Alibaba Cloud Container Service for Kubernetes
//
// ACK clusters across an Alibaba Cloud account. Exposes the Kubernetes clusters
// in every enabled region, including their type and version, network layout,
// API server exposure, control-plane audit logging, workload-identity (RRSA)
// settings, node pools, and installed addons. Use it to audit whether a
// cluster's API server is reachable from the internet and whether audit logging
// is enabled.
alicloud.cs {
  // Kubernetes clusters across all enabled regions
  clusters() []alicloud.cs.cluster
  // Cluster access grants held by the account's RAM users and roles
  //
  // Every grant in the account, across all clusters. Container Service reports
  // grants per principal rather than per cluster, so reading these costs one
  // call for each RAM user and each RAM role in the account. A credential that
  // is itself a RAM user or role only sees the clusters it administers, so the
  // result can be incomplete for anything other than the account owner.
  grants() []alicloud.cs.grant
}

// Container Service cluster access grant
//
// A single cluster access grant held by a RAM user or role, keyed by the
// principal together with the scope and role it confers. Exposes what the grant
// covers (one cluster, one namespace of a cluster, or every cluster in the
// account), which preset role it confers, and whether it is the cluster
// creator's implicit administrator right. This is the answer to who can reach a
// cluster's API server and with what rights, which cluster settings alone do not
// show.
alicloud.cs.grant @defaults("principalName roleType resourceType resourceId") {
  // ID of the RAM user or role holding the grant
  uid string
  // Name of the RAM user or role holding the grant
  principalName string
  // Whether the grant is held by a RAM role rather than a RAM user
  ramRole bool
  // Scope the grant applies at
  //
  // One of cluster (a single cluster), namespace (one namespace of a single
  // cluster), or console (every cluster in the account).
  resourceType string
  // Resource the grant applies to
  //
  // The cluster ID for a cluster-scoped grant, clusterId/namespace for a
  // namespace-scoped grant, or all-clusters for a grant covering every cluster
  // in the account.
  resourceId string
  // Preset role the grant confers
  //
  // One of admin (administrator), ops (operations), dev (developer),
  // restricted (limited), or custom, where the rights come from the cluster
  // role named by roleName instead.
  roleType string
  // Name of the custom cluster role the grant confers
  //
  // Empty unless roleType is custom.
  roleName string
  // Whether the grant is the cluster creator's implicit administrator right
  //
  // A creator grant is not one somebody assigned, so it does not appear in a
  // review of assigned permissions.
  owner bool
  // Cluster the grant applies to
  //
  // Null for a grant that covers every cluster rather than a named one, and
  // null when the named cluster can no longer be read.
  cluster() alicloud.cs.cluster
  // RAM user holding the grant
  //
  // Null when the grant is held by a RAM role.
  user() alicloud.ram.user
  // RAM role holding the grant
  //
  // Null when the grant is held by a RAM user.
  role() alicloud.ram.role
}

// Container Service for Kubernetes cluster
//
// A single ACK cluster, keyed by clusterId within its region. Exposes the
// cluster type and Kubernetes version, the VPC, vSwitches, and security group it
// runs in, the pod and service CIDRs, the public and intranet API server
// endpoints, and the derived internet-exposure of the API server. Node pools,
// installed addons, control-plane audit logging, and workload-identity (RRSA)
// settings are reached from here. For example
// alicloud.cs.cluster(clusterId: "c1a2b3", regionId: "cn-hangzhou").
alicloud.cs.cluster {
  // Region ID the cluster resides in, for example cn-hangzhou
  regionId string
  // Cluster ID, used as the lookup key within its region
  clusterId string
  // Cluster name
  name string
  // Cluster type
  //
  // One of Kubernetes (dedicated), ManagedKubernetes, Ask (serverless), or
  // ExternalKubernetes.
  clusterType string
  // Cluster profile, for example Default, Serverless, or Edge
  profile string
  // Managed-tier specification
  //
  // For example ack.pro.small or ack.standard. Empty for dedicated Kubernetes
  // clusters.
  clusterSpec string
  // Cluster lifecycle state
  //
  // For example running, initial, failed, or deleting.
  state string
  // Running Kubernetes version
  currentVersion string
  // Kubernetes version the cluster was created with
  initVersion string
  // Next Kubernetes version available for upgrade, empty when up to date
  nextVersion string
  // Pod CIDR block
  containerCidr string
  // Service CIDR block
  serviceCidr string
  // Node subnet CIDR block
  subnetCidr string
  // IP stack of the cluster
  //
  // One of ipv4, ipv6, or dual.
  ipStack string
  // kube-proxy mode, either iptables or ipvs
  proxyMode string
  // Cluster network mode, for example vpc or overlay
  networkMode string
  // Cluster local DNS domain, for example cluster.local
  clusterDomain string
  // Whether PrivateZone (private DNS) is enabled for the cluster
  privateZone bool
  // Whether deletion protection is enabled for the cluster
  deletionProtection bool
  // Total number of nodes in the cluster
  size int
  // ID of the resource group the cluster belongs to
  resourceGroupId string
  // Resource group that contains the cluster
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Zone ID the cluster's managed resources reside in
  zoneId string
  // Time zone configured for the cluster
  timezone string
  // Public (internet) API server endpoint
  //
  // The internet-facing Kubernetes API server URL. Empty when the API server
  // has no public endpoint.
  apiServerPublicEndpoint string
  // Intranet (private) API server endpoint
  apiServerIntranetEndpoint string
  // Whether the Kubernetes API server is reachable from the internet
  //
  // True when the cluster exposes a public API server endpoint. A publicly
  // reachable API server broadens the attack surface of the control plane.
  apiServerInternetExposed bool
  // Time the cluster was created
  created time
  // Time the cluster was last updated
  updated time
  // Tags applied to the cluster
  tags map[string]string
  // Maintenance window configuration
  //
  // The scheduled maintenance window, with enable, duration, maintenanceTime,
  // recurrence, and weeklyPeriod. Null when no window is configured.
  maintenanceWindow dict
  // VPC the cluster runs in
  vpc() alicloud.vpc.network
  // vSwitches the cluster's control plane and nodes attach to
  vswitches() []alicloud.vpc.vswitch
  // Security group applied to the cluster nodes
  securityGroup() alicloud.ecs.securitygroup
  // Worker node RAM role, null when the cluster has no worker RAM role
  workerRamRole() alicloud.ram.role
  // Whether RAM Roles for Service Accounts (RRSA) workload identity is enabled
  //
  // True when the cluster issues OIDC tokens for pod-level RAM authorization
  // instead of relying on the shared worker node role.
  rrsaEnabled() bool
  // OIDC issuer URL for workload identity, empty when RRSA is disabled
  oidcIssuerUrl() string
  // Whether Kubernetes API server audit logging is enabled
  //
  // Deprecated in favor of alicloud.cs.cluster.apiServerAuditEnabled. This
  // reports whether control-plane log collection lists a component named audit,
  // which is not one of the components ACK collects.
  auditLogEnabled() @maturity("deprecated") @replaced_by("alicloud.cs.cluster.apiServerAuditEnabled") bool
  // Whether Kubernetes API server audit logging is enabled
  //
  // True when cluster auditing records API server activity to Log Service. Null
  // when the cluster auditing configuration does not report the setting.
  apiServerAuditEnabled() bool
  // Log Service project that receives the API server audit logs
  //
  // Null when cluster auditing is not configured.
  apiServerAuditLogProject() alicloud.log.project
  // Control-plane components shipping logs to Log Service
  //
  // For example kube-apiserver, kube-controller-manager, kube-scheduler, ccm
  // (cloud-controller-manager), or controlplane-events. Empty when control-plane
  // logging is off. API server audit logs are a separate feature, reported by
  // apiServerAuditEnabled.
  controlPlaneLogComponents() []string
  // Retention in days of the control-plane logs, 0 when logging is disabled
  controlPlaneLogTtl() int
  // Log Service project that receives the control-plane logs
  //
  // Null when control-plane logging is not configured.
  controlPlaneLogProject() alicloud.log.project
  // Node pools in the cluster
  nodePools() []alicloud.cs.nodePool
  // Addons installed in the cluster
  //
  // Each entry lists the name, version, and state of an installed addon, for
  // example security-inspector, logtail-ds, terway-eniip, or csi-plugin. Use it
  // to audit which security and observability addons are present.
  addons() []dict
  // Cluster access grants that reach this cluster
  //
  // The grants naming this cluster or a namespace within it, together with the
  // account-wide grants that cover every cluster. Shares one sweep with the
  // grants on the parent service, so reading it for a second cluster costs no
  // further calls.
  grants() []alicloud.cs.grant
  // Cluster inspection runs
  //
  // The cluster check runs recorded for the cluster, most recent first. Each
  // carries when it ran and how it finished, so a cluster that has never been
  // inspected reports an empty list and one whose last run is old is visible
  // from finishedAt.
  checks() []alicloud.cs.cluster.check
}

// Container Service cluster inspection run
//
// A single cluster check run, keyed by checkId. Exposes the kind of check, how
// it finished, and when it started and completed.
alicloud.cs.cluster.check @defaults("type status finishedAt") {
  // Check run ID, used as the lookup key
  checkId string
  // Kind of check that ran, for example ClusterUpgrade or NodePoolUpgrade
  type string
  // Outcome of the run, for example Succeeded, Failed, or Running
  status string
  // Status message the run reported
  message string
  // Time the run was created
  createdAt time
  // Time the run completed
  //
  // Null while the run is still in progress.
  finishedAt time
}

// Container Service for Kubernetes node pool
//
// A single node pool within an ACK cluster, keyed by nodePoolId. Exposes the
// node instance configuration, scaling and management policy, OS hardening
// flags, disk encryption, and the typed references to the security groups,
// vSwitches, RAM role, and KMS key the nodes use. Use it to audit node disk
// encryption, OS hardening, and automatic CVE patching.
alicloud.cs.nodePool {
  // Region ID the node pool resides in
  regionId string
  // ID of the cluster the node pool belongs to
  //
  // A node pool ID is unique only within its cluster, so both are needed to
  // identify a node pool.
  clusterId string
  // Cluster the node pool belongs to
  cluster() alicloud.cs.cluster
  // Node pool ID, used as the lookup key
  nodePoolId string
  // Node pool name
  name string
  // Node pool type, for example ess or edge
  type string
  // ID of the resource group the node pool belongs to
  resourceGroupId string
  // Resource group that contains the node pool
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Whether this is the cluster's default node pool
  isDefault bool
  // Time the node pool was created
  created time
  // Time the node pool was last updated
  updated time
  // ECS instance types used for nodes
  instanceTypes []string
  // System disk category, for example cloud_essd
  systemDiskCategory string
  // System disk size in GiB
  systemDiskSize int
  // Whether the system disk is encrypted
  systemDiskEncrypted bool
  // System disk encryption algorithm, for example aes-256 or sm4
  systemDiskEncryptAlgorithm string
  // Key pair name used for node SSH access, empty when password or managed login is used
  keyPair string
  // Image type used for nodes, for example AliyunLinux or ContainerOS
  imageType string
  // ID of the image used for nodes
  imageId string
  // Image the node pool launches nodes from
  //
  // Null on a node pool that names no image, and on one whose image is not
  // visible to the account, for example a public image that has been retired.
  image() alicloud.ecs.image
  // Node billing method
  //
  // Either PrePaid (subscription) or PostPaid (pay-as-you-go).
  instanceChargeType string
  // Desired number of nodes in the pool
  desiredSize int
  // Multi-zone scaling policy, for example PRIORITY, COST_OPTIMIZED, or BALANCE
  multiAzPolicy string
  // Spot instance strategy
  //
  // One of NoSpot, SpotWithPriceLimit, or SpotAsPriceGo.
  spotStrategy string
  // Whether OS security hardening is applied to nodes
  securityHardeningOs bool
  // Whether MLPS (Multi-Level Protection Scheme) compliance hardening is enabled
  socEnabled bool
  // Whether CIS benchmark hardening is enabled for nodes
  cisEnabled bool
  // Maximum outbound internet bandwidth in Mbps assigned to nodes, 0 when nodes have no public bandwidth
  internetMaxBandwidthOut int
  // Data disks attached to nodes
  //
  // Each entry lists the category, size, encrypted, kmsKeyId, performanceLevel,
  // and autoSnapshotPolicyId of a data disk.
  dataDisks []dict
  // Container runtime, for example containerd or docker
  runtime string
  // Container runtime version
  runtimeVersion string
  // Whether the CloudMonitor agent is installed on nodes
  cmsEnabled bool
  // CPU management policy, either none or static
  cpuPolicy string
  // Whether nodes are marked unschedulable
  unschedulable bool
  // Kubernetes labels applied to nodes
  labels map[string]string
  // Kubernetes taints applied to nodes
  //
  // Each entry lists the key, value, and effect (NoSchedule, PreferNoSchedule,
  // or NoExecute) of a node taint.
  taints []dict
  // Whether autoscaling is enabled for the node pool
  autoScalingEnabled bool
  // Autoscaling type, for example cpu, gpu, or spot
  autoScalingType string
  // Minimum number of nodes when autoscaling is enabled
  minInstances int
  // Maximum number of nodes when autoscaling is enabled
  maxInstances int
  // Whether the node pool is managed (control-plane operated)
  managed bool
  // Whether managed nodes are automatically repaired
  autoRepair bool
  // Whether managed nodes are automatically upgraded
  autoUpgrade bool
  // Whether managed nodes automatically receive CVE fixes
  autoVulFix bool
  // Whether trusted (confidential) computing is enabled for nodes
  teeEnabled bool
  // Total number of nodes in the pool
  totalNodes int
  // Number of nodes serving workloads
  servingNodes int
  // Number of healthy nodes
  healthyNodes int
  // Number of failed nodes
  failedNodes int
  // Node pool state, for example active or scaling
  nodePoolState string
  // KMS key used to encrypt the system disk, null when the system disk is not encrypted
  systemDiskKmsKey() alicloud.kms.key
  // Security groups applied to the nodes
  securityGroups() []alicloud.ecs.securitygroup
  // vSwitches the nodes attach to
  vswitches() []alicloud.vpc.vswitch
  // RAM role assigned to the nodes, null when the node pool has no RAM role
  ramRole() alicloud.ram.role
}

// Alibaba Cloud Application Load Balancer
//
// ALB (Layer-7) load balancers across an Alibaba Cloud account. Exposes the
// application load balancers in every enabled region, along with their
// listeners and server groups. Use it to audit which load balancers are
// internet-facing, whether HTTPS listeners use a strong TLS policy, and whether
// access logging is enabled.
alicloud.alb {
  // Application load balancers across all enabled regions
  loadBalancers() []alicloud.alb.loadBalancer
  // ALB server groups across all enabled regions
  serverGroups() []alicloud.alb.serverGroup
  // Custom TLS security policies across all enabled regions
  //
  // A security policy fixes the TLS versions and cipher suites a listener
  // accepts. Only custom policies are listed; a listener using one of the
  // built-in policies names it by id and has no entry here.
  securityPolicies() []alicloud.alb.securityPolicy
}

// Application Load Balancer TLS security policy
//
// A custom TLS security policy, keyed by securityPolicyId within its region.
// Exposes the TLS versions and cipher suites the policy permits. Use it to find
// a listener that still accepts TLS 1.0 or 1.1.
alicloud.alb.securityPolicy @defaults("securityPolicyName tlsVersions status") {
  // Region ID the policy resides in, for example cn-hangzhou
  regionId string
  // Security policy ID, used as the lookup key within its region
  securityPolicyId string
  // Name of the security policy
  securityPolicyName string
  // Lifecycle status of the policy, for example Available or Configuring
  status string
  // TLS versions the policy accepts, for example TLSv1.2 and TLSv1.3
  tlsVersions []string
  // Cipher suites the policy permits
  ciphers []string
  // Whether the policy still accepts TLS 1.0 or TLS 1.1
  //
  // Both versions are deprecated and carry known weaknesses, so a listener
  // bound to such a policy accepts connections that a current client would
  // refuse to make.
  allowsLegacyTls bool
  // ID of the resource group the policy belongs to
  resourceGroupId string
  // Resource group that contains the policy
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the policy
  tags map[string]string
}

// Application Load Balancer instance
//
// A single ALB load balancer, keyed by loadBalancerId within its region.
// Exposes the address type and the derived internet-facing state, the VPC and
// security groups it runs in, its access-logging configuration, and its
// listeners. Use it to audit public exposure and access logging. For example
// alicloud.alb.loadBalancer(loadBalancerId: "alb-xxx", regionId: "cn-hangzhou").
alicloud.alb.loadBalancer {
  // Region ID the load balancer resides in, for example cn-hangzhou
  regionId string
  // Load balancer ID, used as the lookup key within its region
  loadBalancerId string
  // Load balancer name
  name string
  // Load balancer status
  //
  // For example Active, Inactive, Provisioning, or Configuring.
  status string
  // Address type
  //
  // Either Internet (internet-facing) or Intranet (internal only).
  addressType string
  // Address allocation mode, either Fixed or Dynamic
  addressAllocatedMode string
  // IP version of the address, either IPv4 or DualStack
  addressIpVersion string
  // IPv6 address type, either Internet or Intranet
  ipv6AddressType string
  // DNS name assigned to the load balancer
  dnsName string
  // Load balancer edition, one of Basic, Standard, or StandardWithWaf
  edition string
  // Business (billing) status of the load balancer, for example Normal
  businessStatus string
  // ID of the bandwidth package bound to the load balancer, empty when none
  bandwidthPackageId string
  // ID of the resource group the load balancer belongs to
  resourceGroupId string
  // Resource group that contains the load balancer
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the load balancer was created
  createTime time
  // Whether deletion protection is enabled
  deletionProtectionEnabled bool
  // Modification-protection status, either NonProtection or ConsoleProtection
  modificationProtectionStatus string
  // Whether access logging to Log Service is enabled
  //
  // True when the load balancer delivers access logs to a Log Service project
  // and logstore. When false, request-level access logs are not retained.
  accessLoggingEnabled bool
  // Tags applied to the load balancer
  tags map[string]string
  // Whether the load balancer serves traffic from the public internet
  //
  // True when the address type is Internet. An internet-facing load balancer is
  // reachable from outside the VPC.
  internetFacing() bool
  // VPC the load balancer runs in
  vpc() alicloud.vpc.network
  // Security groups applied to the load balancer
  securityGroups() []alicloud.ecs.securitygroup
  // vSwitches the load balancer attaches to across its zones
  vswitches() []alicloud.vpc.vswitch
  // Log Service project that receives access logs, null when access logging is disabled
  accessLogProject() alicloud.log.project
  // Log Service logstore that receives access logs, null when access logging is disabled
  accessLogStore() alicloud.log.logstore
  // Listeners configured on the load balancer
  listeners() []alicloud.alb.listener
}

// Application Load Balancer listener
//
// A single listener on an ALB load balancer, keyed by listenerId. Exposes the
// protocol and port it serves, the TLS security policy for HTTPS/QUIC
// listeners, and the server groups it forwards to. Use it to audit whether an
// HTTPS listener enforces a strong TLS policy and presents certificates.
alicloud.alb.listener {
  // Region ID the listener resides in
  regionId string
  // Listener ID, used as the lookup key
  listenerId string
  // ID of the load balancer the listener belongs to
  //
  // Deprecated in favor of loadBalancer.
  loadBalancerId @maturity("deprecated") @replaced_by("alicloud.alb.listener.loadBalancer") string
  // Load balancer the listener belongs to
  loadBalancer() alicloud.alb.loadBalancer
  // Listener protocol, one of HTTP, HTTPS, or QUIC
  protocol string
  // Port the listener serves on
  port int
  // Listener status, for example Running, Configuring, or Stopped
  status string
  // Description of the listener
  description string
  // TLS security policy applied to the listener, empty for non-TLS listeners
  securityPolicyId string
  // TLS security policy applied to the listener
  //
  // Null for a non-TLS listener and for a listener using one of the built-in
  // policies, which are not enumerable; securityPolicyId names those.
  securityPolicy() alicloud.alb.securityPolicy
  // Whether HTTP/2 is enabled
  http2Enabled bool
  // Whether response gzip compression is enabled
  gzipEnabled bool
  // Idle connection timeout in seconds
  idleTimeout int
  // Request timeout in seconds
  requestTimeout int
  // Tags applied to the listener
  tags map[string]string
  // Server certificate IDs presented by the listener
  //
  // Empty for non-TLS listeners. A populated list confirms the HTTPS/QUIC
  // listener presents a server certificate.
  certificateIds() []string
  // Whether mutual TLS (client certificate authentication) is enabled
  mutualTlsEnabled() bool
  // Server groups the listener forwards requests to
  serverGroups() []alicloud.alb.serverGroup
}

// Application Load Balancer server group
//
// A single ALB server group, keyed by serverGroupId within its region. A server
// group is a set of backends that listeners forward requests to. Exposes the
// backend protocol, scheduling algorithm, health-check configuration, and the
// VPC the group belongs to.
alicloud.alb.serverGroup {
  // Region ID the server group resides in
  regionId string
  // Server group ID, used as the lookup key within its region
  serverGroupId string
  // Server group name
  name string
  // Server group type, one of Instance, Ip, or Fc
  type string
  // Server group status
  status string
  // Backend protocol, one of HTTP, HTTPS, or gRPC
  protocol string
  // Scheduling algorithm, one of Wrr, Wlc, or Sch
  scheduler string
  // Number of backend servers in the group
  serverCount int
  // ID of the resource group the server group belongs to
  resourceGroupId string
  // Resource group that contains the server group
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the server group was created
  createTime time
  // Whether cross-zone load balancing is enabled
  crossZoneEnabled bool
  // Whether health checks are enabled for the group
  healthCheckEnabled bool
  // Health-check protocol, one of HTTP, HTTPS, TCP, or gRPC
  healthCheckProtocol string
  // Health-check request path, for HTTP health checks
  healthCheckPath string
  // Whether session stickiness is enabled
  stickySessionEnabled bool
  // Session stickiness type, either Insert or Server
  stickySessionType string
  // Servers in the group
  //
  // What the load balancer forwards to. An internet-facing ALB makes every one
  // of these reachable from the public internet on the listener's port.
  servers() []alicloud.alb.serverGroup.server
  // Tags applied to the server group
  tags map[string]string
  // VPC the server group belongs to
  vpc() alicloud.vpc.network
}

// ALB backend server
//
// One server an ALB server group forwards requests to. The serverType decides
// what serverId names, and the ECS case is the one that reaches an instance
// whose own security groups may say nothing about the load balancer's address.
alicloud.alb.serverGroup.server @defaults("serverType serverId serverIp port weight") {
  // ID of the backend server
  //
  // An ECS instance ID, an elastic network interface ID, an IP address, or a
  // Function Compute function, depending on serverType.
  serverId string
  // Kind of backend
  //
  // One of Ecs, Eni, Eci, Ip, or Fc.
  serverType string
  // IP address the load balancer forwards to
  serverIp string
  // Port the load balancer forwards to
  port int
  // Share of traffic the server receives
  //
  // A weight of 0 takes the server out of rotation without detaching it.
  weight int
  // Backend server status
  status string
  // Whether the client IP is preserved to the backend
  //
  // False means the backend sees the load balancer's address instead of the
  // caller's, which affects any allowlist or log the backend keeps.
  remoteIpEnabled bool
  // Backend server description
  description string
  // ECS instance behind the backend
  //
  // Null unless serverType is Ecs, or when the instance can no longer be read.
  ecsInstance() alicloud.ecs.instance
}

// Alibaba Cloud Network Load Balancer
//
// NLB (Layer-4) load balancers across an Alibaba Cloud account. Exposes the
// network load balancers in every enabled region, along with their listeners
// and server groups. Use it to audit which load balancers are internet-facing,
// whether security groups are applied, and whether TCPSSL listeners use a strong
// TLS policy.
alicloud.nlb {
  // Network load balancers across all enabled regions
  loadBalancers() []alicloud.nlb.loadBalancer
  // NLB server groups across all enabled regions
  serverGroups() []alicloud.nlb.serverGroup
  // Custom TLS security policies across all enabled regions
  //
  // A security policy fixes the TLS versions and cipher suites a TCPSSL
  // listener accepts. Only custom policies are listed; a listener using one of
  // the built-in policies names it by id and has no entry here.
  securityPolicies() []alicloud.nlb.securityPolicy
}

// Network Load Balancer TLS security policy
//
// A custom TLS security policy, keyed by securityPolicyId within its region.
// Exposes the TLS versions and cipher suites the policy permits on a TCPSSL
// listener. Use it to find a listener that still accepts TLS 1.0 or 1.1.
alicloud.nlb.securityPolicy @defaults("securityPolicyName tlsVersions status") {
  // Region ID the policy resides in, for example cn-hangzhou
  regionId string
  // Security policy ID, used as the lookup key within its region
  securityPolicyId string
  // Name of the security policy
  securityPolicyName string
  // Lifecycle status of the policy, for example Available or Configuring
  status string
  // TLS versions the policy accepts, for example TLSv1.2 and TLSv1.3
  tlsVersions []string
  // Cipher suites the policy permits
  ciphers []string
  // Whether the policy still accepts TLS 1.0 or TLS 1.1
  //
  // Both versions are deprecated and carry known weaknesses, so a listener
  // bound to such a policy accepts connections that a current client would
  // refuse to make.
  allowsLegacyTls bool
  // ID of the resource group the policy belongs to
  resourceGroupId string
  // Resource group that contains the policy
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the policy
  tags map[string]string
}

// Network Load Balancer instance
//
// A single NLB load balancer, keyed by loadBalancerId within its region.
// Exposes the address type and the derived internet-facing state, the VPC,
// vSwitches, and security groups it runs in, and its listeners. Unlike an ALB,
// an NLB can enforce security groups directly. For example
// alicloud.nlb.loadBalancer(loadBalancerId: "nlb-xxx", regionId: "cn-hangzhou").
alicloud.nlb.loadBalancer {
  // Region ID the load balancer resides in, for example cn-hangzhou
  regionId string
  // Load balancer ID, used as the lookup key within its region
  loadBalancerId string
  // Load balancer name
  name string
  // Load balancer status
  //
  // For example Active, Inactive, Provisioning, or Configuring.
  status string
  // Load balancer type, always Network for NLB
  type string
  // Business (billing) status, either Normal or Abnormal
  businessStatus string
  // Address type
  //
  // Either Internet (internet-facing) or Intranet (internal only).
  addressType string
  // IP version of the address, either Ipv4 or DualStack
  addressIpVersion string
  // IPv6 address type, either Internet or Intranet
  ipv6AddressType string
  // DNS name assigned to the load balancer
  dnsName string
  // ID of the resource group the load balancer belongs to
  resourceGroupId string
  // Resource group that contains the load balancer
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the load balancer was created
  createTime time
  // ID of the bandwidth package bound to the load balancer, empty when none
  bandwidthPackageId string
  // Whether cross-zone load balancing is enabled
  crossZoneEnabled bool
  // Whether deletion protection is enabled
  deletionProtectionEnabled bool
  // Modification-protection status, either NonProtection or ConsoleProtection
  modificationProtectionStatus string
  // Tags applied to the load balancer
  tags map[string]string
  // Whether the load balancer serves traffic from the public internet
  //
  // True when the address type is Internet. An internet-facing load balancer is
  // reachable from outside the VPC.
  internetFacing() bool
  // VPC the load balancer runs in
  vpc() alicloud.vpc.network
  // Security groups applied to the load balancer
  //
  // NLB enforces these security groups on traffic to the load balancer. An
  // empty result means no security-group filtering is applied at the load
  // balancer.
  securityGroups() []alicloud.ecs.securitygroup
  // vSwitches the load balancer attaches to across its zones
  vswitches() []alicloud.vpc.vswitch
  // Listeners configured on the load balancer
  listeners() []alicloud.nlb.listener
}

// Network Load Balancer listener
//
// A single listener on an NLB load balancer, keyed by listenerId. Exposes the
// protocol and port it serves, the TLS security policy and certificates for
// TCPSSL listeners, and the server group it forwards to. Use it to audit
// whether a TCPSSL listener enforces a strong TLS policy.
alicloud.nlb.listener {
  // Region ID the listener resides in
  regionId string
  // Listener ID, used as the lookup key
  listenerId string
  // ID of the load balancer the listener belongs to
  //
  // Deprecated in favor of loadBalancer.
  loadBalancerId @maturity("deprecated") @replaced_by("alicloud.nlb.listener.loadBalancer") string
  // Load balancer the listener belongs to
  loadBalancer() alicloud.nlb.loadBalancer
  // Listener protocol, one of TCP, UDP, or TCPSSL
  protocol string
  // Port the listener serves on
  port int
  // Listener status, for example Running, Configuring, or Stopped
  status string
  // Description of the listener
  description string
  // TLS security policy applied to the listener, meaningful for TCPSSL listeners
  securityPolicyId string
  // TLS security policy applied to the listener
  //
  // Null for a non-TCPSSL listener and for a listener using one of the built-in
  // policies, which are not enumerable; securityPolicyId names those.
  securityPolicy() alicloud.nlb.securityPolicy
  // Server certificate IDs presented by a TCPSSL listener
  certificateIds []string
  // CA certificate IDs used for mutual TLS on a TCPSSL listener
  caCertificateIds []string
  // Whether mutual TLS (client certificate authentication) is enabled
  caEnabled bool
  // Idle connection timeout in seconds
  idleTimeout int
  // Whether the Proxy Protocol is enabled to pass client information to backends
  proxyProtocolEnabled bool
  // Whether ALPN is enabled
  alpnEnabled bool
  // ALPN policy applied when ALPN is enabled
  alpnPolicy string
  // Connections-per-second limit for the listener, 0 when unlimited
  cps int
  // Tags applied to the listener
  tags map[string]string
  // Server group the listener forwards traffic to
  serverGroup() alicloud.nlb.serverGroup
}

// Network Load Balancer server group
//
// A single NLB server group, keyed by serverGroupId within its region. A server
// group is a set of backends that listeners forward traffic to. Exposes the
// backend protocol, scheduling algorithm, client-IP preservation, health-check
// configuration, and the VPC the group belongs to.
alicloud.nlb.serverGroup {
  // Region ID the server group resides in
  regionId string
  // Server group ID, used as the lookup key within its region
  serverGroupId string
  // Server group name
  name string
  // Server group type, either Instance or Ip
  type string
  // Server group status
  status string
  // Backend protocol, one of TCP, UDP, TCP_UDP, or TCPSSL
  protocol string
  // Scheduling algorithm, for example Wrr, rr, sch, tch, or qch
  scheduler string
  // IP version of the backends, either Ipv4 or DualStack
  addressIpVersion string
  // Number of backend servers in the group
  serverCount int
  // Whether client source IP preservation is enabled
  preserveClientIpEnabled bool
  // Whether connection draining is enabled
  connectionDrainEnabled bool
  // Whether health checks are enabled for the group
  healthCheckEnabled bool
  // Health-check protocol, one of TCP, HTTP, or UDP
  healthCheckType string
  // Health-check connection port
  healthCheckConnectPort int
  // ID of the resource group the server group belongs to
  resourceGroupId string
  // Resource group that contains the server group
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Servers in the group
  //
  // What the load balancer forwards to. An internet-facing NLB makes every one
  // of these reachable from the public internet on the listener's port.
  servers() []alicloud.nlb.serverGroup.server
  // Tags applied to the server group
  tags map[string]string
  // VPC the server group belongs to
  vpc() alicloud.vpc.network
}

// NLB backend server
//
// One server an NLB server group forwards traffic to. The serverType decides
// what serverId names, and the ECS case is the one that reaches an instance
// whose own security groups may say nothing about the load balancer's address.
alicloud.nlb.serverGroup.server @defaults("serverType serverId serverIp port weight") {
  // ID of the backend server
  //
  // An ECS instance ID, an elastic network interface ID, or an IP address,
  // depending on serverType.
  serverId string
  // Kind of backend
  //
  // One of Ecs, Eni, Eci, or Ip.
  serverType string
  // IP address the load balancer forwards to
  serverIp string
  // Port the load balancer forwards to
  port int
  // Share of traffic the server receives
  //
  // A weight of 0 takes the server out of rotation without detaching it.
  weight int
  // Backend server status
  status string
  // Zone the backend server sits in
  zoneId string
  // Backend server description
  description string
  // ECS instance behind the backend
  //
  // Null unless serverType is Ecs, or when the instance can no longer be read.
  ecsInstance() alicloud.ecs.instance
}

// Alibaba Cloud Function Compute
//
// Function Compute (FC 3.0) functions across an Alibaba Cloud account. Exposes
// the serverless functions in every enabled region, along with their triggers.
// Use it to audit function execution roles, network placement, public egress
// and invocation, and whether environment variables might carry secrets.
alicloud.fc {
  // Functions across all enabled regions
  functions() []alicloud.fc.function
}

// Function Compute function
//
// A single FC 3.0 function, keyed by functionName within its region. Exposes the
// runtime and resource configuration, the execution RAM role, the VPC and log
// configuration, public network egress, environment variables, and the
// function's triggers. Use it to audit the function's privilege and network
// exposure. For example
// alicloud.fc.function(functionName: "my-fn", regionId: "cn-hangzhou").
alicloud.fc.function {
  // Region ID the function resides in, for example cn-hangzhou
  regionId string
  // Function name, used as the lookup key within its region
  functionName string
  // System-generated function ID
  functionId string
  // Alibaba Cloud Resource Name of the function
  arn string
  // Description of the function
  description string
  // Function runtime
  //
  // For example nodejs18, python3.10, go1, java11, php7.2, custom,
  // custom.debian10, or custom-container.
  runtime string
  // Request handler entry point, for example index.handler
  handler string
  // Maximum execution time in seconds
  timeout int
  // Memory allocated to the function in MB
  memorySize int
  // Ephemeral disk size in MB, either 512 or 10240
  diskSize int
  // vCPU cores allocated to the function
  cpu float
  // Function state, for example Active or Pending
  state string
  // Reason for the current state, empty when healthy
  stateReason string
  // Deployed code size in bytes
  codeSize int
  // CRC-64 checksum of the deployed code
  codeChecksum string
  // Time the function was created
  createdTime time
  // Time the function was last modified
  lastModifiedTime time
  // Whether the function has public internet egress
  //
  // True when the function may reach the public internet for outbound requests.
  internetAccess bool
  // Maximum number of concurrent requests handled by one instance
  instanceConcurrency int
  // ID of the resource group the function belongs to
  resourceGroupId string
  // Resource group that contains the function
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Environment variables configured on the function
  //
  // Audit these for plaintext secrets; values are returned as configured.
  environmentVariables map[string]string
  // Container image for a custom-container function, empty for other runtimes
  customContainerImage string
  // Name of the Log Service logstore that receives function logs
  logStore string
  // Tags applied to the function
  tags map[string]string
  // RAM role the function assumes when it runs
  //
  // Null when the function has no execution role. The role determines the
  // permissions the function code runs with.
  executionRole() alicloud.ram.role
  // VPC the function is attached to, null when the function has no VPC configuration
  vpc() alicloud.vpc.network
  // vSwitches the function's elastic network interfaces attach to
  vswitches() []alicloud.vpc.vswitch
  // Security group applied to the function's VPC elastic network interface
  securityGroup() alicloud.ecs.securitygroup
  // Log Service project that receives function logs, null when logging is not configured
  logProject() alicloud.log.project
  // Triggers configured on the function
  triggers() []alicloud.fc.trigger
}

// Function Compute trigger
//
// A single trigger on an FC function, keyed by the owning functionName and
// triggerName. Exposes the trigger type and event source, the public and
// intranet HTTP endpoints for HTTP triggers, and the RAM role the event source
// assumes to invoke the function. Use it to audit whether a function is
// invocable from the internet.
alicloud.fc.trigger {
  // Region ID the trigger resides in
  regionId string
  // Name of the function the trigger belongs to
  functionName string
  // Function the trigger belongs to
  function() alicloud.fc.function
  // Trigger name, used with the function name as the lookup key
  triggerName string
  // System-generated trigger ID
  triggerId string
  // Trigger type
  //
  // One of http, oss, timer, log, mns_topic, cdn_events, tablestore, or eventbridge.
  type string
  // ARN of the event source that fires the trigger
  sourceArn string
  // ARN of the invocation target
  targetArn string
  // Version or alias the trigger invokes
  qualifier string
  // Trigger status, for example OK or Disabled
  status string
  // Description of the trigger
  description string
  // Time the trigger was created
  createdTime time
  // Time the trigger was last modified
  lastModifiedTime time
  // Public HTTP endpoint for an http trigger
  //
  // Empty for non-http triggers or when the public URL is disabled. A non-empty
  // value means the function can be invoked over the internet.
  httpUrlInternet string
  // Intranet (VPC-only) HTTP endpoint for an http trigger
  httpUrlIntranet string
  // Type-specific trigger configuration
  //
  // Parsed from the trigger's config document; the shape varies by type, for
  // example authType and methods for an http trigger, or events for an oss
  // trigger.
  triggerConfig dict
  // Whether the function is invocable from the public internet through this trigger
  //
  // True when an http trigger exposes a public URL. Combine with the
  // triggerConfig authType to determine whether anonymous invocation is allowed.
  internetInvocable() bool
  // RAM role the event source assumes to invoke the function, null when none
  invocationRole() alicloud.ram.role
}

// Alibaba Cloud NAS file storage
//
// Apsara File Storage NAS file systems and access controls across an Alibaba
// Cloud account. Exposes the file systems in every enabled region, their mount
// targets, and the access groups and rules that govern which clients may mount
// them. Use it to audit whether file systems are encrypted and whether their
// exports are open to overly broad client ranges.
alicloud.nas {
  // NAS file systems across all enabled regions
  fileSystems() []alicloud.nas.fileSystem
  // NAS access groups across all enabled regions
  accessGroups() []alicloud.nas.accessGroup
}

// NAS file system
//
// A single NAS file system, keyed by fileSystemId within its region. Exposes the
// storage and protocol type, the encryption state and key, capacity and used
// size, and the mount targets that expose it to clients. Use it to audit
// encryption at rest and the network exposure of the mount targets. For example
// alicloud.nas.fileSystem(fileSystemId: "1a2b3c", regionId: "cn-hangzhou").
alicloud.nas.fileSystem {
  // Region ID the file system resides in, for example cn-hangzhou
  regionId string
  // File system ID, used as the lookup key within its region
  fileSystemId string
  // File system type, one of standard, extreme, cpfs, or cpfsse
  fileSystemType string
  // Access protocol, one of NFS, SMB, or cpfs
  protocolType string
  // Storage class, for example Performance, Capacity, standard, or advance
  storageType string
  // Description of the file system
  description string
  // Zone ID the file system resides in
  zoneId string
  // Provisioned capacity in GiB
  capacity int
  // Used (metered) size in bytes
  meteredSize int
  // File system status, for example Running, Pending, or Stopped
  status string
  // Billing method, either PayAsYouGo or Subscription
  chargeType string
  // Storage redundancy type, for example LRS
  redundancyType string
  // Server-side encryption type
  //
  // One of 0 (no encryption), 1 (NAS-managed service key), or 2 (a customer
  // master key from KMS).
  encryptType int
  // Whether the file system is encrypted at rest
  //
  // True when the encryption type is 1 or 2. When false, data is stored
  // unencrypted.
  encrypted bool
  // ID of the resource group the file system belongs to
  resourceGroupId string
  // Resource group that contains the file system
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the file system was created
  createTime time
  // Tags applied to the file system
  tags map[string]string
  // Customer master key used for encryption
  //
  // Null unless the encryption type is 2 (a specific KMS key). The NAS-managed
  // service key (type 1) is not a queryable KMS key.
  kmsKey() alicloud.kms.key
  // Mount targets that expose the file system to clients
  mountTargets() []alicloud.nas.mountTarget
}

// NAS mount target
//
// A single mount target of a NAS file system, keyed by mountTargetDomain. A
// mount target is the network endpoint clients mount, bound to a VPC and access
// group. Exposes the network placement and the access group that controls which
// clients may mount it. Use it to audit whether a file system is reachable from
// a classic (non-VPC) network.
alicloud.nas.mountTarget {
  // Region ID the mount target resides in
  regionId string
  // ID of the file system the mount target belongs to
  //
  // Deprecated in favor of fileSystem.
  fileSystemId @maturity("deprecated") @replaced_by("alicloud.nas.mountTarget.fileSystem") string
  // File system the mount target belongs to
  fileSystem() alicloud.nas.fileSystem
  // Mount target domain (the mount address), used as the lookup key
  mountTargetDomain string
  // Mount target status, for example Active or Inactive
  status string
  // Network type
  //
  // Either Vpc (isolated to a VPC) or Classic (the legacy shared network).
  networkType string
  // Name of the access group that controls which clients may mount the target
  accessGroupName string
  // VPC the mount target is attached to, null for a classic-network mount target
  vpc() alicloud.vpc.network
  // vSwitch the mount target attaches to, null for a classic-network mount target
  vswitch() alicloud.vpc.vswitch
  // Access group that controls which clients may mount the target
  accessGroup() alicloud.nas.accessGroup
}

// NAS access group
//
// A single NAS access group, keyed by accessGroupName within its region. An
// access group is a named set of access rules that govern which client IP
// ranges may mount the file systems bound to it. Exposes the group metadata and
// its access rules. Use it to audit the client ranges permitted to mount.
alicloud.nas.accessGroup {
  // Region ID the access group resides in
  regionId string
  // Access group name, used as the lookup key within its region
  accessGroupName string
  // Access group network type, either Vpc or Classic
  accessGroupType string
  // File system type the access group applies to
  fileSystemType string
  // Number of access rules in the group
  ruleCount int
  // Number of mount targets bound to the group
  mountTargetCount int
  // Description of the access group
  description string
  // Time the access group was created
  createTime time
  // Access rules that govern which clients may mount
  accessRules() []alicloud.nas.accessRule
}

// NAS access rule
//
// A single access rule within a NAS access group, keyed by accessRuleId. A rule
// permits a client IP range to mount with a given read/write and user-squash
// policy. Exposes the allowed CIDR, access mode, and squash setting. Use it to
// find rules that open a file system to broad client ranges or disable root
// squashing.
alicloud.nas.accessRule {
  // Region ID the access rule resides in
  regionId string
  // Name of the access group the rule belongs to
  accessGroupName string
  // Access rule ID, used as the lookup key
  accessRuleId string
  // Allowed IPv4 client CIDR
  //
  // The client address range permitted to mount. 0.0.0.0/0 permits every IPv4
  // client.
  sourceCidrIp string
  // Allowed IPv6 client CIDR, empty when no IPv6 rule is set
  //
  // The IPv6 client range permitted to mount. ::/0 permits every IPv6 client.
  ipv6SourceCidrIp string
  // Read/write access granted, either RDWR (read-write) or RDONLY (read-only)
  rwAccess string
  // Root-squash policy
  //
  // One of no_squash (root is not squashed), root_squash (root maps to an
  // anonymous user), or all_squash (every user maps to anonymous). no_squash
  // gives mounting clients full root access to the file system.
  userAccess string
  // Rule priority, 1 (highest) to 100 (lowest)
  priority int
}

// Alibaba Cloud Web Application Firewall
//
// WAF 3.0 instances and the resources they protect for an Alibaba Cloud account.
// WAF is a center service with one instance per account in each of the China and
// international centers. Exposes the instance edition and subscription state,
// the protected objects (domains and cloud-native resources), and the CNAME
// domains with their TLS configuration. Use it to audit which web assets are
// behind WAF and whether their listeners terminate TLS.
alicloud.waf {
  // WAF instances across the China and international centers
  instances() []alicloud.waf.instance
}

// Web Application Firewall instance
//
// A single WAF 3.0 instance, keyed by instanceId. WAF provisions one instance
// per account per center. Exposes the edition, subscription window, and status,
// and is the parent of the protected resources and domains. Use it to confirm
// WAF is provisioned and not expired.
alicloud.waf.instance {
  // Center region the instance belongs to, either cn-hangzhou or ap-southeast-1
  regionId string
  // WAF instance ID, used as the lookup key
  instanceId string
  // Instance status
  //
  // 1 (Normal), 2 (Expired), or 3 (Released). Only a Normal instance is
  // actively protecting traffic.
  status int
  // Instance edition or plan
  edition string
  // Billing method, for example POSTPAY or SUBSCRIPTION
  payType string
  // Whether the instance is in debt (overdue payment)
  inDebt string
  // Start of the subscription window
  startTime time
  // End of the subscription window
  endTime time
  // Protected objects (domains and cloud-native resources) behind the instance
  defenseResources() []alicloud.waf.defenseResource
  // CNAME-access domains protected by the instance
  domains() []alicloud.waf.domain
  // Protection templates configured on the instance
  //
  // A template groups the rules for one protection scene (basic protection,
  // HTTP flood protection, custom rules, and the rest) and carries its own
  // enabled flag. An instance can have every template switched off while still
  // reporting protected objects, so enumerate these to tell an onboarded asset
  // from a defended one.
  defenseTemplates() []alicloud.waf.defenseTemplate
  // Whether the instance is delivering its logs to Log Service
  //
  // True only while logStatus reports normal. A failed initialization and an
  // in-progress release both leave the instance protecting traffic while
  // recording nothing about it.
  logDeliveryEnabled() bool
  // State of Log Service log delivery for the instance
  //
  // One of initializing, initialize_failed, normal, releasing, or
  // release_failed. Empty when log delivery has never been configured.
  logStatus() string
  // Region the instance delivers its logs to
  //
  // Empty when log delivery has never been configured.
  logRegionId() string
}

// Web Application Firewall protected resource
//
// A single protected object of a WAF instance, keyed by the owning instanceId
// and resource name. A protected object is a CNAME domain or an attached
// cloud-native resource (ALB, CLB, MSE). Exposes the backing product, protection
// mode, and provisioning health. Use it to enumerate what WAF is protecting and
// whether protection is active.
alicloud.waf.defenseResource {
  // Center region the resource belongs to
  regionId string
  // ID of the WAF instance protecting the resource
  instanceId string
  // Protected object name, for example a domain or a cloud resource id
  resource string
  // Cloud service backing the resource, for example alb, clb, or mse; empty for a CNAME domain
  product string
  // Protection mode of the object, for example domain
  pattern string
  // Provisioning status
  //
  // active when protection is running, or initializing / init_failed while it
  // is being set up.
  resourceStatus string
  // WAF protection-group the resource belongs to
  resourceGroup string
  // Time the protected object was created
  createTime time
  // Whether the protected object's logs are delivered to Log Service
  //
  // Log delivery is switched on per protected object as well as for the
  // instance as a whole, so an instance whose logStatus reads normal still
  // records nothing for an object left switched off.
  logDeliveryEnabled() bool
  // Protection templates applied to the protected object
  //
  // Templates carry the rules WAF enforces for this object, one template per
  // protection scene. An empty list means the object is onboarded to WAF but no
  // protection module is bound to it.
  templates() []alicloud.waf.defenseTemplate
  // Protection scenes covered by an enabled template on this object
  //
  // Each entry is a defenseScene value such as waf_group (basic protection),
  // cc (HTTP flood protection), or custom_acl (custom rules). A scene whose
  // template is bound but switched off is not listed, because a disabled
  // template inspects no traffic.
  enabledDefenseScenes() []string
  // Whether at least one enabled protection template is applied to the object
  //
  // False when the object is onboarded to WAF but every template bound to it is
  // switched off, which is the case an onboarding check alone cannot see:
  // traffic still flows through WAF, and nothing inspects it.
  protectionEnabled() bool
}

// Web Application Firewall protected domain
//
// A single CNAME-access domain protected by a WAF instance, keyed by domain.
// Exposes the WAF-assigned CNAME, listen ports, and the TLS configuration
// (certificate, minimum TLS version) of the HTTPS listener. Use it to audit
// whether an HTTPS domain enforces a strong TLS version and presents a
// non-expired certificate.
alicloud.waf.domain {
  // Center region the domain belongs to
  regionId string
  // ID of the WAF instance protecting the domain
  instanceId string
  // Protected hostname, used as the lookup key
  domain string
  // WAF-assigned CNAME that traffic must resolve to
  cname string
  // Domain status
  //
  // 1 (normal), 2 (creating), 3 (modifying), 4 (releasing), or 5 (forwarding
  // disabled).
  status int
  // HTTP listener ports
  httpPorts []int
  // HTTPS listener ports
  httpsPorts []int
  // Whether the domain serves HTTPS
  //
  // True when at least one HTTPS listener port is configured.
  httpsEnabled bool
  // ID of the certificate bound to the HTTPS listener, empty when none
  certId() string
  // Minimum TLS version accepted, for example tlsv1.2
  tlsVersion() string
  // Whether TLS 1.3 is enabled
  tls13Enabled() bool
  // Expiry time of the bound certificate, null when no certificate is configured
  certExpireTime() time
}

// Web Application Firewall protection template
//
// A single WAF 3.0 protection template, keyed by the owning instanceId and
// templateId. A template holds the rules for one protection scene and carries
// the switch that decides whether that scene inspects traffic at all. Exposes
// the scene, the template origin and type, whether it is enabled, and the rules
// it contains. Use it to find protected objects whose protection modules are
// bound but switched off.
alicloud.waf.defenseTemplate @defaults("templateName defenseScene templateType enabled") {
  // Center region the template belongs to
  regionId string
  // ID of the WAF instance the template belongs to
  instanceId string
  // Template ID, used as the lookup key
  templateId int
  // Template name
  templateName string
  // Template type
  //
  // One of user_default (the account-wide default for the scene) or
  // user_custom (a template bound to named protected objects).
  templateType string
  // Origin of the template, custom for a user-defined template
  templateOrigin string
  // Protection scene the template covers
  //
  // One of waf_group (basic protection), antiscan (scan protection),
  // ip_blacklist, custom_acl (custom rules), whitelist, region_block (location
  // blacklist), custom_response, cc (HTTP flood protection), tamperproof (web
  // tamper proofing), dlp (data leak prevention), or bot_manager.
  defenseScene string
  // Sub-scene of the template
  //
  // Set only for bot management templates, where it is one of web, app, basic,
  // or bot_custom_acl. Empty for every other scene.
  defenseSubScene string
  // Description of the template
  description string
  // Raw template status, 0 (disabled) or 1 (enabled)
  status int
  // Whether the template is enabled
  //
  // A disabled template is configured but inspects no traffic, so the scene it
  // covers is unprotected on every object the template is bound to.
  enabled bool
  // Time the template was last modified
  updateTime time
  // Protection rules contained in the template
  rules() []alicloud.waf.defenseRule
}

// Web Application Firewall protection rule
//
// A single rule inside a WAF 3.0 protection template, keyed by the owning
// instanceId and ruleId. Exposes the rule scene, the action taken on a match,
// the rule configuration, and whether the rule is enabled. Use it to confirm
// that a protection template blocks rather than merely observes, and to find
// rules left switched off.
alicloud.waf.defenseRule @defaults("ruleName defenseScene action enabled") {
  // Center region the rule belongs to
  regionId string
  // ID of the WAF instance the rule belongs to
  instanceId string
  // ID of the template the rule belongs to, 0 for a global or per-object rule
  templateId int
  // Rule ID, used as the lookup key
  ruleId int
  // Rule name
  ruleName string
  // Rule type
  //
  // One of whitelist (a rule that skips inspection) or defense (a rule that
  // inspects). A whitelist rule widens what reaches the origin, so it deserves
  // the same scrutiny as an allow rule in a firewall.
  ruleType string
  // Scope the rule was defined at
  //
  // One of template (a rule inside a protection template), resource (a rule
  // bound to one protected object), or global.
  defenseType string
  // Protection scene the rule belongs to, for example custom_acl, cc, or ip_blacklist
  defenseScene string
  // Origin of the rule, custom for user-created or system for generated
  defenseOrigin string
  // Action taken when the rule matches
  //
  // For example block, monitor, or js (JavaScript challenge). A rule set to
  // monitor records the match and lets the request through.
  action string
  // Rule configuration
  //
  // The condition and action detail of the rule, as returned by the API. The
  // shape varies by defenseScene: a custom_acl rule carries its match
  // conditions, an ip_blacklist rule carries its address list. Null when the
  // configuration is not valid JSON.
  config dict
  // Description of the rule
  description string
  // Protected object the rule is bound to, empty for a template or global rule
  resource string
  // Raw rule status, 0 (disabled) or 1 (enabled)
  status int
  // Whether the rule is enabled
  enabled bool
  // Time the rule was created
  createTime time
  // Time the rule was last modified
  updateTime time
}

// Alibaba Cloud Cloud Firewall
//
// Cloud Firewall access-control state for an Alibaba Cloud account. Cloud
// Firewall is a center service. Exposes whether the firewall service is active,
// its edition, and the internet-boundary control policies (the allow and deny
// rules). Use it to audit whether the firewall is enabled and whether any rule
// broadly permits inbound traffic.
alicloud.cloudFirewall {
  // Whether the Cloud Firewall service is active for the account
  enabled() bool
  // Cloud Firewall edition
  //
  // 2 (Premium), 3 (Enterprise), 4 (Ultimate), or 10 (pay-as-you-go). 0 when
  // the service is not provisioned.
  edition() int
  // Internet-boundary control policies in both the inbound and outbound directions
  controlPolicies() []alicloud.cloudFirewall.controlPolicy
  // Whether Cloud Firewall delivers its traffic logs to Log Service
  //
  // Reports whether a Log Service logstore is provisioned to receive the
  // firewall's logs. This is the log-analysis feature and is separate from
  // enabled: a firewall that is running with log analysis off keeps no
  // searchable record of the traffic it allowed or denied, so a control policy
  // cannot be shown to have ever matched.
  logDeliveryEnabled() bool
  // Name of the Log Service project holding the firewall logs
  //
  // Empty when log analysis is off.
  logProjectName() string
  // Name of the Log Service logstore holding the firewall logs
  //
  // Empty when log analysis is off.
  logStoreName() string
  // Region the firewall logs are delivered to
  //
  // Empty when log analysis is off.
  logRegionId() string
  // Days the firewall logs are retained
  //
  // Zero when log analysis is off. Logs older than this are dropped, which
  // bounds how far back an investigation can reach.
  logRetentionDays() int
  // Log Service project holding the firewall logs
  //
  // Null when log analysis is off or the project can no longer be read.
  logProject() alicloud.log.project
  // VPC firewalls guarding traffic between VPCs
  //
  // A VPC firewall sits on an east-west path (a CEN attachment, a VPC peering,
  // or an Express Connect circuit) rather than on the internet boundary, so
  // controlPolicies says nothing about it. A VPC pair with no VPC firewall, or
  // one whose firewall is switched off, moves traffic between networks with
  // nothing inspecting it.
  vpcFirewalls() []alicloud.cloudFirewall.vpcFirewall
  // NAT firewalls guarding outbound traffic through a NAT gateway
  //
  // A NAT firewall inspects the egress path of a private subnet. Without one,
  // an instance with no public address still reaches the internet through the
  // NAT gateway unfiltered.
  natFirewalls() []alicloud.cloudFirewall.natFirewall
}

// Cloud Firewall VPC firewall
//
// A single VPC firewall, keyed by vpcFirewallId. A VPC firewall guards the
// east-west path between two VPCs joined by CEN, VPC peering, or Express
// Connect. Exposes both ends of the pair, whether the firewall is switched on,
// the strict-mode and intrusion-prevention settings, and the access-control
// rules it enforces. Use it to find VPC pairs that carry traffic with no
// firewall in the path, or with a firewall that only observes.
alicloud.cloudFirewall.vpcFirewall @defaults("vpcFirewallName connectType enabled strictMode") {
  // VPC firewall ID, used as the lookup key
  vpcFirewallId string
  // Name of the VPC firewall
  vpcFirewallName string
  // Kind of connection the firewall guards
  //
  // One of cen (a Cloud Enterprise Network attachment), vpcpeer (a VPC peering
  // connection), or expressconnect (a leased-line circuit).
  connectType string
  // Sub-type of the connection, for further detail on the connect type
  connectSubType string
  // Throughput of the firewall in Mbit/s
  bandwidth int
  // Raw switch status of the firewall
  //
  // One of opened, closed, or notconfigured.
  firewallSwitchStatus string
  // Whether the firewall is switched on
  //
  // True only while firewallSwitchStatus reads opened. A configured but closed
  // firewall enforces none of its control policies.
  enabled bool
  // Whether the firewall region is available
  regionStatus string
  // Whether strict mode is enabled
  //
  // In strict mode traffic is denied unless a policy allows it. With strict
  // mode off the default is to allow, so an empty policy list means the pair is
  // wide open rather than closed.
  strictMode bool
  // Whether the intrusion-prevention system blocks rather than observes
  //
  // False when IPS runs in monitor mode, where a detected intrusion is recorded
  // and still delivered.
  ipsBlocking bool
  // Raw intrusion-prevention mode, 0 (monitor) or 1 (block)
  ipsMode int
  // Whether the intrusion-prevention basic rule set is enabled
  ipsBasicRulesEnabled bool
  // Whether virtual patching is enabled
  //
  // Virtual patching blocks exploitation of a known vulnerability at the
  // firewall while the workload behind it is still unpatched.
  ipsVirtualPatchEnabled bool
  // Intrusion-prevention rule group, 1 (loose), 2 (medium), or 3 (strict)
  ipsRuleClass int
  // Region of the local VPC
  localRegionId string
  // Name of the local VPC
  localVpcName string
  // Local VPC of the guarded pair
  //
  // Null when the VPC lies outside the scanned regions.
  localVpc() alicloud.vpc.network
  // Region of the peer VPC
  peerRegionId string
  // ID of the peer VPC
  //
  // Kept as a raw value as well as a reference because the peer may belong to
  // another Alibaba Cloud account, in which case peerVpc cannot be resolved and
  // this is the only record of what the pair reaches.
  peerVpcId string
  // Name of the peer VPC
  peerVpcName string
  // Account that owns the peer VPC
  peerVpcOwnerId string
  // Whether the peer VPC belongs to a different account
  //
  // A cross-account pair carries traffic out of this account's control, so the
  // rules on it are worth reading even when both ends look internal.
  crossAccount bool
  // Peer VPC of the guarded pair
  //
  // Null when the peer belongs to another account or lies outside the scanned
  // regions.
  peerVpc() alicloud.vpc.network
  // Access-control rules enforced on the guarded path
  controlPolicies() []alicloud.cloudFirewall.vpcControlPolicy
}

// Cloud Firewall VPC firewall control policy
//
// A single east-west access-control rule of a VPC firewall, keyed by aclUuid. A
// rule permits or denies traffic between a source and a destination on given
// ports and protocols. Exposes the action, both endpoints, the resolved
// address-book members, and whether the rule is enforced. Use it to find
// enabled rules that broadly permit traffic between VPCs (for example an accept
// rule whose source is 0.0.0.0/0).
alicloud.cloudFirewall.vpcControlPolicy @defaults("action source destination destPort proto enabled") {
  // Rule UUID, used as the lookup key
  aclUuid string
  // ID of the VPC firewall the rule belongs to
  vpcFirewallId string
  // Action taken on matching traffic
  //
  // One of accept (allow), drop (deny), or log (monitor only).
  action string
  // Source address, CIDR, or address-book reference
  source string
  // Source type, either net (a CIDR) or group (an address book)
  sourceType string
  // CIDRs behind a source address book, empty when the source is a plain CIDR
  sourceGroupCidrs []string
  // Destination address, CIDR, domain, or address-book reference
  destination string
  // Destination type, one of net, group, or domain
  destinationType string
  // CIDRs behind a destination address book, empty when the destination is a plain CIDR
  destinationGroupCidrs []string
  // Destination port or port range
  destPort string
  // Destination port type, either port (a literal port) or group (a port address book)
  destPortType string
  // Ports behind a destination port address book
  destPortGroupPorts []string
  // Protocol, one of ANY, TCP, UDP, or ICMP
  proto string
  // Application-layer protocols the rule matches, for example HTTP or ANY
  applicationNames []string
  // Description of the rule
  description string
  // Whether the rule is enforced
  //
  // A disabled rule is configured but not applied.
  enabled bool
  // Rule priority order
  order int
  // Cumulative number of times the rule has matched traffic
  hitTimes int
  // Time the rule last matched traffic, null when it never has
  lastHitTime time
  // Time the rule was created
  createTime time
  // Time the rule was last modified
  updateTime time
}

// Cloud Firewall NAT firewall
//
// A single NAT firewall, keyed by proxyId. A NAT firewall inspects the traffic
// a private subnet sends through a NAT gateway. Exposes the guarded gateway and
// VPC, the firewall health, strict mode, and the access-control rules on the
// egress path. Use it to find NAT gateways whose outbound traffic passes
// uninspected.
alicloud.cloudFirewall.natFirewall @defaults("proxyName proxyStatus enabled strictMode") {
  // NAT firewall (proxy) ID, used as the lookup key
  proxyId string
  // Name of the NAT firewall
  proxyName string
  // Region the NAT firewall runs in
  regionId string
  // Health of the NAT firewall
  //
  // One of configuring, deleting, normal, abnormal, opening, closing, or
  // closed.
  proxyStatus string
  // Whether the NAT firewall is inspecting traffic
  //
  // True only while proxyStatus reads normal. Every other state, including
  // abnormal, leaves egress traffic uninspected.
  enabled bool
  // Whether strict mode is enabled
  //
  // In strict mode outbound traffic is denied unless a policy allows it. With
  // strict mode off the default is to allow.
  strictMode bool
  // Detail of the failure when the firewall is in an abnormal state, empty otherwise
  errorDetail string
  // Name of the VPC the guarded NAT gateway belongs to
  vpcName string
  // VPC the guarded NAT gateway belongs to
  //
  // Null when the VPC lies outside the scanned regions.
  vpc() alicloud.vpc.network
  // Name of the guarded NAT gateway
  natGatewayName string
  // NAT gateway the firewall guards
  //
  // Null when the gateway lies outside the scanned regions or has been deleted.
  natGateway() alicloud.vpc.natGateway
  // Access-control rules enforced on the egress path
  controlPolicies() []alicloud.cloudFirewall.natControlPolicy
}

// Cloud Firewall NAT firewall control policy
//
// A single NAT-boundary access-control rule, keyed by aclUuid. A rule permits or
// denies traffic leaving (or entering) a NAT gateway on given ports and
// protocols. Exposes the direction, action, both endpoints, and whether the rule
// is enforced. Use it to find egress rules that permit unrestricted outbound
// traffic from a private subnet.
alicloud.cloudFirewall.natControlPolicy @defaults("direction action source destination destPort enabled") {
  // Rule UUID, used as the lookup key
  aclUuid string
  // ID of the NAT gateway the rule applies to
  natGatewayId string
  // Traffic direction the rule applies to, either in (inbound) or out (outbound)
  direction string
  // Action taken on matching traffic
  //
  // One of accept (allow), drop (deny), or log (monitor only).
  action string
  // Source address, CIDR, or address-book reference
  source string
  // Source type, one of net (a CIDR), group (an address book), or location (a region)
  sourceType string
  // CIDRs behind a source address book, empty when the source is a plain CIDR
  sourceGroupCidrs []string
  // Destination address, CIDR, domain, or address-book reference
  destination string
  // Destination type, one of net, group, domain, or location
  destinationType string
  // CIDRs behind a destination address book, empty when the destination is a plain CIDR
  destinationGroupCidrs []string
  // Destination port or port range
  destPort string
  // Destination port type, either port (a literal port) or group (a port address book)
  destPortType string
  // Ports behind a destination port address book
  destPortGroupPorts []string
  // Protocol, one of ANY, TCP, UDP, or ICMP
  proto string
  // Application-layer protocols the rule matches, for example HTTP or ANY
  applicationNames []string
  // Description of the rule
  description string
  // Whether the rule is enforced
  //
  // A disabled rule is configured but not applied.
  enabled bool
  // Rule priority order
  order int
  // Cumulative number of times the rule has matched traffic
  hitTimes int
  // Time the rule last matched traffic, null when it never has
  lastHitTime time
  // Time the rule was created
  createTime time
  // Time the rule was last modified
  updateTime time
}

// Cloud Firewall control policy
//
// A single internet-boundary access-control rule, keyed by aclUuid. A rule
// permits or denies traffic between a source and destination on given ports and
// protocols. Exposes the action, source, destination, and whether it is
// enabled. Use it to find enabled rules that broadly accept inbound traffic (for
// example an accept rule with source 0.0.0.0/0).
alicloud.cloudFirewall.controlPolicy {
  // Rule UUID, used as the lookup key
  aclUuid string
  // Traffic direction the rule applies to, either in (inbound) or out (outbound)
  direction string
  // Action taken on matching traffic
  //
  // One of accept (allow), drop (deny), or log (monitor only).
  action string
  // Source address, CIDR, or address-book reference
  source string
  // Source type, for example net (CIDR), group (address book), or location
  sourceType string
  // Destination address, CIDR, domain, or address-book reference
  destination string
  // Destination type, for example net, group, domain, or location
  destinationType string
  // Destination port or port range
  destPort string
  // Protocol, one of ANY, TCP, UDP, or ICMP
  proto string
  // Application-layer protocol the rule matches, for example HTTP or ANY
  applicationName string
  // Description of the rule
  description string
  // Whether the rule is enabled
  //
  // A disabled rule is configured but not enforced.
  enabled bool
  // Rule priority order
  order int
  // Cumulative number of times the rule has matched traffic
  hitTimes int
}

// Alibaba Cloud Anti-DDoS
//
// Anti-DDoS Pro and Premium instances and the assets they protect for an
// Alibaba Cloud account. Anti-DDoS is a center service. Exposes the scrubbing
// instances, their subscription health, and the web domains and forwarding
// ports under protection. Use it to audit which assets are protected and whether
// an instance's protection has lapsed (expired, disabled, or in debt).
alicloud.antiddos {
  // Anti-DDoS Pro and Premium instances across the China and international centers
  instances() []alicloud.antiddos.instance
}

// Anti-DDoS instance
//
// A single Anti-DDoS Pro or Premium instance, keyed by instanceId. Exposes the
// mitigation edition, forwarding state, and subscription window, and is the
// parent of the protected web domains and forwarding ports. Use it to confirm an
// instance is enabled and not expired. Protection is effectively off when the
// instance is expired or not forwarding traffic.
alicloud.antiddos.instance {
  // Center region the instance belongs to, either cn-hangzhou or ap-southeast-1
  regionId string
  // Anti-DDoS instance ID, used as the lookup key
  instanceId string
  // Instance remark
  remark string
  // Instance status
  //
  // 1 (Normal) or 2 (Expired). An expired instance no longer scrubs traffic.
  status int
  // Mitigation edition
  //
  // 0 (Premium Insurance), 1 (Premium Unlimited), 2 (Premium mainland
  // acceleration), or 9 (Pro Profession).
  edition int
  // Whether the instance is forwarding (protecting) traffic
  //
  // False when the instance is not forwarding service traffic, which means its
  // protection is effectively off.
  enabled bool
  // Forwarding mode of the instance IP, for example fnat
  ipMode string
  // IP version of the instance, either Ipv4 or Ipv6
  ipVersion string
  // Anti-DDoS instance IP that scrubbed traffic is delivered from
  ip string
  // Overdue-payment status, 0 when there is no overdue payment
  debtStatus int
  // Time the instance subscription expires
  expireTime time
  // Time the instance was created
  createTime time
  // Web (HTTP/HTTPS) domains protected by the instance
  webRules() []alicloud.antiddos.webRule
  // Non-web (TCP/UDP) forwarding ports protected by the instance
  networkRules() []alicloud.antiddos.networkRule
}

// Anti-DDoS protected web domain
//
// A single web domain protected by an Anti-DDoS instance, keyed by the owning
// instanceId and domain. Exposes the scrubbing CNAME, the HTTP flood (CC)
// protection state, the certificate, and the origin servers. Use it to audit
// whether a protected domain has CC protection and a non-expired certificate.
alicloud.antiddos.webRule {
  // Center region the domain belongs to
  regionId string
  // ID of the Anti-DDoS instance protecting the domain
  instanceId string
  // Protected hostname, used with the instance ID as the lookup key
  domain string
  // Anti-DDoS scrubbing CNAME that traffic must resolve to
  cname string
  // Whether HTTP flood (CC) protection is enabled
  ccEnabled bool
  // Whether a CC protection rule is enabled
  ccRuleEnabled bool
  // Name of the certificate bound to the domain, empty when none
  certName string
  // Expiry time of the bound certificate, null when no certificate is configured
  certExpireTime time
  // Whether the domain is currently penalized (blocked) for abnormal traffic
  penalized bool
  // Protocols and listener ports the domain serves
  //
  // Each entry lists the proxyType (http, https, websocket, or websockets) and
  // the proxyPorts it listens on.
  proxyTypes []dict
  // Origin servers traffic is forwarded to after scrubbing
  //
  // Each entry lists the realServer (an IP or hostname) and its rsType (0 for an
  // IP, 1 for a domain).
  realServers []dict
  // Whether access and attack logs for the domain are delivered to Log Service
  //
  // Anti-DDoS keeps a searchable record of the traffic it scrubbed only while
  // this is on, so an attack on a domain with it off leaves nothing to
  // investigate afterwards. The switch is per protected domain rather than per
  // instance, so one domain having it on says nothing about the others.
  logDeliveryEnabled() bool
  // Name of the Log Service project the domain's logs are delivered to
  //
  // Empty when log delivery is off.
  logProjectName() string
  // Name of the Log Service logstore the domain's logs are delivered to
  //
  // Empty when log delivery is off.
  logLogstoreName() string
  // Log Service project the domain's logs are delivered to
  //
  // Null when log delivery is off or the project can no longer be read.
  // Traverse to it for the retention and the access policy of the store that
  // holds the scrubbing records.
  logProject() alicloud.log.project
}

// Anti-DDoS protected forwarding port
//
// A single non-web (Layer-4) forwarding rule on an Anti-DDoS instance, keyed by
// the instanceId, protocol, and frontend port. Exposes the frontend and backend
// ports and the origin servers. Use it to enumerate the TCP and UDP ports under
// Anti-DDoS protection.
alicloud.antiddos.networkRule {
  // Center region the rule belongs to
  regionId string
  // ID of the Anti-DDoS instance the rule belongs to
  instanceId string
  // Forwarding protocol, either tcp or udp
  protocol string
  // Frontend (listener) port scrubbed traffic arrives on
  frontendPort int
  // Backend (origin) port traffic is forwarded to
  backendPort int
  // Origin servers traffic is forwarded to after scrubbing
  realServers []string
}

// CloudSSO
//
// Workforce identity and account access for an Alibaba Cloud resource
// directory. Exposes the CloudSSO directories in the account, and through them
// the workforce users and groups, the access configurations that define what a
// session may do, and the assignments that grant those configurations on
// individual member accounts.
alicloud.cloudsso {
  // Whether CloudSSO is enabled for the account
  //
  // False when the service has never been enabled, in which case the account
  // manages access through RAM users and roles alone.
  enabled() bool
  // CloudSSO directories in the account
  directories() []alicloud.cloudsso.directory
}

// CloudSSO directory
//
// A CloudSSO directory, the container for a workforce identity population and
// the access it holds on the resource directory. The directoryId selects the
// directory, for example
// `alicloud.cloudsso.directory(directoryId: "d-00example")`. Exposes the users
// and groups in the directory, the access configurations and their assignments,
// the password policy, and the multi-factor and credential-retrieval settings
// that govern how members sign in.
alicloud.cloudsso.directory @defaults("directoryId directoryName region") {
  // Directory ID, used as the lookup key
  directoryId string
  // Name of the directory
  directoryName string
  // Region the directory is hosted in
  region string
  // Time the directory was created
  createTime time
  // Time the directory was last updated
  updateTime time
  // Users in the directory
  users() []alicloud.cloudsso.user
  // Groups in the directory
  groups() []alicloud.cloudsso.group
  // Access configurations defined in the directory
  accessConfigurations() []alicloud.cloudsso.accessConfiguration
  // Assignments granting access configurations on member accounts
  accessAssignments() []alicloud.cloudsso.accessAssignment
  // Password requirements for users in the directory
  passwordPolicy() alicloud.cloudsso.passwordPolicy
  // When multi-factor authentication is demanded of users signing in
  //
  // One of Enabled, where every sign-in requires a second factor, Byp, where it
  // is required only for sign-ins the service judges risky, or Disabled.
  mfaAuthenticationStatus() string
  // Whether users may retrieve long-lived access credentials for themselves
  //
  // True lets a signed-in user mint credentials that outlive the sign-in
  // session, widening the window in which a compromised session is useful.
  allowUserToGetCredentials() bool
  // Network ranges users may sign in from
  //
  // Semicolon-separated CIDR blocks restricting where sign-ins are accepted.
  // Empty when sign-in is accepted from anywhere.
  loginNetworkMasks() string
  // Whether SCIM synchronization from an external identity provider is enabled
  //
  // When enabled, the user and group population is managed by the external
  // provider, so accounts deactivated there stop being usable here.
  scimSynchronizationEnabled() bool
  // External SAML identity provider federated with the directory
  //
  // Null when no identity provider has been configured, in which case sign-in
  // is authenticated by CloudSSO's own user store and the controls of the
  // corporate identity provider (conditional access, device posture,
  // deprovisioning on termination) do not apply.
  samlIdentityProvider() alicloud.cloudsso.samlIdentityProvider
  // Whether single sign-on through an external identity provider is enabled
  //
  // False both when no provider is configured and when one is configured but
  // switched off, which are the two ways sign-in falls back to the local user
  // store.
  ssoEnabled() bool
  // Access-provisioning tasks recorded for the directory
  //
  // Each task is one grant or revocation of an access configuration on a member
  // account. Use it to find a revocation that failed, which leaves access in
  // place after it was meant to be withdrawn.
  tasks() []alicloud.cloudsso.task
}

// CloudSSO external SAML identity provider
//
// The SAML identity provider federated with a CloudSSO directory, keyed by the
// directoryId. Exposes the provider entity, the sign-in endpoint, the request
// binding and signing settings, and whether federated sign-in is switched on.
// Use it to confirm that sign-in is authenticated by the corporate identity
// provider rather than by CloudSSO's local user store.
alicloud.cloudsso.samlIdentityProvider @defaults("entityId ssoStatus bindingType") {
  // ID of the directory the provider is federated with
  directoryId string
  // Entity ID of the identity provider, for example http://www.okta.com/exk3qwgt
  entityId string
  // Sign-in URL users are redirected to
  loginUrl string
  // Binding used to send SAML requests, either Post or Redirect
  bindingType string
  // Raw single sign-on status, either Enabled or Disabled
  ssoStatus string
  // Whether federated sign-in is switched on
  //
  // A provider configured but left disabled means sign-in still falls back to
  // the local user store.
  enabled bool
  // Whether CloudSSO signs the SAML requests it sends
  //
  // Signed requests let the identity provider reject an authentication request
  // that did not originate from this directory.
  wantRequestSigned bool
  // IDs of the SAML signing certificates configured for the provider
  certificateIds []string
  // Time the provider was first configured
  createTime time
  // Time the provider configuration was last modified
  updateTime time
}

// CloudSSO access-provisioning task
//
// A single grant or revocation of an access configuration on a member account,
// keyed by taskId. Exposes what was granted to whom on which target and whether
// the operation succeeded. Use it to find a failed revocation, which leaves
// access in place after it was meant to be withdrawn.
alicloud.cloudsso.task @defaults("taskType status principalName targetName") {
  // Task ID, used as the lookup key
  taskId string
  // Kind of operation
  //
  // For example ProvisionAccessConfiguration,
  // DeprovisionAccessConfiguration, CreateAccessAssignment, or
  // DeleteAccessAssignment.
  taskType string
  // Outcome of the task
  //
  // One of InProgress, Success, or Failed.
  status string
  // Whether the task completed successfully
  //
  // False for a task still running as well as for a failed one. A failed
  // DeleteAccessAssignment means the access it was withdrawing is still
  // granted.
  succeeded bool
  // Reason the task failed, empty when it did not
  failureReason string
  // ID of the user or group the task acted on
  principalId string
  // Name of the user or group the task acted on
  principalName string
  // Kind of principal, either User or Group
  principalType string
  // ID of the access configuration the task granted or revoked
  //
  // Kept as a raw value alongside accessConfiguration because a task is a
  // historical record: the configuration it names may since have been deleted,
  // in which case the reference resolves to null and this is all that remains.
  accessConfigurationId string
  // Name of the access configuration the task granted or revoked
  accessConfigurationName string
  // Access configuration the task granted or revoked
  //
  // Null when the configuration has since been deleted.
  accessConfiguration() alicloud.cloudsso.accessConfiguration
  // ID of the account the access was granted on or revoked from
  targetId string
  // Name of the account the access was granted on or revoked from
  targetName string
  // Resource-directory path of the target
  targetPath string
  // Resource-directory path name of the target
  targetPathName string
  // Kind of target, for example RD-Account
  targetType string
  // Time the task started
  startTime time
  // Time the task finished, null while it is still running
  endTime time
}

// CloudSSO password policy
//
// Password requirements applied to users in a CloudSSO directory. Exposes the
// length, character-class, reuse, and expiration rules, along with the
// failed-sign-in lockout threshold.
alicloud.cloudsso.passwordPolicy @defaults("minPasswordLength maxLoginAttempts") {
  // Minimum number of characters a password must contain
  minPasswordLength int
  // Maximum number of characters a password may contain
  maxPasswordLength int
  // Minimum number of characters that must differ from the previous password
  minPasswordDifferentChars int
  // Number of days a password remains valid
  maxPasswordAge int
  // Number of previous passwords that may not be reused
  passwordReusePrevention int
  // Number of consecutive failed sign-ins before the account is locked
  maxLoginAttempts int
  // Whether a lowercase letter is required
  requireLowerCaseChars bool
  // Whether an uppercase letter is required
  requireUpperCaseChars bool
  // Whether a digit is required
  requireNumbers bool
  // Whether a symbol is required
  requireSymbols bool
  // Whether the password is barred from containing the user name
  passwordNotContainUsername bool
  // Whether an expired password blocks sign-in outright
  //
  // True locks the user out until an administrator resets the password, rather
  // than prompting for a change at the next sign-in.
  hardExpire bool
}

// CloudSSO user
//
// A workforce user in a CloudSSO directory, keyed by the directoryId and
// userId. Exposes the user profile, whether the account was created directly or
// synchronized from an external identity provider, the multi-factor devices
// bound to it, and the groups it belongs to.
alicloud.cloudsso.user @defaults("userName displayName status provisionType") {
  // ID of the directory the user belongs to
  directoryId string
  // User ID, used with directoryId as the lookup key
  userId string
  // Sign-in name of the user
  userName string
  // Display name of the user
  displayName string
  // First name of the user
  firstName string
  // Last name of the user
  lastName string
  // Email address of the user
  email string
  // Description of the user
  description string
  // User status
  //
  // Either Enabled or Disabled. A disabled user cannot sign in but keeps its
  // group memberships and assignments.
  status string
  // How the user account came to exist
  //
  // Either Manual for a user created directly in the directory, or
  // Synchronized for one provisioned from an external identity provider. A
  // manual user survives deprovisioning at the identity provider.
  provisionType string
  // Time the user was created
  createTime time
  // Time the user was last updated
  updateTime time
  // Multi-factor authentication devices bound to the user
  mfaDevices() []alicloud.cloudsso.mfaDevice
  // Groups the user belongs to
  groups() []alicloud.cloudsso.group
}

// CloudSSO group
//
// A group of workforce users in a CloudSSO directory, keyed by the directoryId
// and groupId. Access assignments made to a group apply to every member, so the
// members list is what turns a group-level grant into the set of people who
// actually hold it.
alicloud.cloudsso.group @defaults("groupName provisionType") {
  // ID of the directory the group belongs to
  directoryId string
  // Group ID, used with directoryId as the lookup key
  groupId string
  // Name of the group
  groupName string
  // Description of the group
  description string
  // How the group came to exist
  //
  // Either Manual for a group created directly in the directory, or
  // Synchronized for one provisioned from an external identity provider.
  provisionType string
  // Time the group was created
  createTime time
  // Time the group was last updated
  updateTime time
  // Users that belong to the group
  members() []alicloud.cloudsso.user
}

// CloudSSO multi-factor authentication device
//
// A second-factor device bound to a CloudSSO user, keyed by deviceId. Exposes
// the device type and when it became effective.
alicloud.cloudsso.mfaDevice @defaults("deviceName deviceType") {
  // Device ID
  deviceId string
  // ID of the user the device is bound to
  userId string
  // Name of the device
  deviceName string
  // Device type, for example TOTP for an authenticator application
  deviceType string
  // Time the device became effective
  effectiveTime time
}

// CloudSSO access configuration
//
// A named set of permissions that a CloudSSO user assumes on a member account,
// keyed by the directoryId and accessConfigurationId. The permission policies
// determine what a session created from this configuration may do, and the
// session duration determines how long it lasts. An access configuration grants
// nothing until an assignment binds it to a principal and an account.
alicloud.cloudsso.accessConfiguration @defaults("accessConfigurationName sessionDuration") {
  // ID of the directory the access configuration belongs to
  directoryId string
  // Access configuration ID, used with directoryId as the lookup key
  accessConfigurationId string
  // Name of the access configuration
  accessConfigurationName string
  // Description of the access configuration
  description string
  // Maximum length of a session created from this configuration, in seconds
  sessionDuration int
  // Initial console page a session lands on
  relayState string
  // Time the access configuration was created
  createTime time
  // Time the access configuration was last updated
  updateTime time
  // Permission policies attached to the access configuration
  permissionPolicies() []alicloud.cloudsso.permissionPolicy
}

// CloudSSO permission policy
//
// A permission policy attached to a CloudSSO access configuration. A System
// policy is one of the Alibaba Cloud managed policies, reachable through
// ramPolicy; an Inline policy carries its statements in policyDocument on this
// resource. Between them they define everything a session created from the
// access configuration is allowed to do.
alicloud.cloudsso.permissionPolicy @defaults("policyName policyType") {
  // ID of the directory the access configuration belongs to
  directoryId string
  // ID of the access configuration the policy is attached to
  accessConfigurationId string
  // Name of the permission policy
  policyName string
  // Policy type
  //
  // Either System for an Alibaba Cloud managed policy or Inline for a policy
  // defined on the access configuration itself.
  policyType string
  // Permission statements of an inline policy, as a JSON string
  //
  // Empty for a System policy, whose statements are exposed through ramPolicy
  // instead.
  policyDocument string
  // Time the policy was attached to the access configuration
  addTime time
  // Managed policy behind a System permission policy
  //
  // The Alibaba Cloud managed policy of the same name, so its statements can be
  // read the same way as for a RAM identity. Null for an Inline policy.
  ramPolicy() alicloud.ram.policy
}

// CloudSSO access assignment
//
// A grant binding a CloudSSO user or group to an access configuration on one
// member account. This is the edge that turns a permission set into effective
// access: it names who (principal), what (access configuration), and where
// (target account).
alicloud.cloudsso.accessAssignment @defaults("principalName accessConfigurationName targetName") {
  // ID of the directory the assignment belongs to
  directoryId string
  // ID of the principal the assignment grants access to
  principalId string
  // Name of the principal
  principalName string
  // Principal type
  //
  // Either User for an assignment made to a single user, or Group for one made
  // to a group, in which case every member of the group holds the access.
  principalType string
  // ID of the access configuration the assignment grants
  accessConfigurationId string
  // Name of the access configuration the assignment grants
  accessConfigurationName string
  // ID of the account the assignment grants access on
  targetId string
  // Name of the account the assignment grants access on
  targetName string
  // Target type, for example RD-Account for a resource directory member account
  targetType string
  // Path of the target account in the resource directory hierarchy
  targetPath string
  // Time the assignment was created
  createTime time
  // Access configuration the assignment grants
  accessConfiguration() alicloud.cloudsso.accessConfiguration
  // Member account the assignment grants access on
  account() alicloud.resourceManager.account
  // User the assignment was made to
  //
  // Null when the assignment was made to a group.
  user() alicloud.cloudsso.user
  // Group the assignment was made to
  //
  // Null when the assignment was made to a single user.
  group() alicloud.cloudsso.group
}

// Security Center
//
// Threat detection and posture management for the account. Exposes the
// subscription edition and quota, the protected machines and whether their
// agents are reporting, the vulnerabilities and baseline check failures found
// across them, and the alerts raised by threat detection.
alicloud.sas {
  // Whether Security Center is active for the account
  //
  // False when the service has never been subscribed. The free tier still
  // reports true, so pair this with version to tell the tiers apart.
  enabled() bool
  // Subscription edition code
  //
  // Higher codes carry more detection capability, with 1 for the free basic
  // edition. Zero when the service has never been subscribed.
  version() int
  // Number of assets the subscription covers
  //
  // Protection stops applying to assets beyond this quota, so a machine count
  // above it means part of the fleet is unprotected.
  assetLevel() int
  // Whether the current subscription is a trial
  trialVersion() bool
  // Whether the subscription is billed pay-as-you-go
  postPay() bool
  // Time the subscription was activated
  openTime() time
  // Time the subscription expires
  expireTime() time
  // Machines Security Center is protecting
  machines() []alicloud.sas.machine
  // Vulnerabilities found across the protected machines, grouped by vulnerability
  vulnerabilities() []alicloud.sas.vulnerability
  // Baseline check failures found across the protected machines, grouped by check
  baselineChecks() []alicloud.sas.baselineCheck
  // Alerts raised by threat detection
  alarmEvents() []alicloud.sas.alarmEvent
  // Account-level Security Center settings
  config() alicloud.sas.config
  // Log analysis delivery configured for each Security Center log type
  //
  // Security Center delivers its host, network and security logs to Log Service
  // under separate switches, so read every entry rather than assuming one
  // setting covers all three.
  logDeliveries() []alicloud.sas.logDelivery
}

// Security Center settings
//
// The account-level Security Center configuration behind the detections:
// the antivirus scan schedule, the configuration assessment schedule, the
// directories webshell detection covers, where alerts are routed, the
// vulnerability scan settings per vulnerability type, and how often asset
// fingerprints are collected. A machine can sit in the inventory reporting no
// findings because a scan it needed was never scheduled, which the machine
// inventory alone does not show.
private alicloud.sas.config {
  // Whether the scheduled antivirus scan is switched on
  //
  // This is the scheduled scan, not real-time protection. Reports false when
  // the account has never configured one.
  virusScanEnabled bool
  // How often the scheduled antivirus scan runs
  //
  // Read together with virusScanPeriodUnit, which gives the unit. Zero when no
  // scan is scheduled.
  virusScanInterval int
  // Unit of the antivirus scan interval, for example day
  //
  // Empty when no scan is scheduled.
  virusScanPeriodUnit string
  // Directories the scheduled antivirus scan covers
  //
  // Empty when the scan covers the default scope rather than named paths.
  virusScanPaths []string
  // Scope of the scheduled antivirus scan
  //
  // Empty when no scan is scheduled.
  virusScanType string
  // Whether configuration assessment runs automatically on a schedule
  //
  // False when assessment only runs when somebody starts it by hand, which
  // means the reported baseline results can be arbitrarily stale.
  configAssessmentEnabled bool
  // Whether newly added assets are automatically brought into configuration assessment
  //
  // False when a machine added after the schedule was set is assessed only
  // once somebody adds it, so fleet growth quietly reduces coverage.
  configAssessmentAutoAddEnabled bool
  // Days of the week the automatic configuration assessment runs
  //
  // Empty when no automatic assessment is scheduled.
  configAssessmentCycleDays []int
  // Baseline standards the configuration assessment applies
  //
  // Empty when no standard is selected, in which case the assessment has
  // nothing to check against.
  configAssessmentStandards []string
  // Directories webshell detection covers
  //
  // Webshell detection only inspects the directories listed here, so a web
  // server whose document root is absent is not being checked at all.
  webPaths() []alicloud.sas.webPath
  // Where Security Center sends each kind of notification
  noticeConfigs() []alicloud.sas.noticeConfig
  // Vulnerability scan settings, one entry per vulnerability type
  vulnerabilityConfigs() []alicloud.sas.vulnerabilityConfig
  // Asset fingerprint collection schedules, one entry per fingerprint kind
  propertySchedules() []alicloud.sas.propertySchedule
}

// Webshell detection path
//
// A single directory webshell detection covers, keyed by the path. Exposes the
// path, how it was configured, and the machines or groups it applies to.
alicloud.sas.webPath @defaults("webPath webPathType") {
  // Directory webshell detection covers, used as the lookup key
  webPath string
  // How the path was configured, for example a manually added or a detected path
  webPathType string
  // Machines and groups the path applies to, keyed by target
  //
  // The value gives the kind of target, for example a single machine or a
  // machine group.
  targets map[string]string
}

// Security Center notification setting
//
// The notification routing for one kind of Security Center event, keyed by
// project (the event type, for example sas_suspicious or health). Exposes which
// channels the notification goes to and during which hours, so an event type
// routed nowhere is visible as an empty channels list.
alicloud.sas.noticeConfig @defaults("project channels") {
  // Event type the setting covers, used as the lookup key
  //
  // For example sas_suspicious (suspicious events), remotelogin (remote
  // logons), or health (security checks).
  project string
  // Severity or grouping the event type belongs to
  category string
  // Channels the notification is sent through
  //
  // Any of sms, email, and internal. An empty list means the event type raises
  // no notification at all.
  channels []string
  // Raw channel code the API reports
  //
  // A bit field where 1 is text message, 2 is email, and 4 is internal
  // message, so 7 is all three. Zero means no channel.
  route int
  // Hours during which notifications are sent
  //
  // 0 for any time, or 1 for 08:00 to 22:00 only, in which case an event
  // raised overnight is not notified until the morning.
  timeLimit int
}

// Security Center vulnerability scan setting
//
// The scan setting for one vulnerability type, keyed by type. Exposes whether
// scanning for that type is switched on and the type-specific value behind it,
// so a type left off is visible even though the others are scanned.
alicloud.sas.vulnerabilityConfig @defaults("type enabled") {
  // Vulnerability type the setting covers, used as the lookup key
  //
  // One of cve (system vulnerabilities), sys (Windows system vulnerabilities),
  // cms (web content management system vulnerabilities), sca (application
  // vulnerabilities found by version fingerprint), app (web scanner findings), emg (emergency
  // vulnerabilities), scanMode (whether only real-risk vulnerabilities are
  // shown), imageVulClean (the retention period for image vulnerabilities), or
  // yum (whether Alibaba Cloud sources are preferred when fixing).
  type string
  // Whether scanning for the type is switched on
  enabled bool
  // Type-specific setting value
  //
  // The meaning depends on type: a scan scope for the scan types, or a
  // retention period in days when type is imageVulClean.
  config string
}

// Security Center asset fingerprint schedule
//
// The collection schedule for one kind of asset fingerprint, keyed by type.
// Exposes how often the fingerprint is collected and when the next collection
// is due, so a fingerprint kind that is never collected is visible rather than
// simply reporting no data.
alicloud.sas.propertySchedule @defaults("type scheduleHours") {
  // Fingerprint kind the schedule covers, used as the lookup key
  //
  // One of scheduler_software_period (software), scheduler_cron_period
  // (scheduled tasks), scheduler_sca_period (middleware),
  // scheduler_autorun_period (startup items), scheduler_lkm_period (kernel
  // modules), or scheduler_sca_proxy_period (websites).
  type string
  // Hours between collections
  //
  // For example 12 for twice a day, 24 for daily, or 168 for weekly. Zero when
  // no schedule is configured for the kind.
  scheduleHours int
  // Time the next collection is due
  //
  // Null when no schedule is configured for the kind.
  nextScheduleTime time
}

// Security Center log analysis delivery
//
// The log analysis configuration for a single Security Center log type, keyed
// by topic (for example aegis-log-login). Exposes the category the log type
// belongs to, whether delivery to Log Service is switched on, the destination
// project and logstore, and how long the delivered logs are kept. A category
// left switched off means Security Center detects against those events but
// keeps no searchable record of them.
alicloud.sas.logDelivery @defaults("topic category enabled") {
  // Log topic, used as the lookup key, for example aegis-log-login
  topic string
  // Category of log the entry covers
  //
  // One of host (host logs), network (network logs), or security (security
  // logs).
  category string
  // Name of the log type, for example Login
  description string
  // Whether delivery of this log type to Log Service is switched on
  enabled bool
  // Days the delivered logs are retained
  //
  // Zero when the entry reports no retention window.
  ttlDays int
  // Name of the Log Service project in the account the logs are delivered to
  //
  // Empty when the account has no dedicated project for Security Center logs.
  projectName string
  // Name of the Log Service logstore in the account the logs are delivered to
  //
  // Empty when the account has no dedicated logstore for this log type.
  logstoreName string
  // Region the logs are delivered to
  regionId string
  // Log Service project the logs are delivered to
  //
  // Null when the account has no dedicated project or it can no longer be read.
  logProject() alicloud.log.project
}

// Machine protected by Security Center
//
// A single asset in the Security Center inventory, keyed by uuid. Exposes the
// agent state, the vulnerability and risk counts attributed to the machine, and
// its network addresses. The clientStatus field is the coverage audit: an
// offline or unbound agent means the machine is in the inventory but not
// actually being protected.
alicloud.sas.machine @defaults("instanceName clientStatus vulCount riskCount") {
  // Security Center asset UUID, used as the lookup key
  uuid string
  // ID of the underlying instance
  instanceId string
  // Name of the instance
  instanceName string
  // Region ID the machine runs in
  regionId string
  // Operating system family, for example linux or windows
  os string
  // Operating system name and version
  osName string
  // Public IP address of the machine
  internetIp string
  // Private IP address of the machine
  intranetIp string
  // Security Center agent state
  //
  // Online when the agent is reporting, Offline when it has stopped, and
  // Uninstalled when no agent is present. Anything other than Online means the
  // machine is in the inventory without being protected.
  clientStatus string
  // Whether the machine is bound to the Security Center subscription
  //
  // False when the machine falls outside the purchased asset quota, so its
  // findings are reported but protection is not applied.
  bind bool
  // Number of unfixed vulnerabilities attributed to the machine
  vulCount int
  // Whether the machine has outstanding vulnerabilities
  vulStatus string
  // Number of outstanding risks attributed to the machine
  riskCount string
  // Whether the machine has outstanding risks
  riskStatus string
  // Whether the machine has outstanding alerts
  alarmStatus string
  // Number of security events recorded against the machine
  safeEventCount int
  // Number of baseline check failures on the machine
  healthCheckCount int
  // Whether the machine is exposed to the internet
  //
  // Non-zero when Security Center's exposure analysis found an internet-facing
  // path to the machine.
  exposedStatus int
  // Asset importance, where higher values mark more critical assets
  importance int
  // Protection edition applied to the machine
  authVersionName string
  // Asset type, for example ECS or a non-Alibaba Cloud server
  assetTypeName string
  // Cloud vendor hosting the machine
  vendorName string
  // ID of the Kubernetes cluster the machine belongs to
  clusterId string
  // Group the machine is filed under in the Security Center console
  groupTrace string
  // Time the machine was added to the inventory
  createdTime time
  // Time of the last recorded sign-in to the machine
  lastLoginTime time
  // ECS instance behind the machine
  //
  // Null when the machine is not an Alibaba Cloud ECS instance, which is the
  // case for servers onboarded from another cloud or from on-premises.
  ecsInstance() alicloud.ecs.instance
}

// Vulnerability found by Security Center
//
// A vulnerability seen across the protected machines, keyed by its type and
// name. The counts break the affected machines down by remediation urgency, so
// asapCount is the number that Security Center judges must be fixed
// immediately.
alicloud.sas.vulnerability @defaults("name aliasName type asapCount") {
  // Vulnerability identifier, for example a CVE or advisory ID
  name string
  // Human-readable vulnerability title
  aliasName string
  // Vulnerability category
  //
  // One of cve for Linux software vulnerabilities, sys for Windows system
  // vulnerabilities, cms for web content management vulnerabilities, app for
  // application vulnerabilities, emg for urgent vulnerabilities, or sca for
  // software component analysis findings.
  type string
  // Number of affected machines Security Center rates fix-immediately
  asapCount int
  // Number of affected machines Security Center rates fix-later
  laterCount int
  // Number of affected machines Security Center rates no-fix-required
  nntfCount int
  // Number of affected machines where the vulnerability has been handled
  handledCount int
  // Total number of successful fixes recorded for the vulnerability
  totalFixCount int
  // Time the vulnerability was last seen
  lastFoundTime time
  // Tags describing the vulnerability, for example whether an exploit exists
  tags string
  // Related vulnerability identifiers
  related string
  // Whether application self-protection can defend the vulnerability at runtime
  //
  // Non-zero when runtime defense covers the vulnerability, which mitigates it
  // without a patch.
  raspDefend int
}

// Baseline check failure found by Security Center
//
// A configuration baseline check that machines are failing, keyed by riskId.
// Exposes how many machines fail the check and the severity split of those
// failures, so a check with a high warningMachineCount is a systemic
// misconfiguration rather than a one-off.
alicloud.sas.baselineCheck @defaults("riskName level warningMachineCount") {
  // Baseline check ID, used as the lookup key
  riskId int
  // Name of the baseline check
  riskName string
  // Category of the baseline check
  typeAlias string
  // Subcategory of the baseline check
  subTypeAlias string
  // Severity of the check
  //
  // One of high, medium, or low.
  level string
  // Number of times the check has been run
  checkCount int
  // Number of high-severity failures of the check
  highWarningCount int
  // Number of medium-severity failures of the check
  mediumWarningCount int
  // Number of low-severity failures of the check
  lowWarningCount int
  // Number of machines currently failing the check
  warningMachineCount int
  // Time the failure was last observed
  lastFoundTime time
  // Whether a known exploit exists for the condition the check detects
  checkExploit bool
  // Whether the check applies to container workloads
  containerRisk bool
  // Whether the check applies to databases
  databaseRisk bool
}

// Alert raised by Security Center threat detection
//
// A single alert, keyed by its event ID. Exposes what was detected, where, and
// whether it has been handled, along with the container and Kubernetes context
// when the alert came from a containerized workload.
alicloud.sas.alarmEvent @defaults("alarmEventName level eventStatus instanceName") {
  // Event ID, used as the lookup key
  id int
  // Alert name
  alarmEventName string
  // Alert type
  alarmEventType string
  // Alert severity
  //
  // One of serious, suspicious, or remind.
  level string
  // Handling state of the alert
  //
  // A non-zero value marks the alert as still outstanding.
  eventStatus int
  // Description of what was detected
  description string
  // Attack stages the alert maps to
  stages string
  // Detection engine that raised the alert
  dataSource string
  // Security Center asset UUID of the affected machine
  uuid string
  // ID of the affected instance
  instanceId string
  // Name of the affected instance
  instanceName string
  // Public IP address of the affected machine
  internetIp string
  // Private IP address of the affected machine
  intranetIp string
  // ID of the affected container
  containerId string
  // Image the affected container was started from
  containerImageName string
  // ID of the Kubernetes cluster the alert came from
  k8sClusterId string
  // Kubernetes namespace the alert came from
  k8sNamespace string
  // Kubernetes pod the alert came from
  k8sPodName string
  // Time the activity behind the alert first occurred
  occurrenceTime time
  // Time the activity behind the alert was last seen
  lastTime time
  // Whether the alert can be handled from the console
  canBeDealOnLine bool
  // Whether the alert triggered automatic containment
  autoBreaking bool
  // Machine the alert was raised against
  //
  // Null when the alert carries no asset UUID, which is the case for alerts
  // raised against the account rather than a specific machine.
  machine() alicloud.sas.machine
}

// Cloud Enterprise Network
//
// Transit networking for the account. Exposes the CEN instances, each of which
// joins the networks attached to it into one routing domain, so a workload in
// one attached VPC can reach a workload in another regardless of region.
alicloud.cen {
  // Cloud Enterprise Network instances in the account
  instances() []alicloud.cen.instance
}

// Cloud Enterprise Network instance
//
// A single CEN, keyed by cenId. Every network attached to it can route to every
// other attached network, so the attachments list is the reachability boundary:
// a VPC attached here is reachable from every other attached VPC, across
// regions and across accounts, before security-group and ACL rules are
// considered.
alicloud.cen.instance @defaults("cenId name status protectionLevel") {
  // CEN instance ID, used as the lookup key
  cenId string
  // Name of the CEN instance
  name string
  // Description of the CEN instance
  description string
  // Instance status, for example Creating or Active
  status string
  // Level of DDoS protection applied to the CEN
  //
  // FULL when protection covers every attached network, or REDUCE for the
  // basic level.
  protectionLevel string
  // Whether the CEN carries IPv6 traffic
  //
  // ENABLE when IPv6 routing is on, DISABLE when the CEN carries IPv4 only.
  ipv6Level string
  // Resource group ID the CEN belongs to
  resourceGroupId string
  // Resource group that contains the CEN instance
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the CEN was created
  creationTime time
  // Tags on the CEN, as key-value pairs
  tags map[string]string
  // Networks attached to the CEN
  attachments() []alicloud.cen.attachment
}

// Network attached to a Cloud Enterprise Network
//
// A single network joined to a CEN, keyed by the cenId and the attached
// network's ID. The childInstanceType names what kind of network it is, and
// childInstanceOwnerId reveals attachments owned by another account, which
// extend reachability outside the account boundary.
alicloud.cen.attachment @defaults("childInstanceId childInstanceType childInstanceRegionId status") {
  // ID of the CEN the network is attached to
  cenId string
  // ID of the attached network
  childInstanceId string
  // Kind of attached network
  //
  // One of VPC, VBR for a virtual border router carrying an Express Connect
  // circuit, or CCN for a Cloud Connect Network.
  childInstanceType string
  // Region the attached network lives in
  childInstanceRegionId string
  // Account (UID) that owns the attached network
  //
  // A value other than the scanned account means the CEN reaches into another
  // account, extending the routing domain past the account boundary.
  childInstanceOwnerId int
  // Attachment status, for example Attached or Attaching
  status string
  // Time the network was attached
  attachTime time
  // VPC behind a VPC attachment
  //
  // Null for a VBR or CCN attachment, and for a VPC owned by another account,
  // which the scanned credential cannot read.
  vpc() alicloud.vpc.network
}

// VPN gateway
//
// A VPN gateway attached to a VPC, keyed by vpnGatewayId. Exposes the IPsec and
// SSL capabilities, the public address traffic arrives on, and the connections
// terminating on it. A gateway is how traffic reaches the VPC from outside
// Alibaba Cloud, so its connections describe reachability that security groups
// alone do not explain.
alicloud.vpc.vpnGateway @defaults("vpnGatewayId name status internetIp") {
  // SSL VPN servers hosted on the gateway
  //
  // Empty on a gateway that terminates site-to-site tunnels only. An SSL VPN
  // server is a remote-access path that individual client machines reach.
  sslVpnServers() []alicloud.vpc.sslVpnServer
  // VPN gateway ID, used as the lookup key
  vpnGatewayId string
  // Name of the gateway
  name string
  // Description of the gateway
  description string
  // Region ID the gateway runs in
  regionId string
  // Gateway status, for example active or provisioning
  status string
  // Billing status of the gateway, for example Normal or FinancialLocked
  businessStatus string
  // Public IP address the gateway terminates tunnels on
  internetIp string
  // Whether the gateway accepts IPsec connections
  ipsecVpnEnabled bool
  // Whether the gateway accepts SSL client connections
  //
  // An SSL gateway lets individual clients dial into the VPC rather than
  // joining a fixed network, so it widens reachability to anyone holding a
  // client certificate.
  sslVpnEnabled bool
  // Maximum number of concurrent SSL clients the gateway accepts
  sslMaxConnections int
  // Public IP address SSL clients connect to
  sslVpnInternetIp string
  // Gateway type, for example Normal or National-Standard
  vpnType string
  // Whether the gateway is reachable over the internet or only privately
  //
  // public for an internet-facing gateway, private for one reachable only from
  // within Alibaba Cloud.
  networkType string
  // Whether the gateway exchanges routes over BGP
  enableBgp bool
  // Whether the gateway automatically propagates learned routes to the VPC
  autoPropagate bool
  // Gateway bandwidth specification
  spec string
  // Billing method of the gateway
  chargeType string
  // Time the gateway was created
  createTime time
  // Time the gateway subscription ends
  endTime time
  // Resource group ID the gateway belongs to
  resourceGroupId string
  // Resource group that contains the VPN gateway
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags on the gateway, as key-value pairs
  tags map[string]string
  // VPC the gateway is attached to
  vpc() alicloud.vpc.network
  // vSwitch the gateway is placed in
  vswitch() alicloud.vpc.vswitch
  // Connections terminating on the gateway
  connections() []alicloud.vpc.vpnConnection
}

// VPN connection
//
// A single IPsec tunnel terminating on a VPN gateway, keyed by
// vpnConnectionId. The local and remote subnets are the reachability this
// connection creates: traffic from the remote subnet reaches the local one
// without crossing an internet gateway. The negotiated algorithms and lifetimes
// are exposed so weak cipher suites can be found, but the pre-shared key is
// deliberately not.
alicloud.vpc.vpnConnection @defaults("vpnConnectionId name status") {
  // VPN connection ID, used as the lookup key
  vpnConnectionId string
  // Name of the connection
  name string
  // Region ID the connection lives in
  regionId string
  // ID of the customer gateway representing the remote end
  customerGatewayId string
  // Customer gateway representing the remote end
  //
  // Null when the gateway has since been deleted, and when it lies outside the
  // scanned regions.
  customerGateway() alicloud.vpc.customerGateway
  // Connection status, for example ike_sa_established or active
  status string
  // Negotiation state of the tunnel
  state string
  // CIDR blocks on the Alibaba Cloud side reachable through the tunnel
  localSubnet string
  // CIDR blocks on the remote side reachable through the tunnel
  remoteSubnet string
  // Public IP address of the remote peer
  internetIp string
  // Whether configuration changes take effect immediately
  effectImmediately bool
  // Whether dead peer detection is enabled
  enableDpd bool
  // Whether NAT traversal is enabled
  enableNatTraversal bool
  // Whether the tunnel exchanges routes over BGP
  enableTunnelsBgp bool
  // Whether the connection is authorized across accounts
  //
  // True when the tunnel joins networks owned by different accounts.
  crossAccountAuthorized bool
  // Whether the connection attaches to a VPN gateway or a transit router
  attachType string
  // ID of the gateway or transit router the connection attaches to
  attachInstanceId string
  // IKE protocol version, either ikev1 or ikev2
  ikeVersion string
  // IKE negotiation mode, either main or aggressive
  //
  // Aggressive mode completes in fewer exchanges but sends identity
  // information before the channel is encrypted.
  ikeMode string
  // Encryption algorithm negotiated for the key exchange
  ikeEncryptionAlgorithm string
  // Authentication algorithm negotiated for the key exchange
  ikeAuthenticationAlgorithm string
  // Diffie-Hellman group used for the key exchange
  ikePfs string
  // Lifetime of the key-exchange security association in seconds
  ikeLifetime int
  // Encryption algorithm protecting the tunnel payload
  ipsecEncryptionAlgorithm string
  // Authentication algorithm protecting the tunnel payload
  ipsecAuthenticationAlgorithm string
  // Diffie-Hellman group used to rekey the tunnel
  ipsecPfs string
  // Lifetime of the tunnel security association in seconds
  ipsecLifetime int
  // Time the connection was created
  createTime time
  // Tunnels the connection is built from
  //
  // A dual-tunnel connection negotiates IKE and IPsec separately for each
  // tunnel, so every entry carries its own algorithms and lifetimes and a check
  // that only reads ikeEncryptionAlgorithm and ipsecEncryptionAlgorithm misses
  // whatever the second tunnel agreed to. Empty on a connection the API reports
  // without per-tunnel options.
  tunnels []alicloud.vpc.vpnConnection.tunnel
  // IKE encryption algorithms in effect across the connection
  //
  // Every distinct encryption algorithm negotiated for the key exchange,
  // spanning the connection and all of its tunnels, deduplicated and sorted. A
  // dual-tunnel connection is only as strong as its weaker tunnel, so the
  // weakest entry is the one that matters for an audit. Empty when neither the
  // connection nor any tunnel reports an algorithm.
  ikeEncryptionAlgorithms() []string
  // IPsec encryption algorithms in effect across the connection
  //
  // Every distinct encryption algorithm protecting the tunnel payload, spanning
  // the connection and all of its tunnels, deduplicated and sorted. A
  // dual-tunnel connection is only as strong as its weaker tunnel, so the
  // weakest entry is the one that matters for an audit. Empty when neither the
  // connection nor any tunnel reports an algorithm.
  ipsecEncryptionAlgorithms() []string
  // Diffie-Hellman groups in effect for the key exchange
  //
  // Every distinct group used for the key exchange, spanning the connection and
  // all of its tunnels, deduplicated and sorted. A dual-tunnel connection is
  // only as strong as its weaker tunnel, so the weakest entry is the one that
  // matters for an audit. Empty when neither the connection nor any tunnel
  // reports a group.
  ikePfsGroups() []string
  // Diffie-Hellman groups in effect for tunnel rekeying
  //
  // Every distinct group used to rekey the tunnel, spanning the connection and
  // all of its tunnels, deduplicated and sorted. A dual-tunnel connection is
  // only as strong as its weaker tunnel, so the weakest entry is the one that
  // matters for an audit. Empty when neither the connection nor any tunnel
  // reports a group.
  ipsecPfsGroups() []string
  // VPN gateway the connection terminates on
  vpnGateway() alicloud.vpc.vpnGateway
}

// VPN connection tunnel
//
// A single tunnel of an IPsec-VPN connection, keyed by tunnelId. A dual-tunnel
// connection runs two tunnels that each negotiate their own IKE and IPsec
// parameters, so the algorithms and lifetimes here describe that one tunnel and
// the weaker of the pair is the one that matters. The pre-shared key is
// deliberately not exposed.
alicloud.vpc.vpnConnection.tunnel @defaults("tunnelId role status ikeEncryptionAlgorithm") {
  // Tunnel ID, used as the lookup key
  tunnelId string
  // Position of the tunnel within the connection
  //
  // 1 for the first tunnel and 2 for the second on a dual-tunnel connection.
  tunnelIndex int
  // Which side of the pair the tunnel serves
  //
  // master for the tunnel carrying traffic, slave for the standby one.
  role string
  // Tunnel status, for example active or updating
  status string
  // Negotiation state of the tunnel
  state string
  // Public IP address the tunnel terminates on
  internetIp string
  // Customer gateway representing the remote end of the tunnel
  //
  // Each tunnel of a dual-tunnel connection may face a different remote
  // gateway. Null when the gateway has since been deleted, and when it lies
  // outside the scanned regions.
  customerGateway() alicloud.vpc.customerGateway
  // Whether dead peer detection is enabled on the tunnel
  enableDpd bool
  // Whether NAT traversal is enabled on the tunnel
  enableNatTraversal bool
  // IKE protocol version, either ikev1 or ikev2
  ikeVersion string
  // IKE negotiation mode, either main or aggressive
  //
  // Aggressive mode completes in fewer exchanges but sends identity
  // information before the channel is encrypted.
  ikeMode string
  // Encryption algorithm negotiated for the key exchange
  ikeEncryptionAlgorithm string
  // Authentication algorithm negotiated for the key exchange
  ikeAuthenticationAlgorithm string
  // Diffie-Hellman group used for the key exchange
  ikePfs string
  // Lifetime of the key-exchange security association in seconds
  //
  // Null when the API reports no lifetime for the tunnel.
  ikeLifetime int
  // Identifier the Alibaba Cloud side presents during IKE negotiation
  ikeLocalId string
  // Identifier the remote peer presents during IKE negotiation
  ikeRemoteId string
  // Encryption algorithm protecting the tunnel payload
  ipsecEncryptionAlgorithm string
  // Authentication algorithm protecting the tunnel payload
  ipsecAuthenticationAlgorithm string
  // Diffie-Hellman group used to rekey the tunnel
  ipsecPfs string
  // Lifetime of the tunnel security association in seconds
  //
  // Null when the API reports no lifetime for the tunnel.
  ipsecLifetime int
}

// Alibaba Cloud Container Registry
//
// Container Registry (ACR) instances in the account and what is published
// through them: the namespaces that group repositories, the repositories
// themselves and whether each is readable without credentials, the replication
// rules that copy images to other regions or accounts, and the scan rules that
// decide whether an image is examined before it runs. The images an ACK cluster
// pulls come from here, so this is where a container supply chain begins.
alicloud.acr {
  // Container Registry Enterprise Edition instances in the account
  instances() []alicloud.acr.instance
}

// Container Registry instance
//
// A single Enterprise Edition registry, keyed by instanceId. Reports the
// edition and state of the instance, whether its internet endpoint is switched
// on and which addresses that endpoint accepts, and the namespaces,
// repositories, replication rules and scan rules it holds.
alicloud.acr.instance @defaults("instanceName instanceSpecification instanceStatus regionId") {
  // Instance ID, used as the lookup key
  instanceId string
  // Instance name
  instanceName string
  // Enterprise Edition specification
  //
  // The purchased edition, such as Enterprise_Basic, Enterprise_Standard, or
  // Enterprise_Advanced. Vulnerability scanning and some replication features
  // are only available above the basic edition.
  instanceSpecification string
  // Instance status
  //
  // RUNNING for an instance serving traffic.
  instanceStatus string
  // Region the instance lives in
  regionId string
  // ID of the resource group the instance belongs to
  resourceGroupId string
  // Resource group the instance belongs to
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the instance
  tags map[string]string
  // Time the instance was created
  createTime time
  // Time the instance was last modified
  modifiedTime time
  // Whether the instance is reachable over the internet
  //
  // False means images can only be pulled from inside a linked VPC. True means
  // the registry answers on a public domain, and internetEndpointAclEnabled
  // decides whether anything narrows who may reach it.
  internetEndpointEnabled() bool
  // Whether an address list gates the internet endpoint
  //
  // False on an enabled internet endpoint means every source address may reach
  // the registry, leaving repository visibility as the only control.
  internetEndpointAclEnabled() bool
  // Addresses allowed to reach the internet endpoint
  //
  // The CIDR entries of the endpoint's address list. Empty when no list is
  // configured, which is not a restriction: an enabled endpoint with no
  // entries and no list enforcement accepts every source.
  internetEndpointAclEntries() []string
  // Public domains the instance answers on
  internetEndpointDomains() []string
  // Namespaces defined in the instance
  namespaces() []alicloud.acr.namespace
  // Repositories held in the instance
  repositories() []alicloud.acr.repository
  // Replication rules that copy images in or out of the instance
  syncRules() []alicloud.acr.syncRule
  // Rules that decide which images are scanned and when
  //
  // Empty when no scan rule is configured, in which case images are only
  // examined if someone starts a scan by hand.
  scanRules() []alicloud.acr.scanRule
}

// Container Registry namespace
//
// A namespace groups repositories inside one registry and sets the defaults new
// repositories inherit. Selected by namespaceName within an instance. The
// defaults matter on their own: a namespace that creates repositories on push
// and hands them public visibility turns a mistyped image name into a
// world-readable repository.
alicloud.acr.namespace @defaults("namespaceName defaultRepoType autoCreateRepo") {
  // Namespace ID
  namespaceId string
  // Namespace name, used as the selection key within an instance
  namespaceName string
  // ID of the instance holding the namespace
  instanceId string
  // Whether pushing an unknown repository name creates it
  //
  // True means a push to a name that does not exist yet creates the repository
  // with the namespace defaults rather than failing, so a typo or an unreviewed
  // push lands a new repository.
  autoCreateRepo bool
  // Visibility given to a repository created in this namespace
  //
  // Either PUBLIC or PRIVATE. PUBLIC together with autoCreateRepo means an
  // automatically created repository is readable without credentials.
  defaultRepoType string
  // Tag immutability given to a repository created in this namespace
  //
  // False means new repositories allow an existing tag to be repointed at
  // different content.
  defaultTagImmutability bool
  // Namespace status
  //
  // Either NORMAL or DELETING.
  namespaceStatus string
  // ID of the resource group the namespace belongs to
  resourceGroupId string
  // Resource group the namespace belongs to
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Repositories in the namespace
  repositories() []alicloud.acr.repository
}

// Container Registry repository
//
// One image repository, keyed by repoId. Reports whether the repository is
// readable without credentials, whether its tags can be overwritten after they
// have been deployed, and which namespace holds it.
alicloud.acr.repository @defaults("repoNamespaceName repoName repoType tagImmutability") {
  // Repository ID, used as the lookup key
  repoId string
  // Repository name
  repoName string
  // Name of the namespace holding the repository
  repoNamespaceName string
  // Namespace holding the repository
  namespace() alicloud.acr.namespace
  // ID of the instance holding the repository
  instanceId string
  // Repository visibility
  //
  // Either PUBLIC, which needs no credentials to pull, or PRIVATE.
  repoType string
  // Whether the repository can be pulled from the internet without credentials
  //
  // True only when the repository is PUBLIC and its instance answers on the
  // internet: a public repository inside an instance with no internet endpoint
  // is still reachable only from a linked VPC.
  isPublic() bool
  // Whether an existing tag can be overwritten
  //
  // False means a tag can be repointed at different content after it has been
  // deployed, so the image reviewed at build time is not necessarily the one
  // that runs.
  tagImmutability bool
  // Repository summary
  summary string
  // Repository status
  repoStatus string
  // How images reach the repository
  //
  // MANUAL for images pushed by a client, AUTO for images produced by a build
  // rule in the registry.
  repoBuildType string
  // ID of the resource group the repository belongs to
  resourceGroupId string
  // Resource group the repository belongs to
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Time the repository was created
  createTime time
  // Time the repository was last modified
  modifiedTime time
  // Image tags held in the repository
  //
  // Each tag names the image content a deployment pulls when it references
  // this repository by tag, and carries the scan findings for that content.
  imageTags() []alicloud.acr.repositoryTag
}

// Container Registry image tag
//
// A single tag in a Container Registry repository, keyed by the owning repoId
// and tag name. Exposes the image content the tag points at (digest, size, push
// time) and the vulnerability scan of that content. Use it to answer whether a
// cluster pulls an image carrying known high-severity vulnerabilities, which
// the scan rule alone cannot say because it configures the scan rather than
// reporting its findings.
alicloud.acr.repositoryTag @defaults("tag status vulnerabilityCount") {
  // ID of the registry instance holding the image
  instanceId string
  // ID of the repository holding the tag
  repoId string
  // Tag name, for example latest or v1.2.3
  tag string
  // Content digest the tag points at, for example sha256:abc123
  //
  // The digest, not the tag, identifies the bytes that run. On a repository
  // with tagImmutability off, the same tag can point at a different digest
  // tomorrow.
  digest string
  // Registry-assigned image ID
  imageId string
  // Size of the image in bytes
  imageSize int
  // Status of the image, for example NORMAL
  status string
  // Time the image was pushed
  createTime time
  // Time the image was last updated
  updateTime time
  // Scan status of the image
  //
  // One of SCANNING, COMPLETE, FAILED, or RETRYING. Empty when the registry
  // has never scanned the image, or when the scan status cannot be read.
  scanStatus() string
  // Whether a vulnerability scan of this image has completed
  //
  // False when the image has never been scanned, when a scan is still running,
  // and when the last scan failed. An unscanned image reports no
  // vulnerabilities, which must not be read as a clean image.
  scanned() bool
  // Vulnerabilities the registry found in the image
  //
  // Empty on an image that has not been scanned as well as on a clean one, so
  // read scanned alongside this.
  vulnerabilities() []alicloud.acr.vulnerability
  // Total number of vulnerabilities found in the image
  vulnerabilityCount() int
  // Number of high-severity vulnerabilities found in the image
  highSeverityCount() int
  // Number of medium-severity vulnerabilities found in the image
  mediumSeverityCount() int
  // Number of low-severity vulnerabilities found in the image
  lowSeverityCount() int
  // Number of vulnerabilities the scanner could not rate
  unknownSeverityCount() int
  // Whether the image carries a high-severity vulnerability
  //
  // False on an image that has never been scanned, which is a different fact
  // from a clean image; read scanned to tell them apart.
  hasHighSeverityVulnerabilities() bool
}

// Vulnerability found in a Container Registry image
//
// A single scan finding for one image tag. Exposes the CVE, its severity, the
// package that carries it, and the version that fixes it. Use it to find images
// running a package with a known fix available.
alicloud.acr.vulnerability @defaults("cveName severity feature version") {
  // CVE identifier, for example CVE-2021-3711
  cveName string
  // Alternative name the scanner uses for the vulnerability
  aliasName string
  // Severity rating
  //
  // One of High, Medium, Low, or Unknown.
  severity string
  // Description of the vulnerability
  description string
  // Reference URL for the vulnerability
  cveLink string
  // Path inside the image where the affected component was found
  cveLocation string
  // Package or component carrying the vulnerability
  feature string
  // Version of the package present in the image
  version string
  // Version that fixes the vulnerability, empty when no fix is published
  //
  // A non-empty value means the image can be rebuilt to remove the finding
  // today.
  versionFixed string
  // Packaging format the version numbers follow, for example dpkg or rpm
  versionFormat string
  // Image layer that introduced the affected component
  addedBy string
  // Command that installs the fixed version, empty when no fix is published
  fixCmd string
  // Kind of finding, cve for a system package or sca for an application dependency
  scanType string
}

// Container Registry replication rule
//
// A rule that copies images between registries, keyed by syncRuleId. Reports
// what the rule matches and where the copies land, so a rule that moves images
// into another account or region is visible as one.
alicloud.acr.syncRule @defaults("syncRuleName syncDirection targetRegionId crossUser") {
  // Replication rule ID, used as the lookup key
  syncRuleId string
  // Replication rule name
  syncRuleName string
  // Whether the rule crosses an account boundary
  //
  // True means the other end of the rule belongs to a different Alibaba Cloud
  // account, so images leave this account entirely.
  crossUser bool
  // Direction images move
  //
  // FROM copies from the source instance to the target instance, TO copies from
  // the target instance back to the source.
  syncDirection string
  // What the rule matches
  //
  // NAMESPACE replicates a whole namespace, REPO replicates a single
  // repository. A NAMESPACE rule keeps applying to repositories created after
  // the rule was written.
  syncScope string
  // How the rule fires
  //
  // INITIATIVE for a replication started on purpose, PASSIVE for one triggered
  // by a push.
  syncTrigger string
  // ID of the instance the rule was defined on
  localInstanceId string
  // Region of the instance the rule was defined on
  localRegionId string
  // Namespace the rule reads from
  localNamespaceName string
  // Repository the rule reads from
  //
  // Empty for a rule scoped to a whole namespace.
  localRepoName string
  // ID of the instance images are copied to
  //
  // The target can belong to another account, which has no resource here, so
  // this is the only view of it.
  targetInstanceId string
  // Region images are copied to
  targetRegionId string
  // Namespace images are copied into
  targetNamespaceName string
  // Repository images are copied into
  //
  // Empty for a rule scoped to a whole namespace.
  targetRepoName string
  // Regular expression selecting which namespaces the rule covers
  namespaceNameFilter string
  // Regular expression selecting which repositories the rule covers
  repoNameFilter string
  // Regular expression selecting which tags the rule copies
  tagFilter string
  // Time the rule was created
  createTime time
  // Time the rule was last modified
  modifiedTime time
}

// Container Registry scan rule
//
// A rule that decides which images are examined and when, keyed by scanRuleId.
// A registry with no scan rule only examines an image when someone asks it to,
// so an image can be pulled and run without ever having been looked at.
alicloud.acr.scanRule @defaults("ruleName scanType scanScope triggerType") {
  // Scan rule ID, used as the lookup key
  scanRuleId string
  // Scan rule name
  ruleName string
  // ID of the instance the rule applies to
  instanceId string
  // What the scan looks for
  //
  // VUL runs the cloud security scanner for vulnerabilities, SBOM runs content
  // analysis to inventory what an image contains.
  scanType string
  // What the rule covers
  //
  // REPO for a single repository, or the wider scope the rule was created with.
  scanScope string
  // Regular expression selecting which tags are scanned
  //
  // Empty when the rule covers every tag in scope.
  repoTagFilterPattern string
  // How the scan fires
  //
  // AUTO for a scan triggered by a push, so an image is examined as it arrives
  // rather than on request.
  triggerType string
  // Time the rule was created
  createTime time
  // Time the rule was last updated
  updateTime time
}

// Alibaba Cloud Elasticsearch
//
// Elasticsearch clusters in the account. A cluster holds indexed copies of
// whatever was shipped into it, which is often log and application data, and it
// can be published on a public endpoint of its own alongside a Kibana console.
// Reports what each cluster accepts connections on and which addresses are
// allowed to reach it.
alicloud.es {
  // Elasticsearch clusters in the account
  instances() []alicloud.es.instance
}

// Elasticsearch cluster
//
// A single Elasticsearch cluster, keyed by instanceId. Reports the engine
// version and node layout, whether the transport is plain HTTP, whether disks
// are encrypted, and, through its detail accessors, whether the cluster and its
// Kibana console answer on a public endpoint and which address lists gate them.
alicloud.es.instance @defaults("description instanceId esVersion status") {
  // Instance ID, used as the lookup key
  instanceId string
  // Cluster description, which is the name shown in the console
  description string
  // Elasticsearch version the cluster runs
  //
  // An unsupported version stops receiving security fixes, so the version is
  // part of the cluster's exposure and not only its capability.
  esVersion string
  // Cluster edition
  //
  // Values include x-pack for a standard commercial cluster and advanced for
  // the enterprise edition.
  instanceCategory() string
  // Cluster status
  //
  // One of active, activating, inactive, invalid, or unknown.
  status string
  // Region the cluster lives in
  regionId string
  // Billing method
  paymentType string
  // Number of data nodes in the cluster
  nodeAmount int
  // Number of zones the cluster spans
  zoneCount int
  // Whether the cluster runs dedicated master nodes
  dedicatedMaster bool
  // Protocol the cluster accepts connections on
  //
  // HTTP or HTTPS. HTTP means credentials and query results cross the network
  // in the clear, which matters most on a cluster that also answers publicly.
  protocol string
  // Private domain the cluster answers on
  domain string
  // Port the cluster answers on
  port int
  // Whether the data node disks are encrypted at rest
  diskEncrypted bool
  // VPC the cluster is attached to
  vpc() alicloud.vpc.network
  // vSwitch the cluster is attached to
  vswitch() alicloud.vpc.vswitch
  // ID of the resource group the cluster belongs to
  resourceGroupId string
  // Resource group the cluster belongs to
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the cluster
  tags map[string]string
  // Time the cluster was created
  createdAt time
  // Time the cluster was last updated
  updatedAt time
  // Whether the cluster answers on a public endpoint
  //
  // True means the cluster is reachable from outside its VPC, leaving
  // publicIpWhitelist as the control over who may connect.
  publicNetworkEnabled() bool
  // Public domain the cluster answers on
  //
  // Empty when no public endpoint is switched on.
  publicDomain() string
  // Port the public endpoint answers on
  publicPort() int
  // Addresses allowed to reach the public endpoint
  //
  // An entry of 0.0.0.0/0 leaves the cluster open to the whole internet, which
  // is the default the console offers when a public endpoint is switched on.
  publicIpWhitelist() []string
  // Whether the public endpoint whitelist admits every address
  //
  // True when an entry in publicIpWhitelist admits any source address: the
  // 0.0.0.0/0 block, the bare 0.0.0.0 the console writes for it, any other
  // block with a /0 prefix length, the % wildcard, an address range spanning
  // the whole space, or ::/0. Only the public endpoint whitelist is read, not
  // privateIpWhitelist or kibanaIpWhitelist. An empty whitelist reports false,
  // and an entry that cannot be parsed is not counted as open.
  whitelistAllowsAllAddresses() bool
  // Addresses allowed to reach the cluster from inside the VPC
  privateIpWhitelist() []string
  // Whether the Kibana console answers on a public endpoint
  //
  // Kibana reads everything the cluster holds, so a public console is a data
  // exposure in its own right even when the cluster endpoint stays private.
  kibanaPublicNetworkEnabled() bool
  // Public domain the Kibana console answers on
  kibanaDomain() string
  // Addresses allowed to reach the Kibana console
  kibanaIpWhitelist() []string
  // Whether the cluster is reachable from the internet
  //
  // True when either the cluster endpoint or the Kibana console answers
  // publicly. False means both are confined to the VPC.
  internetExposed() bool
}
