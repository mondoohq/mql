import core

option provider = "go.mondoo.com/mql/providers/alicloud"
option go_package = "go.mondoo.com/mql/providers/alicloud/resources"
option root = "alicloud"

// Alibaba Cloud
//
// Entry point for querying an Alibaba Cloud account. Exposes the account
// identity and the region IDs enabled on the account, and is the root from
// which the RAM, ECS, Auto Scaling, VPC, OSS, SLB, ALB, NLB, and
// managed-database resources are reached, along with the Container Service for
// Kubernetes, Function Compute, NAS file storage, Web Application Firewall,
// Cloud Firewall, Anti-DDoS, Security Center, Key Management Service,
// ActionTrail, Log Service, Cloud Config, CloudSSO, Cloud Enterprise Network,
// and Resource Directory resources.
alicloud @root {
  // Account (UID) that the active credential belongs to
  accountId() string
  // Region IDs enabled on the account, for example cn-hangzhou
  regions() []string
}

// Alibaba Cloud Resource Access Management
//
// Identity and access configuration for an Alibaba Cloud account. Exposes the
// RAM users, user groups, roles, and permission policies defined in the
// account, along with the account-wide password policy and the console and
// credential security preferences.
alicloud.ram {
  // RAM users in the account
  users() []alicloud.ram.user
  // RAM user groups in the account
  groups() []alicloud.ram.group
  // RAM roles in the account
  roles() []alicloud.ram.role
  // Permission policies in the account, both system and custom
  policies() []alicloud.ram.policy
  // Account-wide password policy for RAM users
  passwordPolicy() alicloud.ram.passwordPolicy
  // Console and credential security preferences for the account
  //
  // Deprecated in favor of allowUserToManageAccessKeys,
  // allowUserToManageMfaDevices, allowUserToManagePublicKeys,
  // allowUserToChangePassword, saveMfaTicketEnabled, loginNetworkMasks, and
  // loginSessionDuration. Every value here is null on an account whose
  // preferences cannot be read, and a null compares as true in an MQL `&&`
  // assertion, so a check written against this dict passes on the accounts it
  // was meant to catch.
  securityPreference() @maturity("deprecated") dict
  // Whether RAM users may create and rotate their own access keys
  //
  // A user who can mint their own long-lived keys can move credentials out of
  // any console-based control, including the MFA requirement on console
  // sign-in.
  allowUserToManageAccessKeys() bool
  // Whether RAM users may bind and unbind their own MFA devices
  //
  // A user who can unbind their own device can remove the second factor an MFA
  // requirement was meant to enforce.
  allowUserToManageMfaDevices() bool
  // Whether RAM users may manage their own public keys
  allowUserToManagePublicKeys() bool
  // Whether RAM users may change their own console password
  allowUserToChangePassword() bool
  // Whether the console remembers an MFA verification for the session
  //
  // When on, a browser that has passed MFA once is not challenged again for the
  // remembered period, so a stolen session skips the second factor.
  saveMfaTicketEnabled() bool
  // Network masks console sign-in is restricted to
  //
  // Console sign-in is refused from outside these CIDRs. An empty list means
  // sign-in is accepted from anywhere on the internet.
  loginNetworkMasks() []string
  // Console session duration in hours before re-authentication is required
  loginSessionDuration() int
}

// Resource Access Management user
//
// A single RAM identity, keyed by userName. Exposes the user profile (display
// name, email, mobile phone, comments) and lifecycle timestamps, plus the
// user's access keys, group memberships, attached policies, MFA device binding,
// and console login profile.
alicloud.ram.user {
  // User ID
  userId string
  // User name, used as the console sign-in name and the lookup key
  userName string
  // Display name
  displayName string
  // Email address bound to the user
  email string
  // Mobile phone number bound to the user
  mobilePhone string
  // Comments describing the user
  comments string
  // Time the user was created
  createDate time
  // Time the user was last updated
  updateDate time
  // Time the user last signed in to the console
  lastLoginDate() time
  // Access keys belonging to the user
  accessKeys() []alicloud.ram.accessKey
  // Groups the user belongs to
  groups() []alicloud.ram.group
  // Policy attachment records for policies attached directly to the user
  //
  // Each entry lists the policyName, policyType (System or Custom),
  // defaultVersion, description, and attachDate of a policy attached to the
  // user. Use attachedPolicies to reach the policy itself, including its
  // permission statements.
  policies() []dict
  // Policies attached directly to the user
  //
  // The permission policies granted to the user by direct attachment, not
  // counting policies the user inherits through group membership. Traverse to
  // policyDocument to inspect the permission statements a user holds, for
  // example to find users granted the AdministratorAccess system policy.
  attachedPolicies() []alicloud.ram.policy
  // Every policy the user holds, directly or through a group
  //
  // The union of attachedPolicies and the policies attached to each group the
  // user belongs to, with a policy held by both routes listed once. This is
  // the set that decides what a user can actually do, which attachedPolicies
  // alone understates whenever permissions are granted through groups. For
  // example
  // `alicloud.ram.users.where(effectivePolicies.any(allowsAdminAccess))`
  // finds every administrator in the account.
  effectivePolicies() []alicloud.ram.policy
  // Multi-factor authentication device bound to the user
  //
  // Deprecated in favor of mfaEnabled, mfaDeviceType, and
  // mfaDeviceSerialNumber. This dict is null for a user with no device bound,
  // and a null compares as true in an MQL `&&` assertion, so a check written
  // against it passes on exactly the users it was meant to catch.
  mfaDevice() @maturity("deprecated") dict
  // Console login profile for the user
  //
  // Deprecated in favor of consoleLoginEnabled, mfaBindRequired,
  // passwordResetRequired, and loginProfileCreateDate. This dict is null for a
  // user with no console access, and a null compares as true in an MQL `&&`
  // assertion.
  loginProfile() @maturity("deprecated") dict
  // Whether the user can sign in to the Alibaba Cloud console
  //
  // False for a user that holds only programmatic credentials. Console access
  // is what the password policy, the MFA requirement, and the login network
  // masks apply to, so it decides which account-wide controls reach this user
  // at all.
  consoleLoginEnabled() bool
  // Whether the user must bind an MFA device at the next console sign-in
  //
  // This is the enforcement flag, not the state: a user with it set may still
  // have no device bound today. Read mfaEnabled for whether a second factor is
  // in place now.
  mfaBindRequired() bool
  // Whether the user must change their password at the next console sign-in
  passwordResetRequired() bool
  // Whether a multi-factor authentication device is bound to the user
  //
  // False for a user with console access and no second factor, which is the
  // case a console-sign-in audit is looking for. Also false for a user with no
  // console access at all, where the question does not arise.
  mfaEnabled() bool
  // Type of the bound MFA device, for example VMFA, empty when none is bound
  mfaDeviceType() string
  // Serial number identifying the bound MFA device, empty when none is bound
  mfaDeviceSerialNumber() string
  // Time the console login profile was created, null when the user has no console access
  loginProfileCreateDate() time
}

// Resource Access Management access key
//
// An access key credential belonging to a RAM user, keyed by the owning
// userName and accessKeyId. Exposes the key status and creation time. The
// secret access key is never exposed.
alicloud.ram.accessKey {
  // User name that owns the access key
  userName string
  // RAM user that owns the access key
  user() alicloud.ram.user
  // Access key ID
  accessKeyId string
  // Key status
  //
  // Either Active or Inactive.
  status string
  // Time the access key was created
  createDate time
}

// Resource Access Management user group
//
// A collection of RAM users, keyed by groupName. Exposes the group metadata
// and lifecycle timestamps, plus the member users and the policies attached to
// the group.
alicloud.ram.group {
  // Group ID
  groupId string
  // Group name, used as the lookup key
  groupName string
  // Comments describing the group
  comments string
  // Time the group was created
  createDate time
  // Time the group was last updated
  updateDate time
  // Users that belong to the group
  users() []alicloud.ram.user
  // Policy attachment records for policies attached to the group
  //
  // Each entry lists the policyName, policyType (System or Custom),
  // defaultVersion, description, and attachDate of a policy attached to the
  // group. Use attachedPolicies to reach the policy itself, including its
  // permission statements.
  policies() []dict
  // Policies attached to the group
  //
  // The permission policies every member of the group inherits. Traverse to
  // policyDocument to inspect the permission statements granted through group
  // membership.
  attachedPolicies() []alicloud.ram.policy
}

// Resource Access Management role
//
// A RAM role that trusted identities can assume, keyed by roleName. Exposes the
// role identifiers, description, session limits, and tags, along with the trust
// policy that governs who may assume it and the permission policies attached to
// it.
alicloud.ram.role {
  // Role ID
  roleId string
  // Role name, used as the lookup key
  roleName string
  // Alibaba Cloud Resource Name of the role
  arn string
  // Description of the role
  description string
  // Time the role was created
  createDate time
  // Time the role was last updated
  updateDate time
  // Maximum session duration in seconds allowed when assuming the role
  maxSessionDuration int
  // Tags attached to the role
  tags map[string]string
  // Trust policy document controlling which identities may assume the role
  //
  // The assume-role policy as a JSON string, naming the principals permitted to
  // assume this role and the conditions on that trust.
  assumeRolePolicyDocument() string
  // Policy attachment records for policies attached to the role
  //
  // Each entry lists the policyName, policyType (System or Custom),
  // defaultVersion, description, and attachDate of a policy attached to the
  // role. Use attachedPolicies to reach the policy itself, including its
  // permission statements.
  policies() []dict
  // Policies attached to the role
  //
  // The permission policies a session that assumes this role receives.
  // Traverse to policyDocument alongside assumeRolePolicyDocument to see both
  // who may assume the role and what the assumed session is allowed to do.
  attachedPolicies() []alicloud.ram.policy
  // Parsed statements of the trust policy
  //
  // The assume-role policy decoded into statements, so the principals and the
  // conditions on the trust can be queried directly instead of by matching text
  // against assumeRolePolicyDocument.
  trustStatements() []alicloud.ram.policy.statement
  // Principals permitted to assume the role
  //
  // Every principal named by an allowing trust statement, across all principal
  // kinds, sorted and deduplicated. For example
  // `acs:ram::123456789:root`, `acs:ram::123456789:user/deploy`,
  // `ecs.aliyuncs.com`, or the wildcard `*`.
  trustedPrincipals() []string
  // Accounts permitted to assume the role
  //
  // The account IDs parsed out of the RAM principals in the trust policy,
  // sorted and deduplicated. Compare against the account under audit to find a
  // role a foreign account can assume, which is a cross-account takeover path
  // into whatever the role's attached policies grant.
  trustedAccountIds() []string
  // Alibaba Cloud services permitted to assume the role
  //
  // The Service principals in the trust policy, for example ecs.aliyuncs.com
  // or fc.aliyuncs.com. A service-linked role is expected to have these; a role
  // meant for humans is not.
  trustedServices() []string
  // Whether any identity may assume the role
  //
  // True when an allowing trust statement names the wildcard `*` as a
  // principal, which lets any Alibaba Cloud identity anywhere assume the role.
  hasWildcardPrincipal() bool
}

// Resource Access Management permission policy
//
// A permission policy. Exposes the policy metadata, attachment count, and
// default version, along with the policy document of the default version.
// System policies are managed by Alibaba Cloud; custom policies are defined in
// the account. The policyName and policyType fields together select a single
// policy, for example
// `alicloud.ram.policy(policyName: "AdministratorAccess", policyType: "System")`.
alicloud.ram.policy {
  // Policy name, used as the lookup key
  policyName string
  // Policy type
  //
  // Either System for an Alibaba Cloud managed policy or Custom for an
  // account-defined policy.
  policyType string
  // Description of the policy
  description string
  // Version ID of the default policy version, for example v1
  defaultVersion string
  // Number of entities the policy is attached to
  attachmentCount int
  // Time the policy was created
  createDate time
  // Time the policy was last updated
  updateDate time
  // Tags attached to the policy
  tags map[string]string
  // Policy document of the default version
  //
  // The permission statements of the default version as a JSON string.
  policyDocument() string
  // Permission statements of the default policy version
  //
  // The statements of policyDocument broken out one by one, each carrying the
  // effect, the actions and resources it names, and any condition placed on
  // the grant. Query into them to audit what a policy actually permits, for
  // example
  // `alicloud.ram.policies.where(policyType == "Custom") { policyName statements { effect action resource } }`.
  statements() []alicloud.ram.policy.statement
  // Whether the policy grants every action on every resource
  //
  // True when a statement allows action `*` on resource `*`, or on the fully
  // wildcarded `acs:*:*:*:*`, with no NotAction or NotResource exception
  // carved out of it. A condition on the statement does not clear the flag,
  // because the grant is still unrestricted wherever that condition holds.
  allowsAdminAccess() bool
  // Whether a granting statement names an action by wildcard
  //
  // True when any Allow statement names an action containing `*`, covering
  // both the full `*` and prefix forms such as `ecs:Describe*`. A prefix
  // wildcard is worth surfacing because it also grants actions the service
  // has not shipped yet. Deny statements are ignored.
  hasWildcardAction() bool
  // Whether a granting statement applies to a whole service
  //
  // True when any Allow statement names `*`, or an ACS resource name whose
  // relative ID is `*`, such as `acs:oss:*:*:*`. Only the relative ID counts:
  // the region and account fields are wildcarded in most real policies, so
  // `acs:oss:*:*:mybucket/*` names one bucket and does not set the flag. Deny
  // statements are ignored.
  hasUnscopedResource() bool
}

// Statement of a Resource Access Management permission policy
//
// A single permission statement out of a policy's default version. Exposes the
// effect, the actions and resources the statement names or excludes, and the
// condition constraining the grant. For example
// `alicloud.ram.policy(policyName: "AdministratorAccess", policyType: "System").statements`.
alicloud.ram.policy.statement @defaults("effect action resource") {
  // Effect of the statement
  //
  // Either Allow or Deny.
  effect string
  // Actions the statement applies to
  //
  // Each entry is either `service:Action`, a prefix wildcard such as
  // `ecs:Describe*`, or the full wildcard `*`. Empty when the statement uses
  // notAction instead.
  action []string
  // Actions excluded from the statement
  //
  // The statement applies to every action except these. Empty on the usual
  // statement, which names its actions through action.
  notAction []string
  // Resources the statement applies to
  //
  // Each entry is either the full wildcard `*` or an ACS resource name of the
  // form `acs:<service>:<region>:<account>:<relative-id>`. Empty when the
  // statement uses notResource instead, and on statements that name no
  // resource at all, such as a role trust statement.
  resource []string
  // Resources excluded from the statement
  //
  // The statement applies to every resource except these. Empty on the usual
  // statement, which names its resources through resource.
  notResource []string
  // Condition constraining the grant
  //
  // The condition block keyed by operator, for example
  // `{"StringEquals": {"acs:SourceVpc": ["vpc-1"]}}` or
  // `{"IpAddress": {"acs:SourceIp": ["10.0.0.0/8"]}}`. Null when the statement
  // grants unconditionally.
  condition dict
  // Identities the statement applies to
  //
  // Keyed by principal kind, for example
  // `{"RAM": ["acs:ram::123456789:root"], "Service": ["ecs.aliyuncs.com"]}`.
  // Null on a permission policy statement, which names actions and resources
  // rather than principals; set on a role trust statement and on a bucket
  // policy statement.
  principal dict
}

// Resource Access Management password policy
//
// Account-wide password requirements for RAM users. Exposes the minimum
// length, character-class requirements, expiration and reuse rules, and the
// failed-login lockout threshold.
private alicloud.ram.passwordPolicy {
  // Minimum number of characters required in a password
  minimumPasswordLength int
  // Whether passwords must contain a lowercase letter
  requireLowercaseCharacters bool
  // Whether passwords must contain an uppercase letter
  requireUppercaseCharacters bool
  // Whether passwords must contain a number
  requireNumbers bool
  // Whether passwords must contain a symbol
  requireSymbols bool
  // Whether an expired password blocks console sign-in until an administrator resets it
  //
  // When true, a user whose password has expired cannot sign in and an
  // administrator must reset the password. When false, the user may change the
  // expired password at sign-in.
  hardExpiry bool
  // Maximum password age in days before it must be changed, or 0 when passwords never expire
  maxPasswordAge int
  // Number of previous passwords that cannot be reused
  passwordReusePrevention int
  // Number of consecutive failed sign-in attempts before the user is locked out
  maxLoginAttempts int
}

// Elastic Compute Service (ECS)
//
// Compute resources in a region, including virtual machine instances,
// their attached block-storage disks, machine images, SSH key pairs, and
// the security groups that filter instance traffic. Fans out over every
// region enabled on the account.
alicloud.ecs {
  // ECS instances across all enabled regions
  instances() []alicloud.ecs.instance
  // Block-storage disks across all enabled regions
  disks() []alicloud.ecs.disk
  // Machine images visible to the account across all enabled regions
  images() []alicloud.ecs.image
  // SSH key pairs across all enabled regions
  keyPairs() []alicloud.ecs.keypair
  // Security groups across all enabled regions
  securityGroups() []alicloud.ecs.securitygroup
  // Prefix lists across all enabled regions
  //
  // A prefix list names a set of CIDR blocks that security group rules point at
  // instead of writing the blocks out, so a rule scoped to a list shows no CIDR
  // of its own until the list is read.
  prefixLists() []alicloud.ecs.prefixList
  // Disk snapshots across all enabled regions
  //
  // A snapshot holds a copy of a disk's contents and is encrypted (or not)
  // independently of the disk it came from, so an unencrypted snapshot of an
  // encrypted disk defeats the disk's own encryption.
  snapshots() []alicloud.ecs.snapshot
  // Instance launch templates across all enabled regions
  //
  // A launch template fixes the image, security groups, RAM role, key pair and
  // user data of every instance launched from it, so a weakness in a template
  // is reproduced on each new instance rather than existing on one.
  launchTemplates() []alicloud.ecs.launchTemplate
}

// Elastic Compute Service launch template
//
// A named instance launch template, keyed by launchTemplateId within its
// region. A template holds one or more versions, each fixing the image,
// security groups, RAM role, key pair, metadata-service settings and user data
// of the instances launched from it. Exposes the version list and which version
// is the default. Use it to audit the shape of instances that do not exist yet,
// which an instance-by-instance check cannot reach.
alicloud.ecs.launchTemplate @defaults("launchTemplateName launchTemplateId latestVersionNumber") {
  // Region ID the template resides in, for example cn-hangzhou
  regionId string
  // Launch template ID, used as the lookup key within its region
  launchTemplateId string
  // Name of the launch template
  launchTemplateName string
  // Account or service that created the template
  createdBy string
  // Version number used when a launch does not name one
  defaultVersionNumber int
  // Highest version number the template has
  //
  // A template whose default is behind its latest launches the older shape, so
  // a fix applied in a new version does not reach new instances until the
  // default moves.
  latestVersionNumber int
  // Time the template was created
  createTime time
  // Time the template was last modified
  modifiedTime time
  // ID of the resource group the template belongs to
  resourceGroupId string
  // Resource group that contains the template
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the template
  tags map[string]string
  // Versions of the template
  versions() []alicloud.ecs.launchTemplate.version
  // Version launched when a launch does not name one
  //
  // Null when the default version could not be read. This is the version that
  // actually shapes new instances, so it is the one an audit should read.
  defaultVersion() alicloud.ecs.launchTemplate.version
}

// Version of an Elastic Compute Service launch template
//
// A single version of a launch template, keyed by the owning launchTemplateId
// and version number. Exposes the instance shape the version launches: the
// image, security groups, RAM role, key pair, metadata-service settings, disk
// encryption, and user data. Use it to find a template that grants a broad RAM
// role, leaves the metadata service on IMDSv1, or embeds a credential in user
// data.
alicloud.ecs.launchTemplate.version @defaults("versionNumber instanceType isDefault") {
  // Region ID the template resides in
  regionId string
  // ID of the launch template the version belongs to
  launchTemplateId string
  // Version number
  versionNumber int
  // Description of the version
  versionDescription string
  // Whether this version launches when a launch does not name one
  isDefault bool
  // Account or service that created the version
  createdBy string
  // Time the version was created
  createTime time
  // Instance type launched, for example ecs.g6.large
  instanceType string
  // ID of the image launched
  imageId string
  // Image launched
  //
  // Null when the image has since been deleted, which also means the template
  // can no longer launch.
  image() alicloud.ecs.image
  // Where the image comes from, for example system, self, others, or marketplace
  imageOwnerAlias string
  // Zone the instance is launched into
  zoneId string
  // Name of the SSH key pair installed on launch, empty when none is installed
  keyPairName string
  // Whether the instance inherits the password of the image
  passwordInherit bool
  // Security-hardening applied at launch, for example Active or Deactive
  securityEnhancementStrategy string
  // RAM role attached to launched instances
  //
  // Null when the template attaches no role. An instance carrying a role can
  // mint credentials for it from the metadata service, so a broad role here is
  // granted to every instance the template launches.
  ramRole() alicloud.ram.role
  // IDs of the security groups applied at launch
  securityGroupIds []string
  // Security groups applied at launch
  //
  // A group that has since been deleted is left out, so this can be shorter
  // than securityGroupIds.
  securityGroups() []alicloud.ecs.securitygroup
  // VPC launched instances join
  //
  // Null when the template names no VPC, and when the VPC lies outside the
  // scanned regions.
  vpc() alicloud.vpc.network
  // vSwitch launched instances join
  //
  // Null when the template names no vSwitch, and when the vSwitch lies outside
  // the scanned regions.
  vswitch() alicloud.vpc.vswitch
  // Startup script and cloud-init data written into every launched instance
  //
  // The user data as plain text, decoded from the base64 form the API returns.
  // Every instance launched from this version receives it, and any process on
  // those instances that can reach the metadata service can read it back, so a
  // credential embedded here is exposed on every instance the template has ever
  // launched. Empty when the version carries no user data.
  userData string
  // Whether the instance metadata service is reachable, either enabled or disabled
  httpEndpoint string
  // Whether the metadata service demands a session token
  //
  // Either required, which is IMDSv2, or optional, which still answers the
  // token-less IMDSv1 request that a server-side request forgery can reach.
  httpTokens string
  // Whether the metadata service requires IMDSv2
  //
  // False when httpTokens is optional, which leaves the instance role
  // credentials reachable through a server-side request forgery against the
  // workload.
  imdsV2Required bool
  // Hop limit for metadata service responses
  //
  // A limit above 1 lets a container on the instance reach the metadata
  // service through the host's network namespace.
  httpPutResponseHopLimit int
  // Maximum inbound public bandwidth in Mbit/s, 0 when no public address is assigned
  internetMaxBandwidthIn int
  // Maximum outbound public bandwidth in Mbit/s
  //
  // A value above 0 assigns a public IP address to every instance the version
  // launches.
  internetMaxBandwidthOut int
  // Whether launched instances are protected from release
  deletionProtection bool
  // Preemption strategy, for example NoSpot, SpotWithPriceLimit, or SpotAsPriceGo
  spotStrategy string
  // Storage category of the system disk, for example cloud_essd
  systemDiskCategory string
  // Whether the system disk is encrypted
  systemDiskEncrypted bool
  // ID of the KMS key encrypting the system disk, empty when the service-managed key is used
  systemDiskKmsKeyId string
  // Whether the system disk is released with the instance
  systemDiskDeleteWithInstance bool
}

// Prefix list
//
// A named set of CIDR blocks that security group rules reference in place of a
// literal address range, keyed by prefixListId. A rule scoped to a prefix list
// carries no source or destination CIDR of its own, so the blocks it actually
// admits live here and nowhere else. associationCount reports how many rules
// and route tables point at the list, which is how far a change to it reaches.
alicloud.ecs.prefixList @defaults("prefixListName prefixListId addressFamily associationCount") {
  // Prefix list ID, used as the lookup key
  prefixListId string
  // Prefix list name
  prefixListName string
  // Prefix list description
  description string
  // Address family of the entries
  //
  // Either IPv4 or IPv6.
  addressFamily string
  // Maximum number of entries the list can hold
  maxEntries int
  // Number of resources that reference the list
  //
  // Counts the security group rules and route entries pointing at the list, so
  // a change to its blocks reaches every one of them.
  associationCount int
  // Region the prefix list lives in
  regionId string
  // ID of the resource group the prefix list belongs to
  resourceGroupId string
  // Resource group the prefix list belongs to
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the prefix list
  tags map[string]string
  // Time the prefix list was created
  creationTime time
  // CIDR blocks the list admits
  //
  // These are the addresses a rule scoped to this list actually matches. An
  // entry of 0.0.0.0/0 opens every rule that points at the list.
  cidrBlocks() []string
}

// Elastic Compute Service instance
//
// A single ECS virtual machine, keyed by the composite region and
// instanceId. Exposes the lifecycle status, the instance type and zone,
// hardware sizing (vCPUs, memory, GPUs), billing and charge configuration,
// the private, public, and elastic IP addresses, the VPC and vSwitch it is
// attached to, and the security groups controlling its traffic.
alicloud.ecs.instance @defaults("instanceId instanceName status instanceType") {
  // Instance ID, for example i-bp1234567890abcdef
  instanceId string
  // Instance name
  instanceName string
  // Instance description
  description string
  // Lifecycle status
  //
  // One of Pending, Running, Starting, Stopping, or Stopped.
  status string
  // Instance type, for example ecs.g5.large
  instanceType string
  // Instance type family, for example ecs.g5
  instanceTypeFamily string
  // Image the instance was created from
  image() alicloud.ecs.image
  // Region ID of the instance, for example cn-hangzhou
  regionId string
  // Zone ID of the instance, for example cn-hangzhou-g
  zoneId string
  // Number of vCPUs
  cpu int
  // Memory size in MiB
  memory int
  // Name of the operating system
  osName string
  // English name of the operating system
  osNameEn string
  // Operating system family
  //
  // One of windows or linux.
  osType string
  // Hostname of the instance
  hostName string
  // Serial number of the instance
  serialNumber string
  // Billing method of the instance
  //
  // One of PrePaid (subscription) or PostPaid (pay-as-you-go).
  instanceChargeType string
  // Bidding policy for a pay-as-you-go instance
  //
  // One of NoSpot, SpotWithPriceLimit, or SpotAsPriceGo.
  spotStrategy string
  // Maximum hourly price for a preemptible instance
  spotPriceLimit float
  // Protection period of a preemptible instance in hours
  spotDuration int
  // Billing method for network usage
  //
  // One of PayByBandwidth or PayByTraffic.
  internetChargeType string
  // Maximum inbound public bandwidth in Mbit/s
  internetMaxBandwidthIn int
  // Maximum outbound public bandwidth in Mbit/s
  internetMaxBandwidthOut int
  // Time when the instance was created
  creationTime time
  // Time when the instance was last started
  startTime time
  // Expiration time of the instance
  expiredTime time
  // Automatic release time of a pay-as-you-go instance
  autoReleaseTime time
  // Stopped-instance billing mode
  //
  // One of KeepCharging, StopCharging, or Not-applicable.
  stoppedMode string
  // Deployment set ID the instance belongs to
  deploymentSetId string
  // Name of the SSH key pair used by the instance
  keyPairName string
  // SSH key pair used by the instance
  //
  // Null on an instance launched without a key pair, and on one whose key pair
  // has since been deleted.
  keyPair() alicloud.ecs.keypair
  // Whether release protection is enabled
  deletionProtection bool
  // Whether the instance is I/O optimized
  ioOptimized bool
  // Number of GPUs attached to the instance
  gpuAmount int
  // GPU model of the instance type, for example NVIDIA V100
  gpuSpec string
  // Performance mode of a burstable instance
  //
  // One of Standard or Unlimited.
  creditSpecification string
  // Whether data disks can be attached to the instance
  deviceAvailable bool
  // Number of local disks attached to the instance
  localStorageAmount int
  // Capacity of local disks attached to the instance in GiB
  localStorageCapacity int
  // Resource group ID the instance belongs to
  resourceGroupId string
  // Resource group that contains the instance
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Network type of the instance
  //
  // One of classic or vpc.
  networkType string
  // VPC the instance is attached to
  vpc() alicloud.vpc.network
  // vSwitch the instance is connected to
  vswitch() alicloud.vpc.vswitch
  // Private IP addresses assigned to the instance
  privateIpAddresses []string
  // Public IP addresses assigned directly to the instance
  publicIpAddresses []string
  // Elastic IP address associated with the instance
  eipAddress string
  // Tags on the instance, as key-value pairs
  tags map[string]string
  // Security groups controlling the instance's traffic
  securityGroups() []alicloud.ecs.securitygroup
  // Whether the instance is reachable from the internet
  //
  // True when the instance has a directly-assigned public IP address or an
  // associated elastic IP address, indicating inbound reachability from the
  // public internet before security-group rules are considered.
  internetExposed() bool
  // Instance RAM role assumed by workloads on the instance
  //
  // The role whose temporary credentials the instance metadata service hands
  // to any process that can reach it. Traverse to attachedPolicies to see what
  // a workload on this instance is authorized to do, and therefore what an
  // attacker reaching the metadata service would inherit. Null when no
  // instance RAM role is attached.
  ramRole() alicloud.ram.role
  // Whether the instance metadata service endpoint is reachable
  //
  // False when the metadata endpoint is switched off entirely, which removes
  // the instance RAM role credential path from the instance.
  metadataEndpointEnabled bool
  // Whether a session token is required to read instance metadata
  //
  // Either optional, where a plain request to the metadata service returns
  // credentials, or required, where the caller must obtain a token first.
  // Requiring a token is what stops a server-side request forgery from reading
  // the instance RAM role credentials.
  metadataHttpTokens string
  // Maximum number of network hops a metadata response may travel
  //
  // A limit of 1 keeps metadata responses on the instance itself, so a
  // containerized workload on a bridged network cannot reach them.
  metadataHopLimit int
  // Startup script and cloud-init data supplied to the instance
  //
  // The user data as plain text, decoded from the base64 form the API returns.
  // Anything readable here is also readable by any process on the instance
  // that can reach the metadata service, so it is where hardcoded passwords,
  // API keys, and private registry credentials end up. Empty when the instance
  // was launched without user data.
  userData() string
}

// Elastic Compute Service disk
//
// A single block-storage disk (cloud disk or local disk), keyed by the
// composite region and diskId. Exposes the disk category and size, its
// attachment to an instance, encryption state and KMS key, snapshot
// behavior, and the performance level.
alicloud.ecs.disk @defaults("diskId diskName category size status") {
  // Disk ID, for example d-bp1234567890abcdef
  diskId string
  // Disk name
  diskName string
  // Disk description
  description string
  // Disk role
  //
  // One of system or data.
  type string
  // Disk category
  //
  // One of cloud, cloud_efficiency, cloud_ssd, cloud_essd, cloud_auto,
  // cloud_essd_entry, cloud_regional_disk_auto, elastic_ephemeral_disk_standard,
  // elastic_ephemeral_disk_premium, ephemeral, ephemeral_ssd, local_ssd_pro,
  // local_hdd_pro, or other local disk categories.
  category string
  // Disk size in GiB
  size int
  // Disk status
  //
  // One of In_use, Available, Attaching, Detaching, Creating, or ReIniting.
  status string
  // Whether the disk is encrypted
  encrypted bool
  // KMS key used to encrypt the disk, null when the disk is not encrypted
  kmsKey() alicloud.kms.key
  // Instance the disk is attached to
  instance() alicloud.ecs.instance
  // Device name the disk is mounted as, for example /dev/xvda
  device string
  // Whether the disk is released together with its instance
  deleteWithInstance bool
  // Whether automatic snapshots are deleted together with the disk
  deleteAutoSnapshot bool
  // Whether the automatic snapshot policy is enabled for the disk
  enableAutoSnapshot bool
  // Whether the disk can be detached
  portable bool
  // Zone ID of the disk
  zoneId string
  // Region ID of the disk
  regionId string
  // Time when the disk was created
  creationTime time
  // Time when the disk was last attached
  attachedTime time
  // Time when the disk was last detached
  detachedTime time
  // Performance level of an ESSD disk
  //
  // One of PL0, PL1, PL2, or PL3.
  performanceLevel string
  // Billing method of the disk
  //
  // One of PrePaid (subscription) or PostPaid (pay-as-you-go).
  diskChargeType string
  // Tags on the disk, as key-value pairs
  tags map[string]string
  // Snapshots taken from the disk
  //
  // A snapshot is encrypted independently of the disk it came from, so an
  // encrypted disk with an unencrypted snapshot has its contents readable
  // outside the protection the disk itself has.
  snapshots() []alicloud.ecs.snapshot
}

// Elastic Compute Service image
//
// A single machine image visible to the account, keyed by the composite
// region and imageId. Exposes the operating system and architecture, the
// image size and version, its ownership and sharing state, and whether it
// is public or supports cloud-init.
alicloud.ecs.image @defaults("imageId imageName osName status") {
  // Image ID, for example m-bp1234567890abcdef
  imageId string
  // Image name
  imageName string
  // Image description
  description string
  // Name of the operating system in the image
  osName string
  // Operating system family
  //
  // One of windows or linux.
  osType string
  // CPU architecture of the image
  //
  // One of i386, x86_64, or arm64.
  architecture string
  // Image size in GiB
  size int
  // Alias of the image owner
  //
  // One of system, self, others, or marketplace.
  imageOwnerAlias string
  // Image status
  //
  // One of UnAvailable, Available, Creating, or CreateFailed.
  status string
  // Whether the image is public
  isPublic bool
  // Whether the image is shared to other accounts by the owner
  isSelfShared string
  // Whether the image supports cloud-init
  isSupportCloudinit bool
  // Platform of the operating system, for example CentOS or Ubuntu
  platform string
  // Time when the image was created
  creationTime time
  // Image version
  imageVersion string
  // How the image is used
  //
  // One of instance, none, or reserved.
  usage string
  // Region ID of the image
  regionId string
  // Accounts the image is shared with
  //
  // Each entry is the Alibaba Cloud account the owner granted use of the image
  // to. isPublic covers exposure through the marketplace; this covers a share
  // to a named account, which that check does not see.
  sharedAccounts() []string
  // Share groups the image is shared with
  //
  // Each entry names a group of accounts, for example ALL, that may use the
  // image.
  shareGroups() []string
  // Whether the image is shared outside the owning account
  //
  // True when the image is shared with at least one account or share group.
  // False when nothing is shared, and when the share permissions could not be
  // read, so this must not stand alone as evidence that an image is private.
  isShared() bool
}

// Elastic Compute Service disk snapshot
//
// A point-in-time copy of a disk's contents, keyed by snapshotId within its
// region. Exposes the source disk, the encryption state and key, the retention
// setting, and the snapshot lifecycle. Use it to find an unencrypted snapshot
// of an encrypted disk, which puts the disk's contents outside the protection
// the disk itself has.
alicloud.ecs.snapshot @defaults("snapshotName snapshotId status encrypted") {
  // Region ID the snapshot resides in, for example cn-hangzhou
  regionId string
  // Snapshot ID, used as the lookup key within its region
  snapshotId string
  // Name of the snapshot
  snapshotName string
  // Description of the snapshot
  description string
  // ID of the disk the snapshot was taken from
  sourceDiskId string
  // Disk the snapshot was taken from
  //
  // Null when the disk has since been deleted, and when it lies outside the
  // scanned regions. Compare its encrypted field with this snapshot's to find a
  // snapshot that is not protected to the same standard as its source.
  disk() alicloud.ecs.disk
  // Size of the source disk in GiB
  sourceDiskSize string
  // Kind of the source disk, either system or data
  sourceDiskType string
  // Region the snapshot was copied from, empty when it was not copied
  sourceRegionId string
  // ID of the snapshot this one was copied from, empty when it was not copied
  sourceSnapshotId string
  // Whether the snapshot contents are encrypted
  encrypted bool
  // ID of the KMS key that encrypts the snapshot, empty when none is used
  kmsKeyId string
  // KMS key that encrypts the snapshot
  //
  // Null when the snapshot is unencrypted, and when it is encrypted with the
  // service-managed key rather than a customer master key.
  kmsKey() alicloud.kms.key
  // Whether a customer master key protects the snapshot
  //
  // False both for an unencrypted snapshot and for one encrypted with the
  // service-managed key, where key rotation and revocation are not under the
  // account's control.
  encryptedWithCustomerKey bool
  // Lifecycle status of the snapshot
  //
  // One of progressing, accomplished, or failed. Only an accomplished snapshot
  // can be restored.
  status string
  // Percentage of the snapshot that has been taken, for example 100%
  progress string
  // Whether the snapshot can be used to create a disk or image
  available bool
  // Storage category of the snapshot, for example standard or flash
  category string
  // Days the snapshot is retained before automatic deletion, 0 when it is retained indefinitely
  retentionDays int
  // How the snapshot was created, one of user, or auto or timer for an automatic snapshot policy
  snapshotType string
  // What the snapshot is used by, for example image, disk, image_disk, or none
  usage string
  // Size of the full snapshot in bytes
  fullSnapshotSizeInBytes int
  // Whether instant access is enabled for the snapshot
  instantAccess bool
  // Time the snapshot was created
  creationTime time
  // Time the snapshot was last modified
  lastModifiedTime time
  // ID of the resource group the snapshot belongs to
  resourceGroupId string
  // Resource group that contains the snapshot
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the snapshot
  tags map[string]string
}

// Elastic Compute Service SSH key pair
//
// A single SSH key pair, keyed by the composite region and keyPairName.
// Exposes the public-key fingerprint, the creation time, and the resource
// group the key pair belongs to.
alicloud.ecs.keypair @defaults("keyPairName") {
  // Key pair name
  keyPairName string
  // Fingerprint of the public key
  keyPairFingerPrint string
  // Time when the key pair was created
  creationTime time
  // Resource group ID the key pair belongs to
  resourceGroupId string
  // Resource group that contains the key pair
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Region ID of the key pair
  regionId string
  // Tags on the key pair, as key-value pairs
  tags map[string]string
}

// Elastic Compute Service security group
//
// A single security group, keyed by the composite region and
// securityGroupId. Exposes the group name and type, the VPC it belongs to,
// its inbound and outbound rules, and the instances it is applied to.
alicloud.ecs.securitygroup @defaults("securityGroupId securityGroupName securityGroupType") {
  // Security group ID, for example sg-bp1234567890abcdef
  securityGroupId string
  // Security group name
  securityGroupName string
  // Security group description
  description string
  // VPC ID the security group belongs to
  //
  // Deprecated in favor of vpc.
  vpcId @maturity("deprecated") @replaced_by("alicloud.ecs.securitygroup.vpc") string
  // VPC the security group belongs to
  //
  // Null on a classic-network security group, which is not in a VPC.
  vpc() alicloud.vpc.network
  // Security group type
  //
  // One of normal or enterprise.
  securityGroupType string
  // Time when the security group was created
  creationTime time
  // Region ID of the security group
  regionId string
  // Resource group ID the security group belongs to
  resourceGroupId string
  // Resource group that contains the security group
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags on the security group, as key-value pairs
  tags map[string]string
  // Inbound and outbound rules of the security group
  permissions() []alicloud.ecs.securitygroup.permission
  // Instances the security group is applied to
  instances() []alicloud.ecs.instance
}

// Elastic Compute Service security group rule
//
// A single inbound or outbound rule of a security group, keyed by the
// security group ID, direction, and position. Exposes the protocol and
// port range, the source and destination CIDR blocks, referenced security
// groups, prefix lists, and the accept or drop policy.
alicloud.ecs.securitygroup.permission @defaults("direction ipProtocol portRange policy") {
  // Rule ID
  securityGroupRuleId string
  // Rule direction
  //
  // One of ingress or egress.
  direction string
  // Access policy of the rule
  //
  // One of Accept or Drop.
  policy string
  // Priority of the rule, from 1 (highest) to 100 (lowest)
  priority string
  // Transport protocol the rule matches
  //
  // One of TCP, UDP, ICMP, ICMPv6, GRE, or ALL.
  ipProtocol string
  // Network interface type the rule applies to
  //
  // One of internet or intranet.
  nicType string
  // Destination port range matched by the rule, for example 22/22 or 1/65535
  portRange string
  // Lowest destination port the rule matches
  //
  // A rule written as -1/-1 matches every port, and reports 1 here alongside
  // 65535 in toPort. Null when portRange holds no range that resolves to a
  // pair of ports, which leaves portRange as the only record of it.
  fromPort int
  // Highest destination port the rule matches
  //
  // A rule written as -1/-1 matches every port, and reports 65535 here
  // alongside 1 in fromPort. Null when portRange holds no range that resolves
  // to a pair of ports.
  toPort int
  // Source port range matched by the rule
  sourcePortRange string
  // Source IPv4 CIDR block for an inbound rule
  sourceCidrIp string
  // Source security group for an inbound rule
  sourceSecurityGroup() alicloud.ecs.securitygroup
  // Source prefix list ID for an inbound rule
  //
  // Deprecated in favor of sourcePrefixList.
  sourcePrefixListId @maturity("deprecated") @replaced_by("alicloud.ecs.securitygroup.permission.sourcePrefixList") string
  // Source prefix list for an inbound rule
  //
  // Null unless the rule is scoped to a prefix list. When it is set, the rule
  // has no sourceCidrIp of its own and the list's cidrBlocks are what the rule
  // admits.
  sourcePrefixList() alicloud.ecs.prefixList
  // Source IPv6 CIDR block for an inbound rule
  ipv6SourceCidrIp string
  // Effective IPv4 source CIDR blocks of an inbound rule
  //
  // Combines sourceCidrIp with the cidrBlocks of the prefix list the rule is
  // scoped to, so one list holds every IPv4 address the rule admits. An entry
  // of 0.0.0.0/0 means the rule admits the whole internet. Empty for an
  // outbound rule, for a rule scoped to a security group, and for a rule whose
  // only source is IPv6. When the prefix list cannot be read, the list carries
  // only the rule's own sourceCidrIp.
  sourceCidrs() []string
  // Effective IPv6 source CIDR blocks of an inbound rule
  //
  // Combines ipv6SourceCidrIp with the cidrBlocks of the prefix list the rule
  // is scoped to, when that list holds IPv6 entries. An entry of ::/0 means the
  // rule admits the whole IPv6 internet. Empty for an outbound rule and for a
  // rule whose only source is IPv4. When the prefix list cannot be read, the
  // list carries only the rule's own ipv6SourceCidrIp.
  ipv6SourceCidrs() []string
  // Destination IPv4 CIDR block for an outbound rule
  destCidrIp string
  // Destination security group for an outbound rule
  destSecurityGroup() alicloud.ecs.securitygroup
  // Destination prefix list ID for an outbound rule
  //
  // Deprecated in favor of destPrefixList.
  destPrefixListId @maturity("deprecated") @replaced_by("alicloud.ecs.securitygroup.permission.destPrefixList") string
  // Destination prefix list for an outbound rule
  //
  // Null unless the rule is scoped to a prefix list. When it is set, the rule
  // has no destCidrIp of its own and the list's cidrBlocks are what the rule
  // permits traffic to reach.
  destPrefixList() alicloud.ecs.prefixList
  // Destination IPv6 CIDR block for an outbound rule
  ipv6DestCidrIp string
  // Effective IPv4 destination CIDR blocks of an outbound rule
  //
  // Combines destCidrIp with the cidrBlocks of the prefix list the rule is
  // scoped to, so one list holds every IPv4 address the rule permits traffic to
  // reach. An entry of 0.0.0.0/0 means the rule permits traffic to the whole
  // internet. Empty for an inbound rule, for a rule scoped to a security group,
  // and for a rule whose only destination is IPv6. When the prefix list cannot
  // be read, the list carries only the rule's own destCidrIp.
  destinationCidrs() []string
  // Effective IPv6 destination CIDR blocks of an outbound rule
  //
  // Combines ipv6DestCidrIp with the cidrBlocks of the prefix list the rule is
  // scoped to, when that list holds IPv6 entries. An entry of ::/0 means the
  // rule permits traffic to the whole IPv6 internet. Empty for an inbound rule
  // and for a rule whose only destination is IPv4. When the prefix list cannot
  // be read, the list carries only the rule's own ipv6DestCidrIp.
  ipv6DestinationCidrs() []string
  // Rule description
  description string
  // Time when the rule was created
  createTime time
}

// Auto Scaling
//
// Scaling groups and the scaling configurations they launch instances from,
// across every enabled region on the account. Instances created by a scaling
// group are transient, so the scaling configuration is the durable record of
// how they are built: the user data written into them, the RAM role and
// security groups they receive, the image they boot, and the metadata service
// hardening they inherit.
alicloud.ess {
  // Scaling groups across all enabled regions
  scalingGroups() []alicloud.ess.scalingGroup
  // Scaling configurations across all enabled regions
  scalingConfigurations() []alicloud.ess.scalingConfiguration
}

// Auto Scaling scaling group
//
// A scaling group and the sizing, placement, and health-check settings that
// govern it, along with the scaling configurations it can launch from and the
// one currently active. The scalingGroupId and regionId fields together select
// a single group, for example
// `alicloud.ess.scalingGroup(scalingGroupId: "asg-bp1abc", regionId: "cn-hangzhou")`.
alicloud.ess.scalingGroup @defaults("name scalingGroupId lifecycleState totalCapacity") {
  // Scaling group ID
  scalingGroupId string
  // Scaling group name
  name string
  // Region ID the scaling group resides in, for example cn-hangzhou
  regionId string
  // Lifecycle state of the scaling group
  //
  // One of Active, Inactive, or Deleting. Only an Active group launches and
  // releases instances.
  lifecycleState string
  // Kind of instance the group manages
  //
  // Either ECS for Elastic Compute Service instances or ECI for elastic
  // container instances.
  groupType string
  // Minimum number of instances the group maintains
  minSize int
  // Maximum number of instances the group may create
  maxSize int
  // Expected number of instances the group tries to hold
  desiredCapacity int
  // Number of instances currently in the group
  totalCapacity int
  // Number of instances in the group that are serving traffic
  activeCapacity int
  // Seconds after a scaling activity before another may start
  defaultCooldown int
  // How the group decides an instance is unhealthy
  //
  // One of ECS, where the group replaces instances the ECS service reports as
  // unhealthy, LOAD_BALANCER, or NONE, which disables replacement entirely.
  healthCheckType string
  // How instances are spread across zones
  //
  // One of PRIORITY, BALANCE, COST_OPTIMIZED, or COMPOSABLE.
  multiAZPolicy string
  // Reclaim mode applied when the group removes an instance
  //
  // One of recycle, which stops the instance, release, which deletes it,
  // forcerelease, or forcerecycle.
  scalingPolicy string
  // Whether the group is protected from deletion
  groupDeletionProtection bool
  // Scaling processes the group has been told to stop running
  //
  // Any of ScaleIn, ScaleOut, HealthCheck, AlarmNotification, or
  // ScheduledAction. A suspended HealthCheck stops unhealthy instances being
  // replaced, so a group can sit degraded without any activity recorded.
  suspendedProcesses []string
  // Whether Auto Scaling itself has suspended the group
  systemSuspended bool
  // Maximum seconds an instance may stay in the group before replacement
  //
  // Zero when instances are never replaced on age alone, which lets a
  // long-lived instance drift from the image the group launches today.
  maxInstanceLifetime int
  // ID of the resource group the scaling group belongs to
  resourceGroupId string
  // Resource group that contains the scaling group
  resourceGroup() alicloud.resourceManager.resourceGroup
  // ID of the launch template the group creates instances from
  //
  // Empty on a group that launches from a scaling configuration instead. When
  // set, the instance shape lives in the launch template rather than in
  // scalingConfigurations, so those settings are not visible here.
  launchTemplateId string
  // Version of the launch template the group uses
  //
  // A version number, or Latest or Default. Empty when the group launches from
  // a scaling configuration.
  launchTemplateVersion string
  // Launch template the group creates instances from
  //
  // Null when the group launches from a scaling configuration instead, and when
  // the template has since been deleted. Traverse to its versions to see the
  // image, security groups, RAM role and user data the group's instances get.
  launchTemplate() alicloud.ecs.launchTemplate
  // Time the scaling group was created
  creationTime time
  // Time the scaling group was last modified
  modificationTime time
  // VPC the scaling group launches instances into
  //
  // Null on a classic-network group.
  vpc() alicloud.vpc.network
  // vSwitches the scaling group may place instances in
  //
  // The subnets available to the group, which determine the zones it can
  // spread across. Empty on a classic-network group.
  vswitches() []alicloud.vpc.vswitch
  // Scaling configuration the group currently launches from
  //
  // Null when the group has no active configuration, which is the case for a
  // group that launches from a launch template.
  activeScalingConfiguration() alicloud.ess.scalingConfiguration
  // Scaling configurations defined on the group
  //
  // Every configuration attached to the group, active or not. An inactive
  // configuration still ships whatever user data and permissions it holds the
  // moment someone makes it active.
  scalingConfigurations() []alicloud.ess.scalingConfiguration
}

// Auto Scaling scaling configuration
//
// The instance template a scaling group launches from: the image and instance
// type, the user data written into every instance, the RAM role and security
// groups each instance receives, the metadata service hardening, and the
// system disk encryption. The scalingConfigurationId and regionId fields
// together select a single configuration, for example
// `alicloud.ess.scalingConfiguration(scalingConfigurationId: "asc-bp1abc", regionId: "cn-hangzhou")`.
alicloud.ess.scalingConfiguration @defaults("name scalingConfigurationId instanceType lifecycleState") {
  // Scaling configuration ID
  scalingConfigurationId string
  // Scaling configuration name
  name string
  // Region ID the scaling configuration resides in, for example cn-hangzhou
  regionId string
  // Lifecycle state of the scaling configuration
  //
  // Either Active, meaning the scaling group launches instances from this
  // configuration, or Inactive.
  lifecycleState string
  // Instance type launched from this configuration, for example ecs.g6.large
  instanceType string
  // Startup script and cloud-init data written into every instance
  //
  // The user data as plain text, decoded from the base64 form the API returns.
  // Every instance the group launches receives it, and any process on those
  // instances that can reach the metadata service can read it back, so a
  // credential embedded here is exposed on every instance the group has ever
  // created. Empty when the configuration carries no user data.
  userData string
  // Where the image comes from
  //
  // One of system for an Alibaba Cloud public image, self for a private image
  // in the account, others for an image shared from another account, or
  // marketplace.
  imageOwnerAlias string
  // Whether a session token is required to read instance metadata
  //
  // Either optional, where a plain request to the metadata service returns
  // credentials, or required, where the caller must obtain a token first.
  // Requiring a token is what stops a server-side request forgery on a
  // launched instance from reading the RAM role credentials.
  metadataHttpTokens string
  // Whether the instance metadata service endpoint is reachable
  //
  // False when the metadata endpoint is switched off entirely, which removes
  // the RAM role credential path from every instance the group launches.
  metadataEndpointEnabled bool
  // Whether launched instances keep the password baked into the image
  //
  // True when the configuration inherits the image password rather than
  // setting one, which leaves every instance sharing whatever credential the
  // image was built with.
  passwordInherit bool
  // Whether a logon password is configured
  //
  // True when the configuration sets a password for the instance, enabling
  // password logon alongside or instead of key-pair logon. The password itself
  // is never returned.
  passwordSet bool
  // Hardening applied to the operating system at launch
  //
  // Either Active, which installs the Security Center agent on each instance,
  // or Deactive.
  securityEnhancementStrategy string
  // Maximum inbound public bandwidth in Mbit/s
  internetMaxBandwidthIn int
  // Maximum outbound public bandwidth in Mbit/s
  //
  // A value above zero means every instance the group launches is assigned a
  // public IP address, making it reachable from the internet subject to its
  // security groups. Zero means instances get no public address.
  internetMaxBandwidthOut int
  // Whether the system disk is encrypted at rest
  systemDiskEncrypted bool
  // System disk category
  //
  // One of cloud, cloud_efficiency, cloud_ssd, cloud_essd, cloud_auto, or
  // ephemeral_ssd.
  systemDiskCategory string
  // System disk size in GiB
  systemDiskSize int
  // Whether launched instances are protected from deletion
  deletionProtection bool
  // Purchasing option for launched instances
  //
  // One of NoSpot for pay-as-you-go, SpotWithPriceLimit, or SpotAsPriceGo.
  spotStrategy string
  // Tenancy of the underlying host
  //
  // Either default for shared hosts or host for a dedicated host.
  tenancy string
  // Confidential computing mode of launched instances
  //
  // Either Enclave or TDX when the instance builds a confidential computing
  // environment. Empty when confidential computing is not configured.
  confidentialComputingMode string
  // Time the scaling configuration was created
  creationTime time
  // Scaling group the configuration belongs to
  scalingGroup() alicloud.ess.scalingGroup
  // RAM role granted to every instance the configuration launches
  //
  // The role whose temporary credentials the metadata service hands to any
  // process on a launched instance. Traverse to attachedPolicies to see what a
  // workload on those instances is authorized to do. Null when no instance RAM
  // role is configured.
  ramRole() alicloud.ram.role
  // Security groups applied to every instance the configuration launches
  //
  // Traverse to permissions to see the inbound rules that will apply to each
  // new instance, which is where a group launching into an open security group
  // shows up.
  securityGroups() []alicloud.ecs.securitygroup
  // Image launched instances boot from
  //
  // Null when the image has been deleted or is not visible to the account,
  // which leaves the configuration unable to launch.
  image() alicloud.ecs.image
  // Key pair installed on every instance the configuration launches
  //
  // Null when the configuration installs no key pair, in which case logon
  // depends on a password, and also when the named key pair has since been
  // deleted.
  keyPair() alicloud.ecs.keypair
  // KMS key encrypting the system disk
  //
  // Null when the system disk is unencrypted, or when it is encrypted with the
  // service-managed key rather than a customer master key.
  systemDiskKmsKey() alicloud.kms.key
}

// Virtual Private Cloud (VPC)
//
// Entry point for the Alibaba Cloud VPC networking service. Exposes the VPCs,
// vSwitches, route tables, NAT gateways, elastic IP addresses, and network ACLs
// defined across every enabled region on the account.
alicloud.vpc {
  // VPC networks across all enabled regions
  networks() []alicloud.vpc.network
  // vSwitches (subnets) across all enabled regions
  vswitches() []alicloud.vpc.vswitch
  // Route tables across all enabled regions
  routeTables() []alicloud.vpc.routeTable
  // NAT gateways across all enabled regions
  natGateways() []alicloud.vpc.natGateway
  // Elastic IP addresses across all enabled regions
  eipAddresses() []alicloud.vpc.eipAddress
  // Network ACLs across all enabled regions
  networkAcls() []alicloud.vpc.networkAcl
  // Flow logs across all enabled regions
  flowLogs() []alicloud.vpc.flowLog
  // VPN gateways across all enabled regions
  vpnGateways() []alicloud.vpc.vpnGateway
  // VPN connections across all enabled regions
  vpnConnections() []alicloud.vpc.vpnConnection
  // SSL VPN servers across all enabled regions
  //
  // An SSL VPN server admits individual client machines into the VPC over TLS,
  // which is a different ingress path from the site-to-site IPsec tunnels that
  // vpnConnections covers, and one that reaches the VPC from any address a
  // client certificate is installed on.
  sslVpnServers() []alicloud.vpc.sslVpnServer
  // Customer gateways across all enabled regions
  //
  // A customer gateway represents the remote end of a site-to-site VPN tunnel:
  // the public address of the on-premises or third-party device the VPC will
  // establish a tunnel with.
  customerGateways() []alicloud.vpc.customerGateway
  // Express Connect physical connections across all enabled regions
  //
  // A leased-line circuit into Alibaba Cloud. Traffic over it bypasses the
  // internet entirely, so no internet-facing control sees it, and the routes it
  // carries reach the VPC through its virtual border routers.
  physicalConnections() []alicloud.vpc.physicalConnection
  // Virtual border routers across all enabled regions
  //
  // The routed hand-off between a physical connection and the Alibaba Cloud
  // side. A router whose physical connection is owned by another account is a
  // path into the VPC from outside this account's control.
  virtualBorderRouters() []alicloud.vpc.virtualBorderRouter
}

// SSL VPN server
//
// An SSL VPN server on a VPN gateway, keyed by sslVpnServerId. Exposes the
// client address pool, the subnets it publishes to clients, the transport and
// cipher, the connection limit, and whether a second authentication factor is
// demanded. Use it to find a remote-access path into a VPC that clients reach
// with a certificate alone.
alicloud.vpc.sslVpnServer @defaults("name sslVpnServerId clientIpPool connections") {
  // Region ID the server runs in
  regionId string
  // SSL VPN server ID, used as the lookup key
  sslVpnServerId string
  // Name of the server
  name string
  // ID of the VPN gateway hosting the server
  vpnGatewayId string
  // VPN gateway hosting the server
  //
  // Null when the gateway lies outside the scanned regions.
  vpnGateway() alicloud.vpc.vpnGateway
  // Public address clients connect to
  internetIp string
  // Address pool clients are assigned from
  clientIpPool string
  // CIDR blocks on the Alibaba Cloud side published to clients
  //
  // Everything a connected client can reach. A broad local subnet gives a
  // single client certificate reach across the whole VPC.
  localSubnet string
  // Port the server listens on
  port int
  // Transport protocol, either UDP or TCP
  proto string
  // Encryption algorithm negotiated with clients, for example AES-128-CBC or none
  cipher string
  // Whether the tunnel compresses traffic
  compress bool
  // Number of clients connected now
  connections int
  // Maximum number of simultaneous client connections
  maxConnections int
  // DNS servers pushed to clients, comma-separated when several
  dnsServers string
  // Whether clients must pass a second authentication factor
  //
  // False means a client certificate alone admits a machine to the VPC, so a
  // copied certificate file is enough to reach it.
  multiFactorAuthEnabled bool
  // ID of the IDaaS instance providing the second factor, empty when none is configured
  idaasInstanceId string
  // Region of the IDaaS instance, empty when none is configured
  idaasRegionId string
  // Time the server was created
  createTime time
  // ID of the resource group the server belongs to
  resourceGroupId string
  // Resource group that contains the server
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Client certificates issued for the server
  clientCerts() []alicloud.vpc.sslVpnClientCert
}

// SSL VPN client certificate
//
// A client certificate issued for an SSL VPN server, keyed by
// sslVpnClientCertId. Exposes the certificate lifecycle and expiry. The private
// key is never exposed. Use it to find certificates that have expired without
// being revoked, or that are close to expiry.
alicloud.vpc.sslVpnClientCert @defaults("name status endTime") {
  // Region ID the certificate belongs to
  regionId string
  // Client certificate ID, used as the lookup key
  sslVpnClientCertId string
  // Name of the certificate
  name string
  // ID of the SSL VPN server the certificate is issued for
  sslVpnServerId string
  // Lifecycle status of the certificate
  //
  // One of expiring-soon, normal, or expired. A certificate reported here at
  // all is still installed on the server, whatever its status.
  status string
  // Time the certificate was issued
  createTime time
  // Time the certificate expires
  endTime time
  // ID of the resource group the certificate belongs to
  resourceGroupId string
  // Resource group that contains the certificate
  resourceGroup() alicloud.resourceManager.resourceGroup
}

// VPN customer gateway
//
// The remote end of a site-to-site VPN tunnel, keyed by customerGatewayId.
// Exposes the public address of the on-premises or third-party device and its
// BGP autonomous system number. The BGP authentication key is never exposed;
// authKeyConfigured reports only whether one is set.
alicloud.vpc.customerGateway @defaults("name customerGatewayId ipAddress") {
  // Region ID the gateway is registered in
  regionId string
  // Customer gateway ID, used as the lookup key
  customerGatewayId string
  // Name of the gateway
  name string
  // Description of the gateway
  description string
  // Public IP address of the remote device
  ipAddress string
  // BGP autonomous system number of the remote device, 0 when BGP is not used
  asn int
  // Whether a BGP authentication key is configured
  //
  // The key itself is a shared secret and is never exposed. False means BGP
  // sessions with this peer are unauthenticated, so a peer that can reach the
  // address can inject routes.
  authKeyConfigured bool
  // Time the gateway was registered
  createTime time
  // ID of the resource group the gateway belongs to
  resourceGroupId string
  // Resource group that contains the gateway
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the gateway
  tags map[string]string
}

// Express Connect physical connection
//
// A leased-line circuit into Alibaba Cloud, keyed by physicalConnectionId.
// Exposes the circuit status, capacity, access point and carrier, along with
// the virtual border routers that hand its traffic to the Alibaba Cloud side.
// Traffic over the circuit never touches the internet, so no internet-facing
// control sees it.
alicloud.vpc.physicalConnection @defaults("name physicalConnectionId status bandwidth") {
  // Region ID the circuit terminates in
  regionId string
  // Physical connection ID, used as the lookup key
  physicalConnectionId string
  // Name of the circuit
  name string
  // Description of the circuit
  description string
  // Lifecycle status of the circuit
  //
  // For example Initial, Approved, Allocating, Allocated, Confirmed, Enabled,
  // or Terminated. Only an Enabled circuit carries traffic.
  status string
  // Commercial status of the circuit, for example Normal or FinancialLocked
  businessStatus string
  // Capacity of the circuit in Mbit/s
  bandwidth int
  // Carrier providing the line, for example CT, CU, CM, or Other
  lineOperator string
  // Port type of the circuit, for example 10GBase-LR
  portType string
  // Access point the circuit lands at
  accessPointId string
  // Physical location of the remote end
  peerLocation string
  // Circuit code assigned by the carrier
  circuitCode string
  // Specification of the circuit, for example 10G
  spec string
  // Kind of circuit, for example VPC
  type string
  // ID of the redundant circuit paired with this one, empty when there is none
  //
  // A circuit with no redundant pair is a single point of failure for
  // everything routed over it.
  redundantPhysicalConnectionId string
  // ID of the parent circuit when this is a hosted connection, empty otherwise
  parentPhysicalConnectionId string
  // Time the circuit was created
  creationTime time
  // Time the circuit was enabled
  enabledTime time
  // Time the circuit expires
  endTime time
  // ID of the resource group the circuit belongs to
  resourceGroupId string
  // Resource group that contains the circuit
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the circuit
  tags map[string]string
  // Virtual border routers handing the circuit's traffic to Alibaba Cloud
  virtualBorderRouters() []alicloud.vpc.virtualBorderRouter
}

// Virtual border router
//
// The routed hand-off between an Express Connect circuit and the Alibaba Cloud
// side, keyed by vbrId. Exposes both gateway addresses of the peering, the VLAN
// it runs on, the BFD settings, and which circuit it attaches to. Use it to
// find a router attached to a circuit owned by another account, which is a path
// into the network from outside this account's control.
alicloud.vpc.virtualBorderRouter @defaults("name vbrId status vlanId") {
  // Region ID the router runs in
  regionId string
  // Virtual border router ID, used as the lookup key
  vbrId string
  // Name of the router
  name string
  // Description of the router
  description string
  // Lifecycle status of the router
  //
  // For example active, terminating, terminated, recovering, or unconfirmed.
  // Only an active router carries traffic.
  status string
  // VLAN the peering runs on
  vlanId int
  // ID of the physical connection the router attaches to
  physicalConnectionId string
  // Physical connection the router attaches to
  //
  // Null when the circuit belongs to another account, which is the hosted
  // Express Connect arrangement, and when it lies outside the scanned regions.
  physicalConnection() alicloud.vpc.physicalConnection
  // Lifecycle status of the attached circuit
  physicalConnectionStatus string
  // Account that owns the attached circuit
  physicalConnectionOwnerUid string
  // Whether the attached circuit belongs to another account
  //
  // True on a hosted connection, where the circuit and therefore the physical
  // path is under a third party's control.
  crossAccountConnection bool
  // Alibaba Cloud side address of the peering
  localGatewayIp string
  // Remote side address of the peering
  peerGatewayIp string
  // Subnet mask of the peering addresses
  peeringSubnetMask string
  // Whether IPv6 is enabled on the peering
  enableIpv6 bool
  // Alibaba Cloud side IPv6 address of the peering, empty when IPv6 is off
  localIpv6GatewayIp string
  // Remote side IPv6 address of the peering, empty when IPv6 is off
  peerIpv6GatewayIp string
  // Capacity of the router in Mbit/s
  bandwidth int
  // Maximum transmission unit of the peering
  mtu int
  // Number of missed BFD packets before the peer is declared down, 0 when BFD is off
  detectMultiplier int
  // Minimum BFD receive interval in milliseconds, 0 when BFD is off
  minRxInterval int
  // Minimum BFD transmit interval in milliseconds, 0 when BFD is off
  minTxInterval int
  // ID of the route table the router uses
  routeTableId string
  // Kind of router, for example VBR
  type string
  // Time the router was created
  creationTime time
  // Time the router was activated
  activationTime time
  // Time the router was terminated, null when it has not been
  terminationTime time
  // ID of the resource group the router belongs to
  resourceGroupId string
  // Resource group that contains the router
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the router
  tags map[string]string
}

// Virtual Private Cloud network
//
// A single VPC, keyed by vpcId, for example vpc-bp1qpo0kug3a20qqe0abc. Exposes
// the primary and secondary CIDR blocks, the IPv6 configuration, the lifecycle
// status, the default-VPC flag, the vRouter, and the vSwitches, route tables,
// and NAT gateways associated with the network.
alicloud.vpc.network {
  // VPC ID, for example vpc-bp1qpo0kug3a20qqe0abc
  vpcId string
  // VPC name
  vpcName string
  // Description of the VPC
  description string
  // Primary IPv4 CIDR block of the VPC
  cidrBlock string
  // Secondary IPv4 CIDR blocks of the VPC
  cidrBlocks []string
  // IPv6 CIDR block of the VPC
  ipv6CidrBlock string
  // IPv6 CIDR blocks with their ISP line type
  //
  // Each entry carries the ipv6CidrBlock and its ipv6Isp line type (for
  // example BGP, ChinaMobile, ChinaUnicom, or ChinaTelecom).
  ipv6CidrBlocks []dict
  // Whether IPv6 is enabled for the VPC
  enabledIpv6 bool
  // Lifecycle status
  //
  // One of Pending or Available.
  status string
  // Whether this is the default VPC in the region
  isDefault bool
  // Region ID the VPC belongs to, for example cn-hangzhou
  regionId string
  // vRouter ID of the VPC
  vRouterId string
  // Time when the VPC was created
  creationTime time
  // Resource group ID the VPC belongs to
  resourceGroupId string
  // Resource group that contains the VPC
  resourceGroup() alicloud.resourceManager.resourceGroup
  // User CIDR blocks associated with the VPC
  userCidrs []string
  // vSwitches in the VPC
  vswitches() []alicloud.vpc.vswitch
  // NAT gateways attached to the VPC
  natGateways() []alicloud.vpc.natGateway
  // Route tables associated with the VPC
  routeTables() []alicloud.vpc.routeTable
  // Flow logs monitoring this VPC
  //
  // Flow logs whose monitored resource is the VPC itself. A flow log only
  // captures traffic while its status is Active. Flow logs scoped to a vSwitch
  // or an elastic network interface inside the VPC are not included.
  flowLogs() []alicloud.vpc.flowLog
  // VPN gateways attached to the VPC
  //
  // Each gateway terminates connections that reach the VPC from outside
  // Alibaba Cloud, so this is reachability that security-group rules alone do
  // not explain.
  vpnGateways() []alicloud.vpc.vpnGateway
  // DNS hostname feature status
  //
  // Indicates whether the DNS hostname feature is enabled, for example ENABLED
  // or DISABLED.
  dnsHostnameStatus string
  // DHCP options set ID bound to the VPC
  dhcpOptionsSetId string
  // DHCP options set status
  //
  // One of Available, InUse, Deleted, or Pending.
  dhcpOptionsSetStatus string
  // Cloud Enterprise Network (CEN) attachment status
  //
  // Returned as Attached only when the VPC is attached to a CEN instance.
  cenStatus string
  // ID of the Alibaba Cloud account that owns the VPC
  ownerId int
  // Tags attached to the VPC
  tags map[string]string
}

// vSwitch (VPC subnet)
//
// A single vSwitch, keyed by vSwitchId, for example vsw-25bcdxs7pv1abc. Exposes
// the CIDR blocks, the zone, the number of free IP addresses, the associated
// route table and network ACL, and the parent VPC.
alicloud.vpc.vswitch {
  // vSwitch ID, for example vsw-25bcdxs7pv1abc
  vSwitchId string
  // vSwitch name
  vSwitchName string
  // Description of the vSwitch
  description string
  // IPv4 CIDR block of the vSwitch
  cidrBlock string
  // IPv6 CIDR block of the vSwitch
  ipv6CidrBlock string
  // Whether IPv6 is enabled for the vSwitch
  enabledIpv6 bool
  // Lifecycle status
  //
  // One of Pending or Available.
  status string
  // VPC the vSwitch belongs to
  vpc() alicloud.vpc.network
  // Zone ID the vSwitch belongs to, for example cn-hangzhou-d
  zoneId string
  // Number of available IP addresses in the vSwitch
  availableIpAddressCount int
  // Whether the vSwitch is the default vSwitch in its zone
  isDefault bool
  // Time when the vSwitch was created
  creationTime time
  // Route table associated with the vSwitch
  routeTable() alicloud.vpc.routeTable
  // Type of the associated route table, for example System or Custom
  routeTableType string
  // Network ACL bound to the vSwitch
  networkAcl() alicloud.vpc.networkAcl
  // Resource group ID the vSwitch belongs to
  resourceGroupId string
  // Resource group that contains the vSwitch
  resourceGroup() alicloud.resourceManager.resourceGroup
  // vSwitch sharing status
  //
  // Empty for a regular vSwitch, Shared once the vSwitch is shared, or Sharing
  // while sharing is in progress.
  shareType string
  // ID of the Alibaba Cloud account that owns the vSwitch
  ownerId int
  // Tags attached to the vSwitch
  tags map[string]string
}

// VPC route table
//
// A single route table, keyed by routeTableId, for example vtb-bp1e123abc.
// Exposes the route table type, the bound vSwitches and gateways, the lifecycle
// status, and the individual route entries through routeEntries.
alicloud.vpc.routeTable {
  // Route table ID, for example vtb-bp1e123abc
  routeTableId string
  // Route table name
  routeTableName string
  // Route table type
  //
  // One of System or Custom.
  routeTableType string
  // Description of the route table
  description string
  // VPC the route table belongs to
  vpc() alicloud.vpc.network
  // Lifecycle status
  //
  // One of Pending, Available, or Deleting.
  status string
  // Time when the route table was created
  creationTime time
  // Resource group ID the route table belongs to
  resourceGroupId string
  // Resource group that contains the route table
  resourceGroup() alicloud.resourceManager.resourceGroup
  // vSwitches associated with the route table
  vswitches() []alicloud.vpc.vswitch
  // Gateway IDs associated with the route table
  gatewayIds []string
  // Type of resource the route table is associated with
  //
  // One of VSwitch or Gateway.
  associateType string
  // ID of the router the route table belongs to
  routerId string
  // Type of router the route table belongs to
  //
  // One of VRouter or VBR.
  routerType string
  // Whether route propagation is enabled for the route table
  routePropagationEnable bool
  // ID of the Alibaba Cloud account that owns the route table
  ownerId int
  // Tags attached to the route table
  tags map[string]string
  // Route entry summaries
  //
  // Deprecated in favor of routes. Each entry carries destinationCidrBlock,
  // nextHopType, nextHopId, status, type, routeEntryId, routeEntryName,
  // description, ipVersion, and origin.
  routeEntries() @maturity("deprecated") @replaced_by("alicloud.vpc.routeTable.routes") []dict
  // Routes in the route table
  //
  // Where traffic leaving the attached vSwitches is sent. A route for
  // 0.0.0.0/0 is the one that decides whether a subnet reaches the internet at
  // all, and which gateway it leaves through.
  routes() []alicloud.vpc.routeTable.route
}

// Route in a VPC route table
//
// A single route, keyed by routeEntryId. Reports the destination it matches and
// the next hop traffic is handed to. A system route is created with the VPC and
// a custom route was added deliberately, which the type field distinguishes.
alicloud.vpc.routeTable.route @defaults("destinationCidrBlock nextHopType nextHopId status") {
  // Route entry ID, used as the lookup key
  routeEntryId string
  // Route entry name
  routeEntryName string
  // Route description
  description string
  // Destination the route matches
  //
  // A CIDR block. 0.0.0.0/0 is the default route, which catches everything not
  // matched by a more specific entry.
  destinationCidrBlock string
  // Kind of next hop traffic is handed to
  //
  // Values include Instance, NatGateway, VpnGateway, RouterInterface,
  // NetworkInterface, IPv6Gateway, and Attachment. The kind decides whether the
  // route leads out of the VPC.
  nextHopType string
  // ID of the next hop
  nextHopId string
  // Route status
  status string
  // How the route was created
  //
  // System for a route created with the VPC, Custom for one added afterwards.
  type string
  // IP version of the destination
  ipVersion string
  // Origin of the route
  origin string
}

// VPC NAT gateway
//
// A single NAT gateway, keyed by natGatewayId, for example ngw-bp1uewa15k4abc.
// Exposes the specification, the NAT type and network type, the lifecycle and
// billing status, the SNAT and DNAT table IDs, and the private-network placement.
alicloud.vpc.natGateway {
  // NAT gateway ID, for example ngw-bp1uewa15k4abc
  natGatewayId string
  // NAT gateway name
  name string
  // Description of the NAT gateway
  description string
  // VPC the NAT gateway belongs to
  vpc() alicloud.vpc.network
  // Lifecycle status
  //
  // One of Creating, Available, Modifying, Deleting, or Converting.
  status string
  // Specification of the NAT gateway
  //
  // One of Small, Middle, Large, or XLarge.1 for a standard NAT gateway.
  spec string
  // NAT gateway type
  //
  // One of Normal or Enhanced.
  natType string
  // Network type of the NAT gateway
  //
  // One of internet for a public gateway or intranet for a private gateway.
  networkType string
  // Business (payment) status of the NAT gateway
  //
  // One of Normal or FinancialLocked.
  businessStatus string
  // Time when the NAT gateway was created
  creationTime time
  // Time when the NAT gateway expires
  expiredTime time
  // Metering method for internet data transfer
  //
  // One of PayByLcu or PayBySpec.
  internetChargeType string
  // Billing method of the NAT gateway
  //
  // One of PrePaid (subscription) or PostPaid (pay-as-you-go).
  instanceChargeType string
  // Whether deletion protection is enabled
  deletionProtection bool
  // Whether flow monitoring (ECS metrics) is enabled
  ecsMetricEnabled bool
  // Whether the NAT gateway replies to ICMP (ping) requests
  icmpReplyEnabled bool
  // Whether PrivateLink is enabled for the NAT gateway
  privateLinkEnabled bool
  // PrivateLink mode of the NAT gateway
  privateLinkMode string
  // Whether firewall (security protection) is enabled
  securityProtectionEnabled bool
  // EIP binding mode of the NAT gateway
  //
  // One of MULTI_BINDED or NAT.
  eipBindMode string
  // Whether NAT session logging is enabled
  enableSessionLog string
  // Whether the order is automatically paid for a subscription NAT gateway
  autoPay bool
  // Region ID the NAT gateway belongs to
  regionId string
  // Resource group ID the NAT gateway belongs to
  resourceGroupId string
  // Resource group that contains the NAT gateway
  resourceGroup() alicloud.resourceManager.resourceGroup
  // SNAT table IDs of the NAT gateway
  snatTableIds []string
  // DNAT (forward) table IDs of the NAT gateway
  forwardTableIds []string
  // FULLNAT table IDs of the NAT gateway
  fullNatTableIds []string
  // Private-network placement of an enhanced NAT gateway
  //
  // Carries vswitchId, privateIpAddress, eniInstanceId, eniType, izNo,
  // maxBandwidth, maxSessionEstablishRate, and maxSessionQuota.
  natGatewayPrivateInfo dict
  // Elastic IP addresses associated with the NAT gateway
  //
  // Each entry carries allocationId, ipAddress, privateIpAddress,
  // snatEntryEnabled, and usingStatus.
  ipLists []dict
  // Access mode of the NAT gateway
  //
  // Carries modeValue and tunnelType.
  accessMode dict
  // Tags attached to the NAT gateway
  tags map[string]string
  // SNAT rules giving private addresses outbound internet access
  //
  // Each rule maps a source range or vSwitch onto one or more public
  // addresses. An instance with no public address of its own still reaches the
  // internet whenever a SNAT rule covers it, which a check on the instance's
  // own addressing does not show.
  snatEntries() []alicloud.vpc.natGateway.snatEntry
  // DNAT rules forwarding inbound traffic to private addresses
  //
  // Each rule publishes a private address and port on a public IP. This is an
  // inbound path from the internet that no security group audit sees, because
  // the security group is evaluated against the private address the traffic
  // arrives at.
  forwardEntries() []alicloud.vpc.natGateway.forwardEntry
}

// SNAT rule of a NAT gateway
//
// A single source-NAT rule, keyed by snatEntryId. A rule gives a source range,
// a vSwitch, or one network interface outbound internet access through a public
// address. Exposes the source it covers, the public addresses it uses, and the
// rule status. Use it to find which private workloads can reach the internet.
alicloud.vpc.natGateway.snatEntry @defaults("snatEntryName snatIp sourceCIDR status") {
  // SNAT rule ID, used as the lookup key
  snatEntryId string
  // Name of the SNAT rule
  snatEntryName string
  // ID of the SNAT table holding the rule
  snatTableId string
  // Public addresses the rule translates to, comma-separated when several
  snatIp string
  // Source CIDR the rule applies to, empty when the rule is scoped by vSwitch
  sourceCIDR string
  // ID of the vSwitch the rule applies to, empty when the rule is scoped by CIDR
  sourceVSwitchId string
  // vSwitch the rule applies to
  //
  // Null when the rule is scoped by CIDR or network interface rather than by
  // vSwitch, and when the vSwitch lies outside the scanned regions.
  sourceVswitch() alicloud.vpc.vswitch
  // ID of the network interface the rule applies to, empty when it is not interface-scoped
  networkInterfaceId string
  // Whether the rule pins a connection to one public address
  //
  // Enabled when consecutive connections from the same source keep the same
  // public address.
  eipAffinity string
  // Lifecycle status of the rule
  //
  // One of Pending, Available, or Deleting. Only an Available rule forwards
  // traffic.
  status string
}

// DNAT rule of a NAT gateway
//
// A single destination-NAT (port forwarding) rule, keyed by forwardEntryId. A
// rule publishes a private address and port on a public IP, which is an inbound
// path from the internet. Exposes both ends of the mapping, the protocol, and
// whether the rule forwards every port. Use it to find private workloads
// reachable from the internet without a public address of their own.
alicloud.vpc.natGateway.forwardEntry @defaults("forwardEntryName externalIp externalPort internalIp status") {
  // DNAT rule ID, used as the lookup key
  forwardEntryId string
  // Name of the DNAT rule
  forwardEntryName string
  // ID of the DNAT table holding the rule
  forwardTableId string
  // Public address traffic arrives at
  externalIp string
  // Public port traffic arrives at, or any when every port is forwarded
  externalPort string
  // Private address traffic is forwarded to
  internalIp string
  // Private port traffic is forwarded to, or any when every port is forwarded
  internalPort string
  // Protocol the rule forwards, one of TCP, UDP, or Any
  ipProtocol string
  // Whether the rule forwards every port
  //
  // True when the rule maps the whole port range rather than one port, which
  // publishes every listening service on the private address rather than the
  // one that was meant to be exposed.
  forwardsAllPorts bool
  // Lifecycle status of the rule
  //
  // One of Pending, Available, or Deleting. Only an Available rule forwards
  // traffic.
  status string
}

// Elastic IP address (EIP)
//
// A single elastic IP address, keyed by allocationId, for example
// eip-2zeerraiwb7uabc. Exposes the public IP address, the bandwidth and billing
// configuration, the ISP line, the lifecycle status, and the instance the EIP
// is bound to.
alicloud.vpc.eipAddress {
  // Allocation ID of the EIP, for example eip-2zeerraiwb7uabc
  allocationId string
  // Name of the EIP
  name string
  // Description of the EIP
  description string
  // Public IP address of the EIP
  ipAddress string
  // Lifecycle status
  //
  // One of Associating, Unassociating, InUse, Available, or Releasing.
  status string
  // Peak bandwidth of the EIP in Mbit/s
  bandwidth string
  // Metering method for internet data transfer
  //
  // One of PayByBandwidth or PayByTraffic.
  internetChargeType string
  // Billing method of the EIP
  //
  // One of PrePaid (subscription) or PostPaid (pay-as-you-go).
  chargeType string
  // ISP line of the EIP
  //
  // One of BGP, BGP_PRO, ChinaTelecom, ChinaUnicom, ChinaMobile, ChinaTelecom_L2,
  // ChinaUnicom_L2, ChinaMobile_L2, or BGP_FinanceCloud.
  isp string
  // ID of the instance the EIP is bound to
  instanceId string
  // Type of the instance the EIP is bound to
  //
  // One of EcsInstance, SlbInstance, Nat, HaVip, NetworkInterface, or
  // IpAddress.
  instanceType string
  // Region ID of the instance the EIP is bound to
  instanceRegionId string
  // Private IP address of the instance the EIP is bound to
  privateIpAddress string
  // Time when the EIP was allocated
  allocationTime time
  // Time when the EIP expires
  expiredTime time
  // High-definition monitoring status of the EIP
  hdMonitorStatus string
  // Whether deletion protection is enabled
  deletionProtection bool
  // Whether the EIP has renewal (reservation) data
  hasReservationData string
  // Network mode of the EIP
  //
  // One of public or a private network mode.
  netmode string
  // ID of the IP address pool the EIP was drawn from
  publicIpAddressPoolId string
  // Region ID the EIP belongs to
  regionId string
  // Resource group ID the EIP belongs to
  resourceGroupId string
  // Resource group that contains the elastic IP address
  resourceGroup() alicloud.resourceManager.resourceGroup
  // VPC the EIP is associated with
  vpc() alicloud.vpc.network
  // Zone the EIP belongs to
  zone string
  // ID of the bandwidth plan (shared bandwidth) the EIP joined
  bandwidthPackageId string
  // Type of the bandwidth plan the EIP joined
  bandwidthPackageType string
  // Maximum bandwidth of the bandwidth plan in Mbit/s
  bandwidthPackageBandwidth string
  // Maximum bandwidth of the EIP in Mbit/s
  eipBandwidth string
  // Business type of the EIP
  bizType string
  // Business (payment) status of the EIP
  //
  // One of Normal, FinancialLocked, OperationLock, or Unactivated.
  businessStatus string
  // Association mode of the EIP
  //
  // One of NAT, MULTI_BINDED, or BINDED.
  mode string
  // Whether second-level (fine-grained) monitoring is limited
  secondLimited bool
  // ID of the contiguous EIP group the EIP belongs to
  segmentInstanceId string
  // Firewall (security protection) types enabled on the EIP
  securityProtectionTypes []string
  // Whether the EIP is managed by an Alibaba Cloud service
  //
  // 0 indicates the EIP is user-managed, 1 indicates it is managed by a service.
  serviceManaged int
  // Tags attached to the EIP
  tags map[string]string
}

// VPC network ACL
//
// A single network ACL, keyed by networkAclId, for example
// nacl-a2do9e413e0spzasx. Exposes the lifecycle status, the ingress and egress
// rule entries, and the vSwitches the ACL is bound to.
alicloud.vpc.networkAcl {
  // Network ACL ID, for example nacl-a2do9e413e0spzasx
  networkAclId string
  // Network ACL name
  networkAclName string
  // Description of the network ACL
  description string
  // VPC the network ACL belongs to
  vpc() alicloud.vpc.network
  // Lifecycle status
  //
  // One of Available or Modifying.
  status string
  // Time when the network ACL was created
  creationTime time
  // Region ID the network ACL belongs to
  regionId string
  // ID of the Alibaba Cloud account that owns the network ACL
  ownerId int
  // Inbound rule summaries
  //
  // Deprecated in favor of ingressEntries. Each entry carries protocol, port,
  // sourceCidrIp, policy, description, entryType, ipVersion, networkAclEntryId,
  // and networkAclEntryName.
  ingressAclEntries @maturity("deprecated") @replaced_by("alicloud.vpc.networkAcl.ingressEntries") []dict
  // Outbound rule summaries
  //
  // Deprecated in favor of egressEntries. Each entry carries protocol, port,
  // destinationCidrIp, policy, description, entryType, ipVersion,
  // networkAclEntryId, and networkAclEntryName.
  egressAclEntries @maturity("deprecated") @replaced_by("alicloud.vpc.networkAcl.egressEntries") []dict
  // Inbound rules of the network ACL
  //
  // Evaluated before security groups on traffic entering the attached
  // vSwitches, so a rule here can admit traffic no security group was ever
  // asked about.
  ingressEntries []alicloud.vpc.networkAcl.entry
  // Outbound rules of the network ACL
  egressEntries []alicloud.vpc.networkAcl.entry
  // Resources the network ACL is bound to
  //
  // Each entry carries resourceId, resourceType, and status.
  resources []dict
  // Tags attached to the network ACL
  tags map[string]string
}

// Network ACL rule
//
// A single inbound or outbound rule, keyed by entryId. Network ACLs are
// evaluated before security groups, so an accept rule here decides what reaches
// the security groups at all and a drop rule overrides whatever they allow.
// Ports arrive as a range string such as 22/22 or -1/-1 for every port.
alicloud.vpc.networkAcl.entry @defaults("direction policy protocol port") {
  // Rule ID, used as the lookup key
  entryId string
  // Rule name
  name string
  // Rule description
  description string
  // Which way the rule applies
  //
  // Either ingress or egress.
  direction string
  // What the rule does with matching traffic
  //
  // Either accept or drop.
  policy string
  // Protocol the rule matches
  //
  // One of icmp, icmpv6, gre, tcp, udp, or all.
  protocol string
  // Port range the rule matches
  //
  // Written as first/last, for example 22/22. A value of -1/-1 matches every
  // port, which is the form a rule takes when the protocol is not tcp or udp.
  port string
  // Lowest port the rule matches
  //
  // A rule written as -1/-1 matches every port, and reports 1 here alongside
  // 65535 in toPort. Null when port holds no range that resolves to a pair of
  // ports, which leaves port as the only record of it.
  fromPort int
  // Highest port the rule matches
  //
  // A rule written as -1/-1 matches every port, and reports 65535 here
  // alongside 1 in fromPort. Null when port holds no range that resolves to a
  // pair of ports.
  toPort int
  // Source addresses an inbound rule matches
  //
  // Empty on an egress rule. A value of 0.0.0.0/0 matches the whole internet.
  sourceCidrIp string
  // Destination addresses an outbound rule matches
  //
  // Empty on an ingress rule.
  destinationCidrIp string
  // How the rule was created
  //
  // custom for a rule added deliberately, system for one created with the ACL.
  entryType string
  // IP version the rule applies to
  ipVersion string
}

// Object Storage Service
//
// Entry point for the Object Storage Service (OSS) in an Alibaba Cloud
// account. Exposes every bucket the credential can list across all regions
// through buckets, from which per-bucket access control, encryption,
// versioning, logging, tagging, and public-access posture are reachable.
alicloud.oss {
  // Buckets owned by the account across all regions
  buckets() []alicloud.oss.bucket
}

// Object Storage Service bucket
//
// A single OSS bucket, keyed by name (bucket names are globally unique).
// The summary fields (region, storageClass, creationDate, endpoints,
// resourceGroupId) come from the account bucket listing. The remaining
// accessors call the per-bucket configuration APIs to expose the access
// control policy, default server-side encryption, versioning state, access
// logging target, bucket policy document, tags, and the block-public-access
// posture used to audit exposure.
alicloud.oss.bucket {
  // Bucket name, globally unique across Alibaba Cloud
  name string
  // Region ID the bucket resides in, for example cn-hangzhou
  region string
  // Data center that stores the bucket, for example oss-cn-hangzhou
  location string
  // Storage class
  //
  // One of Standard, IA, Archive, ColdArchive, or DeepColdArchive.
  storageClass string
  // Time the bucket was created
  creationDate time
  // Internal endpoint for access from ECS instances in the same region
  intranetEndpoint string
  // Public endpoint for access over the Internet
  extranetEndpoint string
  // ID of the resource group the bucket belongs to
  resourceGroupId string
  // Resource group that contains the bucket
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Access control list grant
  //
  // The canned ACL applied to the bucket. One of private, public-read, or
  // public-read-write. public-read and public-read-write expose bucket
  // contents to anonymous callers.
  acl() string
  // Versioning state
  //
  // One of Enabled or Suspended. Empty when versioning was never configured.
  versioning() string
  // Default server-side encryption rule
  //
  // The default encryption applied to new objects, with the SSEAlgorithm
  // (KMS, AES256, or SM4), the KMSMasterKeyID when a specific key is used,
  // and the KMSDataEncryption algorithm. Null when no default encryption
  // rule is configured.
  encryption() dict
  // Default server-side encryption algorithm
  //
  // The SSEAlgorithm from the default encryption rule (KMS, AES256, or SM4),
  // flattened for auditing. Empty when no default encryption is configured.
  sseAlgorithm() string
  // KMS key used for default server-side encryption
  //
  // The customer master key named by the bucket's default encryption rule.
  // Null when the bucket has no default encryption or uses the AES256/SM4
  // built-in keys rather than a specific KMS key.
  kmsKey() alicloud.kms.key
  // Access logging configuration
  //
  // The access-logging target when logging is enabled, with TargetBucket,
  // TargetPrefix, and LoggingRole. Null when access logging is disabled.
  logging() dict
  // Bucket policy document
  //
  // The raw JSON bucket policy that grants cross-account or anonymous
  // permissions. Empty when no bucket policy is attached.
  policy() string
  // Bucket tags as key-value pairs
  tags() map[string]string
  // Block public access configuration
  //
  // The block-public-access setting, with BlockPublicAccess indicating
  // whether public access is blocked. Null when never configured.
  publicAccessBlock() dict
  // Full bucket information
  //
  // The complete bucket detail record, including access monitoring, data
  // redundancy type, cross-region replication, transfer acceleration, the
  // server-side encryption rule, the log bucket policy, owner, comment, and
  // the block-public-access flag.
  bucketInfo() dict
  // Transfer acceleration state
  //
  // Whether transfer acceleration is enabled for the bucket. One of Enabled
  // or Disabled. Empty when the setting is not returned.
  transferAcceleration() string
  // Cross-region replication state
  //
  // Whether cross-region replication is enabled for the bucket. One of
  // Enabled or Disabled. Empty when the setting is not returned.
  crossRegionReplication() string
  // Data redundancy type
  //
  // The redundancy model for stored data. One of LRS (locally redundant) or
  // ZRS (zone redundant). Empty when the setting is not returned.
  dataRedundancyType() string
  // Whether block public access is enabled for the bucket
  blockPublicAccess() bool
  // Whether the bucket is readable from the internet without credentials
  //
  // True when the bucket reaches anonymous callers, either through a
  // public-read or public-read-write canned acl or through a bucket policy
  // that allows a `*` principal. False whenever blockPublicAccess is on,
  // which overrides both. Use it to find buckets exposed to the internet
  // regardless of which of the two mechanisms opened them.
  isPublic() bool
  // Whether the bucket policy allows public access
  //
  // Object Storage Service's own verdict on the attached policy, independent of
  // the ACL. False when no policy is attached.
  policyAllowsPublicAccess() bool
  // Whether the bucket restricts which TLS versions clients may use
  //
  // False means every TLS version the service accepts is allowed, including
  // versions no longer considered safe.
  tlsEnforced() bool
  // TLS versions clients may use
  //
  // For example TLSv1.2 and TLSv1.3. Empty when tlsEnforced is false, which
  // does not mean TLS is off, only that the bucket sets no floor of its own.
  tlsVersions() []string
  // State of the retention policy applied to the bucket
  //
  // InProgress for a policy that can still be withdrawn, Locked for one that
  // cannot. Empty when no retention policy is configured, meaning objects can
  // be deleted or overwritten at any time. A locked policy is what makes stored
  // objects survive an attacker holding valid credentials.
  objectLockState() string
  // Days objects are retained under the retention policy
  //
  // Zero when no retention policy is configured.
  objectLockRetentionDays() int
  // Whether requests carrying no Referer header are allowed
  //
  // True by default. Combined with an otherwise restrictive referer list, this
  // being true leaves the restriction trivially bypassed, since the client
  // chooses whether to send the header.
  allowEmptyReferer() bool
  // Referer values allowed to reach the bucket
  //
  // Empty when no referer restriction is configured.
  refererAllowList() []string
  // Referer values refused by the bucket
  refererDenyList() []string
  // Whether the bucket serves a static website
  //
  // Static hosting is an intentional public surface, so a bucket with it
  // enabled is meant to be read anonymously.
  websiteEnabled() bool
  // Default page served for the static website
  websiteIndexDocument() string
  // Page served for errors on the static website
  websiteErrorDocument() string
  // Cross-origin resource sharing rules
  //
  // Which other origins a browser may read the bucket from. Empty when CORS is
  // not configured, which refuses every cross-origin browser request.
  corsRules() []alicloud.oss.bucket.corsRule
  // Rules that copy objects to another bucket
  //
  // Replication moves object data out of this bucket, and the destination can
  // be in another region or owned by another account.
  replicationRules() []alicloud.oss.bucket.replicationRule
}

// OSS bucket cross-origin resource sharing rule
//
// One CORS rule, deciding which origins a browser may read the bucket from and
// with which methods and headers. An allowed origin of `*` lets a page on any
// site read whatever the requesting browser is allowed to read.
alicloud.oss.bucket.corsRule @defaults("allowedOrigins allowedMethods maxAgeSeconds") {
  // Origins a browser may issue cross-origin requests from
  //
  // A value of `*` allows every site.
  allowedOrigins []string
  // Methods allowed in a cross-origin request
  allowedMethods []string
  // Request headers allowed in a cross-origin request
  //
  // A value of `*` allows every header.
  allowedHeaders []string
  // Response headers exposed to the requesting page
  exposeHeaders []string
  // Seconds a browser may cache the preflight response
  maxAgeSeconds int
}

// OSS bucket replication rule
//
// One rule copying objects to another bucket, keyed by its rule ID. Reports
// where the copies land and what is copied, so a rule sending object data to
// another region or another account is visible as one.
alicloud.oss.bucket.replicationRule @defaults("id targetBucket targetLocation status") {
  // Replication rule ID, used as the lookup key
  id string
  // Bucket objects are copied to
  targetBucket string
  // Region the destination bucket sits in
  targetLocation string
  // Replication status
  //
  // One of starting, doing, or closing.
  status string
  // Operations copied to the destination
  //
  // ALL covers writes, deletes and aborted uploads. PUT covers writes only, so
  // an object deleted here survives at the destination.
  action string
  // Whether objects that predate the rule are copied
  //
  // Either enabled or disabled.
  historicalObjectReplication string
  // Object name prefixes the rule covers
  //
  // Empty when the rule covers the whole bucket.
  prefixes []string
  // RAM role Object Storage Service assumes to perform the replication
  syncRole string
  // KMS key ID used to encrypt the replicated objects
  //
  // Empty when the destination objects are not encrypted with a customer key.
  replicaKmsKeyId string
}

// Server Load Balancer
//
// Classic Load Balancer (CLB) resources in an Alibaba Cloud account. Exposes
// the CLB instances discovered across every enabled region through
// loadBalancers, from which listeners, backend servers, addressing, and
// protection settings can be audited.
alicloud.slb {
  // CLB instances across all enabled regions
  loadBalancers() []alicloud.slb.loadBalancer
  // Access control lists across all enabled regions
  //
  // An access control list holds the addresses a CLB listener allows or denies.
  // A listener naming an allowlist that turns out to hold 0.0.0.0/0 is
  // indistinguishable from an unrestricted listener, which the listener's own
  // fields cannot show.
  acls() []alicloud.slb.acl
}

// Server Load Balancer access control list
//
// A named list of addresses a CLB listener allows or denies, keyed by aclId
// within its region. Exposes the address entries and the listeners bound to
// the list. Use it to find an allowlist that admits every address, which
// leaves a listener open despite access control reading as enabled.
alicloud.slb.acl @defaults("aclName aclId addressIPVersion entryCount") {
  // Region ID the list resides in, for example cn-hangzhou
  regionId string
  // Access control list ID, used as the lookup key within its region
  aclId string
  // Name of the access control list
  aclName string
  // IP version of the entries, either ipv4 or ipv6
  addressIPVersion string
  // Address entries in the list, as CIDR blocks
  entries() []string
  // Number of address entries in the list
  entryCount() int
  // Whether the list covers every address
  //
  // True when an entry is 0.0.0.0/0 or ::/0. On a listener whose aclType is
  // white this makes the allowlist a no-op, so access control reads as enabled
  // while admitting the whole internet.
  allowsAllAddresses() bool
  // ID of the resource group the list belongs to
  resourceGroupId string
  // Resource group that contains the list
  resourceGroup() alicloud.resourceManager.resourceGroup
  // Tags applied to the list
  tags map[string]string
}

// Server Load Balancer (CLB) instance
//
// A single Classic Load Balancer instance, keyed by loadBalancerId (for
// example lb-bp1b6c719dfa08ex). Exposes the instance addressing and network
// placement, the internet or intranet exposure signalled by addressType, the
// billing and specification settings, the deletion and modification
// protection flags, and the configured listeners and backend servers.
alicloud.slb.loadBalancer {
  // CLB instance ID, for example lb-bp1b6c719dfa08ex
  loadBalancerId string
  // Name of the CLB instance
  loadBalancerName string
  // Service IP address that the CLB instance uses to provide services
  address string
  // Network exposure of the CLB instance
  //
  // One of internet (a public IP address is assigned and requests are
  // forwarded over the internet) or intranet (a private IP address is
  // assigned and requests are forwarded only over internal networks).
  addressType string
  // IP version of the service address
  //
  // One of ipv4 or ipv6.
  addressIPVersion string
  // Lifecycle status of the CLB instance
  //
  // One of active (running as expected), inactive (disabled, does not forward
  // traffic), or locked (locked, for example after expiration or non-payment).
  status string
  // Region ID where the CLB instance is deployed, for example cn-hangzhou
  regionId string
  // ID of the primary zone, for example cn-hangzhou-b
  masterZoneId string
  // ID of the secondary zone, for example cn-hangzhou-d
  slaveZoneId string
  // Network type of an internal-facing CLB instance
  //
