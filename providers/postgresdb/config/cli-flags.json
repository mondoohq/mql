{
  "connectors": [
    {
      "name": "postgresdb",
      "flags": [
        {
          "long": "ask-pass",
          "type": "Bool",
          "default": "false"
        },
        {
          "long": "database",
          "type": "String",
          "default": "postgres"
        },
        {
          "long": "host",
          "type": "String"
        },
        {
          "long": "password",
          "short": "p",
          "type": "String",
          "options": [
            "Password"
          ]
        },
        {
          "long": "port",
          "type": "Int",
          "default": "5432"
        },
        {
          "long": "sslcert",
          "type": "String"
        },
        {
          "long": "sslkey",
          "type": "String"
        },
        {
          "long": "sslmode",
          "type": "String",
          "default": "prefer"
        },
        {
          "long": "sslrootcert",
          "type": "String"
        },
        {
          "long": "user",
          "short": "u",
          "type": "String"
        }
      ]
    }
  ]
}
