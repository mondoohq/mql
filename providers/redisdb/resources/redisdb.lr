option provider = "go.mondoo.com/mql/providers/redisdb"
option go_package = "go.mondoo.com/mql/providers/redisdb/resources"

// Redis or Valkey server
//
// Root of the redisdb provider. The connected server and everything queryable
// through it (access-control users and the security-relevant configuration) is
// reached from redisdb.instance.
redisdb {
}

// Redis or Valkey server
//
// Server identity and network and authentication posture: version and product
// (Redis or Valkey), server mode, listening ports, whether protected mode is
// on, which interfaces it binds, whether a password is set, and the TLS
// settings. The access-control users and durability configuration are reached
// from here. Populated from INFO and CONFIG GET; fields the connecting
// credential is not permitted to read are left null rather than failing.
redisdb.instance @defaults("version isValkey protectedMode requirepassSet") {
  // Server version, for example "7.4.0"
  //
  // On Valkey this is the compatible Redis OSS version, not the Valkey
  // version; read valkeyVersion for the latter.
  version string
  // Whether the server is Valkey rather than Redis
  isValkey bool
  // Valkey version, when the server is Valkey
  valkeyVersion string
  // Server mode: "standalone", "sentinel", or "cluster"
  mode string
  // Operating system the server reports running on
  os string
  // Run identifier, a random value regenerated on every restart
  runId string
  // Plaintext TCP port, or 0 when the plaintext listener is disabled
  port int
  // Whether protected mode is enabled
  //
  // Protected mode (on by default) refuses external connections when no
  // password and no explicit bind are set. Turning it off on an exposed
  // server is a risk.
  protectedMode bool
  // Interfaces the server binds to
  //
  // The configured bind addresses. An empty list means the server listens on
  // all interfaces.
  bind []string
  // Whether the server listens on all network interfaces
  //
  // True when no bind address is configured or a wildcard address such as
  // 0.0.0.0 is present, exposing the server beyond loopback.
  bindsAllInterfaces bool
  // Whether a password is configured (the requirepass value)
  //
  // The password value itself is never exposed, only whether one is set. A
  // false value means unauthenticated clients that reach the port are served.
  requirepassSet bool
  // TLS port, or 0 when TLS is disabled
  tlsPort int
  // Whether the TLS listener is enabled
  tlsEnabled bool
  // Client-certificate policy for TLS: "yes", "no", or "optional"
  //
  // "yes" requires and verifies a client certificate (mutual TLS); "no" does
  // not enforce one.
  tlsAuthClients string
  // Path to the external ACL file, or empty when access-control rules are inline
  aclFile string
  // Default pub/sub permission granted to newly created access-control users
  //
  // The acl-pubsub-default setting. "resetchannels" grants a new user no
  // channels until channel rules are added; "allchannels" grants every
  // channel. Under "allchannels" a user with an empty channelPatterns list
  // reaches every channel, so the empty list means unrestricted rather than
  // restricted, and reading a user's channel exposure depends on this value.
  aclPubsubDefault string
  // Access-control users defined on the server
  users() []redisdb.acl.user
  // Durability and resource-limit configuration
  config() redisdb.config
}

// Redis or Valkey access-control user
//
// A single access-control user and the rules that govern it: whether it is
// enabled, whether it has no password, and the key patterns, channel patterns,
// and command rules it is granted. The keyPatterns, channelPatterns, and
// commandRules fields describe the user's base rules only; any additional
// permission sets attached to the user are reported separately by selectors,
// and a full picture of what the user can reach needs both. Read from
// ACL GETUSER. The name field selects the user, for example
// redisdb.instance.users.where(name == "default").
redisdb.acl.user @defaults("name enabled nopass") {
  // User name
  name string
  // Whether this is the built-in default user
  isDefault bool
  // Whether the user is enabled and can authenticate
  enabled bool
  // Whether the user has no password
  //
  // When true, the user authenticates with no password. A nopass, enabled
  // default user means anyone who reaches the port has that user's access.
  nopass bool
  // Number of passwords configured for the user
  //
  // A count of the configured password hashes; the hashes themselves are not
  // exposed.
  passwordCount int
  // Key patterns the user's base rules may access
  //
  // Glob patterns of the keys the base rules allow the user to operate on. A
  // single "*" means all keys. Keys reachable only through a selector are not
  // listed here; read selectors for those.
  keyPatterns []string
  // Pub/sub channel patterns the user's base rules may access
  //
  // A single "*" means all channels. An empty list means the base rules grant
  // no channels, unless the server's aclPubsubDefault is "allchannels", in
  // which case a user created without channel rules reaches every channel.
  // Channels reachable only through a selector are not listed here.
  channelPatterns []string
  // Command rules granted by the user's base rules
  //
  // The effective command allow and deny rules, for example "+@all -@dangerous"
  // or "-@all +get +set". Categories are prefixed with @. Commands permitted
  // only by a selector are not listed here, so a "-@all" base rule set does not
  // on its own mean the user can run nothing.
  commandRules []string
  // Additional permission sets attached to the user
  //
  // Selectors, available on Redis 7.0 and later. Redis permits a command when
  // the base rules allow it or when any one selector allows it, so a user
  // whose base commandRules read "-@all" can still hold a selector granting
  // "+@all ~*". An audit of what the user can actually do has to read these
  // alongside the base rules. Empty on servers without selector support.
  selectors() []redisdb.acl.selector
}

// Redis or Valkey access-control selector
//
// One additional permission set attached to an access-control user, available
// on Redis 7.0 and later. A selector carries its own command rules, key
// patterns, and channel patterns, and grants access on its own: Redis permits
// a command when the user's base rules allow it or when any one selector
// allows it. Selectors are reported in the order Redis applies them.
private redisdb.acl.selector @defaults("commandRules keyPatterns") {
  // Command rules granted by this selector
  //
  // The allow and deny rules that apply within the selector, for example
  // "-@all +set". Categories are prefixed with @.
  commandRules []string
  // Key patterns this selector may access
  //
  // Glob patterns of the keys the selector allows. A single "*" means all keys.
  keyPatterns []string
  // Pub/sub channel patterns this selector may access
  //
  // A single "*" means all channels.
  channelPatterns []string
}

// Redis or Valkey durability configuration
//
// The durability and resource-limit settings relevant to availability and
// data-at-rest: RDB snapshotting, append-only logging, memory cap and eviction
// policy, and the on-disk data location. Read from CONFIG GET.
redisdb.config @defaults("appendOnly rdbEnabled maxmemoryPolicy") {
  // RDB snapshot schedule, empty when snapshotting is disabled
  save string
  // Whether RDB snapshotting is enabled
  rdbEnabled bool
  // Whether append-only file persistence is enabled
  appendOnly bool
  // Append-only fsync policy: "everysec", "always", or "no"
  appendFsync string
  // Maximum memory in bytes, or 0 for no limit
  maxmemory int
  // Eviction policy when maxmemory is reached, for example "noeviction" or "allkeys-lru"
  maxmemoryPolicy string
  // Path to the log file, empty when logging goes to standard output
  logfile string
  // Working directory where RDB and AOF files are written
  dir string
  // RDB file name
  dbFilename string
}
