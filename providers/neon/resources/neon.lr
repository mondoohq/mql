import core

option provider = "go.mondoo.com/mql/providers/neon"
option go_package = "go.mondoo.com/mql/providers/neon/resources"
option root = "neon"

// Neon
//
// Neon account posture across every organization and project the API key can
// reach. The `organizations` field enumerates those organizations with their
// members and API keys, `projects` flattens every project across them,
// `apiKeys` lists the keys owned by the authenticated account, and
// `currentUser` identifies the principal the key belongs to.
neon @root {
  // Organizations the API key can access
  organizations() []neon.organization
  // Projects across every accessible organization
  projects() []neon.project
  // API keys owned by the authenticated account
  apiKeys() []neon.apiKey
  // Authenticated Neon account behind the API key
  currentUser() neon.user
}

// Neon User
//
// The authenticated Neon account behind the API key, including its email,
// display name, plan, and the identity providers it can sign in with. Use it to
// attribute a scan to a principal and to confirm which account the key belongs
// to.
private neon.user @defaults("email name") {
  // Unique user identifier
  id string
  // Primary email address
  email string
  // Display name of the account
  name string
  // Family name of the account holder
  lastName string
  // Plan the account is subscribed to
  plan string
  // Identity providers the account can sign in with
  //
  // Each entry names a linked provider, such as github, google, or hasura. An
  // account reachable through a social provider inherits that provider's
  // authentication controls, including whether it enforces multi-factor
  // authentication.
  authProviders []string
  // Maximum number of projects the account may create
  projectsLimit int
  // Maximum number of branches the account may create per project
  branchesLimit int
}

// Neon Organization
//
// A Neon organization and the posture that applies to every project under it.
// The `members` field lists the roster with each member's role, `apiKeys`
// covers the organization-scoped keys with when each was last used and from
// where, and `allowHipaaProjects` reports whether projects may be marked as
// handling regulated health data. Select an organization with
// `neon.organizations.where(name == "acme")`.
private neon.organization @defaults("name plan") {
  // Unique organization identifier
  id string
  // Display name
  name string
  // URL-safe organization handle
  handle string
  // Plan the organization is subscribed to, for example free, launch, or scale
  plan string
  // Whether projects in the organization may be marked as HIPAA regulated
  allowHipaaProjects bool
  // Whether members must have multi-factor authentication enabled
  //
  // When false, a member can hold administrative rights over every project in
  // the organization behind a single factor. The `hasMfa` field on each member
  // reports who has enrolled regardless of whether it is required.
  requireMfa bool
  // Mechanism that manages the organization
  //
  // An organization created through the console or the API reports console.
  // An organization created another way, such as through a cloud marketplace
  // subscription, reports that source and cannot be deleted through the API.
  managedBy string
  // Time the organization was created
  createdAt time
  // Time the organization was last updated
  updatedAt time
  // Members of the organization and the role each holds
  members() []neon.organization.member
  // API keys scoped to the organization
  apiKeys() []neon.apiKey
  // Projects belonging to the organization
  projects() []neon.project
  // Invitations sent but not yet accepted
  invitations() []neon.organization.invitation
}

// Member of a Neon organization
//
// A single member of an organization with the role that member holds. Use
// `role` to find members holding administrative rights, which in Neon carry
// project creation, member management, and API key issuance.
private neon.organization.member @defaults("email role") {
  // Unique membership identifier
  id string
  // Email address of the member
  email string
  // Role the member holds
  //
  // One of admin, member, editor, viewer, or collaborator. An admin carries
  // project creation, member management, and API key issuance across the
  // whole organization.
  role string
  // Whether the member has multi-factor authentication enabled
  //
  // Reported per member whether or not the organization requires it, so an
  // admin without a second factor is visible even where enrollment is
  // voluntary.
  hasMfa bool
  // Time the member joined the organization
  joinedAt time
  // Time the account was deactivated, or null while it is active
  //
  // A deactivated account stays on the roster with the role it held, so a
  // roster read that ignores this field counts access that can no longer be
  // exercised alongside access that can.
  deactivatedAt time
}

// Neon API Key
//
// A key that authenticates against the Neon API with the rights of the account
// or organization that issued it. The `lastUsedAt` and `lastUsedFromAddr`
// fields show when and from where the key last authenticated, which is what
// distinguishes a key still in service from one left behind. Neon does not
// expire keys, so an unused key keeps working until it is revoked.
private neon.apiKey @defaults("name lastUsedAt") {
  // Unique key identifier
  id string
  // Human-readable key name
  name string
  // Display name of the account that created the key
  createdByName string
  // Time the key was created
  createdAt time
  // Time the key last authenticated, or null when it never has
  lastUsedAt time
  // Address the key last authenticated from, or null when it never has
  lastUsedFromAddr string
}

// Neon Project
//
// A Neon project and the controls that govern who can reach its data. Query
// `blockPublicConnections` and `allowedIps` for network exposure of the
// project's compute endpoints, `blockVpcConnections` for private connectivity,
// `storePasswords` for whether Neon retains role passwords, `hipaa` for
// regulated-data handling, `historyRetentionSeconds` for how far back a branch
// can be restored, and `enableLogicalReplication` for whether data can be
// streamed out to another system. The `branches`, `endpoints`, `permissions`,
// and `jwksEndpoints` fields cover what runs in the project and who can reach
// it. Select a project with `neon.projects.where(name == "production")`.
private neon.project @defaults("name regionId") {
  // Unique project identifier
  id string
  // Project name
  name string
  // Cloud platform the project runs on, for example aws or azure
  platformId string
  // Region the project runs in, for example aws-us-east-1
  regionId string
  // Major PostgreSQL version the project runs
  pgVersion int
  // Compute provisioner backing the project's endpoints
  provisioner string
  // Host that proxies connections to the project
  proxyHost string
  // Whether connections from the public internet are blocked
  //
  // When true, the project answers only over private connectivity, and this
  // supersedes the allowedIps list. When false, the endpoints are reachable
  // from any address the allowedIps list permits.
  blockPublicConnections bool
  // Whether connections arriving over VPC endpoints are blocked
  blockVpcConnections bool
  // Addresses permitted to connect to the project's endpoints
  //
  // Empty when every address is permitted, which is the default. An entry is
  // a single address or a CIDR range.
  allowedIps []string
  // Whether the allowed-address list applies only to protected branches
  //
  // When true, the list constrains protected branches and every other branch
  // stays reachable from any address.
  allowedIpsProtectedBranchesOnly bool
  // Whether write-ahead logging is set up for logical replication
  //
  // Enabling logical replication lets an outside system subscribe to the
  // project's changes. Neon cannot turn it back off once enabled.
  enableLogicalReplication bool
  // Whether Neon retains the passwords of the project's roles
  //
  // Storing passwords lets features that connect on the account's behalf work,
  // and it means the passwords are recoverable through the API by anyone the
  // key authorizes.
  storePasswords bool
  // Whether the project is marked as handling HIPAA regulated data
  hipaa bool
  // Time HIPAA handling was enabled for the project, or null when it is not
  hipaaEnabledAt time
  // Level of audit logging configured for the project
  auditLogLevel string
  // Seconds of history retained for restoring the project's branches
  //
  // A longer window allows recovery from a change discovered late. A window of
  // zero means a branch cannot be restored to an earlier point.
  historyRetentionSeconds int
  // Time the project was created
  createdAt time
  // Time the project was last updated
  updatedAt time
  // Time any endpoint of the project was last active, or null when never
  computeLastActiveAt time
  // Email address of the account that owns the project
  ownerEmail() string
  // Organization the project belongs to, or null for a personal project
  organization() neon.organization
  // Branches of the project
  branches() []neon.branch
  // Default branch of the project
  defaultBranch() neon.branch
  // Compute endpoints across every branch of the project
  endpoints() []neon.endpoint
  // Accounts outside the project's owner that have been granted access
  permissions() []neon.project.permission
  // JWKS endpoints trusted to authenticate database access
  jwksEndpoints() []neon.project.jwksEndpoint
  // Private connectivity endpoints attached to the project
  vpcEndpoints() []neon.vpcEndpoint
  // Findings reported by Neon's own advisor checks
  advisorIssues() []neon.project.advisorIssue
  // Members of the owning organization and the rights each holds on the project
  members() []neon.project.member
  // Control-plane operations Neon has run on the project
  operations() []neon.project.operation
  // Snapshots captured of the project's branches
  snapshots() []neon.project.snapshot
}

// Access granted on a Neon project
//
// A grant of project access to an account outside the project's owner. The
// `revokedAt` field is null while the grant is live, so a query for live grants
// is what shows who can reach the project's data today. Sharing survives the
// departure of the person who set it up, so an unreviewed grant is how access
// outlives its reason.
private neon.project.permission @defaults("grantedToEmail grantedAt") {
  // Unique grant identifier
  id string
  // Email address the project was shared with
  grantedToEmail string
  // Time the grant was made
  grantedAt time
  // Time the grant was revoked, or null while it is live
  revokedAt time
}

// JWKS endpoint trusted by a Neon project
//
// A JSON Web Key Set that the project trusts to authenticate database access,
// which is how an outside identity provider is wired up to Postgres row-level
// security. The `jwksUrl` field is the endpoint whose keys are trusted, and
// `roleNames` reports which database roles a presented token may act as, so a
// token minted by that provider reaches the data those roles can read.
private neon.project.jwksEndpoint @defaults("providerName jwksUrl") {
  // Unique JWKS identifier
  id string
  // URL the key set is published at
  jwksUrl string
  // Name of the authentication provider, for example Clerk, Stytch, or Auth0
  providerName string
  // Audience a presented token must carry, or null when any audience is accepted
  jwtAudience string
  // Database roles a token authenticated by this key set may act as
  roleNames []string
  // Time the key set was registered
  createdAt time
  // Time the key set was last updated
  updatedAt time
  // Branch the key set applies to, or null when it applies to every branch
  branch() neon.branch
}

// Private connectivity endpoint of a Neon project
//
// A VPC endpoint attached to a project so connections can arrive over private
// connectivity rather than the public internet. It is what
// `blockPublicConnections` on the project is set alongside.
private neon.vpcEndpoint @defaults("vpcEndpointId label") {
  // Identifier of the VPC endpoint in the cloud platform
  vpcEndpointId string
  // Descriptive label given to the endpoint
  label string
  // Attachment state of the endpoint
  //
  // A value of new means the endpoint has been configured but Neon has not
  // accepted the connection yet, so nothing reaches the project over it. A
  // value of accepted means the private path is live. A project that sets
  // blockPublicConnections against an endpoint that is not accepted is not
  // privately reachable, it is unreachable.
  state() string
  // Number of projects restricted to reaching Neon over this endpoint
  numRestrictedProjects() int
  // Projects restricted to this endpoint, at most three of them
  //
  // The API returns a sample rather than the full set. Compare its length
  // against numRestrictedProjects to tell a complete list from a sample.
  exampleRestrictedProjects() []neon.project
}

// Neon Branch
//
// A branch of a Neon project, holding its own copy of the data and its own
// roles and databases. Query `protected` for whether the branch is guarded
// against deletion and reset and covered by the project's allowed-address list,
// `default` for whether it is the branch applications connect to by default,
// and `restrictedActions` for what the branch currently refuses. A branch
// created from production data carries that data at full fidelity, so a
// long-lived unprotected branch is a second copy of production with weaker
// controls. Select a branch with
// `neon.projects.branches.where(name == "main")`.
private neon.branch @defaults("name protected") {
  // Unique branch identifier
  id string
  // Branch name
  name string
  // Whether the branch is the project's default branch
  default bool
  // Whether the branch is protected
  //
  // A protected branch cannot be deleted or reset, and the project's
  // allowed-address list applies to it even when the list is configured to
  // constrain protected branches only.
  protected bool
  // Lifecycle state of the branch, for example init, ready, or archived
  //
  // An archived branch has been moved to cold storage after a period of
  // inactivity and is restored on the next connection.
  currentState string
  // Logical size of the branch in bytes, or null when not yet measured
  logicalSize int
  // Source the branch was initialized from, either parent-data or schema-only
  //
  // A branch initialized from parent-data carries the parent's rows. A branch
  // initialized from schema-only carries the structure without the data.
  initSource string
  // Actions the branch currently refuses and why
  //
  // Each entry carries the `name` of a restricted action, such as restore or
  // delete-rw-endpoint, and the `reason` it is restricted.
  restrictedActions []dict
  // Time the branch is scheduled to expire and be deleted, or null when it has no expiry
  expiresAt time
  // Time the branch was created
  createdAt time
  // Time the branch was last updated
  updatedAt time
  // Time the branch was last reset from its parent, or null when it never was
  lastResetAt time
  // Project the branch belongs to
  project() neon.project
  // Branch this branch was created from, or null for a root branch
  parent() neon.branch
  // Compute endpoints attached to the branch
  endpoints() []neon.endpoint
  // Postgres roles defined on the branch
  roles() []neon.role
  // Databases defined on the branch
  databases() []neon.database
  // Neon Auth integration on the branch, or null when none is set up
  auth() neon.auth
  // Object storage buckets on the branch
  buckets() []neon.bucket
  // Scoped credentials issued against the branch
  credentials() []neon.credential
  // Functions deployed on the branch
  functions() []neon.function
}

// Compute endpoint of a Neon branch
//
// The compute that serves connections to a branch, and the network surface
// clients reach it on. Query `disabled` for whether the endpoint refuses
// connections outright, `passwordlessAccess` for whether a client may connect
// without presenting a password, `poolerEnabled` and `poolerMode` for
// connection pooling, and the autoscaling and suspend-timeout fields for how
// the compute behaves under load and at rest. Select an endpoint with
// `neon.projects.endpoints.where(type == "read_write")`.
private neon.endpoint @defaults("id host") {
  // Unique endpoint identifier
  id string
  // Hostname clients connect to
  host string
  // Endpoint type, either read_write or read_only
  type string
  // Lifecycle state of the compute, for example init, active, or idle
  currentState string
  // Whether connections to the endpoint are refused
  //
  // A disabled endpoint cannot be woken by a connection or a console action,
  // which takes the branch's data out of reach without deleting it.
  disabled bool
  // Whether a client may connect without presenting a password
  passwordlessAccess bool
  // Whether connection pooling is enabled
  poolerEnabled bool
  // Pooling mode, for example transaction
  poolerMode string
  // Minimum compute units the endpoint scales down to
  autoscalingLimitMinCu float
  // Maximum compute units the endpoint scales up to
  autoscalingLimitMaxCu float
  // Seconds of inactivity before the compute suspends
  //
  // A value of zero applies the default. A suspended compute wakes on the next
  // connection.
  suspendTimeoutSeconds int
  // Region the endpoint runs in
  regionId string
  // Compute provisioner backing the endpoint
  provisioner string
  // Time the endpoint was created
  createdAt time
  // Time the endpoint was last active, or null when it never was
  lastActive time
  // Time the endpoint was last started, or null when it never was
  startedAt time
  // Time the endpoint was last suspended, or null when it never was
  suspendedAt time
  // Branch the endpoint serves
  branch() neon.branch
  // Project the endpoint belongs to
  project() neon.project
}

// Postgres role on a Neon branch
//
// A database role defined on a branch. The `protected` field reports whether
// Neon maintains the role for its own features rather than an operator having
// created it. Role passwords are not exposed, though a project with
// `storePasswords` enabled holds them in a form the API can return.
private neon.role @defaults("name protected") {
  // Role name
  name string
  // Whether the role is maintained by Neon rather than by an operator
  protected bool
  // How a client authenticates as the role
  //
  // Either password for a role holding its own credential, or another
  // mechanism where the role is reached through a trusted key set rather than
  // by presenting a password.
  authenticationMethod string
  // Time the role was created
  createdAt time
  // Time the role was last updated
  updatedAt time
  // Branch the role is defined on
  branch() neon.branch
}

// Database on a Neon branch
//
// A Postgres database on a branch, together with the role that owns it. The
// owning role holds full rights over the database, so `owner` is where a review
// of who can read a database starts.
private neon.database @defaults("name") {
  // Unique database identifier
  id string
  // Database name
  name string
  // Time the database was created
  createdAt time
  // Time the database was last updated
  updatedAt time
  // Role that owns the database
  owner() neon.role
  // Branch the database is defined on
  branch() neon.branch
  // Data API publishing the database over HTTP, or null when none is deployed
  dataApi() neon.dataApi
}

// Invitation to a Neon organization
//
// An invitation sent to an email address that has not been accepted yet. An
// outstanding invitation carrying the admin role is organization-wide
// administrative access waiting to be claimed by whoever controls that
// mailbox, and it does not appear on the member roster until it is accepted.
// Query `email` against the addresses the organization expects to grant access
// to, and `role` for what the invitation confers.
private neon.organization.invitation @defaults("email role invitedAt") {
  // Unique invitation identifier
  id string
  // Email address the invitation was sent to
  email string
  // Role the invitation confers once accepted
  //
  // One of admin, member, editor, viewer, or collaborator.
  role string
  // Time the invitation was sent
  invitedAt time
  // Member who sent the invitation, or null when they have left the organization
  invitedBy() neon.organization.member
}

// Finding reported by Neon's advisors
//
// A single finding from the first-party checks Neon runs over a project's
// Postgres schema and its exposure, such as a table left without row-level
// security. The `facing` field separates a finding that affects what the
// project publishes externally from one that is internal only, `level` carries
// the severity, `categories` separates security findings from performance
// ones, and `remediation` carries the fix Neon suggests.
private neon.project.advisorIssue @defaults("name level facing") {
  // Identifier of the issue type, for example rls_disabled_in_public
  name string
  // Human-readable title of the finding
  title string
  // Severity of the finding, for example ERROR, WARN, or INFO
  level string
  // Whether the finding affects external exposure
  //
  // A value of EXTERNAL means the finding concerns what the project publishes
  // beyond its own boundary, which is where an unauthenticated reader could
  // reach it. A value of INTERNAL means it is confined to the project.
  facing string
  // Categories the finding belongs to, either SECURITY or PERFORMANCE
  categories []string
  // Description of what the check looks for
  description string
  // Detail of what the check found on this project
  detail string
  // Remediation Neon suggests for the finding
  remediation string
  // Structured detail of the finding, such as the schema and table it concerns
  metadata dict
}

// Member of a Neon project
//
// An account of the owning organization together with the rights it holds on
// one project. Query `effectiveProjectPermission` for what the member can
// actually do, since it resolves an explicit grant, the organization's default
// for the project, and an organization-admin override into a single answer.
// The `grantSource` field reports which of those produced it, so access held
// only because someone is an organization admin is distinguishable from access
// granted on the project itself.
private neon.project.member @defaults("email effectiveProjectPermission grantSource") {
  // Unique membership identifier
  id string
  // Email address of the member
  email string
  // Display name of the member
  name string
  // Role the member holds in the owning organization
  //
  // One of admin, member, editor, viewer, or collaborator.
  orgRole string
  // Role the member holds on the project, or null when none is set on it
  //
  // One of viewer, editor, or admin.
  projectRole string
  // Permission the organization applies to the project by default
  //
  // One of VIEWER, EDITOR, or ADMIN.
  orgDefaultProjectPermission string
  // Permission granted on the project itself, or null when none was granted
  //
  // One of VIEWER, EDITOR, or ADMIN.
  explicitProjectPermission string
  // Permission the member actually holds on the project
  //
  // One of VIEWER, EDITOR, or ADMIN. This is the resolved answer, and it is
  // what a review of who can change the project should read.
  effectiveProjectPermission string
  // Where the effective permission came from
  //
  // One of explicit for a grant made on the project, org_role_default for the
  // organization's default, org_admin_override for rights held only by virtue
  // of organization administration, or unassigned when the member holds none.
  grantSource string
  // Membership of the owning organization, or null when it cannot be read
  organizationMember() neon.organization.member
}

// Control-plane operation on a Neon project
//
// A single action Neon ran on a project, which is the only change record the
// API exposes. The `action` field names what ran, and the actions that change
// a project's guarantees are visible here rather than on the resource they
// changed: timeline_update_protected_config is a branch gaining or losing
// protection, and detach_parent_branch is a branch being severed from the one
// it was created from. Query `status` for whether the action completed and
// `failuresCount` for one that kept failing.
private neon.project.operation @defaults("action status createdAt") {
  // Unique operation identifier
  id string
  // Action that ran
  //
  // Values include create_branch, delete_timeline, detach_parent_branch,
  // timeline_update_protected_config, apply_config, start_compute, and
  // suspend_compute, among others.
  action string
  // Lifecycle state of the operation
  //
  // One of scheduling, running, finished, failed, error, cancelling,
  // cancelled, or skipped.
  status string
  // Message describing why the operation failed, or null when it did not
  error string
  // Number of times the operation failed
  failuresCount int
  // Time the operation was last retried, or null when it never was
  retryAt time
  // Time the operation was created
  createdAt time
  // Time the operation's status was last updated
  updatedAt time
  // Total duration of the operation in milliseconds
  totalDurationMs int
  // Branch the operation ran on, or null when it was not branch-scoped
  branch() neon.branch
  // Compute endpoint the operation ran on, or null when it was not endpoint-scoped
  endpoint() neon.endpoint
  // Project the operation ran on
  project() neon.project
}

// Snapshot of a Neon branch
//
// A point-in-time capture of a branch that a new branch can be restored from.
// Snapshots are the durable restore path, and they outlive the window that
// historyRetentionSeconds describes, so a project whose branches carry no
// snapshot can only be recovered as far back as that window reaches. The
// `manual` field separates a snapshot an operator took from one a schedule
// produced, and `expiresAt` is when the snapshot stops being available.
private neon.project.snapshot @defaults("name createdAt expiresAt") {
  // Unique snapshot identifier
  id string
  // Human-readable label for the snapshot
  name string
  // Write-ahead log position the snapshot was captured at
  lsn string
  // Point in time the snapshot captures
  timestamp time
  // Time the snapshot was created
  createdAt time
  // Time the snapshot expires and becomes eligible for deletion, or null when it does not expire
  expiresAt time
  // Whether an operator took the snapshot rather than a schedule producing it
  manual bool
  // Full size of the snapshot in bytes
  fullSize int
  // Size of the snapshot's difference from its predecessor in bytes
  diffSize int
  // Branch the snapshot was captured from, or null when that branch is gone
  sourceBranch() neon.branch
}

// Object storage bucket on a Neon branch
//
// A bucket on the object storage plane attached to a branch. The
// `accessLevel` field governs who may read the objects it holds, and a value
// of public_read serves every object to an anonymous caller over HTTP. That
// plane is separate from the project's Postgres endpoints, so neither
// blockPublicConnections nor allowedIps constrains what a bucket publishes.
private neon.bucket @defaults("name accessLevel") {
  // Bucket name
  name string
  // Who may read the bucket's objects
  //
  // A value of private requires a credential carrying the storage:read scope.
  // A value of public_read serves every object in the bucket to any caller,
  // with no credential and no network restriction.
  accessLevel string
  // Time the bucket was created
  createdAt time
  // Branch the bucket is attached to
  branch() neon.branch
}

// Scoped credential on a Neon branch
//
// A bearer credential issued against a branch, separate from the API keys that
// authenticate to the control plane. The `scopes` field lists the capabilities
// it carries, such as reading or writing object storage and invoking
// functions. Unlike an API key a credential may carry an expiry, and
// `expiresAt` is null when it never expires, so a credential holding
// storage:write with no expiry and no recent use is a secret left behind.
// Query `revokedAt` for whether the credential is still live.
private neon.credential @defaults("tokenIdShort scopes expiresAt") {
  // Shortened form of the credential identifier, safe to record
  //
  // The full credential identifier is not exposed, and the bearer token itself
  // is returned only once when the credential is issued.
  tokenIdShort string
  // Label given to the credential at issuance, or null when none was given
  name string
  // Capabilities the credential carries
  //
  // Each entry is one of storage:read, storage:write, ai_gateway:invoke, or
  // functions:invoke. A credential may only do what its scopes list.
  scopes []string
  // Kind of principal the credential authenticates as
  //
  // A value of user is a credential an operator issued. Values of function and
  // system are issued by Neon for its own use and are not created through the
  // customer-facing API.
  principalType string
  // Time the credential was created
  createdAt time
  // Time the credential last authenticated, or null when it never has
  lastUsedAt time
  // Time the credential was revoked, or null while it is live
  revokedAt time
  // Time the credential expires, or null when it never expires
  expiresAt time
  // Branch the credential is scoped to, or null when it is not branch-scoped
  branch() neon.branch
  // Function the credential was minted for, or null when it was not
  function() neon.function
}

// Function deployed on a Neon branch
//
// Code Neon runs on a branch's behalf, reachable at `invocationUrl`. That URL
// resolves publicly, so a project's functions are an internet-facing compute
// surface that neither blockPublicConnections nor allowedIps governs. The
// `activeDeployment` field is the build currently serving traffic and
// `currentDeployment` is the most recent build, which differ while a
// deployment is still building or after one failed.
private neon.function @defaults("name slug invocationUrl") {
  // Unique function identifier
  id string
  // Branch-unique name forming the first label of the invocation URL
  slug string
  // Display name of the function
  name string
  // URL the function is invoked at
  //
  // The host carries the branch identifier and the slug under a Neon-managed
  // domain, and it resolves from the public internet.
  invocationUrl string
  // Time the function was created
  createdAt time
  // Build currently serving invocations, or null when none is live
  activeDeployment() neon.function.deployment
  // Most recent build, or null when the function has never been deployed
  currentDeployment() neon.function.deployment
  // Branch the function is deployed on
  branch() neon.branch
}

// Build of a Neon function
//
// One build of a function, carrying the runtime it executes under and the
// names of the environment variables it was deployed with. Neon encrypts the
// values and never returns them, so `environment` lists names only, which is
// still what shows a function wired to a secret it should not hold. Query
// `status` for whether the build completed and `error` for why one failed.
private neon.function.deployment @defaults("id status runtime") {
  // Build number, which increases with each deployment of the function
  id int
  // Build lifecycle state
  //
  // One of pending, building, completed, or failed.
  status string
  // Memory the build runs with, in mebibytes
  memoryMib int
  // Runtime the build executes under, for example nodejs24
  runtime string
  // Time the build was created
  createdAt time
  // Names of the environment variables the build was deployed with
  //
  // Neon encrypts the values and never returns them, so only the names appear
  // here.
  environment []string
  // Message describing why the build failed, or null when it did not
  error string
}

// Data API of a Neon database
//
// A REST interface that publishes a database over HTTP. An anonymous request
// is executed as the role named by `dbAnonRole`, so whatever that role can
// read is what an unauthenticated caller can read, across every schema listed
// in `dbSchemas`. The `corsAllowedOrigins` field is the browser-side
// allowlist, and a value of `*` alongside a privileged anonymous role is a
// reachable path to the data. This interface is served separately from the
// project's Postgres endpoints, so blockPublicConnections does not govern it.
private neon.dataApi @defaults("url status dbAnonRole") {
  // URL the Data API is served at
  url string
  // Deployment state of the Data API
  status string
  // Role an anonymous request is executed as
  //
  // A request that presents no token runs with this role's rights, so the
  // grants held by this role are what the interface publishes to the public.
  dbAnonRole string
  // Schemas the interface exposes
  dbSchemas []string
  // Schemas the interface exposes that are available on the database
  availableSchemas []string
  // Extra schemas added to the search path, or null when none are
  dbExtraSearchPath string
  // Hard limit on rows returned in one response, or null when unlimited
  dbMaxRows int
  // Whether aggregate queries are permitted
  dbAggregatesEnabled bool
  // Browser origins permitted to call the interface
  //
  // A value of `*` permits a page on any origin to call the interface with the
  // caller's credentials. Null when no allowlist is configured.
  corsAllowedOrigins string
  // Claim of a presented token that names the role to run as, or null when unset
  jwtRoleClaimKey string
  // Seconds a verified token is cached for, or null when unset
  jwtCacheMaxLifetime int
  // Whether the interface publishes its own OpenAPI description, and to whom
  openapiMode string
  // Whether responses carry server timing headers
  serverTimingEnabled bool
  // Database the interface publishes
  database() neon.database
}

// Neon Auth integration on a branch
//
// The identity provider Neon runs for an application, and the record every
// other part of the identity surface hangs from. The `authProvider` field
// names which implementation backs it, and a value of mock is a stand-in for
// local development that does not actually verify anyone, so a branch serving
// production traffic behind it is not authenticating its users. Query
// `allowLocalhost` and `trustedDomains` for the redirect-URI boundary,
// the `emailPassword` fields for self-registration, and `oauthProviders` for
// how sign-in with an outside provider is configured.
private neon.auth @defaults("authProvider ownedBy") {
  // Implementation backing the integration
  //
  // One of mock, stack, or better_auth. A value of mock does not verify
  // credentials and exists for local development.
  authProvider string
  // Identifier of the project in the backing provider
  authProviderProjectId string
  // Database the integration stores its identity tables in
  dbName string
  // URL of the key set that signs the integration's tokens
  jwksUrl string
  // Base URL the integration is served at, or null when it has none
  baseUrl string
  // Display name of the integration, or null when it has none
  name string
  // Who owns the integration, either user or neon
  ownedBy string
  // State of an ownership transfer, either initiated or finished, or null when none is under way
  transferStatus string
  // Time the integration was created
  createdAt time
  // Whether a callback to a localhost address is accepted
  //
  // A localhost redirect URI is accepted from any caller, so a listener an
  // attacker controls on the victim's own machine can receive a token minted
  // for the victim. It is a development convenience that should not be left on
  // where real users sign in.
  allowLocalhost() bool
  // Domains a sign-in flow may redirect back to
  //
  // This is the redirect-URI allowlist, which is the boundary that keeps a
  // token from being delivered to somewhere the application does not control.
  trustedDomains() []string
  // Whether an account may be created with an email address and a password
  emailPasswordEnabled() bool
  // How an email address is verified, either link or otp
  emailVerificationMethod() string
  // Whether an address must be verified before the account is usable
  //
  // When false alongside a sign-up that is not disabled, anyone can register
  // an account against an address they do not control and use it.
  requireEmailVerification() bool
  // Whether verifying an address signs the account in
  autoSignInAfterVerification() bool
  // Whether a verification email is sent when an account is created
  sendVerificationEmailOnSignUp() bool
  // Whether a verification email is sent when an account signs in
  sendVerificationEmailOnSignIn() bool
  // Whether self-registration is turned off
  //
  // When false, any caller that reaches the integration may create an account.
  disableSignUp() bool
  // Providers a user may sign in with from outside
  oauthProviders() []neon.auth.oauthProvider
  // Branch the integration runs on
  branch() neon.branch
}

// Sign-in provider of a Neon Auth integration
//
// An outside provider users may sign in with. The `type` field separates a
// provider wired up with the tenant's own application credentials from one
// running on credentials Neon shares across tenants, and a value of shared
// means users are authenticated through a development registration Neon owns
// rather than the tenant's, which Neon documents as unsuitable for production.
// Client secrets are not exposed.
private neon.auth.oauthProvider @defaults("provider type") {
  // Provider users sign in with
  //
  // One of google, github, microsoft, or vercel.
  provider string
  // Whose application credentials the provider uses
  //
  // A value of standard means the tenant registered its own application with
  // the provider. A value of shared means Neon's shared development
  // credentials are used, which is not intended for production.
  type string
  // Client identifier of the registered application, or null when shared credentials are used
  clientId string
}
