  // Inbound rules the security list permits
  ingressRules []oci.network.securityRule
  // Outbound rules the security list permits
  egressRules []oci.network.securityRule
  // Whether any rule (ingress or egress) is stateless
  hasStatelessRules() bool
  // VCN that this security list belongs to
  vcn() oci.network.vcn
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Network Security Group (virtual firewall rules for VNICs)
//
// VNIC-level firewall whose rules apply only to the VNICs added to the group,
// giving finer-grained control than a subnet security list.
// `ingressSecurityRules` and `egressSecurityRules` hold the allowed traffic
// and `attachedVnics` lists what the group protects; audits check for rules
// admitting `0.0.0.0/0` or exposing sensitive ports.
private oci.network.networkSecurityGroup @defaults("name") {
  // NSG OCID
  id string
  // NSG display name
  name string
  // Compartment containing the NSG
  compartment() oci.compartment
  // VCN the NSG belongs to
  vcn() oci.network.vcn
  // NSG lifecycle state (e.g., PROVISIONING, AVAILABLE, TERMINATING, TERMINATED)
  state string
  // NSG creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // Ingress security rule dicts
  //
  // Deprecated in favor of ingressRules, which resolves the port ranges nested
  // inside tcpOptions and udpOptions into queryable fields. Each entry:
  // {direction, protocol (IANA number, e.g. "6"=TCP), description, source, sourceType, isStateless, tcpOptions{sourcePortRange{min,max}, destinationPortRange{min,max}}, udpOptions{...}, icmpOptions{type,code}}.
  ingressSecurityRules() @maturity("deprecated") @replaced_by("oci.network.networkSecurityGroup.ingressRules") []dict
  // Egress security rule dicts
  //
  // Deprecated in favor of egressRules. Same shape as ingressSecurityRules but
  // with destination/destinationType instead of source/sourceType.
  egressSecurityRules() @maturity("deprecated") @replaced_by("oci.network.networkSecurityGroup.egressRules") []dict
  // Inbound rules the group permits
  ingressRules() []oci.network.securityRule
  // Outbound rules the group permits
  egressRules() []oci.network.securityRule
  // Whether any rule (ingress or egress) is stateless
  hasStatelessRules() bool
  // VNICs this NSG is attached to (from ListNetworkSecurityGroupVnics + GetVnic)
  attachedVnics() []oci.compute.vnic
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Security rule from a VCN security list or network security group
//
// A single inbound or outbound rule, with the port ranges that OCI nests
// inside tcpOptions and udpOptions lifted into `sourcePortMin`,
// `sourcePortMax`, `destinationPortMin`, and `destinationPortMax` so traffic
// can be selected by port. `protocol` is the IANA protocol number as a string
// ("6" for TCP, "17" for UDP, "1" for ICMP, "58" for ICMPv6) or "all" when the
// rule covers every protocol. Rules from a security list apply to every VNIC
// in the subnets referencing it, while rules from a network security group
// apply only to the VNICs added to that group; OCI evaluates the union of
// both, so a rule from either layer can admit traffic on its own.
private oci.network.securityRule @defaults("direction protocol source destination destinationPortMin destinationPortMax") {
  // Traffic direction the rule covers: INGRESS or EGRESS
  direction string
  // Transport protocol
  //
  // The IANA protocol number as a string ("6" for TCP, "17" for UDP, "1" for
  // ICMP, "58" for ICMPv6), or "all" when the rule matches every protocol.
  protocol string
  // Rule description
  description string
  // Source the rule permits traffic from
  //
  // A CIDR block, the OCID of a network security group, or the name of a
  // service CIDR label, depending on sourceType. Empty on egress rules.
  source string
  // How to read the source value
  //
  // One of CIDR_BLOCK, SERVICE_CIDR_BLOCK, or NETWORK_SECURITY_GROUP. Empty on
  // egress rules.
  sourceType string
  // Destination the rule permits traffic to
  //
  // A CIDR block, the OCID of a network security group, or the name of a
  // service CIDR label, depending on destinationType. Empty on ingress rules.
  destination string
  // How to read the destination value
  //
  // One of CIDR_BLOCK, SERVICE_CIDR_BLOCK, or NETWORK_SECURITY_GROUP. Empty on
  // ingress rules.
  destinationType string
  // Whether the rule is stateless, so return traffic needs its own matching rule
  stateless bool
  // Lowest source port the rule covers
  //
  // Taken from the source port range of tcpOptions or udpOptions, whichever
  // the protocol selects. Null when the rule sets no source port range, which
  // means every source port, and on rules for protocols that carry no ports.
  sourcePortMin int
  // Highest source port the rule covers
  //
  // Null under the same conditions as sourcePortMin.
  sourcePortMax int
  // Lowest destination port the rule covers
  //
  // Taken from the destination port range of tcpOptions or udpOptions,
  // whichever the protocol selects. Null when the rule sets no destination
  // port range, which means every destination port, and on rules for protocols
  // that carry no ports. A null therefore admits more traffic than any explicit
  // range, so treat it as matching when selecting rules by port.
  destinationPortMin int
  // Highest destination port the rule covers
  //
  // Null under the same conditions as destinationPortMin.
  destinationPortMax int
  // ICMP message type the rule covers
  //
  // Null on rules for protocols other than ICMP and ICMPv6.
  icmpType int
  // ICMP message code the rule covers
  //
  // Null when the rule covers every code of its icmpType, and on rules for
  // protocols other than ICMP and ICMPv6.
  icmpCode int
}

// Oracle Cloud Infrastructure (OCI) internet gateway (connects VCN to the internet)
//
// Gateway that provides bidirectional internet connectivity for a VCN. A
// subnet is internet-reachable only when its route table forwards a default
// route to an internet gateway whose `isEnabled` is true, making this a key
// hop when auditing internet exposure.
private oci.network.internetGateway @defaults("name") {
  // Internet gateway OCID
