  // data-residency boundary is a copy of the credential beyond it.
  replicationTargets() []oci.vault.secret.replicationTarget
  // Name of the region holding the source secret this replica was copied from
  //
  // The full region name, for example us-phoenix-1. Empty when the secret is
  // not a replica.
  sourceRegionName string
  // Vault holding the source secret this replica was copied from
  //
  // Null when the secret is not a replica.
  sourceVault() oci.kms.vault
  // Key encrypting the source secret this replica was copied from
  //
  // Null when the secret is not a replica.
  sourceKey() oci.kms.key
  // Rotation interval in ISO 8601 duration format (e.g., P30D for 30 days)
  rotationInterval() string
  // Whether scheduled rotation is enabled
  isScheduledRotationEnabled() bool
  // Expiry time of the current secret version
  timeOfCurrentVersionExpiry() time
  // Secret versions
  secretVersions() []oci.vault.secretVersion
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Region a vault secret is replicated into
//
// One target of a secret's replication configuration, naming the region the
// secret's material is copied into together with the vault that holds it and
// the key that encrypts it there. The `regionName` field carries the full
// region name and stays populated even for a region the tenancy is not
// subscribed to, where the vault and key cannot be read.
private oci.vault.secret.replicationTarget @defaults("regionName") {
  // Name of the region the secret is replicated into
  //
  // The full region name, for example us-phoenix-1.
  regionName string
  // Region the secret is replicated into
  //
  // Null when the tenancy is not subscribed to the region, which leaves
  // `regionName` as the only record of where the copy went.
  region() oci.region
  // Vault in the target region that holds the replicated secret
  //
  // Null when the vault cannot be read from this tenancy's subscribed regions.
  vault() oci.kms.vault
  // Key in the target region that encrypts the replicated secret
  //
  // Null when the key cannot be read from this tenancy's subscribed regions.
  key() oci.kms.key
}

// Oracle Cloud Infrastructure (OCI) vault secret version
private oci.vault.secretVersion @defaults("versionNumber") {
  // Secret OCID this version belongs to
  secretId string
  // Secret version number
  versionNumber int
  // Version name
