// device reachable only over a private network rather than the public
// internet.
private oci.network.cpe @defaults("name ipAddress") {
  // CPE OCID
  id string
  // Display name
  name string
  // Compartment containing the CPE
  compartment() oci.compartment
  // Public IP address of the on-premises router terminating the VPN
  ipAddress string
  // OCID of the CPE device shape describing the on-premises router model
  cpeDeviceShapeId string
  // Whether the CPE is reachable only over a private network rather than the public internet
  isPrivate bool
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) site-to-site VPN IPSec connection
//
// Encrypted VPN linking an on-premises network to a VCN, terminating on a CPE
// at the customer end and a DRG at the OCI end. `transportType` records
// whether it runs over the public internet or FastConnect, and `tunnels`
// exposes the individual encrypted tunnels whose negotiated cryptography
// audits inspect.
private oci.network.ipsecConnection @defaults("name state") {
  // IPSec connection OCID
  id string
  // Display name
  name string
  // Compartment containing the IPSec connection
  compartment() oci.compartment
  // Customer-premises equipment terminating the on-premises end of the connection
  cpe() oci.network.cpe
  // Dynamic routing gateway terminating the OCI end of the connection
  drg() oci.network.drg
  // Static routes advertised to the CPE, as CIDR blocks
  staticRoutes []string
  // Identifier the CPE presents during IKE negotiation
  cpeLocalIdentifier string
  // Type of the CPE local identifier (IP_ADDRESS, HOSTNAME)
  cpeLocalIdentifierType string
  // Transport the tunnels traverse (INTERNET routes over the public internet; PRIVATE routes over FastConnect)
  transportType string
  // Tunnels carrying the connection's encrypted traffic
  tunnels() []oci.network.ipsecConnectionTunnel
  // Lifecycle state (e.g., PROVISIONING, AVAILABLE, TERMINATING, TERMINATED)
  state string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) IPSec tunnel
//
// One encrypted tunnel within a site-to-site VPN, carrying the negotiated
// cryptographic parameters that security audits check: the IKE version, the
// key-exchange encryption, authentication, and Diffie-Hellman group, and the
// data-channel encryption, authentication, and perfect-forward-secrecy
// setting. `status` and `bgpState` report whether the tunnel is up.
private oci.network.ipsecConnectionTunnel @defaults("name status ikeVersion") {
  // Tunnel OCID
  id string
  // Display name
  name string
  // Compartment containing the tunnel
  compartment() oci.compartment
  // Tunnel connection status (UP, DOWN, DOWN_FOR_MAINTENANCE, PARTIAL_UP)
  status string
  // IKE protocol version negotiated (V1, V2)
  //
  // IKEv1 is weaker than IKEv2; audits that require modern key exchange expect
  // V2.
  ikeVersion string
  // Routing type (BGP, STATIC, POLICY)
  routing string
  // Whether Oracle can initiate the tunnel (INITIATOR_OR_RESPONDER, RESPONDER_ONLY)
  oracleCanInitiate string
  // Whether NAT-T is enabled (ENABLED, DISABLED, AUTO)
  natTranslationEnabled string
  // Dead peer detection mode (INITIATE_AND_RESPOND, RESPOND_ONLY)
  dpdMode string
  // Oracle VPN headend IP address for the tunnel
  vpnIp string
  // CPE IP address for the tunnel
  cpeIp string
  // BGP session state, when routing is BGP (UP, DOWN)
  bgpState string
  // Negotiated IKE (ISAKMP) key-exchange encryption algorithm
  //
  // Null until the tunnel negotiates its security association, and while the
  // tunnel is down; the other negotiated crypto fields behave the same way.
  // Audit the configured counterparts below when the tunnel may not be up,
  // since those carry a value regardless.
  phase1EncryptionAlgorithm() string
  // Negotiated IKE (ISAKMP) key-exchange authentication algorithm
  phase1AuthenticationAlgorithm() string
  // Negotiated IKE (ISAKMP) key-exchange Diffie-Hellman group
  //
  // Larger groups resist attack better. Groups below 14 (2048-bit MODP)
  // are considered weak for modern key exchange.
  phase1DhGroup() string
  // Negotiated IPSec (ESP) data-channel encryption algorithm
  phase2EncryptionAlgorithm() string
  // Negotiated IPSec (ESP) data-channel authentication algorithm
  phase2AuthenticationAlgorithm() string
  // Whether perfect forward secrecy is enabled for the IPSec (ESP) data channel
  //
  // False also means the tunnel's negotiated crypto is unavailable (the
  // tunnel is down), not only that perfect forward secrecy is disabled.
  // Combine with `status` when auditing so an unknown tunnel is not
  // mistaken for one with it turned off.
  phase2PfsEnabled() bool
  // Diffie-Hellman group for IPSec (ESP) perfect forward secrecy
  phase2DhGroup() string
  // Configured IKE (ISAKMP) key-exchange encryption algorithm
  //
  // The custom proposal set on the tunnel, present whether or not the tunnel
  // has come up, so a tunnel that never negotiated is still auditable. Null
  // when the tunnel uses Oracle's default proposal set rather than a custom
  // one; `isCustomPhase1Config` distinguishes the two.
  phase1ConfiguredEncryptionAlgorithm() string
  // Configured IKE (ISAKMP) key-exchange authentication algorithm
  phase1ConfiguredAuthenticationAlgorithm() string
  // Configured IKE (ISAKMP) key-exchange Diffie-Hellman group
  phase1ConfiguredDhGroup() string
  // Configured IPSec (ESP) data-channel encryption algorithm
  phase2ConfiguredEncryptionAlgorithm() string
  // Configured IPSec (ESP) data-channel authentication algorithm
  phase2ConfiguredAuthenticationAlgorithm() string
  // Configured IPSec (ESP) data-channel Diffie-Hellman group
  phase2ConfiguredDhGroup() string
  // Whether the tunnel uses a custom IKE (ISAKMP) proposal set
  isCustomPhase1Config() bool
  // Whether the tunnel uses a custom IPSec (ESP) proposal set
  isCustomPhase2Config() bool
  // Whether the IKE (ISAKMP) security association is established
  //
  // False when the key exchange has not completed, which is also why the
  // negotiated phase 1 fields read null.
  isIkeEstablished() bool
  // Whether the IPSec (ESP) security association is established
  isEspEstablished() bool
  // IKE (ISAKMP) security association lifetime in seconds
  //
  // Null when OCI reports no lifetime. Shorter lifetimes force more frequent
  // rekeying.
  phase1Lifetime() int
  // IPSec (ESP) security association lifetime in seconds
  phase2Lifetime() int
  // Lifecycle state (e.g., PROVISIONING, AVAILABLE, TERMINATING, TERMINATED)
  state string
  // Creation time
  created time
}

// Oracle Cloud Infrastructure (OCI) FastConnect virtual circuit
//
// Dedicated FastConnect connection between the tenancy and an on-premises
// network or Oracle public services. `type` distinguishes a PUBLIC circuit
// reaching Oracle public services from a PRIVATE circuit reaching a VCN
// through a DRG, and the BGP session and administrative state report whether
// the routing session is up.
private oci.network.virtualCircuit @defaults("name type state") {
  // Virtual circuit OCID
  id string
  // Display name
  name string
  // Compartment containing the virtual circuit
  compartment() oci.compartment
  // Circuit type (PUBLIC exposes Oracle public services; PRIVATE reaches a VCN through a DRG)
  type string
  // Provisioning model (COLOCATED for a direct cross-connect; LAYER2 or LAYER3 for a provider-mediated circuit)
  serviceType string
  // Bandwidth shape name (e.g., 10 Gbps)
  bandwidthShapeName string
  // Whether Oracle or the customer manages BGP (CUSTOMER_MANAGED, ORACLE_MANAGED, PROVIDER_MANAGED)
  bgpManagement string
  // BGP session state (UP, DOWN)
  bgpSessionState string
  // BGP administrative state (ENABLED, DISABLED)
  bgpAdminState string
  // Dynamic routing gateway the circuit reaches, for a private virtual circuit
  drg() oci.network.drg
  // FastConnect partner name, for a provider-mediated circuit
  providerName string
  // FastConnect partner service name, for a provider-mediated circuit
  providerServiceName string
  // Public IP prefixes advertised over a public virtual circuit
  publicPrefixes []string
  // BGP peering mappings to the underlying cross-connects
  //
  // Deprecated in favor of mappings, which returns the same entries as
  // resources and resolves each one to the cross-connect it terminates on.
  // Each entry: {crossConnectOrCrossConnectGroupId, vlan,
  // customerBgpPeeringIp, oracleBgpPeeringIp, customerBgpPeeringIpv6,
  // oracleBgpPeeringIpv6}.
  crossConnectMappings @maturity("deprecated") @replaced_by("oci.network.virtualCircuit.mappings") []dict
  // BGP peering mappings to the underlying cross-connects
  //
  // One row per cross-connect the circuit terminates on, carrying the VLAN and
  // both ends of the BGP session. The BGP MD5 authentication key the API also
  // returns is deliberately not exposed.
  mappings []oci.network.virtualCircuit.crossConnectMapping
  // Lifecycle state (e.g., PENDING_PROVIDER, PROVISIONING, PROVISIONED, FAILED, INACTIVE, TERMINATING, TERMINATED)
  state string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// BGP peering mapping on a FastConnect virtual circuit
//
// A single cross-connect the virtual circuit terminates on, with the VLAN it
// was assigned and both ends of the BGP session. `crossConnect` resolves the
// physical port when the mapping names one; it is null when the mapping names
// a cross-connect group instead, or when the port belongs to the FastConnect
// provider rather than the tenancy. The BGP MD5 authentication key the API
// also returns for this mapping is deliberately not exposed.
private oci.network.virtualCircuit.crossConnectMapping @defaults("vlan customerBgpPeeringIp oracleBgpPeeringIp") {
  // OCID of the cross-connect or cross-connect group the mapping terminates on
  //
  // Empty on a provider-mediated circuit, where the FastConnect partner owns
  // the port rather than the tenancy.
  crossConnectId string
  // Cross-connect the mapping terminates on
  //
  // Null when the mapping names a cross-connect group rather than a single
  // port, and when the port is not readable in this tenancy.
  crossConnect() oci.network.crossConnect
  // VLAN assigned to this virtual circuit on the cross-connect
  //
  // Null on a mapping the tenancy does not own the port for.
  vlan int
  // BGP IPv4 address of the router on the far end of the session
  customerBgpPeeringIp string
  // BGP IPv4 address of Oracle's end of the session
  oracleBgpPeeringIp string
  // BGP IPv6 address of the router on the far end of the session
  //
  // Empty on a mapping that peers over IPv4 only.
  customerBgpPeeringIpv6 string
  // BGP IPv6 address of Oracle's end of the session
  //
  // Empty on a mapping that peers over IPv4 only.
  oracleBgpPeeringIpv6 string
}

// Oracle Cloud Infrastructure (OCI) FastConnect cross-connect
//
// Physical port at a FastConnect location that carries the tenancy's dedicated
// connectivity. `locationName` and `portName` identify the port,
// `portSpeedShapeName` its bandwidth, and `crossConnectGroupId` the link
// aggregation group when multiple cross-connects are bonded together.
private oci.network.crossConnect @defaults("name state") {
  // Cross-connect OCID
  id string
  // Display name
  name string
  // Compartment containing the cross-connect
  compartment() oci.compartment
  // Name of the FastConnect location housing the physical port
  locationName string
  // Name of the physical port at the FastConnect location
  portName string
  // Port speed shape name (e.g., 10 Gbps)
  portSpeedShapeName string
  // OCID of the cross-connect group this cross-connect belongs to, when grouped for link aggregation
  crossConnectGroupId string
  // Lifecycle state (e.g., PENDING_CUSTOMER, PROVISIONING, PROVISIONED, INACTIVE, TERMINATING, TERMINATED)
  state string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Logging
//
// Logging service for the tenancy, covering both service-emitted and
// custom logs across every compartment. The `logGroups` field returns
// the log groups, each holding its enabled `logs`, retention duration,
// source service and resource, and the log category (read, write, or
// all) that describes which events are captured. Query it to confirm
// audit and diagnostic logging is enabled where required.
oci.logging {
  // Log groups in the tenancy
  logGroups() []oci.logging.logGroup
}

// Oracle Cloud Infrastructure (OCI) log group
private oci.logging.logGroup @defaults("name") {
  // Log group OCID
  id string
  // Display name
  name string
  // Log group description
  description string
  // Compartment containing the log group
  compartment() oci.compartment
  // Lifecycle state (e.g., CREATING, ACTIVE, UPDATING, INACTIVE, DELETING, FAILED)
  state string
  // Logs in the group
  logs() []oci.logging.log
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) log
private oci.logging.log @defaults("name") {
  // Log OCID
  id string
  // Display name
  name string
  // Log type (SERVICE, CUSTOM)
  logType string
  // Parent log group
  logGroup() oci.logging.logGroup
  // Whether the log is enabled
  isEnabled bool
  // Lifecycle state (e.g., CREATING, ACTIVE, UPDATING, INACTIVE, DELETING, FAILED)
  state string
  // Retention duration in days
  retentionDuration int
  // Log configuration
  //
  // Keyed by `compartmentId` (OCID of the compartment owning the log),
  // `source`, a nested map describing the emitting service, and
  // `archiving` when object-storage archiving is configured. For a
  // service log the `source` map carries `sourceType`, `service`,
  // `resource`, and `category`. The `category`, `sourceService`, and
  // `sourceResource` fields surface those source values directly. The
  // `archiving` map carries `isEnabled`.
  configuration dict
  // Log category (e.g., all, write, read — depends on service)
  category string
  // Emitting OCI service (e.g., flowlogs, objectstorage, vcn)
  sourceService string
  // OCID of the resource emitting the log (e.g., a subnet OCID for flow logs)
  sourceResource string
  // Creation time
  created time
  // Last modification time
  timeLastModified time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Key Management Service
//
// Encryption vaults and customer-managed keys across the tenancy. Each
// vault (DEFAULT, VIRTUAL_PRIVATE, or EXTERNAL type) exposes its
// management endpoint and the keys it holds, and each key reports its
// algorithm, length, lifecycle state, rotation history, and whether it
// is software-protected or HSM-protected. Audit key rotation policy,
// protection mode, and vault type to confirm keys meet cryptographic
// and isolation requirements.
oci.kms {
  // Key vaults in the tenancy
  vaults() []oci.kms.vault
}

// Oracle Cloud Infrastructure (OCI) KMS vault
private oci.kms.vault @defaults("name") {
  // Vault OCID
  id string
  // Display name
  name string
  // Compartment containing the vault
  compartment() oci.compartment
  // Vault type (DEFAULT, VIRTUAL_PRIVATE, EXTERNAL)
  vaultType string
  // Lifecycle state
  //
  // For example: CREATING, ACTIVE, DELETING, DELETED, PENDING_DELETION, SCHEDULING_DELETION, CANCELLING_DELETION, UPDATING, BACKUP_IN_PROGRESS, RESTORING.
  state string
  // Vault management endpoint
  managementEndpoint string
  // Keys in the vault
  keys() []oci.kms.key
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) KMS key
private oci.kms.key @defaults("name") {
  // Key OCID
  id string
  // Display name
  name string
  // Compartment containing the key
  compartment() oci.compartment
  // Parent vault containing the key
  vault() oci.kms.vault
  // Key algorithm (AES, RSA, ECDSA)
  algorithm string
  // Key length in bits
  //
  // For example 2048 or 4096 for RSA keys and 256 for AES keys. For
  // ECDSA keys this is the key's byte length expressed in bits; use
  // `curveId` for the exact curve.
  length() int
  // Elliptic curve for ECDSA keys
  //
  // One of NIST_P256, NIST_P384, or NIST_P521. Empty for non-ECDSA
  // (AES, RSA) keys.
  curveId() string
  // Protection mode (HSM, SOFTWARE, EXTERNAL)
  protectionMode string
  // Lifecycle state
  //
  // For example: CREATING, ENABLING, ENABLED, DISABLING, DISABLED, DELETING, DELETED, PENDING_DELETION, SCHEDULING_DELETION, CANCELLING_DELETION, UPDATING, BACKUP_IN_PROGRESS, RESTORING.
  state string
  // Whether auto key rotation is enabled
  isAutoRotationEnabled bool
  // Interval between automatic key rotations, in days
  //
  // Between 60 and 365. Null when the key carries no rotation schedule, which
  // is the case whenever `isAutoRotationEnabled` is false. Without it a key
  // rotating yearly and a key rotating monthly read the same.
  rotationIntervalInDays() int
  // Time automatic rotation last ran for the key
  //
  // Null when automatic rotation has never run.
  lastRotationTime() time
  // Next estimated automatic rotation time
  //
  // Null when the key carries no rotation schedule.
  nextRotationTime() time
  // Outcome of the most recent automatic rotation
  //
  // One of SUCCESS, FAILED, or IN_PROGRESS. Empty when automatic rotation has
  // never run, so a key whose schedule exists but has never fired is
  // distinguishable from one whose last attempt failed.
  lastRotationStatus() string
  // Whether the key lives in the primary vault rather than a replica
  //
  // False when the key is the replicated copy of material created in another
  // region. Null when the service does not report it.
  isPrimary() bool
  // Identifier of the replication that copied this key across regions
  //
  // Empty when the key's material has not been replicated out of the region
  // it was created in.
  replicationId() string
  // Key versions (rotation history)
  keyVersions() []oci.kms.keyVersion
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) KMS key version (represents a specific version of a master encryption key)
private oci.kms.keyVersion @defaults("id") {
  // Key version OCID
  id string
  // Master encryption key OCID
  keyId string
  // Parent vault containing the key version
  vault() oci.kms.vault
  // Compartment containing the key version
  compartment() oci.compartment
  // Origin of the key material (INTERNAL, EXTERNAL)
  origin string
  // Lifecycle state
  //
  // For example: CREATING, ENABLING, ENABLED, DISABLING, DISABLED, DELETING, DELETED, PENDING_DELETION, SCHEDULING_DELETION, CANCELLING_DELETION.
  state string
  // Whether this version was created by auto-rotation
  isAutoRotated bool
  // Creation time
  created time
  // Scheduled deletion time
  timeOfDeletion time
}

// Oracle Cloud Infrastructure (OCI) Object Storage
//
// S3-compatible object storage for the tenancy. The `namespace` field
// holds the unique per-tenancy Object Storage namespace, and `buckets`
// enumerates every bucket. Each bucket surfaces its public access type,
// storage tier, auto-tiering and versioning configuration, KMS
// encryption key, retention rules for WORM/immutability, replication
// enablement, and the approximate object count and total size.
oci.objectStorage {
  // Object Storage namespace (unique per tenancy)
  namespace() string
  // Object Storage buckets
  buckets() []oci.objectStorage.bucket
}

// Oracle Cloud Infrastructure (OCI) Object Storage bucket
private oci.objectStorage.bucket {
  // Object Storage namespace
  namespace string
  // Bucket name
  name string
  // Compartment containing the bucket
  compartment() oci.compartment
  // Bucket creation time
  created time
  // Region where the bucket is located
  region oci.region
  // OCID of the principal that created the bucket
  createdBy() string
  // User that created the bucket, when the creating principal is an IAM user
  createdByUser() oci.identity.user
  // Public access type (NoPublicAccess, ObjectRead, ObjectReadWithoutList)
  publicAccessType() string
  // Storage tier (Standard or Archive)
  storageTier() string
  // Auto-tiering status (Disabled or InfrequentAccess)
  autoTiering() string
  // Object versioning status (Enabled, Suspended, Disabled)
  versioning() string
  // Whether object state change events are emitted
  objectEventsEnabled() bool
  // Whether the bucket is configured as a replication source
  replicationEnabled() bool
  // Bucket OCID
  //
  // Resolved from the bucket detail call, so it reports the same value whether
  // the bucket came from `oci.objectStorage.buckets` or from
  // `oci.objectStorage.bucket(namespace:, name:)`.
  ocid() string
  // Whether the bucket is read-only (true when configured as replication destination)
  isReadOnly() bool
  // Entity tag (ETag) for change detection
  etag() string
  // KMS key OCID for encryption
  //
  // Deprecated in favor of kmsKey, which resolves the same OCID to the key it
  // names.
  kmsKeyId() @maturity("deprecated") @replaced_by("oci.objectStorage.bucket.kmsKey") string
  // Customer-managed key that encrypts the bucket
  //
  // Null when the bucket is encrypted with an Oracle-managed key. Resolving
  // the key rather than reporting its OCID is what lets one query ask which
  // buckets sit on a key whose rotation is off.
  kmsKey() oci.kms.key
  // Whether the bucket derives a per-bucket data key from its KMS key
  //
  // A bucket key lets Object Storage encrypt objects under a key derived once
  // for the bucket rather than calling the vault per object. Without it every
  // object is wrapped directly by the KMS key.
  isBucketKeyEnabled() bool
  // Whether the bucket name is unique within its namespace or only within its compartment
  //
  // One of GLOBAL or COMPARTMENT. A compartment-scoped bucket name can be
  // reused in another compartment of the same namespace.
  bucketScope() string
  // User-defined metadata stored on the bucket
  //
  // Free-form keys set at creation. Object Storage returns them unchanged and
  // attaches no meaning to them.
  metadata() map[string]string
  // Approximate number of objects in the bucket
  approximateCount() int
  // Approximate total size of objects in bytes
  approximateSize() int
  // Object lifecycle policy ETag
  objectLifecyclePolicyEtag() string
  // Free-form tags for resource management
  freeformTags() map[string]string
  // Defined tags for governance and cost tracking
  definedTags() map[string]map[string]string
  // Retention rules for immutability/WORM compliance
  retentionRules() []oci.objectStorage.retentionRule
  // Pre-authenticated requests granting credential-free access to the bucket or its objects
  preauthenticatedRequests() []oci.objectStorage.preauthenticatedRequest
}

// Oracle Cloud Infrastructure (OCI) Object Storage pre-authenticated request
//
// Pre-authenticated request (PAR), a URL that grants access to the
// bucket or a specific object without any IAM credential or audit
// trail for the duration of its validity. `accessType` is one of
// `ObjectRead`, `ObjectWrite`, `ObjectReadWrite`, `AnyObjectRead`,
// `AnyObjectWrite`, or `AnyObjectReadWrite`; the `AnyObject*` forms apply to
// the whole bucket. `objectName` names the single object a PAR is scoped to,
// and is null for bucket-level PARs. `bucketListingAction` (`Deny` or
// `ListObjects`) decides whether the holder can enumerate bucket contents.
// `timeExpires` is when the URL stops working. A far-future value is an
// effectively permanent anonymous grant.
private oci.objectStorage.preauthenticatedRequest @defaults("name accessType timeExpires") {
  // Pre-authenticated request identifier
  id string
  // Display name
  name string
  // Operation the request grants (ObjectRead, ObjectWrite, ObjectReadWrite, AnyObjectRead, AnyObjectWrite, AnyObjectReadWrite)
  accessType string
  // Object the request is scoped to; null when the request grants access to the entire bucket
  objectName string
  // Whether the holder may list bucket contents (Deny or ListObjects)
  bucketListingAction string
  // Expiration time after which the request is no longer valid
  timeExpires time
  // Creation time
  created time
}

// Oracle Cloud Infrastructure (OCI) Object Storage retention rule
private oci.objectStorage.retentionRule @defaults("name") {
  // Retention rule OCID
  id string
  // Retention rule display name
  name string
  // Duration amount (in timeUnit units)
  durationAmount int
  // Duration time unit (DAYS, YEARS)
  durationTimeUnit string
  // Time after which the rule becomes locked and cannot be deleted
  timeRuleLocked time
  // Creation time
  created time
  // Last modification time
  timeModified time
}

// Oracle Cloud Infrastructure (OCI) File Storage
//
// Managed NFS file systems across the tenancy's availability domains,
// exposed through fileSystems, together with the machinery that decides
// who may mount them. `exports` carries the NFS export options that
// authorize clients by source CIDR, `mountTargets` carries the network
// placement and Kerberos or LDAP identity mapping each export is served
// through, and `exportSets` groups the exports served by one mount
// target. `replications`, `snapshotPolicies` and `outboundConnectors`
// cover cross-region copies, snapshot retention, and the LDAP servers
// mount targets bind to.
oci.fileStorage {
  // File systems
  fileSystems() []oci.fileStorage.fileSystem
  // Mount targets serving NFS exports
  mountTargets() []oci.fileStorage.mountTarget
  // Export sets grouping the exports on a mount target
  exportSets() []oci.fileStorage.exportSet
  // NFS exports and the client options authorizing them
  exports() []oci.fileStorage.export
  // Snapshot policies and their schedules
  snapshotPolicies() []oci.fileStorage.snapshotPolicy
  // Cross-region file system replications
  replications() []oci.fileStorage.replication
  // Outbound connectors mount targets bind to for LDAP identity mapping
  outboundConnectors() []oci.fileStorage.outboundConnector
}

// Oracle Cloud Infrastructure (OCI) file system
//
// A single managed NFS file system. Reports the availability domain
// it is anchored to, the KMS key encrypting its data at rest, metered
// byte consumption including snapshots, and clone lineage through
// parentFileSystem and isCloneParent, supporting encryption-coverage
// and storage-capacity audits.
private oci.fileStorage.fileSystem @defaults("name") {
  // File system OCID
  id string
  // File system display name
  name string
  // Compartment containing the file system
  compartment() oci.compartment
  // Availability domain where the file system is located
  availabilityDomain string
  // File system lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // KMS key for file system encryption
  kmsKey() oci.kms.key
  // Number of bytes consumed by the file system including snapshots
  meteredBytes int
  // File system this one was cloned from, when this is a clone
  parentFileSystem() oci.fileStorage.fileSystem
  // Whether this file system is the parent of at least one clone
  isCloneParent bool
  // NFS exports publishing this file system
  //
  // Each export publishes the file system at a path on one mount target and
  // carries the client options deciding which source addresses may mount it
  // and with what access. A file system with no exports is unreachable over
  // NFS whatever its mount targets allow.
  exports() []oci.fileStorage.export
  // Snapshots of this file system
  snapshots() []oci.fileStorage.snapshot
  // Snapshot policy scheduling this file system's snapshots
  snapshotPolicy() oci.fileStorage.snapshotPolicy
  // Storage quota rules applied to this file system
  //
  // Rules are reported for every principal scope the service supports:
  // whole-file-system, default user and group, and individual users and
  // groups.
  quotaRules() []oci.fileStorage.quotaRule
  // Quota enforcement state
  //
  // One of ENABLING, ENABLED, DISABLING, DISABLED, SYNCING, or FAILED. Only
  // ENABLED means the rules in `quotaRules` are being applied.
  quotaEnforcementState string
  // File system creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) mount target
//
// NFS endpoint a file system is served through. The mount target owns the
// network placement of the share: `subnet` and `securityGroups` decide which
// clients can reach it at all, and `privateIpIds` are the addresses it answers
// on. Identity mapping is set here too, through `idmapType` with the `ldap`
// fields, or through Kerberos with `kerberosEnabled` and `kerberosRealm`. The
// exports served through this target hang off `exportSet`.
private oci.fileStorage.mountTarget @defaults("name state availabilityDomain") {
  // Mount target OCID
  id string
  // Mount target display name
  name string
  // Compartment containing the mount target
  compartment() oci.compartment
  // Availability domain the mount target is in
  availabilityDomain string
  // Mount target lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Subnet the mount target's addresses are allocated from
  subnet() oci.network.subnet
  // Network security groups applied to the mount target
  //
  // The NSGs are the mount target's own packet filter, evaluated in addition
  // to the subnet's security lists. A mount target with no NSGs is
  // constrained only by its subnet.
  securityGroups() []oci.network.networkSecurityGroup
  // Export set holding the exports this mount target serves
  exportSet() oci.fileStorage.exportSet
  // OCIDs of the private IP addresses the mount target answers on
  privateIpIds []string
  // OCIDs of the IPv6 addresses the mount target answers on
  ipv6Ids []string
  // Identity mapping mode for UNIX credentials
  //
  // LDAP when the mount target maps incoming UIDs and GIDs through the
  // directory named by the `ldap` fields, NONE when it trusts the credentials
  // the client presents.
  idmapType() string
  // LDAP schema the identity mapping reads
  //
  // RFC2307 or RFC2307BIS.
  ldapSchemaType() string
  // Base distinguished name user lookups start from
  ldapUserSearchBase() string
  // Base distinguished name group lookups start from
  ldapGroupSearchBase() string
  // Seconds between refreshes of the identity mapping cache
  ldapCacheRefreshIntervalSeconds() int
  // Seconds a cached identity mapping stays valid
  ldapCacheLifetimeSeconds() int
  // Seconds a failed identity lookup is remembered
  ldapNegativeCacheLifetimeSeconds() int
  // Outbound connectors the identity mapping binds to
  ldapOutboundConnectors() []oci.fileStorage.outboundConnector
  // Whether Kerberos authentication is enabled on the mount target
  //
  // With Kerberos enabled the export options may demand KRB5, KRB5I or KRB5P
  // rather than AUTH_SYS, which is what moves the trust decision off the
  // client's self-asserted UID.
  kerberosEnabled() bool
  // Kerberos realm the mount target authenticates against
  kerberosRealm() string
  // Vault secret holding the mount target's Kerberos keytab
  kerberosKeyTabSecret() oci.vault.secret
  // Keytab secret version currently in use
  kerberosKeyTabSecretVersion() int
  // Keytab secret version kept as the fallback
  kerberosBackupKeyTabSecretVersion() int
  // Throughput requested for the mount target, in bytes per second
  requestedThroughput int
  // Throughput currently observed on the mount target, in bytes per second
  observedThroughput int
  // Storage capacity reserved for the mount target, in bytes
  reservedStorageCapacity int
  // Mount target creation time
  created time
  // Security attributes applied to the mount target, keyed by namespace
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits. Zero Trust Packet Routing authorizes traffic from
  // these rather than from the mount target's address.
  securityAttributes @maturity("deprecated") @replaced_by("oci.fileStorage.mountTarget.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) export set
//
// Group of NFS exports served through one mount target. The export set is
// bound to a VCN, so it also records which virtual network the file systems
// under it are published into. `maxFsStatBytes` and `maxFsStatFiles` are the
// capacity figures the exports report back to NFS clients.
private oci.fileStorage.exportSet @defaults("name state availabilityDomain") {
  // Export set OCID
  id string
  // Export set display name
  name string
  // Compartment containing the export set
  compartment() oci.compartment
  // Availability domain the export set is in
  availabilityDomain string
  // Export set lifecycle state (e.g., CREATING, ACTIVE, DELETING, DELETED)
  state string
  // Virtual cloud network the export set publishes into
  vcn() oci.network.vcn
  // Exports in this export set
  exports() []oci.fileStorage.export
  // Capacity reported to NFS clients, in bytes
  maxFsStatBytes() int
  // File count reported to NFS clients
  maxFsStatFiles() int
  // Export set creation time
  created time
}

// Oracle Cloud Infrastructure (OCI) NFS export
//
// Publication of one file system at a path on one mount target, and the point
// where NFS access is authorized. The `options` list is the access control:
// each entry admits a source CIDR with read-write or read-only access, decides
// whether root is squashed, and names the authentication flavors accepted. An
// export whose options admit `0.0.0.0/0` with `identitySquash` set to NONE is
// an open share with root access.
private oci.fileStorage.export @defaults("path state") {
  // Export OCID
  id string
  // Path the file system is exported at
  path string
  // Export lifecycle state (e.g., CREATING, ACTIVE, DELETING, DELETED)
  state string
  // File system published by this export
  fileSystem() oci.fileStorage.fileSystem
  // Export set this export belongs to
  exportSet() oci.fileStorage.exportSet
  // Client options authorizing access to the export
  options() []oci.fileStorage.export.option
  // Whether supplementary groups are looked up through identity mapping for AUTH_SYS clients
  //
  // With this off, an AUTH_SYS client's own list of supplementary groups is
  // trusted as sent, so a client can claim membership of any group.
  isIdmapGroupsForSysAuth bool
  // Export creation time
  created time
}

// Client options on an NFS export
//
// One access rule on an export: which client addresses it covers and what they
// are allowed to do. `source` is the CIDR or address the rule applies to,
// `access` is READ_WRITE or READ_ONLY, and `identitySquash` decides whether
// incoming root or all users are remapped to the anonymous UID and GID.
// `allowedAuth` names the authentication flavors accepted, which is where a
// Kerberos requirement is expressed.
private oci.fileStorage.export.option @defaults("source access identitySquash") {
  // Source address or CIDR block the rule applies to
  source string
  // Access granted to matching clients
  //
  // READ_WRITE or READ_ONLY.
  access string
  // Which incoming identities are remapped to the anonymous UID and GID
  //
  // NONE leaves client credentials as sent, ROOT remaps only UID 0, and ALL
  // remaps every user. NONE on a wide source is what lets a client mount the
  // share as root.
  identitySquash string
  // Whether clients must connect from a privileged source port below 1024
  requirePrivilegedSourcePort bool
  // UID that squashed identities are remapped to
  anonymousUid int
  // GID that squashed identities are remapped to
  anonymousGid int
  // Whether unauthenticated access is allowed
  isAnonymousAccessAllowed bool
  // Authentication flavors accepted from matching clients
  //
  // Any of SYS, KRB5, KRB5I, or KRB5P. SYS is unauthenticated in the sense
  // that the client asserts its own UID and GID.
  allowedAuth []string
}

// Oracle Cloud Infrastructure (OCI) file system snapshot
//
// Point-in-time copy of a file system. `snapshotType` separates snapshots a
// user took from ones a snapshot policy or a replication created, and
// `expirationTime` is when a policy-created snapshot is due to be removed.
private oci.fileStorage.snapshot @defaults("name snapshotType state") {
  // Snapshot OCID
  id string
  // Snapshot name
  name string
  // Snapshot lifecycle state (e.g., CREATING, ACTIVE, DELETING, DELETED)
  state string
  // File system this snapshot was taken from
  fileSystem() oci.fileStorage.fileSystem
  // How the snapshot was created
  //
  // USER for a manually taken snapshot, POLICY_BASED for one a snapshot
  // policy scheduled, and REPLICATION for one taken to support replication.
  snapshotType string
  // Time the snapshot represents
  snapshotTime time
  // Time the snapshot is due to be removed
  expirationTime time
  // Whether a file system has been cloned from this snapshot
  isCloneSource bool
  // Bytes held only by this snapshot and no other
  exclusiveBytes int
  // Snapshot creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) file system snapshot policy
//
// Schedule governing when snapshots of the file systems attached to it are
// taken and how long they are kept. The `schedules` carry the period and the
// retention duration, so this is where a retention requirement is proved or
// disproved. A policy in the INACTIVE state takes no snapshots at all while
// still being attached.
private oci.fileStorage.snapshotPolicy @defaults("name state availabilityDomain") {
  // Snapshot policy OCID
  id string
  // Snapshot policy display name
  name string
  // Compartment containing the snapshot policy
  compartment() oci.compartment
  // Availability domain the snapshot policy is in
  availabilityDomain string
  // Snapshot policy lifecycle state (e.g., CREATING, ACTIVE, DELETING, DELETED, INACTIVE, FAILED)
  state string
  // Prefix prepended to the names of snapshots this policy takes
  policyPrefix string
  // Schedules on which snapshots are taken
  schedules() []oci.fileStorage.snapshotPolicy.schedule
  // Snapshot policy creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Schedule on a file system snapshot policy
//
// One recurrence in a snapshot policy: how often a snapshot is taken and how
// long it is kept. `retentionDurationInSeconds` is the retention control, and
// it is absent when snapshots taken on this schedule are kept indefinitely.
private oci.fileStorage.snapshotPolicy.schedule @defaults("period retentionDurationInSeconds") {
  // How often the schedule runs
  //
  // One of HOURLY, DAILY, WEEKLY, MONTHLY, or YEARLY.
  period string
  // Time zone the schedule's clock fields are interpreted in
  //
  // UTC or REGIONAL_DATA_CENTER_TIME.
  timeZone string
  // Prefix prepended to the names of snapshots this schedule takes
  schedulePrefix string
  // Time the schedule starts taking snapshots
  timeScheduleStart time
  // Seconds a snapshot taken on this schedule is kept
  //
  // Null when snapshots on this schedule are kept indefinitely.
  retentionDurationInSeconds int
  // Hour of the day the schedule runs
  hourOfDay int
  // Day of the week the schedule runs
  //
  // One of MONDAY through SUNDAY.
  dayOfWeek string
  // Day of the month the schedule runs
  dayOfMonth int
  // Month the schedule runs
  //
  // One of JANUARY through DECEMBER.
  month string
}

// Oracle Cloud Infrastructure (OCI) file system replication
//
// Scheduled copy of a file system to a target file system, usually in another
// region. Replication moves the data out of the source region on the interval
// in `replicationInterval`, so this is the resource that answers where a file
// system's contents are allowed to land. `recoveryPointTime` is how current
// the target copy is.
private oci.fileStorage.replication @defaults("name state replicationInterval") {
  // Replication OCID
  id string
  // Replication display name
  name string
  // Compartment containing the replication
  compartment() oci.compartment
  // Availability domain the replication is in
  availabilityDomain string
  // Replication lifecycle state (e.g., CREATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // File system being copied
  sourceFileSystem() oci.fileStorage.fileSystem
  // File system being copied to
  //
  // Null when the target is in a region this scan does not cover, which is
  // the common case for a cross-region replication.
  targetFileSystem() oci.fileStorage.fileSystem
  // Seconds between replication cycles
  replicationInterval int
  // Time the target copy is current as of
  recoveryPointTime time
  // Progress of the current replication cycle
  //
  // One of IDLE, CAPTURING, APPLYING, TRANSFERRING, SERVICE_ERROR,
  // USER_ERROR, or FAILED.
  deltaStatus() string
  // Detail behind the current lifecycle state
  lifecycleDetails string
  // Replication creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) outbound connector
//
// Directory server a mount target binds to when it maps UNIX identities
// through LDAP. The connector is credential-bearing: `bindDistinguishedName`
// is the account it binds as, `passwordSecret` holds that account's password,
// and `trustedCertificateSecret` holds the certificate the LDAP connection is
// validated against. `endpoints` are the hosts and ports it connects to.
private oci.fileStorage.outboundConnector @defaults("name connectorType state") {
  // Outbound connector OCID
  id string
  // Outbound connector display name
  name string
  // Compartment containing the outbound connector
  compartment() oci.compartment
  // Availability domain the outbound connector is in
  availabilityDomain string
  // Outbound connector lifecycle state (e.g., CREATING, ACTIVE, DELETING, DELETED)
  state string
  // Kind of directory the connector reaches
  //
  // LDAPBIND is the only kind the service offers today.
  connectorType string
  // Distinguished name the connector binds to the directory as
  bindDistinguishedName string
  // Directory hosts and ports the connector reaches, each with `hostname` and `port`
  endpoints []dict
  // Vault secret holding the bind account's password
  passwordSecret() oci.vault.secret
  // Vault secret version holding the bind account's password
  passwordSecretVersion() int
  // Vault secret holding the certificate the LDAP connection is validated against
  //
  // Null when the connector does not validate the directory's certificate.
  trustedCertificateSecret() oci.vault.secret
  // Vault secret version holding the trusted certificate
  trustedCertificateSecretVersion() int
  // Outbound connector creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) file system quota rule
//
// Storage limit applied to a file system as a whole or to one user or group
// within it. `isHardQuota` separates a limit that blocks writes from one that
// only reports, and `usageInBytes` against `quotaLimitInGigabytes` is how far
// the principal is from that limit.
private oci.fileStorage.quotaRule @defaults("name principalType quotaLimitInGigabytes") {
  // Quota rule OCID
  id string
  // Quota rule display name
  name string
  // File system the quota rule applies to
  fileSystem() oci.fileStorage.fileSystem
  // Scope the quota rule applies to
  //
  // One of FILE_SYSTEM_LEVEL, DEFAULT_USER, DEFAULT_GROUP, INDIVIDUAL_USER,
  // or INDIVIDUAL_GROUP.
  principalType string
  // UID or GID the rule applies to, for the individual scopes
  principalId int
  // Whether exceeding the limit blocks writes rather than only being reported
  isHardQuota bool
  // Storage limit in gigabytes
  quotaLimitInGigabytes int
  // Storage currently consumed under this rule, in bytes
  usageInBytes int
  // Quota rule creation time
  created time
  // Last modification time
  timeUpdated time
}

// Oracle Cloud Infrastructure (OCI) Events
//
// Event-rule-based automation configured in the tenancy. Each rule in
// `rules` surfaces the matching `condition` (a JSON event filter), the
// `actions` to perform (function, notification topic, or stream
// targets), the rule's enabled state, and its lifecycle state. Audit
// these to see which events trigger automated responses and where
// those responses are routed.
oci.events {
  // Event rules
  rules() []oci.events.rule
}

// Oracle Cloud Infrastructure (OCI) event rule
//
// A single Events service rule, evaluated against emitted events. The
// `condition` holds the JSON filter that selects matching events,
// `actions` lists the automated responses to invoke, and `isEnabled`
// with `state` report whether the rule is active. Audit these to
// confirm which events trigger automation and that no rule routes
// events to unexpected functions, topics, or streams.
private oci.events.rule @defaults("name") {
  // Rule OCID
  id string
  // Rule display name
  name string
  // Rule description
  description string
  // Compartment containing the rule
  compartment() oci.compartment
  // Event matching condition (JSON)
  condition string
  // Whether the rule is enabled
  isEnabled bool
  // Rule lifecycle state (e.g., CREATING, ACTIVE, INACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Actions to perform when the rule matches an event
  //
  // Each entry has `id`, `isEnabled`, `state` (the action's lifecycle
  // state), a `description`, and `actionType` set to ONS (notification
  // topic), OSS (stream), or FAAS (function). Depending on that type,
  // the target OCID is in `topicId`, `streamId`, or `functionId`.
  actions() []dict
  // Rule creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard
//
// Tenancy-wide threat-detection and security-monitoring posture. The
// `status` and `reportingRegion` fields report whether Cloud Guard is
// enabled and which region collects findings, and `selfManageResources`
// reports whether Cloud Guard's resources are customer-managed. The
// `targets` field lists the compartments and resources Cloud Guard
// monitors, `detectorRecipes` the curated detector rule sets,
// `securityZones` and `securityZoneRecipes` the security-zone
// enforcement scopes, and `securityPolicies` the individual policies
// that compose those recipes. `problems` carries the findings Cloud
// Guard has actually raised, each with its risk level, affected
// resource, and triage state, and `sightings` the activity Cloud Guard
// observed and correlated rather than the configuration it inspected.
// `responderRecipes` covers the remediation side: which responders
// exist, whether each is enabled, and whether it acts on its own or
// waits for an operator.
oci.cloudGuard {
  // Whether Cloud Guard is enabled
  status() bool
  // Region where Cloud Guard reports findings
  reportingRegion() string
  // Whether Cloud Guard resources are self-managed
  selfManageResources() bool
  // Cloud Guard targets (monitored compartments/resources)
  targets() []oci.cloudGuard.target
  // Problems (security findings) Cloud Guard has raised across the tenancy
  problems() []oci.cloudGuard.problem
  // Cloud Guard detector recipes
  detectorRecipes() []oci.cloudGuard.detectorRecipe
  // Cloud Guard security zones
  securityZones() []oci.cloudGuard.securityZone
  // Cloud Guard security zone recipes
  securityZoneRecipes() []oci.cloudGuard.securityZoneRecipe
  // Cloud Guard security policies (used in security zone recipes)
  securityPolicies() []oci.cloudGuard.securityPolicy
  // Responder recipes and the remediation rules they carry
  responderRecipes() []oci.cloudGuard.responderRecipe
  // Sightings, the correlated activity Cloud Guard has observed across the tenancy
  sightings() []oci.cloudGuard.sighting
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard target
private oci.cloudGuard.target @defaults("name") {
  // Target OCID
  id string
  // Target display name
  name string
  // Compartment containing the target
  compartment() oci.compartment
  // OCID of the resource being monitored
  targetResourceId string
  // Type of resource being monitored (e.g., COMPARTMENT, ERPCLOUD, HCMCLOUD, SECURITY_ZONE)
  targetResourceType string
  // Target lifecycle state (e.g., CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Number of detector recipes attached to the target
  recipeCount int
  // Target creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard detector recipe
private oci.cloudGuard.detectorRecipe @defaults("name") {
  // Detector recipe OCID
  id string
  // Detector recipe display name
  name string
  // Detector recipe description
  description string
  // Compartment containing the detector recipe
  compartment() oci.compartment
  // Owner of the detector recipe (CUSTOMER or ORACLE)
  owner string
  // Type of detector
  //
  // For example: IAAS_ACTIVITY_DETECTOR, IAAS_CONFIGURATION_DETECTOR, IAAS_THREAT_DETECTOR, IAAS_LOG_INSIGHT_DETECTOR, IAAS_INSTANCE_SECURITY_DETECTOR, IAAS_CONTAINER_SECURITY_DETECTOR.
  detectorType string
  // Detector recipe lifecycle state (e.g., CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Detector recipe creation time
  created time
  // Detector rules in the recipe, each with its enabled state and risk level
  rules() []oci.cloudGuard.detectorRule
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard detector rule
//
// Single detection rule inside a detector recipe, and the switch that
// decides whether Cloud Guard looks for that condition at all. `isEnabled`
// reports whether the rule is active in the recipe and `riskLevel` the
// severity it assigns to matches, so a rule that is present but disabled,
// or downgraded to a lower risk level, is visible rather than silently
// absent from findings. `configurations` carries the rule's tunable
// parameters, `labels` its classification tags, and `problemThreshold` the
// count that must be reached before a problem is raised. `recommendation`
// is the remediation guidance Cloud Guard shows for matches.
private oci.cloudGuard.detectorRule @defaults("name isEnabled riskLevel") {
  // Detector rule identifier
  id string
  // Detector this rule belongs to
  //
  // For example: IAAS_ACTIVITY_DETECTOR, IAAS_CONFIGURATION_DETECTOR,
  // IAAS_THREAT_DETECTOR, IAAS_LOG_INSIGHT_DETECTOR,
  // IAAS_INSTANCE_SECURITY_DETECTOR, or IAAS_CONTAINER_SECURITY_DETECTOR.
  detector string
  // Detector rule display name
  name string
  // Detector rule description
  description string
  // Remediation guidance shown for problems this rule raises
  recommendation string
  // OCI service the rule inspects
  serviceType string
  // Resource type the rule inspects
  resourceType string
  // Whether the rule is enabled in the recipe
  isEnabled bool
  // Risk level assigned to problems this rule raises (CRITICAL, HIGH, MEDIUM, LOW, MINOR)
  riskLevel string
  // Number of matches required before a problem is raised
  problemThreshold int
  // Classification labels attached to the rule
  labels []string
  // Tunable parameters for the rule
  //
  // Deprecated in favor of settings, which returns the same entries as
  // resources. Each entry has `configKey`, `name`, `value`, `dataType`, and
  // for multi-valued settings a `values` list whose entries carry `name`,
  // `value`, and `listType`.
  configurations @maturity("deprecated") @replaced_by("oci.cloudGuard.detectorRule.settings") []dict
  // Tunable parameters for the rule
  //
  // One row per setting the rule exposes, keyed by `configKey`. A rule is only
  // as strict as its settings, so a threshold or an allow-list left at the
  // default is what decides whether the rule fires on a real finding.
  settings []oci.cloudGuard.detectorRule.configuration
  // Whether the rule's configuration may be changed
  isConfigurationAllowed bool
  // Whether the rule can be cloned into a customer-managed recipe
  isCloneable bool
  // Managed list types the rule accepts (e.g., CIDR_BLOCK, USERS, GROUPS, RESOURCE_OCID)
  managedListTypes []string
  // Detector rule lifecycle state (e.g., CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Detector rule creation time
  created time
  // Detector rule last-update time
  updated time
}

// Tunable parameter on a Cloud Guard detector rule
//
// A single setting the detector rule exposes, keyed by `configKey`. `value`
// carries the setting as configured, and `values` the entries when the setting
// is multi-valued. `allowedValues` lists what the setting accepts, which is
// what separates a setting left at its default from one that was narrowed.
private oci.cloudGuard.detectorRule.configuration @defaults("configKey name value") {
  // Unique identifier of the setting within the rule
  configKey string
  // Setting name
  name string
  // Setting value
  //
  // Empty on a multi-valued setting, where `values` carries the entries.
  value string
  // Data type of the setting value
  dataType string
  // Entries of a multi-valued setting
  //
  // Each entry carries `name`, `value`, and `listType`. Empty on a
  // single-valued setting.
  values []dict
  // Data type of the entries in `allowedValues`
  allowedValuesDataType string
  // Values the setting accepts
  //
  // Each entry carries `key` and `value`. Empty when the setting accepts any
  // value of its data type.
  allowedValues []dict
  // Additional property definitions for the setting
  //
  // Each entry carries `name`, `type`, and the `value` it defaults to.
  additionalProperties []dict
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard problem
//
// Security finding Cloud Guard has raised against a monitored resource.
// `riskLevel` and `riskScore` grade the finding, `resourceId`,
// `resourceName`, and `resourceType` identify what it was raised against,
// and `detectorRuleId` names the rule that fired. `lifecycleDetail` is the
// triage state (OPEN, RESOLVED, DISMISSED, or DELETED), which distinguishes
// a finding still awaiting action from one an operator has already closed
// or waived. `firstDetected` and `lastDetected` bound how long the
// condition has persisted, and `labels` carries the rule's classification
// tags. Problems are reported from the Cloud Guard reporting region and
// cover every compartment in the tenancy subtree.
private oci.cloudGuard.problem @defaults("resourceName riskLevel lifecycleDetail") {
  // Problem OCID
  id string
  // Compartment containing the resource the problem was raised against
  compartment() oci.compartment
  // Risk level assigned to the problem (CRITICAL, HIGH, MEDIUM, LOW, MINOR)
  riskLevel string
  // Numeric risk score for the problem
  riskScore float
  // Identifier of the detector rule that raised the problem
  detectorRuleId string
  // Detector that raised the problem
  //
  // For example: IAAS_ACTIVITY_DETECTOR, IAAS_CONFIGURATION_DETECTOR,
  // IAAS_THREAT_DETECTOR, IAAS_LOG_INSIGHT_DETECTOR,
  // IAAS_INSTANCE_SECURITY_DETECTOR, or IAAS_CONTAINER_SECURITY_DETECTOR.
  detector string
  // OCID of the resource the problem was raised against
  resourceId string
  // Name of the resource the problem was raised against
  resourceName string
  // Type of the resource the problem was raised against
  resourceType string
  // Cloud Guard target that reported the problem
  target() oci.cloudGuard.target
  // Classification labels attached to the problem
  labels []string
  // Problem record lifecycle state (ACTIVE, INACTIVE)
  state string
  // Triage state of the problem (OPEN, RESOLVED, DISMISSED, DELETED)
  lifecycleDetail string
  // Region the problem was detected in
  region string
  // Every region the problem applies to, for problems spanning more than one
  regions []string
  // When the problem was first detected
  firstDetected time
  // When the problem was most recently detected
  lastDetected time
  // Responder runs recorded against the problem, with the outcome of each
  responderActivities() []oci.cloudGuard.responderActivity
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard security zone
private oci.cloudGuard.securityZone @defaults("name") {
  // Security zone OCID
  id string
  // Security zone display name
  name string
  // Security zone description
  description string
  // Compartment containing the security zone
  compartment() oci.compartment
  // Security zone recipe applied to the zone
  securityZoneRecipe() oci.cloudGuard.securityZoneRecipe
  // Whether the compartment inherits a parent security zone after the zone is deleted
  isInheritanceAfterDeleteEnabled bool
  // Security zone lifecycle state (e.g., CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Security zone creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard security zone recipe
private oci.cloudGuard.securityZoneRecipe @defaults("name") {
  // Security zone recipe OCID
  id string
  // Security zone recipe display name
  name string
  // Security zone recipe description
  description string
  // Compartment containing the security zone recipe
  compartment() oci.compartment
  // Owner of the recipe (CUSTOMER or ORACLE)
  owner string
  // Security policies included in the recipe
  securityPolicies() []oci.cloudGuard.securityPolicy
  // Recipe lifecycle state (e.g., CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Recipe creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard security policy (a requirement enforced inside a security zone)
private oci.cloudGuard.securityPolicy @defaults("name category") {
  // Security policy OCID
  id string
  // Security policy display name
  name string
  // Shorter version of the policy name
  friendlyName string
  // Security policy description
  description string
  // Compartment containing the security policy
  compartment() oci.compartment
  // Owner of the policy (CUSTOMER or ORACLE)
  owner string
  // Policy category (e.g., the resource type or feature the policy applies to)
  category string
  // OCI services protected by the policy
  services []string
  // Policy lifecycle state (e.g., CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Policy creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard responder recipe
//
// Set of remediation rules Cloud Guard can run against a problem, and the
// only place the remediation half of the service is configured. `owner`
// separates an Oracle-supplied recipe from a customer-cloned one, `rules`
// carries the individual responders, and `sourceRecipe` names the recipe a
// clone was derived from. A tenancy with detector recipes and no responder
// recipe raises problems it never acts on, so the presence of a recipe and
// the execution mode of the rules inside it are what separate detection
// from remediation.
private oci.cloudGuard.responderRecipe @defaults("name owner state") {
  // Responder recipe OCID
  id string
  // Responder recipe display name
  name string
  // Responder recipe description
  description string
  // Compartment containing the responder recipe
  compartment() oci.compartment
  // Owner of the responder recipe (CUSTOMER or ORACLE)
  owner string
  // Recipe this one was cloned from, for a customer-owned clone of an Oracle recipe
  sourceRecipe() oci.cloudGuard.responderRecipe
  // Responder rules in the recipe, each with its execution mode and enabled state
  rules() []oci.cloudGuard.responderRule
  // Responder recipe lifecycle state (CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Details of the current lifecycle state, populated when the recipe is in FAILED
  lifecycleDetails string
  // Responder recipe creation time
  created time
  // Responder recipe last-update time
  updated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard responder rule
//
// Single remediation action inside a responder recipe, and the switch that
// decides whether Cloud Guard ever performs it. `isEnabled` reports whether
// the rule is active in the recipe and `mode` whether it acts on its own
// (AUTOACTION) or waits for an operator to confirm (USERACTION), which are
// very different controls: a recipe of user-action rules remediates nothing
// until somebody acts. `type` separates a rule that changes the resource
// (REMEDIATION) from one that only raises an alert (NOTIFICATION),
// `condition` narrows which problems the rule applies to, `policies` lists
// the IAM policies the rule needs in order to run, and `settings` carries
// its tunable parameters.
private oci.cloudGuard.responderRule @defaults("name isEnabled mode type") {
  // Responder rule identifier
  id string
  // Responder rule display name
  name string
  // Responder rule description
  description string
  // Whether the rule is enabled in the recipe
  isEnabled bool
  // Execution mode of the rule (AUTOACTION, USERACTION)
  //
  // AUTOACTION runs the rule as soon as a matching problem is raised.
  // USERACTION leaves the run waiting for an operator to trigger it, so the
  // problem stays unremediated until somebody acts. Empty when the recipe
  // reports no execution detail for the rule.
  mode string
  // Execution modes the rule supports (AUTOACTION, USERACTION)
  supportedModes []string
  // Kind of action the rule performs (REMEDIATION, NOTIFICATION)
  type string
  // IAM policy statements the rule requires in order to run
  policies []string
  // Condition narrowing which problems the rule applies to
  //
  // Either a simple condition with `kind`, `parameter`, `value`, and
  // `valueType`, or a composite with `kind`, `leftOperand`, `rightOperand`,
  // and `compositeOperator` joining two nested conditions. Empty when the
  // rule applies to every problem the responder covers.
  condition dict
  // Tunable parameters for the rule, keyed by `configKey`
  settings []oci.cloudGuard.responderRule.configuration
  // Responder rule lifecycle state (CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Details of the current lifecycle state, populated when the rule is in FAILED
  lifecycleDetails string
  // Responder rule creation time
  created time
  // Responder rule last-update time
  updated time
}

// Tunable parameter on a Cloud Guard responder rule
//
// A single setting the responder rule exposes, keyed by `configKey`, with
// `value` carrying it as configured. A responder is only as useful as its
// settings: the notification topic a NOTIFICATION rule publishes to lives
// here, and a rule pointing at nothing notifies nobody.
private oci.cloudGuard.responderRule.configuration @defaults("configKey name value") {
  // Unique identifier of the setting within the rule
  configKey string
  // Setting name
  name string
  // Setting value
  value string
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard responder activity
//
// Record of a responder rule running against one problem, and the evidence
// that remediation actually happened rather than merely being configured.
// `executionStatus` reports the outcome, where AWAITING_CONFIRMATION means
// a user-action responder is still waiting on an operator and SKIPPED means
// the run was declined, `activityType` separates the start of a run from
// its completion, and `message` carries the detail the service recorded.
private oci.cloudGuard.responderActivity @defaults("responderRuleName executionStatus activityType") {
  // Responder activity identifier
  id string
  // Identifier of the responder rule that ran
  responderRuleId string
  // Display name of the responder rule that ran
  responderRuleName string
  // Kind of action the rule performs (REMEDIATION, NOTIFICATION)
  responderType string
  // Stage of the run this record describes (STARTED, COMPLETED)
  activityType string
  // Outcome of the run (STARTED, AWAITING_CONFIRMATION, AWAITING_INPUT, SUCCEEDED, FAILED, SKIPPED, ALL)
  executionStatus string
  // Message the service recorded for the run
  message string
  // Time the activity was recorded
  created time
}

// Oracle Cloud Infrastructure (OCI) Cloud Guard sighting
//
// Activity Cloud Guard has correlated into a single suspected intrusion,
// which is the observed-behavior side of the service rather than the
// configuration side its problems report. `severity` grades the activity
// and `confidence` reports how sure Cloud Guard is that it is not a false
// positive, while `classificationStatus` records the verdict an operator
// reached, so a sighting nobody has triaged is distinguishable from one
// already dismissed. `tacticName` and `techniqueName` place the activity in
// the MITRE ATT&CK framework, `actorPrincipalName` names the principal that
// performed it, `impactedResources` lists what it touched, and `endpoints`
// the source addresses it came from with their country and network owner.
private oci.cloudGuard.sighting @defaults("sightingTypeDisplayName severity confidence") {
  // Sighting OCID
  id string
  // Compartment containing the impacted resource
  compartment() oci.compartment
  // Problem raised from the sighting
  problem() oci.cloudGuard.problem
  // Identifier of the detector rule that was triggered
  detectorRuleId string
  // Verdict an operator reached (NOT_CLASSIFIED, TRUE_POSITIVE, FALSE_POSITIVE, TRUE_NEGATIVE, FALSE_NEGATIVE)
  classificationStatus string
  // Identifier of the kind of activity observed
  sightingType string
  // Display name of the kind of activity observed
  sightingTypeDisplayName string
  // MITRE ATT&CK tactic the activity belongs to
  tacticName string
  // MITRE ATT&CK technique the activity matches
  techniqueName string
  // Score Cloud Guard assigned to the sighting
  sightingScore int
  // Severity of the sighting (CRITICAL, HIGH, MEDIUM, LOW, MINOR)
  severity string
  // Confidence that the sighting is not a false positive (CRITICAL, HIGH, MEDIUM, LOW, MINOR)
  confidence string
  // OCID of the principal that performed the activity
  actorPrincipalId string
  // Name of the principal that performed the activity
  actorPrincipalName string
  // Kind of principal that performed the activity, which says how to read actorPrincipalId
  actorPrincipalType string
  // Regions the activity spanned
  regions []string
  // Resources the activity touched
  impactedResources() []oci.cloudGuard.sighting.impactedResource
  // Source addresses the activity came from
  endpoints() []oci.cloudGuard.sighting.endpoint
  // When the activity was first detected
  firstDetected time
  // When the activity was most recently detected
  lastDetected time
  // When the activity was first performed
  firstOccurred time
  // When the activity was most recently performed
  lastOccurred time
}

// Resource touched by a Cloud Guard sighting
//
// One resource the observed activity reached, which is what turns a
// sighting into a blast radius. `resourceId`, `resourceName`, and
// `resourceType` identify it, `region` and `compartment` place it, and
// `identified` records when Cloud Guard tied it to the sighting.
private oci.cloudGuard.sighting.impactedResource @defaults("resourceName resourceType region") {
  // Impacted resource record identifier
  id string
  // OCID of the resource the activity reached
  resourceId string
  // Name of the resource the activity reached
  resourceName string
  // Type of the resource the activity reached
  resourceType string
  // Region the resource is in
  region string
  // Compartment containing the resource
  compartment() oci.compartment
  // When the resource was tied to the sighting
  identified time
  // When the activity against this resource was first detected
  firstDetected time
  // When the activity against this resource was most recently detected
  lastDetected time
  // When the activity against this resource was first performed
  firstOccurred time
  // When the activity against this resource was most recently performed
  lastOccurred time
}

// Source address of a Cloud Guard sighting
//
// One IP address the observed activity came from, with the geography and
// network ownership Cloud Guard resolved for it. `ipClassificationType`
// records how the address is judged, `country` and `asnNumber` attribute
// it, and `services` names the OCI services it reached, so an external
// address touching an administrative service is visible without
// correlating logs by hand.
private oci.cloudGuard.sighting.endpoint @defaults("ipAddress country ipClassificationType") {
  // Sighting endpoint record identifier
  id string
  // IP address the activity came from
  ipAddress string
  // Whether the address is inside or outside the tenancy
  ipAddressType string
  // How Cloud Guard classifies the address, for example whether it is known to be malicious
  ipClassificationType string
  // Country the address resolves to
  country string
  // Latitude the address resolves to
  latitude float
  // Longitude the address resolves to
  longitude float
  // Autonomous system number owning the address
  asnNumber string
  // Regions the activity from this address reached
  regions []string
  // OCI services the activity from this address reached
  services []string
  // When activity from this address was first detected
  firstDetected time
  // When activity from this address was most recently detected
  lastDetected time
  // When activity from this address was first performed
  firstOccurred time
  // When activity from this address was most recently performed
  lastOccurred time
}

// Oracle Cloud Infrastructure (OCI) Notifications
//
// OCI Notifications (ONS) pub/sub messaging service used for
// broadcasting alerts and delivering events to subscribers. The
// `topics` collection enumerates every notification topic, and
// each topic exposes its lifecycle state and the `subscriptions`
// bound to it (Email, HTTPS, Slack, PagerDuty, function, and other
// delivery protocols). Auditing topics and their subscriptions
// reveals where operational and security alerts are routed.
oci.ons {
  // Notification topics
  topics() []oci.ons.topic
}

// Oracle Cloud Infrastructure (OCI) notification topic
private oci.ons.topic @defaults("name") {
  // Topic OCID
  id string
  // Topic name
  name string
  // Topic description
  description string
  // Compartment containing the topic
  compartment() oci.compartment
  // Topic lifecycle state (e.g., ACTIVE, DELETING, CREATING)
  state string
  // Topic creation time
  created time
  // Topic subscriptions
  subscriptions() []oci.ons.subscription
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) notification subscription
private oci.ons.subscription @defaults("id") {
  // Subscription OCID
  id string
  // Topic the subscription belongs to
  topic() oci.ons.topic
  // Delivery protocol (EMAIL, HTTPS, SLACK, etc.)
  protocol string
  // Delivery endpoint
  endpoint string
  // Subscription lifecycle state (e.g., PENDING, ACTIVE, DELETED)
  state string
  // Subscription creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Audit
//
// Tenancy-wide audit log configuration and the recorded events
// themselves. The `retentionPeriodDays` field reports how many days
// audit events are retained before being purged, letting you verify
// that the retention window meets your compliance requirements.
// `events` returns the control-plane API calls recorded across the
// tenancy in the last 24 hours, each carrying the calling principal,
// source IP, and outcome.
oci.audit {
  // Audit log retention period in days
  retentionPeriodDays() int
  // Audit events recorded across the tenancy in the last 24 hours
  //
  // Every control-plane API call OCI recorded, across every compartment
  // and every subscribed region. The window is fixed at the last 24
  // hours: the Audit API requires an explicit time range, and an
  // unbounded one would pull the full retention period on every query.
  events() []oci.audit.event
}

// Oracle Cloud Infrastructure (OCI) audit event
//
// Single control-plane API call recorded by the Audit service.
// `eventName` is the operation invoked (for example
// `CreateUser`, `DeletePolicy`, or `Login`) and `eventTime` when it
// happened. The calling principal is described by `principalName`,
// `principalId`, and `authType` (`natv` for a native OCI user,
// `federated` for one signing in through an identity provider, or
// `instance` for an instance principal), with `ipAddress` and
// `userAgent` recording where the call came from and
// `consoleSessionId` linking console actions to a session.
// `responseStatus` is the HTTP status the call returned, which
// separates a successful change from a rejected attempt, and
// `resourceName` and `resourceId` identify what was acted on. Together
// these support detection-style checks such as finding privilege
// changes, console logins from unexpected addresses, or repeated
// authorization failures.
private oci.audit.event @defaults("eventName principalName eventTime responseStatus") {
  // Audit event OCID
  id string
  // Operation that was invoked (e.g., CreateUser, DeletePolicy, Login)
  eventName string
  // Type of the event, in reverse-DNS form (e.g., com.oraclecloud.identityControlPlane.CreateUser)
  eventType string
  // When the event occurred
  eventTime time
  // Service that emitted the event (e.g., identityControlPlane)
  source string
  // Identifier grouping the request and response halves of one operation
  eventGroupingId string
  // Compartment the event was recorded in
  compartment() oci.compartment
  // Name of the compartment the event was recorded in
  compartmentName string
  // Name of the resource the operation acted on
  resourceName string
  // OCID of the resource the operation acted on
  resourceId string
  // Availability domain the event originated from
  availabilityDomain string
  // Display name of the principal that made the call
  principalName string
  // OCID of the principal that made the call
  //
  // Kept alongside `principal` because the two do not always agree: an
  // instance principal, a service principal, or a user deleted since the
  // call was recorded all leave an OCID here that resolves to no user.
  principalId string
  // IAM user that made the call
  //
  // Null when the caller was not a user, which is the case for instance
  // and service principals, or when the user has since been deleted.
  // `principalId` records the raw OCID either way.
  principal() oci.identity.user
  // How the caller authenticated (e.g., natv, federated, instance)
  authType string
  // Name of the user on whose behalf a delegated call was made
  callerName string
  // OCID of the user on whose behalf a delegated call was made
  callerId string
  // IAM user on whose behalf a delegated call was made
  //
  // Set for calls a service made on a user's behalf, and null for direct
  // calls or when the user has since been deleted.
  caller() oci.identity.user
  // Source IP address the call originated from
  ipAddress string
  // User agent string of the calling client
  userAgent string
  // Console session the call belongs to, for actions taken in the web console
  consoleSessionId string
  // HTTP method of the request (e.g., GET, POST, DELETE)
  requestAction string
  // Full path of the API request
  //
  // For example `/20160918/instances/ocid1.instance.oc1.phx.<unique_ID>`.
  requestPath string
  // Request identifier assigned by the service
  requestId string
  // Query and body parameters supplied with the request
  //
  // Keyed by parameter name, each mapping to the list of values supplied
  // for it.
  requestParameters map[string][]string
  // HTTP status code the operation returned
  //
  // A 2xx status means the change was applied; 401 and 403 record a
  // rejected attempt, which is what distinguishes a successful privilege
  // change from a failed one.
  responseStatus string
  // Message the service returned with the response
  responseMessage string
  // When the response was issued
  responseTime time
  // State transition the operation caused
  //
  // Has `previous` and `current` maps for operations that changed a
  // resource's lifecycle state, and is empty for read-only calls.
  stateChange dict
  // Service-specific details recorded alongside the event
  additionalDetails dict
}

// Oracle Cloud Infrastructure (OCI) Connector Hub
//
// Connectors that move data between OCI services, and the mechanism by
// which audit events and logs leave the tenancy for an external SIEM or
// long-term storage. Each connector reads from one source and writes to
// one target, so enumerating `connectors` answers whether audit logging
// is exported at all, where it goes, and whether the pipeline is
// running. A tenancy with audit retention configured but no connector
// forwarding it keeps its logs only inside OCI, and only for the
// retention window.
oci.serviceConnectorHub {
  // Connectors defined across the tenancy
  connectors() []oci.serviceConnectorHub.connector
}

// Oracle Cloud Infrastructure (OCI) connector
//
// Single data-movement pipeline, keyed by its OCID. `sourceKind` and
// `targetKind` name the two ends: a source of `logging` (which includes
// the tenancy audit log), `monitoring`, `streaming`, or `plugin`, and a
// target of `objectStorage`, `streaming`, `functions`,
// `loggingAnalytics`, `monitoring`, or `notifications`. The `source` and
// `target` fields carry the full configuration of each end, including
// the bucket, stream, or function being written to and any private
// endpoint the connector routes through, and `tasks` holds the optional
// filtering or transformation applied in between. `state` reports
// whether the pipeline is ACTIVE and actually moving data, since an
// INACTIVE or FAILED connector exports nothing while still appearing to
// be configured.
private oci.serviceConnectorHub.connector @defaults("name sourceKind targetKind state") {
  // Connector OCID
  id string
  // Connector display name
  name string
  // Connector description
  description string
  // Compartment containing the connector
  compartment() oci.compartment
  // Connector lifecycle state (CREATING, UPDATING, ACTIVE, INACTIVE, NEEDS_ATTENTION, DELETING, DELETED, FAILED)
  state string
  // Detail explaining the current lifecycle state, for FAILED connectors
  stateDetails string
  // Region the connector runs in
  region string
  // Kind of source the connector reads from (logging, monitoring, streaming, plugin)
  sourceKind() string
  // Configuration of the source the connector reads from
  //
  // Shape varies by `sourceKind`. A `logging` source has `logSources`,
  // each with `compartmentId` and optionally `logGroupId` and `logId`,
  // where the tenancy audit log is named by the reserved value `_Audit`. A
  // `monitoring` source has `namespaceDetails`, a `streaming` source has
  // `streamId` and `cursor`, and a `plugin` source has `pluginName` and
  // `configMap`.
  source() dict
  // Kind of target the connector writes to (objectStorage, streaming, functions, loggingAnalytics, monitoring, notifications)
  targetKind() string
  // Object Storage bucket the connector writes to
  //
  // Set when `targetKind` is objectStorage, and null otherwise. Resolving
  // it makes the receiving bucket's own posture, such as its public
  // access type and retention rules, reachable from the connector.
  targetBucket() oci.objectStorage.bucket
  // Notification topic the connector writes to
  //
  // Set when `targetKind` is notifications, and null otherwise.
  targetTopic() oci.ons.topic
  // Log groups the connector reads from
  //
  // The log groups named by a `logging` source. Empty for every other
  // source kind. The tenancy audit log is not a customer log group and so
  // does not appear here; `exportsAuditLog` reports it instead.
  sourceLogGroups() []oci.logging.logGroup
  // Whether the connector exports the tenancy audit log
  //
  // True when a `logging` source names the reserved `_Audit` log group,
  // which is the audit stream itself rather than a log group in a
  // compartment. This is the check for whether control-plane audit events
  // leave OCI for archival or a SIEM.
  exportsAuditLog() bool
  // Configuration of the target the connector writes to
  //
  // Shape varies by `targetKind`. An `objectStorage` target has
  // `bucketName`, `namespace`, `objectNamePrefix`, and batch rollover
  // settings; `streaming` has `streamId`; `functions` has `functionId`;
  // `notifications` has `topicId`; `loggingAnalytics` has `logGroupId`;
  // and `monitoring` has `namespace` and `metric`.
  target() dict
  // Filtering and transformation applied between source and target
  //
  // Each entry has a `kind` of `logRule` (a filter expression in
  // `condition`) or `function` (a transform in `functionId`), plus
  // `batchSizeInKbs` and `batchTimeInSec` where the task batches.
  tasks() []dict
  // Connector creation time
  created time
  // Connector last-update time
  updated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Bastion
//
// Bastion instances in the tenancy, managed jump hosts that broker SSH
// access into private subnets without exposing them to the public
// internet. Iterate `bastions` for every bastion deployment, each
// exposing its target VCN and subnet, DNS proxy status, bastion type,
// and lifecycle state.
oci.bastion {
  // Bastion instances
  bastions() []oci.bastion.instance
}

// Oracle Cloud Infrastructure (OCI) bastion instance
private oci.bastion.instance @defaults("name") {
  // Bastion OCID
  id string
  // Bastion display name
  name string
  // Compartment containing the bastion
  compartment() oci.compartment
  // Bastion type (e.g., standard)
  bastionType string
  // Target VCN
  targetVcn() oci.network.vcn
  // Target subnet
  targetSubnet() oci.network.subnet
  // CIDR blocks allowed to connect to the bastion
  //
  // The source addresses permitted to open a session. A bastion allowing
  // 0.0.0.0/0 accepts session attempts from anywhere on the internet. Empty
  // when no allow list is configured.
  clientCidrBlockAllowList() []string
  // Maximum session lifetime in seconds
  //
  // The longest a session may stay open before it must be recreated. Null
  // when the bastion reports no limit.
  maxSessionTtlInSeconds() int
  // Maximum number of concurrent sessions
  maxSessionsAllowed() int
  // Fixed private IP addresses the bastion connects from
  //
  // The jump-host addresses that appear as the source of bastion traffic, for
  // writing narrower target security rules.
  staticJumpHostIpAddresses() []string
  // Private endpoint IP address of the bastion in the target subnet
  privateEndpointIpAddress() string
  // Lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // DNS proxy status (DISABLED, ENABLED)
  dnsProxyStatus string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Monitoring
//
// Alarm definitions configured in the tenancy's Monitoring service.
// Each alarm evaluates a Monitoring Query Language expression against a
// metric namespace and publishes notifications to Oracle Notifications
// Service (ONS) topics when its condition and severity threshold are
// met. Auditing the alarms confirms that critical infrastructure and
// security signals are actually monitored and routed to a live
// notification destination.
oci.monitoring {
  // Monitoring alarm definitions
  alarms() []oci.monitoring.alarm
}

// Oracle Cloud Infrastructure (OCI) monitoring alarm
//
// Single alarm definition in the Monitoring service. It evaluates a
// Monitoring Query Language expression over a metric namespace and
// raises a notification when the condition is met. Each alarm records
// its severity, whether it is enabled, its lifecycle state, and the
// Oracle Notifications Service topics that receive its messages, so an
// audit can confirm that important metrics are watched and that the
// resulting alerts reach a valid destination.
private oci.monitoring.alarm @defaults("name") {
  // Alarm OCID
  id string
  // Alarm display name
  name string
  // Compartment containing the alarm
  compartment() oci.compartment
  // Metric compartment OCID being monitored
  //
  // Deprecated in favor of metricCompartment, which resolves the same OCID to
  // the compartment it names.
  metricCompartmentId @maturity("deprecated") @replaced_by("oci.monitoring.alarm.metricCompartment") string
  // Compartment whose metrics the alarm evaluates
  //
  // An alarm watches the metrics of this compartment rather than of the one it
  // is defined in, so this is what bounds the blast radius the alarm can see.
  metricCompartment() oci.compartment
  // Metric namespace (e.g., oci_computeagent, oci_vcn)
  namespace string
  // Monitoring Query Language (MQL) expression
  query string
  // Alarm severity (CRITICAL, ERROR, WARNING, INFO)
  severity string
  // Notification topics the alarm publishes to
  topics() []oci.ons.topic
  // Notification destinations the alarm publishes to
  //
  // One OCID per destination service, either a Notifications topic or a
  // Streaming stream. An empty list is an alarm that fires and reaches nobody.
  // The `topics` field resolves the Notifications entries; a stream
  // destination is reported here only.
  destinations []string
  // Start of the window in which alarm notifications are suppressed
  //
