  // Path the probe requests, on an HTTP probe
  urlPath string
  // Consecutive failures before a backend is considered unhealthy
  retries int
  // Time the probe waits for a reply, in milliseconds
  timeoutInMillis int
  // Interval between probes, in milliseconds
