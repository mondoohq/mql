  //
  // One row per address the system listens on. `modes` separates a read-only
  // endpoint from one that accepts writes, and `resourceType` separates the
  // system's own address from a read replica or the load balancer fronting it.
  dbEndpoints []oci.mysql.dbSystem.endpoint
  // How the data-at-rest encryption key is managed (SYSTEM, BYOK)
  encryptionKeyGenerationType() string
  // Customer-managed KMS key protecting data at rest
  //
  // Null when `encryptionKeyGenerationType` is SYSTEM, meaning the system
  // is encrypted with an Oracle-managed key.
  encryptionKey() oci.kms.key
  // How the TLS certificate is provided (SYSTEM, BYOC)
  tlsCertificateType() string
  // Certificate served for TLS connections, when a customer certificate is configured
  tlsCertificate() oci.certificates.certificate
  // Automatic backup policy
  //
  // Has `isEnabled`, `retentionInDays`, `windowStartTime`, a `softDelete`
  // flag, a `pitrPolicy` block for point-in-time recovery, and
  // `copyPolicies` for cross-region backup copies.
  backupPolicy dict
  // Policy applied to backups and automatic backups when the system is deleted
  //
  // Deprecated in favor of deletionRules, which reports the same policy as a
  // structure. Together its values decide whether deleting the system also
  // destroys its recovery points.
  deletionPolicy @maturity("deprecated") @replaced_by("oci.mysql.dbSystem.deletionRules") dict
  // What deleting the system does to it and to its backups
  //
  // Null when the system reports no deletion policy.
  deletionRules() oci.mysql.deletionPolicy
  // Availability domain the system is placed in
  availabilityDomain string
  // Fault domain the system is placed in
  faultDomain string
  // Lifecycle state (CREATING, ACTIVE, INACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Creation time
  created time
  // Last-update time
  updated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Deletion policy of a MySQL database system
//
// What deleting the database system does to it and to its recovery points.
// deleteProtected is what stops the delete outright, and the other two decide
// whether the backups that would allow a restore survive it.
private oci.mysql.deletionPolicy @defaults("deleteProtected automaticBackupRetention finalBackup") {
  // What happens to automatic backups when the system is deleted
  //
  // RETAIN keeps them, DELETE destroys them along with the system.
  automaticBackupRetention string
  // Whether a backup is taken when the system is deleted
  //
  // REQUIRE_FINAL_BACKUP takes one, SKIP_FINAL_BACKUP does not.
  finalBackup string
  // Whether the database system is protected from deletion
  //
  // False, the default, means an API call or console action can delete the
  // system outright.
  deleteProtected bool
}


// Address a MySQL database system answers on
//
// A single listener the database system publishes, with the port for the
// classic MySQL protocol in `port` and the port for the X protocol in `portX`.
// `modes` reports whether the endpoint accepts writes or only reads, and
// `resourceType` separates the system's own address from a read replica or the
// load balancer fronting it.
private oci.mysql.dbSystem.endpoint @defaults("hostname ipAddress port status") {
  // Address the endpoint listens on
  ipAddress string
  // Network address of the endpoint
  //
  // Empty when the endpoint publishes no hostname, leaving the address as the
  // only way to reach it.
  hostname string
  // Port the classic MySQL protocol listens on
  port int
  // Port the X protocol listens on
  portX int
  // Address family of the endpoint
  //
  // IPV4 or IPV6.
  ipAddressVersion string
  // Access modes the endpoint accepts
  //
  // READ, WRITE, or both. An endpoint offering only READ cannot be used to
  // modify data whatever the connecting account is granted.
  modes []string
  // State of the endpoint as the database system sees it
  //
  // For example ACTIVE, INACTIVE, or UPDATING. This is the system's own view
  // and can lag the actual state of the MySQL service.
  status string
  // Detail behind the endpoint status
  statusDetails string
  // Kind of resource the endpoint is attached to
  //
  // DBSYSTEM, READ_REPLICA, LOAD_BALANCER, or READ_ENDPOINT.
  resourceType string
  // OCID of the resource the endpoint is attached to
  //
  // The kind of resource this names varies with `resourceType`, so it is
  // reported as the OCID rather than resolved.
  resourceId string
}

// Oracle Cloud Infrastructure (OCI) Database with PostgreSQL
//
// Managed PostgreSQL database systems in the tenancy. PostgreSQL systems
// are always deployed into a customer subnet with no public endpoint, so
// the exposure question is which subnet and which network security
// groups rather than public versus private. Each system reports its
// backup policy, its admin username, and whether a reader endpoint is
// published alongside the primary.
oci.postgresql {
  // PostgreSQL database systems
  dbSystems() []oci.postgresql.dbSystem
}

// Oracle Cloud Infrastructure (OCI) PostgreSQL database system
//
// Single managed PostgreSQL system, keyed by its OCID. `subnet` and
// `securityGroups` place it on the network and are the only controls on
// who can reach it. `managementPolicy` carries the backup retention and
// maintenance window, `storageDetails` the storage configuration
// including whether the volume is encrypted with a customer-managed key,
// and `systemRole` distinguishes a standalone system from a primary or
// one of its standbys.
private oci.postgresql.dbSystem @defaults("name dbVersion state") {
  // Database system OCID
  id string
  // Display name
  name string
  // Description
  description() string
  // Compartment containing the database system
  compartment() oci.compartment
  // PostgreSQL server version
  dbVersion string
  // Shape name
  shape string
  // Deployment type (OCI_OPTIMIZED_STORAGE)
  systemType string
  // Role in a disaster-recovery topology (STANDALONE_DB_SYSTEM, PRIMARY_DB_SYSTEM, WARM_STANDBY_DB_SYSTEM, PILOT_LIGHT_DB_SYSTEM)
  systemRole() string
  // Number of database instances in the system
  instanceCount int
  // OCPUs allocated per instance
  instanceOcpuCount int
  // Memory allocated per instance, in GB
  instanceMemorySizeInGBs int
  // Administrator user name created with the system
  adminUsername() string
  // Subnet the database system is attached to
  subnet() oci.network.subnet
  // Network security groups attached to the database system
  securityGroups() []oci.network.networkSecurityGroup
  // Private IP address of the primary database endpoint
  primaryEndpointPrivateIp() string
  // Whether a separate read-only endpoint is published
  isReaderEndpointEnabled() bool
  // Storage configuration
  //
  // Has `systemType`, `isRegionallyDurable`, `availabilityDomain`, and
  // `iops`. For an encrypted volume it also carries the KMS `kmsKeyId`.
  storageDetails() dict
  // Backup and maintenance policy
  //
  // Has a `backupPolicy` block with the retention schedule (`kind` of
  // DAILY, WEEKLY, MONTHLY, or NONE, plus `retentionDays` and the
  // scheduled time) and a `maintenanceWindowStart`.
  managementPolicy() dict
  // Database configuration applied to the system
  configId string
  // Lifecycle state (CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED, NEEDS_ATTENTION)
  state string
  // Detail explaining the current lifecycle state, for FAILED systems
  stateDetails string
  // Creation time
  created time
  // Last-update time
  updated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) NoSQL Database
//
// NoSQL tables in the tenancy. Tables report their lifecycle state,
// throughput and storage limits, and whether they are replicated across
// regions, which is what determines where the data physically resides.
// `isAutoReclaimable` marks always-free tables that OCI deletes
// automatically after a period of inactivity, and `timeOfExpiration`
// when that will happen.
oci.nosql {
  // NoSQL tables
  tables() []oci.nosql.table
}

// Oracle Cloud Infrastructure (OCI) NoSQL table
private oci.nosql.table @defaults("name state") {
  // Table OCID
  id string
  // Table name
  name string
  // Compartment containing the table
  compartment() oci.compartment
  // Throughput and storage limits
  //
  // Deprecated in favor of limits, which reports the same ceilings as a
  // structure.
  tableLimits @maturity("deprecated") @replaced_by("oci.nosql.table.limits") dict
  // Throughput and storage ceilings the table is provisioned with
  //
  // Null when the table reports no limits.
  limits() oci.nosql.tableLimits
  // Whether the table is replicated across regions
  isMultiRegion bool
  // Whether the table is reclaimed automatically after a period of inactivity
  //
  // True for always-free tables, which OCI deletes on the
  // `timeOfExpiration` date unless they are used again.
  isAutoReclaimable bool
  // When an auto-reclaimable table will be deleted
  timeOfExpiration time
  // Whether the table schema can still be changed (MUTABLE, FROZEN)
  //
  // A frozen schema is required before a table can be replicated across
  // regions.
  schemaState string
  // Lifecycle state (CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED, FAILED)
  state string
  // Creation time
  created time
  // Last-update time
  updated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Throughput and storage limits of a NoSQL table
//
// The ceilings the table is provisioned with. capacityMode decides whether the
// read and write units are enforced at all: an ON_DEMAND table reports zero
// for both because the limits do not apply to it.
private oci.nosql.tableLimits @defaults("capacityMode maxReadUnits maxWriteUnits") {
  // Maximum sustained read throughput for the table
  //
  // Zero when capacityMode is ON_DEMAND, where the limit does not apply.
  maxReadUnits int
  // Maximum sustained write throughput for the table
  //
  // Zero when capacityMode is ON_DEMAND, where the limit does not apply.
  maxWriteUnits int
  // Maximum storage the table may use, in gigabytes
  maxStorageInGBs int
  // How the table's capacity is provisioned
  //
  // PROVISIONED or ON_DEMAND.
  capacityMode string
}


// Oracle Cloud Infrastructure (OCI) Search with OpenSearch
//
// OpenSearch clusters in the tenancy. `securityMode` is the field that
// decides whether the cluster authenticates its callers at all: a
// cluster in DISABLED mode serves every request unauthenticated to
// anything that can reach it on the network, PERMISSIVE accepts both
// authenticated and unauthenticated requests, and only ENFORCING
// requires credentials. Combined with the subnet placement in `subnet`,
// that determines who can read the indexed data.
oci.opensearch {
  // OpenSearch clusters
  clusters() []oci.opensearch.cluster
}

// Oracle Cloud Infrastructure (OCI) OpenSearch cluster
//
// Single OpenSearch cluster, keyed by its OCID. Beyond `securityMode`,
// `securityMasterUserName` names the built-in administrator when
// security is on, and `outboundClusterConfig` reports whether the
// cluster is configured to reach out to other clusters through
// cross-cluster search. `securityAttributes` carries the Zero Trust
// Packet Routing attributes applied to the cluster.
private oci.opensearch.cluster @defaults("name softwareVersion securityMode state") {
  // Cluster OCID
  id string
  // Display name
  name string
  // Compartment containing the cluster
  compartment() oci.compartment
  // OpenSearch version
  softwareVersion string
  // Whether the cluster requires authentication (DISABLED, PERMISSIVE, ENFORCING)
  //
  // DISABLED serves every request unauthenticated. PERMISSIVE accepts
  // both authenticated and unauthenticated requests, so it does not
  // enforce access control either. Only ENFORCING requires credentials.
  securityMode string
  // Built-in administrator user name, when security is enabled
  securityMasterUserName() string
  // Whether SAML single sign-on is configured on the cluster
  //
  // When enabled, an external identity provider issues the assertions the
  // cluster accepts, so access is no longer bounded by the built-in master
  // user and internal roles alone.
  isSamlEnabled() bool
  // Entity identifier of the SAML identity provider
  //
  // Empty when SAML is not configured.
  samlIdpEntityId() string
  // Backend role mapped to cluster administrator for SAML users
  //
  // Every federated user carrying this role becomes a cluster administrator.
  // Empty when SAML is not configured.
  samlAdminBackendRole() string
  // Assertion attribute the cluster reads the user name from
  samlSubjectKey() string
  // Assertion attribute the cluster reads role membership from
  //
  // Role membership drives authorization, so the attribute named here decides
  // which cluster roles a federated user receives.
  samlRolesKey() string
  // OpenSearch Dashboards URL registered with the identity provider
  samlOpendashboardUrl() string
  // How the OpenSearch API endpoint certificate is managed (OCI_MANAGED, BYOC)
  //
  // BYOC means the certificate comes from the tenancy's own OCI Certificates
  // service, exposed through apiCertificate.
  clusterCertificateMode() string
  // How the OpenSearch Dashboards endpoint certificate is managed (OCI_MANAGED, BYOC)
  dashboardCertificateMode() string
  // Certificate served on the OpenSearch API endpoint
  //
  // Null when the endpoint uses an Oracle-managed certificate.
  apiCertificate() oci.certificates.certificate
  // Certificate served on the OpenSearch Dashboards endpoint
  //
  // Null when the endpoint uses an Oracle-managed certificate.
  dashboardCertificate() oci.certificates.certificate
  // VCN the cluster is deployed into
  vcn() oci.network.vcn
  // Subnet the cluster is deployed into
  subnet() oci.network.subnet
  // Network security groups attached to the cluster
  //
  // Empty when the cluster is governed only by its subnet's security lists.
  securityGroups() []oci.network.networkSecurityGroup
  // Fully-qualified domain name of the cluster
  fqdn() string
  // Load balancer service fronting the cluster (OCI_LOAD_BALANCER, OCI_NETWORK_LOAD_BALANCER)
  //
  // Empty when the cluster is reached directly rather than through a load
  // balancer.
  loadBalancerServiceType() string
  // Reverse connection endpoints the cluster reaches customer networks through
  //
  // Each entry has a `customerIp`, the address in the customer VCN, and a
  // `natIp`, the address the cluster presents. These are the paths by which
  // the managed cluster reaches back into tenant networks.
  reverseConnectionEndpoints() []dict
  // Clusters permitted to run cross-cluster searches against this one
  //
  // The inbound half of cross-cluster search, where outboundClusterConfig is
  // the outbound half. Empty when no other cluster may search this one.
  inboundClusters() []oci.opensearch.cluster
  // Fully-qualified domain name of the OpenSearch API endpoint
  opensearchFqdn() string
  // Private IP address of the OpenSearch API endpoint
  opensearchPrivateIp() string
  // Fully-qualified domain name of the OpenSearch Dashboards endpoint
  opendashboardFqdn() string
  // Private IP address of the OpenSearch Dashboards endpoint
  opendashboardPrivateIp() string
  // Cross-cluster search configuration
  //
  // Has `isEnabled` and a `outboundClusters` list, each entry carrying
  // the remote cluster's `displayName`, `seedClusterId`, `mode`, and
  // whether it `isSkipUnavailable`.
  outboundClusterConfig dict
  // Backup policy
  //
  // Deprecated in favor of backups, which reports the same policy as a
  // structure.
  backupPolicy @maturity("deprecated") @replaced_by("oci.opensearch.cluster.backups") dict
  // Automatic backup schedule and retention
  //
  // Null when the cluster reports no backup policy, which is a different fact
  // from a policy that turns backups off.
  backups() oci.opensearch.backupPolicy
  // Total storage allocated to the cluster, in GB
  totalStorageGB int
  // Availability domains the cluster is distributed across
  availabilityDomains []string
  // Zero Trust Packet Routing security attributes applied to the cluster
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits.
  securityAttributes @maturity("deprecated") @replaced_by("oci.opensearch.cluster.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
  // Lifecycle state (CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Detail explaining the current lifecycle state, for FAILED clusters
  stateDetails string
  // Creation time
  created time
  // Last-update time
  updated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Automatic backup policy of an OpenSearch cluster
//
// Whether the cluster takes automatic backups, how often, and how long each
// copy is kept. A cluster with backups off has no recovery point to restore
// from, whatever retention says.
private oci.opensearch.backupPolicy @defaults("isEnabled frequencyInHours retentionInDays") {
  // Whether automatic backups are enabled
  isEnabled bool
  // Days a backup copy is kept on storage
  retentionInDays int
  // Hours between backups
  frequencyInHours int
}


// Oracle Cloud Infrastructure (OCI) GoldenGate
//
// GoldenGate data-replication deployments in the tenancy. A deployment
// runs a web console and REST API that hold the credentials for every
// source and target database it replicates between, so `isPublic` - and
// the `publicIpAddress` that accompanies it - is the field that decides
// whether that console is reachable from the internet. `subnet` and
// `securityGroups` govern reachability for private deployments.
oci.goldenGate {
  // GoldenGate deployments
  deployments() []oci.goldenGate.deployment
}

// Oracle Cloud Infrastructure (OCI) GoldenGate deployment
//
// Single GoldenGate deployment, keyed by its OCID. `deploymentUrl` is
// the console and REST endpoint, published on `publicIpAddress` when
// `isPublic` is set and on `privateIpAddress` otherwise.
// `isLatestVersion` reports whether the deployment is running the
// current GoldenGate release, which is the patch-currency signal for a
// component that brokers database credentials. `securityAttributes`
// carries the Zero Trust Packet Routing attributes applied to the
// deployment.
private oci.goldenGate.deployment @defaults("name isPublic state") {
  // Deployment OCID
  id string
  // Display name
  name string
  // Description
  description string
  // Compartment containing the deployment
  compartment() oci.compartment
  // Whether the deployment console and REST API are reachable from the internet
  isPublic bool
  // Public IP address of the deployment, when it is public
  publicIpAddress string
  // Private IP address of the deployment
  privateIpAddress string
  // Fully-qualified domain name of the deployment
  fqdn string
  // URL of the deployment console and REST API
  deploymentUrl string
  // Subnet the deployment is attached to
  subnet() oci.network.subnet
  // Network security groups attached to the deployment
  securityGroups() []oci.network.networkSecurityGroup
  // Load balancer fronting the deployment
  loadBalancer() oci.loadBalancer.loadBalancer
  // Deployment type
  //
  // One of OGG, DATABASE_ORACLE, BIGDATA, DATABASE_MICROSOFT_SQLSERVER,
  // DATABASE_MYSQL, DATABASE_POSTGRESQL, DATABASE_DB2ZOS, GGSA, or
  // DATA_TRANSFORMS.
  deploymentType string
  // Deployment category (DATA_REPLICATION, STREAM_ANALYTICS, DATA_TRANSFORMS)
  category string
  // Environment type (PRODUCTION, DEVELOPMENT_OR_TESTING)
  environmentType string
  // License model (LICENSE_INCLUDED, BRING_YOUR_OWN_LICENSE)
  licenseModel string
  // Whether the deployment runs the latest available GoldenGate version
  isLatestVersion bool
  // Whether CPU auto-scaling is enabled
  isAutoScalingEnabled bool
  // OCPUs allocated to the deployment
  cpuCoreCount int
  // Zero Trust Packet Routing security attributes applied to the deployment
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits.
  securityAttributes @maturity("deprecated") @replaced_by("oci.goldenGate.deployment.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
  // Lifecycle state
  //
  // One of CREATING, UPDATING, ACTIVE, INACTIVE, DELETING, DELETED,
  // FAILED, NEEDS_ATTENTION, IN_PROGRESS, CANCELING, CANCELED,
  // SUCCEEDED, or WAITING.
  state string
  // Detailed lifecycle sub-state
  //
  // One of RECOVERING, STARTING, STOPPING, MOVING, UPGRADING, RESTORING,
  // BACKUP_IN_PROGRESS, or ROLLBACK_IN_PROGRESS.
  lifecycleSubState string
  // Detail explaining the current lifecycle state, for FAILED deployments
  stateDetails string
  // Creation time
  created time
  // Last-update time
  updated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) DNS
//
// DNS zones hosted in the tenancy and the traffic-management policies
// applied to them. `zones` covers both the internet-facing GLOBAL scope
// and the VCN-internal PRIVATE scope, each zone reporting its DNSSEC
// state and, through `records`, the resource records it publishes.
// `steeringPolicies` lists the geo, failover, and load-balancing rules
// that decide which answer a resolver receives.
oci.dns {
  // DNS zones hosted in the tenancy
  zones() []oci.dns.zone
  // Steering policies applied to DNS answers
  steeringPolicies() []oci.dns.steeringPolicy
}

// Oracle Cloud Infrastructure (OCI) DNS zone
//
// Single DNS zone, keyed by its OCID. `scope` separates a GLOBAL zone,
// which answers queries from the public internet, from a PRIVATE zone,
// which answers only inside the VCNs attached to its view.
// `dnssecState` reports whether DNSSEC signing is ENABLED or DISABLED,
// and `dnssecKeyVersions` carries the key-signing and zone-signing key
// material behind it, including each key's algorithm and its scheduled
// rollover times. `records` returns the resource records the zone
// publishes, which is what makes it possible to find answers still
// pointing at addresses or hostnames the tenancy no longer owns.
// `isProtected` marks zones OCI manages and blocks from modification.
private oci.dns.zone @defaults("name zoneType scope dnssecState") {
  // Zone OCID
  id string
  // Zone name (the DNS domain, e.g., example.com)
  name string
  // Compartment containing the zone
  compartment() oci.compartment
  // Zone type (PRIMARY, SECONDARY)
  zoneType string
  // Whether the zone answers publicly (GLOBAL) or only inside attached VCNs (PRIVATE)
  scope string
  // How the zone resolves queries (IMPORTED, IMPORTED_LIMITED_SUPPORT)
  resolutionMode string
  // Whether DNSSEC signing is enabled for the zone (ENABLED, DISABLED)
  dnssecState string
  // DNSSEC key-signing and zone-signing key versions
  //
  // Deprecated in favor of kskVersions and zskVersions, which return the two
  // lists as resources with the timestamps as real times rather than strings.
  // The field name describes a list, but the value is an object holding the
  // `kskDnssecKeyVersions` and `zskDnssecKeyVersions` lists. Empty when
  // `dnssecState` is DISABLED.
  dnssecKeyVersions @maturity("deprecated") dict
  // Key-signing key versions for the zone
  //
  // The keys whose material signs the zone's DNSKEY record set, and whose
  // digests the parent zone publishes as DS records. Empty when `dnssecState`
  // is DISABLED.
  kskVersions []oci.dns.zone.dnssecKeyVersion
  // Zone-signing key versions for the zone
  //
  // The keys whose material signs the zone's records. Empty when
  // `dnssecState` is DISABLED.
  zskVersions []oci.dns.zone.dnssecKeyVersion
  // Resource records published by the zone
  records() []oci.dns.record
  // Whether the zone is managed by OCI and cannot be modified
  isProtected bool
  // Zone serial number
  serial int
  // Zone version
  version string
  // View the zone belongs to, for PRIVATE zones
  viewId string
  // Zone lifecycle state (ACTIVE, CREATING, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Zone creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// DNSSEC key version for a DNS zone
//
// A single key-signing or zone-signing key version, keyed by its UUID. The
// lifecycle timestamps are what make key rollover auditable: `timeActivated`
// says when the key started signing, `timeExpired` when its recommended
// lifetime ends, and `timeInactivated` when it stopped. A key that is past
// `timeExpired` and still active means a rollover was never completed, and a
// key-signing key stays active arbitrarily long in that state rather than
// breaking resolution.
private oci.dns.zone.dnssecKeyVersion @defaults("algorithm lengthInBytes keyTag") {
  // Signing algorithm used for the key
  //
  // For example RSASHA256 or ECDSAP256SHA256.
  algorithm string
  // Length of the corresponding private key, in bytes
  lengthInBytes int
  // Key tag carried in the RRSIG and DS records for this key
  keyTag int
  // When the key version was created
  created time
  // When the DNSKEY record for this key was, or will be, published in the zone
  //
  // Null when no publication is scheduled.
  timePublished time
  // When the key started, or will start, generating signatures
  //
  // Null when no activation is scheduled.
  timeActivated time
  // When the key stopped, or will stop, generating signatures
  //
  // Null while the key is still in use. On a key-signing key this is only
  // populated once the successor has been promoted.
  timeInactivated time
  // When the DNSKEY record for this key was, or will be, removed from the zone
  //
  // Null while the key is still published.
  timeUnpublished time
  // When the recommended publication and activation lifetime ends
  //
  // A key still active past this time has an incomplete rollover behind it. A
  // key-signing key whose successor has not been promoted stays active past
  // this point rather than breaking resolution.
  timeExpired time
  // When the key version was promoted
  //
  // Null on a key that has not been promoted.
  timePromoted time
  // UUID of the key version this one replaces
  //
  // Empty when this key version has no predecessor.
  predecessorUuid string
  // UUID of the key version that replaces this one
  //
  // Empty when no successor has been created, which on a key-signing key past
  // its expiry means the rollover has not been started.
  successorUuid string
  // DS record data for this key version
  //
  // One entry per supported DS digest algorithm, each carrying `rdata` and
  // `digestType`. These are the records the parent zone must publish for the
  // chain of trust to hold. Empty on a zone-signing key, which has no DS
  // records.
  dsData []dict
}

// Oracle Cloud Infrastructure (OCI) DNS record
//
// Single resource record in a zone. `domain` is the fully-qualified name
// the record answers for, `rtype` its type (A, AAAA, CNAME, MX, TXT, NS,
// and so on), and `rdata` the answer itself. A CNAME or A record whose
// `rdata` points at a hostname or address the tenancy has released is
// the shape of a subdomain-takeover exposure, which is why the record
// data is queryable rather than summarized.
private oci.dns.record @defaults("domain rtype rdata") {
  // Fully-qualified domain name the record answers for
  domain string
  // Record type (A, AAAA, CNAME, MX, TXT, NS, SRV, CAA, and others)
  rtype string
  // Record data, in the presentation format for its type
  rdata string
  // Time-to-live in seconds
  ttl int
  // Whether the record is managed by OCI and cannot be modified
  isProtected bool
  // Version of the record set this record belongs to
  rrsetVersion string
}

// Oracle Cloud Infrastructure (OCI) DNS steering policy
//
// Rule set that decides which answer a resolver receives for a name,
// keyed by its OCID. `template` names the behavior: FAILOVER,
// LOAD_BALANCE, ROUTE_BY_GEO, ROUTE_BY_ASN, ROUTE_BY_IP, or CUSTOM.
// Geo and IP routing decide answers from client location, so the policy
// is part of understanding what a given client actually resolves.
private oci.dns.steeringPolicy @defaults("name template state") {
  // Steering policy OCID
  id string
  // Steering policy display name
  name string
  // Compartment containing the steering policy
  compartment() oci.compartment
  // Policy behavior (FAILOVER, LOAD_BALANCE, ROUTE_BY_GEO, ROUTE_BY_ASN, ROUTE_BY_IP, CUSTOM)
  template string
  // Time-to-live applied to answers this policy produces, in seconds
  ttl int
  // Health check monitor driving failover decisions
  healthCheckMonitorId string
  // Policy lifecycle state (ACTIVE, CREATING, UPDATING, DELETING, DELETED)
  state string
  // Policy creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Network Firewall
//
// Next-generation firewall deployments in the tenancy. The
// `firewalls` field lists the deployed firewall instances, each with
// its subnet placement, IPv4/IPv6 addresses, shape, and attached
// `policy`. The `policies` field lists the reusable firewall policies
// that drive the rule sets each firewall enforces.
oci.networkFirewall {
  // Network firewalls
  firewalls() []oci.networkFirewall.firewall
  // Network firewall policies
  policies() []oci.networkFirewall.policy
}

// Oracle Cloud Infrastructure (OCI) network firewall
private oci.networkFirewall.firewall @defaults("name") {
  // Firewall OCID
  id string
  // Display name
  name string
  // Compartment containing the firewall
  compartment() oci.compartment
  // Subnet the firewall is deployed in
  subnet() oci.network.subnet
  // Firewall policy
  policy() oci.networkFirewall.policy
  // IPv4 address
  ipv4Address string
  // IPv6 address
  ipv6Address string
  // Firewall shape
  shape string
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Zero Trust Packet Routing security attributes enforced on the firewall
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits. Keyed by security-attribute namespace, each value
  // maps the attribute names within that namespace to their assigned values.
  securityAttributes @maturity("deprecated") @replaced_by("oci.networkFirewall.firewall.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
  // Overall firewall health status
  //
  // One of OK, WARNING, CRITICAL, or UNKNOWN.
  healthStatus() string
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) network firewall policy
private oci.networkFirewall.policy @defaults("name") {
  // Policy OCID
  id string
  // Display name
  name string
  // Compartment containing the policy
  compartment() oci.compartment
  // Policy description
  description() string
  // Number of firewalls attached to this policy
  attachedFirewallCount() int
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
  // SSL/TLS decryption profiles
  //
  // Decryption profiles bound to the policy's decryption rules, which
  // control the SSL/TLS sessions the firewall blocks during inspection
  // (unsupported protocol versions, weak cipher suites, expired or
  // untrusted certificates). Audit these to confirm that legacy TLS and
  // non-compliant ciphers are refused in transit.
  decryptionProfiles() []oci.networkFirewall.policy.decryptionProfile
  // Security rules the policy enforces
  //
  // The ordered rule set deciding which traffic the attached firewalls allow,
  // drop, reject or inspect. An empty list means the policy enforces nothing,
  // which is not the same as a policy that denies.
  securityRules() []oci.networkFirewall.policy.securityRule
  // Decryption rules the policy enforces
  //
  // The rules deciding which TLS sessions are decrypted for inspection, and
  // under which decryption profile.
  decryptionRules() []oci.networkFirewall.policy.decryptionRule
  // Address lists the policy's rules match on
  //
  // Named groups of IP addresses or FQDNs. Security rules name these rather
  // than carrying addresses inline, so a rule cannot be read as permissive or
  // restrictive without them.
  addressLists() []oci.networkFirewall.policy.addressList
  // URL pattern lists the policy's rules match on
  //
  // Named groups of URL patterns evaluated against the HTTP(S) request target
  // of decrypted traffic.
  urlLists() []oci.networkFirewall.policy.urlList
  // Services the policy's rules match on
  //
  // Named TCP or UDP port ranges. Together with applications these define the
  // protocol side of what a security rule matches.
  services() []oci.networkFirewall.policy.service
  // Service lists the policy's rules match on
  //
  // Named groups of services, referenced by security rules in place of listing
  // each service individually.
  serviceLists() []oci.networkFirewall.policy.serviceList
  // Applications the policy's rules match on
  //
  // Named ICMP and ICMPv6 message types and codes.
  applications() []oci.networkFirewall.policy.application
  // Application groups the policy's rules match on
  //
  // Named groups of applications, referenced by security rules in place of
  // listing each application individually.
  applicationGroups() []oci.networkFirewall.policy.applicationGroup
  // Secrets mapped into the policy for TLS inspection
  //
  // The certificates and private keys, held in Vault, that the firewall uses to
  // decrypt traffic. Each entry names the vault secret it reads, so these are
  // the key material behind every decryption rule.
  mappedSecrets() []oci.networkFirewall.policy.mappedSecret
  // NAT rules the policy applies
  //
  // Source network address translation applied to matching traffic. A NAT rule
  // changes the address a destination observes, so it also changes which
  // address-based controls downstream apply.
  natRules() []oci.networkFirewall.policy.natRule
  // Tunnel inspection rules the policy applies
  //
  // Rules deciding which encapsulated traffic (VXLAN) is unwrapped and
  // inspected. Traffic inside a tunnel that no rule matches passes through
  // uninspected.
  tunnelInspectionRules() []oci.networkFirewall.policy.tunnelInspectionRule
}

// Oracle Cloud Infrastructure (OCI) network firewall decryption profile
//
// SSL/TLS decryption profile bound to a network firewall policy. The
// `name` field selects the profile within its policy. `type`
// distinguishes SSL_FORWARD_PROXY (outbound inspection, which validates
// the server certificate) from SSL_INBOUND_INSPECTION. The boolean
// fields report which sessions the firewall blocks: unsupported TLS
// versions, unsupported cipher suites, and out-of-capacity conditions
// apply to both types, while the certificate-validation controls apply
// only to forward-proxy profiles.
// Network firewall policy security rule
//
// Single rule in a network firewall policy's ordered rule set, deciding what
// the attached firewalls do with matching traffic. `action` is the verdict and
// `priorityOrder` fixes the position in the evaluation order, so a permissive
// rule early in the set overrides stricter rules after it.
private oci.networkFirewall.policy.securityRule @defaults("name action inspection priorityOrder") {
  // Unique name of the rule within its policy
  name string
  // Verdict applied to matching traffic
  //
  // One of ALLOW, DROP, REJECT or INSPECT. DROP discards silently while
  // REJECT answers the sender.
  action string
  // Inspection applied to matching traffic
  //
  // INTRUSION_DETECTION logs a match, INTRUSION_PREVENTION blocks it. Empty
  // when the rule performs no inspection.
  inspection string
  // Position in the policy's evaluation order
  priorityOrder int
  // Rule description
  description string
  // Traffic the rule matches, by list name
  //
  // Keys are `sourceAddress`, `destinationAddress`, `application`, `service`
  // and `url`, each holding the names of the lists the rule evaluates against.
  // An absent or empty key matches anything, so a rule with no `sourceAddress`
  // accepts every source. The names resolve through the accessors below.
  condition() dict
  // Address lists evaluated against the traffic source
  sourceAddressLists() []oci.networkFirewall.policy.addressList
  // Address lists evaluated against the traffic destination
  destinationAddressLists() []oci.networkFirewall.policy.addressList
  // Applications the rule matches
  applications() []oci.networkFirewall.policy.application
  // Services the rule matches
  services() []oci.networkFirewall.policy.service
  // URL pattern lists the rule matches
  urlLists() []oci.networkFirewall.policy.urlList
}

// Named group of addresses in a network firewall policy
//
// A set of IP addresses or FQDNs that security and NAT rules match traffic
// against by name. The `name` field selects the list as a rule references it,
// for example `addressLists.where(name == "corp-ranges")`. An address list
// admitting broad public ranges makes every rule that names it permissive.
private oci.networkFirewall.policy.addressList @defaults("name type totalAddresses") {
  // Name of the address list, unique within its policy
  name string
  // Kind of entries the list holds
  //
  // One of IP or FQDN.
  type string
  // Description of the address list
  description string
  // Number of addresses in the list
  totalAddresses int
  // The addresses themselves
  //
  // IP addresses in CIDR notation, or fully qualified domain names, depending
  // on the list's type.
  addresses() []string
}

// Named group of URL patterns in a network firewall policy
//
// A set of URL patterns evaluated against the request target of decrypted
// HTTP(S) traffic. The `name` field selects the list as a security rule
// references it.
private oci.networkFirewall.policy.urlList @defaults("name totalUrls") {
  // Name of the URL list, unique within its policy
  name string
  // Description of the URL list
  description string
  // Number of URL patterns in the list
  totalUrls int
  // The URL patterns themselves
  //
  // Each entry: {type, pattern}, where a `SIMPLE` type pattern may use `*` as
  // a leading wildcard for subdomains and a trailing wildcard for paths.
  urls() []dict
}

// TCP or UDP service in a network firewall policy
//
// A named set of port ranges that security rules match traffic against. The
// `name` field selects the service as a rule references it.
private oci.networkFirewall.policy.service @defaults("name type") {
  // Name of the service, unique within its policy
  name string
  // Transport protocol
  //
  // One of TCP_SERVICE or UDP_SERVICE.
  type string
  // Description of the service
  description string
  // Port ranges the service covers
  //
  // Each entry: {minimumPort, maximumPort}. `maximumPort` is absent for a
  // single-port range.
  portRanges() []dict
}

// Named group of services in a network firewall policy
//
// A set of services referenced by security rules in place of listing each
// service individually.
private oci.networkFirewall.policy.serviceList @defaults("name totalServices") {
  // Name of the service list, unique within its policy
  name string
  // Description of the service list
  description string
  // Number of services in the list
  totalServices int
  // Names of the services the list contains
  services() []string
}

// ICMP application in a network firewall policy
//
// A named ICMP or ICMPv6 message type, and optionally a code, that security
// rules match traffic against. The `name` field selects the application as a
// rule references it.
private oci.networkFirewall.policy.application @defaults("name type icmpType") {
  // Name of the application, unique within its policy
  name string
  // Protocol the application describes
  //
  // One of ICMP or ICMP6.
  type string
  // Description of the application
  description string
  // ICMP message type
  icmpType int
  // ICMP message code (subtype)
  //
  // Null when the application matches every code of its type.
  icmpCode int
}

// Named group of applications in a network firewall policy
//
// A set of applications referenced by security rules in place of listing each
// application individually.
private oci.networkFirewall.policy.applicationGroup @defaults("name totalApps") {
  // Name of the application group, unique within its policy
  name string
  // Description of the application group
  description string
  // Number of applications in the group
  totalApps int
  // Names of the applications the group contains
  applications() []string
}

// Secret mapped into a network firewall policy for TLS inspection
//
// The certificate and private key material the firewall uses to decrypt
// traffic, held in Vault and referenced here by name. Every decryption rule
// resolves to one of these, so this is where the trust placed in the firewall
// becomes concrete.
private oci.networkFirewall.policy.mappedSecret @defaults("name type source") {
  // Name of the mapped secret, unique within its policy
  name string
  // What the secret is used for
  //
  // One of SSL_INBOUND_INSPECTION (inbound inspection) or SSL_FORWARD_PROXY
  // (outbound forward-proxy inspection).
  type string
  // Where the secret is stored
  //
  // OCI_VAULT for secrets held in the Vault service.
  source string
  // Vault secret holding the certificate and key
  vaultSecret() oci.vault.secret
  // Version of the vault secret the policy reads
  vaultSecretVersionNumber() int
}

// NAT rule in a network firewall policy
//
// Source network address translation applied to matching traffic. Because a
// NAT rule changes the address a destination observes, it also changes which
// address-based controls downstream see, so it belongs in any reading of what
// a firewall policy actually does.
private oci.networkFirewall.policy.natRule @defaults("name action priorityOrder") {
  // Name of the NAT rule, unique within its policy
  name string
  // Translation applied to matching traffic
  //
  // DIPP_SRC_NAT performs dynamic-IP-and-port source translation.
  action string
  // Position in the policy's evaluation order
  priorityOrder int
  // Rule description
  description string
  // Traffic the rule matches, by list name
  //
  // Keys are `sourceAddress`, `destinationAddress` and `service`, each holding
  // the names of the lists the rule evaluates against. An absent or empty key
  // matches anything.
  condition dict
}

// Tunnel inspection rule in a network firewall policy
//
// Decides which encapsulated traffic is unwrapped so the policy's other rules
// can see inside it. Traffic in a tunnel that no rule matches passes through
// uninspected, so the absence of a rule is itself the finding.
private oci.networkFirewall.policy.tunnelInspectionRule @defaults("name protocol action priorityOrder") {
  // Name of the tunnel inspection rule, unique within its policy
  name string
  // Encapsulation the rule inspects
  //
  // VXLAN is the only protocol currently supported.
  protocol string
  // Action taken on matching traffic
  //
  // INSPECT unwraps and inspects the traffic; INSPECT_AND_CAPTURE_LOG also
  // records it.
  action string
  // Position in the policy's evaluation order
  priorityOrder int
  // Rule description
  description string
  // Traffic the rule matches, by list name
  //
  // Keys are `sourceAddress` and `destinationAddress`, each holding the names
  // of the address lists the rule evaluates against.
  condition dict
  // Inspection profile applied to matching traffic
  //
  // Contains `mustReturnTrafficToSource`, which decides whether inspected
  // traffic is returned along the path it arrived on.
  profile dict
}

// Network firewall policy decryption rule
//
// Single rule deciding which TLS sessions a network firewall policy decrypts
// for inspection. `action` selects DECRYPT or NO_DECRYPT, and
// `decryptionProfile` names the profile whose controls apply to the decrypted
// session.
private oci.networkFirewall.policy.decryptionRule @defaults("name action decryptionProfile priorityOrder") {
  // Unique name of the rule within its policy
  name string
  // Whether matching sessions are decrypted (DECRYPT, NO_DECRYPT)
  action string
  // Name of the decryption profile applied to matching sessions
  decryptionProfile string
  // Name of the mapped secret holding the certificate used to decrypt
  secret string
  // Position in the policy's evaluation order
  priorityOrder int
  // Rule description
  description string
}

private oci.networkFirewall.policy.decryptionProfile @defaults("name type isUnsupportedVersionBlocked isUnsupportedCipherBlocked") {
  // Unique name of the decryption profile within its policy
  name string
  // Inspection type
  //
  // One of SSL_FORWARD_PROXY (outbound forward-proxy inspection) or
  // SSL_INBOUND_INSPECTION (inbound inspection).
  type string
  // Description of the decryption profile
  description string
  // Whether sessions are blocked when the SSL/TLS version is not supported
  //
  // Applies to both forward-proxy and inbound-inspection profiles.
  isUnsupportedVersionBlocked bool
  // Whether sessions are blocked when the SSL/TLS cipher suite is not supported
  //
  // Applies to both forward-proxy and inbound-inspection profiles.
  isUnsupportedCipherBlocked bool
  // Whether sessions are blocked when the firewall is temporarily unable to decrypt their traffic
  //
  // Applies to both forward-proxy and inbound-inspection profiles.
  isOutOfCapacityBlocked bool
  // Whether sessions are blocked when the server certificate is expired
  //
  // Forward-proxy profiles only; null for inbound-inspection profiles.
  isExpiredCertificateBlocked bool
  // Whether sessions are blocked when the server certificate is issued by an untrusted certificate authority
  //
  // Forward-proxy profiles only; null for inbound-inspection profiles.
  isUntrustedIssuerBlocked bool
  // Whether sessions are blocked when the certificate revocation status check times out
  //
  // Forward-proxy profiles only; null for inbound-inspection profiles.
  isRevocationStatusTimeoutBlocked bool
  // Whether sessions are blocked when the certificate revocation status is unknown
  //
  // Forward-proxy profiles only; null for inbound-inspection profiles.
  isUnknownRevocationStatusBlocked bool
  // Whether sessions are blocked when the server certificate uses restricted extensions
  //
  // Blocks certificates using extensions other than key usage and
  // extended key usage. Forward-proxy profiles only; null for
  // inbound-inspection profiles.
  areCertificateExtensionsRestricted bool
  // Whether a Subject Alternative Name is appended to the impersonating certificate when the server certificate is missing one
  //
  // Forward-proxy profiles only; null for inbound-inspection profiles.
  isAutoIncludeAltName bool
}

// Oracle Cloud Infrastructure (OCI) Container Engine for Kubernetes
//
// Managed Kubernetes deployments in the tenancy. The `clusters` field
// enumerates every OKE cluster, each surfacing the Kubernetes version,
// cluster type (BASIC_CLUSTER or ENHANCED_CLUSTER), the VCN it is
// deployed in, the KMS key used for secret encryption, the
// public/private API endpoint configuration, image-policy
// verification, the available upgrade versions, the legacy Pod
// Security Policy admission setting, and the node pools running
// workloads inside the cluster.
oci.oke {
  // OKE clusters
  clusters() []oci.oke.cluster
}

// Oracle Cloud Infrastructure (OCI) OKE cluster
//
// Managed Kubernetes cluster and its control-plane security posture:
// the Kubernetes version and cluster type, the VCN it runs in, the KMS
// key protecting Kubernetes secrets, whether the API server endpoint
// is publicly reachable, whether image signature verification is
// enforced, and whether the deprecated Pod Security Policy admission
// controller is still enabled. Worker nodes running inside the cluster
// are reached through nodePools.
private oci.oke.cluster @defaults("name") {
  // Cluster OCID
  id string
  // Cluster name
  name string
  // Compartment containing the cluster
  compartment() oci.compartment
  // Kubernetes version
  kubernetesVersion string
  // Cluster type (BASIC_CLUSTER, ENHANCED_CLUSTER)
  type string
  // VCN the cluster is deployed in
  vcn() oci.network.vcn
  // KMS key for secret encryption
  kmsKey() oci.kms.key
  // Whether the Kubernetes API endpoint is publicly accessible
  isPublicEndpointEnabled bool
  // Public API endpoint URL
  publicEndpoint string
  // Private API endpoint URL
  privateEndpoint string
  // Whether image signature verification policy is enabled
  isImagePolicyEnabled bool
  // Keys whose signatures the image policy accepts
  //
  // Empty when isImagePolicyEnabled is false, and also when the policy is on
  // but names no key, which admits every image.
  imagePolicyKmsKeys() []oci.kms.key
  // Available Kubernetes version upgrades
  availableKubernetesUpgrades []string
  // Whether Pod Security Policy admission controller is enabled
  isPodSecurityPolicyEnabled bool
  // Whether the Kubernetes Dashboard add-on is deployed
  //
  // The dashboard is a cluster-wide administrative console; where it is
  // reachable it becomes a route to the cluster that does not pass through
  // kubectl authentication.
  isKubernetesDashboardEnabled bool
  // Whether the Tiller add-on is deployed
  //
  // Tiller is the Helm 2 in-cluster component. It runs with broad cluster
  // permissions and is unsupported upstream.
  isTillerEnabled bool
  // CIDR block pods are addressed from
  //
  // Empty on a cluster using native VCN pod networking, where pods take
  // addresses from the subnets rather than from an overlay range.
  podsCidr string
  // CIDR block Kubernetes services are addressed from
  servicesCidr string
  // IP address families the cluster serves (IPv4, IPv6)
  ipFamilies []string
  // Pod networking types available on the cluster
  //
  // Each entry is OCI_VCN_IP_NATIVE, where pods take VCN addresses and are
  // governed by network security groups directly, or FLANNEL_OVERLAY, where
  // pod traffic is tunnelled and invisible to VCN rules.
  podNetworkTypes []string
  // Subnets the cluster provisions service load balancers into
  serviceLbSubnets() []oci.network.subnet
  // Subnet hosting the Kubernetes API endpoint
  //
  // Null on a cluster that predates native VCN endpoint configuration.
  endpointSubnet() oci.network.subnet
  // Network security groups applied to the Kubernetes API endpoint
  //
  // Empty when no group is attached, in which case the endpoint is governed
  // only by its subnet's security lists.
  endpointSecurityGroups() []oci.network.networkSecurityGroup
  // Whether the API server accepts OpenID Connect tokens
  //
  // When enabled, an external identity provider can mint tokens the cluster
  // accepts, so cluster access is no longer bounded by OCI IAM alone.
  isOpenIdConnectAuthEnabled bool
  // Issuer URL the API server accepts OpenID Connect tokens from
  openIdConnectIssuerUrl string
  // Client identifier the API server requires in OpenID Connect tokens
  openIdConnectClientId string
  // Token claim the API server reads the username from
  openIdConnectUsernameClaim string
  // Token claim the API server reads group membership from
  //
  // Group membership drives role binding, so the claim named here decides
  // which cluster roles a federated user receives.
  openIdConnectGroupsClaim string
  // Signing algorithms the API server accepts on OpenID Connect tokens
  openIdConnectSigningAlgorithms []string
  // Discovery endpoint serving the cluster's own OpenID Connect metadata
  //
  // Used by workloads federating to OCI with a service account token. Empty
  // when the cluster publishes no discovery document.
  openIdConnectDiscoveryEndpoint() string
  // Lifecycle state (e.g., CREATING, ACTIVE, FAILED, DELETING, DELETED, UPDATING)
  state string
  // Detail behind the lifecycle state
  //
  // Empty on a healthy cluster.
  lifecycleDetails string
  // User that created the cluster
  //
  // Null when the cluster was created by a principal that is not an IAM user,
  // for example an instance principal or a federated identity.
  createdByUser() oci.identity.user
  // Last time the cluster was updated
  timeUpdated time
  // Expiry of the cluster's own credentials
  //
  // The point at which the control plane certificates the cluster issued to
  // itself stop being valid. Null when the cluster reports no expiry.
  timeCredentialExpiration time
  // Node pools in the cluster
  nodePools() []oci.oke.nodePool
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
  // Zero Trust Packet Routing security attributes on the cluster API endpoint
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits.
  securityAttributes @maturity("deprecated") @replaced_by("oci.oke.cluster.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
}

// Oracle Cloud Infrastructure (OCI) OKE node pool
//
// Group of worker nodes within an OKE cluster, sharing a compute
// shape, node image, and Kubernetes version. Covers the network
// placement of the nodes (subnets and attached network security
// groups) and the SSH public key provisioned onto them, which should
// be empty so nodes are not directly reachable by operators.
private oci.oke.nodePool @defaults("name") {
  // Node pool OCID
  id string
  // Node pool name
  name string
  // Compartment containing the node pool
  compartment() oci.compartment
  // Kubernetes version on nodes
  kubernetesVersion string
  // Compute shape for nodes
  nodeShape string
  // Cluster this node pool belongs to
  cluster() oci.oke.cluster
  // Node shape configuration
  //
  // Deprecated in favor of nodeSizing, which reports the same allocation as a
  // structure. Compute sizing applied to each node when the shape is flexible.
  nodeShapeConfig @maturity("deprecated") @replaced_by("oci.oke.nodePool.nodeSizing") dict
  // Compute and memory allocation of each node in the pool
  //
  // Null on a node pool whose shape is not flexible, where the shape name
  // alone fixes the sizing.
  nodeSizing() oci.oke.nodeSizing
  // Image the nodes boot from
  //
  // Resolved from the node pool's node source, so it is populated on node
  // pools provisioned by current tooling. Null when the node pool boots from
  // a source that is not an image.
  nodeImage() oci.compute.image
  // Boot volume size in GB for each node
  //
  // Null when the node pool does not override the image's default size.
  bootVolumeSizeInGBs int
  // SSH public key on nodes (should be empty for security)
  sshPublicKey string
  // Subnets where Kubernetes nodes are placed (per-placement-config on newer node pools; node-pool-level fallback on older ones)
  subnets() []oci.network.subnet
  // Network Security Groups attached to the node VNICs (empty when nodes are governed only by subnet security lists)
  networkSecurityGroups() []oci.network.networkSecurityGroup
  // Number of nodes the pool maintains
  size int
  // Whether traffic between the nodes and their block volumes is encrypted
  //
  // Without it, volume traffic crosses the network in the clear even though
  // the volume itself is encrypted at rest.
  isPvEncryptionInTransitEnabled bool
  // Key encrypting the node boot and block volumes
  //
  // Null when the nodes use Oracle-managed encryption rather than a key from
  // the tenancy's vault.
  nodeKmsKey() oci.kms.key
  // Labels applied to every node as it joins the cluster
  //
  // Workloads select nodes by these, so a label here is what places a pod on
  // this pool.
  initialNodeLabels map[string]string
  // Grace period before a node being removed is force-drained
  //
  // An ISO 8601 duration, for example PT60M. Empty when the pool leaves the
  // service default in place.
  evictionGraceDuration string
  // Whether a node is deleted once its grace period expires even if pods remain
  isForceDeleteAfterGraceDuration bool
  // Whether the pool replaces its nodes in place when its configuration changes
  //
  // Node cycling is how a pool picks up a new Kubernetes version or a patched
  // image without being recreated. Where it is off, nodes keep running the
  // image they launched with.
  isNodeCyclingEnabled bool
  // Nodes the pool may take out of service at once while cycling
  //
  // A count or a percentage, for example `1` or `25%`.
  cyclingMaximumUnavailable string
  // Extra nodes the pool may add above its size while cycling
  //
  // A count or a percentage, for example `1` or `25%`.
  cyclingMaximumSurge string
  // Lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED, NEEDS_ATTENTION)
  state string
  // Detail behind the lifecycle state
  //
  // Empty on a healthy node pool.
  lifecycleDetails string
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Node sizing of an OKE node pool
//
// Compute and memory allocated to each node in the pool. Present only where
// the pool runs a flexible shape; a fixed shape fixes the sizing by name and
// reports nothing here.
private oci.oke.nodeSizing @defaults("ocpus memoryInGBs") {
  // OCPUs available to each node in the pool
  ocpus float
  // Memory available to each node in the pool, in gigabytes
  memoryInGBs float
}


// Oracle Cloud Infrastructure (OCI) Web Application Firewall
//
// L7 web-application firewall deployments in the tenancy. The
// `firewalls` field lists every WAF instance with the load balancer
// it fronts and the attached `policy`, and `policies` lists the
// reusable rule sets that drive request-rate limiting, signature
// inspection, IP allow/deny lists, and bot management.
oci.waf {
  // Web Application Firewalls
  firewalls() []oci.waf.firewall
  // Web Application Firewall policies
  policies() []oci.waf.policy
}

// Oracle Cloud Infrastructure (OCI) Web Application Firewall
private oci.waf.firewall @defaults("name") {
  // WAF OCID
  id string
  // Display name
  name string
  // Compartment containing the firewall
  compartment() oci.compartment
  // WAF policy attached to this firewall
  policy() oci.waf.policy
  // Load balancer this WAF is attached to
  loadBalancer() oci.loadBalancer.loadBalancer
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Web Application Firewall policy
private oci.waf.policy @defaults("name") {
  // WAF policy OCID
  id string
  // Display name
  name string
  // Compartment containing the policy
  compartment() oci.compartment
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Functions
//
// Serverless functions across the tenancy, organized into function
// applications. Each application in `applications` sets the shape,
// subnet placement, network security groups, environment
// configuration, syslog destination, and image-signature
// verification, and holds the `functions` that run under it with
// their image, memory, timeout, invoke endpoint, and tracing
// settings.
oci.functions {
  // Function applications
  applications() []oci.functions.application
}

// Oracle Cloud Infrastructure (OCI) Functions application
//
// Function application grouping related serverless functions under a
// shared shape, subnet placement, network security groups, and
// environment configuration. The application is the security and
// networking boundary for OCI Functions: `imagePolicyConfig` controls
// whether function images must pass signature verification, `subnets`
// and `networkSecurityGroups` place function invocations on the
// network, and `syslogUrl` routes function logs to an external
// collector.
private oci.functions.application @defaults("name") {
  // Application OCID
  id string
  // Application display name
  name string
  // Compartment containing the application
  compartment() oci.compartment
  // Lifecycle state (CREATING, ACTIVE, INACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Application shape (GENERIC_X86, GENERIC_ARM, GENERIC_X86_ARM)
  shape string
  // Distributed tracing configuration
  //
  // Deprecated in favor of tracing, which reports the same settings as a
  // structure. Application Performance Monitoring (APM) trace settings, with
  // keys `isEnabled` and `domainId`.
  traceConfig @maturity("deprecated") @replaced_by("oci.functions.application.tracing") dict
  // Distributed tracing settings of the application
  //
  // Null when the application reports no trace configuration.
  tracing() oci.functions.applicationTraceConfig
  // Image signature verification policy
  //
  // Deprecated in favor of imagePolicyEnabled and imagePolicyKeys, which carry
  // the two values this dict holds. Signed-image enforcement for the
  // application, with keys `isPolicyEnabled` and `keyDetails`.
  imagePolicyConfig @maturity("deprecated") dict
  // Signed-image enforcement for the application
  //
  // Null when the application reports no image policy configuration.
  imagePolicy() oci.functions.imagePolicyConfig
  // Application creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // Subnets where functions run
  subnets() []oci.network.subnet
  // Network Security Groups applied to the application
  networkSecurityGroups() []oci.network.networkSecurityGroup
  // Application environment configuration variables
  config() map[string]string
  // Syslog URL for logging (tcp://host:port)
  syslogUrl() string
  // Functions in this application
  functions() []oci.functions.function
}

// Distributed tracing settings of a Functions application
//
// Whether the application emits traces and which Application Performance
// Monitoring collector receives them. domainId stays an OCID because APM
// domains are not modelled in this provider.
private oci.functions.applicationTraceConfig @defaults("isEnabled") {
  // Whether distributed tracing is enabled for the application
  isEnabled bool
  // OCID of the collector traces are sent to
  //
  // Usually an Application Performance Monitoring domain. Empty when tracing
  // is off or no collector is configured.
  domainId string
}

// Image signature verification policy of a Functions application
//
// Whether functions in the application must run signed images, and the vault
// keys trusted to verify those signatures. Enforcement with no key configured
// leaves nothing to verify against, so both fields matter together.
private oci.functions.imagePolicyConfig @defaults("isPolicyEnabled") {
  // Whether functions in the application must use signed images
  //
  // When false any image the application can pull will run, so an image
  // substituted in the registry runs unchallenged.
  isPolicyEnabled bool
  // Vault keys trusted to verify image signatures
  //
  // Empty when verification is off, and also when it is on but no key is
  // configured.
  keys() []oci.kms.key
}


// Oracle Cloud Infrastructure (OCI) serverless function
//
// Single serverless function within an application, addressable by
// its `invokeEndpoint`. Each function pins the Docker `image` and
// `imageDigest` it runs, its `shape`, memory and timeout limits, and
// its tracing configuration, so you can audit which image a function
// executes and whether its resource limits and observability settings
// meet policy.
private oci.functions.function @defaults("name") {
  // Function OCID
  id string
  // Function display name
  name string
  // Compartment containing the function
  compartment() oci.compartment
  // Parent application OCID
  applicationId string
  // Lifecycle state (CREATING, ACTIVE, INACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Docker image URL for the function
  image string
  // Image digest (sha256)
  imageDigest string
  // Function shape (GENERIC_X86, GENERIC_ARM, GENERIC_X86_ARM)
  shape string
  // Maximum memory in MBs
  memoryInMBs int
  // Execution timeout in seconds
  timeoutInSeconds int
  // Base URL for function invocation
  invokeEndpoint string
  // Distributed tracing configuration
  //
  // Deprecated in favor of tracing, which reports the same setting as a
  // structure. Application Performance Monitoring (APM) trace settings, with
  // the single key `isEnabled`.
  traceConfig @maturity("deprecated") @replaced_by("oci.functions.function.tracing") dict
  // Distributed tracing settings of the function
  //
  // Null when the function reports no trace configuration.
  tracing() oci.functions.functionTraceConfig
  // Function creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // Function environment configuration variables
  config() map[string]string
}

// Distributed tracing settings of a function
//
// Whether the function emits traces. The collector is chosen on the
// application rather than per function, so this carries the single flag the
// service reports for a function.
private oci.functions.functionTraceConfig @defaults("isEnabled") {
  // Whether distributed tracing is enabled for the function
  isEnabled bool
}


// Oracle Cloud Infrastructure (OCI) Container Instances
//
// Serverless container deployments across the tenancy. Each container
// instance in `instances` surfaces its compute shape, CPU and memory
// allocation, fault domain, container restart policy, graceful shutdown
// timeout, lifecycle state, and the containers running inside it.
oci.containerInstances {
  // Container instances
  instances() []oci.containerInstances.instance
}

// Oracle Cloud Infrastructure (OCI) container instance (serverless container group)
//
// Serverless group of one or more containers that share a compute shape
// and lifecycle. The instance records its shape and OCPU/memory
// allocation, fault domain, container restart policy, graceful shutdown
// timeout, attached volume count, and lifecycle state, and lists the
// `containers` running inside it. Useful for auditing which serverless
// workloads run in a compartment and how they are sized and restarted.
private oci.containerInstances.instance @defaults("name") {
  // Container instance OCID
  id string
  // Display name
  name string
  // Compartment containing the instance
  compartment() oci.compartment
  // Availability domain
  availabilityDomain string
  // Lifecycle state (CREATING, ACTIVE, INACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Compute shape
  shape string
  // Shape allocation
  //
  // Deprecated in favor of sizing, which reports the same allocation as a
  // structure.
  shapeConfig @maturity("deprecated") @replaced_by("oci.containerInstances.instance.sizing") dict
  // Compute, memory and network allocation of the container instance
  //
  // Null when the instance reports no shape configuration.
  sizing() oci.containerInstances.shapeConfig
  // Number of containers
  containerCount int
  // Container restart policy (ALWAYS, NEVER, ON_FAILURE)
  containerRestartPolicy string
  // Fault domain
  faultDomain string
  // Graceful shutdown timeout in seconds
  gracefulShutdownTimeoutInSeconds int
  // Number of attached volumes
  volumeCount int
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
  // Containers running on this instance
  containers() []oci.containerInstances.container
}

// Resource allocation of a container instance
//
// Compute, memory and network the container instance is sized to. Every
// container it runs draws from this allocation, so it is the ceiling a
// per-container limit sits under.
private oci.containerInstances.shapeConfig @defaults("ocpus memoryInGBs") {
  // OCPUs available to the container instance
  ocpus float
  // Memory available to the container instance, in gigabytes
  memoryInGBs float
  // Short description of the container instance's processor
  processorDescription string
  // Networking bandwidth available to the container instance, in gigabits per second
  networkingBandwidthInGbps float
}


// Oracle Cloud Infrastructure (OCI) container within a container instance
//
// Single container running inside a container instance, identified by
// the image it runs (`imageUrl`), its CPU and memory limits, and whether
// it can reach OCI services through resource principal authentication
// (`isResourcePrincipalDisabled`). Useful for auditing the images
// deployed to serverless container workloads and the privileges granted
// to them.
private oci.containerInstances.container @defaults("name") {
  // Container OCID
  id string
  // Display name
  name string
  // Compartment containing the container
  compartment() oci.compartment
  // Availability domain
  availabilityDomain string
  // Lifecycle state (CREATING, ACTIVE, INACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Parent container instance OCID
  containerInstanceId string
  // Docker image URL
  imageUrl string
  // Whether resource principal access is disabled
  isResourcePrincipalDisabled bool
  // Resource limits
  //
  // Deprecated in favor of resourceLimits, which reports the same ceilings as
  // a structure. Absent when the container inherits the instance defaults.
  resourceConfig @maturity("deprecated") @replaced_by("oci.containerInstances.container.resourceLimits") dict
  // Ceilings on what the container's process may consume
  //
  // Null when the container declares no resource configuration, in which case
  // its process may use every CPU and all the memory on the instance.
  resourceLimits() oci.containerInstances.resourceConfig
  // UID the container process runs as
  //
  // Null when the container declares no security context, in which case the
  // effective user comes from the image. 0 means the process runs as root.
  runAsUser int
  // GID the container process runs as
  runAsGroup int
  // Whether the container is checked for running as a non-root user
  //
  // False also when the container declares no security context, since an
  // unchecked container is not protected either way.
  isNonRootUserCheckEnabled bool
  // Whether the container's root filesystem is mounted read-only
  isRootFileSystemReadonly bool
  // Linux capabilities added to the container beyond the default set
  //
  // Capabilities granted on top of the runtime default, for example
  // CAP_NET_ADMIN or CAP_SYS_ADMIN. A non-empty list widens what the container
  // can do on the host.
  addedCapabilities []string
  // Linux capabilities dropped from the container's default set
  droppedCapabilities []string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Resource limits of a container
//
// Ceilings on what one container's process may consume out of its instance's
// allocation. A limit left unset is not a limit of zero: the process may use
// every CPU and all the memory the instance has.
private oci.containerInstances.resourceConfig @defaults("vcpusLimit memoryLimitInGBs") {
  // Maximum vCPUs the container's process may consume
  //
  // Fractional, and expressed in logical CPUs, so an E3 container instance
  // with one OCPU tops out at 2.0. Null when the container declares no limit.
  vcpusLimit float
  // Maximum memory the container's process may consume, in gigabytes
  //
  // Null when the container declares no limit.
  memoryLimitInGBs float
}


// Oracle Cloud Infrastructure (OCI) Database
//
// Database deployments and their backups across the tenancy. The
// dbSystems field lists VM and bare-metal Oracle Database systems
// (Oracle Database on virtual machines or bare metal),
// autonomousDatabases lists serverless and dedicated Autonomous
// Database instances, backups lists the manual and automatic backups
// taken from VM/BM databases, and autonomousDatabaseBackups lists
// backups belonging to Autonomous Databases. Each backup surfaces
// TDE/KMS encryption, retention, destination type, and lifecycle
// state, making this the entry point for auditing database
// encryption and recovery posture.
oci.database {
  // Database systems (VM/BM)
  dbSystems() []oci.database.dbSystem
  // Autonomous databases
  autonomousDatabases() []oci.database.autonomousDatabase
  // Database backups (VM/BM database backups across all regions)
  backups() []oci.database.backup
  // Autonomous database backups across all regions
  autonomousDatabaseBackups() []oci.database.autonomousDatabaseBackup
}

// Management and user interface URLs for an Autonomous Database
//
// The web consoles an Autonomous Database publishes, one field per interface.
// Each is a full URL a browser can open, so a populated set on the public
// endpoint means those consoles answer requests from the internet and their
// only remaining control is the credentials they ask for.
private oci.database.autonomousDatabase.consoleUrls @defaults("sqlDevWebUrl apexUrl ordsUrl") {
  // Oracle SQL Developer Web URL
  //
  // A browser-based SQL client with full query access to the database.
  sqlDevWebUrl string
  // Oracle Application Express (APEX) URL
  apexUrl string
  // Oracle Machine Learning user management URL
  //
  // Manages the accounts that may use Oracle Machine Learning against the
  // database.
  machineLearningUserManagementUrl string
  // Graph Studio URL
  graphStudioUrl string
  // MongoDB API URL
  mongoDbUrl string
  // Oracle Machine Learning notebook URL
  machineLearningNotebookUrl string
  // Oracle REST Data Services (ORDS) web access URL
  //
  // The entry point through which the database's REST-enabled objects are
  // reachable over HTTP.
  ordsUrl string
  // Database Transforms URL
  databaseTransformsUrl string
  // Spatial Studio URL
  spatialStudioUrl string
}

// Oracle Cloud Infrastructure (OCI) database backup (for VM/BM databases)
private oci.database.backup @defaults("name") {
  // Backup OCID
  id string
  // Backup display name
  name string
  // Compartment containing the backup
  compartment() oci.compartment
  // OCID of the source database (not the DB system)
  databaseId string
  // Availability domain where the backup is stored
  availabilityDomain string
  // Backup type (INCREMENTAL, FULL, VIRTUAL_FULL)
  type string
  // Backup destination (OBJECT_STORE, DBRS, AWS_S3)
  backupDestinationType string
  // Size of the source database at backup time, in GBs
  databaseSizeInGBs float
  // Database edition
  //
  // One of: STANDARD_EDITION, ENTERPRISE_EDITION, ENTERPRISE_EDITION_HIGH_PERFORMANCE, ENTERPRISE_EDITION_EXTREME_PERFORMANCE, ENTERPRISE_EDITION_DEVELOPER.
  databaseEdition string
  // Database version used by the source database
  version string
  // Shape of the source database
  shape string
  // KMS key used for TDE encryption of the backup
  kmsKey() oci.kms.key
  // KMS vault used for TDE encryption
  kmsVault() oci.kms.vault
  // Whether Oracle Managed Keys is required to restore the backup
  isUsingOracleManagedKeys bool
  // Retention period in days (long-term backups only)
  retentionPeriodInDays int
  // Retention period in years (long-term backups only)
  retentionPeriodInYears int
  // Scheduled expiration time for long-term backups
  timeExpiryScheduled time
  // Lifecycle state (e.g., CREATING, ACTIVE, DELETING, DELETED, FAILED, RESTORING, UPDATING, CANCELING, CANCELED)
  state string
  // Backup start time
  timeStarted time
  // Backup end time
  timeEnded time
}

// Oracle Cloud Infrastructure (OCI) autonomous database backup
private oci.database.autonomousDatabaseBackup @defaults("name") {
  // Backup OCID
  id string
  // Backup display name
  name string
  // Compartment containing the autonomous database backup
  compartment() oci.compartment
  // Autonomous database the backup belongs to
  autonomousDatabase() oci.database.autonomousDatabase
  // Backup type (INCREMENTAL, FULL, LONGTERM, VIRTUAL_FULL, CUMULATIVE_INCREMENTAL, ROLL_FORWARD_IMAGE_COPY)
  type string
  // Whether the backup was created automatically
  isAutomatic bool
  // Whether the backup can be used to restore the source database
  isRestorable bool
  // Retention period in days (long-term backups only)
  retentionPeriodInDays int
  // Timestamp until when the backup will be available
  timeAvailableTill time
  // Size of the database at backup time, in TBs
  databaseSizeInTBs float
  // Backup size in TBs
  sizeInTBs float
  // Autonomous database version
  dbVersion string
  // Infrastructure type (CLOUD, CLOUD_AT_CUSTOMER)
  infrastructureType string
  // KMS key used for encryption
  kmsKey() oci.kms.key
  // KMS vault used for encryption
  kmsVault() oci.kms.vault
  // Lifecycle state (e.g., CREATING, ACTIVE, DELETING, DELETED, FAILED, UPDATING)
  state string
  // Backup start time
  timeStarted time
  // Backup end time
  timeEnded time
}

// Oracle Cloud Infrastructure (OCI) database system (VM/BM)
private oci.database.dbSystem @defaults("name") {
  // DB system OCID
  id string
  // Display name
  name string
  // Compartment containing the db system
  compartment() oci.compartment
  // Availability domain
  availabilityDomain string
  // Compute shape
  shape string
  // Database edition
  //
  // One of STANDARD_EDITION, ENTERPRISE_EDITION, ENTERPRISE_EDITION_HIGH_PERFORMANCE, ENTERPRISE_EDITION_EXTREME_PERFORMANCE, or ENTERPRISE_EDITION_DEVELOPER.
  databaseEdition string
  // Disk redundancy (HIGH, NORMAL)
  diskRedundancy string
  // Hostname of the database system
  hostname string
  // DNS domain name configured on the database system
  domain string
  // Database listener port (e.g., 1521)
  listenerPort int
  // Single Client Access Name (SCAN) DNS name for the database system
  scanDnsName string
  // Source DB system this DB system was created from, when created from another DB system
  sourceDbSystem() oci.database.dbSystem
  // Oracle Database version
  version string
  // Number of CPU cores
  cpuCoreCount int
  // Number of nodes
  nodeCount int
  // Data storage size in GBs
  dataStorageSizeInGBs int
  // License model (LICENSE_INCLUDED, BRING_YOUR_OWN_LICENSE)
  licenseModel string
  // KMS key for encryption
  kmsKey() oci.kms.key
  // Subnet the DB system is in
  subnet() oci.network.subnet
  // Network Security Groups attached to the DB system
  securityGroups() []oci.network.networkSecurityGroup
  // Network Security Groups attached to the backup network
  backupSecurityGroups() []oci.network.networkSecurityGroup
  // Subnet carrying the DB system's backup traffic
  //
  // Null when the DB system runs a single network rather than separating
  // backup traffic onto its own subnet.
  backupSubnet() oci.network.subnet
  // Public keys authorized to sign in to the DB system hosts over SSH
  //
  // Every key here reaches the database hosts directly, outside the database
  // authentication that governs the data. Empty when no key was supplied at
  // launch.
  sshPublicKeys []string
  // Fault domains the DB system nodes are placed across
  faultDomains []string
  // Operating system version on the DB system hosts
  osVersion string
  // Time zone configured on the DB system
  timeZone string
  // Cluster name for an Exadata or RAC DB system
  //
  // Empty on a single-node DB system.
  clusterName string
  // How storage is managed (ASM, LVM)
  //
  // Empty when the DB system reports no storage management option.
  storageManagement string
  // Whether Oracle collects diagnostic events from the DB system
  isDiagnosticsEventsEnabled bool
  // Whether Oracle collects health metrics from the DB system
  isHealthMonitoringEnabled bool
  // Whether Oracle collects incident logs and trace files from the DB system
  //
  // Incident logs can carry query text and payload fragments, so enabling
  // collection sends database content to Oracle support tooling.
  isIncidentLogsEnabled bool
  // Zero Trust Packet Routing security attributes applied to the DB system
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits. Each key is a security attribute namespace and
  // each value maps that namespace's attribute names to this DB system's
  // values.
  securityAttributes @maturity("deprecated") @replaced_by("oci.database.dbSystem.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
  // Patching and maintenance schedule
  //
  // Deprecated in favor of maintenanceSchedule, which reports the same window
  // as a structure. Keyed by `preference` (NO_PREFERENCE or
  // CUSTOM_PREFERENCE), `patchingMode` (ROLLING or NONROLLING),
  // `isMonthlyPatchingEnabled`, `isCustomActionTimeoutEnabled` with its
  // `customActionTimeoutInMins`, `leadTimeInWeeks`, `skipRu`, and the
  // `months`, `weeksOfMonth`, `daysOfWeek`, and `hoursOfDay` that schedule the
  // window.
  maintenanceWindow @maturity("deprecated") @replaced_by("oci.database.dbSystem.maintenanceSchedule") dict
  // When Oracle may patch the system, and how
  //
  // Null when the system has no maintenance window configured, which is a
  // different fact from a window scheduled for no months and no days.
  maintenanceSchedule() oci.database.maintenanceWindow
  // Lifecycle state
  //
  // For example: PROVISIONING, AVAILABLE, UPDATING, TERMINATING, TERMINATED, FAILED, MIGRATED, MAINTENANCE_IN_PROGRESS, NEEDS_ATTENTION, UPGRADING.
  state string
  // Detail behind the lifecycle state
  //
  // Empty on a healthy DB system.
  lifecycleDetails string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Maintenance window of a database system
//
// When Oracle may patch the system and how. preference separates a window
// Oracle chooses from one pinned to the months, weeks, days and hours listed
// here, and patchingMode is what says whether patching takes the system down:
// NONROLLING involves an outage where ROLLING does not.
private oci.database.maintenanceWindow @defaults("preference patchingMode") {
  // How the maintenance window is scheduled
  //
  // NO_PREFERENCE lets Oracle choose the window, CUSTOM_PREFERENCE pins it to
  // the months, weeks, days and hours listed here.
  preference string
  // How infrastructure nodes are patched
  //
  // ROLLING patches nodes one at a time, NONROLLING takes the system down for
  // the duration.
  patchingMode string
  // Whether a custom wait between database server patching operations is configured
  isCustomActionTimeoutEnabled bool
  // Minutes the system waits before each database server patching operation
  //
  // Between 15 and 120 when set. Null when no custom action timeout is
  // configured.
  customActionTimeoutInMins int
  // Whether monthly patching is enabled
  isMonthlyPatchingEnabled bool
  // Months during the year maintenance may run in
  //
  // Empty when the preference is NO_PREFERENCE, where Oracle chooses.
  months []string
  // Weeks within the month maintenance may run in
  //
  // Weeks start on the 1st, 8th, 15th and 22nd, so 2 means the 8th to the
  // 14th. Empty when the preference is NO_PREFERENCE.
  weeksOfMonth []int
  // Days of the week maintenance may run on
  //
  // Empty when the preference is NO_PREFERENCE.
  daysOfWeek []string
  // Four-hour slots maintenance may start in, as the hour the slot opens
  //
  // 0, 4, 8, 12, 16, or 20, each covering the four hours from that hour in
  // UTC. Empty when the preference is NO_PREFERENCE.
  hoursOfDay []int
  // Weeks of notice before a maintenance window opens
  //
  // Between 1 and 4 when set. Null when no lead time is configured.
  leadTimeInWeeks int
  // Whether a quarterly release update is skipped
  //
  // One entry per quarter the system is set to skip. Two consecutive quarters
  // cannot be skipped, so a system carrying entries here is at most one
  // release update behind by request.
  skipRu []bool
}


// Oracle Cloud Infrastructure (OCI) autonomous database
private oci.database.autonomousDatabase @defaults("name") {
  // Autonomous database OCID
  id string
  // Display name
  name string
  // Compartment containing the autonomous database
  compartment() oci.compartment
  // Database name
  dbName string
  // Source Autonomous Database this database was provisioned or cloned from, when set
  sourceDatabase() oci.database.autonomousDatabase
  // Whether this database is a refreshable clone of another Autonomous Database
  isRefreshableClone bool
  // Database version
  dbVersion string
  // Database workload type (OLTP, DW, AJD, APEX, LH)
  dbWorkload string
  // Whether this is a dedicated Exadata infrastructure
  isDedicated bool
  // Whether this is a free-tier database
  isFreeTier bool
  // Number of CPU cores
  cpuCoreCount int
  // Data storage size in TBs
  dataStorageSizeInTBs int
  // Whether mTLS connection is required
  isMtlsConnectionRequired bool
  // Whether access control is enabled
  isAccessControlEnabled bool
  // Allowed client IP addresses (ACL)
  whitelistedIps []string
  // Whether the database is reachable from the public internet
  //
  // True when the database has a public endpoint (no private endpoint) and
  // either access control is disabled or its allow-list admits any address
  // (0.0.0.0/0 or 0.0.0.0). mTLS may still be required to connect, but the
  // listener itself is reachable from the internet.
  internetReachable() bool
  // Allowed client IP addresses for the Data Guard standby (ACL)
  //
  // The standby's own access control list. When it diverges from
  // whitelistedIps the standby may be reachable from networks the primary
  // blocks, so compare the two when auditing disaster-recovery exposure.
  standbyWhitelistedIps []string
  // Whether auto-scaling is enabled
  isAutoScalingEnabled bool
  // Whether local Data Guard is enabled
  isLocalDataGuardEnabled bool
  // Whether cross-region (remote) Autonomous Data Guard is enabled
  isRemoteDataGuardEnabled bool
  // Whether Autonomous Data Guard is enabled for the database
  isDataGuardEnabled bool
  // Retention period in days for long-term backups
  backupRetentionPeriodInDays int
  // Whether backup retention is locked
  //
  // When true, backups cannot be deleted before their retention period
  // elapses, protecting recovery points against tampering or premature
  // deletion.
  isBackupRetentionLocked bool
  // How often a long-term backup is taken
  //
  // One of ONE_TIME, WEEKLY, MONTHLY, or YEARLY. Null when no long-term
  // backup schedule is configured, in which case the database keeps only
  // the automatic backups covered by backupRetentionPeriodInDays.
  longTermBackupRepeatCadence string
  // Time the long-term backup schedule takes its backup
  //
  // For a MONTHLY cadence, a month with fewer days than the configured
  // date takes the backup on its last day. Null when no long-term backup
  // schedule is configured.
  longTermBackupTimeOfBackup time
  // Days a long-term backup is kept for
  //
  // Separate from backupRetentionPeriodInDays, which governs the
  // automatic backups. Null when no long-term backup schedule is
  // configured.
  longTermBackupRetentionPeriodInDays int
  // Whether the long-term backup schedule is marked for deletion
  //
  // True when a schedule exists but is disabled, so no long-term backup
  // will be taken from it. Null when no schedule is configured at all,
  // which is a different state from a schedule that was switched off.
  longTermBackupScheduleDisabled bool
  // Time the next long-term backup is due
  //
  // Null when no long-term backup schedule is configured, or when a
  // ONE_TIME schedule has already run.
  nextLongTermBackupTimestamp time
  // Day of the week the scheduled maintenance window opens on
  //
  // One of MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, or SUNDAY.
  // Null when the database has no scheduled maintenance window, in which case
  // Oracle chooses when to patch it.
  maintenanceDayOfWeek string
  // Time of day the scheduled maintenance window opens, in ISO-8601 `hh:mm` form
  //
  // Null when the database has no scheduled maintenance window, or when the
  // window fixes only the day and leaves the hour to Oracle.
  maintenanceStartTime string
  // Time of day the scheduled maintenance window closes, in ISO-8601 `hh:mm` form
  //
  // With maintenanceStartTime this bounds the span in which the database may be
  // patched and restarted. Null when the database has no scheduled maintenance
  // window, or when the window sets no end time.
  maintenanceEndTime string
  // Availability domain the scheduled maintenance runs in
  //
  // Null when the database has no scheduled maintenance window, or when the
  // window is not pinned to a single availability domain.
  maintenanceAvailabilityDomain string
  // Whether a change to the maintenance window is pending
  //
  // True when a request to move the window has been accepted but has not taken
