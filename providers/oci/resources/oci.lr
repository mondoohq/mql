// Oracle Cloud Infrastructure (OCI) Compute
//
// Compute and block-storage inventory for the tenancy. The `instances`
// collection covers virtual machine and bare-metal instances with their
// shape, source image, networking, metadata, agent configuration, and
// internet exposure. The `images` collection lists Oracle-provided and
// custom images available for launch, `blockVolumes` lists managed block
// storage volumes, and `bootVolumes` lists the boot volumes attached to
// instances. Use these to audit instance security posture, encryption, and
// storage across compartments.
oci.compute {
  // Compute instances
  instances() []oci.compute.instance
  // Compute images
  images() []oci.compute.image
  // Block volumes
  blockVolumes() []oci.compute.blockVolume
  // Boot volumes
  bootVolumes() []oci.compute.bootVolume
}

// OCI network internet-exposure breakdown
//
// Explains whether a resource is reachable from the internet by combining its
// public-IP assignment with the network security group ingress rules (and, for
// compute, the subnet's internet-ingress policy) that admit traffic from any
// address. Shared by compute instances and load balancers.
private oci.network.exposure @defaults("internetReachable hasPublicIp") {
  // Whether the resource is reachable from the internet
  //
  // True when the resource has a public IP, sits on a subnet that permits
  // internet ingress and routes a default route to an enabled internet gateway,
  // and an ingress rule (in an attached network security group or the subnet's
  // security list) admits traffic from any address.
  internetReachable bool
  // Whether the resource has a public IP
  hasPublicIp bool
  // Whether an attached network security group admits inbound traffic from any address
  //
  // True also when no NSG is attached (OCI's default open posture). For compute,
  // the subnet's internet-ingress policy is applied only to internetReachable,
  // not here.
  securityGroupAllowsIngress bool
  // Whether the subnet's security list admits inbound traffic from any address
  //
  // True also when no security list is resolvable, matching the network
  // security group default. OCI evaluates the union of security list and NSG
  // rules, so either layer admitting any address opens ingress.
  securityListAllowsIngress bool
  // Whether the subnet routes a default route (0.0.0.0/0 or ::/0) to an enabled internet gateway
  //
  // A public IP alone does not make a resource internet-reachable in OCI; the
  // subnet's route table must also forward internet-bound traffic to an internet
  // gateway. False when the only default route targets a NAT gateway, a DRG, or
  // nothing.
  hasRouteToInternet bool
  // Ingress rules that admit traffic from any address (0.0.0.0/0 or ::/0)
  //
  // Deprecated in favor of internetIngressRules, which returns the same rules
  // as security rule resources with one shape for both sources. The two rule
  // sources spell the stateless flag differently in this dict: network
  // security group rules carry `isStateless` while security list rules carry
  // `stateless`, so a filter naming either one silently misses half the rows.
  // Each entry: {source, sourceType, protocol (IANA number, e.g. "6"=TCP,
  // "17"=UDP, "1"=ICMP), description, tcpOptions, udpOptions, icmpOptions}.
  openIngressRules @maturity("deprecated") @replaced_by("oci.network.exposure.internetIngressRules") []dict
  // Ingress rules that admit traffic from any address (0.0.0.0/0 or ::/0)
  //
  // The matching rules from every attached network security group and from the
  // subnet's security list, combined into one list. Both sources are returned
  // in the same shape, so `stateless`, the port bounds and the ICMP type and
  // code can be read across all of them without knowing which layer a rule
  // came from.
  internetIngressRules []oci.network.securityRule
  // Security attributes carried by the resource, keyed by namespace
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits. Each key is a security attribute namespace and
  // each value maps that namespace's attribute names to the resource's values.
  securityAttributes @maturity("deprecated") @replaced_by("oci.network.exposure.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
  // Whether Zero Trust Packet Routing is enforcing on this resource
  //
  // True when ZPR is enabled for the tenancy and the resource carries at least
  // one security attribute from a namespace whose mode includes `enforce`.
  // A namespace in `audit` mode reports its decisions without acting on them,
  // so it does not make this true.
  //
  // ZPR sits above security lists and network security groups: where it
  // enforces, traffic the other layers admit can still be denied. The other
  // fields on this resource describe those layers only, so a resource can
  // report `internetReachable` while ZPR blocks the traffic in practice. Read
  // `internetReachable && !zprEnforced` when the question is whether an
  // opening is genuinely reachable.
  zprEnforced bool
  // Zero Trust Packet Routing policies in the tenancy
  //
  // The policies that could govern this resource. Whether any given policy
  // admits or denies its traffic depends on the Zero Trust Packet Routing
  // Policy Language statements it carries, which are returned as written.
  zprPolicies() []oci.zpr.policy
}

// Oracle Cloud Infrastructure (OCI) Compute instance
//
// Virtual machine or bare-metal Compute instance in the tenancy, keyed by
// its OCID. Surfaces the instance's shape and sizing, source image and boot
// volume, attached network interfaces, platform security settings, Oracle
// Cloud Agent plugin states, and a derived internet-exposure breakdown.
// Central to auditing instance hardening, metadata-service (IMDS)
// configuration, encryption, and internet reachability.
private oci.compute.instance @defaults("name") {
  // Instance OCID
  id string
  // Instance display name
  name string
  // Region where the instance is running
  region oci.region
  // Instance creation time
  created time
  // Instance lifecycle state (e.g., MOVING, PROVISIONING, RUNNING, STARTING, STOPPING, STOPPED, CREATING_IMAGE, TERMINATING, TERMINATED)
  state string
  // Compute shape determining CPU and memory (e.g., VM.Standard2.1)
  shape string
  // Availability domain where the instance is placed (e.g., Uocm:PHX-AD-1)
  availabilityDomain string
  // Compartment containing the instance
  compartment oci.compartment
  // Fault domain for fault tolerance (e.g., FAULT-DOMAIN-1)
  faultDomain string
  // Image used to launch the instance
  image() oci.compute.image
  // Dedicated VM host OCID if running on dedicated infrastructure
  dedicatedVmHostId string
  // Platform security configuration
  //
  // Deprecated in favor of platformSecurity, which reports the same settings
  // as a structure. Shielded-instance and confidential-computing settings.
  // Keys: `type` (the platform variant, for example AMD_VM, INTEL_VM, or
  // AMD_MILAN_BM), `isSecureBootEnabled`, `isTrustedPlatformModuleEnabled`,
  // `isMeasuredBootEnabled`, and `isMemoryEncryptionEnabled`. Absent when the
  // shape does not support these features.
  platformConfig @maturity("deprecated") @replaced_by("oci.compute.instance.platformSecurity") dict
  // Shielded-instance and confidential-computing settings
  //
  // Null when the instance carries no platform configuration, which is the
  // case on shapes that do not offer shielded-instance or
  // confidential-computing features.
  platformSecurity() oci.compute.platformSecurity
  // Launch configuration options
  //
  // Deprecated in favor of launchConfig, which reports the same settings as a
  // structure. Emulation and I/O settings chosen at launch. Keys:
  // `bootVolumeType` and `remoteDataVolumeType` (ISCSI, SCSI, IDE, VFIO, or
  // PARAVIRTUALIZED), `firmware` (BIOS or UEFI_64), `networkType` (E1000,
  // VFIO, PARAVIRTUALIZED, or ACCELERATEDPV),
  // `isPvEncryptionInTransitEnabled`, and `isConsistentVolumeNamingEnabled`.
  launchOptions @maturity("deprecated") @replaced_by("oci.compute.instance.launchConfig") dict
  // Emulation and I/O settings chosen at launch
  //
  // Null when the instance reports no launch options.
  launchConfig() oci.compute.launchConfig
  // Instance runtime options
  //
  // Deprecated in favor of legacyImdsEndpointsDisabled, which carries the
  // only value this dict holds. The single key
  // `areLegacyImdsEndpointsDisabled` reports whether the legacy instance
  // metadata service (IMDSv1) endpoints are turned off.
  instanceOptions @maturity("deprecated") @replaced_by("oci.compute.instance.legacyImdsEndpointsDisabled") dict
  // Whether legacy instance metadata service (IMDSv1) endpoints are disabled
  //
  // When true, only the more secure IMDSv2 (/v2) endpoints are reachable.
  // Defaults to false, meaning the legacy /v1 endpoints remain accessible and
  // any credentials they expose can be read without a signed request.
  legacyImdsEndpointsDisabled bool
  // Whether the Oracle Cloud Agent monitoring plugins are disabled
  //
  // When true, all monitoring plugins (Compute Instance Monitoring, Custom
  // Logs Monitoring) are off regardless of per-plugin configuration.
  monitoringDisabled bool
  // Whether the Oracle Cloud Agent management plugins are disabled
  //
  // When true, all management plugins (OS Management Service Agent, Compute
  // Instance Run Command) are off regardless of per-plugin configuration.
  managementDisabled bool
  // Whether all Oracle Cloud Agent plugins are disabled
  allPluginsDisabled bool
  // Oracle Cloud Agent plugin desired states keyed by plugin name
  //
  // Each value is the plugin's desired state, ENABLED or DISABLED — for
  // example "Vulnerability Scanning", "Bastion", or "OS Management Service
  // Agent". Use it to confirm required security agents are enabled.
  agentPlugins map[string]string
  // Shape configuration details
  //
  // Deprecated in favor of sizing, which reports the same allocation as a
  // structure. Keys: `ocpus`, `memoryInGBs`, `baselineOcpuUtilization`
  // (BASELINE_1_8, BASELINE_1_2, or BASELINE_1_1 for burstable shapes),
  // `networkingBandwidthInGbps`, `maxVnicAttachments`, `gpus` with
  // `gpuDescription`, `localDisks` with `localDisksTotalSizeInGBs`, and
  // `processorDescription`.
  shapeConfig @maturity("deprecated") @replaced_by("oci.compute.instance.sizing") dict
  // Compute, memory, network and local-disk allocation of the instance
  //
  // Null when the instance reports no shape configuration, which is the case
  // on fixed shapes where the shape name alone fixes the allocation.
  sizing() oci.compute.instanceSizing
  // Boot volume or image source details
  //
  // Deprecated in favor of bootSource and bootVolume, which together carry
  // everything this dict holds. The `sourceType` key discriminates the shape:
  // when "image", the keys are `imageId`, `bootVolumeSizeInGBs`,
  // `bootVolumeVpusPerGB`, and `kmsKeyId`; when "bootVolume", the single key
  // is `bootVolumeId`.
  sourceDetails @maturity("deprecated") dict
  // Boot volume the instance was launched from, when launched from an existing boot volume
  bootVolume() oci.compute.bootVolume
  // Image and boot volume the instance was created from at launch
  //
  // Null when the instance was launched from an existing boot volume, in
  // which case the volume was sized and keyed when it was created rather than
  // at launch, and bootVolume is what resolves it.
  bootSource() oci.compute.imageSource
  // Instance metadata key-value pairs
  metadata map[string]string
  // Nested instance metadata beyond the flat key-value pairs
  //
  // Values here may be objects or arrays rather than strings, and the key
  // names are not constrained, so this is where launch automation leaves
  // bootstrap configuration and, often, the credentials that configuration
  // needs. Anything readable from the instance metadata service is readable
  // by every process on the instance.
  extendedMetadata dict
  // iPXE script run before the boot volume is attached
  //
  // Replaces the default network boot chain when set, so it decides what the
  // instance boots and from where. Empty when the instance boots the default
  // chain.
  ipxeScript string
  // SSH public keys authorized for the instance
  //
  // One entry per key in the instance metadata `ssh_authorized_keys`
  // value. Each entry carries the key `algorithm` (for example ssh-rsa,
  // ecdsa-sha2-nistp256, ssh-ed25519), key size in `bits`, the raw
  // `publicKey`, and any trailing `comment`. Empty when no keys are set.
  sshAuthorizedKeys() []dict
  // Expected maintenance reboot time, if scheduled
  timeMaintenanceRebootDue time
  // Security attributes applied to the instance, keyed by namespace
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits. Each key is a security attribute namespace and
  // each value maps that namespace's attribute names to this instance's
  // values.
  securityAttributes @maturity("deprecated") @replaced_by("oci.compute.instance.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
  // Whether the instance's security attributes have finished applying
  //
  // STABLE once applied, UPDATING while a change is still propagating. During
  // an update the attributes reported here may not yet be the ones in force.
  securityAttributesState string
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
  // Virtual network interface cards attached to the instance
  vnics() []oci.compute.vnic
  // Internet-exposure breakdown (public IP combined with NSG ingress and the subnet's internet-ingress policy)
  exposure() oci.network.exposure
  // Most recent agent-based vulnerability scan result for this instance
  vulnerabilityScanResult() oci.vulnerabilityScanning.hostAgentScanResult
  // Most recent open-port scan result for this instance
  portScanResult() oci.vulnerabilityScanning.hostPortScanResult
  // Most recent CIS benchmark scan result for this instance
  cisBenchmarkScanResult() oci.vulnerabilityScanning.hostCisBenchmarkScanResult
  // Most recent endpoint protection scan result for this instance
  endpointProtectionScanResult() oci.vulnerabilityScanning.hostEndpointProtectionScanResult
}

// Shielded-instance and confidential-computing settings of a compute instance
//
// The platform security features an instance runs with: Secure Boot, the
// virtual Trusted Platform Module, Measured Boot, and memory encryption. Each
// flag is null when the platform variant does not report it, which keeps "not
// offered on this shape" apart from "offered and turned off".
private oci.compute.platformSecurity @defaults("secureBootEnabled measuredBootEnabled memoryEncryptionEnabled") {
  // Whether Secure Boot is enabled
  //
  // Secure Boot refuses to load any boot component the platform does not
  // trust, so a bootkit cannot survive a reboot.
  secureBootEnabled bool
  // Whether the Trusted Platform Module is enabled
  //
  // The vTPM holds the measurements Measured Boot records and the keys that
  // seal to them.
  trustedPlatformModuleEnabled bool
  // Whether Measured Boot is enabled
  //
  // Measured Boot records each boot component into the vTPM so a later
  // attestation can tell a tampered boot chain from a clean one.
  measuredBootEnabled bool
  // Whether memory encryption is enabled, making this a confidential instance
  //
  // Encrypts the instance's memory with a key the hypervisor cannot read, so
  // data in use is protected as well as data at rest.
  memoryEncryptionEnabled bool
}

// Launch configuration of a compute instance
//
// The emulation and I/O settings chosen when the instance was launched, and
// fixed for its lifetime. pvEncryptionInTransitEnabled decides whether traffic
// to paravirtualized block volumes is encrypted, and firmware decides whether
// the instance can run Secure Boot at all.
private oci.compute.launchConfig @defaults("firmware networkType pvEncryptionInTransitEnabled") {
  // Emulation type for the boot volume
  //
  // One of ISCSI, SCSI, IDE, VFIO, or PARAVIRTUALIZED.
  bootVolumeType string
  // Firmware the instance boots with
  //
  // BIOS or UEFI_64. Secure Boot requires UEFI_64, so a BIOS instance cannot
  // be running it whatever the platform security settings report.
  firmware string
  // Emulation type for the network interface card
  //
  // One of E1000, VFIO, PARAVIRTUALIZED, or ACCELERATEDPV.
  networkType string
  // Emulation type for remote data volumes
  //
  // One of ISCSI, SCSI, IDE, VFIO, or PARAVIRTUALIZED.
  remoteDataVolumeType string
  // Whether paravirtualized volume traffic is encrypted in transit
  //
  // When false the data moving between the instance and its paravirtualized
  // block volumes crosses the virtual network unencrypted.
  pvEncryptionInTransitEnabled bool
  // Whether consistent volume naming is enabled
  consistentVolumeNamingEnabled bool
}

// Resource allocation of a compute instance
//
// What a flexible shape was sized to: OCPUs and memory, the networking
// bandwidth and VNIC slots that come with them, and any GPUs or local NVMe
// disks attached. A field is null when the shape does not offer that resource,
// so an instance with no GPUs reports null rather than zero.
private oci.compute.instanceSizing @defaults("ocpus memoryInGBs") {
  // OCPUs available to the instance
  ocpus float
  // Memory available to the instance, in gigabytes
  memoryInGBs float
  // Baseline OCPU utilization for a burstable instance
  //
  // BASELINE_1_8, BASELINE_1_2, or BASELINE_1_1. Empty on a non-burstable
  // shape, where the instance always has its full OCPU allocation.
  baselineOcpuUtilization string
  // Short description of the instance's processor
  processorDescription string
  // Networking bandwidth available to the instance, in gigabits per second
  networkingBandwidthInGbps float
  // Maximum number of VNIC attachments the instance supports
  maxVnicAttachments int
  // Number of GPUs available to the instance
  gpus int
  // Short description of the instance's graphics processing unit
  //
  // Empty when the instance has no GPUs.
  gpuDescription string
  // Number of local disks available to the instance
  localDisks int
  // Aggregate size of all local disks, in gigabytes
  //
  // Null when the instance has no local disks.
  localDisksTotalSizeInGBs float
  // Short description of the local disks available to the instance
  //
  // Empty when the instance has no local disks.
  localDiskDescription string
  // Total number of vCPUs available to the instance
  //
  // Null on shapes sized in OCPUs alone.
  vcpus int
  // NVMe-backed local storage capacity, in gigabytes, on flexible dense shapes
  //
  // Null on every shape that is not a flexible dense (DenseLV) VM shape.
  localVolumeSizeInGBs int
}

// Image a compute instance was launched from, with the boot volume built for it
//
// Present only on an instance launched from an image, where the boot volume was
// created at launch and its size, performance tier and encryption key were
// chosen then. kmsKey is what says the boot volume is protected by a
// customer-managed key rather than an Oracle-managed one.
private oci.compute.imageSource @defaults("bootVolumeSizeInGBs bootVolumeVpusPerGB") {
  // Image the boot volume was created from
  image() oci.compute.image
  // Size of the boot volume created at launch, in gigabytes
  bootVolumeSizeInGBs int
  // Volume performance units per gigabyte applied to the boot volume created at launch
  //
  // 10 is the Balanced option, 20 Higher Performance, and 30 to 120 Ultra High
  // Performance.
  bootVolumeVpusPerGB int
  // Vault key protecting the boot volume created at launch
  //
  // Null when the boot volume is encrypted with an Oracle-managed key rather
  // than a customer-managed one.
  kmsKey() oci.kms.key
}

// Oracle Cloud Infrastructure (OCI) virtual network interface card (VNIC)
//
// Virtual network interface attached to a Compute instance, carrying its
// private and public IP addressing, MAC and hostname label, the subnet it
// lives in, and the network security groups applied to it. Use it to audit
// which interfaces hold public IPs and how instance traffic is filtered.
private oci.compute.vnic @defaults("name") {
  // VNIC OCID
  id string
  // VNIC display name
  name string
  // Compartment containing the VNIC
  compartment() oci.compartment
  // Whether this is the primary VNIC
