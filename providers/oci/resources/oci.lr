  // VCN the NAT gateway belongs to
  vcn() oci.network.vcn
  // Whether traffic is blocked through the gateway
  blockTraffic bool
  // The public IP address associated with the NAT gateway
  natIp string
  // Lifecycle state (e.g., PROVISIONING, AVAILABLE, TERMINATING, TERMINATED)
  state string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) route table (routing rules for VCN traffic)
//
// Set of forwarding rules that decide where a subnet's traffic goes. `routes`
