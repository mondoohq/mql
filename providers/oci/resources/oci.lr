import network
import core

option provider = "go.mondoo.com/mql/providers/oci"
option go_package = "go.mondoo.com/mql/providers/oci/resources"
option root = "oci"

// Oracle Cloud Infrastructure (OCI)
//
// Tenancy-scoped entry point for the OCI provider. The `regions` field
// lists the regions the tenancy is subscribed to, with the home-region
// flag and subscription state, and `compartments` lists the OCI
// compartment hierarchy. The active tenancy itself is exposed as
// `oci.tenancy`, and service-specific entry points (`oci.identity`,
// `oci.compute`, `oci.network`, `oci.objectStorage`, `oci.kms`, and so
// on) are reached as siblings.
oci @root {
  // Available regions
  regions() []oci.region
  // Compartments in the tenancy
  compartments() []oci.compartment
}

// Oracle Cloud Infrastructure (OCI) tenancy
//
// Active OCI tenancy, the top-level identity and resource container
// the provider is authenticated against. The `id` is the tenancy
// OCID, `name` and `description` carry the display metadata, and
// `retentionPeriod` reports how long audit events are kept, derived
// from the audit configuration in the tenancy's home region.
oci.tenancy @defaults("name") {
  // Tenancy OCID
  id string
  // Tenancy name
  name string
  // Tenancy description
  description string
  // Event retention period duration
  retentionPeriod() time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) region
//
// Region the tenancy is subscribed to, selected by its region key such as
// `us-phoenix-1`. Reports whether a region is the tenancy's home region,
// where identity and IAM changes originate, and its subscription status,
// which governs where resources may be provisioned. Useful for auditing
// the tenancy's geographic footprint and confirming that only approved
// regions are enabled.
private oci.region @defaults("id name") {
  // Region key (e.g., us-phoenix-1)
  id string
  // Region display name
  name string
  // Whether this is the tenancy's home region
  isHomeRegion bool
  // Region subscription status (READY, IN_PROGRESS)
  status string
}

// Oracle Cloud Infrastructure (OCI) compartment
//
// Logical container that isolates and organizes tenancy resources for
// access control, quota, and billing purposes. Compartments form the
// boundary that IAM policies grant access against, so enumerating them
// reveals the tenancy's resource-isolation structure. The `id` field is
// the compartment OCID, `state` reports the lifecycle status, and
// `created` records when the compartment was provisioned.
private oci.compartment @defaults("id name") {
  // Compartment OCID
  id string
  // Compartment name
  name string
  // Compartment this one sits directly beneath
  //
  // Null for the tenancy root, which has no parent, and for a compartment
  // reached by OCID from outside the tenancy, whose parent cannot be read.
  // Following it repeatedly walks the path a compartment sits on, which is
  // what lets a check ask whether a resource lives anywhere under a named
  // subtree rather than only in the one compartment it reports.
  parent() oci.compartment
  // Whether the caller may inspect resources in this compartment
  //
  // True when the requesting principal holds INSPECT on a resource in the
  // compartment or in one beneath it. False for a compartment the caller can
  // see the existence of but not look inside, which is the case a check for
  // over-broad or missing grants is looking for.
  isAccessible() bool
  // Compartment description
  description string
  // Compartment creation time
  created time
  // Compartment lifecycle state (CREATING, ACTIVE, INACTIVE, DELETING, DELETED)
  state string
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Identity and Access Management
//
// IAM principals and access controls for the tenancy. users are the
// human and service identities, with their MFA state, login history,
// capabilities, API keys, customer secret keys, auth tokens, MFA
// devices, and group memberships. groups collect users, and policies
// carry the statements that grant groups access to compartments and
// resources. dynamicGroups are the rule-matched groups that grant
// access to compute and service principals, identityProviders are the
// federated SAML2 providers, networkSources are the IP and VCN
// allowlists that constrain where console and API requests may
// originate, and authenticationPolicy holds the tenancy's
// password-strength and network-restriction rules.
oci.identity {
  // IAM users
  users() []oci.identity.user
  // IAM groups
  groups() []oci.identity.group
  // IAM policies
  policies() []oci.identity.policy
  // Dynamic groups that grant access to matching compute and service principals
  dynamicGroups() []oci.identity.dynamicGroup
  // Federated SAML2 identity providers
  identityProviders() []oci.identity.identityProvider
  // Network sources that restrict where console and API requests may originate
  networkSources() []oci.identity.networkSource
  // Tenancy authentication policy (password strength and network restrictions)
  authenticationPolicy() oci.identity.authenticationPolicy
  // Identity domains in the tenancy
  //
  // The users, groups, and policies returned by the fields above come
  // from the legacy IAM API, which reaches only the tenancy's default
  // domain. Any tenancy with more than one domain holds principals those
  // fields never return, so `domains` is where the full picture lives.
  domains() []oci.identity.domain
}

// Oracle Cloud Infrastructure (OCI) identity domain
//
// Identity domain, the container OCI uses for users, groups, and the
// authentication policy applied to them. A tenancy has at least a
// Default domain and may have many, each with its own user population,
// password policy, and multi-factor settings, so a control verified only
// against the default domain says nothing about the others.
//
// `type` separates DEFAULT, PRIMARY, SECONDARY, and the free
// DEVELOPER-license domains. `isHiddenOnLogin` reports whether the
// domain appears on the tenancy sign-in page. `users`, `groups`,
// `passwordPolicies`, `authenticationFactorSettings`, and `apps` reach
// into the domain itself through its own endpoint, which is what the
// legacy IAM API cannot do.
private oci.identity.domain @defaults("name type state") {
  // Domain OCID
  id string
  // Domain display name
  name string
  // Domain description
  description string
  // Compartment containing the domain
  compartment() oci.compartment
  // Domain type (DEFAULT, PRIMARY, SECONDARY)
  type string
  // License type the domain runs under (e.g., free, oracle-apps-premium, premium)
  licenseType string
  // Region the domain is homed in
  homeRegion string
  // Regions the domain is replicated to
  replicaRegions []string
  // Whether the domain is hidden from the tenancy sign-in page
  isHiddenOnLogin bool
  // Users in the domain
  users() []oci.identity.domain.user
  // Groups in the domain
  groups() []oci.identity.domain.group
  // Password policies applied in the domain
  passwordPolicies() []oci.identity.domain.passwordPolicy
  // Multi-factor authentication settings for the domain
  authenticationFactorSettings() oci.identity.domain.authenticationFactorSettings
  // Applications registered in the domain
  apps() []oci.identity.domain.app
  // Policies evaluated when a user signs in or a password is set
  //
  // The sign-on policies are the ones carrying `policyType` SignOn, and they
  // are where multi-factor authentication is required rather than merely
  // offered. A policy is an ordered list of rules; the rules are what state
  // the requirement.
  policies() []oci.identity.domain.policy
  // Rules defined in the domain
  //
  // Every rule in the domain, whether or not a policy currently references
  // it. Read a policy's `rules` for the ones it evaluates, in the order it
  // evaluates them.
  rules() []oci.identity.domain.rule
  // Conditions rules match on
  conditions() []oci.identity.domain.condition
  // Network perimeters naming ranges of client addresses
  //
  // A rule that matches on a network perimeter says "when the client comes
  // from perimeter X", and this is what X contains.
  networkPerimeters() []oci.identity.domain.networkPerimeter
  // Whether users may keep a session open across browser restarts
  //
  // Keep-me-signed-in issues a long-lived token that lets a returning user
  // skip sign-in, so with it enabled a multi-factor requirement is satisfied
  // once and then bypassed for the life of the token.
  keepMeSignedInEnabled() bool
  // Whether users are prompted to keep the session open
  keepMeSignedInPromptEnabled() bool
  // Days a keep-me-signed-in token stays valid
  keepMeSignedInTokenValidityInDays() int
  // Days a keep-me-signed-in token survives without being used
  keepMeSignedInLastUsedValidityInDays() int
  // Concurrent keep-me-signed-in sessions allowed per user
  keepMeSignedInMaxAllowedSessions() int
  // Whether the terms-of-use prompt is suppressed
  //
  // Configured alongside the keep-me-signed-in settings.
  termsOfUsePromptDisabled() bool
  // Domain lifecycle state (CREATING, ACTIVE, DELETING, INACTIVE, FAILED)
  state string
  // Domain creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) identity domain user
//
// User account inside an identity domain, keyed by its SCIM id.
// `mfaStatus` reports whether the account is ENROLLED in multi-factor
// authentication, UN_ENROLLED, IGNORED, or DISABLED, which is the
// distinction the tenancy-wide `mfaActivated` flag on the legacy IAM
// user cannot express. `isLocked` and `loginAttempts` report lockout
// state, `lastSuccessfulLogin` and `lastFailedLogin` the account's
// recent use, and `capabilities` which credential types the account may
// hold. `isFederated` marks accounts sourced from an external identity
// provider, whose passwords and MFA are governed there rather than here.
private oci.identity.domain.user @defaults("userName active mfaStatus") {
  // User SCIM identifier
  id string
  // User OCID
  ocid string
  // Login name
  userName string
  // Display name
  displayName string
  // Description
  description string
  // Whether the account is active
  active bool
  // Account type (EMPLOYEE, CONTRACTOR, CUSTOMER, PARTNER, SERVICE)
  userType string
  // Primary email address
  primaryEmail string
  // Whether the primary email address has been verified
  primaryEmailVerified bool
  // All email addresses on the account
  //
  // Each entry has a `value`, a `type` (work, home, recovery, other), and
  // `primary` and `verified` flags.
  emails []dict
  // Whether the account is sourced from an external identity provider
  isFederated bool
  // Multi-factor enrollment status (ENROLLED, UN_ENROLLED, IGNORED, DISABLED)
  mfaStatus string
  // Preferred multi-factor method
  //
  // One of EMAIL, SMS, TOTP, PUSH, OFFLINETOTP, USERNAME_PASSWORD,
  // SECURITY_QUESTIONS, VOICE, PHONE_CALL, THIRDPARTY, FIDO_AUTHENTICATOR,
  // or YUBICO_OTP. Empty when the account is not enrolled.
  preferredAuthenticationFactor string
  // When multi-factor authentication was enrolled
  mfaEnabledOn time
  // Whether the account is locked out
  isLocked bool
  // Consecutive failed login attempts
  loginAttempts int
  // Most recent successful login
  //
  // Null for an account that has never signed in, which is a different
  // state from one that signed in long ago.
  lastSuccessfulLogin time
  // Previous successful login
  previousSuccessfulLogin time
  // Most recent failed login
  lastFailedLogin time
  // Credential types the account is permitted to hold
  //
  // Keyed by capability name, each mapping to whether the account may use
  // it: canUseApiKeys, canUseAuthTokens, canUseConsolePassword,
  // canUseCustomerSecretKeys, canUseSmtpCredentials, canUseDbCredentials,
  // and canUseConsole.
  capabilities map[string]bool
  // Groups the user belongs to
  //
  // Deprecated in favor of groupMemberships, which resolves each row to the
  // group resource behind it. Each entry has the group's `value` (its SCIM
  // id), `display` name, `ocid`, and the `type` of membership.
  groups @maturity("deprecated") @replaced_by("oci.identity.domain.user.groupMemberships") []dict
  // Group memberships held by the user
  //
  // One row per group the user belongs to, each resolving to the group
  // resource so the group's own description, member count and requestable
  // flag can be read from the user. `type` separates a direct membership from
  // one inherited through nesting, which is what decides whether removing the
  // user from a group actually revokes the access it grants.
  groupMemberships() []oci.identity.domain.user.groupMembership
  // When the account was created
  created time
}

// Group membership held by an identity domain user
//
// A single user-to-group binding, carrying the membership's own OCID, when
// the user was added, and the group it binds to. `type` reports whether the
// membership is direct or indirect, which decides whether removing the user
// from the group revokes what it grants.
private oci.identity.domain.user.groupMembership @defaults("displayName type") {
  // Membership OCID
  //
  // Empty on a domain that predates membership OCIDs.
  membershipOcid string
  // Group SCIM identifier the membership binds to
  groupId string
  // Group display name, as recorded on the membership
  displayName string
  // Group the membership binds to
  //
  // Null when the group is not readable in this domain, which leaves the
  // membership in place with nothing behind it.
  group() oci.identity.domain.group
  // How the membership was acquired
  //
  // `direct` when the user was added to the group itself, `indirect` when the
  // membership comes through group nesting.
  type string
  // When the user was added to the group
  //
  // Returned as the service records it, which is not always an RFC 3339
  // timestamp, so it is reported as written rather than parsed.
  dateAdded string
  // Identifier for the membership as defined by the service consumer
  externalId string
}

// Oracle Cloud Infrastructure (OCI) identity domain group
private oci.identity.domain.group @defaults("displayName") {
  // Group SCIM identifier
  id string
  // Group OCID
  ocid string
  // Group display name
  displayName string
  // Description
  description string
  // Number of members in the group
  memberCount int
  // Whether the group can be requested through an access-request workflow
  isRequestable bool
  // When the group was created
  created time
}

// Oracle Cloud Infrastructure (OCI) identity domain password policy
//
// Password rules applied to accounts in a domain. Length and composition
// are set by `minLength`, `maxLength`, `minAlphas`, `minNumerals`,
// `minSpecialChars`, `minLowerCase`, `minUpperCase`, and
// `minUniqueChars`. `passwordExpiresAfter` is the maximum password age
// in days and `numPasswordsInHistory` how many previous passwords are
// blocked from reuse. `maxIncorrectAttempts` and `lockoutDuration`
// govern lockout, and `dictionaryWordDisallowed`, `userNameDisallowed`,
// `firstNameDisallowed`, and `lastNameDisallowed` block guessable
// choices. A domain may carry several policies; the one that applies to
// an account depends on its group membership.
private oci.identity.domain.passwordPolicy @defaults("name minLength passwordExpiresAfter") {
  // Password policy SCIM identifier
  id string
  // Password policy OCID
  ocid string
  // Policy name
  name string
  // Policy description
  description string
  // Minimum password length in characters
  minLength int
  // Maximum password length in characters
  maxLength int
  // Minimum alphabetic characters required
  minAlphas int
  // Minimum numeric characters required
  minNumerals int
  // Minimum alphanumeric characters required
  minAlphaNumerals int
  // Minimum special characters required
  minSpecialChars int
  // Maximum special characters permitted
  maxSpecialChars int
  // Minimum lowercase characters required
  minLowerCase int
  // Minimum uppercase characters required
  minUpperCase int
  // Minimum unique characters required
  minUniqueChars int
  // Maximum times a single character may repeat
  maxRepeatedChars int
  // Days before a password must be changed
  //
  // Zero means passwords never expire.
  passwordExpiresAfter int
  // Days before expiry that a warning is shown
  passwordExpireWarning int
  // Minimum days before a password may be changed again
  minPasswordAge int
  // Previous passwords blocked from reuse
  numPasswordsInHistory int
  // Failed attempts before the account locks
  maxIncorrectAttempts int
  // Minutes an account stays locked after too many failed attempts
  lockoutDuration int
  // Whether dictionary words are rejected
  dictionaryWordDisallowed bool
  // Whether the password may contain the user name
  userNameDisallowed bool
  // Whether the password may contain the user's first name
  firstNameDisallowed bool
  // Whether the password may contain the user's last name
  lastNameDisallowed bool
  // Whether the password must begin with a letter
  startsWithAlphabet bool
  // Substrings the password may not contain
  disallowedSubstrings []string
  // Overall strength preset the policy was built from
  //
  // One of Simple, Standard, or Custom. Simple and Standard are Oracle's
  // presets; Custom means the individual rules on this policy are what
  // actually applies.
  passwordStrength string
  // Character classes a password must draw from
  //
  // A string listing the required characters, so a policy requiring a digit
  // and a symbol reads as those characters rather than as counts. Empty when
  // the policy constrains composition only through the min and max counts.
  requiredChars string
  // Characters a password may contain
  //
  // Empty when every character is permitted.
  allowedChars string
  // Characters a password may not contain
  //
  // Empty when no character is excluded.
  disallowedChars string
  // Minimum distinct characters a new password must have from the previous one
  //
  // Zero means a user may change a password by altering a single character.
  // Null when the policy states no requirement, which the domain treats the
  // same way.
  distinctCharacters int
  // Whether every user governed by the policy must reset their password at next sign-in
  forcePasswordReset bool
  // User attributes whose values a password may not contain
  //
  // Each entry names a profile attribute, so a policy listing `emails`
  // rejects a password built from the user's own mail address. Empty when
  // the policy checks no attribute beyond the dedicated userName, firstName,
  // and lastName rules.
  disallowedUserAttributeValues []string
  // Location of the dictionary of disallowed words
  //
  // Only meaningful when dictionaryWordDisallowed is set. Empty when the
  // domain uses the built-in dictionary.
  dictionaryLocation string
  // Evaluation order when several policies could govern the same user
  //
  // The lowest priority wins, so a weak policy at priority 1 overrides a
  // strict one at priority 2 for any user in both policies' groups. Null on a
  // policy the domain returns no priority for, which is the case for the
  // built-in policies.
  priority int
  // Groups the policy governs
  //
  // Empty when the policy applies to the whole domain rather than to
  // selected groups.
  groups() []oci.identity.domain.group
}

// Oracle Cloud Infrastructure (OCI) identity domain multi-factor settings
//
// Which multi-factor authentication factors a domain permits, and how
// enrollment is handled. Each `*Enabled` field reports whether that
// factor may be used: a domain with only `emailEnabled` accepts a factor
// materially weaker than one offering `fidoAuthenticatorEnabled`, so the
// set of enabled factors is as important as whether MFA is on at all.
// `mfaEnrollmentType` reports whether enrollment is required or optional,
// and `bypassCodeEnabled` whether users can fall back to a bypass code.
private oci.identity.domain.authenticationFactorSettings @defaults("mfaEnrollmentType") {
  // Settings SCIM identifier
  id string
  // Whether SMS one-time passcodes may be used
  smsEnabled bool
  // Whether email one-time passcodes may be used
  emailEnabled bool
  // Whether time-based one-time passcodes may be used
  totpEnabled bool
  // Whether push notifications to the Oracle Mobile Authenticator may be used
  pushEnabled bool
  // Whether phone-call verification may be used
  phoneCallEnabled bool
  // Whether FIDO authenticators may be used
  fidoAuthenticatorEnabled bool
  // Whether Yubico OTP may be used
  yubicoOtpEnabled bool
  // Whether security questions may be used as a factor
  securityQuestionsEnabled bool
  // Whether bypass codes may be used in place of a factor
  bypassCodeEnabled bool
  // Whether enrollment is required or optional
  mfaEnrollmentType string
  // Which user category multi-factor authentication is enabled for
  mfaEnabledCategory string
}

// Oracle Cloud Infrastructure (OCI) identity domain application
//
// Application registered in an identity domain. `isOAuthClient` marks
// apps that hold client credentials and can obtain tokens, and
// `clientType` reports whether those credentials are confidential,
// public, or trusted, which decides whether a client secret is expected
// to be kept private. `allowedGrants` lists the OAuth grant types the
// app may use, so an app permitted the resource-owner password grant is
// distinguishable from one restricted to authorization code.
private oci.identity.domain.app @defaults("displayName isOAuthClient active") {
  // Application SCIM identifier
  id string
  // Application name
  name string
  // Application display name
  displayName string
  // Description
  description string
  // Whether the application is active
  active bool
  // Whether the application is an OAuth client and can obtain tokens
  isOAuthClient bool
  // Whether the application is an OAuth resource server
  isOAuthResource bool
  // OAuth client type (confidential, public, trusted)
  clientType string
  // OAuth grant types the application may use
  //
  // For example authorization_code, implicit, client_credentials,
  // refresh_token, password, tls_client_auth, or device_code.
  allowedGrants []string
  // URL the application lands on after sign-in
  landingPageUrl string
  // Whether a web-tier access policy is applied to the application
  isWebTierPolicy bool
}


// Oracle Cloud Infrastructure (OCI) identity domain policy
//
// Policy evaluated at sign-in, keyed by its SCIM id. A policy is an ordered
// list of rules and carries no requirement of its own, so `rules` is where a
// multi-factor requirement, an address restriction or an outright denial is
// actually stated. `policyType` separates SignOn from the password and
// notification policies the same API returns. `active` is the difference
// between a policy that is written and one that is in force.
private oci.identity.domain.policy @defaults("name policyType active") {
  // Policy SCIM id
  id string
  // Policy OCID
  ocid string
  // Policy name
  name string
  // Policy description
  description string
  // Kind of decision the policy governs
  //
  // SignOn for sign-in policies, and Password, IdentityProvider or
  // NotificationRoute for the others the domain defines.
  policyType string
  // Whether the policy is in force
  active bool
  // Rules the policy evaluates, in evaluation order
  //
  // The first rule whose condition matches decides the outcome, so the order
  // is part of the meaning: a permissive rule ahead of a restrictive one
  // makes the restrictive one unreachable.
  rules() []oci.identity.domain.rule
  // Policy creation time
  created time
}

// Oracle Cloud Infrastructure (OCI) identity domain rule
//
// One rule within a sign-on policy, and the place a requirement is stated.
// `returns` carries the outcome as name and value pairs, so a rule allowing
// access without a second factor and one demanding multi-factor differ only
// there. `condition` is what the rule matches on, and it is null when the
// rule matches on a group of conditions instead, named by
// `conditionGroupName`. An inactive rule is never evaluated.
private oci.identity.domain.rule @defaults("name active") {
  // Rule SCIM id
  id string
  // Rule OCID
  ocid string
  // Rule name
  name string
  // Rule description
  description string
  // Kind of policy the rule belongs to
  //
  // SignOn for sign-in rules, and Password, IdentityProvider or
  // NotificationRoute for the others.
  policyType string
  // Whether the rule is evaluated
  active bool
  // Whether the rule is locked against modification
  locked bool
  // Expression the rule matches on
  conditionExpression string
  // Condition the rule matches on
  //
  // Null when the rule matches on a condition group rather than a single
  // condition, in which case `conditionGroupName` names the group.
  condition() oci.identity.domain.condition
  // Whether the rule matches a single condition or a group of them
  //
  // Condition or ConditionGroup.
  conditionGroupType string
  // Name of the condition or condition group the rule matches on
  conditionGroupName string
  // Outcome the rule produces, keyed by name
  //
  // A sign-on rule states its decision here. `effect` carries ALLOW or DENY,
  // and the factor and session settings a matching sign-in is subject to
  // appear alongside it.
  returns map[string]string
  // Rule creation time
  created time
}

// Oracle Cloud Infrastructure (OCI) identity domain condition
//
// Single test a rule matches on, written as an attribute, an operator and a
// value. Conditions are defined once for the domain and referenced by any
// number of rules, so reading one tells you what every rule naming it
// actually tests. Common attributes are the client's network perimeter, the
// user's group membership, and the application being signed in to.
private oci.identity.domain.condition @defaults("name attributeName operator attributeValue") {
  // Condition SCIM id
  id string
  // Condition OCID
  ocid string
  // Condition name
  name string
  // Condition description
  description string
  // Attribute the condition tests
  attributeName string
  // Comparison the condition applies
  //
  // One of eq, ne, co, coany, sw, ew, gt, ge, lt, le, in, or nin.
  operator string
  // Value the attribute is compared against
  attributeValue string
  // Expression gating whether the condition is evaluated at all
  evaluateConditionIf string
  // Condition creation time
  created time
}

// Oracle Cloud Infrastructure (OCI) identity domain network perimeter
//
// Named set of client addresses a sign-on rule can match on. A rule reading
// "allow from the corporate perimeter" means nothing without this: the
// perimeter may hold a pair of office prefixes or a range wide enough to
// cover the public internet, and `ipAddresses` is the only place that
// difference shows.
private oci.identity.domain.networkPerimeter @defaults("name") {
  // Network perimeter SCIM id
  id string
  // Network perimeter OCID
  ocid string
  // Network perimeter name
  name string
  // Network perimeter description
  description string
  // Client addresses the perimeter covers
  //
  // Deprecated in favor of addresses, which returns the same entries as
  // resources. Each entry carries `value` with the address or range, `type` as
  // CIDR, RANGE or EXACT, and `version` as IPV4 or IPV6.
  ipAddresses @maturity("deprecated") @replaced_by("oci.identity.domain.networkPerimeter.addresses") []dict
  // Client addresses the perimeter covers
  //
  // One row per entry in the perimeter. A perimeter naming a single wide CIDR
  // covers far more of the internet than the pair of office prefixes a sign-on
  // rule referencing it implies, and this is where that difference shows.
  addresses []oci.identity.domain.networkPerimeter.address
  // Network perimeter creation time
  created time
}

// Client address entry in an identity domain network perimeter
//
// A single address, range, or CIDR block the perimeter covers, as a sign-on
// rule sees it. `type` decides how `value` is read.
private oci.identity.domain.networkPerimeter.address @defaults("value type version") {
  // Address, address range, or CIDR block
  //
  // Read according to `type`: a single address for EXACT, a start and end
  // address for RANGE, and a prefix for CIDR.
  value string
  // How the value is read
  //
  // One of CIDR, RANGE, or EXACT.
  type string
  // Address family of the entry
  //
  // IPV4 or IPV6.
  version string
}

// Oracle Cloud Infrastructure (OCI) IAM user
private oci.identity.user @defaults("name") {
  // User OCID
  id string
  // Compartment containing the user
  compartment() oci.compartment
  // User's login name within the OCI tenancy
  name string
  // User description
  description string
  // User creation time
  created time
  // User lifecycle state (CREATING, ACTIVE, INACTIVE, DELETING, DELETED)
  state string
  // Whether multi-factor authentication is enabled
  mfaActivated bool
  // User email address
  email string
  // Whether the email address has been verified
  emailVerified bool
  // Identifier of this user in a federated identity provider, empty for local users
  externalIdentifier string
  // Federated identity provider this user originates from, when the user is federated
  identityProvider() oci.identity.identityProvider
  // Authentication capabilities the user is permitted to hold
  //
  // Keyed by capability name, each mapping to whether the user may use
  // it: canUseConsolePassword, canUseApiKeys, canUseAuthTokens,
  // canUseSmtpCredentials, canUseCustomerSecretKeys, and
  // canUseOAuth2ClientCredentials.
  capabilities map[string]bool
  // Most recent successful login time
  lastLogin time
  // Previous successful login time
  previousLogin time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // API keys for API authentication
  apiKeys() []oci.identity.apiKey
  // Customer secret keys for Amazon S3 compatibility API
  customerSecretKeys() []oci.identity.customerSecretKey
  // Authentication tokens for Oracle Cloud Infrastructure APIs
  authTokens() []oci.identity.authToken
  // Groups the user belongs to
  groups() []oci.identity.group
  // MFA TOTP devices
  mfaDevices() []oci.identity.mfaDevice
  // Database password credentials for OCI database connections
  dbCredentials() []oci.identity.dbCredential
  // SMTP credentials for the Email Delivery service
  smtpCredentials() []oci.identity.smtpCredential
  // OAuth 2.0 client credentials for token-based API access
  oauth2ClientCredentials() []oci.identity.oauth2ClientCredential
}

