  // Whether the secret is a replica of a secret in another region
  //
  // Null when the service does not report it.
  isReplica bool
  // Whether writes to a replica are forwarded to the source secret
  //
  // Null when the secret carries no replication configuration.
  isReplicationWriteForwardEnabled bool
  // Regions the secret's material is copied into
  //
