// Oracle Cloud Infrastructure (OCI) IAM policy that grants group permissions to resources
private oci.identity.policy @defaults("name description") {
  // Policy OCID
  id string
  // Compartment containing the policy
  compartment() oci.compartment
  // Policy name
  name string
  // Policy description
  description string
  // Policy creation time
  created time
  // Policy lifecycle state (CREATING, ACTIVE, INACTIVE, DELETING, DELETED)
  state string
  // Policy statements defining permissions
  statements []string
  // Policy statements broken into their grammatical parts
  //
  // Each entry corresponds to one line of `statements`, split into the
  // subject, verb, resource type, scope, and condition that determine what
  // the line grants, so an audit can match on those parts instead of
  // pattern-matching the statement text.
  parsedStatements() []oci.identity.policy.statement
  // Policy version date
  versionDate time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Statement within an Oracle Cloud Infrastructure (OCI) IAM policy
//
// One policy statement split into the parts that determine what it grants:
// the effect that opens it, the principals named as its subject, the verb
// and resource type it permits, the compartment or tenancy it applies in,
// and any condition that narrows it. The `raw` field keeps the original
// text, so a statement written in a form the provider does not recognize
// remains readable even when the other fields come back empty.
//
// The keyword fields are lowercased, so `Allow` and `allow` both read as
// `allow`, while `subjectNames` and `scopeName` preserve the casing used in
// the policy. `groups` and `dynamicGroups` resolve the named subject
// principals, and `compartment` resolves the scope for statements written
// against a compartment rather than the whole tenancy.
private oci.identity.policy.statement @defaults("effect subjectType verb resourceType scopeType") {
  // Statement text as written in the policy
  raw string
  // Statement effect
  //
  // One of allow, endorse, admit, or define. Endorse and admit statements
  // carry cross-tenancy grants, and define statements name a tenancy or
  // group rather than granting access.
  effect string
  // Kind of principal the statement grants to
  //
  // One of group, dynamic-group, service, any-user, or any-group. Define
  // statements report the kind being named, such as tenancy. Empty when the
  // subject is written in a form the provider does not recognize.
  subjectType string
  // Principals named as the statement's subject
  //
  // Group or dynamic group names, or OCIDs where the statement uses the
  // `id` form. Empty for subjects that name no principal, such as any-user.
  subjectNames []string
  // Access level the statement grants
  //
  // One of inspect, read, use, or manage, in increasing order of access.
  // Empty on define statements, which grant nothing.
  verb string
  // Resource type the statement covers
  //
  // An aggregate such as all-resources or instance-family, or an individual
  // type such as buckets or objects.
  resourceType string
  // Kind of scope the statement applies in
  //
  // One of tenancy, compartment, or any-tenancy. A statement scoped to the
  // tenancy applies to every compartment beneath it.
  scopeType string
  // Compartment named as the statement's scope
  //
  // The compartment name, a colon-separated path for a nested compartment,
  // or an OCID where the statement uses the `compartment id` form. Empty
  // when the scope is the whole tenancy.
  scopeName string
  // Condition that narrows when the statement applies
  //
  // The text following `where`, covering both single comparisons and the
  // `any` and `all` groupings. Empty when the statement is unconditional.
  condition string
  // Groups named as the statement's subject
  groups() []oci.identity.group
  // Dynamic groups named as the statement's subject
  dynamicGroups() []oci.identity.dynamicGroup
  // Compartment the statement is scoped to
  compartment() oci.compartment
}

