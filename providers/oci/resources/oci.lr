  // Route rules resolved to their destination and target network entity
  routes() []oci.network.routeTable.route
  // Lifecycle state (e.g., PROVISIONING, AVAILABLE, TERMINATING, TERMINATED)
  state string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) route rule
private oci.network.routeTable.route @defaults("destination targetType") {
  // Destination CIDR block or Oracle service CIDR label
  destination string
  // Type of destination (CIDR_BLOCK, SERVICE_CIDR_BLOCK)
  destinationType string
  // Route type (STATIC, LOCAL)
  routeType string
  // Description of the route rule
  description string
  // Kind of network entity matching traffic is forwarded to
