  // One row per affected package. `cveFixVersion` is what separates a finding
  // that can be remediated by rebuilding the image from one with no fix
  // published yet.
  packages() []oci.vulnerabilityScanning.vulnerablePackage
  // Time the problem was first detected
  firstDetected time
  // Time the problem was last detected
  lastDetected time
}

// Vulnerability rollup
//
// Single vulnerability aggregated across every scanned host and
// container in the tenancy. Each row collapses a single CVE (or
// proprietary issue) into the highest observed severity, the
// impacted-resource counts, and the CVE metadata (title, impact,
// threat, solution, exploitability). `impactedHosts` returns the
// compute instances affected.
private oci.vulnerabilityScanning.vulnerability @defaults("name severity vulnerabilityType state") {
  // Vulnerability identifier (CVE id or proprietary issue id)
  id string
  // Vulnerability name (typically the CVE id)
  name string
  // Compartment OCID owning the rollup row
  compartmentId string
  // Compartment owning the rollup row
  compartment() oci.compartment
  // Highest observed severity
  severity string
  // Vulnerability type (CVE, PROBLEM)
  vulnerabilityType string
  // Remediation state (OPEN, FIXED, NOT_APPLICABLE)
  state string
  // Authentication requirement for exploitation
  authentication string
  // Upstream reference identifier
  vulnerabilityReference string
  // CVE description from the upstream reference
  cveDescription string
  // CVE title
  cveTitle string
  // CVE impact summary
  cveImpact string
  // CVE threat summary
  cveThreat string
  // CVE remediation guidance
  cveSolution string
  // Whether a patch is available (yes, no, unknown)
  cvePatchable string
  // Whether a public exploit is known (yes, no, unknown)
  cveExploitable string
  // Related CVE reference, when applicable
  cveRelatedReference string
  // Upstream URL with full vulnerability details
  cveReferenceUrl string
  // CVSS v3 base score
  //
  // Reported by OCI as a string, so compare it as a number with
  // `cvss3.float`. Empty when the upstream reference carries no CVSS v3
  // score, which is common for non-CVE findings.
  cvss3 string
  // Time the CVE was published upstream
  cvePublished time
  // Time the CVE record was last updated upstream
  cveUpdated time
  // Number of compute instances affected
  impactedHostsCount int
  // Number of container images affected
  impactedContainersCount int
  // Lifecycle state
  lifecycleState string
  // Compute instances affected by this vulnerability
  impactedHosts() []oci.compute.instance
  // Container images affected by this vulnerability
  //
  // Deprecated in favor of impactedContainers, which returns the same entries
  // as resources and adds the scan completion time this dict drops. Each entry
  // has `image`, `repository`, `registry`, `containerScanTargetId`, and
  // `lastContainerScanId`.
  impactedContainerImages() @maturity("deprecated") @replaced_by("oci.vulnerabilityScanning.vulnerability.impactedContainers") []dict
  // Container images affected by this vulnerability
  //
  // One row per affected image, each carrying when the scan that found it
  // completed, so a stale result can be told from a current one.
  impactedContainers() []oci.vulnerabilityScanning.impactedContainerImage
}

// Package affected by a vulnerability scanning finding
//
// A single installed package a scan found affected by a vulnerability, with
// where it sits on disk or in the image. `cveFixVersion` is the version that
// resolves the finding, and is empty when no fix has been published, which
// separates a finding that can be patched from one that can only be mitigated.
private oci.vulnerabilityScanning.vulnerablePackage @defaults("name version cveFixVersion") {
  // Package name
  name string
  // Installed package version
  version string
  // Package format
  //
  // For example RPM or DPKG.
  type string
  // Version in which the vulnerability is fixed
  //
  // Empty when no fixed version has been published, so upgrading the package
  // does not resolve the finding.
  cveFixVersion string
  // Paths where the package was found
  locations []string
}

// Benchmark control score from a host benchmark scan
//
// One control the scan evaluated, with the control statement and whether the
// host passed it.
private oci.vulnerabilityScanning.hostCisBenchmarkScanResult.score @defaults("benchmarkIdentifier score") {
  // Identifier for the benchmark control, for example "1.1.1"
  benchmarkIdentifier string
  // The control statement the identifier refers to
  description string
  // Whether the host passed the control
  //
  // PASS or FAIL.
  score string
}

// Endpoint protection finding from a host scan
//
// One endpoint protection product the scan found on the host, with its
// configuration finding and when its signatures were last updated.
private oci.vulnerabilityScanning.hostEndpointProtectionScanResult.protection @defaults("service severity timeSignatureUpdated") {
  // Name of the endpoint protection product
  service string
  // What the scan found about the product's configuration
  //
  // Empty when the scan found nothing to report.
  configurationFinding string
  // Severity assigned to the finding
  severity string
  // When the product's signatures were last updated
  //
  // Null when the product reports no signature timestamp. Signatures older
  // than the vendor's release cadence mean the product is running but not
  // detecting current threats.
  timeSignatureUpdated time
}

// Container image affected by a vulnerability
//
// One container image a scan found affected by a vulnerability, with the
// registry and repository it lives in and when the scan that found it
// completed.
private oci.vulnerabilityScanning.impactedContainerImage @defaults("registry repository image timeScanCompleted") {
  // Container image name
  image string
  // Repository holding the image
  repository string
  // Registry holding the repository
  registry string
  // Scan target that produced the finding
  containerScanTargetId string
  // Most recent container scan result for the image
  lastContainerScanId string
  // When the scan that found the image completed
  //
  // A finding whose scan completed long ago describes an image as it was then,
  // not as it is now.
  timeScanCompleted time
}

// Oracle Cloud Infrastructure (OCI) AI services
//
// Namespace and entry point for Oracle's managed AI and machine-learning
// services, spanning Generative AI Agents (`oci.ai.agents`), Data Science
// (`oci.ai.dataScience`), Generative AI (`oci.ai.generativeAi`), and the
// Language, Vision, Speech, and Document Understanding services. Each
// covers the resources that make up that service in the tenancy, from
// agents and knowledge bases to models, endpoints, and training projects.
oci.ai {
}

// Oracle Cloud Infrastructure (OCI) Generative AI Agents
//
// Generative AI Agents estate for the tenancy across every subscribed
// region. The `agents` are the configured agents, `agentEndpoints` are
// the endpoints clients connect to (with their content-moderation and
// guardrail settings), `knowledgeBases` and `dataSources` are the
// enterprise data wired into retrieval-augmented generation, and `tools`
// are the tools attached to agents, including the HTTP-endpoint and
// function-calling tools that let an agent reach external APIs.
oci.ai.agents {
  // Generative AI agents
  agents() []oci.ai.agents.agent
  // Agent endpoints
  agentEndpoints() []oci.ai.agents.endpoint
  // Knowledge bases
  knowledgeBases() []oci.ai.agents.knowledgeBase
  // Knowledge base data sources
  dataSources() []oci.ai.agents.dataSource
  // Tools attached to agents
  tools() []oci.ai.agents.tool
}

// Oracle Cloud Infrastructure (OCI) Generative AI agent
//
// Single Generative AI agent, the large-language-model application that
// answers questions over enterprise data. Select an agent by its OCID,
// for example `oci.ai.agents.agent(id: "ocid1.genaiagent.oc1...")`. The
// agent exposes its welcome message, the language-model routing
// configuration, and the compartment it lives in. Clients connect to an
// agent through one of its `oci.ai.agents.endpoint` resources.
private oci.ai.agents.agent @defaults("name state") {
  init(id? string)
  // Agent OCID
  id string
  // Agent display name
  name string
  // Compartment OCID containing the agent
  compartmentID string
  // Compartment containing the agent
  compartment() oci.compartment
  // Description of the agent's purpose
  description string
  // Greeting shown to users at the start of a conversation
  welcomeMessage string
  // Language-model routing and selection configuration
  llmConfig dict
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Detail message describing the current lifecycle state
  lifecycleDetails string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Generative AI agent endpoint
//
// Network-reachable entry point clients use to chat with a Generative AI
// agent. Select an endpoint by its OCID, for example
// `oci.ai.agents.endpoint(id: "ocid1.genaiagentendpoint.oc1...")`. The
// endpoint reports whether content moderation runs on input and output,
// the guardrail configuration that screens for content, prompt
// injection, and personally identifiable information, session behavior,
// and whether tracing and citations are returned in chat results, the
// controls that govern how safely the agent can be used.
private oci.ai.agents.endpoint @defaults("name state") {
  init(id? string)
  // Endpoint OCID
  id string
  // Endpoint display name
  name string
  // Compartment OCID containing the endpoint
  compartmentID string
  // Compartment containing the endpoint
  compartment() oci.compartment
  // OCID of the agent this endpoint serves
  agentID string
  // Agent this endpoint serves
  agent() oci.ai.agents.agent
  // Description of the endpoint
  description string
  // Whether content moderation runs on user input
  contentModerationOnInput bool
  // Whether content moderation runs on model output
  contentModerationOnOutput bool
  // Guardrail configuration screening content, prompt injection, and PII
  //
  // Has `contentModerationConfig`, `promptInjectionConfig`, and
  // `personallyIdentifiableInformationConfig`, each reporting whether
  // the guardrail is enabled and the action it takes.
  guardrailConfig dict
  // Idle timeout in seconds before a chat session expires
  sessionIdleTimeoutInSeconds int
  // Whether session-based chat is enabled
  sessionEnabled bool
  // Whether traces are returned in chat results
  traceEnabled bool
  // Whether citations are returned in chat results
  citationEnabled bool
  // Whether multi-language chat is enabled
  multiLanguageEnabled bool
  // Additional endpoint configuration key-value pairs
  metadata map[string]string
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Detail message describing the current lifecycle state
  lifecycleDetails string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Generative AI agent knowledge base
//
// Indexed corpus a Generative AI agent retrieves from to answer
// questions. Select a knowledge base by its OCID, for example
// `oci.ai.agents.knowledgeBase(id: "ocid1.genaiagentknowledgebase.oc1...")`.
// The tenancy's `dataSources` show which content feeds each knowledge
// base.
private oci.ai.agents.knowledgeBase @defaults("name state") {
  init(id? string)
  // Knowledge base OCID
  id string
  // Knowledge base display name
  name string
  // Compartment OCID containing the knowledge base
  compartmentID string
  // Compartment containing the knowledge base
  compartment() oci.compartment
  // Description of the knowledge base
  description string
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Detail message describing the current lifecycle state
  lifecycleDetails string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Generative AI agent data source
//
// Content ingested into a knowledge base for a Generative AI agent to
// retrieve. Select a data source by its OCID, for example
// `oci.ai.agents.dataSource(id: "ocid1.genaiagentdatasource.oc1...")`.
// The `knowledgeBase` field resolves the knowledge base this content
// feeds.
private oci.ai.agents.dataSource @defaults("name state") {
  init(id? string)
  // Data source OCID
  id string
  // Data source display name
  name string
  // Compartment OCID containing the data source
  compartmentID string
  // Compartment containing the data source
  compartment() oci.compartment
  // OCID of the knowledge base this data source feeds
  knowledgeBaseID string
  // Knowledge base this data source feeds
  knowledgeBase() oci.ai.agents.knowledgeBase
  // Description of the data source
  description string
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Detail message describing the current lifecycle state
  lifecycleDetails string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Generative AI agent tool
//
// Capability an agent can invoke while answering, such as retrieving from
// a knowledge base, querying a database, calling a function, or reaching
// an external HTTP endpoint. Select a tool by its OCID, for example
// `oci.ai.agents.tool(id: "ocid1.genaiagenttool.oc1...")`. The `toolType`
// field identifies the kind of tool. Use it to find tools that can reach
// outside the tenancy, for example
// `oci.ai.agents.tools.where(toolType == "HTTP_ENDPOINT_TOOL_CONFIG")`.
private oci.ai.agents.tool @defaults("name toolType state") {
  init(id? string)
  // Tool OCID
  id string
  // Tool display name
  name string
  // Compartment OCID containing the tool
  compartmentID string
  // Compartment containing the tool
  compartment() oci.compartment
  // OCID of the agent this tool is attached to
  agentID string
  // Agent this tool is attached to
  agent() oci.ai.agents.agent
  // Description of the tool
  description string
  // Tool type
  //
  // One of RAG_TOOL_CONFIG, SQL_TOOL_CONFIG, FUNCTION_CALLING_TOOL_CONFIG,
  // HTTP_ENDPOINT_TOOL_CONFIG, or AGENT_TOOL_CONFIG.
  toolType string
  // Full tool configuration, with shape determined by `toolType`
  toolConfig dict
  // Additional tool configuration key-value pairs
  metadata map[string]string
  // Lifecycle state (e.g., CREATING, UPDATING, ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Creation time
  created time
  // Last update time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Data Science
//
// Data Science machine learning estate for the tenancy across every
// subscribed region. The `projects` are the workspaces that organize ML
// work, `notebookSessions` are the managed JupyterLab environments (with
// their compute shape, network placement, and private-endpoint
// configuration), `models` and `modelVersionSets` are the model catalog,
// `modelDeployments` are the models served as HTTP endpoints (with their
// endpoint URL and logging configuration), and `jobs` and `pipelines`
// are the batch and orchestration workloads.
oci.ai.dataScience {
  // Data Science projects
  projects() []oci.ai.dataScience.project
  // Notebook sessions
  notebookSessions() []oci.ai.dataScience.notebookSession
  // Models in the model catalog
  models() []oci.ai.dataScience.model
  // Model version sets
  modelVersionSets() []oci.ai.dataScience.modelVersionSet
  // Model deployments
  modelDeployments() []oci.ai.dataScience.modelDeployment
  // Jobs
  jobs() []oci.ai.dataScience.job
  // Pipelines
  pipelines() []oci.ai.dataScience.pipeline
}

// Oracle Cloud Infrastructure (OCI) Data Science project
//
// Workspace that groups Data Science notebook sessions, models, jobs, and
// pipelines for a team or initiative. Select a project by its OCID, for
// example
// `oci.ai.dataScience.project(id: "ocid1.datascienceproject.oc1...")`.
private oci.ai.dataScience.project @defaults("name state") {
  init(id? string)
  // Project OCID
  id string
  // Project display name
  name string
  // Compartment OCID containing the project
  compartmentID string
  // Compartment containing the project
  compartment() oci.compartment
  // Description of the project
  description string
  // OCID of the principal that created the project
  createdBy string
  // Lifecycle state (e.g., ACTIVE, DELETING, DELETED, FAILED)
  state string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Data Science notebook session
