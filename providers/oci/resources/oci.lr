  // Security list creation time
  created time
  // Security list lifecycle state (e.g., PROVISIONING, AVAILABLE, TERMINATING, TERMINATED)
  state string
  // Egress security rule dicts
  //
  // Deprecated in favor of egressRules, which resolves the port ranges nested
