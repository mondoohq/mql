  byoipv6CidrBlocks []string
  // ULA and private IPv6 CIDR blocks for the VCN address space
  //
  // Not routable to the internet. Empty when the VCN defines no private IPv6
  // range.
  ipv6PrivateCidrBlocks []string
  // Whether the VCN admits traffic only where a Zero Trust Packet Routing policy allows it
  //
  // When set, security lists and network security groups no longer decide on
  // their own what may reach resources in the VCN; a ZPR policy has to permit
  // the flow as well.
  isZprOnly bool
  // VCN domain name for DNS resolution
  vcnDomainName string
  // Security attributes applied to the VCN, keyed by namespace
  //
  // Deprecated in favor of appliedSecurityAttributes, which joins each
  // labelling to the namespace behind it and so reports whether that namespace
  // enforces or only audits. Zero Trust Packet Routing statements can name a
  // whole VCN this way rather than naming the resources inside it.
  securityAttributes @maturity("deprecated") @replaced_by("oci.network.vcn.appliedSecurityAttributes") map[string]dict
  // Security attributes applied to this resource, resolved
  //
  // Each labelling as a row carrying its namespace, its definition and whether
  // that namespace enforces or only audits.
  appliedSecurityAttributes() []oci.securityAttributes.applied
  // Default DHCP options OCID for the VCN
  defaultDhcpOptionsId string
  // Default route table OCID for the VCN
  //
  // Deprecated in favor of defaultRouteTable.
  defaultRouteTableId @maturity("deprecated") @replaced_by("oci.network.vcn.defaultRouteTable") string
  // Route table applied to subnets that specify none of their own
  defaultRouteTable() oci.network.routeTable
  // Default security list OCID for the VCN
  //
  // Deprecated in favor of defaultSecurityList.
  defaultSecurityListId @maturity("deprecated") @replaced_by("oci.network.vcn.defaultSecurityList") string
  // Security list applied to subnets that specify none of their own
  defaultSecurityList() oci.network.securityList
  // DNS label for the VCN
  dnsLabel string
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
  // Subnets carved out of the VCN address space
  subnets() []oci.network.subnet
  // Route tables defined in the VCN
  routeTables() []oci.network.routeTable
  // Security lists defined in the VCN
  //
  // The subnet-level firewall. OCI evaluates the union of a subnet's security
  // lists and the network security groups on a VNIC, so a rule in either layer
  // admits traffic on its own.
  securityLists() []oci.network.securityList
  // Network security groups defined in the VCN
  networkSecurityGroups() []oci.network.networkSecurityGroup
  // Internet gateways attached to the VCN
  //
  // A subnet reaches the internet only when its route table forwards a default
  // route to one of these and that gateway's isEnabled is true.
  internetGateways() []oci.network.internetGateway
  // NAT gateways attached to the VCN
  natGateways() []oci.network.natGateway
  // VCN flow logs (OCI logs with service=flowlogs whose resource is this VCN)
  flowLogs() []oci.logging.log
}

// Oracle Cloud Infrastructure (OCI) network subnet
//
// Address range partitioned from a VCN that VNICs attach to, carrying the
