// Zero Trust Packet Routing
//
// Network authorization written against the security attributes a resource
// carries rather than against its address. ZPR policies sit above security
// lists and network security groups: where a namespace enforces, traffic those
// layers admit can still be denied, so a network posture read without them is
// incomplete for any tenancy that has onboarded ZPR. Exposes the tenancy's
// onboarding status and the policies written against it.
oci.zpr {
  // Zero Trust Packet Routing policies in the tenancy
  policies() []oci.zpr.policy
  // Tenancy-wide Zero Trust Packet Routing onboarding status
  configuration() oci.zpr.configuration
}

// Zero Trust Packet Routing policy
//
// A named set of statements written in the Zero Trust Packet Routing Policy
// Language, deciding which traffic between security-attributed resources is
// permitted. Statements are returned as authored, so an audit reads the same
// text an operator wrote. A policy only governs resources carrying the
// security attributes its statements name.
private oci.zpr.policy @defaults("name state") {
  // Policy OCID
  id string
  // Name of the policy, unique across the tenancy
  name string
  // Policy description
  description string
  // Compartment containing the policy
  compartment() oci.compartment
  // Zero Trust Packet Routing Policy Language statements
  //
  // Up to 25 statements per policy, returned as written.
  statements []string
  // Lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Detail message describing the current lifecycle state
  lifecycleDetails string
  // Creation time
  created time
  // Time the policy was last updated
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace.
  systemTags map[string]dict
}

// Zero Trust Packet Routing tenancy configuration
//
// Whether Zero Trust Packet Routing has been onboarded to the tenancy. ZPR
// policies have no effect until this reports an enabled status, so this is the
// gate to check before reading any conclusion from the policies themselves.
private oci.zpr.configuration @defaults("zprStatus state") {
  // Configuration OCID
  id string
  // Compartment the configuration belongs to
  compartment() oci.compartment
  // Whether Zero Trust Packet Routing is enabled for the tenancy
  //
  // One of ENABLED or DISABLED. Policies do not take effect while disabled.
  zprStatus string
  // Lifecycle state (e.g., CREATING, ACTIVE, UPDATING, FAILED)
  state string
  // Detail message describing the current lifecycle state
  lifecycleDetails string
  // Time Zero Trust Packet Routing was onboarded to the tenancy
  created time
  // Time the configuration was last updated
  timeUpdated time
}

// Security attributes
//
// The vocabulary Zero Trust Packet Routing policies are written against.
// Namespaces group attribute definitions and carry the mode that decides
// whether their attributes are enforced or only audited; the attributes
// themselves are the keys resources are labelled with.
oci.securityAttributes {
  // Security attribute namespaces in the tenancy
  namespaces() []oci.securityAttributes.namespace
  // Security attribute definitions across all namespaces
  attributes() []oci.securityAttributes.attribute
}

// Security attribute applied to a resource
//
// One namespace/name/value labelling on a single resource, resolved against
// the namespace and attribute definition that give it meaning. `isEnforcing`
// reports whether the labelling constrains traffic or only records it, so a
// query can separate resources Zero Trust Packet Routing governs from those
// merely tagged. For example
// `oci.compute.instances.where(appliedSecurityAttributes.any(isEnforcing))`.
private oci.securityAttributes.applied @defaults("namespaceName name value isEnforcing") {
  // Name of the namespace the attribute belongs to
  namespaceName string
  // Name of the attribute
  name string
  // Value assigned on this resource
  //
  // Rendered as text regardless of the attribute's declared type, so a numeric
  // attribute compares against the string form of its value.
  value string
  // Whether the attribute's namespace enforces rather than audits
  //
  // True when the namespace's mode includes `enforce`. This describes the
  // namespace only: whether Zero Trust Packet Routing is switched on for the
  // tenancy is a separate fact, reported by `oci.zpr.configuration.zprStatus`
  // and combined with this one in `oci.network.exposure.zprEnforced`.
  isEnforcing bool
  // Namespace defining the attribute
  namespace() oci.securityAttributes.namespace
  // Definition of the attribute, including its validator
  attribute() oci.securityAttributes.attribute
}

// Security attribute namespace
//
// A named group of security attribute definitions, and the unit at which
// enforcement is decided. The `mode` field is the load-bearing one: a
// namespace in `enforce` mode has its attributes acted on by Zero Trust Packet
// Routing, while one in `audit` mode reports what it would have done and
// admits the traffic regardless.
private oci.securityAttributes.namespace @defaults("name mode isRetired") {
  // Namespace OCID
  id string
  // Name of the namespace, unique across the tenancy
  name string
  // Namespace description
  description string
  // Compartment containing the namespace
  compartment() oci.compartment
  // Modes the namespace's attributes can be set to
  //
  // Contains `enforce`, `audit`, or both. Attributes from a namespace that
  // does not include `enforce` never block traffic.
  mode []string
  // Whether the namespace is retired
  //
  // A retired namespace cannot be applied to new resources, though resources
  // already carrying its attributes keep them.
  isRetired bool
  // Lifecycle state (e.g., ACTIVE, INACTIVE, DELETING, DELETED)
  state string
  // Creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace.
  systemTags map[string]dict
}

// Security attribute definition
//
// A single key within a security attribute namespace, and one of the terms a
// Zero Trust Packet Routing statement can name. The validator records whether
// the attribute accepts free-form values or is restricted to an enumerated
// set, which is what stops a policy from being satisfied by an unexpected
// value.
private oci.securityAttributes.attribute @defaults("name isRetired") {
  // Attribute OCID
  id string
  // Name of the attribute, unique within its namespace
  name string
  // Attribute description
  description string
  // Namespace containing the attribute
  namespace() oci.securityAttributes.namespace
  // Compartment containing the attribute definition
  compartment() oci.compartment
  // Data type of the attribute
  type string
  // Whether the attribute is retired
  //
  // A retired attribute cannot be applied to new resources, though resources
  // already carrying it keep it.
  isRetired() bool
  // Value validator applied to the attribute
  //
  // Shape varies by validator type: {validatorType: "DEFAULT"} accepts any
  // value, while {validatorType: "ENUM", values: [...]} restricts the
  // attribute to the listed values. An attribute a Zero Trust Packet Routing
  // statement depends on is only as reliable as the values it will accept.
  validator() dict
  // Lifecycle state (e.g., ACTIVE, INACTIVE, DELETING, DELETED)
  state() string
  // Creation time
  created() time
}

// Oracle Cloud Infrastructure (OCI) Artifact Registry
//
// Container images and generic artifacts stored in the tenancy's registry.
// `containerRepositories` reports which repositories are readable without
// credentials and which reject overwriting a published tag,
// `containerImages` what is stored in them, and `containerImageSignatures`
// which of those images were signed and with which key. Together they answer
// whether an OKE cluster enforcing an image policy is pulling from
// repositories that can satisfy it. `repositories` and their artifacts cover
// the generic, non-container side of the same registry.
oci.artifacts {
  // Container repositories in the registry
  containerRepositories() []oci.artifacts.containerRepository
  // Container images stored in the registry
  containerImages() []oci.artifacts.containerImage
  // Signatures applied to container images
  containerImageSignatures() []oci.artifacts.containerImageSignature
  // Generic artifact repositories
  repositories() []oci.artifacts.repository
  // Registry namespace for the tenancy
  //
  // The first segment of every image path, so it is what a pull reference in
  // a deployment has to match.
  registryNamespace() string
  // Whether pushing to an unknown repository creates it
  //
  // With this on, any principal that can push can bring a new repository into
  // existence, so the set of repositories is not something an administrator
  // has approved in advance.
  isRepositoryCreatedOnFirstPush() bool
}

// Oracle Cloud Infrastructure (OCI) container repository
//
// Repository holding container images, and the place two registry-side
// controls are set. `isPublic` reports whether the repository can be pulled
// anonymously from the internet, and `isImmutable` whether a published tag
// can be moved to point at different content. A mutable tag means an image
// verified once is not necessarily the image that runs next.
private oci.artifacts.containerRepository @defaults("name isPublic imageCount") {
  // Container repository OCID
  id string
  // Repository name, which is the image path below the registry namespace
  name string
  // Compartment containing the repository
  compartment() oci.compartment
  // Registry namespace the repository sits under
  namespace string
  // Whether the repository can be pulled without credentials
  isPublic bool
  // Whether a published tag is prevented from being moved to other content
  isImmutable() bool
  // Images stored in the repository
  images() []oci.artifacts.containerImage
  // Number of images in the repository
  imageCount int
  // Number of layers across the repository
  layerCount int
  // Bytes consumed by the repository's layers
  layersSizeInBytes int
  // Billable size of the repository in gigabytes
  billableSizeInGBs int
  // Repository lifecycle state (AVAILABLE, DELETING, or DELETED)
  state string
  // Principal that created the repository
  createdBy() string
  // Time an image was last pushed to the repository
  timeLastPushed() time
  // Repository creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) container image
//
// One image manifest in a container repository, identified by its `digest`.
// `signatures` is what an image policy checks, so an image with none cannot
// satisfy a cluster that enforces one. `versions` lists the tags currently
// resolving to this digest, which is how a tag in a deployment is traced back
// to the content it actually pulls.
private oci.artifacts.containerImage @defaults("name digest state") {
  // Container image OCID
  id string
  // Image path and tag, as it appears in a pull reference
  name string
  // Content digest of the image manifest
  digest string
  // Tag this listing entry refers to
  version string
  // Repository the image is stored in
  repository() oci.artifacts.containerRepository
  // Name of the repository the image is stored in
  repositoryName string
  // Compartment containing the image
  compartment() oci.compartment
  // Signatures applied to the image
  //
  // An image with no signatures cannot satisfy a cluster whose image policy
  // requires one, whatever keys that policy names.
  signatures() []oci.artifacts.containerImageSignature
  // Tags currently resolving to this digest
  //
  // Each entry carries `version` with the tag, `createdBy` with the principal
  // that pushed it, and `timeCreated`.
  versions() []dict
  // Principal that pushed the image
  createdBy() string
  // Number of times the image has been pulled
  pullCount() int
  // Time the image was last pulled
  timeLastPulled() time
  // Bytes consumed by the image's layers
  layersSizeInBytes() int
  // Image lifecycle state (AVAILABLE, DELETING, or DELETED)
  state string
  // Image creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) container image signature
//
// Signature over a container image's digest, and the evidence an image policy
// evaluates. `kmsKey` is the key the signature was produced with, which is
// what a cluster's image policy names when it decides whose signatures it
// trusts, and `signingAlgorithm` is how it was produced. A signature made
// with a key the policy does not name satisfies nothing.
private oci.artifacts.containerImageSignature @defaults("name signingAlgorithm") {
  // Signature OCID
  id string
  // Signature display name
  name string
  // Compartment containing the signature
  compartment() oci.compartment
  // Image the signature covers
  image() oci.artifacts.containerImage
  // Vault key the signature was produced with
  kmsKey() oci.kms.key
  // Version of the vault key used
  //
  // Reported as an identifier because a key version is reachable only through
  // the key that owns it, which `kmsKey` resolves.
  kmsKeyVersionId string
  // How the signature was produced
  //
  // One of SHA_224_RSA_PKCS_PSS, SHA_256_RSA_PKCS_PSS,
  // SHA_384_RSA_PKCS_PSS, or SHA_512_RSA_PKCS_PSS.
  signingAlgorithm string
  // Base64-encoded payload that was signed
  message string
  // Base64-encoded signature over the message
  signature string
  // Signature lifecycle state (e.g., AVAILABLE, DELETING, DELETED)
  state string
  // Signature creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) artifact repository
//
// Repository holding generic, non-container artifacts. `isImmutable` reports
// whether an artifact already published at a path and version can be
// replaced, which is the same tamper question a container repository answers
// for tags.
private oci.artifacts.repository @defaults("name repositoryType isImmutable") {
  // Repository OCID
  id string
  // Repository display name
  name string
  // Repository description
  description string
  // Compartment containing the repository
  compartment() oci.compartment
  // Kind of repository
  //
  // GENERIC is the only kind the service offers today.
  repositoryType string
  // Whether an artifact already published cannot be replaced
  isImmutable bool
  // Artifacts stored in the repository
  artifacts() []oci.artifacts.genericArtifact
  // Repository lifecycle state (e.g., AVAILABLE, DELETING, DELETED)
  state string
  // Repository creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) generic artifact
//
// One file stored in an artifact repository, identified by its path and
// version. `sha256` is the content digest a consumer can verify a download
// against, and it is the only integrity evidence a generic artifact carries,
// since these are not signed the way container images are.
private oci.artifacts.genericArtifact @defaults("name version sizeInBytes") {
  // Artifact OCID
  id string
  // Artifact display name, which is the path and version
  name string
  // Compartment containing the artifact
  compartment() oci.compartment
  // Repository the artifact is stored in
  repository() oci.artifacts.repository
  // Path the artifact is published at
  artifactPath string
  // Version the artifact is published under
  version string
  // SHA-256 digest of the artifact's content
  sha256 string
  // Size of the artifact in bytes
  sizeInBytes int
  // Artifact lifecycle state (e.g., AVAILABLE, DELETING, DELETED)
  state string
  // Artifact creation time
  created time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) Operator Access Control
//
// Gate on Oracle's own operators reaching customer infrastructure. Exadata
// Cloud@Customer, Autonomous Database and the other managed platforms are
// serviced by Oracle staff, and an operator control decides whether that
// access needs an approval, how many approvers, and for how long. `controls`
// holds the rules, `controlAssignments` records which resources each rule is
// actually attached to, and `accessRequests` is the history of who asked for
// what and whether it was granted. The history is the evidence: a control
// that has never denied anything and a control nobody has ever tested look
// the same until the requests are read.
oci.operatorAccessControl {
  // Operator controls defined in the tenancy
  controls() []oci.operatorAccessControl.control
  // Assignments attaching a control to a resource
  controlAssignments() []oci.operatorAccessControl.controlAssignment
  // Access requests raised against controlled resources
  accessRequests() []oci.operatorAccessControl.accessRequest
  // Operator actions that can be requested
  actions() []oci.operatorAccessControl.action
}

// Oracle Cloud Infrastructure (OCI) operator control
//
// Rule governing Oracle operator access to a class of resource.
// `isFullyPreApproved` is the setting that matters most: with it set, every
// operator action proceeds without anyone approving it, so the control exists
// while enforcing nothing. `numberOfApprovers` is how many people must agree
// when it is not pre-approved.
private oci.operatorAccessControl.control @defaults("name isFullyPreApproved numberOfApprovers") {
  // Operator control OCID
  id string
  // Operator control name
  name string
  // Compartment containing the operator control
  compartment() oci.compartment
  // Whether every request under this control is approved without review
  isFullyPreApproved bool
  // Approvers required before an operator action proceeds
  numberOfApprovers int
  // Kind of resource the control governs (e.g., EXACC, EXADATAINFRASTRUCTURE, AUTONOMOUSVMCLUSTER, CCCINFRASTRUCTURE)
  resourceType string
  // Operator control lifecycle state (e.g., CREATED, ASSIGNED, UNASSIGNED, DELETED)
  state string
  // Operator control creation time
  created time
  // Last modification time
  timeOfModification time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) operator control assignment
//
// Attachment of an operator control to one resource, and the only thing that
// puts a control into effect. An unassigned control governs nothing, so this
// is where coverage is proved. `isEnforcedAlways` separates a permanent
// assignment from one bounded by `timeAssignmentFrom` and `timeAssignmentTo`,
// and `isLogForwarded` with `remoteSyslogServerAddress` reports whether
// operator activity is streamed off the resource for independent review.
private oci.operatorAccessControl.controlAssignment @defaults("resourceName operatorControlName state") {
  // Assignment OCID
  id string
  // Operator control this assignment applies
  operatorControl() oci.operatorAccessControl.control
  // Name of the operator control this assignment applies
  operatorControlName string
  // Compartment containing the assignment
  compartment() oci.compartment
  // OCID of the resource the control is attached to
  //
  // Which kind of resource this identifies is given by `resourceType`, and
  // the platforms it covers are managed database and Cloud@Customer
  // infrastructure rather than resources this provider models.
  resourceId string
  // Name of the resource the control is attached to
  resourceName string
  // Kind of resource the control is attached to (e.g., EXACC, EXADATAINFRASTRUCTURE, AUTONOMOUSVMCLUSTER, CCCINFRASTRUCTURE)
  resourceType string
  // Whether the control applies at all times rather than for a bounded window
  isEnforcedAlways bool
  // Start of the assignment window
  timeAssignmentFrom time
  // End of the assignment window
  timeAssignmentTo time
  // Whether operator activity is forwarded to a remote syslog server
  isLogForwarded bool
  // Address of the syslog server operator activity is forwarded to
  remoteSyslogServerAddress string
  // Port of the syslog server operator activity is forwarded to
  remoteSyslogServerPort int
  // Whether hypervisor logs are forwarded as well
  isHypervisorLogForwarded bool
  // Assignment lifecycle state (e.g., CREATED, APPLIED, APPLYFAILED, DELETED)
  state string
  // Detail behind the current lifecycle state
  lifecycleDetails string
  // Time the control was assigned
  timeOfAssignment time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) operator access request
//
// One request by an Oracle operator to reach a controlled resource, and the
// record of what happened to it. `isAutoApproved` marks a request nobody
// reviewed, `severity` and `duration` state how urgent and how long, and
// `actionRequests` names the specific operator actions asked for. Reading
// these is how an assertion about operator access moves from what the control
// permits to what actually took place.
private oci.operatorAccessControl.accessRequest @defaults("resourceName severity state") {
  // Access request OCID
  id string
  // Human-readable request identifier
  requestId string
  // Compartment containing the access request
  compartment() oci.compartment
  // Reason the operator gave for the request
  accessReasonSummary string
  // OCID of the resource access was requested to
  //
  // Which kind of resource this identifies is given by `resourceType`.
  resourceId string
  // Name of the resource access was requested to
  resourceName string
  // Kind of resource access was requested to (e.g., EXACC, EXADATAINFRASTRUCTURE, AUTONOMOUSVMCLUSTER, CCCINFRASTRUCTURE)
  resourceType string
  // Sub-resources named in the request
  subResources []string
  // Operator actions the request asks to perform
  actionRequests []string
  // Whether the request was approved without human review
  isAutoApproved bool
  // Urgency the operator claimed (e.g., S1, S2, S3, S4)
  severity string
  // Hours of access requested
  duration int
  // Additional hours requested as an extension
  extendDuration int
  // Access request lifecycle state (e.g., CREATED, APPROVED, APPROVEDFORFUTURE, REJECTED, DEPLOYED, CLOSED, EXPIRED, REVOKED)
  state string
  // Detail behind the current lifecycle state
  lifecycleDetails string
  // Time access was requested for, when scheduled ahead
  timeRequestedForFutureAccess time
  // Access request creation time
  created time
  // Last modification time
  timeOfModification time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
}

// Oracle Cloud Infrastructure (OCI) operator action
//
// One operation an Oracle operator can ask to perform, as published by the
// service. The catalog is what an operator control is written against, so it
// is the denominator for any question about which operations a control
// actually restricts. `component` names the part of the platform the action
// touches.
private oci.operatorAccessControl.action @defaults("name component resourceType") {
  // Operator action OCID
  id string
  // Operator action name
  name string
  // Operator action description
  description string
  // Part of the platform the action operates on
  component string
  // Compartment the action was listed from
  compartment() oci.compartment
  // Kind of resource the action applies to (e.g., EXACC, EXADATAINFRASTRUCTURE, AUTONOMOUSVMCLUSTER, CCCINFRASTRUCTURE)
  resourceType string
  // Operator action lifecycle state (e.g., ACTIVE, INACTIVE)
  state string
}

// Oracle Cloud Infrastructure (OCI) Delegate Access Control
//
// Gate on a managed service provider reaching customer infrastructure. Where
// operator access control covers Oracle's own staff, this covers third
// parties the tenancy has subscribed to: `serviceProviders` is who they are,
// `delegationSubscriptions` records which of them the tenancy has accepted,
// `delegationControls` is the rule attached to the resources they may reach,
// and `accessRequests` is what they asked for and what happened. A
// subscription with no matching delegation control is a provider admitted
// without a rule governing it.
oci.delegateAccessControl {
  // Delegation controls defined in the tenancy
  delegationControls() []oci.delegateAccessControl.delegationControl
  // Subscriptions to service providers
  delegationSubscriptions() []oci.delegateAccessControl.delegationSubscription
  // Access requests raised by service providers
  accessRequests() []oci.delegateAccessControl.accessRequest
  // Service providers offered to the tenancy
  serviceProviders() []oci.delegateAccessControl.serviceProvider
}

// Oracle Cloud Infrastructure (OCI) delegation control
//
// Rule governing which resources a subscribed service provider may reach and
// what it may do there. `resourceType` fixes the class of resource it covers,
// and the control has to exist and be active for delegated access to be
// governed at all.
private oci.delegateAccessControl.delegationControl @defaults("name resourceType state") {
  // Delegation control OCID
  id string
  // Delegation control display name
  name string
  // Compartment containing the delegation control
  compartment() oci.compartment
  // Kind of resource the control governs (e.g., VMCLUSTER, CLOUDVMCLUSTER)
  resourceType string
  // Delegation control lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED, NEEDS_ATTENTION)
  state string
  // Detail behind the current lifecycle state
  lifecycleStateDetails string
  // Delegation control creation time
  created time
  // Last modification time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) delegation subscription
//
// The tenancy's acceptance of one service provider for one class of service.
// A subscription is what admits an outside party at all, so the set of active
// subscriptions is the list of organizations that can be granted access to
// this tenancy's managed resources.
private oci.delegateAccessControl.delegationSubscription @defaults("name subscribedServiceType state") {
  // Delegation subscription OCID
  id string
  // Delegation subscription display name
  name string
  // Compartment containing the subscription
  compartment() oci.compartment
  // Service provider the tenancy is subscribed to
  serviceProvider() oci.delegateAccessControl.serviceProvider
  // Class of service the subscription covers (e.g., TROUBLESHOOTING, ASSISTED_PATCHING)
  subscribedServiceType string
  // Subscription lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED, NEEDS_ATTENTION)
  state string
  // Detail behind the current lifecycle state
  lifecycleStateDetails string
  // Subscription creation time
  created time
  // Last modification time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) delegated resource access request
//
// One request by a subscribed service provider to reach a customer resource.
// `isAutoApproved` marks a request nobody reviewed, `requesterType` separates
// a request raised by the provider from one raised on the customer's behalf,
// and `ticketNumbers` links it to the support case it claims to serve.
private oci.delegateAccessControl.accessRequest @defaults("name resourceName state") {
  // Access request OCID
  id string
  // Access request display name
  name string
  // Compartment containing the access request
  compartment() oci.compartment
  // Delegation control governing the request
  delegationControl() oci.delegateAccessControl.delegationControl
  // Reason the provider gave for the request
  reasonForRequest string
  // OCID of the resource access was requested to
  //
  // Which kind of resource this identifies is given by `resourceType`.
  resourceId string
  // Name of the resource access was requested to
  resourceName string
  // Kind of resource access was requested to (e.g., VMCLUSTER, CLOUDVMCLUSTER)
  resourceType string
  // Support tickets the request is associated with
  ticketNumbers []string
  // Actions the request asks to perform
  requestedActionNames []string
  // Who raised the request (e.g., CUSTOMER, DELEGATEE)
  requesterType string
  // Urgency claimed for the request (e.g., S1, S2, S3, S4)
  severity string
  // Hours of access requested
  durationInHours int
  // Additional hours requested as an extension
  extendDurationInHours int
  // Whether the request was approved without human review
  isAutoApproved bool
  // Where the request stands (e.g., CREATED, APPROVAL_WAITING, APPROVED, REJECTED, CLOSED, EXPIRED, REVOKED)
  requestStatus string
  // Access request lifecycle state (e.g., ACCEPTED, IN_PROGRESS, WAITING, FAILED, SUCCEEDED, CANCELING, CANCELED)
  state string
  // Detail behind the current lifecycle state
  lifecycleStateDetails string
  // Time access was requested
  timeAccessRequested time
  // Access request creation time
  created time
  // Last modification time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) delegate access service provider
//
// An organization the tenancy can subscribe to for delegated access.
// `serviceTypes` is what it may be engaged for and `supportedResourceTypes`
// what it may be engaged on, so together they bound what a subscription to it
// can ever permit.
private oci.delegateAccessControl.serviceProvider @defaults("name serviceProviderType state") {
  // Service provider OCID
  id string
  // Service provider name
  name string
  // Compartment the service provider was listed from
  compartment() oci.compartment
  // Kind of provider (e.g., ORACLE_PROVIDED, THIRD_PARTY)
  serviceProviderType string
  // Classes of service the provider offers (e.g., TROUBLESHOOTING, ASSISTED_PATCHING)
  serviceTypes []string
  // Kinds of resource the provider can be engaged on (e.g., VMCLUSTER, CLOUDVMCLUSTER)
  supportedResourceTypes []string
  // Service provider lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED, NEEDS_ATTENTION)
  state string
  // Detail behind the current lifecycle state
  lifecycleStateDetails string
  // Service provider creation time
  created time
  // Last modification time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Privileged API Control
//
// Approval gate on individual API operations. Where the other controls in
// this family govern who may reach a resource, this governs which operations
// may be called on it at all without someone signing off first.
// `privilegedApiControls` holds the rules and `privilegedApiRequests` the
// operations that were actually asked for, each naming the API and the
// attributes it would touch.
oci.apiAccessControl {
  // Privileged API controls defined in the tenancy
  privilegedApiControls() []oci.apiAccessControl.privilegedApiControl
  // Requests to invoke a privileged API operation
  privilegedApiRequests() []oci.apiAccessControl.privilegedApiRequest
}

// Oracle Cloud Infrastructure (OCI) privileged API control
//
// Rule putting a set of API operations behind approval. `numberOfApprovers`
// is the strength of the gate: a control requiring none is a record that the
// operations are watched rather than a constraint on calling them.
private oci.apiAccessControl.privilegedApiControl @defaults("name resourceType numberOfApprovers") {
  // Privileged API control OCID
  id string
  // Privileged API control display name
  name string
  // Compartment containing the control
  compartment() oci.compartment
  // Kind of resource the control governs
  resourceType string
  // Approvers required before a privileged operation proceeds
  numberOfApprovers int
  // Control lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Detail behind the current lifecycle state
  lifecycleDetails string
  // Control creation time
  created time
  // Last modification time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) privileged API request
//
// One request to invoke API operations that a privileged API control has put
// behind approval. `privilegedOperations` names each API and the attributes
// it would read or change, which is the closest thing OCI offers to a record
// of what a privileged caller intended to touch.
private oci.apiAccessControl.privilegedApiRequest @defaults("name resourceName state") {
  // Privileged API request OCID
  id string
  // Privileged API request display name
  name string
  // Human-readable request identifier
  requestId string
  // Compartment containing the request
  compartment() oci.compartment
  // Reason the caller gave for the request
  reasonSummary string
  // OCID of the resource the operations would be called on
  //
  // Which kind of resource this identifies is given by `resourceType`.
  resourceId string
  // Name of the resource the operations would be called on
  resourceName string
  // Kind of resource the operations would be called on
  resourceType string
  // Sub-resources named in the request
  subResourceNames []string
  // API operations the request asks to invoke
  //
  // Each entry carries `apiName` and, where the operation is attribute
  // scoped, `attributeNames` listing what it would touch.
  privilegedOperations []dict
  // Where the request stands (e.g., CREATED, APPROVAL_WAITING, APPROVED, REJECTED, CLOSED, EXPIRED, REVOKED)
  requestState string
  // Request lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Detail behind the current lifecycle state
  lifecycleDetails string
  // Urgency claimed for the request (e.g., S1, S2, S3, S4)
  severity string
  // Hours of access requested
  durationInHours int
  // Time access was requested for, when scheduled ahead
  timeRequestedForFutureAccess time
  // Request creation time
  created time
  // Last modification time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) Managed Access
//
// Approval workflow for Oracle access to a resource, known as Lockbox. A
// lockbox wraps one resource and points at the approval template deciding who
// must sign off before access is granted. `lockboxes` is what is wrapped and
// `approvalTemplates` the workflows, and each lockbox carries its own
// `accessRequests` history. A lockbox whose template auto-approves is a
// workflow that records access rather than gating it.
oci.lockbox {
  // Lockboxes protecting resources in the tenancy
  lockboxes() []oci.lockbox.lockbox
  // Approval templates lockboxes are governed by
  approvalTemplates() []oci.lockbox.approvalTemplate
}

// Oracle Cloud Infrastructure (OCI) lockbox
//
// Approval gate wrapping one resource. `maxAccessDuration` bounds how long a
// granted access lasts, and `approvalTemplate` is who has to agree before it
// is granted at all. `lockboxPartner` names which Oracle organization the
// lockbox admits.
private oci.lockbox.lockbox @defaults("name lockboxPartner state") {
  // Lockbox OCID
  id string
  // Lockbox display name
  name string
  // Compartment containing the lockbox
  compartment() oci.compartment
  // OCID of the resource the lockbox protects
  //
  // The lockbox wraps whichever service resource it was created for, which
  // may be of a kind this provider does not model.
  resourceId string
  // Approval template deciding who must sign off on access
  approvalTemplate() oci.lockbox.approvalTemplate
  // Oracle organization the lockbox admits (e.g., FAAAS, FUSIONAAAS)
  lockboxPartner string
  // OCID identifying the partner
  partnerId string
  // Compartment OCID on the partner side
  //
  // A compartment in the partner's tenancy rather than this one, so it is
  // reported as an identifier rather than resolved.
  partnerCompartmentId string
  // Longest access a single request can be granted
  maxAccessDuration string
  // Access requests raised against this lockbox
  accessRequests() []oci.lockbox.accessRequest
  // Lockbox lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Detail behind the current lifecycle state
  lifecycleDetails string
  // Lockbox creation time
  created time
  // Last modification time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) lockbox approval template
//
// Workflow deciding who signs off on a lockbox access request.
// `autoApprovalState` is the setting that decides whether the workflow gates
// anything: with it enabled, requests are granted without anyone reviewing
// them. `approverLevels` is the chain of approvers when it is not, and the
// number of levels is the two-person rule made explicit.
private oci.lockbox.approvalTemplate @defaults("name autoApprovalState state") {
  // Approval template OCID
  id string
  // Approval template display name
  name string
  // Compartment containing the approval template
  compartment() oci.compartment
  // Whether requests are granted without review (e.g., ENABLED, DISABLED)
  autoApprovalState string
  // Chain of approvers a request passes through
  //
  // Each entry carries `level` as its position in the chain, `approverType`
  // as the kind of principal, `approverId` naming it, and `domainId` for the
  // identity domain it belongs to. More than one level means no single
  // approver can grant access alone.
  approverLevels []dict
  // Approval template lifecycle state (e.g., CREATING, ACTIVE, UPDATING, DELETING, DELETED, FAILED)
  state string
  // Approval template creation time
  created time
  // Last modification time
  timeUpdated time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}

// Oracle Cloud Infrastructure (OCI) lockbox access request
//
// One request to reach the resource a lockbox protects, and what happened to
// it. `requestorLocation` and `ticketNumber` are the claimed origin and the
// support case behind it, `accessDuration` how long was asked for, and
// `timeExpired` when the granted access lapses. These are the evidence that a
// lockbox is exercised rather than merely configured.
private oci.lockbox.accessRequest @defaults("name state accessDuration") {
  // Access request OCID
  id string
  // Access request display name
  name string
  // Reason given for the request
  description string
  // Lockbox the request was raised against
  lockbox() oci.lockbox.lockbox
  // Identifier of the principal that raised the request
  //
  // An Oracle-side identity rather than a user in this tenancy.
  requestorId string
  // Location the requestor claimed to be operating from
  requestorLocation string
  // Access duration asked for
  accessDuration string
  // Support ticket the request is associated with
  ticketNumber string
  // Access request lifecycle state (e.g., CREATING, IN_PROGRESS, WAITING, SUCCEEDED, CANCELING, CANCELED, FAILED, EXPIRED)
  state string
  // Access request creation time
  created time
  // Last modification time
  timeUpdated time
  // Time the granted access lapses
  timeExpired time
  // Free-form tags for resource management
  freeformTags map[string]string
  // Defined tags for governance and cost tracking
  definedTags map[string]map[string]string
  // System tags
  //
  // Tags applied automatically by Oracle, keyed by namespace. The
  // `Oracle-Tags` namespace records the creating principal in `CreatedBy`
  // and the creation time in `CreatedOn`.
  systemTags map[string]dict
}
