  // window.
  maintenanceWindowChangeScheduled bool
  // Time the pending maintenance window change takes effect
  //
  // Null when no change to the maintenance window is pending.
  timeScheduledMaintenanceWindowUpdate time
  // Oracle Data Safe status (REGISTERED, NOT_REGISTERED, REGISTERING, DEREGISTERING, FAILED)
  dataSafeStatus string
  // Open mode (READ_ONLY, READ_WRITE)
  openMode string
  // Permission level (RESTRICTED, UNRESTRICTED)
  permissionLevel string
  // License model (LICENSE_INCLUDED, BRING_YOUR_OWN_LICENSE)
  licenseModel string
  // KMS key for encryption
  kmsKey() oci.kms.key
  // KMS vault for encryption
  kmsVault() oci.kms.vault
  // Subnet for private endpoint
  subnet() oci.network.subnet
  // Network Security Groups attached to the autonomous database
  securityGroups() []oci.network.networkSecurityGroup
  // Private endpoint IP address
