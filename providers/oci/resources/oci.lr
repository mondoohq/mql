  cidrBlock string
  // Description of the covered Oracle service or services
  description string
}

// Oracle Cloud Infrastructure (OCI) customer-premises equipment (CPE)
//
// On-premises router that terminates a site-to-site IPSec VPN. `ipAddress` is
