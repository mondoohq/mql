  lastOperationType string
  // Description of the last provisioning operation, including the failure reason when it failed
  lastOperationDescription string
  // Region the instance runs in
  region string
  // Cloud Foundry service instance GUID
  cfGuid string
  // CIDR allow-list of client networks permitted to reach the instance
  //
  // From the sgw_acl parameter, the one network control the service
  // exposes on these instances. Empty when no allow-list is configured,
  // which leaves the instance reachable from any address.
  sgwAcl() []string
  // Remote syslog endpoints the instance forwards its logs to
  //
  // Each entry is a syslog drain the instance ships logs to, an egress
  // path for log data that may include connection details. Empty when
  // none is configured.
  syslog() []string
  // Graphite endpoint the instance ships metrics to
  //
  // Host and port of an external Graphite receiver, an off-platform
  // metrics egress. Empty when metrics stay on the platform.
  graphite() string
  // Whether the instance ships metrics to a STACKIT Observability instance
  //
  // Null when the parameter is absent.
  monitoringEnabled() bool
  // Observability instance the instance ships metrics to (nullable)
  //
  // Null when monitoring is not configured or the referenced instance is
  // not readable from this project.
  monitoringInstance() stackit.observability.instance
  // Disk usage percentage at which the node halts to protect data
  //
  // The max_disk_threshold parameter. Null when the parameter is absent.
  maxDiskThreshold() int
  // Backups taken of the instance
  //
  // Proof that backups exist and how the last ones ended. Empty when none
  // exist or the credential cannot list them.
  backups() []stackit.rabbitMq.instance.backup
  // Catalog offering the instance runs (nullable)
  //
  // Matched by offeringVersion against the engine catalog. Follow it to
  // read whether the version is the latest and its lifecycle state. Null
  // when the catalog does not list the version or cannot be read.
  offering() stackit.rabbitMq.offering
  // Catalog plan the instance runs on (nullable)
  //
  // Matched by planId against the engine catalog. Null when the catalog
  // does not list the plan or cannot be read.
  plan() stackit.rabbitMq.offering.plan
  // RabbitMQ plugins enabled on the instance
  //
  // Any of rabbitmq_mqtt, rabbitmq_stomp, rabbitmq_shovel,
  // rabbitmq_shovel_management, rabbitmq_federation,
  // rabbitmq_federation_management, rabbitmq_tracing,
  // rabbitmq_event_exchange, rabbitmq_sharding, or
  // rabbitmq_consistent_hash_exchange. Protocol plugins open additional
  // listeners, the management plugins expose admin HTTP surfaces, and
  // rabbitmq_tracing records message bodies.
  plugins() []string
  // Whether the instance accepts connections from any address
  //
  // True when the instance's parameters enable public access and the
  // source-IP allow-list (`sgw_acl`) is empty or admits any address
  // (0.0.0.0/0 or ::/0), making the instance reachable from the internet.
  internetReachable() bool
  // Enabled TLS protocol versions
  //
  // TLS protocol versions the broker accepts, from the `tls-protocols`
  // parameter (for example TLSv1.2 or TLSv1.3). Empty when the instance
  // uses the broker default. Use it to audit brokers still accepting
  // legacy TLS versions.
  tlsProtocols() []string
  // Enabled TLS cipher list
  //
  // Cipher suites the broker offers, from the `tls-ciphers` parameter.
  // Empty when the instance uses the broker default.
  tlsCiphers() []string
}

// Backup of a STACKIT RabbitMQ instance
//
// One backup the service took of the instance, keyed by its numeric `id`
// rendered as a string. `status` and `finishedAt` on the most recent
// entry answer whether backups are current and healthy; `downloadable`
// says whether the backup can be retrieved through the API.
private stackit.rabbitMq.instance.backup @defaults("id status finishedAt") {
  // Backup identifier
  id string
  // Backup status as reported by the service
  status string
  // Backup size in bytes
  //
  // Null when the service reports no size.
  size int
  // Whether the backup can be downloaded through the API
  //
  // Null when the service reports no setting.
  downloadable bool
  // When the backup was triggered
  triggeredAt time
  // When the backup finished
  finishedAt time
}

// Catalog offering for STACKIT RabbitMQ
//
// One engine version the service provides, keyed by `name` and
// `version`. `latest` marks the current release and `lifecycle` carries
// the state the service assigns to older ones, so an instance on a
// non-latest or retired version can be found through its offering.
private stackit.rabbitMq.offering @defaults("name version latest lifecycle") {
  // Offering name
  name string
  // Engine version
  version string
  // Whether this is the latest version the service provides
  latest bool
  // Lifecycle state the service assigns to the version; empty when none
  lifecycle string
  // Description
  description string
  // Documentation link
  documentationUrl string
  // Number of instances of this offering the project may create
  quotaCount int
  // Plans available for the offering
  plans() []stackit.rabbitMq.offering.plan
}

// Plan within a STACKIT RabbitMQ offering
//
// One sizing plan of an engine offering, keyed by UUID `id`. `free`
// marks the trial plan, which carries no availability commitment.
private stackit.rabbitMq.offering.plan @defaults("name skuName free") {
  // Plan UUID
  id string
  // Plan name
  name string
  // SKU name the plan is billed under
  skuName string
  // Whether this is the free plan
  free bool
  // Description
  description string
}

// STACKIT LogMe namespace
//
// Managed LogMe log-aggregation instances in the project. LogMe is a
// hosted OpenSearch-based logging service; the `instances` field lists
// every provisioned instance so you can audit their plans, connection
// parameters, and internet exposure.
stackit.logMe {
  // LogMe instances
  instances() []stackit.logMe.instance
  // Engine offerings the service currently provides
  //
  // The catalog of engine versions and plans, where a version is marked
  // latest or carries a lifecycle state and a plan is marked free. Empty
  // when the catalog cannot be read.
  offerings() []stackit.logMe.offering
}

// STACKIT LogMe managed instance
//
// A single managed LogMe log-aggregation instance, keyed by its UUID
// `id` (for example `stackit.logMe.instance(id: "...")`). Reports the
// plan and service offering it runs on, the connection `parameters` the
// service returns, and `internetReachable` to flag instances open to the
// public internet.
private stackit.logMe.instance @defaults("id name status planName") {
  init(id? string)
  // Instance UUID
  id string
  // Instance name
  name string
  // Outcome of the last provisioning operation
  //
  // One of "in progress", "succeeded", or "failed". Reports how the
  // last create, update, or delete went (see lastOperationType), not
  // whether the instance is running; read state for that.
  status string
  // Plan name (sizing/quota tier)
  planName string
  // Plan UUID
  planId string
  // Service offering name
  offeringName string
  // Engine version of the service offering
  //
  // Version of the LogMe release the instance runs. `offeringName` names
  // the engine but not its version, and `imageUrl` carries the version only
  // inside an opaque image path, so this is the field to compare against an
  // end-of-life list. Null when the API reports no version for the instance.
  offeringVersion string
  // Cloud-Foundry-style organization GUID
  cfOrganizationGuid string
  // Cloud-Foundry-style space GUID
  cfSpaceGuid string
  // Dashboard URL for the DBaaS UI (empty if not provisioned)
  dashboardUrl string
  // Image / engine version
  imageUrl string
  // Connection and networking parameters
  //
  // Free-form settings the service reports for the instance. Keys
  // include `enable_public_access` (bool) toggling a public endpoint
  // and `sgw_acl` (list of CIDR strings) as the source-IP allow-list;
  // both feed the `internetReachable` exposure check.
  parameters dict
  // Instance lifecycle state
  //
  // Whether the instance is running, as reported by the service: one of
  // active, failed, stopped, creating, deleting, or updating. Distinct
  // from status, which is the outcome of the last provisioning operation;
  // a stopped instance can still report a succeeded status.
  state string
  // Kind of the last provisioning operation
  //
  // One of create, update, or delete. Qualifies status: a succeeded
  // delete is not a healthy instance.
  lastOperationType string
  // Description of the last provisioning operation, including the failure reason when it failed
  lastOperationDescription string
  // Region the instance runs in
  region string
  // Cloud Foundry service instance GUID
  cfGuid string
  // CIDR allow-list of client networks permitted to reach the instance
  //
  // From the sgw_acl parameter, the one network control the service
  // exposes on these instances. Empty when no allow-list is configured,
  // which leaves the instance reachable from any address.
  sgwAcl() []string
  // Remote syslog endpoints the instance forwards its logs to
  //
  // Each entry is a syslog drain the instance ships logs to, an egress
  // path for log data that may include connection details. Empty when
  // none is configured.
  syslog() []string
  // Graphite endpoint the instance ships metrics to
  //
  // Host and port of an external Graphite receiver, an off-platform
  // metrics egress. Empty when metrics stay on the platform.
  graphite() string
  // Whether the instance ships metrics to a STACKIT Observability instance
  //
  // Null when the parameter is absent.
  monitoringEnabled() bool
  // Observability instance the instance ships metrics to (nullable)
  //
  // Null when monitoring is not configured or the referenced instance is
  // not readable from this project.
  monitoringInstance() stackit.observability.instance
  // Disk usage percentage at which the node halts to protect data
  //
  // The max_disk_threshold parameter. Null when the parameter is absent.
  maxDiskThreshold() int
  // Backups taken of the instance
  //
  // Proof that backups exist and how the last ones ended. Empty when none
  // exist or the credential cannot list them.
  backups() []stackit.logMe.instance.backup
  // Catalog offering the instance runs (nullable)
  //
  // Matched by offeringVersion against the engine catalog. Follow it to
  // read whether the version is the latest and its lifecycle state. Null
  // when the catalog does not list the version or cannot be read.
  offering() stackit.logMe.offering
  // Catalog plan the instance runs on (nullable)
  //
  // Matched by planId against the engine catalog. Null when the catalog
  // does not list the plan or cannot be read.
  plan() stackit.logMe.offering.plan
  // Port of the plaintext TCP log ingestion listener
  //
  // The fluentd-tcp parameter. A non-null value means the instance
  // accepts logs over unencrypted TCP alongside the TLS listener. Null
  // when no plaintext TCP listener is configured.
  fluentdTcpPort() int
  // Port of the plaintext UDP log ingestion listener
  //
  // The fluentd-udp parameter. A non-null value means the instance
  // accepts logs over unencrypted UDP. Null when none is configured.
  fluentdUdpPort() int
  // Retention period after which stored logs are deleted
  //
  // The ism_deletion_after parameter as a duration such as `30d`. Empty
  // when no deletion policy is configured.
  logRetention() string
  // Whether the instance accepts connections from any address
  //
  // True when the instance's parameters enable public access and the
  // source-IP allow-list (`sgw_acl`) is empty or admits any address
  // (0.0.0.0/0 or ::/0), making the instance reachable from the internet.
  internetReachable() bool
  // Minimum TLS version for the Fluentd log-ingestion endpoint
  //
  // Lowest TLS protocol version accepted by the Fluentd ingestion
  // listener, from the `fluentd-tls-min-version` parameter (for example
  // TLSv1.2). Empty when the instance uses the service default.
  fluentdTlsMinVersion() string
  // Maximum TLS version for the Fluentd log-ingestion endpoint
  //
  // Highest TLS protocol version accepted by the Fluentd ingestion
  // listener, from the `fluentd-tls-max-version` parameter. Empty when
  // the instance uses the service default.
  fluentdTlsMaxVersion() string
  // Fluentd endpoint TLS cipher list
  //
  // Cipher suites the Fluentd ingestion listener offers, from the
  // `fluentd-tls-ciphers` parameter. Empty when the instance uses the
  // service default.
  fluentdTlsCiphers() string
  // Enabled TLS protocol versions for the embedded OpenSearch endpoint
  //
  // TLS protocol versions accepted by the instance's OpenSearch API,
  // from the `opensearch-tls-protocols` parameter (for example TLSv1.2
  // or TLSv1.3). Empty when the instance uses the service default.
  opensearchTlsProtocols() []string
  // OpenSearch endpoint TLS cipher list
  //
  // Cipher suites the instance's OpenSearch API offers, from the
  // `opensearch-tls-ciphers` parameter. Empty when the instance uses the
  // service default.
  opensearchTlsCiphers() []string
}

// Backup of a STACKIT LogMe instance
//
// One backup the service took of the instance, keyed by its numeric `id`
// rendered as a string. `status` and `finishedAt` on the most recent
// entry answer whether backups are current and healthy; `downloadable`
// says whether the backup can be retrieved through the API.
private stackit.logMe.instance.backup @defaults("id status finishedAt") {
  // Backup identifier
  id string
  // Backup status as reported by the service
  status string
  // Backup size in bytes
  //
  // Null when the service reports no size.
  size int
  // Whether the backup can be downloaded through the API
  //
  // Null when the service reports no setting.
  downloadable bool
  // When the backup was triggered
  triggeredAt time
  // When the backup finished
  finishedAt time
}

// Catalog offering for STACKIT LogMe
//
// One engine version the service provides, keyed by `name` and
// `version`. `latest` marks the current release and `lifecycle` carries
// the state the service assigns to older ones, so an instance on a
// non-latest or retired version can be found through its offering.
private stackit.logMe.offering @defaults("name version latest lifecycle") {
  // Offering name
  name string
  // Engine version
  version string
  // Whether this is the latest version the service provides
  latest bool
  // Lifecycle state the service assigns to the version; empty when none
  lifecycle string
  // Description
  description string
  // Documentation link
  documentationUrl string
  // Number of instances of this offering the project may create
  quotaCount int
  // Plans available for the offering
  plans() []stackit.logMe.offering.plan
}

// Plan within a STACKIT LogMe offering
//
// One sizing plan of an engine offering, keyed by UUID `id`. `free`
// marks the trial plan, which carries no availability commitment.
private stackit.logMe.offering.plan @defaults("name skuName free") {
  // Plan UUID
  id string
  // Plan name
  name string
  // SKU name the plan is billed under
  skuName string
  // Whether this is the free plan
  free bool
  // Description
  description string
}

// STACKIT Secrets Manager namespace
//
// Secrets Manager instances in the project, each a managed vault that
// stores key/value secrets behind an access-controlled API. Query
// `instances` to audit which vaults exist, their lifecycle state, the
// network ACLs that gate access, and how many secrets each one holds.
stackit.secretsManager {
  // Secrets Manager instances
  instances() []stackit.secretsManager.instance
}

// STACKIT Secrets Manager instance
//
// Single managed Secrets Manager instance, a vault that stores
// key/value secrets behind an access-controlled API. Keyed by its
// UUID `id`, for example `stackit.secretsManager.instance(id: "...")`.
// The `acls` field reports the CIDR ranges permitted to reach the
// vault, and `secretCount` tracks how many secrets it currently holds.
private stackit.secretsManager.instance @defaults("id name state") {
  init(id? string)
  // Instance UUID
  id string
  // Instance name
  name string
  // Lifecycle state (CREATING, CREATED, UPDATING, FAILED, DELETING, …)
  state string
  // API URL
  apiUrl string
  // Engine type (e.g., kv)
  secretsEngine string
  // Number of secrets stored in the instance
  secretCount int
  // When instance creation started
  creationStartedAt time
  // When instance creation finished
  creationFinishedAt time
  // ACL CIDRs allowed to connect
  acls() []string
  // Users that hold credentials on the instance
  users() []stackit.secretsManager.user
  // Approles that hold machine credentials on the instance
  approles() []stackit.secretsManager.approle
  // Customer-managed key that encrypts the vault (nullable)
  //
  // Key from Key Management Service the instance is encrypted with. Null
  // when the vault relies on platform-managed encryption, and null when
  // the key is no longer present on its ring. Follow it to read the key
  // state and whether it is importOnly.
  encryptionKey() stackit.kms.key
  // Key ring holding the vault's encryption key (nullable)
  //
  // Null for platform-managed encryption.
  encryptionKeyRing() stackit.kms.keyRing
  // Version number of the key material the vault is pinned to; 0 when unset
  encryptionKeyVersionNumber int
  // Key version pinned by the vault (nullable)
  //
  // Generation of the key material identified by encryptionKeyVersionNumber, so
  // the vault can be checked against the state of the exact version that
  // encrypts it. Null when no version is pinned or when that generation is
  // no longer listed on the key.
  encryptionKeyVersion() stackit.kms.key.version
  // Service account the vault uses to reach its key (nullable)
  //
  // The identity granted use of the customer-managed key on the vault's
  // behalf. Null for platform-managed encryption, and null when the account
  // is not one of this project's.
  encryptionKeyServiceAccount() stackit.serviceAccount
}

// STACKIT Secrets Manager user
//
// Credentialed principal on a Secrets Manager instance, keyed by its UUID
// `id`. The `write` flag separates read-only consumers from principals that
// can create, change, and delete secrets, which is the split least-privilege
// reviews turn on. Pair it with the instance `acls` to see both who may
// authenticate and from where.
private stackit.secretsManager.user @defaults("username write") {
  // User UUID
  id string
  // Username the credential authenticates as
  username string
  // Free-text description recorded when the user was created
  description string
  // Whether the user may create, modify, and delete secrets
  //
  // False for a read-only user that can only fetch secrets.
  write bool
  // Secrets Manager instance the user authenticates against
  instance() stackit.secretsManager.instance
}

// STACKIT Secrets Manager approle
//
// Machine credential on a Secrets Manager instance, keyed by its `roleId`.
// An approle is a standing, non-human identity that authenticates with a
// role ID and a secret ID rather than a username and password. The `write`
// flag separates read-only consumers from identities that can create,
// change, and delete secrets, and `secretIdTtl` with `secretIdNumUses`
// bound how long and how often an issued secret ID keeps working. Both
// bounds are frequently left unlimited, which is what makes a leaked
// secret ID permanent, so `secretIdTtlSeconds` and `secretIdUsesUnlimited`
// report those states directly. The `secretIds` field lists the secret ID
// versions currently live on the approle.
private stackit.secretsManager.approle @defaults("roleId description write") {
  // Role ID the approle authenticates as
  roleId string
  // Free-text description recorded when the approle was created
  description string
  // Whether the approle may create, modify, and delete secrets
  //
  // False for a read-only approle that can only fetch secrets.
  write bool
  // Lifetime of a secret ID issued for the approle
  //
  // A duration string in the service's own format, such as 15m, 1h, or
  // 24h. Null when the instance reports no lifetime for the approle.
  secretIdTtl string
  // Lifetime of a secret ID issued for the approle, in seconds
  //
  // Null when secretIdTtl is absent or is not one of the duration forms
  // the service documents. Zero means an issued secret ID never expires.
  secretIdTtlSeconds int
  // Number of times a secret ID issued for the approle may be used
  //
  // Zero carries the service's unlimited sentinel rather than a real
  // count, so read secretIdUsesUnlimited instead of comparing it.
  secretIdNumUses int
  // Whether a secret ID issued for the approle may be used any number of times
  //
  // True when secretIdNumUses reports the service's unlimited sentinel, so
  // a leaked secret ID keeps authenticating until somebody revokes it.
  secretIdUsesUnlimited bool
  // Secret ID versions currently live on the approle
  secretIds() []stackit.secretsManager.approle.secretId
  // Secrets Manager instance the approle authenticates against
  instance() stackit.secretsManager.instance
}

// Secret ID version issued for a STACKIT Secrets Manager approle
//
// One live secret ID on an approle, selected by its `version`. The secret
// value itself is returned by the service only at creation time and is
// never part of this resource; what is queryable is the bound placed on
// the credential: `ttl` and `ttlSeconds` for how long it stays valid, and
// `numUses` with `usesUnlimited` for how often it may authenticate.
private stackit.secretsManager.approle.secretId @defaults("version ttl numUses") {
  // Version that identifies the secret ID on its approle
  version int
  // Free-text description recorded when the secret ID was created
  description string
  // Lifetime of the secret ID
  //
  // A duration string in the service's own format, such as 15m, 1h, or
  // 24h. Null when the instance reports no lifetime for the secret ID.
  ttl string
  // Lifetime of the secret ID, in seconds
  //
  // Null when ttl is absent or is not one of the duration forms the
  // service documents. Zero means the secret ID never expires.
  ttlSeconds int
  // Number of times the secret ID may be used
  //
  // Zero carries the service's unlimited sentinel rather than a real
  // count, so read usesUnlimited instead of comparing it.
  numUses int
  // Whether the secret ID may be used any number of times
  usesUnlimited bool
}

// STACKIT Observability namespace
//
// Managed observability instances in the project, each a hosted
// Prometheus and Alertmanager stack. Query `instances` to enumerate
// them and audit their plan, lifecycle status, and connection
// endpoints.
stackit.observability {
  // Observability instances
  instances() []stackit.observability.instance
}

// STACKIT Observability managed instance
//
// Single hosted Prometheus and Alertmanager instance, keyed by its
// UUID `id` (for example `stackit.observability.instance(id:
// "fa1d2...")`). Covers the instance name, lifecycle status, plan
// tier, dashboard URL, and the connection parameters clients use to
// push and query metrics and alerts.
private stackit.observability.instance @defaults("id name status planName") {
  init(id? string)
  // Instance UUID
  id string
  // Instance name
  name string
  // Status (CREATING, CREATE_SUCCEEDED, CREATE_FAILED, DELETING, DELETE_SUCCEEDED, DELETE_FAILED, UPDATING, UPDATE_SUCCEEDED, UPDATE_FAILED)
  status string
  // Plan name (sizing/quota tier)
  planName string
  // Service offering name (e.g., "observability")
  offeringName string
  // Plan UUID
  planId() string
  // Dashboard URL for the observability UI (empty if not provisioned)
  dashboardUrl() string
  // Connection parameters
  //
  // Map of parameter name to string value returned by the instance
  // API, holding the endpoint URLs clients use to reach the instance
  // (Alertmanager, Prometheus push and query, Grafana, and log or
  // trace ingestion) along with credential hints. The available keys
  // depend on the plan and provisioning state.
  parameters() dict
  // Whether the instance can be updated
  isUpdatable() bool
  // CIDR blocks permitted to reach the instance endpoints
  //
  // Empty when no ACL is configured, which leaves the Prometheus, Alertmanager,
  // and Grafana endpoints reachable from any address that can authenticate.
  acl() []string
  // Whether Grafana serves dashboards to unauthenticated viewers
  //
  // True exposes every dashboard and the metrics behind it to anyone who
  // reaches the Grafana URL, subject only to acl.
  grafanaPublicReadAccess() bool
  // Whether Grafana logins are authenticated through STACKIT SSO
  grafanaUseStackitSso() bool
  // Whether a generic OAuth provider is configured for Grafana logins
  //
  // An alternative to STACKIT SSO. The provider's client secret is
  // deliberately not exposed.
  grafanaGenericOauthEnabled() bool
  // Whether the generic OAuth provider may grant Grafana admin
  //
  // True lets the external provider's role mapping hand out Grafana
  // administrator rights, so a compromised or loosely scoped provider
  // becomes an admin path into the instance.
  grafanaGenericOauthAllowAssignAdmin() bool
}

// STACKIT Telemetry namespace
//
// Entry point for the project's telemetry pipeline. Telemetry
// `routers` receive, filter, and forward observability data (logs,
// metrics, traces) to external destinations, and the project telemetry
// `link` federates the project's own data to one of those routers.
// Audit this namespace to see where a project's telemetry can flow and
// which external systems receive it.
stackit.telemetry {
  // Telemetry routers defined in the project
  routers() []stackit.telemetry.router
  // Project telemetry link (federation to a telemetry router)
  link() stackit.telemetry.link
}

// STACKIT telemetry router
//
// Single telemetry router, the pipeline that ingests observability
// data, applies a routing `filter`, and forwards it to configured
// destinations. The router is keyed by its UUID `id`, for example
// `stackit.telemetry.router(id: "fa1d2…")`. Audit where telemetry
// leaves the project by reviewing the forwarding targets under
// `destinations` and the ingest credentials issued under
// `accessTokens`.
private stackit.telemetry.router @defaults("id displayName status") {
  init(id? string)
  // Router UUID
  id string
  // Human-readable display name
  displayName string
  // Description
  description string
  // Lifecycle status (reconciling, active, deleting, …)
  status string
  // Ingest URI clients send telemetry to
  uri string
  // Region the router runs in
  region string
  // Routing filter applied to ingested telemetry
  //
  // Holds an `attributes` list, where each entry has `key` (the
  // attribute name to match), `level` (one of resource, scope, or
  // logRecord), `matcher` (`=` or `!=`), and `values` (the strings
  // compared against). Telemetry is forwarded only when it matches
  // these attribute conditions.
  filter dict
  // Creation timestamp
  createdAt time
  // Forwarding destinations configured on the router
  destinations() []stackit.telemetry.router.destination
  // Access tokens issued for the router (metadata only; secrets are not exposed)
  accessTokens() []stackit.telemetry.router.accessToken
}

// STACKIT telemetry router destination
//
// Single forwarding target on a telemetry router, the external system
// a router ships observability data to. The destination is keyed by its
// UUID `id`. Audit `credentialType` and `config` to see which external
// endpoint (an OpenTelemetry collector or an S3 bucket) receives the
// project's telemetry and how the router authenticates to it.
private stackit.telemetry.router.destination @defaults("id displayName status credentialType") {
  // Destination UUID
  id string
  // Human-readable display name
  displayName string
  // Description
  description string
  // Lifecycle status
  //
  // One of reconciling, active, or deleting.
  status string
  // Credential type used to authenticate to the destination
  //
  // One of bearerToken, basicAuth, or accessKey.
  credentialType string
  // Destination configuration
  //
  // Shape depends on `configType`: `OpenTelemetry` populates an
  // `openTelemetry` object with `uri` and, when basic auth is configured,
  // a `basicAuth` object carrying the `username`; `S3` populates an `s3`
  // object with `bucket`, `endpoint`, and, when a key is configured, an
  // `accessKey` object carrying the key `id`. The credential halves
  // (basic-auth password, bearer token, access-key secret) are never
  // included. An optional `filter` (same `attributes` shape as the
  // router filter) narrows what this destination forwards.
  config dict
  // Creation timestamp
  createdAt time
}

// STACKIT telemetry router access token
//
// Metadata for a single access token issued for a telemetry router.
// These tokens authorize clients to push telemetry into the router's
// ingest endpoint, so `status` and `expiresAt` reveal which ingest
// credentials are still live. The token is keyed by its UUID `id`. The
// secret token value is returned only once at creation and is never
// exposed here.
private stackit.telemetry.router.accessToken @defaults("id displayName status expiresAt") {
  // Access token UUID
  id string
  // Human-readable display name
  displayName string
  // Description
  description string
  // Lifecycle status
  //
  // One of active, expired, or deleting.
  status string
  // ID of the principal that created the token
  creatorId string
  // Expiry timestamp
  expiresAt time
}

// STACKIT project telemetry link
//
// Project's telemetry link, the federation binding that forwards the
// project's own observability data to a telemetry router. Check
// `enabled` and `status` to confirm whether the project is actively
// shipping telemetry, and follow `router` to the destination pipeline
// that receives it. The link's access token is a secret and is not
// exposed.
private stackit.telemetry.link @defaults("id displayName enabled status") {
  // Link UUID
  id string
  // Human-readable display name
  displayName string
  // Description
  description string
  // Whether the telemetry link is enabled
  enabled bool
  // Lifecycle status
  //
  // One of active, inactive, failed, reconciling, or deleting.
  status string
  // Region the link applies to
  region string
  // Creation timestamp
  createdAt time
  // Telemetry router this link forwards data to
  router() stackit.telemetry.router
}

// STACKIT Model Serving namespace
//
// Entry point for STACKIT's managed AI inference API in a project. The
// `tokens` list enumerates the authentication tokens issued for calling
// the inference endpoints, and `models` lists the catalog of chat,
// embedding, audio, and image models available in the region together
// with their pricing.
stackit.modelServing {
  // Authentication tokens for the Model Serving API in the project
  tokens() []stackit.modelServing.token
  // Models (chat and embedding) available in the region
  models() []stackit.modelServing.model
}

// STACKIT Model Serving authentication token
//
// Metadata of a single authentication token used to call the Model
// Serving inference API. The token is keyed by its UUID `id`, for
// example `stackit.modelServing.token(id: "fa1d2...")`, and lets audits
// check the lifecycle `state` and the `validUntil` expiry time. The
// secret token value is only returned once at creation and is not
// exposed here.
private stackit.modelServing.token @defaults("id name state validUntil") {
  init(id? string)
  // Token UUID
  id string
  // Token name
  name string
  // Description
  description string
  // Lifecycle state
  //
  // One of creating, active, deleting, or inactive.
  state string
  // Region the token is valid in
  region string
  // Expiry timestamp
  validUntil time
}

// STACKIT Model Serving model
//
// Single model offered by the Model Serving catalog, keyed by its UUID
// `id`. The `type` field distinguishes chat, embedding, audio, and image
// models, `category` reflects the service tier, and `skus` carries the
// per-model pricing. Use it to inventory which models a project can
// invoke and at what cost.
private stackit.modelServing.model @defaults("name type category") {
  // Model UUID
  id string
  // API model name
  name string
  // Human-readable display name
  displayedName string
  // Description
  description string
  // Model type
  //
  // One of chat, embedding, audio, or image.
  type string
  // Model category
  //
  // Service tier of the model: one of standard, plus, or premium.
  category string
  // Region the model is served in
  region string
  // Inference endpoint URL
  url string
  // Free-form tags attached to the model
  tags []string
  // Available pricing SKUs
  //
  // Each entry is a dict with `id` (SKU UUID), `type` (the billing
  // dimension), and `description`.
  skus []dict
}

// STACKIT project service account
//
// Service account within a STACKIT project, the project-scoped
// principal used by automation and SDK callers to authenticate
// against STACKIT APIs. Service accounts are keyed by their email
// address, for example `stackit.serviceAccount(email: "...")`, and
// expose the project they belong to along with the keys and federated
// identity providers issued for authentication (useful for auditing
// credential age and active status).
private stackit.serviceAccount @defaults("email projectId") {
  init(email? string)
  // Service account email (primary identifier)
  email string
  // Project ID the service account belongs to
  projectId string
  // Internal service-account ID (UUID), if returned by the API
  id string
  // Whether the account is a platform-managed internal service account
  //
  // True for service accounts STACKIT itself creates and operates on the
  // project's behalf, false for accounts a user created for their own
  // automation. Filter on it to keep platform identities out of a review
  // of stale or over-privileged automation credentials.
  internal bool
  // Long-lived access tokens issued for this service account
  //
  // Deprecated in favor of keys. STACKIT retired long-lived service
  // account access tokens on 17 December 2025 and removed the
  // access-token endpoints from the service account API, so this
  // field always reports an empty list. Audit credential age and
  // active status through `keys` and `federatedIdentityProviders`.
  accessTokens() @maturity("deprecated") @replaced_by("stackit.serviceAccount.keys") []dict
  // Long-lived keys associated with this service account
  //
  // Each entry has `id`, `keyType`, `keyAlgorithm`, `keyOrigin`,
  // `active`, `createdAt`, and `validUntil`.
  keys() []dict
  // External identity providers trusted to obtain credentials for this account
  federatedIdentityProviders() []stackit.serviceAccount.federatedIdentityProvider
  // Project role bindings whose subject is this service account
  //
  // Which roles the account holds on the project, read from the project's
  // member list. Direct bindings only; a role granted on the folder or
  // organization is inherited but does not appear here.
  roleBindings() []stackit.iam.member
  // Every role binding the account holds, including inherited ones
  //
  // Resolved by the authorization service across the hierarchy: bindings
  // on this project and bindings on the folder or organization above it
  // that the project inherits. Where roleBindings shows only the
  // project's own list, this is the complete answer to which roles the
  // account holds. Empty when the credential may not read the account's
  // memberships.
  memberships() []stackit.iam.membership
}

// Federated identity provider trusted by a STACKIT service account
//
// External OIDC issuer allowed to exchange its own tokens for credentials
// belonging to one service account, together with the claim conditions a
// presented token must satisfy. Keyed by its UUID `id`. Where `keys` and
// `accessTokens` show credentials that already exist, this shows who can
// mint new ones without holding any: a workload outside STACKIT that
// satisfies the assertions gets whatever the service account can do.
private stackit.serviceAccount.federatedIdentityProvider @defaults("name issuer") {
  // Provider UUID
  id string
  // Provider name
  name string
  // OIDC issuer URL whose tokens are accepted
  //
  // Identifies the external token authority, for example a CI system's OIDC
  // endpoint or another cloud's identity service.
  issuer string
  // Claim conditions a presented token must satisfy
  //
  // Every assertion must match before a token is exchanged. Each entry has
  // `item` (the claim inspected, for example sub or repository), `operator`
  // (the comparison applied), and `value` (the expected claim value). A short
  // or loosely matching assertion list widens which external workloads can
  // take on the service account, so the count and specificity of these
  // entries is what an access review reads.
  assertions []dict
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Service account the provider can obtain credentials for
  serviceAccount() stackit.serviceAccount
}


// STACKIT-managed TLS server certificate
//
// TLS server certificate uploaded to STACKIT for use by Application
// Load Balancer listeners. Selected by its UUID `id`, for example
// stackit.certificate(id: "d290f1ee-6c54-4b01-90e6-d701748f0851").
// The parsed X.509 attributes let audits verify the certificate's
// identity, key strength, signing algorithm, and validity window
// without decoding the PEM chain, and the `usage` field reveals which
// load balancer listeners depend on the certificate.
private stackit.certificate @defaults("id name region") {
  init(id? string)
  // Certificate UUID
  id string
  // User-supplied certificate name
  name string
  // Region the certificate is uploaded to
  region string
  // PEM-encoded certificate chain (leaf + intermediates)
  publicKey string
  // User-defined labels attached to the certificate
  labels map[string]string
  // Subject Alternative Names the certificate is valid for
  //
  // Comma-separated list of all domains and IP addresses covered by
  // the certificate.
  dnsNames string
  // Extended key usages the certificate is valid for
  //
  // Comma-separated list of purposes, for example "Server Auth", which
  // is required for load balancer use.
  extendedKeyUsage string
  // SHA1 thumbprint of the certificate
  fingerprintSha1 string
  // SHA256 hash of the raw certificate bytes
  fingerprintSha256 string
  // Subject common name (CN) of the certificate
  subject string
  // Common name (CN) of the certificate authority that issued the certificate
  issuer string
  // Serial number assigned by the CA, in uppercase hexadecimal
  serialNumber string
  // Public-key algorithm of the key pair, for example RSA or ECDSA
  keyAlgorithm string
  // Public-key strength summary
  //
  // Human-readable description of the key's algorithm and bit length or
  // curve name, for example "RSA 2048", "ECDSA P-256", or "Ed25519".
  keyStrength string
  // Key size in bits
  //
  // Bit length of the public key, for example 2048 for RSA. Null for
  // elliptic-curve keys, which are described by a curve name rather than
  // a bit size (see keyStrength).
  keyBitSize int
  // Algorithm the issuing CA used to sign the certificate
  signingAlgorithm string
  // Start of the certificate validity period
  notBefore time
  // Expiration of the certificate validity period
  notAfter time
  // Load balancer listeners consuming the certificate
  //
  // One entry per load balancer that references the certificate, each
  // with `loadBalancerName` and the `listenerNames` on that load
  // balancer using it ([{loadBalancerName, listenerNames}]).
  usage []dict
  // Organization named in the certificate subject
  organization string
  // Whether the certificate is signed by its own private key
  //
  // True when the certificate was signed by its own key rather than by a
  // trusted third-party certificate authority, as reported by the
  // service. Null when the service reports nothing.
  isSelfSigned bool
  // Whether the certificate is a certificate authority
  //
  // True when the certificate can sign other certificates. A CA
  // certificate uploaded to serve as a server certificate is a finding.
  // Null when the service reports nothing.
  isCa bool
}

// STACKIT Application Load Balancer
//
// STACKIT Application Load Balancer (ALB)
//
// Layer 7 (HTTP) load balancer, the newer product distinct from the
// legacy stackit.loadBalancer. Keyed by name (for example
// stackit.alb.loadBalancers.where(name == "my-alb")), it carries the
// public and private addresses, plan, status, and the listeners and
// target pools that route traffic. The exposure field combines the
// public address with the access-control allow-list to judge internet
// reachability, and wafs surfaces the Web Application Firewall
// configurations the listeners reference.
private stackit.alb.loadBalancer @defaults("name status externalAddress") {
  init(name? string)
  // ALB name (unique within the project+region)
  name string
  // External (public) IPv4/IPv6 address (empty if private-only)
  externalAddress string
  // Internal/private address
  privateAddress string
  // Plan ID (sizing tier)
  planId string
  // Status (STATUS_READY, STATUS_PENDING, STATUS_ERROR, STATUS_TERMINATING, STATUS_UNSPECIFIED)
  status string
  // Region the ALB lives in
  region string
  // Frontend listeners
  //
  // Port and protocol bindings that accept inbound traffic. Each entry is
  // a dict with keys name, port, protocol, http, https, and wafConfigName
  // (the name of the WAF configuration applied to the listener).
  listeners []dict
  // Networks attached to the LB ([{networkId, role}])
  networks []dict
  // Backend target pools
  //
  // Backend server groups that receive forwarded traffic. Each entry is a
  // dict with keys name, targetPort, targets, activeHealthCheck, and
  // tlsConfig.
  targetPools []dict
  // Load balancer options
  //
  // Behavioral settings for the balancer, a dict with keys accessControl
  // (holding allowedSourceRanges, the CIDR allow-list restricting who may
  // reach the balancer), ephemeralAddress, observability, and
  // privateNetworkOnly.
  options dict
  // Errors reported by the ALB ([{type, description}])
  errors []dict
  // STACKIT-managed security group
  //
  // Deprecated in favor of managedSecurityGroup, which resolves
  // the same group to the stackit.securityGroup it names. A dict with keys
  // id and name. Null when none is assigned.
  loadBalancerSecurityGroup @maturity("deprecated") @replaced_by("stackit.alb.loadBalancer.managedSecurityGroup") dict
  // STACKIT-managed target security group
  //
  // Deprecated in favor of managedTargetSecurityGroup, which resolves the same
  // group to the stackit.securityGroup it names. A dict with keys id and
  // name. Null when none is assigned.
  targetSecurityGroup @maturity("deprecated") @replaced_by("stackit.alb.loadBalancer.managedTargetSecurityGroup") dict
  // Security group STACKIT manages for the balancer itself (nullable)
  //
  // Resolved against the project's security groups. Null when no managed
  // group is assigned, which is the finding this field exists to surface.
  managedSecurityGroup() stackit.securityGroup
  // Security group STACKIT manages for the backend targets (nullable)
  //
  // Null when no managed group is assigned, for example when
  // disableTargetSecurityGroupAssignment is set.
  managedTargetSecurityGroup() stackit.securityGroup
  // Whether the operator opted out of auto-assigning the target SG to backends
  disableTargetSecurityGroupAssignment bool
  // User-defined labels
  labels map[string]string
  // Internet-exposure breakdown (public address combined with the access-control allow-list)
  exposure() stackit.network.exposure
  // Web Application Firewall configurations referenced by the LB's listeners
  wafs() []stackit.alb.waf
  // CIDR allow-list of client networks permitted to reach the balancer
  //
  // From options.accessControl.allowedSourceRanges. Empty when no
  // allow-list is configured, which leaves a public balancer reachable
  // from any address.
  allowedSourceRanges() []string
  // Whether the public address is a managed ephemeral one
  //
  // True when STACKIT allocates and releases the public IP with the
  // balancer rather than binding a reserved address. Null when the
  // options carry no setting.
  ephemeralAddress() bool
  // Endpoint the balancer pushes access logs to
  //
  // From options.observability.logs.pushUrl, an egress destination for
  // request logs. Empty when logs are not shipped.
  observabilityLogsPushUrl() string
  // Endpoint the balancer pushes metrics to
  //
  // From options.observability.metrics.pushUrl. Empty when metrics are
  // not shipped.
  observabilityMetricsPushUrl() string
  // Certificates terminated by the balancer's HTTPS listeners
  //
  // Every certificate referenced by a listener's certificateConfig,
  // deduplicated. Follow it to read notAfter, isSelfSigned, and
  // keyStrength for the certificates actually serving traffic. Empty when
  // no listener terminates TLS.
  certificates() []stackit.certificate
  // Ports of listeners that accept plaintext HTTP
  //
  // Listener ports whose protocol is PROTOCOL_HTTP rather than
  // PROTOCOL_HTTPS. Empty when every listener terminates TLS.
  plaintextListenerPorts() []int
  // Target pools whose TLS bridging skips certificate validation
  //
  // Names of pools with tlsConfig.skipCertificateValidation set, which the
  // service documents as insecure and for testing only. Empty when no pool
  // does.
  insecureTargetPools() []string
}

// STACKIT Application Load Balancer WAF configuration
//
// Web Application Firewall configuration that a load balancer listener can
// reference by name to inspect and filter inbound HTTP traffic. The
// configuration is keyed by its name and binds a managed rule set and a
// custom rule group, both resolvable as managedRuleSet and customRuleGroup.
private stackit.alb.waf @defaults("name managedRuleSetName customRuleGroupName") {
  init(name? string)
  // WAF configuration name (unique within the project+region)
  name string
  // Name of the managed rule set bound to the configuration (empty if none)
  managedRuleSetName string
  // Managed rule set bound to the configuration
  managedRuleSet() stackit.alb.managedRuleSet
  // Name of the custom rule group bound to the configuration (empty if none)
  customRuleGroupName string
  // Custom rule group bound to the configuration
  customRuleGroup() stackit.alb.customRuleGroup
  // User-defined labels
  labels map[string]string
  // Application load balancers whose listeners enforce this WAF
  //
  // From the usage the service reports for the configuration. Empty for
  // a WAF that is configured but attached to no listener, so it protects
  // nothing.
  loadBalancers() []stackit.alb.loadBalancer
}

// STACKIT Application Load Balancer managed rule set
//
// Provider-maintained set of Web Application Firewall rules, grouped and
// individually toggled between blocking and detection behavior. The set is
// keyed by its name and exposes the rule set type and version and the rule
// groups, each holding the per-rule mode.
private stackit.alb.managedRuleSet @defaults("name type version") {
  init(name? string)
  // Managed rule set name (unique within the project+region)
  name string
  // Rule set type
  type string
  // Rule set version
  version string
  // Rules in the set, each toggled between blocking and detection behavior
  rules() []stackit.alb.managedRule
  // WAF configurations that bind this rule set
  //
  // From the usage the service reports. Empty for a rule set no WAF
  // references.
  wafs() []stackit.alb.waf
}

// STACKIT Application Load Balancer managed rule
//
// Single rule within a managed rule set, identified by its rule name. The
// mode determines how a matching request is handled: MODE_ENABLED blocks
// it, MODE_LOG_ONLY only records it, and MODE_DISABLED turns the rule off.
// Also exposes the rule group the rule belongs to, its severity, and its
// description.
private stackit.alb.managedRule @defaults("name groupName mode severity") {
  // Rule name (identifier within the managed rule set)
  name string
  // Name of the rule group the rule belongs to
  groupName string
  // Mode applied to the rule (MODE_ENABLED, MODE_DISABLED, MODE_LOG_ONLY, MODE_UNSPECIFIED)
  mode string
  // Rule severity (CRITICAL, ERROR, WARNING, INFO)
  severity string
  // Rule description
  description string
}

// STACKIT Application Load Balancer custom rule group
//
// User-defined group of Web Application Firewall rules that match on
// request attributes and apply a behavior. The group is keyed by its name
// and exposes the custom rules it contains.
private stackit.alb.customRuleGroup @defaults("name") {
  init(name? string)
  // Custom rule group name (unique within the project+region)
  name string
  // Custom rules the group contains
  rules() []stackit.alb.customRule
  // WAF configurations that bind this rule group
  //
  // From the usage the service reports. Empty for a group no WAF
  // references.
  wafs() []stackit.alb.waf
}

// STACKIT Application Load Balancer custom rule
//
// User-defined Web Application Firewall rule within a custom rule group,
// identified by its numeric id. Exposes the match conditions and the
// behavior applied when they match: the action taken (ACTION_ALLOW,
// ACTION_DENY, ACTION_PASS), whether the match is logged, the log message,
// and the severity recorded.
private stackit.alb.customRule @defaults("id action severity") {
  // Rule ID (unique within the custom rule group)
  id int
  // Rule description
  description string
  // Action applied when the conditions match (ACTION_ALLOW, ACTION_DENY, ACTION_PASS, ACTION_UNSPECIFIED)
  action string
  // Whether a match is logged
  log bool
  // Log message emitted on a match
  logMsg string
  // Severity recorded for a match
  //
  // One of SEVERITY_EMERGENCY, SEVERITY_ALERT, SEVERITY_CRITICAL,
  // SEVERITY_ERROR, SEVERITY_WARNING, SEVERITY_NOTICE, SEVERITY_INFO, or
  // SEVERITY_DEBUG.
  severity string
  // Match conditions that must hold for the rule to apply
  conditions() []stackit.alb.customRuleCondition
}

// STACKIT Application Load Balancer custom rule condition
//
// Single match condition of a custom Web Application Firewall rule. The
// condition tests a request variable against a value using an operator,
// after applying any transformations. For example variableType
// REQUEST_HEADERS with variableValue "User-Agent", operatorType CONTAINS
// with operatorValue "curl", and a LOWERCASE transformation.
private stackit.alb.customRuleCondition @defaults("variableType operatorType operatorValue") {
  // Request attribute the condition inspects (for example REQUEST_HEADERS, REQUEST_URI)
  variableType string
  // Specifier for the variable, such as a header name (empty when not applicable)
  variableValue string
  // Operator applied to the variable (for example CONTAINS, EQUALS, REGEX)
  operatorType string
  // Value the operator compares the variable against
  operatorValue string
  // Transformations applied to the variable before evaluation (for example LOWERCASE, URL_DECODE)
  transformations []string
}

// STACKIT KMS namespace
//
// Key Management Service (KMS) scope for a project, exposing the
// cryptographic key rings and the keys within them. STACKIT KMS is the
// source of the KEKs that wrap volume- and bucket-level
// data-encryption keys, so this is the entry point for
// customer-managed-key audits.
stackit.kms {
  // Key rings in the project's KMS scope
  keyRings() []stackit.kms.keyRing
  // All keys across all key rings (flattened convenience)
  keys() []stackit.kms.key
}

// STACKIT KMS key ring
//
// Logical container that groups KMS keys for IAM and lifecycle
// purposes. Keyed by its UUID `id`, for example
// `stackit.kms.keyRing(id: "...")`.
private stackit.kms.keyRing @defaults("id displayName state") {
  init(id? string)
  // Key ring UUID
  id string
  // User-supplied display name
  displayName string
  // Description (free text)
  description string
  // Lifecycle state (creating, active, deleted)
  state string
  // Creation timestamp
  createdAt time
  // Keys inside this key ring
  keys() []stackit.kms.key
  // Wrapping keys used to import external key material into the ring
  wrappingKeys() []stackit.kms.wrappingKey
}

// STACKIT KMS wrapping key
//
// Public key used to encrypt externally generated key material before
// importing it into a key ring, keyed by its UUID `id`. Unlike the keys it
// protects, a wrapping key carries an `expiresAt` and stops being usable
// after it, so a ring whose import path depends on an expired or
// soon-expiring wrapping key cannot take new material. The `algorithm`
// and `protection` describe the wrapping primitive and where the private
// half is held.
private stackit.kms.wrappingKey @defaults("displayName state expiresAt") {
  // Wrapping key UUID
  id string
  // Display name
  displayName string
  // Description (free text)
  description string
  // Wrapping algorithm (for example rsa_4096_oaep_sha256)
  algorithm string
  // Purpose the wrapping key serves
  //
  // One of wrap_symmetric_key or wrap_asymmetric_key.
  purpose string
  // Protection level backing the private half (software, hsm)
  protection string
  // Access scope (PUBLIC, SNA)
  accessScope string
  // Lifecycle state
  //
  // One of active, creating, expired, deleted, or
  // key_material_unavailable. An expired wrapping key can no longer
  // accept key material for import.
  state string
  // Expiration, after which the wrapping key can no longer wrap material
  expiresAt time
  // Creation timestamp
  createdAt time
  // PEM-encoded public half used to wrap key material
  publicKey string
  // Key ring the wrapping key belongs to
  keyRing() stackit.kms.keyRing
}

// STACKIT KMS key
//
// Cryptographic key managed by STACKIT KMS. Each key is keyed by its
// UUID `id` and is scoped to a `keyRingId`. The `purpose` describes
// what the key is allowed to do (SYMMETRIC_ENCRYPT_DECRYPT and
// siblings), `algorithm` is the underlying primitive, `protection` is
// the storage backend (SOFTWARE, HSM), and `state` is the lifecycle
// state. `deletionDate` is non-null only when the key has been
// scheduled for deletion.
private stackit.kms.key @defaults("id displayName state purpose") {
  // Key UUID
  id string
  // Parent key ring UUID
  keyRingId string
  // Key ring the key belongs to
  keyRing() stackit.kms.keyRing
  // Display name
  displayName string
  // Description
  description string
  // Purpose (symmetric_encrypt_decrypt, asymmetric_encrypt_decrypt, message_authentication_code, asymmetric_sign_verify)
  purpose string
  // Algorithm (e.g., aes_256_gcm, rsa_4096_oaep_sha256, ecdsa_p256_sha256)
  algorithm string
  // Protection level backing the key material (software, hsm)
  protection string
  // Access scope (PUBLIC, SNA)
  accessScope string
  // Whether the key material was imported (cannot be rotated server-side)
  importOnly bool
  // Lifecycle state (active, deleted, not_available, errors_exist, creating, no_version)
  state string
  // Creation timestamp
  createdAt time
  // Scheduled deletion timestamp (nil unless the key is in PENDING_DELETION)
  deletionDate time
  // Versions of the key
  versions() []stackit.kms.key.version
}

// STACKIT KMS key version
//
// One generation of key material under a KMS key. Rotation creates a new
// version and leaves the previous ones in place to decrypt existing
// ciphertext, so the newest version's `createdAt` is what a key-age or
// rotation-interval check reads, and `disabled` plus `state` tell you which
// generations can still be used. `destroyDate` is set only once a version
// has been scheduled for destruction.
private stackit.kms.key.version @defaults("number state disabled") {
  // Version number, increasing with each rotation
  number int
  // Lifecycle state (active, creating, destroyed, …)
  state string
  // Whether the version has been disabled and can no longer be used
  disabled bool
  // When the version's key material was created
  createdAt time
  // Scheduled destruction timestamp, null unless destruction was requested
  destroyDate time
  // PEM-encoded public half, for asymmetric keys only
  publicKey string
}

// STACKIT IAM namespace
//
// Project-level identity and access management for a STACKIT project:
// the member bindings that grant principals access and the roles
// defined on the project. This namespace is the source for
// least-privilege and stale-access audits. Enumerate the bindings
// with members and the roles with roles.
stackit.iam {
  // Members bound to the project (one entry per (subject, role) pair)
  members() []stackit.iam.member
  // Roles defined on the project
  roles() []stackit.iam.role
  // Kind of resource the bindings and roles belong to
  //
  // Always project: the provider reads the project's direct bindings. A
  // role granted on the folder or organization above it is inherited by
  // the project but is not part of this list.
  resourceType() string
  // ID of the project the bindings and roles belong to
  resourceId() string
}

// STACKIT IAM project member
//
// Single project member binding that ties one principal (a user email,
// service-account email, or group identifier) to one role on the
// project. Each binding is keyed by `subject/role`, so the same
// principal appears once per role it holds. Audit these bindings to
// find over-privileged or stale access.
private stackit.iam.member @defaults("subject role") {
  // Principal identifier (user/service-account email, group id)
  subject string
  // Role assigned to the subject
  role string
  // Role definition the binding grants (nullable)
  //
  // Catalog entry for the role named by role, carrying the permissions the
  // binding actually confers on the subject. Follow it to turn a binding
  // into the concrete actions it allows, which is what a least-privilege
  // review compares against. Null when the project role catalog cannot be
  // read or no longer defines that role.
  roleDetails() stackit.iam.role
  // Service account the binding grants the role to (nullable)
  //
  // Resolved when the subject is one of the project's service accounts.
  // Null for a human user or a group; the API does not mark the subject
  // kind, so membership in the project's service-account list is the test.
  serviceAccount() stackit.serviceAccount
}

// Role binding held by an identity anywhere in the STACKIT hierarchy
//
// One binding as the authorization service resolves it for an identity:
// the `role`, the `subject`, and the container it is granted on
// (`resourceType` project, folder, or organization and its
// `resourceId`). `inherited` is true when the container is not the
// scanned project, which is how a folder or organization grant reaches
// the project without appearing in its member list.
private stackit.iam.membership @defaults("subject role resourceType inherited") {
  // Identity the role is granted to
  subject string
  // Role name
  role string
  // Kind of container the binding is on (project, folder, or organization)
  resourceType string
  // ID of the container the binding is on
  resourceId string
  // Whether the binding is held above the scanned project
  inherited bool
}

// STACKIT IAM role
//
// Single role defined on the project, grouping the set of `permissions`
// that members assigned to it are granted. Inspect a role to see the
// exact actions it confers when reviewing what a member binding allows.
private stackit.iam.role @defaults("name") {
  // Role name (unique within the project)
  name string
  // Description (free text)
  description string
  // Permissions granted by the role (`<resource>.<action>` strings)
  permissions []string
  // Role UUID
  //
  // Stable across renames; the key the authorization API takes for a
  // single role.
  id string
  // Change token of the role definition
  //
  // Changes whenever the permission set changes, so a custom role that
  // drifted from its reviewed definition can be caught without diffing
  // permissions.
  etag string
  // What each permission allows, keyed by permission name
  //
  // The description the service attaches to every permission in
  // permissions, so a permission string can be reviewed without looking
  // it up.
  permissionDescriptions map[string]string
  // Bindings that grant this role on the project
  //
  // Direct project bindings only; grants inherited from the folder or
  // organization are not in the project's member list.
  members() []stackit.iam.member
}

// STACKIT VPN namespace
//
// Site-to-site VPN gateways in the project and, through each gateway, the
// connections and the encrypted tunnels that carry traffic. Enumerate the
// gateways with gateways.
stackit.vpn {
  // VPN gateways
  gateways() []stackit.vpn.gateway
}

// STACKIT VPN gateway
//
// Site-to-site VPN gateway that terminates encrypted tunnels for a
// project. The gateway is keyed by its UUID id and exposes the display
// name, state, routing type, plan, the availability zones its two tunnel
// endpoints run in, the border gateway protocol settings, and its
// connections.
private stackit.vpn.gateway @defaults("id name status routingType") {
  init(id? string)
  // Gateway UUID
  id string
  // Display name
  name string
  // Gateway state (READY, PENDING, DELETING, ERROR)
  status string
  // Routing type (ROUTE_BASED, POLICY_BASED, BGP_ROUTE_BASED)
  routingType string
  // Plan ID (sizing tier)
  planId string
  // Availability zone the first tunnel endpoint runs in
  tunnel1AvailabilityZone string
  // Availability zone the second tunnel endpoint runs in
  tunnel2AvailabilityZone string
  // Local autonomous system number advertised over the border gateway protocol
  bgpLocalAsn int
  // Routes advertised over the border gateway protocol in place of the automatically derived set
  bgpOverrideAdvertisedRoutes []string
  // User-defined labels
  labels map[string]string
  // Connections configured on the gateway
  connections() []stackit.vpn.gateway.connection
  // Public addresses of the gateway's tunnel endpoints
  //
  // The internet-facing surface of the VPN, from the gateway's live
  // status. Empty when the status names none; null when the status could
  // not be read.
  publicIps() []string
  // Failure the gateway is in, from its live status
  //
  // Empty when healthy; null when the status could not be read.
  errorMessage() string
  // BGP sessions held by the gateway's tunnel instances
  //
  // One per remote peer, with the session state and the prefixes
  // exchanged. Empty for a gateway with static routing; null when the
  // status could not be read.
  bgpPeers() []stackit.vpn.gateway.bgpPeer
}

// BGP session on a STACKIT VPN gateway
//
// One BGP peering the gateway's tunnel instance holds with a remote
// router, from the gateway's live status: the peer address and AS
// numbers, the session `state`, its uptime, and how many prefixes were
// received and sent. A session that is not established means the
// dynamic routes behind that peer are not being exchanged.
private stackit.vpn.gateway.bgpPeer @defaults("tunnel remoteIp state") {
  // Tunnel instance holding the session (tunnel1 or tunnel2)
  tunnel string
  // Peer router address
  remoteIp string
  // Peer autonomous system number
  remoteAsn int
  // Gateway autonomous system number
  localAsn int
  // BGP session state as reported by the gateway
  state string
  // Session uptime as reported by the gateway
  uptime string
  // Prefixes received from the peer
  prefixesReceived int
  // Prefixes sent to the peer
  prefixesSent int
}

// STACKIT VPN connection
//
// Single site-to-site connection on a VPN gateway, keyed by its UUID id.
// The connection exposes whether it is enabled, the local and remote
// subnets it routes between, any static routes, and its two redundant
// encrypted tunnels.
private stackit.vpn.gateway.connection @defaults("id name enabled") {
  // Connection UUID
  id string
  // Display name
  name string
  // Whether the connection is enabled
  enabled bool
  // Local subnets routed into the tunnel (CIDR)
  localSubnets []string
  // Remote subnets reachable across the tunnel (CIDR)
  remoteSubnets []string
  // Static routes configured on the connection (CIDR)
  staticRoutes []string
  // User-defined labels
  labels map[string]string
  // First (primary) encrypted tunnel
  tunnel1() stackit.vpn.tunnel
  // Second (redundant) encrypted tunnel
  tunnel2() stackit.vpn.tunnel
}

// STACKIT VPN tunnel
//
// Single encrypted tunnel of a VPN connection, terminating at a remote
// peer. Exposes the peer address, the border gateway protocol and peering
// addressing, and the negotiated cryptographic parameters for both the key
// exchange (IKE) and the data channel (IPsec/ESP): the Diffie-Hellman
// groups, encryption and integrity algorithms, and rekey intervals. Use
// these to flag tunnels that permit weak ciphers or groups.
private stackit.vpn.tunnel @defaults("remoteAddress") {
  // Remote peer IP address
  remoteAddress string
  // Remote autonomous system number for the border gateway protocol (0 if unset)
  bgpRemoteAsn int
  // Local peering address (empty if unset)
  peeringLocalAddress string
  // Remote peering address (empty if unset)
  peeringRemoteAddress string
  // Key-exchange Diffie-Hellman groups offered
  phase1DhGroups []string
  // Key-exchange encryption algorithms offered
  phase1EncryptionAlgorithms []string
  // Key-exchange integrity algorithms offered
  phase1IntegrityAlgorithms []string
  // Key-exchange rekey interval in seconds (0 if unset)
  phase1RekeyTime int
  // Data-channel Diffie-Hellman groups offered
  phase2DhGroups []string
  // Data-channel encryption algorithms offered
  phase2EncryptionAlgorithms []string
  // Data-channel integrity algorithms offered
  phase2IntegrityAlgorithms []string
  // Data-channel rekey interval in seconds (0 if unset)
  phase2RekeyTime int
  // Action taken on dead-peer detection (clear, restart)
  dpdAction string
  // Action taken when establishing the data channel (none, start)
  startAction string
  // Whether the tunnel is currently established
  //
  // From the gateway's live status. Null when the status could not be
  // read or does not carry this tunnel.
  established() bool
  // Key-exchange phase state (for example ESTABLISHED)
  //
  // Null when the status could not be read.
  phase1State() string
  // Diffie-Hellman group actually negotiated for the key exchange
  //
  // The peers may settle on any group offered in phase1DhGroups; this is
  // the one in use. Null when the status could not be read.
  negotiatedPhase1DhGroup() string
  // Encryption algorithm actually negotiated for the key exchange
  //
  // Null when the status could not be read.
  negotiatedPhase1EncryptionAlgorithm() string
  // Integrity algorithm actually negotiated for the key exchange
  //
  // Null when the status could not be read.
  negotiatedPhase1IntegrityAlgorithm() string
  // Data-channel phase state (for example INSTALLED)
  //
  // Null when the status could not be read.
  phase2State() string
  // Diffie-Hellman group actually negotiated for the data channel
  //
  // Null when the status could not be read.
  negotiatedPhase2DhGroup() string
  // Encryption algorithm actually negotiated for the data channel
  //
  // The peers may settle on any algorithm offered in
  // phase2EncryptionAlgorithms; this is the one protecting traffic. Null
  // when the status could not be read.
  negotiatedPhase2EncryptionAlgorithm() string
  // Integrity algorithm actually negotiated for the data channel
  //
  // Null when the status could not be read.
  negotiatedPhase2IntegrityAlgorithm() string
  // Encapsulation negotiated for the data channel (for example UDP)
  //
  // Null when the status could not be read.
  negotiatedPhase2Encapsulation() string
}
