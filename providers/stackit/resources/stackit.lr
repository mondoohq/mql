import core

option provider = "go.mondoo.com/mql/providers/stackit"
option go_package = "go.mondoo.com/mql/providers/stackit/resources"
option root = "stackit"

// STACKIT project
//
// Project-scoped entry point for the stackit provider, covering the
// full estate of a single STACKIT project. The `project` field carries
// the project's metadata (parent organization, lifecycle state, labels)
// and `region` reports the region the connection targets. From here you
// can reach the IaaS layer (compute servers, block storage volumes,
// snapshots, backups, images, networks, public IPs, security groups,
// SSH key pairs), managed Kubernetes through `ske`, S3-compatible object
// storage, managed NFS file storage, managed DNS, load balancers, the
// managed database namespaces (Postgres Flex, MongoDB Flex, SQLServer
// Flex, OpenSearch, MariaDB, Redis, RabbitMQ, LogMe), the secrets vault,
// the managed Prometheus/Alertmanager stack, key management, project
// IAM bindings, and service accounts. Use it to audit what a project
// exposes and how its resources are configured.
stackit @root {
  // STACKIT project the connection is scoped to
  project() stackit.project
  // Region the connection targets (e.g., eu01)
  region() string
  // Compute servers (virtual machines)
  servers() []stackit.server
  // Project backup policies for servers
  //
  // The schedule-and-retention templates a server backup schedule is
  // created from, including which one applies by default.
  serverBackupPolicies() []stackit.server.backupPolicy
  // Project update policies for servers
  //
  // The cadence-and-maintenance-window templates a server update schedule
  // is created from, including which one applies by default.
  serverUpdatePolicies() []stackit.server.updatePolicy
  // Block storage volumes
  volumes() []stackit.volume
  // Volume snapshots
  snapshots() []stackit.snapshot
  // Volume backups
  backups() []stackit.backup
  // Server affinity and anti-affinity placement groups
  affinityGroups() []stackit.affinityGroup
  // VM images
  images() []stackit.image
  // Project networks
  networks() []stackit.network
  // Public (floating) IP addresses
  publicIps() []stackit.publicIp
  // Security groups
  securityGroups() []stackit.securityGroup
  // SSH key pairs available in the project
  keyPairs() []stackit.keyPair
  // Load balancers
  loadBalancers() []stackit.loadBalancer
  // Managed Kubernetes (SKE) namespace
  ske() stackit.ske
  // S3-compatible object storage namespace
  objectStorage() stackit.objectStorage
  // Managed NFS file storage (SFS) namespace
  sfs() stackit.sfs
  // Managed DNS namespace
  dns() stackit.dns
  // Postgres Flex managed database namespace
  postgresFlex() stackit.postgresFlex
  // MongoDB Flex managed database namespace
  mongoDbFlex() stackit.mongoDbFlex
  // SQLServer Flex managed database namespace
  sqlServerFlex() stackit.sqlServerFlex
  // OpenSearch managed namespace
  openSearch() stackit.openSearch
  // MariaDB managed namespace
  mariaDb() stackit.mariaDb
  // Redis managed namespace
  redis() stackit.redis
  // RabbitMQ managed namespace
  rabbitMq() stackit.rabbitMq
  // LogMe (managed Grafana Loki/OpenSearch logging) namespace
  logMe() stackit.logMe
  // Secrets Manager namespace
  secretsManager() stackit.secretsManager
  // Observability (managed Prometheus/Alertmanager) namespace
  observability() stackit.observability
  // Telemetry routing and federation namespace
  telemetry() stackit.telemetry
  // Managed AI Model Serving namespace
  modelServing() stackit.modelServing
  // Site-to-site VPN namespace (gateways, connections, tunnels)
  vpn() stackit.vpn
  // Project service accounts
  serviceAccounts() []stackit.serviceAccount
  // TLS server certificates managed by STACKIT Certificates
  certificates() []stackit.certificate
  // Application Load Balancers separate from the legacy loadBalancers product
  albLoadBalancers() []stackit.alb.loadBalancer
  // Web Application Firewall configurations for Application Load Balancers
  albWafs() []stackit.alb.waf
  // Key Management Service namespace (key rings + keys)
  kms() stackit.kms
  // Project-level IAM bindings (members) and roles
  iam() stackit.iam
}

// STACKIT project metadata
//
// Metadata for the project the connection is scoped to. Projects are
// the container that owns STACKIT resources, so this record identifies
// which project a scan ran against and its administrative state. The
// `id` is the project UUID and `containerId` the human-readable container
// identifier; `parent` and `parentType` name the owning organization or
// folder, and `organization` and `folders` resolve the chain above it.
// `lifecycleState` (one of CREATING, ACTIVE, DELETING, INACTIVE) tells
// you whether the project is usable or being torn down. The `labels` map
// holds user-defined key/value tags.
private stackit.project @defaults("id name lifecycleState") {
  // Project UUID
  id string
  // Project container ID
  //
  // The human-readable identifier every resource-manager endpoint is
  // keyed by, distinct from the UUID in id. This is the value the STACKIT
  // portal shows for the project.
  containerId string
  // Project name
  name string
  // Parent container ID (organization or folder)
  parent string
  // Kind of the parent container
  //
  // One of ORGANIZATION or FOLDER. Tells you whether the project sits
  // directly under its organization or inside a folder; only in the
  // second case does folders carry entries.
  parentType string
  // Lifecycle state (CREATING, ACTIVE, DELETING, INACTIVE)
  lifecycleState string
  // Creation timestamp
  creationTime time
  // Last change to the project's metadata (name, parent, or labels)
  updateTime time
  // User-defined labels
  labels map[string]string
  // Organization that owns the project (nullable)
  //
  // Read from the project's own record, so a project-scoped credential
  // learns its organization without organization-level access. The
  // organization's lifecycleState, labels, and timestamps are read on
  // demand and stay null when the credential cannot read it. Null when
  // the record names no organization.
  organization() stackit.organization
  // Folders between the project and its organization, nearest first
  //
  // Empty when the project sits directly under the organization.
  folders() []stackit.folder
}

// STACKIT organization
//
// The organization at the top of a project's container hierarchy, keyed
// by its UUID `id`, for example `stackit.organization(id: "...")`.
// `containerId` is the human-readable identifier the portal shows.
// Reached from `stackit.project.organization`, where the identity fields
// come from the project's own record and the rest is read on demand.
stackit.organization @defaults("id name") {
  init(id? string)
  // Organization UUID
  id string
  // Organization container ID
  containerId string
  // Display name
  name string
  // Lifecycle state (CREATING, ACTIVE, DELETING, INACTIVE)
  //
  // Null when the credential cannot read the organization.
  lifecycleState() string
  // User-defined labels
  //
  // Null when the credential cannot read the organization.
  labels() map[string]string
  // Creation timestamp
  //
  // Null when the credential cannot read the organization.
  creationTime() time
  // Last change to the organization's metadata
  //
  // Null when the credential cannot read the organization.
  updateTime() time
}

// STACKIT folder
//
// A folder in the container hierarchy between a project and its
// organization, keyed by its container ID, for example
// `stackit.folder(containerId: "...")`. Reached from
// `stackit.project.folders`, where the identity fields come from the
// project's own record and the rest is read on demand.
stackit.folder @defaults("containerId name") {
  init(containerId? string)
  // Folder UUID
  id string
  // Folder container ID
  containerId string
  // Display name
  name string
  // User-defined labels
  //
  // Null when the credential cannot read the folder.
  labels() map[string]string
  // Creation timestamp
  //
  // Null when the credential cannot read the folder.
  creationTime() time
  // Last change to the folder's metadata
  //
  // Null when the credential cannot read the folder.
  updateTime() time
}

// STACKIT compute server
//
// Single virtual machine in a STACKIT project, keyed by its UUID `id`
// (for example `stackit.server(id: "fa1d2...")`). Central to auditing a
// project's compute posture: the attached volumes and their encryption
// state, the security groups and network interfaces that govern who can
// reach the instance, whether a virtual TPM backs measured boot, the
// image and SSH key pair it booted from, and the service accounts,
// backups, and operating-system update runs bound to it. The exposure
// breakdown pairs a public IP with security group ingress to flag
// servers reachable from the internet.
private stackit.server @defaults("id name status machineType") {
  init(id? string)
  // Server UUID
  id string
  // Server name
  name string
  // Server status
  //
  // One of ACTIVE, BACKING-UP, CREATING, DEALLOCATED, DEALLOCATING,
  // DELETED, DELETING, ERROR, INACTIVE, MIGRATING, PAUSED, REBOOT,
  // REBOOTING, REBUILD, REBUILDING, RESCUE, RESCUING, RESIZING,
  // RESTORING, SNAPSHOTTING, STARTING, STOPPING, UNRESCUING, or
  // UPDATING.
  status string
  // Power status (RUNNING, STOPPED, CRASHED, ERROR)
  powerStatus string
  // Machine type / flavor name
  machineType string
  // Availability zone
  availabilityZone string
  // Creation timestamp
  createdAt time
  // Launch timestamp
  launchedAt time
  // Last update timestamp
  updatedAt time
  // Last error message reported by the server (empty if none)
  errorMessage string
  // Whether a config drive is attached
  configDrive bool
  // SSH key pair name used at boot (empty if none)
  keypairName string
  // SSH key pair used at boot (nullable)
  keyPair() stackit.keyPair
  // Image ID the server was created from (empty for boot-volume-only servers)
  imageId string
  // Image the server was created from (nullable)
  image() stackit.image
  // Volume UUIDs attached to the server
  volumeIds []string
  // Volumes attached to the server
  volumes() []stackit.volume
  // Whether the boot volume is deleted when the server is terminated
  //
  // Decides whether the boot disk and the data on it survive deletion of the
  // server, which is the difference between a disk being available for
  // forensic review afterwards and being destroyed with the instance. Null
  // when the server boots straight from an image and so has no boot volume,
  // and when the API reports no setting for it.
  bootVolumeDeleteOnTermination bool
  // Volume holding the root disk (nullable)
  //
  // The volume the server boots from, so a check can ask about the OS
  // disk specifically rather than the whole set in volumes: whether it is
  // encrypted with a customer-managed key (encryptionKey), which image it
  // was built from, or whether it is a clone. Null when the server boots
  // straight from an image and has no boot volume.
  bootVolume() stackit.volume
  // Security group IDs attached to the server
  securityGroupIds []string
  // Security groups attached to the server
  securityGroups() []stackit.securityGroup
  // Internet-exposure breakdown (public IP combined with security group ingress)
  exposure() stackit.network.exposure
  // Service accounts attached to the server
  serviceAccounts() []stackit.serviceAccount
  // Network interfaces attached to the server
  networkInterfaces() []stackit.nic
  // Whether the STACKIT server agent is provisioned on the server
  //
  // The agent is what the Server Backup and Server Update services talk to,
  // so a server without it reports no backups and no update runs regardless
  // of how those services are configured. Read it alongside `backups` and
  // `updates` to tell an empty result that reflects the configuration from
  // one that reflects a server nothing can be collected from. Null when the
  // API reports no provisioning setting, in which case the outcome follows
  // the default of the image the server booted from and is not readable from
  // the server itself.
  agentProvisioned bool
  // Point-in-time backups taken from the server by the Server Backup service
  backups() []stackit.server.backup
  // Recurring backup schedules attached to the server
  backupSchedules() []stackit.server.backupSchedule
  // Operating-system update runs applied to the server by the Server Update service
  updates() []stackit.server.update
  // Recurring maintenance schedules attached to the server
  updateSchedules() []stackit.server.updateSchedule
  // Whether the Server Backup service is enabled for this server
  //
  // Separates "no backups because the service is off" from "no backups
  // yet". Null when the service does not know the server or the
  // credential cannot read it.
  backupServiceEnabled() bool
  // Whether the Server Update service is enabled for this server
  //
  // Separates "no update runs because the service is off" from "no runs
  // yet". Null when the service does not know the server or the
  // credential cannot read it.
  updateServiceEnabled() bool
  // User data (base64-encoded cloud-init)
  userData string
  // User-defined labels
  labels map[string]string
  // Free-form metadata key/value pairs
  metadata map[string]string
}

// STACKIT block storage volume
//
// Block storage volume that backs compute instances, keyed by its UUID
// `id` (for example `stackit.volume(id: "...")`). Reports the volume's
// size in GiB, lifecycle status, and availability zone, whether it is
// encrypted at rest and which key-encryption key wraps its data key, the
// image, snapshot, or backup it was created from, and the server it is
// attached to. Use it to audit unattached, unencrypted, or oversized volumes.
private stackit.volume @defaults("id name size status") {
  init(id? string)
  // Volume UUID
  id string
  // Volume name
  name string
  // Description
  description string
  // Size in GiB
  size int
  // Volume status
  //
  // One of ATTACHED, ATTACHING, AVAILABLE, AWAITING-TRANSFER, BACKING-UP,
  // CREATING, DELETED, DELETING, DETACHING, DOWNLOADING, ERROR,
  // ERROR_BACKING-UP, ERROR_DELETING, ERROR_RESIZING,
  // ERROR_RESTORING-BACKUP, ERROR_KMS-ENCRYPTION-PARAMS, MAINTENANCE,
  // RESERVED, RESIZING, RESTORING-BACKUP, RETYPING, or UPLOADING.
  status string
  // Availability zone
  availabilityZone string
  // Performance class (storage_premium, storage_standard, …)
  performanceClass string
  // Whether the volume is bootable
  bootable bool
  // Source image UUID (empty if not image-based)
  imageId string
  // Image the volume was created from (nullable)
  image() stackit.image
  // Source snapshot UUID (empty if not snapshot-based)
  sourceSnapshotId string
  // Snapshot the volume was created from (nullable)
  sourceSnapshot() stackit.snapshot
  // Source backup UUID (empty if not backup-based)
  sourceBackupId string
  // Backup the volume was created from (nullable)
  sourceBackup() stackit.backup
  // Volume this one was cloned from (nullable)
  //
  // Set when the volume's source type is `volume`, that is, the volume
  // was created as a copy of another volume in the project. Null for
  // volumes created from an image, snapshot, or backup.
  sourceVolume() stackit.volume
  // Server the volume is attached to (nullable)
  server() stackit.server
  // Attached server UUID (empty if detached)
  serverId string
  // Whether the volume is encrypted at rest
  encrypted bool
  // Key-encryption-key UUID that wraps the volume data-encryption key
  //
  // Deprecated in favor of encryptionKey, which resolves the same UUID to
  // the Key Management Service key it names. Empty when the volume uses
  // platform-managed encryption.
  encryptionKeyId @maturity("deprecated") string
  // Key that wraps the volume data-encryption key (nullable)
  //
  // Customer-managed key from Key Management Service whose material wraps
  // this volume data-encryption key. Null when the volume relies on
  // platform-managed encryption, and null when the key is no longer present
  // in the project key rings. Follow it to read the key state, whether the
  // key is importOnly, and the createdAt of its newest version, which is
  // what a key-rotation check reads.
  encryptionKey() stackit.kms.key
  // KEK version number; 0 when unset
  encryptionKeyVersion int
  // Key version pinned by the volume (nullable)
  //
  // Generation of the key material identified by encryptionKeyVersion, so a
  // volume can be checked against the state of the exact version that wraps
  // it rather than the newest one. Null when no version is pinned or when
  // that generation is no longer listed on the key.
  encryptionKeyVersionRef() stackit.kms.key.version
  // Key ring holding the key that wraps the volume (nullable)
  //
  // Null for a platform-managed volume, and null when the key lives in
  // another project (see encryptionKeyProjectId), whose rings this
  // connection cannot read.
  encryptionKeyRing() stackit.kms.keyRing
  // Project that owns the key-encryption key
  //
  // Set when the volume is wrapped with a key from a different project,
  // which only privileged internal projects may do. Empty when the key
  // belongs to the volume's own project or the volume is platform-managed.
  // A non-empty value means the volume's confidentiality depends on that
  // project's access control rather than this one's.
  encryptionKeyProjectId string
  // Service account allowed to unwrap the volume key (nullable)
  //
  // The service account the platform uses to unwrap the volume's
  // data-encryption key with the customer-managed key, which is who the
  // key's access is granted to. Null for a platform-managed volume, and
  // null when the account belongs to another project.
  encryptionKeyServiceAccount() stackit.serviceAccount
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // User-defined labels
  labels map[string]string
}

// STACKIT volume snapshot
//
// Point-in-time copy of a block-storage volume in the project, keyed by
// its UUID `id` (for example `stackit.snapshot(id: "...")`). Snapshots
// capture volume contents for backup, restore, and cloning, so the
// `status` and the source `volume` are the fields to check when auditing
// data-protection coverage.
private stackit.snapshot @defaults("id name status") {
  init(id? string)
  // Snapshot UUID
  id string
  // Snapshot name
  name string
  // Snapshot status
  //
  // One of AVAILABLE, BACKING-UP, CREATING, DELETED, DELETING, ERROR,
  // RESTORING, UNMANAGING, or UPDATING.
  status string
  // Size in GiB
  size int
  // Availability zone
  availabilityZone string
  // Source volume UUID
  volumeId string
  // Source volume (nullable)
  volume() stackit.volume
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // User-defined labels
  labels map[string]string
}

// STACKIT volume backup
//
// Backup of a volume in the project, keyed by its UUID id. Exposes the
// status, size, availability zone, encryption flag, the source volume and
// snapshot, and timestamps. This is the compute-service backup resource;
// backups managed by the Server Backup service are reached through a
// server's backups instead.
private stackit.backup @defaults("id name status size") {
  init(id? string)
  // Backup UUID
  id string
  // Backup name
  name string
  // Description
  description string
  // Backup status
  //
  // One of AVAILABLE, CREATING, DELETED, DELETING, ERROR, or RESTORING.
  status string
  // Size in GiB
  size int
  // Availability zone
  availabilityZone string
  // Whether the backup is encrypted at rest
  encrypted bool
  // Source volume the backup was taken from (nullable)
  volume() stackit.volume
  // Source snapshot the backup was taken from (nullable)
  snapshot() stackit.snapshot
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // User-defined labels
  labels map[string]string
}

// STACKIT affinity group
//
// Server placement group that keeps its member servers on the same
// underlying host (affinity) or spreads them across different hosts
// (anti-affinity). The group is keyed by its UUID id and exposes the
// placement policy and the member servers.
private stackit.affinityGroup @defaults("id name policy") {
  init(id? string)
  // Affinity group UUID
  id string
  // Group name
  name string
  // Placement policy (for example hard-affinity, soft-affinity, hard-anti-affinity, soft-anti-affinity)
  policy string
  // Member servers
  servers() []stackit.server
}

// STACKIT compute image
//
// Bootable VM image available in a project, either a public image
// provided by STACKIT or a private image owned by the project. The
// image is keyed by its UUID, for example
// stackit.image(id: "a1b2c3d4-..."). Query the disk format, minimum
// disk and RAM requirements, protection flag, scope, and the
// operating-system configuration to audit which base images the
// project's servers and volumes are built from.
private stackit.image @defaults("id name status diskFormat") {
  init(id? string)
  // Image UUID
  id string
  // Image name
  name string
  // Image status
  //
  // One of AVAILABLE, CREATING, DEACTIVATED, DELETED, DELETING, or ERROR.
  status string
  // Disk format (qcow2, raw, iso, …)
  diskFormat string
  // Minimum disk size required (GiB)
  minDiskSize int
  // Minimum RAM required (MiB)
  minRam int
  // Image protected flag (true = cannot be deleted)
  protected bool
  // Owning project (empty for public images)
  owner string
  // Image scope
  //
  // One of public (available to every project), local (visible only to
  // the owning project), projects (shared with specific projects, see
  // sharedWithProjects), or organization (shared with the whole
  // organization, see sharedWithOrganization).
  scope string
  // Image checksum
  //
  // Content checksum with keys `algorithm` (the hash algorithm, for
  // example md5 or sha512) and `digest` (the hex checksum value).
  checksum dict
  // Image configuration
  //
  // Boot and hardware settings with keys `bootMenu`, `cdromBus`,
  // `diskBus`, `nicModel`, `operatingSystem`, `operatingSystemDistro`,
  // `operatingSystemVersion`, `rescueBus`, `rescueDevice`,
  // `secureBoot`, `uefi`, `videoModel`, and `virtioScsi`.
  config dict
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // User-defined labels
  labels map[string]string
  // Projects the image is explicitly shared with
  //
  // Project IDs that can boot servers from this image. Empty when the image
  // is not shared, and empty for a public image, whose reach comes from
  // scope rather than an explicit share list.
  sharedWithProjects() []string
  // Whether the image is shared with every project in the parent organization
  //
  // True widens the image to the whole organization rather than the projects
  // named in sharedWithProjects, so anything baked into it (credentials,
  // agents, unpatched packages) spreads with it.
  sharedWithOrganization() bool
}

// STACKIT project network
//
// Network within a STACKIT project, keyed by its UUID `id`, for example
// `stackit.network(id: "...")`. The `routed` flag distinguishes a routed
// network reachable beyond the project from an isolated one, which is the
// first thing to check when reasoning about whether workloads on the network
// can be reached from outside the project. IPv4 and IPv6 prefixes, gateways,
// and name servers describe its addressing.
private stackit.network @defaults("id name routed") {
  init(id? string)
  // Network UUID
  id string
  // Network name
  name string
  // Whether the network is routed (true) or isolated (false)
  routed bool
  // IPv4 prefix CIDR
  ipv4Prefix string
  // IPv4 gateway address (empty if no gateway)
  ipv4Gateway string
  // IPv4 name servers
  ipv4Nameservers []string
  // IPv4 prefix list
  ipv4Prefixes []string
  // Public IPv4 address fronting the network (empty if none)
  //
  // Set when the network has a public IPv4 address bound to it, which makes
  // workloads on the network reachable from the internet subject to security
  // group rules. An empty value means the network has no public IPv4 entry
  // point of its own.
  ipv4PublicIp string
  // IPv6 prefix CIDR
  ipv6Prefix string
  // IPv6 gateway address (empty if no gateway)
  ipv6Gateway string
  // IPv6 name servers
  ipv6Nameservers []string
  // IPv6 prefix list
  ipv6Prefixes []string
  // Network state (CREATING, CREATED, UPDATING, DELETING, FAILED, DELETED, UPDATED)
  state string
  // Whether DHCP is enabled on the network
  //
  // When enabled, the network hands out addresses and DNS settings to
  // attached interfaces automatically. When disabled, workloads carry
  // statically configured addressing.
  dhcp bool
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // User-defined labels
  labels map[string]string
  // Routing table the network forwards through (nullable)
  routingTable() stackit.routingTable
  // Network interfaces attached to this network
  nics() []stackit.nic
}

// STACKIT network area routing table
//
// Routing table that decides where traffic leaving a network is forwarded,
// keyed by its UUID `id`. Routing tables live on a network area rather than
// on a single project, so several networks across the area can share one.
// `isDefault` marks the table applied to networks that do not choose one,
// `dynamicRoutes` reports whether routes learned over the area's dynamic
// peering are propagated into the table, and `systemRoutes` reports whether
// automatic routes connecting projects in the same area are installed. Both
// widen reachability without an explicit route being written, so they are the
// fields to check when auditing which networks can reach each other.
private stackit.routingTable @defaults("id name isDefault") {
  // Routing table UUID
  id string
  // Routing table name
  name string
  // Description (empty if none)
  description string
  // Whether this is the area's default routing table
  //
  // The default table is applied to networks that do not name one and cannot
  // be deleted.
  isDefault bool
  // Whether dynamic routes are propagated into this table
  dynamicRoutes bool
  // Whether automatic system routes connecting projects in the same network area are installed
  systemRoutes bool
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // User-defined labels
  labels map[string]string
}

// STACKIT network interface
//
// Network interface belonging to a network and, when attached, to a
// server. The interface is keyed by its UUID id and exposes the private
// ipv4 and ipv6 addresses, MAC address, the network it lives in, the
// security groups filtering its traffic, allowed address pairs, and
// whether NIC-level security filtering is active.
private stackit.nic @defaults("id ipv4 mac status") {
  // Network interface UUID
  id string
  // Interface name
  name string
  // Network UUID the interface belongs to
  networkId string
  // Network the interface belongs to
  network() stackit.network
  // Private IPv4 address
  ipv4 string
  // Private IPv6 address
  ipv6 string
  // MAC address
  mac string
  // Device identifier presented to the guest operating system
  device string
  // Interface type
  //
  // One of `server`, `metadata`, `gateway`, or `none`.
  nicType string
  // Whether NIC-level security filtering with security groups is active
  nicSecurity bool
  // Security group UUIDs applied to the interface
  securityGroupIds []string
  // Security groups applied to the interface
  securityGroups() []stackit.securityGroup
  // Additional address pairs the interface may send from and receive on
  allowedAddresses []string
  // Interface status
  //
  // One of `ACTIVE` or `DOWN`.
  status string
  // User-defined labels
  labels map[string]string
}

// STACKIT public IP address
//
// Floating public IP that can be attached to a network interface to
// expose a resource to the internet, useful for auditing which
// addresses are externally routable and whether they are currently
// bound to anything. The IP is keyed by its UUID, for example
// `stackit.publicIp(id: "...")`. The `networkInterfaceId` field is
// empty when the address is allocated but unassigned.
private stackit.publicIp @defaults("id ip") {
  init(id? string)
  // Public IP UUID
  id string
  // IP address
  ip string
  // Network interface UUID the IP is bound to (empty if unassigned)
  networkInterfaceId string
  // User-defined labels
  labels map[string]string
}

// STACKIT security group
//
// Firewall rule set that governs which inbound and outbound traffic
// reaches the servers and network interfaces it is attached to.
// Auditing a security group reveals its exposure surface: overly
// permissive rules, whether it is stateful (return traffic for an
// allowed connection is admitted automatically), and its ingress and
// egress rules through `rules`. Selected by its UUID `id`, for example
// `stackit.securityGroup(id: "9f8e7d6c-...")`.
private stackit.securityGroup @defaults("id name stateful") {
  init(id? string)
  // Security group UUID
  id string
  // Security group name
  name string
  // Description
  description string
  // Whether the security group is stateful
  stateful bool
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // User-defined labels
  labels map[string]string
  // Security group rules
  rules() []stackit.securityGroup.rule
}

// STACKIT security group rule
//
// Single ingress or egress rule within a security group, defining
// which traffic the group permits. Auditing rules surfaces overly
// permissive access, for example an ingress rule whose `ipRange` is
// `0.0.0.0/0` or `::/0`. The remote endpoint is either an IP CIDR
// (`ipRange`) or another security group (`remoteSecurityGroupId`); one
// is set and the other empty. Keyed by its UUID `id`, unique within
// the owning security group.
private stackit.securityGroup.rule @defaults("id direction protocol") {
  // Rule UUID
  id string
  // Owning security group UUID
  securityGroupId string
  // Direction (ingress, egress)
  direction string
  // Ethertype (IPv4, IPv6)
  ethertype string
  // Protocol name or number (tcp, udp, icmp, …)
  protocol string
  // Description
  description string
  // ICMP type (nullable)
  icmpType int
  // ICMP code (nullable)
  icmpCode int
  // Lower bound of the port range (0 if not applicable)
  portRangeMin int
  // Upper bound of the port range (0 if not applicable)
  portRangeMax int
  // Remote IP CIDR (empty if remote is a security group)
  ipRange string
  // Remote security group UUID (empty if remote is a CIDR)
  remoteSecurityGroupId string
  // Creation timestamp
  createdAt time
}

// Server internet-exposure breakdown
//
// Internet-reachability assessment for a server: whether one of its network
// interfaces carries a public IP and whether an attached security group admits
// inbound traffic from any address. A server counts as internet-reachable only
// when both hold, so this surfaces the servers most exposed to external attack.
private stackit.network.exposure @defaults("internetReachable hasPublicIp") {
  // Whether the server is reachable from the internet (a public IP and a security group ingress rule that admits any address)
  internetReachable bool
  // Whether any network interface has a public IP
  hasPublicIp bool
  // Whether an attached security group permits inbound traffic from any address (0.0.0.0/0 or ::/0)
  securityGroupAllowsIngress bool
  // Security group ingress rules that admit traffic from any address
  openIngressRules []stackit.securityGroup.rule
}

// STACKIT server backup
//
// Point-in-time backup of a server's volumes taken by the Server Backup
// service. The backup is keyed by its UUID id and exposes the status and
// size, the per-volume backup entries, the volumes the backup protects,
// and the creation, expiry, and last-restore timestamps.
private stackit.server.backup @defaults("id name status size") {
  // Backup UUID
  id string
  // Owning server UUID
  serverId string
  // Server the backup was taken from
  server() stackit.server
  // Backup name
  name string
  // Backup status
  status string
  // Total backup size in GiB
  size int
  // Creation timestamp
  createdAt time
  // Expiry timestamp
  expireAt time
  // Timestamp of the most recent restore from this backup (unset if never restored)
  lastRestoredAt time
  // Per-volume backup entries that make up the backup
  volumeBackups() []stackit.server.backup.volumeBackup
  // Volumes protected by this backup
  volumes() []stackit.volume
}

// STACKIT server volume backup entry
//
// Backup of a single volume that is part of a server backup, keyed by its
// UUID id. Exposes the size and status of the volume's backup, the volume
// it protects, and, once a restore has run, the timestamp and the volume
// the data was restored into.
private stackit.server.backup.volumeBackup @defaults("id status size") {
  // Volume backup UUID
  id string
  // UUID of the volume this entry backs up
  volumeId string
  // Volume this entry backs up
  volume() stackit.volume
  // Size of the volume backup in GiB
  size int
  // Status of the volume backup
  status string
  // Timestamp of the most recent restore from this entry (unset if never restored)
  lastRestoredAt time
  // UUID of the volume the data was most recently restored into (empty if never restored)
  lastRestoredVolumeId string
  // Volume the data was most recently restored into (nullable)
  lastRestoredVolume() stackit.volume
}

// STACKIT server backup schedule
//
// Recurring backup schedule attached to a server by the Server Backup
// service. The schedule is keyed by its numeric id and exposes whether it
// is enabled, the iCalendar recurrence rule, the retention period, and
// the volumes it backs up.
private stackit.server.backupSchedule @defaults("id name enabled") {
  // Schedule ID
  id int
  // Owning server UUID
  serverId string
  // Server the schedule is attached to
  server() stackit.server
  // Schedule name
  name string
  // Whether the schedule is enabled
  enabled bool
  // iCalendar RRULE describing when backups run
  rrule string
  // Number of days backups are retained
  retentionPeriod int
  // Volume UUIDs the schedule backs up
  volumeIds []string
  // Volumes the schedule backs up
  volumes() []stackit.volume
}

// STACKIT server update run
//
// Operating-system update run applied to a server by the Server Update
// service. The run is keyed by its numeric id and exposes the status,
// start and end timestamps, the counts of installed and failed updates,
// and the failure reason when the run did not succeed.
private stackit.server.update @defaults("id status startDate") {
  // Update run ID
  id int
  // Owning server UUID
  serverId string
  // Server the update ran on
  server() stackit.server
  // Update run status
  status string
  // Start timestamp
  startDate time
  // End timestamp
  endDate time
  // Number of updates installed by the run
  installedUpdates int
  // Number of updates that failed during the run
  failedUpdates int
  // Failure reason (empty when the run succeeded)
  failReason string
}

// STACKIT server update schedule
//
// Recurring maintenance schedule attached to a server by the Server
// Update service. The schedule is keyed by its numeric id and exposes
// whether it is enabled, the iCalendar recurrence rule, and the
// maintenance window start hour.
private stackit.server.updateSchedule @defaults("id name enabled") {
  // Schedule ID
  id int
  // Owning server UUID
  serverId string
  // Server the schedule is attached to
  server() stackit.server
  // Schedule name
  name string
  // Whether the schedule is enabled
  enabled bool
  // iCalendar RRULE describing when maintenance runs
  rrule string
  // Maintenance window start hour (0-23)
  maintenanceWindow int
}

// Project backup policy for STACKIT servers
//
// A named backup template a project offers its servers, keyed by UUID
// `id`: an rrule cadence, the retention period applied to the backups it
// produces, and whether it is the project default. A disabled default
// policy means servers created without an explicit schedule are not
// backed up.
private stackit.server.backupPolicy @defaults("name enabled default") {
  // Policy UUID
  id string
  // Policy name
  name string
  // Description
  description string
  // Whether the policy is active
  //
  // Null when the service reports no setting.
  enabled bool
  // Whether this is the project default policy
  //
  // Null when the service reports no setting.
  default bool
  // Backup cadence as an iCalendar recurrence rule
  rrule string
  // Name template for the backups the policy produces
  backupName string
  // Days a produced backup is kept before it is deleted
  //
  // Null when the policy carries no retention.
  retentionPeriod int
}

// Project update policy for STACKIT servers
//
// A named OS update template a project offers its servers, keyed by UUID
// `id`: an rrule cadence and the hourly maintenance window updates start
// in, and whether it is the project default.
private stackit.server.updatePolicy @defaults("name enabled default") {
  // Policy UUID
  id string
  // Policy name
  name string
  // Description
  description string
  // Whether the policy is active
  //
  // Null when the service reports no setting.
  enabled bool
  // Whether this is the project default policy
  //
  // Null when the service reports no setting.
  default bool
  // Update cadence as an iCalendar recurrence rule
  rrule string
  // Hours in the maintenance window updates start within
  //
  // Updates may run past the window and can trigger an automatic
  // restart. Null when the policy carries no window.
  maintenanceWindow int
}

// STACKIT SSH key pair
//
// SSH key pair registered in the project and used to grant login
// access when provisioning servers. The pair is keyed by `name`, for
// example `stackit.keyPair(name: "admin-key")`, and exposes the public
// key material, its SHA256 fingerprint, and user-defined labels.
// Auditing key pairs helps confirm which public keys can be injected
// into new instances.
private stackit.keyPair @defaults("name fingerprint") {
  init(name? string)
  // Key pair name (primary identifier)
  name string
  // MD5 fingerprint of the public key (16 colon-separated hex octets)
  fingerprint string
  // Public key content (OpenSSH format)
  publicKey string
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // User-defined labels
  labels map[string]string
}

// STACKIT load balancer
//
// Layer 4 (TCP/UDP) load balancer that distributes traffic across a
// backend target pool. The balancer is keyed by its `name` (unique
// within the project and region), for example
// `stackit.loadBalancer(name: "my-lb")`. Query it to audit the public
// reachability of a service: the external address, the listener port
// and protocol bindings, the access-control allow-list carried in
// `options`, and whether the balancer is confined to the private
// network. The `exposure` field gives the combined public-address and
// allow-list verdict.
private stackit.loadBalancer @defaults("name status externalAddress") {
  init(name? string)
  // Load balancer name
  name string
  // External (public) IPv4/IPv6 address (empty if private only)
  externalAddress string
  // Private address inside the attached network (empty if none)
  //
  // Transient address the balancer answers on from within the network. It
  // can change at any time, so it identifies the balancer's private entry
  // point rather than serving as a stable key.
  privateAddress string
  // Plan ID (sizing tier)
  planId string
  // Status (STATUS_READY, STATUS_PENDING, STATUS_ERROR, STATUS_TERMINATING, STATUS_UNSPECIFIED)
  status string
  // Whether the load balancer is reachable *only* from inside the project's private network (no public IP)
  privateNetworkOnly bool
  // Region (network and listeners live here)
  region string
  // Listeners — frontend port/protocol bindings
  listeners() []stackit.loadBalancer.listener
  // Networks attached to the load balancer [{networkId, role}]
  networks []dict
  // Target pools — backend groups with their health checks and members
  targetPools() []stackit.loadBalancer.targetPool
  // Load balancer options
  //
  // Keys: `accessControl` ({allowedSourceRanges []string}, the CIDR
  // allow-list for inbound traffic), `ephemeralAddress` (bool, whether
  // a managed public IP is attached), `observability` ({logs, metrics},
  // each {credentialsRef, pushUrl} for external log and metric push),
  // and `privateNetworkOnly` (bool, mirrored by the privateNetworkOnly
  // field).
  options dict
  // Errors reported during creation/operation [{type, description}]
  errors []dict
  // Security group STACKIT manages for the load balancer itself
  //
  // Group that permits traffic from the balancer out to the backend targets.
  // Null when the balancer has none assigned.
  loadBalancerSecurityGroup() stackit.securityGroup
  // Security group STACKIT manages for the backend targets
  //
  // Group that allows the targets to receive traffic from the balancer. It
  // is attached to the targets automatically unless
  // `disableTargetSecurityGroupAssignment` is set, in which case reaching
  // the backends is left to whatever groups the operator attached by hand.
  // Null when the balancer has none assigned.
  targetSecurityGroup() stackit.securityGroup
  // Whether the managed target security group is left off the backends
  //
  // Set at creation and not changeable afterwards. When true, STACKIT does
  // not attach `targetSecurityGroup` to the targets and connectivity to them
  // depends entirely on the groups and routes the operator configured, so
  // the backends can be left reachable by more than the balancer. Null when
  // the API reports no setting for it.
  disableTargetSecurityGroupAssignment bool
  // User-defined labels
  labels map[string]string
  // Internet-exposure breakdown (public address combined with the access-control allow-list)
  exposure() stackit.network.exposure
  // CIDR allow-list of client networks permitted to reach the balancer
  //
  // From options.accessControl.allowedSourceRanges. Empty when no
  // allow-list is configured, which leaves a public balancer reachable
  // from any address.
  allowedSourceRanges() []string
  // Whether the public address is a managed ephemeral one
  //
  // True when STACKIT allocates and releases the public IP with the
  // balancer rather than binding a reserved address. Null when the
  // options carry no setting.
  ephemeralAddress() bool
  // Endpoint the balancer pushes access logs to
  //
  // From options.observability.logs.pushUrl, an egress destination for
  // request logs. Empty when logs are not shipped.
  observabilityLogsPushUrl() string
  // Endpoint the balancer pushes metrics to
  //
  // From options.observability.metrics.pushUrl. Empty when metrics are
  // not shipped.
  observabilityMetricsPushUrl() string
}

// STACKIT load balancer listener
//
// Frontend port and protocol binding that accepts client connections
// and forwards them into a single target pool. Each listener records
// the bound `port`, the wire `protocol`, and the SNI hostnames it
// matches for TLS, making it the place to audit which ports a load
// balancer exposes. Listeners are keyed by the parent load-balancer
// name together with the listener `name`.
private stackit.loadBalancer.listener @defaults("name port protocol targetPool") {
  // Listener machine name (parent-unique key)
  name string
  // Listener display name (user-facing label)
  displayName string
  // Parent load-balancer name
  loadBalancerName string
  // Frontend port the listener binds
  port int
  // Wire protocol
  //
  // One of PROTOCOL_TCP, PROTOCOL_UDP, PROTOCOL_TCP_PROXY,
  // PROTOCOL_TLS_PASSTHROUGH, or PROTOCOL_UNSPECIFIED.
  protocol string
  // Name of the targetPool this listener forwards to
  targetPool string
  // SNI hostnames matched by this listener (TLS only)
  serverNameIndicators []string
  // TCP listener options
  //
  // Single key `idleTimeout` (duration) after which an idle TCP
  // connection is closed. Empty for non-TCP listeners.
  tcp dict
  // UDP listener options
  //
  // Single key `idleTimeout` (duration) after which an idle UDP flow
  // is dropped. Empty for non-UDP listeners.
  udp dict
}

// STACKIT load balancer target pool
//
// Backend group that a listener forwards traffic to. Each target pool
// holds one or more targets (member IP addresses reachable on
// `targetPort`) plus the active health check and session-persistence
// policy used to distribute requests across them. Target pools are
// keyed by the parent load-balancer name together with the pool
// `name`.
private stackit.loadBalancer.targetPool @defaults("name targetPort") {
  // Target pool name (parent-unique key)
  name string
  // Parent load-balancer name
  loadBalancerName string
  // Backend port the pool forwards to
  targetPort int
  // Member backends
  //
  // Each entry is {displayName, ip}: the backend's label and the IP
  // address the pool forwards requests to.
  targets []dict
  // Active health check
  //
  // Keys: `interval` and `intervalJitter` (probe timing), `timeout`
  // (per-probe deadline), `healthyThreshold` and `unhealthyThreshold`
  // (consecutive results before a target flips state), `altPort` (an
  // alternate probe port), and `httpHealthChecks` (HTTP-level probe
  // settings).
  activeHealthCheck dict
  // Session persistence
  //
  // Single key `useSourceIpAddress` (bool): when true, requests from
  // the same client source IP are pinned to the same target.
  sessionPersistence dict
  // Whether health probes use TLS to the backends
  //
  // From activeHealthCheck.httpHealthChecks.tls.enabled. Null when the
  // pool has no HTTP health check or the API reports no setting.
  healthCheckTlsEnabled bool
  // Whether health probes skip backend certificate validation
  //
  // From activeHealthCheck.httpHealthChecks.tls.skipCertificateValidation,
  // which the service documents as insecure and for testing only. Null
  // when the pool has no HTTP health check or the API reports no setting.
  healthCheckSkipCertificateValidation bool
  // Whether clients are pinned to a backend by source address
  //
  // From sessionPersistence.useSourceIpAddress. Null when the API reports
  // no setting.
  sessionPersistenceSourceIp bool
}

// STACKIT Kubernetes Engine namespace
//
// Managed Kubernetes clusters running in the project. The `clusters`
// field enumerates every SKE cluster as a stackit.ske.cluster record,
// each carrying its Kubernetes version, node pools, network binding,
// and security configuration.
stackit.ske {
  // Managed Kubernetes clusters
  clusters() []stackit.ske.cluster
}

// STACKIT managed Kubernetes (SKE) cluster
//
// Single managed Kubernetes cluster, keyed by its `name` (unique within
// the project and region). Exposes the `status` (aggregated lifecycle),
// the Kubernetes version, the node pools (with their flavor, OS, taints,
// autoscaling, labels), the hibernation and maintenance windows, network
// and DNS overrides, extensions (ACL, observability, application load
// balancer), whether API server audit logging is enabled, the cluster-level
// `labels`, and the creation and update timestamps.
private stackit.ske.cluster @defaults("name kubernetesVersion status") {
  init(name? string)
  // Cluster name
  name string
  // Aggregated status
  //
  // One of STATE_HEALTHY, STATE_HIBERNATED, STATE_UNHEALTHY, STATE_RECONCILING, STATE_CREATING, STATE_DELETING, STATE_HIBERNATING, or STATE_WAKINGUP.
  status string
  // Status object (raw): aggregated state, hibernated, errors, credentials rotation, …
  statusDetails dict
  // Kubernetes version of the control plane as a full patch version (e.g., 1.30.4)
  kubernetesVersion string
  // Node pools, one stackit.ske.cluster.nodePool per pool
  nodePools() []stackit.ske.cluster.nodePool
  // Hibernation schedules [{start, end, timezone}]
  hibernations []dict
  // Maintenance window {timeWindow, autoUpdate: {kubernetesVersion, machineImageVersion}}
  //
  // See `autoUpdateKubernetes` and `autoUpdateMachineImage` for the two
  // automatic-patching controls read out of this window.
  maintenance dict
  // Whether the maintenance window applies Kubernetes patch releases automatically
  //
  // When enabled, STACKIT moves the control plane and node pools onto new
  // patch releases of the running Kubernetes minor version inside the
  // maintenance window, which is what keeps a cluster off a version that has
  // passed the date in `kubernetesExpirationDate`. Null when the cluster
  // carries no maintenance window, and when the window reports no setting
  // for it.
  autoUpdateKubernetes bool
  // Whether the maintenance window applies node machine image updates automatically
  //
  // Covers the operating system image the worker nodes run, patched
  // independently of the Kubernetes version. Null when the cluster carries
  // no maintenance window, and when the window reports no setting for it.
  autoUpdateMachineImage bool
  // Extension add-ons keyed by acl, observability, dns, and applicationLoadBalancer
  //
  // Dict of the cluster's enabled add-ons. The `acl` key holds the
  // kube-apiserver access ACL (enabled, allowedCidrs); `observability`
  // holds the metrics and logs integration (enabled, instanceId); `dns`
  // holds the managed-DNS extension (enabled, gatewayApi, zones);
  // `applicationLoadBalancer` holds the application load balancer extension
  // (enabled). See `apiServerAclEnabled`, `observabilityEnabled`, `dnsEnabled`,
  // and `applicationLoadBalancerEnabled` for the hoisted flags.
  extensions dict
  // Network association: the STACKIT network id, control-plane access scope, and CNI configuration
  //
  // Holds `id` (the STACKIT network the cluster is attached to, resolved by
  // `networkRef`) and `cni`, the container network interface configuration.
  // The `cni` object carries a `calico` key whose contents are the
  // provider-defined Calico options and are not a fixed set.
  network dict
  // Creation timestamp
  creationTime time
  // Whether the kube-apiserver access ACL is enforced
  apiServerAclEnabled bool
  // CIDR blocks permitted to reach the kube-apiserver when the access ACL is enforced
  apiServerAclAllowedCidrs []string
  // Credentials-rotation phase
  //
  // One of NEVER, PREPARING, PREPARED, COMPLETING, or COMPLETED.
  credentialsRotationPhase string
  // Time the most recent credentials rotation was initiated
  credentialsRotationLastInitiated time
  // Time the most recent credentials rotation completed
  credentialsRotationLastCompleted time
  // Egress IP ranges from which cluster traffic originates
  egressAddressRanges []string
  // Pod IP ranges assigned to the cluster
  podAddressRanges []string
  // OIDC service-account token issuer URL
  serviceAccountIssuer string
  // Whether Kubernetes API server audit logging is enabled for the cluster
  auditEnabled bool
  // Whether an identity provider is enabled for cluster access
  idpEnabled bool
  // Identity-provider type configured for cluster access
  idpType string
  // Whether the observability (argus) extension is enabled
  observabilityEnabled bool
  // Observability instance the cluster ships metrics and logs to
  observabilityInstance() stackit.observability.instance
  // Whether the DNS extension is enabled
  dnsEnabled bool
  // Whether the DNS extension exposes the Kubernetes Gateway API
  dnsGatewayApi bool
  // DNS zones managed by the DNS extension
  dnsZones []string
  // Whether the application load balancer extension is enabled
  //
  // STACKIT gates this extension to accounts explicitly enabled for it and
  // may still change its shape, so treat the field as provisional.
  applicationLoadBalancerEnabled @maturity("preview") bool
  // Labels applied to the cluster
  //
  // Key-value pairs set on the cluster itself, distinct from the labels on
  // each node pool. Keys may carry a domain prefix separated by a slash and
  // values may be empty.
  labels map[string]string
  // Reachability of the kube-apiserver
  //
  // One of PUBLIC, where the control plane answers on the internet, or SNA,
  // where it answers only from inside the attached STACKIT network. Empty
  // when the cluster predates the setting. A PUBLIC control plane is only as
  // restricted as apiServerAclEnabled and apiServerAclAllowedCidrs make it.
  controlPlaneAccessScope string
  // End of support for the control-plane Kubernetes version
  //
  // Date after which STACKIT stops supporting the Kubernetes minor version
  // the control plane runs. Null when no end of support has been announced
  // for that version.
  kubernetesExpirationDate time
  // STACKIT network the cluster is attached to
  networkRef() stackit.network
}

// SKE node pool
//
// Single node pool within a managed-Kubernetes cluster, keyed by
// `clusterName/name`. Exposes the machine type and image, volume
// size and type, node-count bounds and rolling-update budget
// (maxSurge/maxUnavailable), the worker availability zones, container
// runtime, taints, labels, and whether the cluster's system components
// are allowed to schedule onto the pool.
private stackit.ske.cluster.nodePool @defaults("name machineType minimum maximum") {
  // Node pool name (unique within the cluster)
  name string
  // Parent cluster name
  clusterName string
  // Machine flavor (e.g., g1.2)
  machineType string
  // OS image name (e.g., flatcar)
  machineImage string
  // OS image version
  machineImageVersion string
  // Boot volume size in GiB
  volumeSize int
  // Boot volume type (e.g., storage_premium)
  volumeType string
  // Minimum node count (cluster-autoscaler lower bound)
  minimum int
  // Maximum node count (cluster-autoscaler upper bound)
  maximum int
  // MaxSurge for rolling updates (extra nodes allowed beyond `maximum`)
  maxSurge int
  // MaxUnavailable nodes during rolling updates
  maxUnavailable int
  // Worker availability zones
  availabilityZones []string
  // Container runtime name (containerd, …)
  cri string
  // Taints [{key, value, effect}]
  taints []dict
  // Kubelet/Node labels
  labels map[string]string
  // Whether DaemonSets/system components may schedule on this pool
  allowSystemComponents bool
  // Kubernetes version running on this node pool, when it differs from the control plane
  kubernetesVersion string
  // End of support for the node operating-system image
  //
  // Date after which STACKIT stops supporting the machine image version the
  // pool's nodes boot from. Null when no end of support has been announced.
  // Nodes past this date keep running but stop receiving image updates.
  osExpirationDate time
  // End of support for the pool's Kubernetes version
  //
  // Date after which STACKIT stops supporting the Kubernetes version running
  // on the pool, which can differ from the control-plane date when the pool
  // is pinned to an older version. Null when none has been announced.
  kubernetesExpirationDate time
}

// STACKIT Object Storage namespace
//
// S3-compatible object storage in a STACKIT project. The namespace
// enumerates the project's buckets and the credentials groups that
// hold S3 access keys, so you can audit bucket exposure, retention
// settings, and which credentials can reach them. Individual buckets
// are exposed as stackit.objectStorage.bucket records.
stackit.objectStorage {
  // Object Storage buckets
  buckets() []stackit.objectStorage.bucket
  // S3 credentials groups holding access keys
  credentialsGroups() []stackit.objectStorage.credentialsGroup
}

// STACKIT Object Storage credentials group
//
// Group of S3-compatible access keys for a project's Object Storage. The
// group is keyed by its UUID id and exposes the display name, the URN
// that identifies the group, and the access keys it contains.
private stackit.objectStorage.credentialsGroup @defaults("id displayName") {
  init(id? string)
  // Credentials group UUID
  id string
  // Display name
  displayName string
  // URN identifying the credentials group
  urn string
  // Access keys belonging to the group
  accessKeys() []stackit.objectStorage.accessKey
}

// STACKIT Object Storage access key
//
// S3-compatible access key belonging to a credentials group. The key is
// keyed by its keyId and exposes the display name, the expiry timestamp
// (unset for keys that never expire), and the credentials group the key
// belongs to.
private stackit.objectStorage.accessKey @defaults("keyId displayName expires") {
  // Access key ID
  keyId string
  // Credentials group the key belongs to
  credentialsGroup() stackit.objectStorage.credentialsGroup
  // Display name
  displayName string
  // Expiry timestamp (unset for keys that never expire)
  expires time
}

// STACKIT Object Storage bucket
//
// Single S3-compatible bucket in a STACKIT project. The bucket is keyed
// by its `name`, which is unique within the project and region (for
// example `stackit.objectStorage.bucket(name: "my-bucket")`), and
// exposes the S3 region, the virtual-hosted and path-style access URLs,
// and the Object Lock (WORM) retention settings that govern how long
// objects cannot be deleted or overwritten.
private stackit.objectStorage.bucket @defaults("name region urlPathStyle") {
  init(name? string)
  // Bucket name (primary identifier)
  name string
  // Bucket region
  region string
  // S3-compatible URL in virtual-hosted style (https://<bucket>.<endpoint>)
  urlVirtualHostedStyle string
  // S3-compatible URL in path style (https://<endpoint>/<bucket>)
  urlPathStyle string
  // Whether S3 Object Lock is enabled (WORM retention)
  objectLockEnabled bool
  // Default-retention days; 0 when no default retention is configured
  defaultRetentionDays() int
  // Default-retention mode; COMPLIANCE or GOVERNANCE, empty when unconfigured
  defaultRetentionMode() string
}

// STACKIT File Storage namespace
//
// SFS (STACKIT File Storage) namespace for managed NFS storage in the
// project: the `resourcePools` that provide capacity, the
// `exportPolicies` that govern NFS client access, and the SnapLock
// project lock (`lockId`). Individual file shares and pool snapshots
// hang off each resource pool.
stackit.sfs {
  // File-storage resource pools (capacity pools) in the project
  resourcePools() []stackit.sfs.resourcePool
  // Share export policies (NFS export rule sets) defined in the project
  exportPolicies() []stackit.sfs.exportPolicy
  // SnapLock project lock ID; empty when the project is not locked
  lockId() string
}

// STACKIT File Storage resource pool
//
// Single SFS capacity pool. The pool is keyed by its UUID `id`, for
// example `stackit.sfs.resourcePool(id: "fa1d2…")`, and exposes the
// `name`, lifecycle `state`, `performanceClass` (with peak IOPS and
// throughput), availability zone, NFS `mountPath`, the `ipAcl` of
// CIDRs allowed to mount, capacity accounting in gigabytes
// (`sizeGigabytes`, `usedGigabytes`, `availableGigabytes`,
// `usedBySnapshotsGigabytes`), the attached snapshot policy, labels,
// and creation time. The shares hosted in the pool are available
// through `shares` and point-in-time copies through `snapshots`.
private stackit.sfs.resourcePool @defaults("id name state performanceClass") {
  init(id? string)
  // Resource pool UUID
  id string
  // Resource pool name
  name string
  // Lifecycle state (CREATING, READY, UPDATING, DELETING, FAILED, …)
  state string
  // Region the pool runs in
  region string
  // Performance class name (sizing/quota tier)
  performanceClass string
  // Performance class peak IOPS
  performanceClassPeakIops int
  // Performance class throughput in MiB/s
  performanceClassThroughput int
  // Availability zone hosting the pool
  availabilityZone string
  // Base NFS mount path exported by the pool
  mountPath string
  // Number of shares hosted in the pool
  countShares int
  // Provisioned capacity in gigabytes
  sizeGigabytes int
  // Used capacity in gigabytes
  //
  // Read per pool, since the API reports usage only on a single-pool
  // fetch and returns zero for every pool in the list. Null when the
  // pool could not be read.
  usedGigabytes() float
  // Available capacity in gigabytes
  //
  // Read per pool, like usedGigabytes. Null when the pool could not be
  // read.
  availableGigabytes() float
  // Capacity consumed by snapshots in gigabytes
  //
  // Read per pool, like usedGigabytes. Null when the pool could not be
  // read.
  usedBySnapshotsGigabytes() float
  // CIDRs allowed to mount shares in this pool
  ipAcl []string
  // Whether snapshots are visible to clients under the share mount
  snapshotsAreVisible bool
  // Attached snapshot policy UUID; empty when none is attached
  snapshotPolicyId string
  // Attached snapshot policy name; empty when none is attached
  snapshotPolicyName string
  // User-defined labels attached to the pool
  labels map[string]string
  // Creation timestamp
  createdAt time
  // File shares hosted in this pool
  shares() []stackit.sfs.share
  // Point-in-time snapshots of this pool
  snapshots() []stackit.sfs.snapshot
}

// STACKIT File Storage share
//
// Single NFS file share within a resource pool. The share is keyed by
// its UUID `id` and exposes the `name`, lifecycle `state`, the NFS
// `mountPath` clients use, the per-share hard quota
// (`spaceHardLimitGigabytes`), labels, and creation time. The NFS
// export rules governing client access are available through the
// `exportPolicy` accessor.
private stackit.sfs.share @defaults("id name state") {
  // Share UUID
  id string
  // Share name
  name string
  // Lifecycle state (CREATING, READY, UPDATING, DELETING, FAILED, …)
  state string
  // NFS mount path clients use to mount the share
  mountPath string
  // Per-share hard quota in gigabytes
  spaceHardLimitGigabytes int
  // User-defined labels attached to the share
  labels map[string]string
  // Creation timestamp
  createdAt time
  // Export policy (NFS export rule set) applied to this share
  exportPolicy() stackit.sfs.exportPolicy
}

// STACKIT File Storage share export policy
//
// Single NFS export policy, the rule set that controls which clients
// may mount shares and with what access. The policy is keyed by its
// UUID `id`, for example `stackit.sfs.exportPolicy(id: "fa1d2…")`, and
// exposes the `name`, the count of shares referencing it
// (`sharesUsingExportPolicy`), labels, creation time, and the ordered
// list of `rules`.
private stackit.sfs.exportPolicy @defaults("id name sharesUsingExportPolicy") {
  init(id? string)
  // Export policy UUID
  id string
  // Export policy name
  name string
  // Number of shares currently referencing this policy
  sharesUsingExportPolicy int
  // User-defined labels attached to the policy
  labels map[string]string
  // Creation timestamp
  createdAt time
  // Ordered NFS export rules
  rules() []stackit.sfs.exportPolicy.rule
}

// STACKIT File Storage export policy rule
//
// Single NFS export rule within an export policy. Each rule grants the
// CIDRs in `ipAcl` access at the given evaluation `order`, keyed by its
// UUID `id`, with an optional `description` and creation time.
private stackit.sfs.exportPolicy.rule @defaults("order ipAcl") {
  // Rule UUID
  id string
  // Evaluation order (lower numbers are evaluated first)
  order int
  // CIDRs granted access by this rule
  ipAcl []string
  // Optional rule description
  description string
  // Whether matching clients may only mount the share read-only
  //
  // False means clients matching this rule can write to the share. Null
  // when the service reports nothing for the rule.
  readOnly bool
  // Whether matching clients keep root privileges on the share
  //
  // True grants root access to clients matching the rule, the NFS
  // equivalent of no_root_squash. Null when the service reports nothing.
  superUser bool
  // Whether set-user-ID bits are honored on the export
  //
  // True lets executables on the share run with their file owner's
  // privileges. Null when the service reports nothing.
  setUuid bool
  // Creation timestamp
  createdAt time
}

// STACKIT File Storage resource pool snapshot
//
// Point-in-time snapshot of a resource pool. The snapshot is selected
// by its `name` within the pool and exposes the logical and physical
// sizes in gigabytes (`logicalSizeGigabytes`, `sizeGigabytes`), an
// optional `comment`, the SnapLock expiry time (`snaplockExpiryTime`,
// when WORM-protected), and the creation time.
private stackit.sfs.snapshot @defaults("name sizeGigabytes createdAt") {
  // Snapshot name (unique within the pool)
  name string
  // Physical size in gigabytes
  sizeGigabytes int
  // Logical size in gigabytes
  logicalSizeGigabytes int
  // Optional snapshot comment
  comment string
  // SnapLock expiry time; null when the snapshot is not WORM-protected
  snaplockExpiryTime time
  // Creation timestamp
  createdAt time
}

// STACKIT DNS namespace
//
// Managed DNS zones in the project and the record sets within them.
// Query zones to audit which domains the project is authoritative for,
// their public or private visibility, and TTL hygiene; each zone in
// turn exposes its record sets for inspecting individual DNS answers.
stackit.dns {
  // DNS zones managed by the project
  zones() []stackit.dns.zone
}

// STACKIT DNS zone
//
// Managed DNS zone within the project, keyed by its UUID `id`. Covers
// the domain name, primary or secondary type, public or private
// visibility, SOA timing (refresh, retry, expire, negative cache), the
// query ACL, and lifecycle state. Query zones to audit which domains
// the project is authoritative for and whether their records are
// reachable publicly.
private stackit.dns.zone @defaults("id dnsName type state") {
  init(id? string)
  // Zone UUID
  id string
  // Zone name (e.g., `example.com.`)
  dnsName string
  // Description
  description string
  // Zone type (primary, secondary)
  type string
  // Visibility (the API currently defines only public)
  visibility string
  // Lifecycle state (CREATING, CREATE_SUCCEEDED, CREATE_FAILED, DELETING, DELETE_SUCCEEDED, DELETE_FAILED, UPDATING, UPDATE_SUCCEEDED, UPDATE_FAILED)
  state string
  // Default record TTL (seconds)
  defaultTtl int
  // Authoritative contact email
  contactEmail string
  // SOA serial
  serialNumber int
  // SOA primary nameserver
  primaryNameServer string
  // SOA expire (seconds)
  expireTime int
  // SOA refresh (seconds)
  refreshTime int
  // SOA retry (seconds)
  retryTime int
  // Negative-cache TTL (seconds)
  negativeCache int
  // Number of record sets in the zone
  recordCount int
  // ACL CIDRs allowed to query (for zones with restricted ACL)
  acl string
  // Primary nameservers (for secondary zones)
  primaries []string
  // Whether this is a reverse DNS zone
  isReverseZone bool
  // When zone creation started
  creationStartedAt time
  // When zone creation finished
  creationFinishedAt time
  // User-defined labels
  labels map[string]string
  // Record sets in the zone
  recordSets() []stackit.dns.recordSet
}

// STACKIT DNS record set
//
// Resource record set (RRSet) within a DNS zone, keyed by its UUID
// `id`. Groups every record of one `type` (A, AAAA, CNAME, MX, TXT,
// NS, SRV, and so on) under a single `name`, along with the record
// values, TTL, and lifecycle state. Query record sets to inspect the
// actual DNS answers a zone serves, for example CNAME targets, MX
// hosts, or TXT verification and SPF values.
private stackit.dns.recordSet @defaults("name type state") {
  // Record set UUID
  id string
  // Owning zone UUID
  zoneId string
  // Zone the record set belongs to
  zone() stackit.dns.zone
  // Record name (FQDN, e.g., `www.example.com.`)
  name string
  // Record type
  //
  // One of A, AAAA, SOA, CNAME, NS, MX, TXT, SRV, PTR, ALIAS, DNAME,
  // CAA, DNSKEY, DS, LOC, NAPTR, SSHFP, TLSA, URI, CERT, SVCB, TYPE,
  // CSYNC, HINFO, or HTTPS.
  type string
  // Record TTL (seconds)
  ttl int
  // Lifecycle state (CREATING, CREATE_SUCCEEDED, CREATE_FAILED, DELETING, DELETE_SUCCEEDED, DELETE_FAILED, UPDATING, UPDATE_SUCCEEDED, UPDATE_FAILED)
  state string
  // Comment
  comment string
  // Record values (textual representation of each record in the set)
  records []string
  // Whether the record set is for active healthcheck failover
  active bool
  // When record set creation started
  creationStartedAt time
  // Creation timestamp
  creationFinishedAt time
  // Last update timestamp
  updateFinishedAt time
}

// STACKIT Postgres Flex namespace
//
// Managed PostgreSQL service for a STACKIT project. The `instances`
// field lists every Postgres Flex database provisioned in the project,
// each inspectable for engine version, connection ACL, backup schedule,
// storage sizing, and replica count.
stackit.postgresFlex {
  // Postgres Flex instances
  instances() []stackit.postgresFlex.instance
  // Engine versions the service currently offers
  //
  // An instance whose version is not in this list runs a release the
  // service no longer provisions. Empty when the catalog cannot be read.
  versions() []string
}

// STACKIT Postgres Flex managed database instance
//
// Single managed PostgreSQL instance, selected by its UUID `id` (for
// example `stackit.postgresFlex.instance(id: "...")`). Surfaces the
// engine version, connection ACL, backup schedule, storage sizing,
// replica count, and operator options, so audits can check whether a
// database is reachable from the internet, adequately backed up, or
// running a supported PostgreSQL release.
private stackit.postgresFlex.instance @defaults("id name version status") {
  init(id? string)
  // Instance UUID
  id string
  // Instance name
  name string
  // Status (READY, CREATING, UPDATING, DELETING, FAILED, …)
  status string
  // Region the instance runs in
  region string
  // Postgres major version
  version() string
  // Compute flavor
  //
  // Machine sizing for the instance. Keys: `id` (flavor identifier),
  // `cpu` (vCPU count), `memory` (RAM in GB), and `description`.
  flavor() dict
  // CIDR ranges allowed to connect to the instance
  acl() []string
  // Number of replicas
  replicas() int
  // Storage configuration
  //
  // Disk allocation for the instance. Keys: `size` (provisioned
  // capacity in GB) and `class` (storage performance class).
  storage() dict
  // Backup schedule as a cron expression
  backupSchedule() string
  // Operator-tunable engine options as name/value pairs
  options() map[string]string
  // Whether the instance accepts connections from any address
  //
  // True only when the connection ACL explicitly admits a default route
  // (0.0.0.0/0 or ::/0). An empty ACL is not flagged: the Flex API exposes no
  // public-endpoint indicator, so an unpopulated ACL cannot be assumed to be
  // internet-reachable.
  internetReachable() bool
  // Database users defined on the instance
  users() []stackit.postgresFlex.instance.user
  // Backups taken of the instance
  //
  // Proof that the backup schedule produces backups and how the last ones
  // ended. Empty when none exist or the credential cannot list them.
  backups() []stackit.postgresFlex.instance.backup
}

// STACKIT Postgres Flex database user
//
// Database login on a Postgres Flex instance, keyed by its UUID `id`. The
// `roles` a user holds decide what it can do once connected, so pairing
// them with the instance `acl` gives both halves of the access question:
// who can reach the database and what they may do there. Reading `roles`,
// `host`, or `port` fetches the user record on demand; `username` comes
// from the instance listing.
private stackit.postgresFlex.instance.user @defaults("username roles") {
  // User UUID
  id string
  // Login name
  username string
  // Roles granted to the user
  //
  // PostgreSQL role names, for example login, createdb, or a role conferring
  // superuser rights. A user holding a broad role can act well beyond the
  // schema it was provisioned for.
  roles() []string
  // Host the user is permitted to connect from
  host() string
  // Port the user connects on
  port() int
}

// Backup of a STACKIT Postgres Flex instance
//
// One backup the service took of the instance, keyed by UUID `id`. The
// `error` text is empty for a backup that succeeded, and `startedAt` and
// `finishedAt` bound the run, so the most recent entry answers whether
// backups are current and healthy.
private stackit.postgresFlex.instance.backup @defaults("name finishedAt error") {
  // Backup UUID
  id string
  // Backup name
  name string
  // When the backup run started
  startedAt time
  // When the backup run finished
  finishedAt time
  // Backup size in bytes
  size int
  // Failure recorded for the run; empty when it succeeded
  error string
  // Labels on the backup
  labels []string
}

// STACKIT MongoDB Flex namespace
//
// Entry point for the managed MongoDB Flex service in a STACKIT
// project. The instances field lists every managed MongoDB instance
// provisioned in the project.
stackit.mongoDbFlex {
  // MongoDB Flex instances
  instances() []stackit.mongoDbFlex.instance
  // Engine versions the service currently offers
  //
  // An instance whose version is not in this list runs a release the
  // service no longer provisions. Empty when the catalog cannot be read.
  versions() []string
}

// STACKIT MongoDB Flex managed database instance
//
// Managed MongoDB instance in a STACKIT project, selected by its UUID
// id. Covers the engine version, compute flavor, replica count,
// storage, backup schedule, region, and the connection ACL. The
// internetReachable predicate flags instances whose ACL admits a
// default route (0.0.0.0/0 or ::/0).
private stackit.mongoDbFlex.instance @defaults("id name version status") {
  init(id? string)
  // Instance UUID
  id string
  // Instance name
  name string
  // Status (READY, PENDING, PROCESSING, FAILED, UNKNOWN)
  status string
  // Region the instance runs in
  region string
  // MongoDB major version
  version() string
  // Compute flavor
  //
  // Dict describing the compute flavor backing the instance, with keys
  // id, cpu, memory, and description.
  flavor() dict
  // Number of replicas backing the instance
  replicas() int
  // Storage configuration
  //
  // Dict describing the instance storage, with keys size and class.
  storage() dict
  // Backup schedule as a cron expression
  backupSchedule() string
  // CIDR blocks allowed to connect to the instance
  acl() []string
  // Free-form operator-tunable engine options keyed by option name
  options() map[string]string
  // Whether the instance accepts connections from any address
  //
  // True only when the connection ACL explicitly admits a default route
  // (0.0.0.0/0 or ::/0). An empty ACL is not flagged: the Flex API exposes no
  // public-endpoint indicator, so an unpopulated ACL cannot be assumed to be
  // internet-reachable.
  internetReachable() bool
  // Database users defined on the instance
  users() []stackit.mongoDbFlex.instance.user
  // Backups taken of the instance
  //
  // Proof that the backup schedule produces backups and how the last ones
  // ended. Empty when none exist or the credential cannot list them.
  backups() []stackit.mongoDbFlex.instance.backup
}

// STACKIT MongoDB Flex database user
//
// Database login on a MongoDB Flex instance, keyed by its UUID `id`. The
// `roles` a user holds decide what it can do once connected, so pairing them
// with the instance `acl` gives both halves of the access question: who can
// reach the database and what they may do there. Reading `roles`,
// `database`, `host`, or `port` fetches the user record on demand;
// `username` comes from the instance listing.
private stackit.mongoDbFlex.instance.user @defaults("username roles") {
  // User UUID
  id string
  // Login name
  username string
  // Roles granted to the user
  //
  // MongoDB role names, for example read, readWrite, or a cluster-wide
  // administrative role. Roles scoped beyond the user's own database widen
  // what a stolen credential reaches.
  roles() []string
  // Database the user authenticates against
  database() string
  // Host the user is permitted to connect from
  host() string
  // Port the user connects on
  port() int
}

// Backup of a STACKIT MongoDB Flex instance
//
// One backup the service took of the instance, keyed by UUID `id`. The
// `error` text is empty for a backup that succeeded, and `startedAt` and
// `finishedAt` bound the run, so the most recent entry answers whether
// backups are current and healthy.
private stackit.mongoDbFlex.instance.backup @defaults("name finishedAt error") {
  // Backup UUID
  id string
  // Backup name
  name string
  // When the backup run started
  startedAt time
  // When the backup run finished
  finishedAt time
  // Backup size in bytes
  size int
  // Failure recorded for the run; empty when it succeeded
  error string
  // Labels on the backup
  labels []string
}

// STACKIT SQLServer Flex namespace
//
// Managed Microsoft SQL Server instances running on STACKIT's SQLServer
// Flex service. The `instances` field lists every SQL Server Flex
// instance provisioned in the project, the entry point for auditing
// their sizing, backup schedule, and network exposure.
stackit.sqlServerFlex {
  // SQLServer Flex instances
  instances() []stackit.sqlServerFlex.instance
  // Engine versions the service currently offers
  //
  // An instance whose version is not in this list runs a release the
  // service no longer provisions. Empty when the catalog cannot be read.
  versions() []string
}

// STACKIT SQLServer Flex managed database instance
//
// Single managed Microsoft SQL Server instance provisioned through
// SQLServer Flex, selected by its UUID `id` (for example
// `stackit.sqlServerFlex.instance(id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx")`).
// Covers the deployment shape (flavor, replicas, storage, version),
// operational status, backup schedule, and the connection ACL that
// governs which networks may reach the database. The `internetReachable`
// predicate reports whether that ACL leaves the instance open to the
// public internet.
private stackit.sqlServerFlex.instance @defaults("id name version status") {
  init(id? string)
  // Instance UUID
  id string
  // Instance name
  name string
  // Status (READY, CREATING, UPDATING, DELETING, FAILED, …)
  status string
  // Region the instance runs in
  region string
  // SQLServer version
  version() string
  // Machine flavor
  //
  // Compute shape of the instance, with keys `id`, `cpu` (vCPU count),
  // `memory` (RAM), and `description`.
  flavor() dict
  // CIDR blocks allowed to connect to the instance
  acl() []string
  // Number of replicas
  replicas() int
  // Storage configuration
  //
  // Disk allocation of the instance, with keys `size` (in GB) and
  // `class` (storage class).
  storage() dict
  // Backup schedule as a cron expression
  backupSchedule() string
  // Operator-tunable engine options as key/value pairs
  options() map[string]string
  // SQL Server edition the instance runs
  //
  // The edition from the instance options (for example developer,
  // express, standard, or enterprise), which decides the feature set
  // available to the instance. Null when the options carry no edition.
  edition() string
  // Days backup files are kept before cleanup
  //
  // From the retentionDays instance option, which the service accepts in
  // the range 30 to 365. Null when the option is absent or not numeric.
  backupRetentionDays() int
  // Whether the instance accepts connections from any address
  //
  // True only when the connection ACL explicitly admits a default route
  // (0.0.0.0/0 or ::/0). An empty ACL is not flagged: the Flex API exposes no
  // public-endpoint indicator, so an unpopulated ACL cannot be assumed to be
  // internet-reachable.
  internetReachable() bool
  // Database users defined on the instance
  users() []stackit.sqlServerFlex.instance.user
  // Backups taken of the instance
  //
  // Proof that the backup schedule produces backups and how the last ones
  // ended. Empty when none exist or the credential cannot list them.
  backups() []stackit.sqlServerFlex.instance.backup
}

// STACKIT SQLServer Flex database user
//
// Database login on a SQLServer Flex instance, keyed by its UUID `id`. The
// `roles` a user holds decide what it can do once connected, so pairing them
// with the instance `acl` gives both halves of the access question: who can
// reach the database and what they may do there. Reading `roles`,
// `defaultDatabase`, `host`, or `port` fetches the user record on demand;
// `username` comes from the instance listing.
private stackit.sqlServerFlex.instance.user @defaults("username roles") {
  // User UUID
  id string
  // Login name
  username string
  // Roles granted to the user
  //
  // SQL Server role names, for example db_datareader, db_datawriter, or
  // db_owner. A user in an owner or server-level role can change the schema
  // and the permissions of other users.
  roles() []string
  // Database the user connects to by default
  defaultDatabase() string
  // Host the user is permitted to connect from
  host() string
  // Port the user connects on
  port() int
}

// Backup of a STACKIT SQL Server Flex instance
//
// One backup the service took of the instance, keyed by UUID `id`. The
// `error` text is empty for a backup that succeeded, and `startedAt` and
// `finishedAt` bound the run, so the most recent entry answers whether
// backups are current and healthy.
private stackit.sqlServerFlex.instance.backup @defaults("name finishedAt error") {
  // Backup UUID
  id string
  // Backup name
  name string
  // Database the backup belongs to
  //
  // SQL Server Flex backs up each database separately.
  database string
  // When the backup run started
  startedAt time
  // When the backup run finished
  finishedAt time
  // Backup size in bytes
  size int
  // Failure recorded for the run; empty when it succeeded
  error string
  // Labels on the backup
  labels []string
}

// STACKIT OpenSearch namespace
//
// Entry point for the managed OpenSearch service in a STACKIT
// project. The `instances` field lists every provisioned OpenSearch
// database instance, so you can audit their plans, provisioning
// status, and network exposure across the project.
stackit.openSearch {
  // OpenSearch instances
  instances() []stackit.openSearch.instance
  // Engine offerings the service currently provides
  //
  // The catalog of engine versions and plans, where a version is marked
  // latest or carries a lifecycle state and a plan is marked free. Empty
  // when the catalog cannot be read.
  offerings() []stackit.openSearch.offering
}

// STACKIT OpenSearch managed database instance
//
// Single managed OpenSearch database provisioned through the STACKIT
// DBaaS platform. The instance is keyed by its UUID `id`, for example
// `stackit.openSearch.instance(id: "...")`. Query it to audit the
// service plan and offering, provisioning status, and network
// exposure: `parameters` carries the public-access flag and source-IP
// allow-list, and `internetReachable` reports whether the instance
// accepts connections from any address.
private stackit.openSearch.instance @defaults("id name status planName") {
  init(id? string)
  // Instance UUID
  id string
  // Instance name
  name string
  // Outcome of the last provisioning operation
  //
  // One of "in progress", "succeeded", or "failed". Reports how the
  // last create, update, or delete went (see lastOperationType), not
  // whether the instance is running; read state for that.
  status string
  // Plan name (sizing/quota tier)
  planName string
  // Plan UUID
  planId string
  // Service offering name (e.g., opensearch)
  offeringName string
  // Engine version of the service offering
  //
  // Version of the OpenSearch release the instance runs. `offeringName` names
  // the engine but not its version, and `imageUrl` carries the version only
  // inside an opaque image path, so this is the field to compare against an
  // end-of-life list. Null when the API reports no version for the instance.
  offeringVersion string
  // Cloud-Foundry-style organization GUID
  cfOrganizationGuid string
  // Cloud-Foundry-style space GUID
  cfSpaceGuid string
  // Dashboard URL for the DBaaS UI (empty if not provisioned)
  dashboardUrl string
  // Image / engine version
  imageUrl string
  // Instance connection and networking parameters
  //
  // Free-form map returned by the DBaaS API, holding the connection
  // endpoint details along with the networking controls that drive
  // `internetReachable`: `enable_public_access` (bool) toggles a
  // public endpoint, and `sgw_acl` is the source-IP allow-list of CIDR
  // ranges. The password is not included.
  parameters dict
  // Instance lifecycle state
  //
  // Whether the instance is running, as reported by the service: one of
  // active, failed, stopped, creating, deleting, or updating. Distinct
  // from status, which is the outcome of the last provisioning operation;
  // a stopped instance can still report a succeeded status.
  state string
  // Kind of the last provisioning operation
  //
  // One of create, update, or delete. Qualifies status: a succeeded
  // delete is not a healthy instance.
  lastOperationType string
  // Description of the last provisioning operation, including the failure reason when it failed
  lastOperationDescription string
  // Region the instance runs in
  region string
  // Cloud Foundry service instance GUID
  cfGuid string
  // CIDR allow-list of client networks permitted to reach the instance
  //
  // From the sgw_acl parameter, the one network control the service
  // exposes on these instances. Empty when no allow-list is configured,
  // which leaves the instance reachable from any address.
  sgwAcl() []string
  // Remote syslog endpoints the instance forwards its logs to
  //
  // Each entry is a syslog drain the instance ships logs to, an egress
  // path for log data that may include connection details. Empty when
  // none is configured.
  syslog() []string
  // Graphite endpoint the instance ships metrics to
  //
  // Host and port of an external Graphite receiver, an off-platform
  // metrics egress. Empty when metrics stay on the platform.
  graphite() string
  // Whether the instance ships metrics to a STACKIT Observability instance
  //
  // Null when the parameter is absent.
  monitoringEnabled() bool
  // Observability instance the instance ships metrics to (nullable)
  //
  // Null when monitoring is not configured or the referenced instance is
  // not readable from this project.
  monitoringInstance() stackit.observability.instance
  // Disk usage percentage at which the node halts to protect data
  //
  // The max_disk_threshold parameter. Null when the parameter is absent.
  maxDiskThreshold() int
  // Backups taken of the instance
  //
  // Proof that backups exist and how the last ones ended. Empty when none
  // exist or the credential cannot list them.
  backups() []stackit.openSearch.instance.backup
  // Catalog offering the instance runs (nullable)
  //
  // Matched by offeringVersion against the engine catalog. Follow it to
  // read whether the version is the latest and its lifecycle state. Null
  // when the catalog does not list the version or cannot be read.
  offering() stackit.openSearch.offering
  // Catalog plan the instance runs on (nullable)
  //
  // Matched by planId against the engine catalog. Null when the catalog
  // does not list the plan or cannot be read.
  plan() stackit.openSearch.offering.plan
  // OpenSearch plugins enabled on the instance
  //
  // Any of repository-s3, repository-azure (both always on), or
  // analysis-phonetic. The repository plugins are the snapshot egress
  // surface to external object stores.
  plugins() []string
  // Whether the instance accepts connections from any address
  //
  // True when the instance's parameters enable public access and the
  // source-IP allow-list (`sgw_acl`) is empty or admits any address
  // (0.0.0.0/0 or ::/0), making the instance reachable from the internet.
  internetReachable() bool
  // Enabled TLS protocol versions
  //
  // TLS protocol versions the instance's OpenSearch endpoint accepts,
  // from the `tls-protocols` parameter (for example TLSv1.2 or TLSv1.3).
  // Empty when the instance uses the service default. Use it to audit
  // instances still accepting legacy TLS versions.
  tlsProtocols() []string
  // Enabled TLS cipher list
  //
  // Cipher suites the OpenSearch endpoint offers, from the `tls-ciphers`
  // parameter. Empty when the instance uses the service default.
  tlsCiphers() []string
}

// Backup of a STACKIT OpenSearch instance
//
// One backup the service took of the instance, keyed by its numeric `id`
// rendered as a string. `status` and `finishedAt` on the most recent
// entry answer whether backups are current and healthy; `downloadable`
// says whether the backup can be retrieved through the API.
private stackit.openSearch.instance.backup @defaults("id status finishedAt") {
  // Backup identifier
  id string
  // Backup status as reported by the service
  status string
  // Backup size in bytes
  //
  // Null when the service reports no size.
  size int
  // Whether the backup can be downloaded through the API
  //
  // Null when the service reports no setting.
  downloadable bool
  // When the backup was triggered
  triggeredAt time
  // When the backup finished
  finishedAt time
}

// Catalog offering for STACKIT OpenSearch
//
// One engine version the service provides, keyed by `name` and
// `version`. `latest` marks the current release and `lifecycle` carries
// the state the service assigns to older ones, so an instance on a
// non-latest or retired version can be found through its offering.
private stackit.openSearch.offering @defaults("name version latest lifecycle") {
  // Offering name
  name string
  // Engine version
  version string
  // Whether this is the latest version the service provides
  latest bool
  // Lifecycle state the service assigns to the version; empty when none
  lifecycle string
  // Description
  description string
  // Documentation link
  documentationUrl string
  // Number of instances of this offering the project may create
  quotaCount int
  // Plans available for the offering
  plans() []stackit.openSearch.offering.plan
}

// Plan within a STACKIT OpenSearch offering
//
// One sizing plan of an engine offering, keyed by UUID `id`. `free`
// marks the trial plan, which carries no availability commitment.
private stackit.openSearch.offering.plan @defaults("name skuName free") {
  // Plan UUID
  id string
  // Plan name
  name string
  // SKU name the plan is billed under
  skuName string
  // Whether this is the free plan
  free bool
  // Description
  description string
}

// STACKIT MariaDB namespace
//
// Entry point for the managed MariaDB database service in the project.
// The `instances` field lists every MariaDB instance, each a managed
// database whose plan, service offering, connection parameters, and
// internet reachability you can audit.
stackit.mariaDb {
  // MariaDB instances
  instances() []stackit.mariaDb.instance
  // Engine offerings the service currently provides
  //
  // The catalog of engine versions and plans, where a version is marked
  // latest or carries a lifecycle state and a plan is marked free. Empty
  // when the catalog cannot be read.
  offerings() []stackit.mariaDb.offering
}

// STACKIT MariaDB managed database instance
//
// Single managed MariaDB instance, keyed by its UUID `id` (for example
// `stackit.mariaDb.instance(id: "...")`). Carries the plan and service
// offering that size the database, the connection `parameters` the API
// returns, and `internetReachable`, which reports whether the instance
// is reachable from the public internet.
private stackit.mariaDb.instance @defaults("id name status planName") {
  init(id? string)
  // Instance UUID
  id string
  // Instance name
  name string
  // Outcome of the last provisioning operation
  //
  // One of "in progress", "succeeded", or "failed". Reports how the
  // last create, update, or delete went (see lastOperationType), not
  // whether the instance is running; read state for that.
  status string
  // Plan name (sizing/quota tier)
  planName string
  // Plan UUID
  planId string
  // Service offering name
  offeringName string
  // Engine version of the service offering
  //
  // Version of the MariaDB release the instance runs. `offeringName` names
  // the engine but not its version, and `imageUrl` carries the version only
  // inside an opaque image path, so this is the field to compare against an
  // end-of-life list. Null when the API reports no version for the instance.
  offeringVersion string
  // Cloud-Foundry-style organization GUID
  cfOrganizationGuid string
  // Cloud-Foundry-style space GUID
  cfSpaceGuid string
  // Dashboard URL for the DBaaS UI (empty if not provisioned)
  dashboardUrl string
  // Image / engine version
  imageUrl string
  // Connection and networking parameters returned by the API
  //
  // Free-form map of instance settings. Security-relevant keys include
  // `enable_public_access` (whether a public endpoint is exposed) and
  // `sgw_acl` (the source-IP allow-list applied to that endpoint). The
  // derived `internetReachable` field folds these into a single
  // public-reachability verdict.
  parameters dict
  // Instance lifecycle state
  //
  // Whether the instance is running, as reported by the service: one of
  // active, failed, stopped, creating, deleting, or updating. Distinct
  // from status, which is the outcome of the last provisioning operation;
  // a stopped instance can still report a succeeded status.
  state string
  // Kind of the last provisioning operation
  //
  // One of create, update, or delete. Qualifies status: a succeeded
  // delete is not a healthy instance.
  lastOperationType string
  // Description of the last provisioning operation, including the failure reason when it failed
  lastOperationDescription string
  // Region the instance runs in
  region string
  // Cloud Foundry service instance GUID
  cfGuid string
  // CIDR allow-list of client networks permitted to reach the instance
  //
  // From the sgw_acl parameter, the one network control the service
  // exposes on these instances. Empty when no allow-list is configured,
  // which leaves the instance reachable from any address.
  sgwAcl() []string
  // Remote syslog endpoints the instance forwards its logs to
  //
  // Each entry is a syslog drain the instance ships logs to, an egress
  // path for log data that may include connection details. Empty when
  // none is configured.
  syslog() []string
  // Graphite endpoint the instance ships metrics to
  //
  // Host and port of an external Graphite receiver, an off-platform
  // metrics egress. Empty when metrics stay on the platform.
  graphite() string
  // Whether the instance ships metrics to a STACKIT Observability instance
  //
  // Null when the parameter is absent.
  monitoringEnabled() bool
  // Observability instance the instance ships metrics to (nullable)
  //
  // Null when monitoring is not configured or the referenced instance is
  // not readable from this project.
  monitoringInstance() stackit.observability.instance
  // Disk usage percentage at which the node halts to protect data
  //
  // The max_disk_threshold parameter. Null when the parameter is absent.
  maxDiskThreshold() int
  // Backups taken of the instance
  //
  // Proof that backups exist and how the last ones ended. Empty when none
  // exist or the credential cannot list them.
  backups() []stackit.mariaDb.instance.backup
  // Catalog offering the instance runs (nullable)
  //
  // Matched by offeringVersion against the engine catalog. Follow it to
  // read whether the version is the latest and its lifecycle state. Null
  // when the catalog does not list the version or cannot be read.
  offering() stackit.mariaDb.offering
  // Catalog plan the instance runs on (nullable)
  //
  // Matched by planId against the engine catalog. Null when the catalog
  // does not list the plan or cannot be read.
  plan() stackit.mariaDb.offering.plan
  // Whether the instance accepts connections from any address
  //
  // True when the instance's parameters enable public access and the
  // source-IP allow-list (`sgw_acl`) is empty or admits any address
  // (0.0.0.0/0 or ::/0), making the instance reachable from the internet.
  internetReachable() bool
}

