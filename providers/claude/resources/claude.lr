import core

option provider = "go.mondoo.com/mql/providers/claude"
option go_package = "go.mondoo.com/mql/providers/claude/resources"
option root = "claude"

// Claude AI platform
//
// Models available through the Claude API, along with managed agents,
// execution environments, agent sessions, uploaded files, registered
// skills, secret vaults, memory stores, message batches, and user
// profiles. When an admin API key is configured, organizational
// resources such as workspaces, members, invites, API keys, usage,
// cost, and rate limits also become queryable.
claude @defaults("host") @root {
  // API host address
  host() string
  // Available models
  models() []claude.model
  // Managed agents
  agents() []claude.agent
  // Execution environments
  environments() []claude.environment
  // Agent sessions
  sessions() []claude.session
  // Uploaded files
  files() []claude.file
  // Registered skills
  skills() []claude.skill
  // Secret vaults
  vaults() []claude.vault
  // Memory stores
  memoryStores() []claude.memoryStore
  // Message batches
  messageBatches() []claude.messageBatch
  // User profiles
  userProfiles() []claude.userProfile
}

// Claude AI model
//
// AI model available through the Claude API, including its token
// limits and capability flags. The `id` field is the canonical model
// identifier (for example `claude-opus-4-6`) and serves as the
// selection key for `claude.model(id: "claude-opus-4-6")`.
claude.model @defaults("id displayName") {
  init(id string)
  // Canonical model identifier
  id string
  // Human-readable display name
  displayName string
  // Model vendor
  //
  // Always "Anthropic" for models served through the Claude API.
  vendor string
  // Model family
  //
  // Parsed from the model identifier, for example opus, sonnet, or haiku.
  family string
  // Object type
  //
  // Always "model" for Claude model resources.
  type string
  // Model creation timestamp
  createdAt time
  // Maximum input context window size in tokens
  maxInputTokens int
  // Maximum output tokens
  maxTokens int
  // Whether batch processing is supported
  batchSupported bool
  // Whether citation extraction is supported
  citationsSupported bool
  // Whether code execution is supported
  codeExecutionSupported bool
  // Whether image input is supported
  imageInputSupported bool
  // Whether PDF input is supported
  pdfInputSupported bool
  // Whether structured output is supported
  structuredOutputsSupported bool
  // Whether extended thinking is supported
  thinkingSupported bool
}

// Claude managed agent
//
// Managed agent definition created through the Beta Agents API and
// executed within sessions. Auditing an agent surfaces the model it
// runs on, its system prompt, and its version and archival state,
// which together govern the instructions in effect for every session
// that uses it. It also surfaces what the agent is permitted to do:
// the toolsets it can call and the permission policy on each tool, the
// MCP servers it reaches out to, the skills it loads, and the roster of
// other agents it may spawn.
claude.agent @defaults("id name") {
  // Agent identifier
  id string
  // Agent name
  name string
  // Agent description
  description string
  // System prompt
  system string
  // Model identifier used by this agent
  model string
  // Reasoning effort applied on each turn
  //
  // One of low, medium, high, xhigh, or max. Empty when the agent does
  // not pin an effort level.
  modelEffort string
  // Geographic region for model inference
  //
  // Empty when the agent inherits the default inference region of the
  // workspace it runs in.
  modelInferenceGeo string
  // Inference speed mode
  //
  // One of standard or fast.
  modelSpeed string
  // User-provided metadata key-value pairs
  metadata map[string]string
  // MCP servers the agent can reach
  //
  // Maps each configured server name to its URL. Every entry is a network
  // destination the agent may call during a session, so an unrecognized
  // host, or a plaintext one, widens what the agent can talk to.
  mcpServers map[string]string
  // Skills attached to the agent
  skills []claude.agent.skill
  // Toolsets available to the agent
  toolsets []claude.agent.toolset
  // Custom tools defined on the agent
  customTools []claude.agent.customTool
  // Multiagent topology
  //
  // Set to coordinator when the agent may spawn other agents as session
  // threads, and empty when the agent runs alone.
  multiagentType string
  // Agents this agent may spawn as session threads
  //
  // The roster the coordinator draws from, which is how far a single
  // session can reach beyond the agent that started it.
  subagents() []claude.agent
  // Models backing the advisors in the multiagent roster
  advisorModels []string
  // Agent version number
  version int
  // Agent creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Archive timestamp, if applicable
  archivedAt time
  // Object type
  type string
}

// Skill attached to a Claude agent
//
// Version-pinned skill an agent loads at runtime, extending it with
// reusable instructions. The source separates Anthropic-provided skills
// from custom ones authored inside the organization, which is the line
// between vendor-reviewed instructions and instructions anyone with
// skill-write access can change under a running agent.
private claude.agent.skill @defaults("source version") {
  // Skill attached to the agent
  skill() claude.skill
  // Skill source
  //
  // One of anthropic or custom.
  source string
  // Pinned skill version
  version string
}

// Toolset available to a Claude agent
//
// Group of tools an agent can call, together with the permission policy
// governing them. A built-in toolset covers the agent's own capabilities
// such as shell, file, and web access, while an MCP toolset exposes the
// tools published by one connected MCP server. The default policy applies
// to every tool in the group that carries no entry of its own, so a
// default of always_allow means those tools run without a confirmation
// step.
private claude.agent.toolset @defaults("type defaultPermissionPolicy") {
  // Toolset type
  //
  // One of agent_toolset_20260401 or mcp_toolset.
  type string
  // MCP server supplying the tools
  //
  // Empty for built-in toolsets.
  mcpServerName string
  // Whether tools without an entry of their own are enabled
  defaultEnabled bool
  // Permission policy for tools without an entry of their own
  //
  // One of always_allow or always_ask.
  defaultPermissionPolicy string
  // Tools configured individually within the toolset
  tools []claude.agent.toolset.tool
}

// Tool configured on a Claude agent toolset
//
// Single tool carrying its own enablement and permission policy, which
// override the toolset default. For a built-in toolset the name is one of
// bash, edit, read, write, glob, grep, web_fetch, or web_search. For an
// MCP toolset it is a tool name published by the connected server.
private claude.agent.toolset.tool @defaults("name enabled permissionPolicy") {
  // Tool name
  name string
  // Whether the tool is enabled
  enabled bool
  // Permission policy for tool execution
  //
  // One of always_allow or always_ask.
  permissionPolicy string
}

// Custom tool defined on a Claude agent
//
// Tool declared inline on an agent rather than supplied by a built-in
// toolset or an MCP server. The description is the text the model reads
// when deciding whether to call it, and the input schema states the
// parameters it accepts.
private claude.agent.customTool @defaults("name") {
  // Tool name
  name string
  // Tool description
  description string
  // JSON Schema for the tool's input parameters
  inputSchema dict
}

// Claude execution environment
//
// Execution environment that defines the compute context and
// visibility scope in which agent sessions run. Audit environments
// to see where agents execute and how broadly they are exposed. The
// `scope` field is one of organization or account, distinguishing an
// environment shared across the whole organization from one confined
// to a single account. The network policy states which hosts a session
// can reach from inside the environment, and the package fields list
// what is installed in the sandbox the agent runs in.
claude.environment @defaults("id name") {
  // Environment identifier
  id string
  // Environment name
  name string
  // Environment description
  description string
  // Visibility scope
  //
  // One of organization or account.
  scope string
  // Environment configuration type
  //
  // One of cloud or self_hosted.
  configType string
  // Network policy
  //
  // One of unrestricted or limited. An unrestricted environment can reach
  // any host from an agent session, so nothing constrains where data goes
  // once an agent is running in it.
  networkingType string
  // Hosts reachable from the environment
  //
  // The allowlist in force under a limited network policy. Empty when the
  // policy is unrestricted, where no allowlist applies.
  allowedHosts []string
  // Whether MCP servers are reachable under a limited network policy
  //
  // Null when the network policy is unrestricted.
  allowMcpServers bool
  // Whether package registries are reachable under a limited network policy
  //
  // Null when the network policy is unrestricted.
  allowPackageManagers bool
  // Ubuntu and Debian packages installed in the environment
  aptPackages []string
  // Rust packages installed in the environment
  cargoPackages []string
  // Ruby packages installed in the environment
  gemPackages []string
  // Go packages installed in the environment
  goPackages []string
  // Node.js packages installed in the environment
  npmPackages []string
  // Python packages installed in the environment
  pipPackages []string
  // User-provided metadata key-value pairs
  metadata map[string]string
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Archive timestamp, if applicable
  archivedAt time
  // Object type
  type string
}

// Claude agent session
//
// Agent session in the Claude platform, including its execution status,
// the environment it runs in, and its lifecycle timestamps. Auditing
// sessions shows which agent work is active or idle and which environment
// each session is bound to. The `status` field is one of rescheduling,
// running, idle, or terminated.
claude.session @defaults("id title status") {
  // Session identifier
  id string
  // Session title
  title string
  // Session status
  //
  // One of rescheduling, running, idle, or terminated.
  status string
  // Execution environment this session runs in
  //
  // The environment supplies the compute context and visibility scope
  // for the session, so reading it alongside the session shows where
  // the agent work actually executes.
  environment() claude.environment
  // Session creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Archive timestamp, if applicable
  archivedAt time
  // Object type
  type string
}

// Claude uploaded file
//
// File uploaded to the Claude platform and managed through the Beta
// Files API, exposing its original filename, MIME type, size in
// bytes, and whether it can be downloaded, along with its upload
// timestamp. Useful for inventorying which files are available to
// agents and auditing their download exposure.
claude.file @defaults("id filename") {
  // File identifier
  id string
  // Original filename
  filename string
  // MIME type
  mimeType string
  // File size in bytes
  sizeBytes int
  // Whether the file can be downloaded
  downloadable bool
  // Upload timestamp
  createdAt time
  // Object type
  type string
}

// Claude registered skill
//
// Skill registered in the Claude platform, packaging reusable
// instructions that extend agent capabilities. Skills can be
// Anthropic-provided or custom, letting you audit which extensions
// are available to agents and where they originate. The `source`
// field is one of custom or anthropic.
claude.skill @defaults("id displayTitle") {
  // Skill identifier
  id string
  // Skill display title
  displayTitle string
  // Skill source
  //
  // One of custom (authored in the workspace), anthropic (published by
  // Anthropic and read-only), anthropic_example (an Anthropic-published
  // sample), or plugin (resolved from an installed plugin).
  source string
  // Latest version identifier
  latestVersion string
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Object type
  type string
}

// Claude secret vault
//
// Secret vault used to store credentials for agent sessions.
// Vaults hold credentials that agents can access at runtime
// without exposing secrets in prompts.
claude.vault @defaults("id displayName") {
  // Vault identifier
  id string
  // Vault display name
  displayName string
  // Vault creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Archive timestamp, if applicable
  archivedAt time
  // Object type
  type string
  // Credentials stored in this vault
  credentials() []claude.vault.credential
}

// Claude vault credential
//
// Credential stored in a Claude vault. Credentials provide
// authentication details that agents can use during sessions without
// exposing secrets in prompts or tool calls.
claude.vault.credential @defaults("id displayName") {
  // Credential identifier
  id string
  // Credential display name
  displayName string
  // Vault that holds this credential
  vault() claude.vault
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Archive timestamp, if applicable
  archivedAt time
  // Object type
  type string
}

// Claude memory store
//
// Memory store used to persist context across agent sessions. Memory
// stores are mounted under `/mnt/memory/` in the agent environment,
// and their description is included in the system prompt, so their
// name, description, and archival state are worth auditing to
// understand what long-lived context agents can read and write.
claude.memoryStore @defaults("id name") {
  // Memory store identifier
  id string
  // Memory store name
  name string
  // Memory store description
  description string
  // Creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Archive timestamp, if applicable
  archivedAt time
  // Object type
  type string
}

// Claude message batch
//
// Message batch job that submits multiple message requests for
// asynchronous processing, exposing its processing status and
// lifecycle timestamps (creation, expiration, end, cancellation, and
// archival). Useful for auditing in-flight and completed batch
// workloads and their retention. The `processingStatus` field is one
// of in_progress, canceling, or ended.
claude.messageBatch @defaults("id processingStatus") {
  // Batch identifier
  id string
  // Processing status
  //
  // One of in_progress, canceling, or ended.
  processingStatus string
  // Batch creation timestamp
  createdAt time
  // Processing end timestamp, if applicable
  endedAt time
  // Batch expiration timestamp
  expiresAt time
  // Archive timestamp, if applicable
  archivedAt time
  // Cancellation initiation timestamp, if applicable
  cancelInitiatedAt time
  // Object type
  type string
}

// Claude user profile
//
// User profile representing an entity that interacts with the Claude
// platform. The `accessType` field describes how the platform uses the
// API on behalf of the entity, and `externalUserOnboardedAt` records when
// the platform onboarded the end user behind the profile.
claude.userProfile @defaults("id name accessType") {
  // Profile identifier
  id string
  // Profile display name
  name string
  // Platform-provided external identifier
  externalId string
  // Relationship to the platform
  //
  // Deprecated in favor of accessType. The API no longer reports a
  // relationship, so this field is always null.
  relationship @maturity("deprecated") @replaced_by("claude.userProfile.accessType") string
  // How the platform uses the API on behalf of this entity
  //
  // `application` means the platform sells a product that calls the API
  // behind the scenes and the profile is an individual end user of that
  // product. `passthrough` means the platform resells raw inference and the
  // profile identifies the company it is resold to. Null when the profile
  // does not report an access type.
  accessType string
  // Timestamp the platform onboarded the end user behind this profile
  //
  // Null when the platform has not reported an onboarding time.
  externalUserOnboardedAt time
  // Profile creation timestamp
  createdAt time
  // Last update timestamp
  updatedAt time
  // Object type
  type string
}

// Claude organization
//
// Organizational resources managed through the Claude Admin API:
// identity, workspaces, members, pending invites, API keys, usage,
// cost, and rate limits. Requires an admin API key configured via
// `--admin-token` or the `ANTHROPIC_ADMIN_API_KEY` environment variable.
claude.organization @defaults("id name") {
  // Organization identifier
  id string
  // Organization display name
  name string
  // Workspaces in the organization
  workspaces() []claude.organization.workspace
  // Organization members
  members() []claude.organization.member
  // Pending invitations
  invites() []claude.organization.invite
  // API keys in the organization
  apiKeys() []claude.organization.apiKey
  // Organization-level rate limits
  rateLimits() []claude.organization.rateLimit
  // Token usage report entries
  usageReport() []claude.organization.usageEntry
  // Cost report entries
  costReport() []claude.organization.costEntry
  // Compliance activity log entries
  activities() []claude.organization.activity
  // Service accounts in the organization
  serviceAccounts() []claude.organization.serviceAccount
  // Workload identity federation issuers the organization trusts
  federationIssuers() []claude.organization.federationIssuer
  // Rules mapping federated identities onto organization access
  federationRules() []claude.organization.federationRule
}

// Claude organization workspace
//
// Workspace within the Claude organization, including its name, display
// color, creation date, archive status, data residency configuration,
// and workspace-level members and rate limits.
claude.organization.workspace @defaults("id name") {
  // Workspace identifier
  id string
  // Workspace name
  name string
  // Hex display color for the console UI
  displayColor string
  // Workspace creation timestamp
  createdAt time
  // Timestamp when the workspace was archived, if applicable
  archivedAt time
  // Workspace geographic region
  workspaceGeo string
  // Default inference geographic region
  defaultInferenceGeo string
  // Allowed inference geographic regions
  allowedInferenceGeos []string
  // Members with access to this workspace
  members() []claude.organization.workspace.member
  // Workspace-level rate limit overrides
  rateLimits() []claude.organization.rateLimit
}

// Claude organization workspace member
//
// Member's access to a specific workspace. The `workspaceRole` field is
// one of workspace_user, workspace_developer,
// workspace_restricted_developer, workspace_admin, or
// workspace_billing.
claude.organization.workspace.member @defaults("workspaceRole") {
  // Organization member holding this workspace access
  //
  // Carries the member's name, email, and organization-level role, so
  // workspace access can be reviewed against who the person is and what
  // they can already do across the organization.
  user() claude.organization.member
  // Workspace this access grant applies to
  workspace() claude.organization.workspace
  // Workspace-level role
  //
  // One of workspace_user, workspace_developer,
  // workspace_restricted_developer, workspace_admin, or
  // workspace_billing.
  workspaceRole string
}

// Claude organization member
//
// Member of the Claude organization, including their role assignment.
// The `role` field is one of user, developer, billing, admin, or
// claude_code_user.
claude.organization.member @defaults("id name email role") {
  // User identifier
  id string
  // User display name
  name string
  // User email address
  email string
  // Organization role
  //
  // One of user, developer, billing, admin, or claude_code_user.
  role string
  // Timestamp when the user was added to the organization
  addedAt time
}

// Claude organization invite
//
// Pending invitation to the Claude organization. The `status` field is
// one of pending, accepted, expired, or deleted.
claude.organization.invite @defaults("id email role status") {
  // Invite identifier
  id string
  // Invitee email address
  email string
  // Assigned role
  //
  // One of user, developer, billing, admin, or claude_code_user.
  role string
  // Invite status
  //
  // One of pending, accepted, expired, or deleted.
  status string
  // Timestamp when the invite was sent
  invitedAt time
  // Timestamp when the invite expires
  expiresAt time
}

// Claude organization API key
//
// API key in the Claude organization, including its status, associated
// workspace, and creation metadata. The `status` field is one of
// active, inactive, archived, or expired.
claude.organization.apiKey @defaults("id name status") {
  // API key identifier
  id string
  // API key display name
  name string
  // API key status
  //
  // One of active, inactive, archived, or expired.
  status string
  // Timestamp when the key was created
  createdAt time
  // Timestamp when the key expires, if applicable
  expiresAt time
  // Partial key hint for identification
  partialKeyHint string
  // User who created this key
  createdBy() claude.organization.member
  // Workspace this key belongs to
  workspace() claude.organization.workspace
  // Kind of principal the key acts as
  //
  // One of user_actor when the key acts as an organization member, or
  // service_account_actor when it acts as a service account. Null when
  // the key is bound to no principal at all, which covers legacy keys
  // and keys minted through workload identity federation.
  principalType string
  // Organization member the key acts as, when it is bound to one
  principalUser() claude.organization.member
  // Service account the key acts as, when it is bound to one
  principalServiceAccount() claude.organization.serviceAccount
  // Extent of the key's access
  //
  // One of workspace when the key is confined to a single workspace, or
  // organization when it is a principal-bound key with no workspace and
  // so reaches the whole organization. An organization-scoped key is the
  // broader credential of the two.
  scopeType string
}

// Claude organization rate limit group
//
// Organization-level or workspace-level rate limit group. Each group
// covers a category of API usage such as model_group, batch,
// web_search, or files, and lists the models it applies to along with
// per-minute request and token limits.
claude.organization.rateLimit @defaults("groupType") {
  // Rate limit group type
  //
  // One of model_group, batch, token_count, files, skills, or web_search.
  groupType string
  // Models covered by this rate limit group
  models []string
  // Maximum requests per minute
  requestsPerMinute int
  // Maximum input tokens per minute (cache-aware)
  inputTokensPerMinute int
  // Maximum output tokens per minute
  outputTokensPerMinute int
}

// Claude organization usage report bucket
//
// Daily usage bucket from the Admin API usage report. Each bucket covers
// a time window and contains per-model, per-workspace token consumption
// breakdowns for the last seven days.
claude.organization.usageEntry @defaults("startingAt") {
  // Bucket start timestamp
  startingAt time
  // Bucket end timestamp
  endingAt time
  // Model identifier
  model string
  // Workspace the consumption is attributed to
  //
  // Null for buckets that are not scoped to a single workspace.
  workspace() claude.organization.workspace
  // API service tier
  //
  // One of standard, batch, priority, flex, or priority_on_demand.
  serviceTier string
  // Uncached input tokens consumed
  uncachedInputTokens int
  // Input tokens read from cache
  cacheReadInputTokens int
  // Output tokens produced
  outputTokens int
}

// Claude organization cost report bucket
//
// Daily cost bucket from the Admin API cost report. Each bucket covers a
// time window with cost amounts broken down by workspace and cost type.
claude.organization.costEntry @defaults("startingAt costType") {
  // Bucket start timestamp
  startingAt time
  // Bucket end timestamp
  endingAt time
  // Cost amount
  //
  // Decimal string of the cost in the units given by the `currency`
  // field (for example USD).
  amount string
  // Currency code
  currency string
  // Cost type
  //
  // One of tokens, web_search, code_execution, or session_usage.
  costType string
  // Model identifier
  model string
  // Workspace the cost is attributed to
  //
  // Null for buckets that are not scoped to a single workspace.
  workspace() claude.organization.workspace
}

// Claude organization service account
//
// Non-human principal in the Claude organization, holding its own API keys and
// its own organization role. A service account is standing, unattended access:
// it does not expire with a person leaving, so its role and its archive state
// are worth auditing directly. Read `organizationRole` to see how much the
// account can reach and `archivedAt` to tell a retired account from a live
// one, and reach its keys through claude.organization.apiKey where
// principalServiceAccount names this account.
claude.organization.serviceAccount @defaults("id name organizationRole") {
  // Service account identifier
  id string
  // Service account display name
  name string
  // Description recorded on the service account
  description string
  // Role the service account holds in the organization
  //
  // One of admin or developer. An admin service account can administer
  // the organization without a person being involved.
  organizationRole string
  // Timestamp when the service account was created
  createdAt time
  // Timestamp when the service account was last updated
  updatedAt time
  // Timestamp when the service account was archived
  //
  // Null while the account is active. An archived account keeps its
  // record but can no longer be used.
  archivedAt time
  // Tagged identifier of the actor that created the account
  //
  // Prefixed user_ for an organization member or svac_ for another
  // service account, so an account created by another account is
  // visible as such.
  createdByActorId string
  // Tagged identifier of the actor that last updated the account
  //
  // Prefixed user_ or svac_. Null when the account has not been updated
  // since it was created.
  updatedByActorId string
  // Tagged identifier of the actor that archived the account
  //
  // Prefixed user_ or svac_. Null while the account is active.
  archivedByActorId string
}

// Claude workload identity federation issuer
//
// External token issuer the organization trusts to authenticate workloads, so
// that code running outside Claude can obtain credentials without a
// long-lived API key. The issuer is the trust anchor: `issuerUrl` names whose
// tokens are accepted, `maxJwtLifetimeSeconds` caps how long one of those
// tokens stays valid, and `checkJti` reports whether replayed tokens are
// rejected. `archivedAt` separates a retired trust anchor from one still in
// force. The rules deciding what an accepted token may reach are reached
// through `rules`.
claude.organization.federationIssuer @defaults("id name issuerUrl") {
  // Issuer identifier
  id string
  // Issuer display name
  name string
  // URL of the external token issuer
  //
  // A token is accepted only when its iss claim matches this URL, so
  // this names exactly whose identities the organization trusts.
  issuerUrl string
  // Whether the JWT ID is checked so replayed tokens are rejected
  checkJti bool
  // Longest lifetime, in seconds, accepted on a token from this issuer
  //
  // A token presented more than this many seconds after it was issued
  // is rejected regardless of its own expiry claim.
  maxJwtLifetimeSeconds int
  // Timestamp when JWKS polling was switched off
  //
  // Null while polling is active. With polling off, the organization
  // stops picking up the issuer's key rotations.
  jwksPollingDisabledAt time
  // Result of the most recent attempt to fetch the issuer's keys
  //
  // Keys include `status` and the timestamps of the last attempt, so a
  // trust anchor whose key fetch has been failing is visible here.
  pollStatus dict
  // Key material configuration for the issuer
  //
  // Either a discovery URL the organization polls, or keys supplied
  // inline.
  jwks dict
  // Timestamp when the issuer was registered
  createdAt time
  // Timestamp when the issuer was last updated
  updatedAt time
  // Timestamp when the issuer was archived
  //
  // Null while the issuer is trusted. An archived issuer no longer
  // authenticates workloads.
  archivedAt time
  // Tagged identifier of the actor that registered the issuer
  //
  // Prefixed user_ or svac_.
  createdByActorId string
  // Rules that accept tokens from this issuer
  rules() []claude.organization.federationRule
}

// Claude workload identity federation rule
//
// Rule deciding which federated identities from a trusted issuer receive
// access, and what that access reaches. This is where an external workload
// becomes a principal inside the organization, so a rule that matches too
// broadly is a standing grant to anyone who can obtain a matching token. Read
// `matchSubjectPrefix`, `matchAudience`, `matchClaims` and `matchCondition`
// together to see how narrowly the rule matches, and `appliesToAllWorkspaces`
// with `workspaces` to see how far the resulting access reaches.
claude.organization.federationRule @defaults("id name") {
  // Rule identifier
  id string
  // Rule display name
  name string
  // Description recorded on the rule
  description string
  // Issuer whose tokens this rule accepts
  issuer() claude.organization.federationIssuer
  // Whether the rule grants access to every workspace
  //
  // True makes the rule organization-wide, so `workspaces` does not
  // bound it and a new workspace is covered as soon as it is created.
  appliesToAllWorkspaces bool
  // Workspaces the rule grants access to
  //
  // Empty when appliesToAllWorkspaces is true, in which case the rule
  // is not confined to a workspace list.
  workspaces() []claude.organization.workspace
  // Service account a matching identity acts as
  serviceAccount() claude.organization.serviceAccount
  // Audience a token must carry to match
  //
  // Null when the rule does not constrain the aud claim, which widens
  // the rule to tokens minted for any audience.
  matchAudience string
  // Prefix a token's subject must start with to match
  //
  // Null when the rule does not constrain the sub claim. A short or
  // absent prefix matches many more identities than a full subject.
  matchSubjectPrefix string
  // Claims a token must carry, as claim name to required value
  //
  // Empty when the rule matches on no claims beyond the subject and
  // the audience.
  matchClaims map[string]string
  // Additional expression a token must satisfy to match
  //
  // Null when the rule carries no extra condition.
  matchCondition string
  // Attributes recorded on the rule
  attributes map[string]string
  // OAuth scope granted to a matching identity
  oauthScope string
  // Lifetime, in seconds, of the credential issued to a matching identity
  tokenLifetimeSeconds int
  // Timestamp when the rule was created
  createdAt time
  // Timestamp when the rule was last updated
  updatedAt time
  // Timestamp when the rule was archived
  //
  // Null while the rule is in force. An archived rule no longer grants
  // access.
  archivedAt time
  // Tagged identifier of the actor that created the rule
  //
  // Prefixed user_ or svac_.
  createdByActorId string
}

// Claude organization compliance activity
//
// Entry from the Claude compliance activity feed. The activity feed
// captures security-relevant events such as logins, permission changes,
// API key operations, and workspace modifications. Requires either a
// Compliance Access Key or an Admin API key.
claude.organization.activity @defaults("id type actorEmail") {
  // Activity event identifier
  id string
  // Event type
  //
  // For example claude_chat_created, claude_file_uploaded, or
  // organization.user.added.
  type string
  // Actor email address
  actorEmail string
  // Actor identifier
  actorId string
  // Timestamp when the activity was created
  createdAt time
}
