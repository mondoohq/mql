import core

option provider = "go.mondoo.com/mql/providers/mistral"
option go_package = "go.mondoo.com/mql/providers/mistral/resources"
option root = "mistral"

// Mistral AI workspace
//
// Mistral AI workspace covering the available models, fine-tuning jobs,
// uploaded files, batch inference jobs, document libraries, the remote
// servers the models may call, agents, and the webhooks and triggers that
// start work on incoming events, all reachable through a single
// API key. Backs AI security posture assessment and AI Bill of
// Materials generation. API keys are scoped to one workspace, so add
// each workspace as a separate asset to scan an entire organization.
mistral @defaults("ownedBy") @maturity("preview") @root {
  // Workspace identifier passed via --workspace flag
  ownedBy() string
  // Available models in the Mistral AI platform
  models() []mistral.model
  // Fine-tuning jobs
  fineTuningJobs() []mistral.fineTuningJob
  // Uploaded files for fine-tuning, batch, or OCR
  files() []mistral.file
  // Batch inference jobs
  batchJobs() []mistral.batchJob
  // Remote servers the models in this workspace are allowed to call
  connectors() []mistral.connector
  // Document libraries available to this workspace
  libraries() []mistral.library
  // Agents configured in this workspace
  agents() []mistral.agent
  // Webhooks that receive events from third-party services
  webhooks() []mistral.webhook
  // Triggers that start a workflow, agent, or app when a webhook receives an event
  triggers() []mistral.trigger
}

// Mistral AI model
//
// Model available on the Mistral AI platform, covering its capabilities,
// context window size, deprecation status, and ownership. Models are
// either base models owned by Mistral or fine-tuned models created by
// the account. The `family` and `parameterSize` fields are parsed from
// the model identifier to support AI Bill of Materials reporting. Use
// `mistral.models.where(type == "base")` to filter base models or
// `mistral.models.where(capabilityChat == true)` to find chat-capable
// models.
mistral.model @defaults("id type ownedBy maxContextLength") @maturity("preview") {
  // Model identifier (e.g., "mistral-large-latest", "open-mistral-nemo")
  id string
  // Model type
  //
  // One of base or fine-tuned.
  type string
  // Owner of the model (e.g., "mistralai")
  ownedBy string
  // Human-readable model name
  name string
  // Model description
  description string
  // Maximum context window length in tokens
  maxContextLength int
  // Model creation time
  created time
  // Model identifier aliases
  aliases []string
  // Deprecation date if the model is deprecated
  deprecation time
  // Model Mistral recommends moving to before this one is retired
  //
  // Null when Mistral names no successor for the model, so a deprecated model
  // with nowhere to migrate to is
  // `mistral.models.where(deprecation != null && replacementModel == null)`.
  replacementModel() mistral.model
  // Default sampling temperature
  defaultModelTemperature float
  // Whether the model supports chat completions
  capabilityChat bool
  // Whether the model supports function calling
  capabilityFunctionCalling bool
  // Whether the model supports fill-in-the-middle completions
  capabilityFim bool
  // Whether the model can be fine-tuned
  capabilityFineTuning bool
  // Whether the model supports vision (image inputs)
  capabilityVision bool
  // Whether the model supports OCR
  capabilityOcr bool
  // Whether the model supports classification
  capabilityClassification bool
  // Whether the model supports content moderation
  capabilityModeration bool
  // Whether the model supports audio inputs
  capabilityAudio bool
  // Whether the model supports audio transcription
  capabilityAudioTranscription bool
  // Fine-tuning job identifier
  //
  // Deprecated in favor of fineTuningJob.
  job @maturity("deprecated") string
  // Fine-tuning job that produced this model
  //
  // Null for base models, and for a fine-tuned model whose job is no longer
  // listed in the workspace.
  fineTuningJob() mistral.fineTuningJob
  // Identifier of the base model a fine-tuned model was trained from
  //
  // Kept beside baseModel because a fine-tuned model can outlive its base
  // model: once Mistral retires the base model it drops out of the model list,
  // and this identifier is then the only record of the lineage.
  root string
  // Base model a fine-tuned model was trained from
  //
  // Null for base models, and when the base model named in root is not in the
  // workspace model list.
  baseModel() mistral.model
  // Whether this fine-tuned model has been archived
  archived bool
  // Architecture family parsed from the model name (e.g., "Mistral", "Codestral", "Pixtral")
  family() string
  // Parameter count parsed from the model name (e.g., "7B", "8x22B", "123B")
  parameterSize() string
}

// Mistral AI fine-tuning job
//
// Fine-tuning job including its status, base model, output model name,
// training configuration, and cost metadata. Query
// `mistral.fineTuningJobs.where(status == "RUNNING")` to find active
// jobs, or inspect `model`, `trainingData`, and `outputModel` for model
// lineage auditing: the base model, the data that went in, and the model
// that came out.
mistral.fineTuningJob @defaults("id status model") @maturity("preview") {
  // Job identifier
  id string
  // Job status
  //
  // One of QUEUED, STARTED, VALIDATING, VALIDATED, RUNNING,
  // FAILED_VALIDATION, FAILED, SUCCESS, CANCELLED, or
  // CANCELLATION_REQUESTED.
  status string
  // Base model used for fine-tuning
  model string
  // Output model name after fine-tuning completes
  //
  // Deprecated in favor of outputModel.
  fineTunedModel @maturity("deprecated") string
  // Model the job produced
  //
  // Null until the job succeeds, and when the produced model is no longer in
  // the workspace model list.
  outputModel() mistral.model
  // Model name suffix
  suffix string
  // Whether the job starts automatically after creation
  autoStart bool
  // Training file IDs
  //
  // Deprecated in favor of trainingData.
  trainingFiles @maturity("deprecated") []string
  // Validation file IDs
  //
  // Deprecated in favor of validationData.
  validationFiles @maturity("deprecated") []string
  // Files the job trained on
  //
  // Files deleted from the workspace since the job ran are not listed.
  trainingData() []mistral.file
  // Files the job validated against
  //
  // Files deleted from the workspace since the job ran are not listed.
  validationData() []mistral.file
  // Total tokens trained
  trainedTokens int
  // Job creation time
  createdAt time
  // Last modification time
  modifiedAt time
  // Job type
  //
  // One of completion or classifier.
  jobType string
  // Number of training steps
  trainingSteps int
  // Training learning rate
  learningRate float
  // Number of training epochs
  epochs float
  // Expected job duration in seconds
  expectedDurationSeconds int
  // Estimated cost
  cost float
  // Cost currency (e.g., "USD")
  costCurrency string
  // Third-party services the job streams training telemetry to
  integrations []mistral.fineTuningJob.integration
}

// Third-party service receiving fine-tuning telemetry
//
// External service attached to a fine-tuning job, naming the service, the
// project it writes into, and the run it created. Training metrics leave the
// workspace for this service while the job runs, so
// `mistral.fineTuningJobs.all(integrations.length == 0)` asserts that no job
// reports to an outside destination.
mistral.fineTuningJob.integration @defaults("type project runName") @maturity("preview") {
  // Integration type
  //
  // The fine-tuning API accepts wandb, for Weights and Biases.
  type string
  // Project the integration writes into
  project string
  // Integration name
  name string
  // Name of the run the job created in the third-party service
  runName string
  // URL of the run in the third-party service
  url string
}

// Mistral AI file
//
// File uploaded to the account for fine-tuning, batch processing, or
// OCR. The `purpose` field records why the file was uploaded (fine-tune,
// batch, or ocr) and `filename` its original name, so you can audit what
// data has been sent to Mistral and for which workload. The `source`
// field distinguishes user uploads from files generated by Mistral.
mistral.file @defaults("id filename purpose") @maturity("preview") {
  // File identifier
  id string
  // Original filename
  filename string
  // File purpose
  //
  // One of fine-tune, batch, or ocr.
  purpose string
  // File size in bytes
  bytes int
  // Upload time
  createdAt time
  // Sample type
  //
  // One of pretrain, instruct, batch_request, batch_result, or batch_error.
  sampleType string
  // File source
  //
  // One of upload, repository, or mistral.
  source string
  // Number of lines in the file
  numLines int
  // MIME type
  mimeType string
  // Who can access the file
  //
  // One of workspace or user. Null when the API reports none.
  visibility string
  // Time after which Mistral deletes the file
  //
  // Null for a file that does not expire.
  expiresAt time
}

// Mistral AI batch inference job
//
// Batch inference job that runs many requests against a model
// asynchronously, exposing its lifecycle status, target model and
// endpoint, per-request success/failure counts, and the input, output,
// and error file references. Query `mistral.batchJobs.where(status ==
// "RUNNING")` to find active jobs, or audit `model` to see which models
// process batch workloads.
mistral.batchJob @defaults("id status endpoint") @maturity("preview") {
  // Job identifier
  id string
  // Job status
  //
  // One of QUEUED, RUNNING, SUCCESS, FAILED, TIMEOUT_EXCEEDED,
  // CANCELLATION_REQUESTED, or CANCELLED.
  status string
  // Target API endpoint (e.g., "/v1/chat/completions")
  endpoint string
  // Model used for inference
  model string
  // Agent the batch requests ran through
  //
  // Null for a batch that targets a model directly, and when the agent is no
  // longer listed in the workspace.
  agent() mistral.agent
  // Input file IDs
  //
  // Deprecated in favor of inputs.
  inputFiles @maturity("deprecated") []string
  // Output file identifier
  //
  // Deprecated in favor of results.
  outputFile @maturity("deprecated") string
  // Error file identifier
  //
  // Deprecated in favor of errorDetails.
  errorFile @maturity("deprecated") string
  // Files holding the batch requests
  //
  // Files deleted from the workspace since the job ran are not listed.
  inputs() []mistral.file
  // File holding the batch results
  //
  // Null until the job writes results, and when the file is no longer listed.
  results() mistral.file
  // File holding the requests that failed and why
  //
  // Null when the job wrote no error file, and when the file is no longer listed.
  errorDetails() mistral.file
  // Total number of requests in the batch
  totalRequests int
  // Number of completed requests
  completedRequests int
  // Number of succeeded requests
  succeededRequests int
  // Number of failed requests
  failedRequests int
  // Job creation time
  createdAt time
  // Job start time
  startedAt time
  // Job completion time
  completedAt time
  // Distinct errors the job reported
  errors []mistral.batchJob.error
  // Caller-supplied key/value attribution attached to the job
  metadata map[string]string
}

// Error reported by a batch inference job
//
// Distinct error a batch inference job reported, with the number of requests
// it affected. The entries account for `failedRequests` and separate a
// throttled batch from one refused on content or rejected on validation, which
// the failure count alone cannot do.
mistral.batchJob.error @defaults("message count") @maturity("preview") {
  // Error message
  message string
  // Number of requests that hit this error
  count int
}

// Remote server the workspace is allowed to call
//
// Connector registered in the workspace, covering the server it reaches, the
// protocol it speaks, who may call it, and whether its tools run in a private
// execution environment. A connector is an outbound path from the workspace to
// code Mistral does not control, so `server` and `visibility` together answer
// which third-party servers the organization can reach:
// `mistral.connectors.where(visibility == "shared_org")` lists the ones every
// member can call. No authentication material is exposed, only the names of
// the methods a connector accepts.
mistral.connector @defaults("name visibility server") @maturity("preview") {
  // Connector identifier
  id string
  // Connector name
  name string
  // Display title of the connector
  title string
  // Connector description
  description string
  // URL of the server the connector calls
  server string
  // Protocol the connector speaks
  //
  // One of mcp, http, or turbine.
  protocol string
  // Who may call the connector
  //
  // One of private, shared_workspace, shared_org, or shared_global.
  visibility string
  // Kind of entity that owns the connector
  //
  // One of user, workspace, org, or system.
  ownerType string
  // Identifier of the entity that owns the connector
  ownerId string
  // Identifier of the user who created the connector
  creatorId string
  // Whether raw HTTP calls through the connector are allowed
  //
  // False when any connection preference turns raw HTTP calls off, true when at
  // least one allows them and none turns them off, and null when no preference
  // states it, which is always the case for connectors that do not speak http.
  httpProxyEnabled bool
  // Levels at which the connector is blocked
  //
  // Each entry is one of user, workspace, org, or system. Empty when nothing
  // blocks the connector.
  blockedBy []string
  // Authentication methods the connector accepts
  //
  // Method names only, drawn from oauth2, bearer, none, github_app, and
  // slack_app. No credential, token, or header value is reported.
  supportedAuthMethods []string
  // Whether the connector runs its tools in a private execution environment
  privateToolExecution bool
  // Connector creation time
  createdAt time
  // Last modification time
  modifiedAt time
}

// Document library in a Mistral AI workspace
//
// Library of documents uploaded for retrieval, covering its name, document
// count, stored size, and owner. The `accesses` field lists every entity the
// library is shared with and the role each holds, which is who can read the
// corpus. Document contents are not reported. Query
// `mistral.libraries.where(nbDocuments > 0) { name accesses { shareWithType role } }`
// to review sharing on every library that holds documents.
mistral.library @defaults("id name nbDocuments") @maturity("preview") {
  // Library identifier
  id string
  // Library name
  name string
  // Library description
  description string
  // Number of documents stored in the library
  nbDocuments int
  // Total size of the stored documents in bytes
  totalSize int
  // Kind of entity that owns the library
  //
  // Such as User, Workspace, or Org.
  ownerType string
  // Identifier of the entity that owns the library
  ownerId string
  // Library creation time
  createdAt time
  // Last modification time
  updatedAt time
  // Entities the library is shared with
  accesses() []mistral.library.access
}

// Entity granted access to a document library
//
// Single share entry on a library, naming the entity the library is shared
// with and the role it holds. An organization-wide share reports no entity
// identifier, since it names no single entity.
mistral.library.access @defaults("shareWithType role") @maturity("preview") {
  // Kind of entity the library is shared with
  //
  // Such as User, Workspace, or Org.
  shareWithType string
  // Identifier of the entity the library is shared with
  shareWithUuid string
  // Role the entity holds on the library
  //
  // Such as Viewer or Editor.
  role string
}

// Mistral AI agent
//
// Agent configured in the workspace, covering the model it runs on, its
// instructions, the tools it may call and which of them need a human to
// confirm, the document libraries and connectors it reaches, the agents it can
// hand a conversation off to, and whether its guardrails block requests when
// they fail. Query
// `mistral.agents.where(tools.any(type == "connector" && requiresConfirmation.length == 0))`
// to find agents that call remote servers without confirmation.
mistral.agent @defaults("id name modelName") @maturity("preview") {
  // Agent identifier
  id string
  // Agent name
  name string
  // Agent description
  description string
  // Version of the agent configuration reported
  version int
  // Identifier of the model the agent runs on, as configured
  //
  // Kept beside model because the agent can name a model the workspace model
  // list does not carry.
  modelName string
  // Model the agent runs on
  //
  // Null when the model named in modelName is not in the workspace model list.
  model() mistral.model
  // Instruction prompt the agent follows
  instructions string
  // Tools the agent may call
  tools []mistral.agent.tool
  // Document libraries the agent searches
  libraries() []mistral.library
  // Connectors the agent calls
  connectors() []mistral.connector
  // Agents this agent can hand a conversation off to
  handoffs() []mistral.agent
  // Whether the guardrails block a request when they fail
  //
  // True when every configured guardrail blocks on a server-side error, false
  // when any lets the request through, and null when the agent has no
  // guardrails.
  guardrailsBlockOnError bool
  // Agent creation time
  createdAt time
  // Last update time
  updatedAt time
}

// Tool an agent may call
private mistral.agent.tool @defaults("type name") @maturity("preview") {
  // Tool type
  //
  // Such as function, web_search, web_search_premium, code_interpreter,
  // image_generation, document_library, or connector.
  type string
  // Name of the function a function tool calls
  //
  // Null for other tool types.
  name string
  // Connector a connector tool calls
  //
  // Null for other tool types, and when the connector is not listed in the
  // workspace.
  connector() mistral.connector
  // Tool names that need a human to confirm each call
  requiresConfirmation []string
  // Tool names the agent may call, when restricted
  include []string
  // Tool names the agent may not call
  exclude []string
}

// Mistral AI webhook
//
// Endpoint that receives events from a third-party service, covering the
// service, the URL, whether the URL was verified, how incoming events are
// signed and how long a signature stays valid, and when the webhook expires.
// No verification token or signing secret is reported. Query
// `mistral.webhooks.where(signatureHashAlgorithm == null)` to find webhooks
// that accept unsigned events.
mistral.webhook @defaults("name provider urlVerified") @maturity("preview") {
  // Webhook identifier
  id string
  // Webhook name
  name string
  // Service that sends the events
  //
  // One of slack, github, notion, lucca, linear, microsoft, ashby, whatsapp,
  // or custom.
  provider string
  // URL of the webhook
  url string
  // Whether the URL passed the provider's verification
  //
  // Null when the provider does not verify URLs.
  urlVerified bool
  // Hash algorithm incoming event signatures are checked with
  //
  // One of sha256 or sha1. Null when events are not signed.
  signatureHashAlgorithm string
  // Seconds a signed event stays valid after its timestamp
  //
  // Null when no validity period is enforced.
  validityPeriodSeconds int
  // Kind of entity that owns the webhook
  //
  // One of workspace or user.
  ownerType string
  // Time the webhook expires
  //
  // Null for a webhook that does not expire.
  expiresAt time
  // Webhook creation time
  createdAt time
  // Last update time
  updatedAt time
}

// Mistral AI trigger
//
// Rule that starts a workflow, agent, or app when a webhook receives an event,
// covering the webhook it listens on, the event filter, and the action it
// takes. Query `mistral.triggers.where(filters == null) { title eventSource.provider }`
// to find triggers that act on every event their webhook receives.
mistral.trigger @defaults("title handler actionType") @maturity("preview") {
  // Trigger identifier
  id string
  // Trigger title
  title string
  // Webhook the trigger listens on
  eventSource mistral.webhook
  // Kind of target the trigger starts
  //
  // One of workflows, agents, or spaces.
  handler string
  // Action the trigger takes
  //
  // One of start_workflow, build_app, deploy_app, or start_agent_session.
  actionType string
  // Agent the trigger starts a session with
  //
  // Null when the action does not start an agent session, and when the agent
  // is no longer listed.
  agent() mistral.agent
  // Identifier of the workflow or app the action runs
  //
  // Null when the action starts an agent session, which agent reports.
  actionTargetId string
  // Expression selecting which events start the action
  //
  // Null when every event starts it.
  filters string
  // Kind of entity that owns the trigger
  //
  // One of workspace or user.
  ownerType string
}
