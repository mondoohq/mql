import core

option provider = "go.mondoo.com/mql/providers/mistral"
option go_package = "go.mondoo.com/mql/providers/mistral/resources"
option root = "mistral"

// Mistral AI workspace
//
// Mistral AI workspace covering the available models, fine-tuning jobs,
// uploaded files, batch inference jobs, document libraries, and the remote
// servers the models may call, all reachable through a single
// API key. Backs AI security posture assessment and AI Bill of
// Materials generation. API keys are scoped to one workspace, so add
// each workspace as a separate asset to scan an entire organization.
mistral @defaults("ownedBy") @maturity("preview") @root {
  // Workspace identifier passed via --workspace flag
  ownedBy() string
  // Available models in the Mistral AI platform
  models() []mistral.model
  // Fine-tuning jobs
  fineTuningJobs() []mistral.fineTuningJob
  // Uploaded files for fine-tuning, batch, or OCR
  files() []mistral.file
  // Batch inference jobs
  batchJobs() []mistral.batchJob
  // Remote servers the models in this workspace are allowed to call
  connectors() []mistral.connector
  // Document libraries available to this workspace
  libraries() []mistral.library
}

// Mistral AI model
//
// Model available on the Mistral AI platform, covering its capabilities,
// context window size, deprecation status, and ownership. Models are
// either base models owned by Mistral or fine-tuned models created by
// the account. The `family` and `parameterSize` fields are parsed from
// the model identifier to support AI Bill of Materials reporting. Use
// `mistral.models.where(type == "base")` to filter base models or
// `mistral.models.where(capabilityChat == true)` to find chat-capable
// models.
mistral.model @defaults("id type ownedBy maxContextLength") @maturity("preview") {
  // Model identifier (e.g., "mistral-large-latest", "open-mistral-nemo")
  id string
  // Model type
  //
  // One of base or fine-tuned.
  type string
  // Owner of the model (e.g., "mistralai")
  ownedBy string
  // Human-readable model name
  name string
  // Model description
  description string
  // Maximum context window length in tokens
  maxContextLength int
  // Model creation time
  created time
  // Model identifier aliases
  aliases []string
  // Deprecation date if the model is deprecated
  deprecation time
  // Model Mistral recommends moving to before this one is retired
  //
  // Null when Mistral names no successor for the model, so a deprecated model
  // with nowhere to migrate to is
  // `mistral.models.where(deprecation != null && replacementModel == null)`.
  replacementModel() mistral.model
  // Default sampling temperature
  defaultModelTemperature float
  // Whether the model supports chat completions
  capabilityChat bool
  // Whether the model supports function calling
  capabilityFunctionCalling bool
  // Whether the model supports fill-in-the-middle completions
  capabilityFim bool
  // Whether the model can be fine-tuned
  capabilityFineTuning bool
  // Whether the model supports vision (image inputs)
  capabilityVision bool
  // Whether the model supports OCR
  capabilityOcr bool
  // Whether the model supports classification
  capabilityClassification bool
  // Whether the model supports content moderation
  capabilityModeration bool
  // Whether the model supports audio inputs
  capabilityAudio bool
  // Whether the model supports audio transcription
  capabilityAudioTranscription bool
  // Fine-tuning job ID that produced this model (fine-tuned models only)
  job string
  // Root base model ID (fine-tuned models only)
  root string
  // Whether this fine-tuned model has been archived
  archived bool
  // Architecture family parsed from the model name (e.g., "Mistral", "Codestral", "Pixtral")
  family() string
  // Parameter count parsed from the model name (e.g., "7B", "8x22B", "123B")
  parameterSize() string
}

// Mistral AI fine-tuning job
//
// Fine-tuning job including its status, base model, output model name,
// training configuration, and cost metadata. Query
// `mistral.fineTuningJobs.where(status == "RUNNING")` to find active
// jobs, or inspect `model` and `fineTunedModel` for model lineage
// auditing.
mistral.fineTuningJob @defaults("id status model") @maturity("preview") {
  // Job identifier
  id string
  // Job status
  //
  // One of QUEUED, STARTED, VALIDATING, VALIDATED, RUNNING,
  // FAILED_VALIDATION, FAILED, SUCCESS, CANCELLED, or
  // CANCELLATION_REQUESTED.
  status string
  // Base model used for fine-tuning
  model string
  // Output model name after fine-tuning completes
  fineTunedModel string
  // Model name suffix
  suffix string
  // Whether the job starts automatically after creation
  autoStart bool
  // Training file IDs
  trainingFiles []string
  // Validation file IDs
  validationFiles []string
  // Total tokens trained
  trainedTokens int
  // Job creation time
  createdAt time
  // Last modification time
  modifiedAt time
  // Job type
  //
  // One of completion or classifier.
  jobType string
  // Number of training steps
  trainingSteps int
  // Training learning rate
  learningRate float
  // Number of training epochs
  epochs float
  // Expected job duration in seconds
  expectedDurationSeconds int
  // Estimated cost
  cost float
  // Cost currency (e.g., "USD")
  costCurrency string
  // Third-party services the job streams training telemetry to
  integrations []mistral.fineTuningJob.integration
}

// Third-party service receiving fine-tuning telemetry
//
// External service attached to a fine-tuning job, naming the service, the
// project it writes into, and the run it created. Training metrics leave the
// workspace for this service while the job runs, so
// `mistral.fineTuningJobs.all(integrations.length == 0)` asserts that no job
// reports to an outside destination.
mistral.fineTuningJob.integration @defaults("type project runName") @maturity("preview") {
  // Integration type
  //
  // The fine-tuning API accepts wandb, for Weights and Biases.
  type string
  // Project the integration writes into
  project string
  // Integration name
  name string
  // Name of the run the job created in the third-party service
  runName string
  // URL of the run in the third-party service
  url string
}

// Mistral AI file
//
// File uploaded to the account for fine-tuning, batch processing, or
// OCR. The `purpose` field records why the file was uploaded (fine-tune,
// batch, or ocr) and `filename` its original name, so you can audit what
// data has been sent to Mistral and for which workload. The `source`
// field distinguishes user uploads from files generated by Mistral.
mistral.file @defaults("id filename purpose") @maturity("preview") {
  // File identifier
  id string
  // Original filename
  filename string
  // File purpose
  //
  // One of fine-tune, batch, or ocr.
  purpose string
  // File size in bytes
  bytes int
  // Upload time
  createdAt time
  // Sample type
  //
  // One of pretrain, instruct, batch_request, batch_result, or batch_error.
  sampleType string
  // File source
  //
  // One of upload, repository, or mistral.
  source string
  // Number of lines in the file
  numLines int
  // MIME type
  mimeType string
}

// Mistral AI batch inference job
//
// Batch inference job that runs many requests against a model
// asynchronously, exposing its lifecycle status, target model and
// endpoint, per-request success/failure counts, and the input, output,
// and error file references. Query `mistral.batchJobs.where(status ==
// "RUNNING")` to find active jobs, or audit `model` to see which models
// process batch workloads.
mistral.batchJob @defaults("id status endpoint") @maturity("preview") {
  // Job identifier
  id string
  // Job status
  //
  // One of QUEUED, RUNNING, SUCCESS, FAILED, TIMEOUT_EXCEEDED,
  // CANCELLATION_REQUESTED, or CANCELLED.
  status string
  // Target API endpoint (e.g., "/v1/chat/completions")
  endpoint string
  // Model used for inference
  model string
  // Input file IDs
  inputFiles []string
  // Output file identifier
  outputFile string
  // Error file identifier
  errorFile string
  // Total number of requests in the batch
  totalRequests int
  // Number of completed requests
  completedRequests int
  // Number of succeeded requests
  succeededRequests int
  // Number of failed requests
  failedRequests int
  // Job creation time
  createdAt time
  // Job start time
  startedAt time
  // Job completion time
  completedAt time
  // Distinct errors the job reported
  errors []mistral.batchJob.error
  // Caller-supplied key/value attribution attached to the job
  metadata map[string]string
}

// Error reported by a batch inference job
//
// Distinct error a batch inference job reported, with the number of requests
// it affected. The entries account for `failedRequests` and separate a
// throttled batch from one refused on content or rejected on validation, which
// the failure count alone cannot do.
mistral.batchJob.error @defaults("message count") @maturity("preview") {
  // Error message
  message string
  // Number of requests that hit this error
  count int
}

// Remote server the workspace is allowed to call
//
// Connector registered in the workspace, covering the server it reaches, the
// protocol it speaks, who may call it, and whether its tools run in a private
// execution environment. A connector is an outbound path from the workspace to
// code Mistral does not control, so `server` and `visibility` together answer
// which third-party servers the organization can reach:
// `mistral.connectors.where(visibility == "shared_org")` lists the ones every
// member can call. No authentication material is exposed, only the names of
// the methods a connector accepts.
mistral.connector @defaults("name visibility server") @maturity("preview") {
  // Connector identifier
  id string
  // Connector name
  name string
  // Connector description
  description string
  // URL of the server the connector calls
  server string
  // Protocol the connector speaks
  //
  // One of mcp, http, or turbine.
  protocol string
  // Who may call the connector
  //
  // One of private, shared_workspace, shared_org, or shared_global.
  visibility string
  // Kind of entity that owns the connector
  //
  // One of user, workspace, org, or system.
  ownerType string
  // Authentication methods the connector accepts
  //
  // Method names only, drawn from oauth2, bearer, none, github_app, and
  // slack_app. No credential, token, or header value is reported.
  supportedAuthMethods []string
  // Whether the connector runs its tools in a private execution environment
  privateToolExecution bool
  // Connector creation time
  createdAt time
  // Last modification time
  modifiedAt time
}

// Document library in a Mistral AI workspace
//
// Library of documents uploaded for retrieval, covering its name, document
// count, stored size, and owner. The `accesses` field lists every entity the
// library is shared with and the role each holds, which is who can read the
// corpus. Document contents are not reported. Query
// `mistral.libraries.where(nbDocuments > 0) { name accesses { shareWithType role } }`
// to review sharing on every library that holds documents.
mistral.library @defaults("id name nbDocuments") @maturity("preview") {
  // Library identifier
  id string
  // Library name
  name string
  // Library description
  description string
  // Number of documents stored in the library
  nbDocuments int
  // Total size of the stored documents in bytes
  totalSize int
  // Kind of entity that owns the library
  //
  // Such as User, Workspace, or Org.
  ownerType string
  // Identifier of the entity that owns the library
  ownerId string
  // Library creation time
  createdAt time
  // Last modification time
  updatedAt time
  // Entities the library is shared with
  accesses() []mistral.library.access
}

// Entity granted access to a document library
//
// Single share entry on a library, naming the entity the library is shared
// with and the role it holds. An organization-wide share reports no entity
// identifier, since it names no single entity.
mistral.library.access @defaults("shareWithType role") @maturity("preview") {
  // Kind of entity the library is shared with
  //
  // Such as User, Workspace, or Org.
  shareWithType string
  // Identifier of the entity the library is shared with
  shareWithUuid string
  // Role the entity holds on the library
  //
  // Such as Viewer or Editor.
  role string
}
