// ===== Azure DNS Service =====

// Azure DNS service
private azure.subscription.dnsService {
  // Subscription identifier
  subscriptionId string
  // List of public DNS zones
  zones() []azure.subscription.dnsService.zone
  // List of private DNS zones
  privateZones() []azure.subscription.dnsService.privateZone
}

// Azure public DNS zone
//
// Public DNS zone that hosts authoritative records for a domain and
// answers queries from the internet. Reports the assigned authoritative
// name servers, the current record-set count against the
// maxNumberOfRecordSets cap, and the individual recordSets hosted in
// the zone. For internal-only zones resolved from linked virtual
// networks, query azure.subscription.dnsService.privateZone.
azure.subscription.dnsService.zone @defaults("id name") {
  // DNS zone resource ID
  id string
  // DNS zone name
  name string
  // DNS zone location
  location string
  // DNS zone tags
  tags map[string]string
  // Number of record sets in the zone
  numberOfRecordSets int
  // Maximum number of record sets allowed
  maxNumberOfRecordSets int
  // Name servers for the zone
  nameServers []string
  // Record sets in the zone
  recordSets() []azure.subscription.dnsService.zone.recordSet
}

// Azure DNS record set
private azure.subscription.dnsService.zone.recordSet @defaults("id name type") {
  // Record set resource ID
  id string
  // Record set name
  name string
  // Record type (A, AAAA, CNAME, MX, NS, PTR, SOA, SRV, TXT, CAA)
  type string
  // Time-to-live in seconds
  ttl int
  // Fully qualified domain name
  fqdn string
  // Record set properties
  //
  // Deprecated in favor of the per-record-type fields on this resource:
  // aRecords, aaaaRecords, nsRecords, ptrRecords, txtRecords, mxRecords,
  // caaRecords, srvRecords, soaRecord, cnameTarget, targetResourceId,
  // metadata, and provisioningState.
  properties @maturity("deprecated") dict
  // IPv4 addresses of an A record set; empty for every other record type
  aRecords []string
  // IPv6 addresses of an AAAA record set; empty for every other record type
  aaaaRecords []string
  // Name servers of an NS record set; empty for every other record type
  //
  // On a zone's apex NS record set these are the servers the parent zone
  // must delegate to. A record set here that does not match the
  // delegation in the parent zone leaves the subdomain unresolvable or,
  // if the parent still points at a name server that no longer serves the
  // zone, resolvable by whoever now controls it.
  nsRecords []string
  // Target hostnames of a PTR record set; empty for every other record type
  ptrRecords []string
  // Text values of a TXT record set; empty for every other record type
  //
  // DNS splits a text value into 255-byte chunks on the wire; each entry
  // here is one record's chunks joined back into the single value the
  // record carries. SPF, DKIM, DMARC, and domain-ownership verification
  // tokens all live in TXT records, so this is where an overly broad SPF
  // policy or a stale verification token shows up.
  txtRecords []string
  // Mail exchangers of an MX record set; empty for every other record type
  mxRecords []azure.subscription.dnsService.zone.recordSet.mxRecord
  // Certificate authority authorizations of a CAA record set; empty for every other record type
  //
  // CAA records name which certificate authorities may issue for the
  // domain. A zone with no CAA record set lets any public CA issue for it.
  caaRecords []azure.subscription.dnsService.zone.recordSet.caaRecord
  // Service locations of an SRV record set; empty for every other record type
  srvRecords []azure.subscription.dnsService.zone.recordSet.srvRecord
  // Start-of-authority record of an SOA record set; null for every other record type
  soaRecord azure.subscription.dnsService.zone.recordSet.soaRecord
  // User-defined metadata attached to the record set
  metadata map[string]string
  // Record set provisioning state
  provisioningState string
  // Hostname a CNAME record points at
  //
  // Empty for every record type other than CNAME. Normalized to lower
  // case without a trailing dot, so it compares directly against the
  // hostname fields Azure resources report (a web app's defaultHostName,
  // a public IP's fqdn, a Traffic Manager profile's fqdn).
  cnameTarget string
  // Azure service that owns the CNAME target's hostname
  //
  // Derived from the target's DNS suffix: "App Service" for
  // azurewebsites.net, "Storage" for blob.core.windows.net, "Traffic
  // Manager" for trafficmanager.net, "Front Door" for azurefd.net, and so
  // on. Empty when the target is not an Azure-owned hostname.
  //
  // A CNAME pointing at an Azure service hostname that no longer has a
  // resource behind it can be claimed by anyone who creates a resource
  // with that name, which is a subdomain takeover. Compare this against
  // the matching resource list (for example the web apps' defaultHostName
  // values) to find records whose target no longer exists. Note that a
  // target may legitimately live in a subscription this scan cannot see,
  // so an unmatched record is a lead to confirm rather than a conclusion.
  targetAzureService string
  // ARM ID of the Azure resource an alias record set points at
  //
  // Alias record sets track an Azure resource (a public IP, Traffic
  // Manager profile, or Front Door endpoint) instead of a fixed value,
  // and Azure removes the record automatically when that resource goes
  // away. Empty for an ordinary record set. A non-empty value means this
  // record cannot be left dangling.
  targetResourceId string
}

// Mail exchanger in a DNS MX record set
//
// One mail server the domain accepts mail through. `preference` orders
// the servers, lowest first, and `exchange` is the server's hostname.
private azure.subscription.dnsService.zone.recordSet.mxRecord @defaults("preference exchange") {
  // Preference value ordering this exchanger against the others; lower is tried first
  preference int
  // Hostname of the mail server
  exchange string
}

// Certificate authority authorization in a DNS CAA record set
//
// One rule about which certificate authority may issue certificates for
// the domain. `tag` is "issue" (regular certificates), "issuewild"
// (wildcards), or "iodef" (a reporting address), and `value` is the CA's
// domain or the reporting URL. `flags` set to 128 marks the property
// critical, meaning a CA that does not understand the tag must refuse to
// issue.
private azure.subscription.dnsService.zone.recordSet.caaRecord @defaults("tag value flags") {
  // Flags byte; 128 marks the property critical
  flags int
  // Property tag ("issue", "issuewild", or "iodef")
  tag string
  // Property value: the authorized CA's domain, or the reporting URL for an "iodef" tag
  value string
}

// Service location in a DNS SRV record set
//
// One host that serves the record set's service. `priority` and `weight`
// order and load-balance the candidates, and `target` with `port` is
// where clients connect.
private azure.subscription.dnsService.zone.recordSet.srvRecord @defaults("priority weight port target") {
  // Priority of this target; lower is preferred
  priority int
  // Relative weight used to distribute load among targets of equal priority
  weight int
  // Port the service listens on
  port int
  // Hostname of the target
  target string
}

// Start-of-authority record of a DNS zone
//
// The zone's authoritative parameters: the primary name server in `host`,
