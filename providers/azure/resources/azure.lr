// Model in an Azure AI Services account catalog
//
// Single model version the account can serve, selected by `name` and
// `version`. This is the catalog entry a deployment's modelName and
// modelVersion point at, and it is where the model's retirement schedule
// lives: `lifecycleStatus` reports whether the version is generally
// available, deprecating, or already deprecated, `inferenceDeprecationDate`
// the date inference calls against it stop working, and the replacement
// fields the version Azure upgrades to. `isDefaultVersion` marks the version
// a deployment gets when it names no version at all.
private azure.subscription.cognitiveServicesService.account.model @defaults("name version lifecycleStatus inferenceDeprecationDate") {
  // Model name (e.g., "gpt-4o", "text-embedding-3-large")
  name string
  // Model version (e.g., "2024-11-20")
  version string
  // Model family format (e.g., "OpenAI")
  format string
  // Model publisher; empty for first-party Azure OpenAI models
  publisher string
  // Whether this is the version a deployment serves when it names no version
  isDefaultVersion bool
  // Lifecycle status of the version
  //
  // One of "GenerallyAvailable", "Deprecating" (a retirement date is set),
  // "Deprecated", "Legacy", "Preview", or "Stable".
  lifecycleStatus string
  // Date inference requests against this version stop being served
  //
  // Null when no inference retirement date is published. A deployment pinned
  // to this version with versionUpgradeOption "NoAutoUpgrade" stops working on
  // this date rather than moving to the replacement.
  inferenceDeprecationDate time
  // Date fine-tuning on this version stops being accepted
  fineTuneDeprecationDate time
  // How firm the published retirement date is
  //
  // One of "Planned" or "Tentative". Empty when no retirement is scheduled.
  deprecationStatus string
  // Name of the model version Azure upgrades this version to
  replacementModelName string
  // Version Azure upgrades this version to
  replacementModelVersion string
  // Date Azure begins auto-upgrading deployments of this version
  replacementAutoUpgradeStartDate time
  // Days before expiry that Azure upgrades a deployment set to upgrade on expiry
  replacementUpgradeOnExpiryLeadTimeDays int
  // Maximum capacity a single deployment of this version may provision
  maxCapacity int
  // Identifier of the model in the Azure AI model catalog
  catalogAssetId string
  // Advertised model capabilities, keyed by capability name
  capabilities map[string]string
  // Capabilities available when fine-tuning the model
  finetuneCapabilities map[string]string
  // Deployment SKUs the version can be served on
  //
  // Each entry carries the SKU `name`, its `usageName`, the `capacity`
  // configuration (minimum, maximum, step, and default), the `rateLimits`
  // enforced on it, and a `deprecationDate` when that SKU is retiring
  // independently of the model.
  skus []dict
}

