  //
  // Empty when the workspace saves artifacts to its live service
  // instead of a Git repository.
  gitRepositoryType string
  // Account or organization hosting the workspace's Git repository
  gitAccountName string
  // Name of the workspace's Git repository
  gitRepositoryName string
  // Branch the workspace collaborates on
  gitCollaborationBranch string
  // Resource ID of the Microsoft Purview account the workspace reports to
