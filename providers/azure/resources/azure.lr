  // SMS receivers
  //
  // Each entry has keys `name`, `countryCode`, `phoneNumber`, and `status`.
  smsReceivers []dict
  // Voice-call receivers
  //
  // Each entry has keys `name`, `countryCode`, and `phoneNumber`.
  voiceReceivers []dict
  // Webhook receivers
  //
  // Each entry has keys `name`, `serviceUri`, `useCommonAlertSchema`, and the Entra auth settings when secured.
  webhookReceivers []dict
  // Entra role receivers (notify all principals holding a role at the scope)
  //
