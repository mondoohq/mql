// Azure Virtual Network Manager
//
// A management scope that applies security admin rules and connectivity
// configurations across many virtual networks at once. Its security admin
// rules take precedence over network security group rules, so this is where a
// tenant's enforced network posture is defined. Surfaces the manager's scope
// (subscriptions and management groups), the configuration types it is allowed
// to apply, the network groups it targets, and its security-admin and
// connectivity configurations. Select by the manager's Azure resource ID.
azure.subscription.networkService.networkManager @defaults("id name location") {
  // Network manager ID
  id string
  // Network manager name
  name string
  // Network manager location
  location string
  // Network manager tags
  tags map[string]string
  // Network manager resource type
  type string
  // Network manager etag
  etag string
  // Provisioning state of the manager
  provisioningState string
  // Description of the manager
  description string
  // Resource GUID of the manager
  resourceGuid string
  // Configuration types the manager may apply (SecurityAdmin, Connectivity, Routing, SecurityUser)
  scopeAccesses []string
  // Subscriptions in the manager's scope
  scopeSubscriptions []string
  // Management groups in the manager's scope
  scopeManagementGroups []string
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
  // Network groups defined in the manager
  networkGroups() []azure.subscription.networkService.networkManager.networkGroup
  // Security admin configurations defined in the manager
  securityAdminConfigurations() []azure.subscription.networkService.networkManager.securityAdminConfiguration
  // Connectivity configurations defined in the manager
  connectivityConfigurations() []azure.subscription.networkService.networkManager.connectivityConfiguration
}

// Network manager network group
//
// A named collection of virtual networks or subnets that network manager
// configurations target as a unit. Surfaces the group's member type and
// description. Select by the group's Azure resource ID.
private azure.subscription.networkService.networkManager.networkGroup @defaults("id name memberType") {
  // Network group ID
  id string
  // Network group name
  name string
  // Network group resource type
  type string
  // Network group etag
  etag string
  // Provisioning state of the group
  provisioningState string
  // Description of the group
  description string
  // Type of member the group contains (VirtualNetwork, Subnet)
  memberType string
  // Resource GUID of the group
  resourceGuid string
  // Statically-defined members of the group
  staticMembers() []azure.subscription.networkService.networkManager.networkGroup.staticMember
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Network manager network group static member
//
// A resource explicitly added to a network group, as opposed to one
// matched by an Azure Policy membership rule. Names the member resource
// (a virtual network, or a subnet when the group's member type is
// Subnet) and the region it lives in. Static membership determines
// which virtual networks a manager's connectivity and security admin
// configurations actually apply to. Select by the member's Azure
// resource ID.
private azure.subscription.networkService.networkManager.networkGroup.staticMember @defaults("name region") {
  // Static member resource ID
  id string
  // Static member name
  name string
  // ARM resource ID of the member resource (a virtual network or a subnet)
  resourceId string
  // Region the member resource lives in
  region string
  // The member virtual network, when the group's member type is VirtualNetwork
  virtualNetwork() azure.subscription.networkService.virtualNetwork
}

// Network manager security admin configuration
//
// A configuration that groups the security admin rule collections a network
// manager enforces. Its rules override network security group rules on the
// virtual networks in the targeted network groups. Surfaces the intent-policy
// services the configuration applies on and its rule collections. Select by
// the configuration's Azure resource ID.
private azure.subscription.networkService.networkManager.securityAdminConfiguration @defaults("id name") {
  // Security admin configuration ID
  id string
  // Security admin configuration name
  name string
  // Security admin configuration resource type
