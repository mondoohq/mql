// Inbound network rule set of a managed HSM pool
//
// The rules that decide which callers reach the pool over the network, and
// the default action applied when none of them matches. A pool whose default
// action is Allow is reachable from every address its publicNetworkAccess
// permits, whatever the rules say.
private azure.subscription.keyVaultService.managedHsm.networkRuleSet @defaults("defaultAction bypass") {
  // Whether trusted Azure services can bypass the network rules ("AzureServices" or "None")
  bypass string
  // Action applied when no IP, virtual-network, or service-tag rule matches ("Allow" or "Deny")
  //
  // Evaluated after bypass. Allow leaves the pool open to every caller
  // publicNetworkAccess admits, which makes the rule list decorative.
  defaultAction string
  // Allowed IPv4 address ranges, in CIDR notation
  ipRules []string
  // Resource IDs of the virtual network subnets allowed to reach the pool
  virtualNetworkSubnetIds []string
  // Names of the Azure service tags allowed to reach the pool
  serviceTags []string
}

