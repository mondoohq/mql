}

// Azure Service Fabric cluster
//
// Cluster resource that hosts Service Fabric applications on a virtual
// machine scale set. The management endpoint, its transport, and the
// authentication settings together decide who can administer the
// cluster: azureActiveDirectory carries the Entra ID tenant and
// application registrations when the cluster is behind Entra, while
// clientCertificateThumbprints and clientCertificateCommonNames list
// the certificates allowed to manage it and mark which of them hold
// admin rights. A cluster with no Entra configuration and only client
// certificates is a materially different posture from one behind
// Entra, and both lists are empty on a cluster that is not secured at
// all. certificate and certificateCommonNames carry the server
// certificate protecting node to node traffic and the management
// endpoint, reverseProxyCertificate the one fronting the reverse
// proxy. clusterCodeVersion, upgradeMode, upgradeWave and
// waveUpgradePaused show whether the runtime still receives patches,
// nodeTypes exposes the published management and application ports
// per scale set, and fabricSettings carries the cluster configuration
// sections.
azure.subscription.serviceFabricService.cluster @defaults("id name location clusterState") {
  // Cluster resource ID
  id string
  // Cluster name
  name string
  // Cluster location
  location string
  // Cluster resource type
  type string
  // Cluster tags
  tags map[string]string
  // Azure resource etag
  etag string
  // Service generated unique identifier for the cluster resource
  clusterId string
  // HTTP management endpoint of the cluster
  //
  // The address clients and the Service Fabric Explorer connect to,
  // for example "https://mycluster.westus2.cloudapp.azure.com:19080".
  managementEndpoint string
  // Whether the management endpoint uses HTTPS
  //
  // True when managementEndpoint is an https:// URL. A cluster that
  // publishes its management endpoint over plain HTTP carries the
  // administrative API in the clear.
  managementEndpointHttps bool
  // Azure Resource Provider endpoint a system service in the cluster connects to
  clusterEndpoint string
  // Current state of the cluster
  //
  // One of WaitingForNodes, Deploying, BaselineUpgrade,
  // UpdatingUserConfiguration, UpdatingUserCertificate,
  // UpdatingInfrastructure, EnforcingClusterVersion,
  // UpgradeServiceUnreachable, AutoScale, or Ready.
  clusterState string
  // Provisioning state of the cluster resource
  //
  // One of Updating, Succeeded, Failed, or Canceled.
  provisioningState string
  // Service Fabric runtime version the cluster runs
  clusterCodeVersion string
  // Upgrade mode of the cluster when a new runtime version is available
  //
  // One of Automatic or Manual. A cluster on Manual stays on
  // clusterCodeVersion until an operator upgrades it.
  upgradeMode string
  // When new runtime version upgrades are applied after release
  //
  // One of Wave0, Wave1, or Wave2. Only applies when upgradeMode is
  // Automatic.
  upgradeWave string
  // Whether automatic runtime version upgrades are paused
  waveUpgradePaused bool
  // Start of the window during which automatic runtime upgrades are paused, in UTC
  upgradePauseStartTimestampUtc time
  // End of the window during which automatic runtime upgrades are paused, in UTC
  upgradePauseEndTimestampUtc time
  // Reliability level setting the replica set size of system services
  //
  // One of None (1 replica), Bronze (3), Silver (5), Gold (7), or
  // Platinum (9). None and Bronze are intended for test clusters
  // only.
  reliabilityLevel string
  // VM image the scale set is configured with
  vmImage string
  // Add-on features enabled in the cluster
  //
  // Any of BackupRestoreService, DnsService, RepairManager, or
  // ResourceMonitorService.
  addOnFeatures []string
  // Whether the event store service is enabled
  eventStoreServiceEnabled bool
  // Whether the infrastructure service manager is enabled
  infrastructureServiceManager bool
  // Logical grouping of VMs into upgrade domains across availability zones
  //
  // One of Parallel or Hierarchical.
  sfZonalUpgradeMode string
  // Upgrade mode for the virtual machine scale set across availability zones
  //
  // One of Parallel or Hierarchical.
  vmssZonalUpgradeMode string
  // Entra ID authentication settings of the cluster
  //
  // Null on a cluster that does not authenticate administrators
  // against Entra ID, which leaves client certificates as the only
  // way to authorize management access.
  azureActiveDirectory azure.subscription.serviceFabricService.cluster.azureActiveDirectory
  // Server certificate securing node to node traffic and the management endpoint
  //
  // Null on a cluster secured by certificate common name instead of
