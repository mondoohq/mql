  // the source, expanded by Azure. Reading these rather than the tag name is
  // what shows the actual reach of a rule written against Internet or
  // AzureCloud.
  expandedSourceAddressPrefix []string
  // Concrete destination ranges the rule resolves to
  expandedDestinationAddressPrefix []string
  // Network security group in the effective chain that contributed the rule
  networkSecurityGroup() azure.subscription.networkService.securityGroup
}

// Route applied to a network interface after route merging
//
// One route from the table the interface actually uses, merging the system
// routes Azure creates, the user-defined routes from the subnet's route table,
// and any routes learned over BGP. `source` says which of those it came from
// and `state` whether it is active, since an invalid route is present but not
// in use. `nextHopType` is what decides where traffic leaves: a default route
// whose next hop is Internet leaves directly, while VirtualAppliance or
// VirtualNetworkGateway sends it through an inspection or tunnel path.
private azure.subscription.networkService.interface.effectiveRoute @defaults("name addressPrefix nextHopType state") {
  // Route name, empty for the system routes Azure supplies
  name string
  // Where the route came from: Default, User, VirtualNetworkGateway, or Unknown
  source string
  // Whether the route is in use: Active or Invalid
  state string
  // Destination ranges the route covers
  addressPrefix []string
  // Where matching traffic is sent
  //
  // One of VirtualNetworkGateway, VnetLocal, Internet, VirtualAppliance,
  // VirtualApplianceEcmp, or None. A route to None discards the traffic.
  // VirtualApplianceEcmp carries several next hop addresses that share the
  // traffic, so a filter looking only for VirtualAppliance misses it.
  nextHopType string
  // Next hop addresses, set only when nextHopType is VirtualAppliance or VirtualApplianceEcmp
  nextHopIpAddress []string
  // Whether BGP route propagation is disabled on the route's table
  disableBgpRoutePropagation bool
}

