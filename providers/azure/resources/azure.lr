  // Health state of the file system ("Available", "Degraded", "Maintenance", "Transitioning", "Unavailable", or "Expanding")
  healthState string
  // Machine-readable code behind the health state
  healthStatusCode string
  // Description behind the health state
  healthStatusDescription string
  // URL of the Key Vault key encrypting the file system
  //
  // Empty when the file system is encrypted with the platform key rather
