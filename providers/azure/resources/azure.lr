  hasSecretVolume bool
  // Diagnostics: log analytics workspace ID linked to this group, if any
  logAnalyticsWorkspaceId string
  // CMK encryption properties (vaultBaseUrl, keyName, keyVersion, identity)
  encryption dict
  // Priority ("Regular" or "Spot")
  priority string
  // Availability zones the group is pinned to
  zones []string
  // Containers in the group
  containers() []azure.subscription.containerInstanceService.containerGroup.container
  // Init containers
  initContainers() []azure.subscription.containerInstanceService.containerGroup.container
}

// Single container inside a container group
private azure.subscription.containerInstanceService.containerGroup.container @defaults("name image imagePinned") {
  // Composite id: <containerGroupId>/containers/<name>
  id string
  // Container name (within the group)
  name string
  // Image reference
  image string
  // Whether the image reference is digest-pinned (contains "@sha256:")
  imagePinned bool
  // Container start command
  command []string
  // Environment variables
  //
  // One entry per variable, with keys `name` and `value`. A variable declared
  // as a secure value reports its name with no value, since the value is a
  // credential and is deliberately not published.
  env []dict
  // CPU cores requested
  cpuCores float
  // Memory in GB requested
  memoryGB float
  // GPU count (zero when no GPU)
  gpuCount int
  // GPU SKU ("K80", "P100", "V100"), or null
  gpuSku string
  // Ports exposed by this container — each entry has {port, protocol}
  ports []dict
  // Volume mounts (volumeName, mountPath, readOnly)
  volumeMounts []dict
  // Liveness probe
  //
  // Keys: exec, httpGet, initialDelaySeconds, periodSeconds,
  // failureThreshold, successThreshold, and timeoutSeconds.
  livenessProbe dict
  // Readiness probe
  //
  // Keys: exec, httpGet, initialDelaySeconds, periodSeconds,
  // failureThreshold, successThreshold, and timeoutSeconds.
  readinessProbe dict
  // Whether the container runs in privileged mode (full host access)
  privileged bool
  // Whether a process can gain more privileges than its parent
  allowPrivilegeEscalation bool
  // UID the container process runs as; null when not pinned (may default to root, UID 0)
  runAsUser int
  // GID the container process runs as; null when not pinned
  runAsGroup int
  // Seccomp profile applied to the container, or null when none is set
  seccompProfile string
  // Linux capabilities added to the container beyond the default set
  addedCapabilities []string
  // Linux capabilities dropped from the container's default set
  droppedCapabilities []string
  // Current state (state, startTime, exitCode, finishTime, detailStatus)
  currentState dict
  // Restart count
  restartCount int
}

// Azure Logic Apps
//
// Consumption-tier Logic Apps workflows in the subscription, enumerated
// through `workflows`. Auditing these surfaces workflow state,
// access-control policies, secret-typed parameters, and the trigger and
// action set defined in each workflow's JSON definition.
private azure.subscription.logicService {
  // Subscription identifier
  subscriptionId string
  // Consumption-tier workflows
  workflows() []azure.subscription.logicService.workflow
}

// Azure Logic Apps Consumption workflow
//
// Single Consumption-tier Logic App, selectable by ARM id (for example
// `azure.subscription.logicService.workflow(id: "/subscriptions/.../workflows/my-flow")`).
// Fields cover lifecycle state, SKU, integration-account binding,
// access-control policies (per-policy IP allow lists and OAuth
// authentication policies), parameters (with secure-string detection),
// and the trigger and action lists parsed from the workflow definition.
azure.subscription.logicService.workflow @defaults("name location state provisioningState") {
  // ARM resource ID
  id string
  // Workflow name
  name string
  // Azure region
  location string
  // Resource tags
  tags map[string]string
  // Workflow state ("Enabled", "Disabled", "Suspended", "Completed", "Deleted", "NotSpecified")
  state string
  // Provisioning state ("Succeeded", "Failed", "Canceled", ...)
  provisioningState string
  // SKU name ("Free", "Shared", "Basic", "Standard", "Premium", "NotSpecified")
  skuName string
  // Workflow version (changes when the definition changes)
  version string
  // Public access endpoint, when ingress is exposed
  accessEndpoint string
  // Managed identity
  //
  // Deprecated in favor of resourceIdentity, which carries the managed
  // identity members as typed fields.
  identity @maturity("deprecated") @replaced_by("azure.subscription.logicService.workflow.resourceIdentity") dict
  // Managed identity attached to the resource
  resourceIdentity azure.subscription.resourceIdentity
  // ARM id of the linked integration account, if any
  integrationAccountId string
  // ARM id of the linked integration service environment (ISE), if any
  integrationServiceEnvironmentId string
  // Created time
  createdTime time
  // Last changed time
  changedTime time
  // Connector and workflow endpoint IP ranges
  //
  // Has `connector` and `workflow`, each with `accessEndpointIpAddresses` and
  // `outgoingIpAddresses` (lists of `{address}` entries). Use these to build
  // network allow lists for traffic the workflow originates or receives.
  endpointsConfiguration dict
  // Access-control policy for inbound triggers
  //
  // Has `allowedCallerIpAddresses []` and `openAuthenticationPolicies {}`. Empty IP list means no IP restriction.
  accessControlTriggers dict
  // Access-control policy for reading workflow run contents
  //
  // Same shape as `accessControlTriggers`: `allowedCallerIpAddresses []` and
  // `openAuthenticationPolicies {}`. Empty IP list means no IP restriction.
  accessControlContents dict
  // Access-control policy for invoking workflow actions
  //
  // Same shape as `accessControlTriggers`: `allowedCallerIpAddresses []` and
  // `openAuthenticationPolicies {}`. Empty IP list means no IP restriction.
  accessControlActions dict
  // Access-control policy for workflow management operations
  //
  // Same shape as `accessControlTriggers`: `allowedCallerIpAddresses []` and
  // `openAuthenticationPolicies {}`. Empty IP list means no IP restriction.
  accessControlWorkflowManagement dict
  // Whether at least one access-control policy has an IP allow list configured
  hasIpRestrictions bool
  // Workflow parameters
  //
  // Each entry has {name, type, hasDefaultValue, isSecure}.
  // `isSecure` is true when type is `SecureString` or `SecureObject`.
  parameters []dict
  // Names of parameters whose type is `SecureString` or `SecureObject`
  secureParameterNames []string
  // Triggers parsed from the workflow definition
  //
  // Each entry has {name, type, kind?}.
  // `type` examples: "Request" (HTTP), "Recurrence", "ApiConnection", "ApiConnectionWebhook".
  triggers []dict
  // Actions parsed from the workflow definition
  //
  // Each entry has {name, type}.
  // `type` examples: "Http", "ApiConnection", "Compose", "Workflow", "If", "Foreach", "Until".
  actions []dict
  // Names of API connections referenced by triggers and actions (i.e., `parameters.$connections` keys)
  connectionNames []string
}

// ===== Azure API Management Service =====

// Azure API Management
//
// API Management gateway instances configured in the subscription.
// Each entry in `services` is a multi-tenant API gateway that fronts
// backend APIs, exposing its SKU, virtual-network integration mode,
// public network access posture, gateway TLS and cipher policy,
// managed identity, endpoint URLs, and private endpoint connection
// state.
private azure.subscription.apiManagementService {
  // Subscription identifier
  subscriptionId string
  // API Management service instances
  services() []azure.subscription.apiManagementService.service
}

// Azure API Management service instance
//
// Multi-tenant API gateway that fronts backend APIs with authentication,
// rate limiting, request and response transforms, and a developer portal.
// The service's network and transport posture is queryable here: the
// virtual-network integration mode (None, External, or Internal), public
// network access state, and the gateway TLS and cipher policy encoded in
// `customProperties` and surfaced as the `tls10Enabled`, `ssl30Enabled`,
// and `tripleDesEnabled` booleans. Also exposes whether client
// certificates are required, the managed identity, and the private
// endpoint connections that reach the service.
azure.subscription.apiManagementService.service @defaults("name location skuName provisioningState") {
  // Resource ID of the API Management service
  id string
  // Service name
  name string
  // Resource location
  location string
  // Resource tags
  tags map[string]string
  // SKU name ("Developer", "Basic", "Standard", "Premium", "Consumption", "BasicV2", "StandardV2", "PremiumV2", "Isolated")
  skuName string
  // Number of deployed units of the SKU
  skuCapacity int
  // Provisioning state ("Created", "Activating", "Succeeded", "Updating", "Failed", "Stopped", "Terminating", "TerminationFailed", "Deleted")
  provisioningState string
  // Target provisioning state for any in-flight long-running operation (empty when none)
  targetProvisioningState string
  // Publisher email address used as the From address for notifications
  publisherEmail string
  // Publisher display name
  publisherName string
  // Notification sender email address
  notificationSenderEmail string
  // Gateway URL clients use to call APIs hosted on the service
  gatewayUrl string
  // Gateway URL in the default region (set on multi-region deployments)
  gatewayRegionalUrl string
  // Management API endpoint URL
  managementApiUrl string
  // Publisher portal endpoint URL (legacy portal)
  portalUrl string
  // Developer portal endpoint URL
  developerPortalUrl string
  // SCM (source-control management) endpoint URL
  scmUrl string
  // Virtual network integration mode ("None", "External", or "Internal")
  virtualNetworkType string
  // Public network access ("Enabled" or "Disabled")
  publicNetworkAccess string
  // NAT gateway state ("Enabled" or "Disabled")
  natGatewayState string
  // Whether the gateway is disabled in the master region (multi-region deployments only)
  disableGateway bool
  // Whether clients are required to present a TLS certificate on every request (Consumption SKU only)
  enableClientCertificate bool
  // Developer portal status ("Enabled" or "Disabled")
  developerPortalStatus string
  // Legacy portal status ("Enabled" or "Disabled")
  legacyPortalStatus string
  // Compute platform version running the service (e.g. "stv2", "stv1", "mtv1")
  platformVersion string
  // Custom properties controlling gateway TLS protocol / cipher policy
  //
  // Keys like `Microsoft.WindowsAzure.ApiManagement.Gateway.Security.Protocols.Tls10` map to "True"/"False" string values.
  customProperties map[string]string
  // Whether TLS 1.0 is enabled for client connections to the gateway (null when the service does not report the setting)
  tls10Enabled bool
  // Whether TLS 1.1 is enabled for client connections to the gateway (null when the service does not report the setting)
  tls11Enabled bool
  // Whether SSL 3.0 is enabled for client connections to the gateway (null when the service does not report the setting)
  ssl30Enabled bool
  // Whether TLS 1.0 is enabled for gateway connections to backend services (null when the service does not report the setting)
  backendTls10Enabled bool
  // Whether TLS 1.1 is enabled for gateway connections to backend services (null when the service does not report the setting)
  backendTls11Enabled bool
  // Whether SSL 3.0 is enabled for gateway connections to backend services (null when the service does not report the setting)
  backendSsl30Enabled bool
  // Whether the 3DES (TLS_RSA_WITH_3DES_EDE_CBC_SHA) cipher is enabled on the gateway (null when the service does not report the setting)
  tripleDesEnabled bool
  // Whether HTTP/2 is enabled on the gateway (null when the service does not report the setting)
  http2Enabled bool
  // Identity type ("None", "SystemAssigned", "UserAssigned", "SystemAssigned, UserAssigned")
  identityType string
  // Principal ID of the system-assigned managed identity
  principalId string
  // Tenant ID of the system-assigned managed identity
  tenantId string
  // System-assigned managed identity of the service; null when no system-assigned identity is enabled
  //
  // Resolves the system-assigned identity so its role assignments, and their
  // role definitions and permissions, can be traversed, completing the
  // resource-to-privilege leg of an attack path.
  systemAssignedIdentity() azure.subscription.managedIdentity
  // User-assigned managed identities associated with the service
  userAssignedIdentities() []azure.subscription.managedIdentity
  // Public load-balanced IPv4 addresses of the service in its primary region (Basic / Standard / Premium / Isolated SKUs)
  publicIpAddresses []string
  // Private load-balanced IPv4 addresses of the service in its primary region when deployed in an Internal VNet
  privateIpAddresses []string
  // Outbound public IPv4 prefixes associated with NAT Gateway-deployed services (Premium SKU on stv2)
  outboundPublicIpAddresses []string
  // Private endpoint connections to the service
  privateEndpointConnections() []azure.subscription.privateEndpointConnection
  // Availability zones the service is spread across
  zones []string
  // Public IP address attached to the service (null when not configured)
  publicIpAddress() azure.subscription.networkService.ipAddress
  // Service creation time
  createdAt time
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
  // APIs published through the gateway
  apis() []azure.subscription.apiManagementService.service.api
  // Products that group APIs for subscription
  products() []azure.subscription.apiManagementService.service.product
  // Named values available to policy expressions
  namedValues() []azure.subscription.apiManagementService.service.namedValue
  // Subscriptions issuing keys against the gateway
  subscriptions() []azure.subscription.apiManagementService.service.subscription
  // Policy applied to every API on the gateway, as raw XML
  //
  // The global policy is the outermost scope in the policy chain, so
  // inbound authentication placed here covers every API. Empty when no
  // global policy is set, which means each API is responsible for its own
  // authentication.
  policyXml() string
}

// API published through an API Management gateway
//
// A single API exposed by the gateway, selected by `name` (the API's
// identifier, not its display name). The `subscriptionRequired` field
// says whether a caller needs a subscription key at all, and `policyXml`
// carries the policy that runs for this API, which is where token
// validation is enforced. An API with no subscription requirement and no
// validating policy is anonymously callable.
private azure.subscription.apiManagementService.service.api @defaults("name displayName path protocols") {
  // Full resource ID of the API
  id string
  // API identifier used in resource paths
  name string
  // Display name
  displayName string
  // API description
  description string
  // URL suffix the API is served under, relative to the gateway URL
  path string
  // Protocols the API accepts
  //
  // Each entry is "http", "https", "ws", or "wss". A list including
  // "http" or "ws" serves the API without transport encryption.
  protocols []string
  // Backend URL the gateway forwards requests to
  serviceUrl string
  // Whether callers must present a subscription key
  //
  // False makes the API callable without a key. That is only safe when
  // the policy enforces another form of authentication, so read this
  // together with policyXml.
  subscriptionRequired bool
  // Name of the header carrying the subscription key
  subscriptionKeyHeaderName string
  // Name of the query parameter carrying the subscription key
  //
  // A key accepted in the query string is written to logs and browser
  // history far more readily than one in a header.
  subscriptionKeyQueryParamName string
  // API type (for example "http", "soap", "websocket", "graphql", or "grpc")
  apiType string
  // API revision
  apiRevision string
  // API version
  apiVersion string
