  // Whether matching clients get read-write access under Kerberos krb5i
  kerberos5iReadWrite bool
  // Whether matching clients get read-only access under Kerberos krb5p
  kerberos5pReadOnly bool
  // Whether matching clients get read-write access under Kerberos krb5p
  kerberos5pReadWrite bool
}

