  // Only one node type in a cluster is primary.
  isPrimary bool
  // Whether the node type can only host stateless workloads
  isStateless bool
  // Number of VM instances backing this node type
  vmInstanceCount int
  // TCP cluster management endpoint port
  clientConnectionEndpointPort int
  // HTTP cluster management endpoint port
  httpGatewayEndpointPort int
  // Port used by the reverse proxy
  //
  // Null when the node type does not run a reverse proxy.
  reverseProxyEndpointPort int
  // Lowest port assigned to Service Fabric applications
  applicationStartPort int
  // Highest port assigned to Service Fabric applications
  applicationEndPort int
  // Lowest ephemeral port configured on nodes of this type
  ephemeralStartPort int
  // Highest ephemeral port configured on nodes of this type
  ephemeralEndPort int
  // Durability level of the node type
  //
  // One of Bronze, Silver, or Gold. Bronze gives Service Fabric no
  // privileges to delay infrastructure jobs.
  durabilityLevel string
  // Whether the node type supports multiple availability zones
  multipleAvailabilityZones bool
  // Capacity tags the cluster resource manager uses to place services
  capacities map[string]string
  // Placement tags marking where particular workloads should run
  placementProperties map[string]string
}

// Configuration section of a Service Fabric cluster
//
// One named section of the cluster configuration, with its parameters
// as a name to value map. Sections such as Security, Diagnostics and
// ApplicationGateway/Http carry the settings that govern
// authentication, auditing and the reverse proxy, so
// fabricSettings.where(name == "Security") reaches the cluster
// security configuration.
private azure.subscription.serviceFabricService.cluster.fabricSetting @defaults("name") {
  // Name of the configuration section
  name string
  // Parameters in the section, keyed by parameter name
  parameters map[string]string
}

// Diagnostics storage configuration of a Service Fabric cluster
//
// Storage account Service Fabric writes cluster diagnostic logs to.
// storageAccount resolves the account itself when it is in the same
// subscription, which is how the retention and access settings
// protecting the logs are reached. protectedAccountKeyName names
// which of the account keys the cluster authenticates with, and the
// key value itself is never returned by Azure Resource Manager.
private azure.subscription.serviceFabricService.cluster.diagnosticsStorageAccountConfig @defaults("storageAccountName blobEndpoint") {
  // Name of the storage account collecting diagnostic logs
  storageAccountName string
  // Blob endpoint of the storage account
  blobEndpoint string
  // Queue endpoint of the storage account
  queueEndpoint string
  // Table endpoint of the storage account
  tableEndpoint string
  // Name of the storage account key the cluster authenticates with
  //
  // Names which key is used, for example StorageAccountKey1. The key
  // value is not returned by Azure Resource Manager.
  protectedAccountKeyName string
  // Name of the fallback storage account key used while a key is rotated
  protectedAccountKeyName2 string
  // Storage account collecting the diagnostic logs
  //
  // Null when the account is not in the subscription being scanned.
  storageAccount() azure.subscription.storageService.account
}
