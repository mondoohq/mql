  armRoleReceivers []dict
  // Azure Function receivers
  //
  // Each entry has keys `name`, `functionAppResourceId`, `functionName`, `httpTriggerUrl`, and `useCommonAlertSchema`.
  azureFunctionReceivers []dict
  // Logic Apps receivers
  //
  // Each entry has keys `name`, `resourceId`, `callbackUrl`, and `useCommonAlertSchema`.
  logicAppReceivers []dict
  // Automation runbook receivers
  //
  // Each entry has keys `automationAccountId`, `runbookName`, `webhookResourceId`, `isGlobalRunbook`, `name`, and `useCommonAlertSchema`.
  automationRunbookReceivers []dict
