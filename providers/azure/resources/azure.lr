// Microsoft Defender for Cloud continuous export rule
//
// One security automation, which is what the portal calls a continuous
// export. It listens for a class of events, filters them, and forwards what
// matches to a destination such as an Event Hub or a Log Analytics
// workspace. `isEnabled` reports whether the rule is actually running, which
// is separate from whether it exists.

private azure.subscription.cloudDefenderService.securityAutomation @defaults("name isEnabled") {
  // Automation resource ID
  id string
  // Automation name
  name string
  // Automation resource type
  type string
  // Azure region the automation resource lives in
  location string
  // Resource tags
  tags map[string]string
  // Description recorded on the automation
  description string
  // Whether the rule is running
  //
  // False for a rule that exists but is switched off, which forwards
  // nothing. An export that is configured but disabled is the case a
  // presence check alone would miss.
  isEnabled bool
  // Scopes the rule applies to
  //
  // Each entry: `scopePath` (the subscription or a resource group under it,
  // as a fully qualified resource ID) and `description`.
  scopes []dict
  // Event sources the rule listens to, with the filters applied to each
  //
  // Each entry: `eventSource` (Alerts, Assessments, SecureScores and the
  // other supported event models) and `ruleSets`, a list of
  // `{"rules": [...]}`. Rule sets are combined with a logical or, and the
  // rules within one with a logical and. Each rule carries `propertyJPath`,
  // `propertyType`, `operator` and `expectedValue`, so a severity filter
  // reads as propertyJPath "Severity" equals "High".
  sources []dict
  // Destinations matching events are forwarded to
  //
  // Each entry carries `actionType` and the fields for that type:
  // `eventHubResourceId` and `isTrustedServiceEnabled` for EventHub,
  // `workspaceResourceId` for Workspace, `logicAppResourceId` and `uri` for
  // LogicApp. The Event Hub connection string is a credential and Azure
  // never returns it, so it is not reported here.
  actions []dict
}

// Microsoft Defender for Cloud security contact
private azure.subscription.cloudDefenderService.securityContact @defaults("id name"){
  // ID of the security contact
  id string
  // Name of the security contact
  name string
  // Whether the security contact is enabled
  isEnabled bool
  // Phone number of the security contact
  phone string
  // Emails that receive security alerts
  emails []string
  // Email notification sources and their thresholds
  //
  // Keyed by source type ("Alert" or "AttackPath"). Each value carries the
  // source type and its minimum notification threshold: minimalSeverity for
  // Alert sources and minimalRiskLevel for AttackPath sources.
  notificationSources dict
  // Subscription roles that receive email notifications
  //
  // Carries state ("On" or "Off") and roles, the list of subscription RBAC
  // roles whose members are notified (for example Owner, Contributor,
  // ServiceAdmin, or AccountAdmin).
  notificationsByRole dict
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure IAM service
private azure.subscription.authorizationService {
  // Subscription identifier
  subscriptionId string
  // Role definitions for the Azure subscription
  roles() []azure.subscription.authorizationService.roleDefinition
  // Role assignments
  roleAssignments() []azure.subscription.authorizationService.roleAssignment
  // Managed identities
  managedIdentities() []azure.subscription.managedIdentity
  // Deny assignments: read-only deny rules that block actions even for owners (e.g., managed-app deny on resources)
  denyAssignments() []azure.subscription.authorizationService.denyAssignment
  // Classic (ASM) co-administrators
  //
  // Deprecated in favor of roleAssignments. Azure retired classic
  // administrators on 2024-08-31 and converted the remaining grants to RBAC
  // Owner assignments, so this list is always empty.
  classicAdministrators() @maturity("deprecated") @replaced_by("azure.subscription.authorizationService.roleAssignments") []azure.subscription.authorizationService.classicAdministrator
  // PIM role eligibility schedules: who is eligible to activate which privileged role
  roleEligibilitySchedules() []azure.subscription.authorizationService.roleEligibilitySchedule
  // PIM role assignment schedules: currently active (including time-bound) privileged role assignments
  roleAssignmentSchedules() []azure.subscription.authorizationService.roleAssignmentSchedule
  // PIM role management policies: the rules governing how privileged roles are activated and assigned
  roleManagementPolicies() []azure.subscription.authorizationService.roleManagementPolicy
}

// Azure PIM role management policy
//
// A Privileged Identity Management policy governing how a role is
// activated and assigned at a scope: whether activation requires
// approval, multi-factor authentication, justification, or a ticket,
// how long an activation lasts, and who is notified. The behavior is
// expressed through the policy `rules`. Select by the policy's Azure
// resource ID. Audit these to confirm privileged roles are gated
// rather than freely self-activated.
private azure.subscription.authorizationService.roleManagementPolicy @defaults("displayName scope isOrganizationDefault") {
  // Policy resource ID
  id string
  // Policy name
  name string
  // Scope the policy applies to
  scope string
  // Policy display name
  displayName string
  // Policy description
  description string
  // Whether this is the organization's default policy
  isOrganizationDefault bool
  // When the policy was last modified
  lastModifiedDateTime time
  // Principal that last modified the policy
  //
  // Keys: `id`, `displayName`, `email`, and `type`.
  lastModifiedBy dict
  // Rules governing activation and assignment (approval, enablement, expiration, notification, authentication context)
  rules() []azure.subscription.authorizationService.roleManagementPolicy.rule
}

// PIM role management policy rule
//
// A single rule within a role management policy, identified by
// `ruleType`. Which fields carry values depends on that type: an
// enablement rule populates `enabledRules` (Justification,
// MultiFactorAuthentication, Ticketing) to say what activation demands;
// an expiration rule populates `isExpirationRequired` and
// `maximumDuration`; an approval rule populates `approvalSetting`; an
// authentication context rule populates `isEnabled` and `claimValue`;
// a notification rule populates the notification fields. The `target`
// describes which caller, level, and operations the rule governs.
// Select by the rule's `id`.
private azure.subscription.authorizationService.roleManagementPolicy.rule @defaults("id ruleType") {
  // Rule ID (unique within the policy, e.g. "Enablement_Admin_Eligibility")
  id string
  // Rule type
  //
  // One of RoleManagementPolicyApprovalRule,
  // RoleManagementPolicyAuthenticationContextRule,
  // RoleManagementPolicyEnablementRule,
  // RoleManagementPolicyExpirationRule, or
  // RoleManagementPolicyNotificationRule.
  ruleType string
  // What the rule governs
  //
  // Keys: `caller`, `level`, `operations`, `targetObjects`,
  // `inheritableSettings`, and `enforcedSettings`.
  target dict
  // Enablement rule: activation requirements enabled on the role
  //
  // Any of Justification, MultiFactorAuthentication, or Ticketing.
  // Empty on rule types other than the enablement rule.
  enabledRules []string
  // Expiration rule: whether an expiration is required on the assignment or activation
  isExpirationRequired bool
  // Expiration rule: maximum duration (ISO 8601 duration) of an activation or assignment
  maximumDuration string
  // Approval rule: approval settings
  //
  // Keys: `approvalMode`, `isApprovalRequired`,
  // `isApprovalRequiredForExtension`, `isRequestorJustificationRequired`,
  // and `approvalStages` (each stage listing its approvers).
  approvalSetting dict
  // Authentication context rule: whether the rule is enabled
  isEnabled bool
  // Authentication context rule: the required claim value
  claimValue string
  // Notification rule: notification level (None, Critical, All)
  notificationLevel string
  // Notification rule: delivery mechanism (e.g. Email)
  notificationType string
  // Notification rule: recipient type (Requestor, Approver, Admin)
  recipientType string
  // Notification rule: explicit notification recipients
  notificationRecipients []string
  // Notification rule: whether default recipients also receive the notification
  isDefaultRecipientsEnabled bool
}

// Azure PIM role eligibility schedule
//
// A Privileged Identity Management eligibility: a principal that can activate a
// role at a scope, rather than holding it permanently. Surfaces the eligible
// principal, the role, the scope, the eligibility window, and the activation
// membership type. Select by the schedule's Azure resource ID.
private azure.subscription.authorizationService.roleEligibilitySchedule @defaults("principalDisplayName roleDefinitionName status") {
  // Eligibility schedule ID
  id string
  // Eligibility schedule name
  name string
  // Principal ID (user, group, or service principal) eligible for the role
  principalId string
  // Type of the eligible principal (User, Group, ServicePrincipal, ForeignGroup, Device)
  principalType string
  // Display name of the eligible principal
  principalDisplayName string
  // Scope the eligibility applies to
  scope string
  // Status of the eligibility schedule
  status string
  // Membership type of the eligibility (Inherited, Direct, Group)
  memberType string
  // When the eligibility window starts
  startDateTime time
  // When the eligibility window ends; null for permanent eligibility
  endDateTime time
  // ABAC condition limiting the eligibility, if any
  condition string
  // Display name of the role the principal is eligible for
  roleDefinitionName string
  // Role the principal is eligible to activate
  roleDefinition() azure.subscription.authorizationService.roleDefinition
}

// Azure PIM role assignment schedule
//
// A Privileged Identity Management active assignment: a role currently granted
// to a principal at a scope, whether permanent, time-bound, or activated from
// an eligibility. Surfaces the principal, role, scope, assignment window, and
// whether the grant is assigned or activated. Select by the schedule's Azure
// resource ID.
private azure.subscription.authorizationService.roleAssignmentSchedule @defaults("principalDisplayName roleDefinitionName assignmentType status") {
  // Assignment schedule ID
  id string
  // Assignment schedule name
  name string
  // Principal ID (user, group, or service principal) holding the role
  principalId string
  // Type of the assigned principal (User, Group, ServicePrincipal, ForeignGroup, Device)
  principalType string
  // Display name of the assigned principal
  principalDisplayName string
  // Scope the assignment applies to
  scope string
  // How the role was granted (Assigned for a standing assignment, Activated from an eligibility)
  assignmentType string
  // Status of the assignment schedule
  status string
  // Membership type of the assignment (Inherited, Direct, Group)
  memberType string
  // When the assignment window starts
  startDateTime time
  // When the assignment window ends; null for a permanent assignment
  endDateTime time
  // ABAC condition limiting the assignment, if any
  condition string
  // Display name of the assigned role
  roleDefinitionName string
  // Role granted to the principal
  roleDefinition() azure.subscription.authorizationService.roleDefinition
}

// Deny assignment in an Azure subscription
private azure.subscription.authorizationService.denyAssignment @defaults("name doNotApplyToChildScopes type") {
  // Deny assignment ID
  id string
  // Deny assignment name
  name string
  // Resource type
  type string
  // Display name shown in the portal
  denyAssignmentName string
  // Description of the deny assignment
  description string
  // Whether the deny rule does not apply to child scopes
  doNotApplyToChildScopes bool
  // Whether the deny rule is system-protected (cannot be removed by users)
  isSystemProtected bool
  // Scope of the deny assignment (subscription/resource group/resource)
  scope string
  // Denied permissions
  //
  // Each entry has keys `actions`, `dataActions`, `notActions`,
  // `notDataActions`, `condition`, and `conditionVersion`.
  permissions []dict
  // Principals subject to the deny
  //
  // Each entry has keys `id`, `type`, `displayName`, and `email`.
  principals []dict
  // Principals excluded from the deny
  //
  // Each entry has keys `id`, `type`, `displayName`, and `email`.
  excludePrincipals []dict
}

// Classic (ASM) administrator
//
// Legacy co-administrator or service administrator grant from the classic
// (Azure Service Management) deployment model. These grants predate role-based
// access control and carry broad subscription-wide access. Deprecated in favor
// of azure.subscription.authorizationService.roleAssignment: Azure retired
// classic administrators on 2024-08-31 and converted the remaining grants to
// RBAC Owner assignments, so no subscription returns one. Select by the
// administrator's resource ID. Will be removed in the next major release.
private azure.subscription.authorizationService.classicAdministrator @defaults("emailAddress role") @maturity("deprecated") @replaced_by("azure.subscription.authorizationService.roleAssignment") {
  // Classic administrator ID
  id string
  // Resource name (typically the email)
  name string
  // Resource type
  type string
  // Email of the classic administrator
  emailAddress string
  // Role granted ("ServiceAdministrator", "CoAdministrator", "AccountAdministrator")
  role string
}

// Azure role definition
private azure.subscription.authorizationService.roleDefinition @defaults ("name type") {
  // ID of the role definition
  id string
  // Description of the role definition
  description string
  // Name of the role definition
  name string
  // Role type
  type string
  // Scopes for which the role definition applies
  scopes []string
  // Permissions that are attached to the role definition
  permissions() []azure.subscription.authorizationService.roleDefinition.permission
  // Whether the role can grant roles, and so escalate its own privileges
  //
  // True when the role's allowed actions cover
  // `Microsoft.Authorization/roleAssignments/write`,
  // `Microsoft.Authorization/roleDefinitions/write`, or
  // `Microsoft.Authorization/elevateAccess/action` (directly or via a
  // wildcard) and no notActions entry takes that action back. A
  // principal holding such a role can assign itself any other role at
  // the same scope, so its effective privilege is Owner no matter what
  // the role is called. Built-in Owner and User Access Administrator
  // both report true, as does any custom role that reaches those
  // actions.
  isPrivilegeEscalating() bool
  // Whether the role grants wildcard control-plane actions
  //
  // True when any allowed action contains a `*`. A bare `*` is full
  // control at the assigned scope. A narrower pattern such as
  // `Microsoft.Compute/*` still grants every action in that namespace,
  // including actions Azure adds after the role was written, so the
  // role's privilege grows over time without anyone editing it.
  hasWildcardActions() bool
  // Whether the role grants data-plane access
  //
  // True when the role allows any dataActions. Control-plane actions
  // govern a resource's configuration; data actions reach its contents
  // (blob bytes, queue messages, key material), so a role granting them
  // exposes stored data rather than only settings.
  grantsDataAccess() bool
}

// Azure role definition permission
private azure.subscription.authorizationService.roleDefinition.permission @defaults ("allowedActions deniedActions") {
  // ID of the permission
  id string
  // List of allowed actions that are attached to the permission
  allowedActions []string
  // List of denied actions that are attached to the permission
  deniedActions []string
  // List of allowed data actions that are attached to the permission
  allowedDataActions []string
  // List of denied data actions that are attached to the permission
  deniedDataActions []string
}

// Azure role assignment
private azure.subscription.authorizationService.roleAssignment  @defaults("principalId principalType role.name") {
  id string
  description string
  scope string
  principalId string
  // Type of the assigned principal ("User", "Group", "ServicePrincipal", "ForeignGroup", or "Device")
  principalType string
  condition string
  createdAt time
  updatedAt time
  // Resource ID of the role definition the assignment grants
  //
  // The full ARM ID of the granted role, for example
  // "/subscriptions/<id>/providers/Microsoft.Authorization/roleDefinitions/<guid>".
  // Always present, including when the role itself resolves to null because
  // it is defined at a scope this subscription listing does not cover.
  roleDefinitionId() string
  role() azure.subscription.authorizationService.roleDefinition
  // Microsoft Entra principal the role was assigned to
  //
  // Resolves principalId against the directory, giving the grant a name,
  // an object type, and (for service principals) the application and
  // home tenant behind it. Null when the object no longer exists, which
  // marks the assignment as an orphaned grant to a deleted principal.
  // Requires the credential to hold Microsoft Graph directory read
  // access; without it this reports an error rather than reporting no
  // principal, since the latter would silently understate who holds
  // access.
  principal() azure.entraPrincipal
}

// Azure resource SKU
//
// The billable tier and capacity an Azure resource is provisioned at. The tier
// gates which security features a service can use, so it is read together with
// the feature flags it enables. Azure models a different subset of the SKU
// members per service, and a member the service does not report reads null
// rather than an empty value.
private azure.subscription.resourceSku @defaults("name tier") {
  // SKU name, the billable product identifier
  name string
  // SKU tier gating the available feature set
  //
  // Commonly "Free", "Basic", "Standard", "Premium" or "Isolated", with the
  // exact set varying by service. Null on services whose SKU carries no tier,
  // among them Azure Cache for Redis and Azure Automation.
  tier string
  // SKU size within the tier
  size string
  // SKU family, the hardware or capability generation the SKU belongs to
  family string
  // SKU model, reported by the services that version their SKUs by model
  model string
  // Number of provisioned units of the SKU
  capacity int
}

// Azure managed identity assignment
//
// The managed identity configuration attached to an Azure resource: whether
// the resource carries a system-assigned identity, user-assigned identities,
// or both, the object ID of the system-assigned principal, and the tenant that
// owns it. Read userAssignedIdentities to reach the standalone identities and,
// through them, the role assignments that grant the resource its privileges. A
// member the service does not report reads null rather than an empty value.
private azure.subscription.resourceIdentity @defaults("type principalId") {
  // Managed identity type
  //
  // One of "None", "SystemAssigned", "UserAssigned", or
  // "SystemAssigned, UserAssigned".
  type string
  // Object ID of the system-assigned managed identity principal
  //
  // Null on the services whose identity block carries no principal, among
  // them an Azure Batch pool.
  principalId string
  // Entra ID tenant that owns the system-assigned managed identity
  tenantId string
  // User-assigned managed identities attached to the resource
  userAssignedIdentities() []azure.subscription.managedIdentity
}

// Azure managed database maintenance window
//
// The weekly window in which Azure applies planned maintenance to a managed
// database server, or the marker that the server takes the system default
// window instead. The day of week runs 0 for Sunday through 6 for Saturday and
// the start time is expressed in UTC.
private azure.subscription.maintenanceWindow @defaults("customWindow dayOfWeek startHour") {
  // Whether a custom window is in effect, "Enabled" or "Disabled"
  customWindow string
  // Day of the week the window opens, 0 for Sunday through 6 for Saturday
  dayOfWeek int
  // Hour of the day the window opens, in UTC
  startHour int
  // Minute of the hour the window opens
  startMinute int
}

// Azure Cache for Redis server configuration
//
// The Redis server settings Azure reports for a cache: whether unauthenticated
// access is permitted, whether Microsoft Entra ID authentication is enabled,
// the eviction policy, and the RDB and AOF persistence settings together with
// the credential the cache uses to reach its backup storage. ARM reports every
// one of these as a string rather than a boolean, so "true" and "false" arrive
// as text.
private azure.subscription.cacheService.redisInstance.configuration @defaults("authNotRequired aadEnabled maxmemoryPolicy") {
  // Whether the cache accepts connections without an access key
  //
  // Azure reports "true" when key authentication is turned off, and leaves the
  // setting absent (null) when it is required.
  authNotRequired string
  // Whether Microsoft Entra ID authentication is enabled, "true" or "false"
  aadEnabled string
  // Key eviction policy applied when the cache reaches its memory limit
  //
  // For example "volatile-lru", "allkeys-lru", "volatile-random",
  // "allkeys-random", "volatile-ttl", or "noeviction".
  maxmemoryPolicy string
  // Whether RDB snapshot persistence is enabled, "true" or "false"
  rdbBackupEnabled string
  // Interval between RDB snapshots, in minutes
  rdbBackupFrequency string
  // Whether AOF persistence is enabled, "true" or "false"
  aofBackupEnabled string
  // Credential the cache uses to reach its data-persistence storage account
  //
  // "SAS" for a shared access signature or "ManagedIdentity" for a managed
  // identity, which avoids a long-lived secret in the cache configuration.
  preferredDataPersistenceAuthMethod string
}

// Cosmos DB account key metadata
//
// When each of the four account master keys was last generated. A key that has
// not been regenerated in a long time is the signal a key-rotation audit is
// looking for, and the read-only keys rotate independently of the read-write
// ones.
private azure.subscription.cosmosDbService.account.masterKeyMetadata {
  // Metadata of the primary read-write master key
  primaryMasterKey azure.subscription.cosmosDbService.account.accountKeyMetadata
  // Metadata of the secondary read-write master key
  secondaryMasterKey azure.subscription.cosmosDbService.account.accountKeyMetadata
  // Metadata of the primary read-only master key
  primaryReadonlyMasterKey azure.subscription.cosmosDbService.account.accountKeyMetadata
  // Metadata of the secondary read-only master key
  secondaryReadonlyMasterKey azure.subscription.cosmosDbService.account.accountKeyMetadata
}

// Cosmos DB account key metadata entry
//
// The provenance Azure records for a single Cosmos DB account master key.
private azure.subscription.cosmosDbService.account.accountKeyMetadata @defaults("generationTime") {
  // When the key was last generated; null when Azure has never recorded a rotation
  generationTime time
}

// Traffic Manager profile DNS settings
//
// The DNS name a Traffic Manager profile answers on and the time to live it
// hands out. A short TTL shortens the window in which clients keep resolving
// to an endpoint the profile has already taken out of rotation, which is what
// a failover-readiness check looks at.
private azure.subscription.networkService.trafficManagerProfile.dnsSettings @defaults("fqdn ttl") {
  // Leftmost label of the profile's DNS name, unique within trafficmanager.net
  relativeName string
  // Fully qualified DNS name the profile answers on
  fqdn string
  // Time to live of the DNS responses, in seconds
  ttl int
}

// SQL failover group read-write endpoint
//
// How the read-write listener of a failover group fails over to the secondary
// server. An automatic policy fails over without an operator, after the grace
// period has elapsed; a manual policy leaves the group on the primary until
// someone triggers the failover.
private azure.subscription.sqlService.server.failoverGroup.readWriteListener @defaults("failoverPolicy") {
  // Failover policy of the read-write endpoint, "Automatic" or "Manual"
  failoverPolicy string
  // Grace period Azure waits before failing over with possible data loss, in minutes
  //
  // Null on a manual policy, where no automatic failover is attempted.
  failoverWithDataLossGracePeriodMinutes int
}

// SQL failover group read-only endpoint
//
// Whether the read-only listener of a failover group follows the primary when
// the group fails over. Disabled means read-only traffic stops rather than
// following the new primary.
private azure.subscription.sqlService.server.failoverGroup.readOnlyListener @defaults("failoverPolicy") {
  // Failover policy of the read-only endpoint, "Enabled" or "Disabled"
  failoverPolicy string
}

// Defender for Storage feature operational status
//
// The status Microsoft Defender for Storage reports for one of its features on
// an account. A feature can be switched on in the configuration and still not
// be running, so a "the feature is enabled" check that ignores this status can
// report protection that is not in effect.
private azure.subscription.storageService.account.defenderForStorageSetting.operationStatus @defaults("code message") {
  // Status code, "Succeeded" when the feature is operating
  code string
  // Human-readable explanation of the status; empty when the feature is operating
  message string
}

// Key rotation policy attributes
//
// How long a key version stays current under the rotation policy, and when the
// policy itself was created and last changed. The expiry time is an ISO 8601
// duration, for example "P90D" for ninety days, and is the value a
// "keys rotate at least every N days" check reads.
private azure.subscription.keyVaultService.key.rotationPolicyObject.policyAttributes @defaults("expiryTime") {
  // Lifetime of a key version created under this policy, as an ISO 8601 duration
  //
  // For example "P90D" or "P1Y". Null when the policy sets no expiry, which
  // leaves key versions valid indefinitely.
  expiryTime string
  // When the rotation policy was created
  created time
  // When the rotation policy was last updated
  updated time
}

// Service Bus namespace firewall IP rule
//
// A single entry of the namespace firewall: the address or CIDR range the rule
// covers and what the namespace does with traffic from it. Azure only supports
// an allow action today, so a rule list that is empty while public network
// access is enabled means the namespace is reachable from anywhere.
private azure.subscription.serviceBusService.namespace.networkRules.ipRule @defaults("ipMask action") {
  // IPv4 address or CIDR range the rule covers
  ipMask string
  // Action taken for traffic from the range, "Allow"
  action string
}

// Event Hubs namespace firewall IP rule
//
// A single entry of the namespace firewall: the address or CIDR range the rule
// covers and what the namespace does with traffic from it. Azure only supports
// an allow action today, so a rule list that is empty while public network
// access is enabled means the namespace is reachable from anywhere.
private azure.subscription.eventHubService.namespace.networkRules.ipRule @defaults("ipMask action") {
  // IPv4 address or CIDR range the rule covers
  ipMask string
  // Action taken for traffic from the range, "Allow"
  action string
}

// Event Grid inbound IP rule
//
// A single entry of an Event Grid resource firewall: the address or CIDR range
// the rule covers and what the resource does with publish traffic from it. The
// rules only take effect while public network access is enabled, so both are
// read together.
private azure.subscription.eventGridService.inboundIpRule @defaults("ipMask action") {
  // IPv4 address or CIDR range the rule covers
  ipMask string
  // Action taken for publish traffic from the range, "Allow"
  action string
}

// Azure managed identity
//
// Azure managed identity that a resource uses to authenticate to other
// Azure services without an embedded secret, either system-assigned (tied
// to a single resource's lifecycle) or user-assigned (a standalone identity
// attachable to many resources). The `roleAssignments` show the privileges
// granted to the identity across scopes, and `federatedIdentityCredentials`
// reveal external OIDC issuers trusted to obtain tokens for it (workload
// identity federation), a common privilege-escalation path worth auditing.
private azure.subscription.managedIdentity @defaults("name") {
  // Name of the managed identity
  name string
  // Client ID (application ID) of the identity's service principal
  clientId string
  // Object ID of the identity's service principal, referenced by role assignments
  principalId string
  // Entra ID tenant that owns the identity
  tenantId string
  roleAssignments() []azure.subscription.authorizationService.roleAssignment
  // Federated identity credentials (workload identity federation)
  //
  // Each entry trusts an external OIDC issuer to mint tokens for this
  // identity, with `name`, `issuer`, `subject`, and the allowed token
  // `audiences`. A broad or unexpected issuer/subject is a privilege-
  // escalation path worth auditing.
  federatedIdentityCredentials() []dict
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure Kubernetes Service
private azure.subscription.aksService {
  // Subscription identifier
  subscriptionId string
  // List all the AKS clusters inside the subscription
  clusters() []azure.subscription.aksService.cluster
}

// Azure Kubernetes Service (AKS) cluster
//
// Managed Kubernetes cluster and its control-plane security posture:
// the Kubernetes version, private-cluster and API server access
// controls, network plugin and policy, RBAC and Azure AD integration,
// workload identity federation through the OIDC issuer, KMS encryption
// of cluster secrets, Microsoft Defender monitoring, the auto-upgrade
// channel, and the node pools that back the cluster. The
// `internetReachable` predicate reports whether the API server is
// reachable from the public internet.
azure.subscription.aksService.cluster @defaults("name location kubernetesVersion") {
  // ID of the AKS cluster
  id string
  // Name of the AKS cluster
  name string
  // Location of the AKS cluster
  location string
  // The Kubernetes version of the AKS cluster
  kubernetesVersion string
  // The provisioning state of the AKS cluster
  provisioningState string
  // The power state of the AKS cluster
  powerState string
  // The tags of the AKS cluster
  tags map[string]string
  // The node resource group of the AKS cluster
  nodeResourceGroup string
  // Time the AKS cluster was created
  createdAt time
  // Whether RBAC is enabled for the AKS cluster
  rbacEnabled bool
  // The fully qualified domain name of the AKS cluster
  fqdn string
  // The DNS prefix of the AKS cluster
  dnsPrefix string
  // CSI storage driver configuration for the cluster
  //
  // Keys: `blobCSIDriver`, `diskCSIDriver`, `fileCSIDriver`, and
  // `snapshotController`, each an object with an `enabled` boolean. See
  // diskCsiDriverEnabled for the disk-driver state as a boolean.
  storageProfile dict
  // Whether the Azure Disk CSI driver is enabled on the cluster
  diskCsiDriverEnabled bool
  // Workload autoscaler add-on configuration
  //
  // Keys: `keda` (Kubernetes Event-driven Autoscaling) and
  // `verticalPodAutoscaler`, each an object with an `enabled` boolean.
  workloadAutoScalerProfile dict
  // Cluster security add-on configuration
  //
  // Keys: `azureKeyVaultKms` (`{enabled, keyId, keyVaultNetworkAccess,
  // keyVaultResourceId}`), `defender` (`{logAnalyticsWorkspaceResourceId,
  // securityMonitoring}`), `imageCleaner` (`{enabled, intervalHours}`),
  // `workloadIdentity` (`{enabled}`), and `customCATrustCertificates`.
  // Individual states are also exposed as the defenderEnabled,
  // imageCleanerEnabled, workloadIdentityEnabled, and
  // azureKeyVaultKmsEnabled fields.
  securityProfile dict
  // Azure AD pod-managed identity configuration
  //
  // Keys: `enabled`, `allowNetworkPluginKubenet`,
  // `userAssignedIdentities`, and `userAssignedIdentityExceptions`.
  podIdentityProfile dict
  // Cluster network configuration
  //
  // Keys include `networkPlugin`, `networkPluginMode`, `networkPolicy`,
  // `networkDataplane`, `networkMode`, `outboundType`, `loadBalancerSku`,
  // `loadBalancerProfile`, `natGatewayProfile`, `serviceCidr`(s),
  // `podCidr`(s), `dnsServiceIP`, `ipFamilies`, and `advancedNetworking`.
  // The networkPlugin and networkPolicy scalar fields expose the two
  // most common values directly.
  networkProfile dict
  // Outbound HTTP proxy configuration for cluster nodes
  //
