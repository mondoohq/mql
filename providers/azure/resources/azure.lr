  //
  // Empty when the database is not a secondary.
  secondaryType string
  // Number of high availability replicas backing the database
  highAvailabilityReplicaCount int
  // Maintenance configuration the database is assigned to
  //
  // Resource ID of the window Azure applies planned maintenance in.
  // Empty when the database takes the default window.
  maintenanceConfigurationId string
  // Minutes of inactivity before a serverless database is paused
  //
  // A value of -1 means auto-pause is disabled. Null on a provisioned
