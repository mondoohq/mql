  // Local certificate store holding the reverse proxy certificates referenced by common name
  //
  // One of AddressBook, AuthRoot, CertificateAuthority, Disallowed,
  // My, Root, TrustedPeople, or TrustedPublisher.
  reverseProxyCertificateCommonNamesStoreName string
  // Client certificates referenced by thumbprint that may manage the cluster
