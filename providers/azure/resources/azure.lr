// Azure Cache for Redis instance
//
// Managed Redis cache deployment and its exposure and hardening posture.
// Covers the pricing tier and SKU, Redis version, and the settings that
// determine reachability and transport security: publicNetworkAccess,
// the enableNonSslPort flag that opens the plaintext 6379 port,
// minimumTlsVersion, and the VNet injection or private-endpoint
// placement. redisConfiguration carries persistence and authentication
// settings, and the identity fields expose the cache's managed identity.
// Premium and Enterprise tiers add clustering (shardCount) and replicas.
azure.subscription.cacheService.redisInstance @defaults("id hostName") {
  // ID of the Redis cache
  id string
  // Name of the Redis cache
  name string
  // Location of the Redis cache
  location string
  // Type of the Redis cache
  type string
  // Raw Redis cache resource
  //
  // Unmodified Azure Resource Manager representation of the cache, keyed
  // by the ARM property names (`id`, `name`, `location`, `properties`,
  // `sku`, `identity`, `zones`, `tags`). Individual values are also
  // surfaced as their own fields on this resource; prefer those (for
  // example redisVersion, minimumTlsVersion) over reading this bag.
  properties dict
  // Specifies whether the non-ssl Redis server port (6379) is enabled
  enableNonSslPort bool
  // Redis host name
  hostName string
  // publicNetworkAccess possible values are "Enabled" and "Disabled"
  publicNetworkAccess string
  // Redis port (non-SSL)
  port int
  // Redis SSL port
  sslPort int
  // Provisioning state
  //
  // Possible values: Creating, Deleting, Failed, Succeeded, Updating, ConfiguringAAD, Disabled, Linking, Provisioning, RecoveringScaleFailure, Scaling, Unlinking, or Unprovisioning.
  provisioningState string
  // Redis version
  redisVersion string
  // Number of replicas per master
  replicasPerMaster int
  // Number of replicas per primary
  replicasPerPrimary int
  // Minimum TLS version required by the Redis cache
  minimumTlsVersion string
  // Whether access-key authentication is turned off
  //
  // True when the cache accepts only Microsoft Entra ID authentication
  // and its two access keys stop working. False, the default, leaves
  // the shared access keys valid, so anyone holding a key reaches the
  // cache with no identity attached and no way to revoke one caller
  // without rotating for all of them.
  disableAccessKeyAuthentication bool
  // Update channel the cache receives Redis updates on
  //
  // Either Stable or Preview. A Preview cache takes monthly updates
  // ahead of the Stable channel, which is a deliberate choice for a
  // test cache and usually a mistake for a production one.
  updateChannel string
  // How availability zones are assigned to the cache
  //
  // Either Automatic or NoZones. NoZones leaves the cache in a single
  // zone, so a zone outage takes it offline.
  zonalAllocationPolicy string
  // Tenant settings applied to the cache
  //
