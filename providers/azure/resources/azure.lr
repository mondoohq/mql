  // Object (principal) ID of the bound user-assigned managed identity
  managedIdentityObjectId string
  // Tenant ID of the bound user-assigned managed identity
  managedIdentityTenantId string
  // OIDC issuer URL the binding federates against
  oidcIssuerUrl string
  // Bound user-assigned managed identity
  managedIdentity() azure.subscription.managedIdentity
}

// AKS Trusted Access role binding
//
// Grant that lets another Azure resource call the cluster's Kubernetes API
// under a named Kubernetes role, with no cluster credentials and no network
// reachability to the API server. The `roles` field lists the resource-type
// qualified role names the source holds, for example
// "Microsoft.MachineLearningServices/workspaces/mlworkload", and
// `sourceResourceId` is the ARM ID of the resource holding the grant.
// `sourceMachineLearningWorkspace` resolves that source when it is an Azure
// Machine Learning workspace, so the workspace's own public-network exposure
// reads from the same query as the grant it holds.
private azure.subscription.aksService.cluster.trustedAccessRoleBinding @defaults("name roles provisioningState") {
  // Resource ID of the role binding
  id string
  // Name of the role binding
  name string
  // Resource-type qualified Kubernetes role names bound to the source resource
  roles []string
  // Provisioning state of the role binding
  //
  // One of "Canceled", "Deleting", "Failed", "Succeeded", or "Updating".
  provisioningState string
  // Resource ID of the Azure resource the binding grants Kubernetes API access to
  sourceResourceId string
  // Azure Machine Learning workspace holding the binding; null when the source is another resource type
  sourceMachineLearningWorkspace() azure.subscription.machineLearningService.workspace
}

// Azure Kubernetes Service cluster node pool (agent pool)
private azure.subscription.aksService.cluster.nodePool @defaults("name mode vmSize count") {
  // Node pool resource ID
  id string
  // Node pool name
  name string
  // Pool mode ("System" for kube-system pods, "User" for workloads, "Gateway" for static-egress gateway pools)
  mode string
  // Pool VM type ("VirtualMachineScaleSets", "AvailabilitySet", or "VirtualMachines")
  vmType string
  // Number of nodes currently in the pool
  count int
  // Minimum node count when autoscaling is enabled
  minCount int
  // Maximum node count when autoscaling is enabled
  maxCount int
  // Whether the cluster autoscaler manages this pool
  enableAutoScaling bool
  // Maximum number of pods that can run on a node
  maxPods int
  // Size of the node VMs
  vmSize string
  // OS type ("Linux" or "Windows")
  osType string
  // OS SKU ("Ubuntu", "AzureLinux", "Mariner", "Windows2019", "Windows2022", etc.)
  osSku string
  // OS disk type ("Ephemeral" or "Managed")
  osDiskType string
  // OS disk size in GB
  osDiskSizeGB int
  // Scale set priority ("Regular" or "Spot")
  scaleSetPriority string
  // Spot eviction policy ("Delete" or "Deallocate"; only when scaleSetPriority is "Spot")
  scaleSetEvictionPolicy string
  // Maximum price billed for spot nodes (-1 indicates "any on-demand price")
  spotMaxPrice float
  // Availability zones the pool is spread across
  availabilityZones []string
  // Whether each node receives its own public IP
  enableNodePublicIP bool
  // Resource ID of the public IP prefix used for node IPs (empty when not configured)
  nodePublicIPPrefixId string
  // Whether host-based encryption is enabled on nodes
  enableEncryptionAtHost bool
  // Whether ultra-SSD support is enabled on the pool
  enableUltraSSD bool
  // Whether nodes use a FIPS-enabled OS image
  enableFIPS bool
  // Kubernetes version requested for the pool (may be major.minor or major.minor.patch)
  orchestratorVersion string
  // Resolved Kubernetes version currently running on the nodes
  currentOrchestratorVersion string
  // Image version the nodes are currently running
  nodeImageVersion string
  // Resource ID of the subnet the pool nodes are joined to (empty when AKS auto-creates the VNet)
  vnetSubnetId string
  // Resource ID of the subnet pods are placed in when using delegated pod subnets (empty otherwise)
  podSubnetId string
  // Resource ID of the proximity placement group (empty when not configured)
  proximityPlacementGroupId string
  // Resource ID of the dedicated host group (empty when not configured)
  hostGroupId string
  // Provisioning state of the pool
  provisioningState string
  // Power state of the pool ("Running" or "Stopped")
  powerState string
  // Workload runtime ("OCIContainer", "WasmWasi", "KataVmIsolation", or "KataMshvVmIsolation")
  workloadRuntime string
  // Node labels applied to every node in the pool
  nodeLabels map[string]string
  // Node taints applied to every node in the pool (e.g. "key=value:NoSchedule")
  nodeTaints []string
  // Tags on the pool's underlying scale set
  tags map[string]string
  // Maximum surge during pool upgrades (e.g. "10%" or "1")
  upgradeMaxSurge string
  // Maximum unavailable nodes during pool upgrades (e.g. "5%" or "1")
  upgradeMaxUnavailable string
  // Drain timeout in minutes during pool upgrades
  upgradeDrainTimeoutInMinutes int
  // Soak duration in minutes between draining a node and reimaging it during upgrades
  upgradeNodeSoakDurationInMinutes int
  // SSH access mode for the pool ("LocalUser", "Disabled", or "EntraId")
  sshAccess string
  // Whether vTPM is enabled on nodes (Trusted Launch)
  enableVTPM bool
  // Whether Secure Boot is enabled on nodes (Trusted Launch)
  enableSecureBoot bool
  // Unsafe sysctls the kubelet accepts from pods on this pool
  //
  // Each entry is a sysctl name or a pattern ending in `*`. The kubelet
  // refuses these kernel parameters by default, so a non-empty list is the
  // set of node kernel settings a pod on this pool is permitted to change.
  // Empty when the pool carries no kubelet configuration.
  kubeletAllowedUnsafeSysctls []string
  // Port ranges allowed to reach the pool's nodes
  //
  // Each entry has `portStart`, `portEnd`, and `protocol` ("TCP" or "UDP").
  // These ranges open ports on the nodes themselves, so they do not appear in
  // the network security groups applied to the node subnet.
  allowedHostPorts []dict
  // IP tags applied to the instance-level public IPs of the pool's nodes, keyed by tag type
  nodePublicIPTags map[string]string
  // Application security groups the pool's nodes are associated with
  applicationSecurityGroups() []azure.subscription.networkService.appSecurityGroup
  // Node image and Kubernetes versions recently used by the pool, available for rollback
  //
  // Each entry has `orchestratorVersion`, `nodeImageVersion`, and the
  // `timestamp` when that version was last in use.
  recentlyUsedVersions() []dict
}

// Azure Advisor
//
// Azure Advisor recommendations and category scores for a subscription.
// Advisor analyzes resource configuration and usage telemetry and flags
// improvements across cost, security, reliability, operational excellence,
// and performance. The `recommendations` field enumerates individual
// findings, while `scores` and the rolled-up `averageScore` track posture
// per category over time.
private azure.subscription.advisorService @defaults("averageScore recommendations.length scores.length") {
  // Subscription identifier
  subscriptionId string
  // List of all recommendations by the advisor
  recommendations() []azure.subscription.advisorService.recommendation
  // List of scores by categories
  scores() []azure.subscription.advisorService.score
  // Average advisory score
  averageScore() float
}

// Azure Advisor recommendation
//
// Single Advisor finding for a subscription, describing a suggested
// improvement and the resource it applies to. Each recommendation carries
// a `category`, an `impact` rating, and a `risk` level, together with the
// affected resource in `impactedResource`. The `id` selects the record.
private azure.subscription.advisorService.recommendation @defaults("name category impact description impactedResource") {
  // Recommendation ID
  id string
  // Recommendation name
  name string
  // Recommendation resource type
  type string
  // Recommendation category
  //
  // One of Cost, HighAvailability, OperationalExcellence, Performance, or
  // Security.
  category string
  // Recommendation risk
  //
  // Potential risk of not implementing the recommendation. One of Error,
  // Warning, or None.
  risk string
  // Recommendation impact
  //
  // Business impact of the recommendation. One of High, Medium, or Low.
  impact string
  // Recommendation description
  description string
  // Recommendation remediation
  remediation string
  // The impacted resource category type
  impactedResourceType string
  // The impacted resource
  impactedResource string
  // Full recommendation properties
  //
  // The complete Advisor recommendation record. Keys include `category`,
  // `impact`, and `risk` (also surfaced as top-level fields), `impactedField`
  // and `impactedValue` (the affected resource type and resource), plus
  // `shortDescription`, `extendedProperties`, `metadata`, `resourceMetadata`,
  // `recommendationTypeId`, `learnMoreLink`, `potentialBenefits`, `actions`,
  // `remediation`, `label`, and `lastUpdated`.
  properties dict
}

// Azure Advisor score
private azure.subscription.advisorService.score @defaults("name") {
  // Score identifier
  id string
  // Score name
  name string
  // Score type
  type string
  // Current score for the advisor category
  currentScore azure.subscription.advisorService.securityScore
  // List of time series, containing previous scores for the category
  timeSeries []azure.subscription.advisorService.timeSeries
}

// Azure Advisor time series
private azure.subscription.advisorService.timeSeries {
  // Advisor time series identifier
  id string
  // The aggregation level for the time series
  aggregationLevel string
  // The scores in the time series
  scores []azure.subscription.advisorService.securityScore
}

// Azure Advisor security score
private azure.subscription.advisorService.securityScore {
  // Security score identifier
  id string
  // Security score score
  score float
  // The date the score was calculated
  date time
  // The potential percentage increase in overall score at subscription level after all recommendations are implemented
  potentialScoreIncrease float
  // The number of impacted resources
  impactedResourcesCount int
  // The count of impacted categories
  categoryCount int
  // The consumption units for the score
  consumptionUnits float
}

// Azure Policy service
//
// Azure Policy governance for a subscription, covering the policy
// assignments in effect, the definitions and initiatives they draw
// from, the exemptions that suspend enforcement, and an aggregate
// compliance summary. Use it to audit which governance controls are
// applied and where resources fall out of compliance.
private azure.subscription.policy @defaults("subscriptionId") {
  // Subscription identifier
  subscriptionId string
  // List of policy assignments in the subscription
  assignments () []azure.subscription.policy.assignment
  // List of policy definitions available in the subscription
  definitions() []azure.subscription.policy.definition
  // List of policy initiatives (set definitions) available in the subscription
  setDefinitions() []azure.subscription.policy.setDefinition
  // List of policy exemptions in the subscription
  exemptions() []azure.subscription.policy.exemption
  // Aggregate policy compliance summary for the subscription
  complianceSummary() azure.subscription.policy.complianceSummary
  // Per-resource policy compliance states in the subscription
  //
  // Enumerates the latest compliance evaluation of every resource
  // against every applicable policy, so the result set can be large on
  // subscriptions with many resources and assignments. Fetched only
  // when queried; filter by `complianceState` to isolate non-compliant
  // resources.
  states() []azure.subscription.policy.state
}

// Azure Policy compliance state
//
// The latest compliance evaluation of a single resource against a
// single policy: whether the resource is compliant, the effect the
// policy applies, and the assignment and definition responsible. Where
// the aggregate compliance summary reports counts, these records name
// the specific non-compliant resources, so audits can enumerate exactly
// what fails which control. Filter by `complianceState` to isolate
// non-compliant resources.
private azure.subscription.policy.state @defaults("complianceState resourceType policyDefinitionName") {
  // Compliance state ("Compliant", "NonCompliant", "Conflict", "Exempt")
  complianceState string
  // Full ARM resource ID of the evaluated resource
  //
  // For example `/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Compute/virtualMachines/<vm>`.
  resourceId string
  // Resource type of the evaluated resource
  resourceType string
  // Resource group of the evaluated resource
  resourceGroup string
  // Location of the evaluated resource
  resourceLocation string
  // Policy assignment that produced this state
  policyAssignment() azure.subscription.policy.assignment
  // Name of the policy assignment
  policyAssignmentName string
  // Scope of the policy assignment
  policyAssignmentScope string
  // Policy definition evaluated
  policyDefinition() azure.subscription.policy.definition
  // Name of the policy definition
  policyDefinitionName string
  // Reference ID of the definition within an initiative (set definition), if applicable
  policyDefinitionReferenceId string
  // Effect the policy definition applies (e.g. "deny", "audit", "deployIfNotExists", "append")
  policyDefinitionAction string
  // Category of the policy definition (e.g. "Security Center", "Storage")
  policyDefinitionCategory string
  // Initiative (set definition) the assignment applies, if any
  policySetDefinition() azure.subscription.policy.setDefinition
  // Name of the initiative (set definition), if applicable
  policySetDefinitionName string
  // When the evaluation was recorded
  timestamp time
}

// Azure Policy assignment
//
// Assignment of a policy definition or initiative to a scope, which
// puts the policy into effect. The enforcementMode field distinguishes
// active enforcement from audit-only evaluation (Default vs
// DoNotEnforce), and scope records whether the assignment is inherited
// from a containing management group or applied directly to the
// subscription.
private azure.subscription.policy.assignment @defaults("displayName enforcementMode") {
  // Assigned policy definition ID
  //
  // Deprecated in favor of policyDefinition, which resolves the same
  // value to the definition itself. Despite the name, this field holds
  // the assigned definition's resource ID rather than the assignment's
  // own ID, which is assignmentId.
  id @maturity("deprecated") @replaced_by("azure.subscription.policy.assignment.policyDefinition") string
  // Policy assignment resource ID
  assignmentId string
  // Display name of the assignment
  //
  // Deprecated in favor of displayName, which carries the same value
  // under a name that matches the Azure property. This field holds the
  // assignment's display name, not its resource name.
  name @maturity("deprecated") @replaced_by("azure.subscription.policy.assignment.displayName") string
  // Display name given to the assignment
  displayName string
  // Policy scope
  scope string
  // Scopes excluded from the assignment
  //
  // Resource IDs carved out of the assignment's scope. A subscription
  // that appears here is not evaluated by the assigned policy even
  // though the assignment covers its parent, so an exclusion list is
  // where an otherwise tenant-wide control stops applying.
  notScopes []string
  // Policy description
  description string
  // Policy enforcement Mode
  enforcementMode string
  // Origin of the assignment
  //
  // One of NotSpecified, System, SystemHidden, or Custom. System and
  // SystemHidden assignments are created by Azure itself (for example
  // by Defender for Cloud), so filtering them out isolates the
  // assignments an operator actually made.
  assignmentType string
  // Definition version the assignment pins
  //
  // Set when the assignment requests a specific version of the policy
  // definition, in #.#.# form and optionally with a wildcard such as
  // "1.*". Null when the assignment tracks whatever version the
  // definition currently ships.
  definitionVersion string
  // Definition version actually in use
  //
  // The version Azure resolved the assignment to at evaluation time.
  // Compare against latestDefinitionVersion to find assignments running
  // an older rule than the definition now offers.
  effectiveDefinitionVersion string
  // Newest definition version available
  latestDefinitionVersion string
  // Parameter values supplied to the assigned policy
  //
  // Keyed by parameter name, with each value an object holding a
  // `value` field that carries the argument passed to the definition.
  parameters dict
  // Open-ended assignment metadata
  //
  // Free-form object Azure and tooling use to record provenance,
  // typically carrying keys such as `assignedBy`, `createdBy`, and
  // `category`.
  metadata dict
  // Messages shown when a resource fails the policy
  //
  // Each entry carries a `message` and optionally a
  // `policyDefinitionReferenceId` naming which definition in an
  // initiative the message belongs to.
  nonComplianceMessages []dict
  // Per-definition effect overrides applied by the assignment
  //
  // Each entry carries a `kind` (currently `policyEffect`), a `value`
  // holding the replacement effect, and a `selectors` list naming the
  // definitions within an initiative it applies to. An override can
  // downgrade a deny to an audit for part of an initiative without
  // changing the initiative itself.
  overrides []dict
  // Resource selectors narrowing where the assignment applies
  //
  // Each entry carries a `name` and a `selectors` list of `kind`,
  // `in`, and `notIn` values that filter by resource location, resource
  // type, or provider namespace. A selector restricts an assignment to
  // part of its scope without excluding whole resource IDs.
  resourceSelectors []dict
  // Region the assignment resource is stored in
  //
  // Set when the assignment carries a managed identity, which is
  // required for deployIfNotExists and modify effects. Null otherwise.
  location string
  // Managed identity type attached to the assignment
  //
  // One of SystemAssigned, UserAssigned, or None. deployIfNotExists and
  // modify effects act through this identity, so its role assignments
  // are what the policy can actually do when it remediates.
  identityType string
  // Object ID of the assignment's system-assigned identity
  principalId string
  // Tenant of the assignment's system-assigned identity
  tenantId string
  // Whether the assignment allows self-serve exemptions
  //
  // When true, exemptions from this assignment can be created in the
  // UserSelfServe management mode (see the exemption's managementMode)
  // rather than only by a policy administrator. Null when the assignment
  // carries no self-serve exemption settings.
  selfServeExemptionEnabled bool
  // Definitions within the initiative that self-serve exemptions may cover
  //
  // Policy definition reference IDs inside the assigned initiative for
  // which self-serve exemptions are allowed. Null when the assignment
  // carries no self-serve exemption settings.
  selfServeExemptionPolicyDefinitionReferenceIds []string
  // Policy definition the assignment applies
  //
  // Resolves the assigned definition so the rule, its effect, and its
  // parameters can be read from the assignment. Null when the
  // definition cannot be read, which happens for an initiative or a
  // definition held at a management group the credential cannot see.
  policyDefinition() azure.subscription.policy.definition
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure Policy definition
//
// Single policy rule and the effect it produces (for example deny,
// audit, append, or deployIfNotExists). The policyType field records
// whether the definition ships with Azure or is custom, and policyRule
// holds the if/then condition evaluated against resources. Selecting
// definitions by their category metadata or effect helps audit which
// controls are available to assign.
private azure.subscription.policy.definition @defaults("name displayName policyType") {
  // Policy definition resource ID
  id string
  // Policy definition name
  name string
  // Display name of the policy definition
  displayName string
  // Description of what the policy enforces
  description string
  // Origin of the definition: BuiltIn, Custom, Static, or NotSpecified
  policyType string
  // Resource types the policy evaluates, for example All, Indexed, or a Microsoft.*.Data mode
  mode string
  // Policy rule expressing the if/then condition and resulting effect
  policyRule dict
