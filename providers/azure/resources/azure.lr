  ports @maturity("deprecated") @replaced_by("azure.subscription.cloudDefenderService.jitNetworkAccessPolicy.virtualMachine.portRules") []dict
  // Per-port just-in-time rules
  //
  // One rule per port the policy can open on demand, with the sources it
  // may be opened to and how long a grant lasts.
  portRules []azure.subscription.cloudDefenderService.jitNetworkAccessPolicy.virtualMachine.portRule
}

// Just-in-time port rule
//
// One port a just-in-time policy can open on a virtual machine, the sources
// it may be opened to, and the longest a single grant can last. A rule
// allowing "*" opens the port to the whole internet for the duration of every
// approved request, which makes just-in-time access a delay rather than a
// restriction.
private azure.subscription.cloudDefenderService.jitNetworkAccessPolicy.virtualMachine.portRule @defaults("number protocol maxRequestAccessDuration") {
  // Port number the rule governs
  number int
  // Transport protocol the rule governs ("TCP", "UDP", or "*")
  protocol string
  // Longest a single access grant lasts, in ISO 8601 duration form
  //
  // At least 5 minutes and at most 1 day, for example "PT3H".
  maxRequestAccessDuration string
  // Single source address or CIDR range access may be granted to
  //
  // Mutually exclusive with allowedSourceAddressPrefixes; empty when the
  // rule uses the list form instead.
  allowedSourceAddressPrefix string
  // Source addresses or CIDR ranges access may be granted to
  //
  // Mutually exclusive with allowedSourceAddressPrefix; empty when the
  // rule uses the single-value form instead.
  allowedSourceAddressPrefixes []string
}

