  enabled bool
  // Severity (0 = Critical through 4 = Verbose)
  severity int
  // Resource IDs the rule queries
  scopes []string
  // How often the rule evaluates its query (ISO 8601 duration)
  evaluationFrequency string
  // Time window the query covers (ISO 8601 duration)
  windowSize string
  // Duration for which actions are muted after firing (ISO 8601 duration)
  muteActionsDuration string
  // Whether the alert auto-resolves when the condition clears
  autoMitigate bool
  // Resource types the rule queries
