// Stored access policy on a storage account container, queue or table
//
// Named policy that a shared access signature can be bound to. The policy is
// what makes such a signature revocable: deleting or expiring it withdraws
// every signature issued against it, where a signature issued with its
// permissions and expiry inline stays valid until it expires on its own.
private azure.subscription.storageService.account.storedAccessPolicy @defaults("id permission expiryTime") {
  // Policy identifier a shared access signature binds to
  id string
  // Permission letters the policy grants
  //
  // Any of "r" (read), "a" (add), "c" (create), "w" (write), "d" (delete),
  // "l" (list), "u" (update), and "p" (process), concatenated. The set
  // that applies depends on the service the policy sits on.
  permission string
  // When the policy starts granting access; null when it grants access immediately
  startTime time
  // When the policy stops granting access
  //
  // Null when the policy sets no expiry, which leaves every signature bound
  // to it valid until the policy itself is deleted.
  expiryTime time
}

