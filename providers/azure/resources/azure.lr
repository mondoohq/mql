  cmkIdentity() azure.subscription.managedIdentity
  // User-assigned managed identities associated with the factory
  userAssignedIdentities() []azure.subscription.managedIdentity
  // Time the factory was created
  created time
  // Linked services configured on the factory (connection info for external systems)
  linkedServices() []azure.subscription.dataFactoryService.factory.linkedService
  // Integration runtimes that execute pipeline activities
  integrationRuntimes() []azure.subscription.dataFactoryService.factory.integrationRuntime
  // Managed virtual network for the factory, if one exists
