  //
  // One of "Free", "Shared", "Basic", "Standard", "Premium", "PremiumV2",
  // "PremiumV3", "Isolated", "IsolatedV2", "Dynamic", "ElasticPremium",
  // "ElasticIsolated", "PremiumContainer", or "FlexConsumption".
  tier string
  // SKU size, the instance size within the tier
  size string
  // SKU family
  family string
  // Number of worker instances the plan is provisioned for
  capacity int
  // Regions the SKU is offered in
  locations []string
  // Feature flags Azure reports for the SKU
  capabilities []azure.subscription.webService.appServicePlan.skuCapability
  // Scaling limits of the SKU; null when Azure does not report them
  capacityLimits azure.subscription.webService.appServicePlan.skuCapacityLimits
}

// Feature flag on an App Service plan SKU
//
// One capability Azure reports for the plan's SKU, such as whether the SKU
