  // List of Load Balancer inbound NAT pools
  inboundNatPools() []azure.subscription.networkService.inboundNatPool
  // List of Load Balancer inbound NAT rules
  inboundNatRules() []azure.subscription.networkService.inboundNatRule
  // List of Load Balancer outbound rules
  outboundRules() []azure.subscription.networkService.outboundRule
  // List of Load Balancer rules
  loadBalancerRules() []azure.subscription.networkService.loadBalancerRule
}

// Azure network probe
//
// Health probe a load balancer uses to decide whether a backend instance
// still receives traffic. The probe's transport is `protocol` (Tcp, Http,
// or Https) with `port` and, for the HTTP protocols, `requestPath`.
// `intervalInSeconds`, `numberOfProbes` and `probeThreshold` set how fast
// an unhealthy instance is taken out of rotation, and
// `noHealthyBackendsBehavior` decides whether traffic is dropped or still
// forwarded once every instance fails.
