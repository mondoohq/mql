  // Deleted vault name
  name string
  // Azure region the vault was deleted in
  location string
  // Resource type
  type string
  // Resource ID of the deleted vault
  //
  // Identifies the original vault that was deleted. The vault no longer
  // exists as a live resource, so only its resource ID is retained.
  vaultResourceId string
  // Time the vault was deleted (UTC)
  vaultDeletionTime time
  // Time the vault will be permanently purged (UTC)
  purgeAt time
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Security settings for a Recovery Services vault
private azure.subscription.recoveryServicesService.vault.securitySettings @defaults("softDeleteState immutabilityState multiUserAuthorization") {
  // Security settings identifier
  id string
  // Soft delete state ("Enabled", "Disabled", "AlwaysON", or "Invalid")
  softDeleteState string
  // Soft delete retention period in days
  softDeleteRetentionPeriodInDays int
  // Enhanced security state ("Enabled", "Disabled", "AlwaysON", or "Invalid")
  enhancedSecurityState string
  // Immutability state ("Disabled", "Locked", or "Unlocked")
  immutabilityState string
  // Multi-User Authorization state ("Enabled", "Disabled", or "Invalid"); Enabled requires a Resource Guard for destructive ops
  multiUserAuthorization string
  // Source-scan configuration state ("Enabled" or "Disabled") for backup item discovery
  sourceScanConfigurationState string
}

// Encryption settings for a Recovery Services vault
