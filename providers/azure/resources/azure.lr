option provider = "go.mondoo.com/mql/providers/azure"
option go_package = "go.mondoo.com/mql/providers/azure/resources"

// Microsoft Azure
//
// Root namespace and entry point for the Azure provider. The active
// subscription is exposed as `azure.subscription`, and every Azure
// service-specific accessor (Compute, Storage, Network, Key Vault,
// Cosmos DB, Monitor, Defender for Cloud, AKS, and so on) is reached
// through that subscription. Tenant-wide structures that sit above any
// single subscription are reached here instead: managementGroups walks
// the governance hierarchy the tenant's subscriptions hang from.
azure {
  // Management groups in the tenant
  //
  // Every management group the credential can read, in no particular
  // order, including the tenant root group. Management groups are the
  // governance containers above subscriptions, so this is where a role
  // assignment or policy assignment made at a management group scope
  // gets a name, a position in the hierarchy, and a measurable blast
  // radius. Empty when the credential has no Microsoft.Management read
  // access, which is common for service principals scoped to a single
  // subscription.
  managementGroups() []azure.managementGroup
}

// Azure management group
//
// Governance container that groups subscriptions and other management
// groups, and the scope at which tenant-wide role assignments, policy
// assignments, and deny assignments are made. The `name` field is the
// group's identifier as it appears in scope paths (a GUID or a chosen
// short name), and selects the group, for example
// `azure.managementGroup(name: "mg-production")`. Role assignments and
// policy assignments made at this exact scope are reachable here, along
// with the child groups and subscriptions that inherit them, so a grant
// high in the hierarchy can be attributed to the group that carries it
// and weighed against everything underneath.
azure.managementGroup @defaults("name displayName subscriptionCount") {
  // Full resource ID of the management group
  id string
  // Management group identifier used in scope paths
  name string
  // Human-readable display name
  displayName string
  // Tenant that owns the management group
  tenantId string
  // Whether this is the tenant root group
  //
  // The root group's name equals the tenant ID and it has no parent.
  // Every subscription in the tenant sits underneath it, so an
  // assignment here is the widest possible grant.
  isRoot bool
  // Parent management group, or null for the tenant root group
  parent() azure.managementGroup
  // Direct child management groups
  children() []azure.managementGroup
  // Subscription IDs that are direct children of this management group
  //
  // Direct children only. Subscriptions nested under a child management
  // group are reached through children.
  subscriptionIds []string
  // Total number of subscriptions at or below this management group
  //
  // Counts subscriptions underneath the whole subtree, not only direct
  // children, which is the blast radius of a role or policy assignment
  // made at this scope.
  subscriptionCount int
  // Role assignments made at this management group scope
  //
  // Assignments whose scope is exactly this group, not ones it inherits
  // from a parent or ones made further down. Because a grant here is
  // inherited by every subscription in the subtree, pair this with
  // subscriptionCount to weigh its reach.
  roleAssignments() []azure.subscription.authorizationService.roleAssignment
  // Policy assignments made at this management group scope
  //
  // Assignments whose scope is exactly this group. Resolved from the
  // connected subscription's assignment list, so only assignments that
  // the subscription inherits are visible here; a sibling branch of the
  // hierarchy the subscription does not sit under will report none.
  policyAssignments() []azure.subscription.policy.assignment
}

// Microsoft Entra principal
//
// Directory object behind a role assignment: the user, group, service
// principal, application, or device that a grant was made to. Carries
// the display name and type that an object ID alone does not, plus the
// application identity behind a service principal (appId, the home
// tenant in appOwnerTenantId, and whether it is a managed identity or a
// registered application), and whether the account is still enabled.
// This is what turns "some object ID holds Owner" into an attributable
// finding, and it distinguishes a grant to a managed identity from one
// to a human or to an application owned by an outside tenant.
private azure.entraPrincipal @defaults("displayName principalType") {
  // Object ID of the directory object
  id string
  // Display name
  displayName string
  // Kind of directory object
  //
  // One of "user", "group", "servicePrincipal", "application",
  // "device", or "" when Microsoft Graph returned a type this provider
  // does not model.
  principalType string
  // User principal name, for users
  userPrincipalName string
  // Application (client) ID, for service principals and applications
  appId string
  // Tenant that owns the application behind a service principal
  //
  // Differs from the subscription's tenant for a multi-tenant
  // application or a Microsoft first-party service, so a grant to a
  // principal whose home tenant is not yours is a cross-tenant grant.
  // Empty for users, groups, and devices.
  appOwnerTenantId string
  // Service principal subtype
  //
  // One of "Application" (a registered app), "ManagedIdentity" (an
  // Azure resource identity), "Legacy", or "SocialIdp". Empty for object types other
  // than service principals. Distinguishes a workload identity from a
  // human-facing application registration.
  servicePrincipalType string
  // Whether the account is enabled
  //
  // Null for object types that carry no enabled state, such as groups.
  // A disabled account holding a privileged role is a dormant grant
  // that re-arms the moment the account is re-enabled.
  accountEnabled bool
  // Whether the group can be assigned Microsoft Entra roles
  //
  // Only meaningful for groups. A role-assignable group is a privilege
  // escalation path, because whoever can add members to it can grant
  // themselves the group's roles.
  isAssignableToRole bool
}



// Azure subscription
//
// Billing, identity, and policy container that owns every Azure
// resource accessible to the provider, and the top of the resource
// hierarchy for auditing an Azure tenant. Exposes the subscription
// state, authorization source, applied tags, managing tenants, and the
// placement, quota, and spending-limit settings in subscriptionsPolicies.
// Resource groups, individual resources, and deployments are reachable
// from here, along with per-service accessors for compute, network,
// storage, identity, Key Vault, Defender for Cloud, and every other
// modeled Azure service, letting you traverse from a subscription into
// any resource it contains.
azure.subscription @defaults ("name") {
  // Full resource identifier of the subscription
  id string
  // Name of the subscription
  name string
  // Subscription identifier
  subscriptionId string
  // Subscription tenant identifier
  tenantId string
  // List of tenants that manage the subscription
  managedByTenants []string
  // Subscription tags
  tags map[string]string
  // Subscription state
  //
  // One of Enabled, Warned, PastDue, Disabled, or Deleted.
  state string
  // Subscription authorization source
  authorizationSource string
  // Subscription placement and spending policies
  //
  // Policy settings scoped to the subscription. Keys: `locationPlacementId`
  // (the group of regions the subscription may deploy into), `quotaId`
  // (the offer or quota tier), and `spendingLimit` (one of On, Off, or
  // CurrentPeriodOff).
  subscriptionsPolicies dict
  // All resources in a subscription
  resources() []azure.subscription.resource
  // Resource groups in the subscription
  resourceGroups() []azure.subscription.resourcegroup
  // Subscription-scoped Azure Resource Manager deployments
  deployments() []azure.subscription.deployment
  // Management group ancestry of the subscription
  //
  // The chain of management groups the subscription sits under, nearest
  // parent first and the tenant root group last. This is the set of
  // scopes whose role and policy assignments the subscription inherits.
  // Empty when the credential has no Microsoft.Management read access.
  managementGroups() []azure.managementGroup
  // Resource locks in the subscription
  //
  // Every management lock at or below the subscription scope, including
  // locks on resource groups and on individual resources. A lock is the
  // control that stops a resource being deleted or modified regardless
  // of RBAC, so this is how you confirm that vaults, backup vaults, and
  // storage holding retained data cannot be removed by an operator or an
  // attacker who has gained write access.
  locks() []azure.subscription.lock
  // Compute resources in the subscription
  compute() azure.subscription.computeService
  // Batch resources in the subscription
  batch() azure.subscription.batchService
  // Databricks resources in the subscription
  databricks() azure.subscription.databricksService
  // Network resources in the subscription
  network() azure.subscription.networkService
  // Storage resources in the subscription
  storage() azure.subscription.storageService
  // Azure Files resources in the subscription, under the Microsoft.FileShares provider
  fileShares() azure.subscription.fileSharesService
  // Web resources in the subscription
  web() azure.subscription.webService
  // SQL resources in the subscription
  sql() azure.subscription.sqlService
  // MySQL resources inside the subscription
  mySql() azure.subscription.mySqlService
  // PostgreSQL resources in the subscription
  postgreSql() azure.subscription.postgreSqlService
  // Cosmos DB resources in the subscription
  cosmosDb() azure.subscription.cosmosDbService
  // Azure Key Vault resources in the subscription
  keyVault() azure.subscription.keyVaultService
  // Authorization resources in the subscription
  iam() azure.subscription.authorizationService
  // Monitor resources in the subscription
  monitor() azure.subscription.monitorService
  // Cloud defender resources in the subscription
  cloudDefender() azure.subscription.cloudDefenderService
  // AKS resources in the subscription
  aks() azure.subscription.aksService
  // Advisor resources in the subscription
  advisor() azure.subscription.advisorService
  // Policy service in the subscription
  policy() azure.subscription.policy
  // IoT resources in the subscription
  iot() azure.subscription.iotService
  // Cache resources in the subscription
  cache() azure.subscription.cacheService
  // Data Factory resources in the subscription
  dataFactory() azure.subscription.dataFactoryService
  // Synapse Analytics resources in the subscription
  synapse() azure.subscription.synapseService
  // Container Registry resources in the subscription
  containerRegistry() azure.subscription.containerRegistryService
  // Recovery Services resources in the subscription
  recoveryServices() azure.subscription.recoveryServicesService
  // Data Protection resources in the subscription
  dataProtection() azure.subscription.dataProtectionService
  // Azure Data Box resources in the subscription
  dataBox() azure.subscription.dataBoxService
  // Azure NetApp Files resources in the subscription
  netApp() azure.subscription.netAppService
  // Azure Elastic SAN resources in the subscription
  elasticSan() azure.subscription.elasticSanService
  // Azure Managed Lustre resources in the subscription
  storageCache() azure.subscription.storageCacheService
  // Azure Functions resources in the subscription
  functions() azure.subscription.functionsService
  // Service Bus resources in the subscription
  serviceBus() azure.subscription.serviceBusService
  // Service Fabric resources in the subscription
  serviceFabric() azure.subscription.serviceFabricService
  // Event Hubs resources in the subscription
  eventHub() azure.subscription.eventHubService
  // DNS resources in the subscription
  dns() azure.subscription.dnsService
  // Front Door and CDN resources in the subscription
  frontDoor() azure.subscription.frontDoorService
  // Azure Container Apps resources in the subscription
  containerApp() azure.subscription.containerAppService
  // Azure Container Instances resources in the subscription
  containerInstance() azure.subscription.containerInstanceService
  // Logic Apps resources in the subscription
  logic() azure.subscription.logicService
  // Event Grid resources in the subscription
  eventGrid() azure.subscription.eventGridService
  // API Management resources in the subscription
  apiManagement() azure.subscription.apiManagementService
  // Microsoft Purview resources in the subscription
  //
  // Data-governance accounts that classify, map, and monitor sensitive
  // data across the subscription.
  purview() azure.subscription.purviewService
  // Azure AI Search resources in the subscription
  search() azure.subscription.searchService
  // Azure Lighthouse cross-tenant delegated resource management on the subscription
  lighthouse() azure.subscription.lighthouseService
  // App Configuration resources in the subscription
  appConfiguration() azure.subscription.appConfigurationService
  // Azure AI Services / Cognitive Services resources in the subscription
  cognitiveServices() azure.subscription.cognitiveServicesService
  // Microsoft Sentinel onboarded workspaces in the subscription
  sentinel() azure.subscription.sentinelService
  // Azure Machine Learning resources in the subscription
  machineLearning() azure.subscription.machineLearningService
  // Azure SignalR Service resources in the subscription
  signalR() azure.subscription.signalRService
  // Azure Web PubSub Service resources in the subscription
  webPubSub() azure.subscription.webPubSubService
  // Azure Data Explorer (Kusto) resources in the subscription
  kusto() azure.subscription.kustoService
  // Azure Automation accounts in the subscription
  automation() azure.subscription.automationService
  // Azure Virtual Desktop resources in the subscription
  desktopVirtualization() azure.subscription.desktopVirtualizationService
}

// Azure function
private azure.subscription.webService.function @defaults("name type") {
  // ID of the function
  id string
  // Name of the function
  name string
  // Type of function
  type string
  // Kind of function
  kind string
  // Properties for the function
  properties dict
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure resource group
//
// Logical container that holds related Azure resources and defines a
// shared location, tag set, and lifecycle boundary for them. Resource
// groups anchor governance and access control: tags drive cost and
// ownership policy, location constrains where child resources may live,
// and provisioningState reports the outcome of the last management
// operation. A non-empty managedBy marks a group created and owned by
// another service (for example a managed application or cluster), which
// should not be modified directly. The deployments field lists the
// Azure Resource Manager deployments run into the group.
private azure.subscription.resourcegroup @defaults("name location") {
  // Resource group ID
  id string
  // Resource group name
  name string
  // Resource group location
  location string
  // Resource group tags
  tags map[string]string
  // Resource group type
  type string
  // ID of the resource that manages this resource group
  managedBy string
  // Resource group provisioning state
  provisioningState string
  // Azure Resource Manager deployments in the resource group
  deployments() []azure.subscription.deployment
  // Resource locks at or below this resource group
  //
  // Includes locks on the group itself and on the resources inside it.
  // Resolved from the subscription's lock list, so this costs no
  // additional API call.
  locks() []azure.subscription.lock
}

// Azure resource lock
//
// Management lock that blocks deletion, or all modification, of the
// scope it is applied to. Locks sit outside RBAC: they apply to every
// principal including subscription owners, which makes them the last
// line of defense for data that must survive a compromised or mistaken
// operator. The `level` field says which operations are blocked and
// `scope` says what the lock protects, so an audit can check that
// backup vaults, recovery services vaults, key vaults, and storage
// holding retained data all carry one.
private azure.subscription.lock @defaults("name level scope") {
  // Full resource ID of the lock
  id string
  // Lock name
  name string
  // Lock resource type
  type string
  // Operations the lock blocks
  //
  // One of "CanNotDelete" (the scope can be read and modified but not
  // deleted), "ReadOnly" (the scope can only be read, which also blocks
  // deletion), or "NotSpecified". ReadOnly is the stronger of the two
  // and can break operations that write resource state.
  level string
  // Notes recorded on the lock explaining why it exists
  notes string
  // Application IDs of the lock owners
  owners []string
  // Resource ID the lock applies to
  //
  // The subscription, resource group, or resource the lock protects,
  // derived by stripping the lock's own provider path from its ID. A
  // subscription-level lock reports the subscription ID, so a lock's
  // reach is read from how deep this path goes.
  scope string
}

// Azure resource
//
// Generic Azure Resource Manager inventory record for a single resource in a
// subscription, covering resources of every type (compute, storage, networking,
// and so on) in one uniform shape. Useful for cross-cutting audits: locating
// resources by tags, location, or type, checking provisioningState, or reviewing
// the managed identity attached through identity. Deep, type-specific properties
// are not populated on this record; query the dedicated resource for a given type
// when you need those.
private azure.subscription.resource @defaults("id name location") {
  // Azure Monitor diagnostic settings on the resource
  //
  // Which logs and metrics the resource emits, and where they are sent.
  // Empty when the resource has none configured, which is the state a
  // "logging is enabled" check is looking for. Reported per resource, so a
  // sweep can ask the same question of every service that supports
  // diagnostic settings rather than only the few with a dedicated field.
  //
  // This costs one request per resource it is read from, so narrow the set
  // first, for example
  // `resources.where(type == "Microsoft.Databricks/workspaces")`.
  diagnosticSettings() []azure.subscription.monitorService.diagnosticsetting
  // Resource ID
  id string
  // Resource name
  name string
  // Resource kind
  kind string
  // Resource location
  location string
  // Resource tags
  tags map[string]string
  // Resource type
  type string
  // ID of the resource that manages this resource
  managedBy string
  // Resource SKU
  //
  // Deprecated in favor of skuData, which carries the SKU members as
  // typed fields.
  sku @maturity("deprecated") @replaced_by("azure.subscription.resource.skuData") dict
  // Billable SKU the resource is provisioned at
  skuData azure.subscription.resourceSku
  // Resource plan
  //
  // Azure Marketplace purchase plan for resources deployed from a Marketplace
  // offer, with keys name (plan ID), product (offer ID), publisher,
  // promotionCode, and version.
  plan dict
  // Resource identity
  //
  // Deprecated in favor of resourceIdentity, which carries the managed
  // identity members as typed fields.
  identity @maturity("deprecated") @replaced_by("azure.subscription.resource.resourceIdentity") dict
  // Managed identity attached to the resource
  resourceIdentity azure.subscription.resourceIdentity
  // Resource provisioning state
  provisioningState string
  // When the resource was created
  createdTime time
  // When the resource was last changed
  changedTime time
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure Resource Manager system metadata
//
// Creation and last-modification provenance that Azure Resource Manager
// records for a resource: the identity that created it, the identity that
// last modified it, the type of each identity, and the corresponding
// timestamps. Answers "who created this resource and when" across the
// resources that report system metadata.
private azure.subscription.systemData @defaults("createdBy createdAt lastModifiedBy lastModifiedAt") {
  // Identity that created the resource (object ID, user principal name, or application ID)
  createdBy string
  // Type of identity that created the resource
  //
  // One of User, Application, ManagedIdentity, or Key.
  createdByType string
  // When the resource was created
  createdAt time
  // Identity that last modified the resource (object ID, user principal name, or application ID)
  lastModifiedBy string
  // Type of identity that last modified the resource
  //
  // One of User, Application, ManagedIdentity, or Key.
  lastModifiedByType string
  // When the resource was last modified
  lastModifiedAt time
}

// Azure Resource Manager deployment
//
// Azure Resource Manager template deployment, the unit that provisions or
// updates a set of resources from a template. The deployment reports its
// provisioning state and completion timestamp, the deployment mode, the
// template and parameters used, the resources it produced through
// `provisionedResources`, the validation findings it carried in
// `diagnostics`, and the `correlationId` that links it to the activity log
// events it generated. Query this to trace which deployment created or last
// changed a group of resources.
private azure.subscription.deployment @defaults("name provisioningState timestamp") {
  // Deployment ID
  id string
  // Deployment name
  name string
  // Deployment type
  type string
  // Deployment location
  location string
  // Deployment tags
  tags map[string]string
  // Provisioning state
  //
  // Typical values are Accepted, Running, Succeeded, Failed, and Canceled.
  provisioningState string
  // When the deployment finished
  timestamp time
  // Duration of the deployment, as an ISO 8601 duration (for example PT1M30S)
  duration string
  // Correlation identifier shared with the activity log events for this deployment
  correlationId string
  // Deployment mode
  //
  // One of Incremental or Complete.
  mode string
  // Hash produced for the deployed template
  templateHash string
  // What the deployment recorded in its debug log
  //
  // One of requestContent, responseContent, or both joined by a comma.
  // Empty when debug logging is off, which is the safe setting: the
  // debug log is retained with the deployment and readable by anyone
  // who can read the deployment history, so a deployment that logged
  // request content has persisted whatever secrets its parameters
  // carried.
  debugDetailLevel string
  // Deployment run if this one fails
  //
  // One of LastSuccessful or SpecificDeployment, naming what Azure
  // redeploys on failure. Empty when no rollback deployment is
  // configured.
  onErrorDeploymentType string
  // Name of the deployment redeployed on failure
  //
  // Set when onErrorDeploymentType is SpecificDeployment.
  onErrorDeploymentName string
  // How thoroughly the template was validated before deploying
  //
  // One of Template, Provider, or ProviderNoRbac. ProviderNoRbac skips
  // the permission checks the other levels run, so a deployment
  // validated at that level was not tested against the identity's
  // actual access.
  validationLevel string
  // URI of the linked template, when the deployment used one
  //
  // Deprecated in favor of template, which carries the URI alongside the
  // Template Spec ID and content version of the same template.
  templateLink @maturity("deprecated") string
  // Template the deployment ran
  //
  // Where the deployment got its template from. Null when the template was
  // supplied inline with the deployment request rather than linked.
  template azure.subscription.deployment.templateSource
  // URI of the linked parameters file, without its query string
  //
  // Null when the parameters were supplied inline with the deployment
  // request. The query string is removed because a parameters file held in
  // blob storage is linked with the SAS token that reads it.
  parametersLink string
  // Parameters supplied to the deployment
  //
  // Keys are parameter names. Each value is an object holding either a
  // `value` with the supplied value, or a `reference` pointing at a Key
  // Vault secret (with `keyVault` and `secretName`) for secure parameters.
  parameters dict
  // Output values produced by the deployment
  //
  // Keys are output names as declared in the template's outputs section.
  // Each value is an object with a `type` and the resolved `value`.
  outputs dict
  // Resource providers used by the deployment
  //
  // Each entry describes a registered Azure resource provider, with `id`,
  // `namespace`, `registrationState`, `registrationPolicy`, and a
  // `resourceTypes` list of the provider's resource types.
  providers []dict
  // IDs of the resources provisioned or updated by the deployment
  //
  // Deprecated in favor of provisionedResources, which carries the resource
  // type and API version of each entry alongside its ID.
  outputResources @maturity("deprecated") []string
  // Resources the deployment provisioned or updated
  //
  // One entry per resource the deployment produced, carrying the resource
  // type and the API version the template was written against as well as
  // the ID.
  provisionedResources []azure.subscription.deployment.provisionedResource
  // Findings Azure Resource Manager raised while validating the template
  //
  // Retained on the deployment after it finished. A deployment can report a
  // provisioningState of Succeeded while carrying Error level findings, so
  // the level of each entry says whether the deployment went ahead over a
  // validation failure. Empty when validation raised nothing.
  diagnostics []azure.subscription.deployment.diagnostic
  // Deployment extensions the template used
  //
  // Extensions provision resources outside Azure Resource Manager, so this
  // is the set of external systems the deployment reached into. Empty for a
  // template that deploys only Azure resources.
  extensions []azure.subscription.deployment.extension
  // Dependency graph the deployment resolved from the template
  //
  // Each entry names a resource the deployment waited on, with the
  // resources that entry in turn waited on under dependsOn. Empty when the
  // template declared no dependencies.
  dependencies []azure.subscription.deployment.dependency
  // Error details when the deployment failed
  //
  // Null on a successful deployment. When present, an object with `code`,
  // `message`, `target`, a nested `details` list of the same shape, and
  // `additionalInfo` entries carrying `type` and `info`.
  error dict
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Source of the template an Azure Resource Manager deployment ran
//
// Where a linked deployment template came from. A deployment naming a
// Template Spec ran a versioned artifact held in the subscription, where one
// naming a URI ran whatever that location served at the time, so this is the
// distinction a check on how infrastructure reaches production is looking
// for. The query string of the URI is not reported: it carries the SAS token
// the template was fetched with.
private azure.subscription.deployment.templateSource @defaults("templateSpecId uri contentVersion") {
  // Resource ID of the Template Spec the template came from
  //
  // Null when the template was linked by URI instead.
  templateSpecId string
  // URI the template was fetched from, without its query string
  //
  // Null when the template came from a Template Spec instead. The query
  // string is removed because a template held in blob storage is linked
  // with the SAS token that reads it.
  uri string
  // Content version the linked template had to match
  //
  // Null when the deployment accepted whatever version the link resolved to.
  contentVersion string
  // Path of the template relative to its parent
  //
  // Set on a nested deployment whose template was resolved relative to the
  // parent template, either inside a Template Spec or under the parent URI.
  relativePath string
}

// Resource provisioned by an Azure Resource Manager deployment
//
// A single resource the deployment created or updated, as the deployment
// recorded it. The `apiVersion` field is the API contract the template was
// written against, which is what an audit checks when a setting can only be
// expressed from a given version onwards.
private azure.subscription.deployment.provisionedResource @defaults("id resourceType apiVersion") {
  // Full Azure resource ID
  id string
  // Azure resource type, for example Microsoft.Storage/storageAccounts
  resourceType string
  // API version the resource was deployed with
  apiVersion string
  // Symbolic names leading to the resource in the deployment template
  //
  // Outermost first, walking through nested deployments and the extension
  // the resource was deployed with. Empty when the template used no
  // symbolic names.
  symbolicNamePath []string
  // Identifiers for a resource deployed through an extension
  //
  // Null for a resource deployed directly through Azure Resource Manager.
  // Keys and values are defined by the extension.
  identifiers dict
  // Deployment extension that provisioned the resource
  //
  // Null for a resource deployed directly through Azure Resource Manager.
  extension azure.subscription.deployment.extension
}

// Finding raised while validating an Azure Resource Manager deployment
//
// One diagnostic that Azure Resource Manager recorded while validating the
// deployment template, retained on the deployment after it finished. The
// `level` field separates a finding that stopped nothing from one the
// deployment proceeded over.
private azure.subscription.deployment.diagnostic @defaults("level code message") {
  // Severity of the finding
  //
  // One of Error, Warning, or Info.
  level string
  // Code identifying the kind of finding
  code string
  // Description of the finding
  message string
  // Element of the template the finding applies to
  target string
  // Structured detail carried with the finding
  //
  // Each entry has a `type` naming the detail's schema and an `info` object
  // holding it.
  additionalInfo []dict
}

// Extension used by an Azure Resource Manager deployment
//
// An extension lets a deployment template provision resources outside Azure
// Resource Manager, so an extension on a deployment names an external system
// the template reached into. The extension's configuration values are not
// reported; `configHash` identifies a configuration without disclosing it.
private azure.subscription.deployment.extension @defaults("name version alias") {
  // Extension name
  name string
  // Extension version
  version string
  // Alias the deployment template refers to the extension by
  alias string
  // Configuration ID identifying the deployment target within the extension
  configId string
  // Hash of the extension configuration
  //
  // Distinguishes configurations that share a configId.
  configHash string
}

// Dependency resolved by an Azure Resource Manager deployment
//
// One resource the deployment waited on before provisioning the resource
// that declared it, with the resources it waited on in turn under
// `dependsOn`.
private azure.subscription.deployment.dependency @defaults("resourceName resourceType") {
  // Full Azure resource ID of the dependency
  id string
  // Name of the dependency resource
  resourceName string
  // Type of the dependency resource
  resourceType string
  // Resources this dependency itself waited on
  dependsOn []azure.subscription.deployment.dependency
}

// Azure Compute
private azure.subscription.computeService {
  // Subscription identifier
  subscriptionId string
  // All compute instances under a subscription
  vms() []azure.subscription.computeService.vm
  // All the disks under a subscription
  disks() []azure.subscription.computeService.disk
  // All disk encryption sets under a subscription
  diskEncryptionSets() []azure.subscription.computeService.diskEncryptionSet
  // All disk access resources under a subscription
  diskAccesses() []azure.subscription.computeService.diskAccess
  // All managed disk snapshots under a subscription
  snapshots() []azure.subscription.computeService.snapshot
  // All Virtual Machine Scale Sets under a subscription
  vmScaleSets() []azure.subscription.computeService.vmScaleSet
  // All dedicated host groups under a subscription
  dedicatedHostGroups() []azure.subscription.computeService.dedicatedHostGroup
  // All proximity placement groups under a subscription
  proximityPlacementGroups() []azure.subscription.computeService.proximityPlacementGroup
  // All managed images under a subscription
  images() []azure.subscription.computeService.image
  // All Compute Galleries (Shared Image Galleries) under a subscription
  galleries() []azure.subscription.computeService.gallery
  // All Azure Arc-enabled servers (Microsoft.HybridCompute/machines) under a subscription
  hybridMachines() []azure.subscription.computeService.hybridMachine
}

// Azure virtual machine
//
// Virtual machine and the security-relevant configuration around it:
// the VM size, OS profile, storage profile (OS and data disks), network
// profile and attached network interfaces, identity assignments, applied
// tags, the availability/zone/proximity-placement-group placement, the
// boot diagnostics and security profile (TrustedLaunch / ConfidentialVM,
// SecureBoot, vTPM), the extensions installed on the VM, OS patching
// state, and the deployed extensions for ASC, Defender, and guest
// configuration.
azure.subscription.computeService.vm @defaults("name location properties.hardwareProfile.vmSize properties.storageProfile.osDisk.osType") {
  // VM ID
  id string
  // VM name
  name string
  // VM location
  location string
  // VM zones
  zones []string
  // VM state
  state() string
  // Whether the VM is running
  isRunning() bool
  // VM tags
  tags map[string]string
  // VM type
  type string
  // VM properties
  properties dict
  // VM image reference (marketplace publisher/offer/sku/version, or direct gallery image ID)
  imageReference azure.subscription.computeService.vm.imageReference
  // Whether boot diagnostics is enabled on the VM
  bootDiagnosticsEnabled bool
  // Boot diagnostics storage URI; empty when boot diagnostics writes to platform-managed storage
  bootDiagnosticsStorageUri string
  // Base64-encoded user data passed to the VM at provisioning time (cloud-init equivalent)
  //
  // Empty when no user data is set. Treat as sensitive: secrets and bootstrap credentials are sometimes embedded here.
  userData() string
  // VM extension
  extensions() []dict
  // Whether the Microsoft Defender for Endpoint (MDE) extension is installed on the VM
  mdeInstalled() bool
  // Whether the Azure Monitor Agent (AMA) extension is installed on the VM
  amaInstalled() bool
  // Whether the legacy Microsoft Monitoring Agent (OMS) extension is installed on the VM
  omsInstalled() bool
  // Whether the Dependency Agent extension (used by VM Insights for service-map data) is installed on the VM
  dependencyAgentInstalled() bool
  // Whether the Azure Disk Encryption (ADE) extension is installed on the VM
  //
  // ADE encrypts the OS and data disks from inside the guest using BitLocker
  // (Windows) or dm-crypt (Linux). A true result indicates the encryption
  // extension is present; it is distinct from `encryptionAtHost` (platform-side
  // encryption of the VM host) and from server-side disk encryption set on the
  // managed disk itself.
  adeInstalled() bool
  // VM compute disk
  osDisk() azure.subscription.computeService.disk
  // VM compute data disk
  dataDisks() []azure.subscription.computeService.disk
  // VM network interfaces (NICs) attached via the VM's networkProfile
  networkInterfaces() []azure.subscription.networkService.interface
  // VM public IP addresses
  publicIpAddresses() []azure.subscription.networkService.ipAddress
  // Whether encryption at host is enabled for all VM disks
  encryptionAtHost bool
  // Security type of the VM ("ConfidentialVM", "TrustedLaunch", or "Standard")
  securityType string
  // Whether UEFI Secure Boot is enabled
  secureBootEnabled bool
  // Whether virtual Trusted Platform Module (vTPM) is enabled
  vtpmEnabled bool
  // Whether ProxyAgent is enabled on the VM
  proxyAgentEnabled bool
  // ProxyAgent execution mode ("Audit", "Enforce")
  proxyAgentMode string
  // Whether to implicitly install the ProxyAgent extension (Linux only)
  proxyAgentAddExtension bool
  // Whether FIPS 140-3 compliant cryptography is enabled for extension protectedSettings
  fipsEncryptionEnabled bool
  // Resiliency profile (zone movement configuration)
  resiliencyProfile dict
  // Scheduled-events policy (UserInitiatedReboot, UserInitiatedRedeploy, additional publishing targets)
  scheduledEventsPolicy dict
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
  // VM computer name (OS hostname)
  computerName string
  // VM admin username
  adminUsername string
  // Azure Hybrid Benefit license type
  //
  // Null if using standard Azure licensing. Possible values: "Windows_Client", "Windows_Server", "RHEL_BYOS", "SLES_BYOS".
  licenseType string
  // ID of the resource that manages this VM (e.g. VMSS ARM resource ID)
  managedBy string
  // Unique 128-bit VM identifier
  vmId string
  // Provisioning state of the VM (e.g. Succeeded, Failed, Creating, Updating, Deleting)
  provisioningState string
  // When the VM was created
  timeCreated time
  // SSH public keys configured on the Linux VM
  //
  // Each entry carries the `path` the key is installed to, the raw
  // `keyData`, and the `algorithm` (for example ssh-rsa,
  // ecdsa-sha2-nistp256, ssh-ed25519) plus key size in `bits` parsed
  // from the key data. Empty for Windows or password-authentication VMs.
  sshPublicKeys []dict
  // Whether password authentication is disabled for SSH on the Linux VM
  disablePasswordAuthentication bool
  // Operating system type of the OS disk ("Linux" or "Windows")
  osType string
  // Whether the VM agent is provisioned (Linux/Windows)
  provisionVMAgent bool
  // Whether automatic OS upgrades by the platform are enabled (WindowsConfiguration.EnableAutomaticUpdates)
  enableAutomaticUpdates bool
  // Patch mode for the OS ("Manual", "AutomaticByOS", "AutomaticByPlatform", "ImageDefault")
  patchMode string
  // Whether extension operations are permitted on the VM
  //
  // Extensions run inside the guest as root or SYSTEM, so while this is true
  // a caller who can write to the VM resource can execute code on the host
  // without holding any guest credential. Null when the VM reports no OS
  // profile.
  allowExtensionOperations bool
  // Whether the VM waits for a provisioning signal from the guest agent; null when the VM reports no OS profile
  requireGuestProvisionSignal bool
  // Whether a WinRM HTTP listener is configured on the Windows VM
  //
  // An HTTP listener carries the remote PowerShell session, and the
  // credentials that open it, with no transport encryption. Null on a VM that
  // reports no Windows configuration.
  winRmHttpListenerEnabled bool
  // Whether a WinRM HTTPS listener is configured on the Windows VM
  //
  // Null on a VM that reports no Windows configuration.
  winRmHttpsListenerEnabled bool
  // Key Vaults supplying the certificates installed into the guest
  //
  // Empty when the VM installs no Key Vault certificates.
  certificateSourceVaults() []azure.subscription.keyVaultService.vault
  // User-assigned managed identity Azure Disk Encryption uses to reach Key Vault; null when not configured
  encryptionIdentity() azure.subscription.managedIdentity
  // Virtual Machine Scale Set that manages this VM, if any (resolved from managedBy)
  vmScaleSet() azure.subscription.computeService.vmScaleSet
  // Managed identity configuration (type, system- and user-assigned identities)
  //
  // Deprecated in favor of resourceIdentity, which carries the managed
  // identity members as typed fields.
  identity @maturity("deprecated") @replaced_by("azure.subscription.computeService.vm.resourceIdentity") dict
  // Managed identity attached to the resource
  resourceIdentity azure.subscription.resourceIdentity
  // Principal ID of the VM's system-assigned managed identity; empty when no system-assigned identity is enabled
  principalId string
  // System-assigned managed identity of the VM; null when no system-assigned identity is enabled
  //
  // Exposes the system-assigned identity as a managed identity so its role
  // assignments, and their role definitions and permissions, can be traversed.
  // This completes the resource-to-privilege leg of an attack path from an
  // internet-reachable VM to what its identity is authorized to do.
  systemAssignedIdentity() azure.subscription.managedIdentity
  // User-assigned managed identities attached to the VM
  userAssignedIdentities() []azure.subscription.managedIdentity
  // Internet-exposure summary combining public IPs and NSG ingress rules
  //
  // Reports whether the VM is reachable from the public internet by checking for
  // an assigned public IP and whether the effective network security group
  // chain admits inbound traffic from any source. Inbound traffic must be
  // admitted by every NSG in the chain (subnet-level and NIC-level), and rule
  // priority is honored so a higher-priority Deny that shadows an Allow closes
  // the exposure.
  exposure() azure.subscription.networkService.exposure
}

// Azure VM image reference
//
// Image a VM was deployed from. For marketplace images the `publisher`,
// `offer`, `sku`, and `version` are populated. For
// shared / community / direct gallery images, `imageId`,
// `sharedGalleryImageId`, or `communityGalleryImageId` carries the
// gallery resource path. `exactVersion` resolves the concrete version
// when `version` was specified as `"latest"`. Audit queries typically
// check `version != "latest"` to enforce pinning, or flag deployments
// against unapproved publishers.
private azure.subscription.computeService.vm.imageReference @defaults("publisher offer sku version") {
  // Image publisher (marketplace images; empty for gallery images)
  publisher string
  // Image offer (marketplace images; empty for gallery images)
  offer string
  // Image SKU (marketplace images; empty for gallery images)
  sku string
  // Image version (marketplace or shared-gallery images); `"latest"` indicates the platform picks the newest at deploy time
  version string
  // Resolved concrete version when `version` was `"latest"` at deploy time; empty otherwise
  exactVersion string
  // Direct image resource ID (managed image or shared gallery); empty when deployed from a marketplace image
  imageId string
  // Shared-gallery image unique ID; empty when not deployed from a shared gallery
  sharedGalleryImageId string
  // Community-gallery image unique ID; empty when not deployed from a community gallery
  communityGalleryImageId string
}

// Azure Arc-enabled server
//
// Azure Arc-enabled server (Microsoft.HybridCompute/machines), an
// on-premises or other-cloud machine projected into Azure for
// management. Surfaces the agent status (AwaitingConnection, Connected,
// Disconnected, Error), agent version, OS name and version, last status check,
// machine identity, attached extensions, private link scope, and the
// `cloudMetadata` describing the underlying environment when the
// machine is hosted on AWS, GCP, VMware, or another cloud.
azure.subscription.computeService.hybridMachine @defaults("name location osName osVersion status") {
  // ARM resource ID
  id string
  // Machine name (Azure resource name)
  name string
  // Location
  location string
  // Tags
  tags map[string]string
  // ARM resource type (Microsoft.HybridCompute/machines)
  type string
  // Connection status of the Arc agent
  //
  // One of AwaitingConnection, Connected, Disconnected, or Error.
  status string
  // Last time the Arc agent reported in
  lastStatusChange time
  // Connected Machine agent version
  agentVersion string
  // OS name reported by the agent (e.g. "windows", "linux")
  osName string
  // OS product SKU (e.g. "Windows Server 2019 Datacenter")
  osSku string
  // OS edition (e.g. "Datacenter", "Standard")
  osEdition string
  // OS version reported by the agent
  osVersion string
  // OS type as Azure classifies it ("Windows" / "Linux")
  osType string
  // Azure-side display name for the machine
  displayName string
  // Hybrid machine FQDN
  machineFqdn string
  // DNS-resolvable FQDN
  dnsFqdn string
  // AD domain the machine is joined to (Windows only)
  domainName string
  // AD fully qualified display name
  adFqdn string
  // Hybrid machine unique ID (Arc-assigned)
  vmId string
  // Arc Machine's unique SMBIOS UUID
  vmUuid string
  // Provisioning state of the ARM resource
  provisioningState string
  // Resource ID of the parent Azure HCI cluster, if any
  parentClusterResourceId string
  // Resource ID of the private link scope this machine is assigned to, if any
  privateLinkScopeResourceId string
  // Key store protecting the Arc agent's identity private key
  //
  // One of Default or TPM. Default keeps the key in a software key store on
  // disk, where anyone who can read the file can replay the machine's identity
  // to Azure. TPM binds the key to the hardware security module.
  identityKeyStore string
  // TPM endorsement key certificate reported by the agent
  tpmEkCertificate string
  // Reason the service set the machine status to its current value
  //
  // Currently the only value is Cloned, which Azure sets when it detects that
  // this machine is a clone of another onboarded machine. Two machines sharing
  // one Arc identity is otherwise invisible.
  statusReason string
  // Firmware type reported by the agent (for example UEFI or BIOS)
  firmwareType string
  // Firmware serial number reported by the agent
  firmwareSerialNumber string
  // Total number of CPU sockets available on the machine
  numberOfCpuSockets int
  // Total physical memory on the machine, in bytes
  totalPhysicalMemoryInBytes int
  // Physical processors reported by the agent
  //
  // Each entry carries the processor name and the number of cores.
  processors []dict
  // Disks attached to the machine
  //
  // Each entry carries the disk id, generatedId, name, diskType, and
  // maxSizeInBytes as reported by the agent.
  disks []dict
  // Detected agent-reported properties (azureResourceId, manufacturer, model, etc.)
  detectedProperties map[string]string
  // Detected cloud environment metadata (Azure/GCP/AWS/OCI provider, account, region) when applicable
  cloudMetadata dict
  // Windows license / ESU attestation profile
  licenseProfile dict
  // Raw HybridCompute machine properties
  properties dict
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
  // Installed Arc machine extensions
  extensions() []azure.subscription.computeService.hybridMachine.extension
}

// Extension installed on an Azure Arc-enabled server (Microsoft.HybridCompute/machines/extensions)
private azure.subscription.computeService.hybridMachine.extension @defaults("name extensionType publisher provisioningState") {
  // ARM resource ID
  id string
  // Extension name
  name string
  // ARM resource type (Microsoft.HybridCompute/machines/extensions)
  type string
  // Geo-location
  location string
  // Resource tags
  tags map[string]string
  // Extension handler publisher (e.g. "Microsoft.Azure.Monitor")
  publisher string
  // Extension type (e.g. "AzureMonitorLinuxAgent")
  extensionType string
  // Version of the extension handler
  typeHandlerVersion string
  // Whether the extension uses a newer minor version if one is available at deployment time
  autoUpgradeMinorVersion bool
  // Whether the platform automatically upgrades the extension to a newer version
  enableAutomaticUpgrade bool
  // Provisioning state of the extension
  provisioningState string
  // Public JSON settings passed to the extension handler
  settings dict
  // Tag used to trigger a re-run of the extension handler even when settings are unchanged
  forceUpdateTag string
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
  // Latest extension instance view reported by the handler (status code, level, display status, message)
  instanceView dict
}

// Azure managed disk
//
// Managed disk attached to a VM, scale set, or
// available for attachment. Surfaces the disk SKU and tier, OS type,
// disk size and IOPS, the disk state (Unattached, Attached, Reserved,
// ActiveSAS, ReadyToUpload, ActiveUpload, ActiveSASFrozen, Frozen),
// encryption settings
// (platform-managed, customer-managed via diskEncryptionSet, or
// double-encryption), network access policy, public network access,
// the source from which the disk was created, and any attached VM.
azure.subscription.computeService.disk @defaults("name location properties.osType properties.diskSizeGB properties.diskState") {
  // Disk resource ID
  id string
  // Disk resource name
  name string
  // Disk resource location
  location string
  // Disk resource tags
  tags map[string]string
  // Disk resource type
  type string
  // A relative URI containing the ID of the VM that has the disk attached
  managedBy string
  // List of relative URIs containing the IDs of the VMs that have the disk attached
  managedByExtended []string
  // The logical zone list for disk
  zones []string
  // Disk SKU
  //
  // Deprecated in favor of skuData, which carries the SKU members as
  // typed fields.
  sku @maturity("deprecated") @replaced_by("azure.subscription.computeService.disk.skuData") dict
  // Billable SKU the resource is provisioned at
  skuData azure.subscription.resourceSku
  // Disk resource properties
  properties dict
  // Disk network access policy (AllowAll, AllowPrivate, DenyAll)
  networkAccessPolicy string
  // Whether public network access is enabled for the disk
  publicNetworkAccess string
  // Disk encryption type (EncryptionAtRestWithPlatformKey, EncryptionAtRestWithCustomerKey, EncryptionAtRestWithPlatformAndCustomerKeys)
  encryptionType string
  // ID of the disk encryption set used for customer-managed key encryption
  diskEncryptionSetId string
  // Disk encryption set used for customer-managed key encryption
  diskEncryptionSet() azure.subscription.computeService.diskEncryptionSet
  // Whether Azure Disk Encryption (ADE) is enabled on the disk
  //
  // True when guest-based encryption settings (BitLocker / dm-crypt, keyed
  // through Key Vault) are configured on the disk. This is independent of
  // `encryptionType`, which describes server-side encryption at rest with a
  // platform or customer-managed key.
  encryptionSettingsEnabled bool
  // Version of the guest encryption settings schema
  //
  // Either 1.0 or 1.1, recording which Azure Disk Encryption generation
  // configured the disk. Empty when encryptionSettingsEnabled is false.
  encryptionSettingsVersion string
  // Confidential or trusted-launch protection applied to the disk
  //
  // One of TrustedLaunch, ConfidentialVM_VMGuestStateOnlyEncryptedWithPlatformKey,
  // ConfidentialVM_DiskEncryptedWithPlatformKey,
  // ConfidentialVM_DiskEncryptedWithCustomerKey, or
  // ConfidentialVM_NonPersistedTPM. Empty on an ordinary disk. This is
  // what separates a Confidential VM's disk, whose contents are opaque
  // to the host, from a normal one that only has encryption at rest.
  securityType string
  // Confidential VM guest state version
  //
  // Either V1 or V2. Empty unless securityType names a Confidential VM
  // protection level.
  confidentialVmVersion string
  // Disk encryption set protecting the confidential VM guest state
  //
  // Set only when securityType is
  // ConfidentialVM_DiskEncryptedWithCustomerKey, where the guest state
  // blob is encrypted with a customer-managed key rather than a
  // platform one. Null on every other disk.
  secureVmDiskEncryptionSet() azure.subscription.computeService.diskEncryptionSet
  // Operating system the disk holds (Windows, Linux)
  //
  // Empty for a data disk, which carries no operating system.
  osType string
  // Provisioned size of the disk in GiB
  //
  // The size requested when the disk was created. diskSizeBytes reports
  // the exact allocated size, which can differ.
  diskSizeGB int
  // Whether the disk is tuned for frequent attach and detach
  //
  // True for data disks that are repeatedly moved between virtual
  // machines, which improves reliability at the cost of a longer
  // initial detach.
  optimizedForFrequentAttach bool
  // Data access authentication mode (AzureActiveDirectory, None)
  dataAccessAuthMode string
  // Current state of the disk (Unattached, Attached, Reserved, ActiveSAS, ReadyToUpload, ActiveUpload, ActiveSASFrozen, Frozen)
  diskState string
  // Provisioning state of the disk
  provisioningState string
  // When the disk was created
  timeCreated time
  // Unique identifier of the disk (128-bit GUID)
  uniqueId string
  // Whether on-demand bursting is enabled for the disk
  burstingEnabled bool
  // Exact size of the disk in bytes
  diskSizeBytes int
  // Number of IOPS allowed for read/write operations
  diskIopsReadWrite int
  // Bandwidth in MB/s allowed for read/write operations
  diskMbpsReadWrite int
  // Number of IOPS allowed for read-only operations on shared disks
  diskIopsReadOnly int
  // Bandwidth in MB/s allowed for read-only operations on shared disks
  diskMbpsReadOnly int
  // Maximum number of VMs that can attach to the disk concurrently
  maxShares int
  // Hyper-V generation of the disk (V1, V2)
  hyperVGeneration string
  // Performance tier of the disk (P1, P2, P3, P4, P6, P10, P15, P20, P30, P40, P50, P60, P70, P80)
  tier string
  // Whether the disk supports hibernation
  supportsHibernation bool
  // ARM ID of the DiskAccess resource for private endpoint access
  diskAccessId string
  // Behavior when the disk experiences slow I/O (AutomaticReattach)
  availabilityPolicy dict
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure disk encryption set
