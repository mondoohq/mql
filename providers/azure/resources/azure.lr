}

// Azure Managed HSM pool
//
// Single-tenant, FIPS 140-2 Level 3 validated hardware security module
// pool for cryptographic key storage, provisioned separately from
// standard Key Vaults. Query it to audit who holds local HSM admin
// rights (initialAdminObjectIds), whether soft-delete and
// purge-protection guard against key loss, and how network reach is
// restricted (publicNetworkAccess and networkAcls). Data-plane key
// access is governed by Managed HSM local RBAC, distinct from the
// management-plane permission that lists the pool.
azure.subscription.keyVaultService.managedHsm @defaults("name location") {
  // Managed HSM ID
  id string
  // Managed HSM name
  name string
  // Managed HSM location
  location string
  // Managed HSM tags
  tags map[string]string
  // Managed HSM type
  type string
  // SKU name (Standard_B1, Custom_B32, Custom_B6, Custom_C10, Custom_C42)
  skuName string
  // HSM URI
  hsmUri string
  // Tenant ID
  tenantId string
  // Initial admin object IDs
  initialAdminObjectIds []string
  // Whether soft delete is enabled
  enableSoftDelete bool
  // Whether purge protection is enabled
  enablePurgeProtection bool
  // Soft delete retention in days (7-90)
  softDeleteRetentionInDays int
  // Public network access setting
  publicNetworkAccess string
  // Inbound network rule set
  //
  // Deprecated in favor of networkRuleSet.
  networkAcls @maturity("deprecated") @replaced_by("azure.subscription.keyVaultService.managedHsm.networkRuleSet") dict
  // Inbound network rule set
  //
  // The IP, virtual-network and service-tag rules that decide which
  // callers reach the pool, and the default action applied when none of
  // them matches. Null when the pool sets no rules, which leaves it
  // reachable from anywhere its publicNetworkAccess allows.
  networkRuleSet() azure.subscription.keyVaultService.managedHsm.networkRuleSet
  // Provisioning state
  provisioningState string
  // Scheduled purge date (if soft-deleted)
  scheduledPurgeDate time
  // Geo-replicated regions
  regions []dict
  // Private endpoint connections
  privateEndpointConnections() []azure.subscription.privateEndpointConnection
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
  // Cryptographic keys stored in the Managed HSM pool
  //
  // Keys held in the hardware security module, each exposing its key
  // type, key size, and elliptic curve. Reading keys requires
  // data-plane access to the HSM (a Managed HSM local RBAC role such as
  // "Managed HSM Crypto User"), which is separate from the
  // management-plane permission that lists the pool.
  keys() []azure.subscription.keyVaultService.key
  // Microsoft Entra role assignments granting management-plane access to the pool
  //
  // The effective role assignments at the pool scope, including those
  // inherited from the resource group, subscription, and management-group
  // ancestors. These govern the management plane (who can read, configure,
  // and delete the pool). Data-plane key access is governed separately by
  // Managed HSM local RBAC, which is not part of Azure Resource Manager and
  // does not appear here; initialAdminObjectIds names its bootstrap
  // administrators.
  roleAssignments() []azure.subscription.authorizationService.roleAssignment
}

// Azure Key Vault vault
//
// Managed store for cryptographic keys, secrets, and certificates that
// backs application encryption and TLS across Azure workloads. Query it
// to audit the authorization model (rbacAuthorizationEnabled versus
// accessPolicies), data-protection guarantees (enableSoftDelete,
// enablePurgeProtection, and softDeleteRetentionInDays), network
// exposure (publicNetworkAccess and networkAcls), and the keys,
// secrets, and certificates it holds. The skuName distinguishes
// standard vaults from premium, where premium adds HSM-backed keys.
private azure.subscription.keyVaultService.vault @defaults("vaultName type vaultUri location") {
  // Vault ID
  id string
  // Vault name
  vaultName string
  // Vault type
  type string
  // Vault location
  location string
  // Vault tags
  tags map[string]string
  // Vault URL
  vaultUri() string
  // Raw vault properties
  //
  // The unprocessed vault property bag from Azure Resource Manager,
  // with keys including `sku`, `tenantId`, `enableRbacAuthorization`,
  // `enableSoftDelete`, `enablePurgeProtection`, `enabledForDeployment`,
  // `enabledForDiskEncryption`, `enabledForTemplateDeployment`,
  // `publicNetworkAccess`, `networkAcls`, and `accessPolicies`. Most
  // values are also exposed as dedicated fields on this resource
  // (skuName, rbacAuthorizationEnabled, accessPolicies, networkAcls);
  // prefer those for audits.
  properties() dict
  // Whether RBAC access to the vault is enabled
  rbacAuthorizationEnabled() bool
  // Whether soft delete is enabled for the vault
  enableSoftDelete() bool
  // Whether purge protection is enabled for the vault
  enablePurgeProtection() bool
  // Number of days that deleted vaults and vault objects are retained
  softDeleteRetentionInDays() int
  // Public network access setting ("Enabled" or "Disabled")
  publicNetworkAccess() string
  // Whether the vault can be used for Azure Resource Manager deployment
  enabledForDeployment() bool
  // Whether the vault can be used for Azure Disk Encryption
  enabledForDiskEncryption() bool
  // Whether the vault can be used for Azure Resource Manager template deployment
  enabledForTemplateDeployment() bool
  // Vault SKU name ("standard" or "premium"; premium supports HSM-backed keys)
  skuName() string
  // Vault keys
  keys() []azure.subscription.keyVaultService.key
  // Vault certificates
  certificates() []azure.subscription.keyVaultService.certificate
  // Vault secrets
  secrets() []azure.subscription.keyVaultService.secret
  // Vault diagnostic settings
  diagnosticSettings() []azure.subscription.monitorService.diagnosticsetting
  // Diagnostic settings categories the vault can emit (available log and metric categories)
  diagnosticSettingsCategories() []azure.subscription.monitorService.diagnosticSettingsCategory
  // Auto-rotation enabled status for all keys
  autorotation() []azure.subscription.keyVaultService.key.autorotation
  // Private endpoint connections for the vault
  privateEndpointConnections() []azure.subscription.privateEndpointConnection
  // Vault access policies
  //
  // The vault access policy model, which is only in force when
  // rbacAuthorizationEnabled is false. On a vault using Azure RBAC
  // authorization Azure stores no access policies at all and this list is
  // empty, which does not mean nobody can read the vault. Read
  // roleAssignments for the authorization model in that case.
  accessPolicies() []azure.subscription.keyVaultService.vault.accessPolicy
  // Microsoft Entra role assignments granting access to the vault
  //
  // The effective role assignments at the vault scope, including those
  // inherited from the resource group, subscription, and management-group
  // ancestors. This is where authorization lives when
  // rbacAuthorizationEnabled is true, since Azure RBAC vaults hold no
  // accessPolicies. Together with accessPolicies it answers who can read
  // the keys, secrets, and certificates the vault holds (for example who
  // holds Key Vault Secrets User or Key Vault Administrator).
  roleAssignments() []azure.subscription.authorizationService.roleAssignment
  // Vault network ACL rules
  networkAcls() azure.subscription.keyVaultService.vault.networkAcls
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

