  // Last key rotation timestamp
  lastKeyRotationTimestamp time
  // Provisioning state
  provisioningState string
  // Identity configuration
  //
  // Deprecated in favor of resourceIdentity, which carries the managed
  // identity members as typed fields.
  identity @maturity("deprecated") @replaced_by("azure.subscription.computeService.diskEncryptionSet.resourceIdentity") dict
  // Managed identity attached to the resource
  resourceIdentity azure.subscription.resourceIdentity
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure disk access resource
//
// Private-endpoint configuration that managed disks and
// snapshots can be exported and imported through. Surfaces the
