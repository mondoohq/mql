// Azure Monitor metric alert rule
//
// An alert rule that fires when a resource metric crosses a threshold.
// Surfaces whether the rule is enabled, its severity, the resources it
// watches, how often it evaluates and over what window, and the action
// groups it notifies. Audit these to confirm that critical resources
// have active metric alerting wired to a responder. Select by the
// rule's Azure resource ID.
private azure.subscription.monitorService.metricAlert @defaults("name enabled severity") {
  // ARM resource ID
  id string
  // Rule name
  name string
  // Location
  location string
  // Rule tags
  tags map[string]string
  // Description
  description string
  // Whether the rule is enabled
  enabled bool
  // Severity (0 = Critical through 4 = Verbose)
  severity int
  // Resource IDs the rule monitors
  scopes []string
  // How often the rule evaluates its criteria (ISO 8601 duration)
  evaluationFrequency string
  // Time window over which metrics are aggregated (ISO 8601 duration)
  windowSize string
  // Whether the alert auto-resolves when the condition clears
  autoMitigate bool
  // Resource type of the monitored scopes (set for multi-resource alerts)
  targetResourceType string
  // Region of the monitored scopes (set for multi-resource alerts)
  targetResourceRegion string
  // Alert criteria
  //
  // The threshold conditions. Keys vary by criteria type (single- or multi-resource, static or dynamic thresholds); each condition carries a `metricName`, `operator`, `threshold`, and `timeAggregation`.
  criteria dict
  // When the rule was last updated
  lastUpdatedTime time
  // Action groups notified when the rule fires
  actionGroups() []azure.subscription.monitorService.actionGroup
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

