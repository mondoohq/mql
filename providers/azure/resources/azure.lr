  // this records whether the key material still has to be available.
  encryptionSettingsEnabled bool
  // Version of the guest encryption settings schema
  //
  // Either 1.0 or 1.1. Empty when encryptionSettingsEnabled is false.
  encryptionSettingsVersion string
  // Confidential or trusted-launch protection carried by the snapshot
  //
