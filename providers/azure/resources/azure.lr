// Azure SQL Database server
private azure.subscription.sqlService.server @defaults("name location properties.version properties.state properties.fullyQualifiedDomainName") {
  // SQL Database server ID
  id string
  // SQL Database server name
  name string
  // SQL Database server location
  location string
  // SQL Database server tags
  tags map[string]string
  // SQL Database server type
  type string
  // SQL Database server properties
  properties dict
  // SQL Database server minimum TLS version
  minimalTlsVersion string
  // Public network access state ("Enabled" or "Disabled")
  publicNetworkAccess string
  // Outbound network access restriction state ("Enabled" or "Disabled")
  restrictOutboundNetworkAccess string
  // SQL server version
  version string
  // SQL server state
  state string
  // SQL server fully qualified domain name
  fullyQualifiedDomainName string
  // SQL Database server databases
  databases() []azure.subscription.sqlService.database
  // SQL Database server firewall rules
  firewallRules() []azure.subscription.sqlService.firewallrule
  // SQL Database server IPv6 firewall rules
  //
  // The IPv6 half of the server-level firewall, held in a separate rule
  // list from the IPv4 firewallRules. A dual-stack server can be closed on
  // IPv4 and wide open on IPv6, so both lists have to be read to judge
  // reachability.
  ipv6FirewallRules() []azure.subscription.sqlService.server.ipv6FirewallRule
  // SQL Database server Entra ID administrators
  azureAdAdministrators() []azure.subscription.sqlService.server.administrator
  // SQL Database server administrator login
  administratorLogin string
  // SQL Database server vulnerability assessment settings
  vulnerabilityAssessmentSettings() azure.subscription.sqlService.server.vulnerabilityassessmentsettings
  virtualNetworkRules() []azure.subscription.sqlService.virtualNetworkRule
  // Server key type for the encryption protector ("AzureKeyVault" or "ServiceManaged")
  encryptionProtectorServerKeyType() string
  // Key Vault key used by the encryption protector (null if service-managed)
  encryptionProtectorKey() azure.subscription.keyVaultService.key
  // Whether Azure AD-only authentication is enabled (SQL authentication disabled)
  azureAdOnlyAuthentication() bool
  // Server-wide connection type ("Default", "Proxy", or "Redirect")
  connectionType() string
  // Server-level SQL Auditing (blob auditing) policy
  blobAuditingPolicy() azure.subscription.sqlService.server.blobAuditingPolicy
  // Server-level Transparent Data Encryption (TDE) protector configuration
  encryptionProtectorConfig() azure.subscription.sqlService.server.encryptionProtectorConfig
  // Server-level security alert (threat detection) policy
  securityAlertPolicyConfig() azure.subscription.sqlService.server.securityAlertPolicyConfig
  // Server-level Microsoft Defender for SQL advanced threat protection setting
  advancedThreatProtectionSetting() azure.subscription.sqlService.server.advancedThreatProtectionSetting
  // Server-level Microsoft Entra ID (Azure AD) DevOps audit setting
  devOpsAuditingSetting() azure.subscription.sqlService.server.devOpsAuditingSetting
  // Customer-managed encryption keys (BYOK) registered on the server
  keys() []azure.subscription.sqlService.server.key
  // Outbound firewall rules (allowed FQDNs for data egress)
  outboundFirewallRules() []azure.subscription.sqlService.server.outboundFirewallRule
  // Private Link endpoint connections to the server
  privateEndpointConnections() []azure.subscription.privateEndpointConnection
  // Auto-failover groups configured on the server
  failoverGroups() []azure.subscription.sqlService.server.failoverGroup
  // Geo-replication links from databases on this server to partners
  replicationLinks() []azure.subscription.sqlService.server.replicationLink
  // Whether the SQL server is reachable from the public internet
  //
  // True when `publicNetworkAccess` is enabled AND at least one firewall rule
  // opens the server to the entire public internet. Both rule lists count: an
  // IPv4 rule spanning 0.0.0.0-255.255.255.255 and an IPv6 rule spanning
  // ::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff each open the server on their
  // own. The special "allow all Azure services" rule (0.0.0.0-0.0.0.0) does
  // not count, since it admits only Azure-internal IPs.
  internetReachable() bool
  // Type of managed identity configured on the server
  //
  // One of "SystemAssigned", "UserAssigned", "SystemAssigned,UserAssigned", or "None".
  identityType string
  // Principal ID of the server's system-assigned managed identity; empty when no system-assigned identity is enabled
  principalId string
  // Tenant ID of the server's system-assigned managed identity
  tenantId string
  // Default user-assigned managed identity used by the server (null when none is set)
  primaryUserAssignedIdentity() azure.subscription.managedIdentity
  // Diagnostic settings attached to the server
  diagnosticSettings() []azure.subscription.monitorService.diagnosticsetting
  // Log and metric categories the server can emit
  diagnosticSettingsCategories() []azure.subscription.monitorService.diagnosticSettingsCategory
}

