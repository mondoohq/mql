  // typed fields.
  sku @maturity("deprecated") @replaced_by("azure.subscription.databricksService.workspace.skuData") dict
  // Billable SKU the resource is provisioned at
  skuData azure.subscription.resourceSku
  // Public network access setting ("Enabled" or "Disabled")
  publicNetworkAccess string
  // Whether public IPs are disabled on cluster nodes (Secure Cluster Connectivity / VNet injection)
  enableNoPublicIp bool
  // Whether double encryption (platform-managed key on top of CMK) is enabled for the DBFS root
  requireInfrastructureEncryption bool
  // ARM resource ID of the custom VNet the workspace is injected into (empty if using a managed VNet)
  customVirtualNetworkId string
  // Required NSG rules mode ("AllRules", "NoAzureDatabricksRules", or "NoAzureServiceRules")
  requiredNsgRules string
  // Whether the workspace default storage account is locked behind a firewall ("Enabled" or "Disabled")
  defaultStorageFirewall string
  // Compliance Security Profile status ("Enabled" or "Disabled")
  complianceSecurityProfile string
  // Compliance standards enforced by the Compliance Security Profile
  //
  // For example HIPAA, PCI_DSS, or NONE. Empty when the Compliance Security Profile is disabled.
  complianceStandards []string
  // Enhanced Security Monitoring status ("Enabled" or "Disabled")
  enhancedSecurityMonitoring string
  // Automatic cluster update status ("Enabled" or "Disabled")
  automaticClusterUpdate string
  // Whether Unity Catalog is enabled on the workspace
  //
  // Unity Catalog moves data governance from per-workspace table ACLs
  // to an account-level metastore, so grants are managed centrally
  // rather than inside each workspace.
  isUnityCatalogEnabled bool
  // Compute mode of the workspace ("Serverless" or "Hybrid")
  computeMode string
  // URL clients use to reach the workspace
  //
  // In the form adb-{workspaceId}.{n}.azuredatabricks.net.
  workspaceUrl string
  // Resource ID of the access connector attached to the workspace
  //
  // The managed identity Unity Catalog uses to reach external storage.
  // Empty when no access connector is attached.
  accessConnectorId string
  // Catalog type created with the workspace ("UnityCatalog" or "HiveMetastore")
  //
  // Empty when no default catalog was configured at creation.
  defaultCatalogInitialType string
  // Name of the catalog created with the workspace
  defaultCatalogInitialName string
  // Identity that created the workspace
  //
  // Keyed by `oid` (the Entra object ID), `puid`, and
  // `applicationId`. Null when Azure did not record a creator.
  createdBy dict
  // Identity that last updated the workspace
  //
  // Same shape as createdBy. Null when the workspace has not been
  // updated since creation.
  updatedBy dict
  // ARM resource ID of the managed disk encryption set used for managed disks
  diskEncryptionSetId string
  // Managed resource group ARM resource ID
  managedResourceGroupId string
  // Provisioning state
  provisioningState string
  // Databricks control-plane workspace identifier
  workspaceId string
  // CMK key source for managed disks ("Default" or "Microsoft.Keyvault")
  managedDiskKeySource string
  // Key Vault URI for the managed-disk CMK (empty if platform-managed)
  managedDiskKeyVaultUri string
  // Managed-disk CMK key name
  managedDiskKeyName string
  // Managed-disk CMK key version
  managedDiskKeyVersion string
  // CMK key source for managed services ("Default" or "Microsoft.Keyvault")
  managedServicesKeySource string
  // Key Vault URI for the managed-services CMK (empty if platform-managed)
  managedServicesKeyVaultUri string
  // Managed-services CMK key name
  managedServicesKeyName string
  // Managed-services CMK key version
  managedServicesKeyVersion string
  // When the workspace was created
  creationTime time
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

