  // Admin rules in the collection
  rules() []azure.subscription.networkService.networkManager.securityAdminConfiguration.ruleCollection.rule
}

// Network manager security admin rule
//
// A single security admin rule that allows or denies traffic, taking
// precedence over network security group rules. Surfaces the access
// (Allow, Deny, AlwaysAllow), direction, priority, protocol, and the source
// and destination address prefixes and port ranges. Select by the rule's Azure
// resource ID.
private azure.subscription.networkService.networkManager.securityAdminConfiguration.ruleCollection.rule @defaults("name access direction priority") {
  // Rule ID
  id string
  // Rule name
  name string
  // Rule resource type
  type string
  // Rule etag
  etag string
  // Provisioning state of the rule
  provisioningState string
  // Whether the rule is Custom or Default
  kind string
  // Description of the rule
  description string
  // Access applied to matching traffic (Allow, Deny, AlwaysAllow)
  access string
  // Direction the rule matches (Inbound, Outbound)
  direction string
  // Evaluation priority of the rule; lower numbers are evaluated first
  priority int
  // Network protocol the rule applies to (Tcp, Udp, Icmp, Esp, Ah, Any)
  protocol string
  // Source port ranges the rule matches
  sourcePortRanges []string
  // Destination port ranges the rule matches
  destinationPortRanges []string
  // Source address prefixes; each entry carries addressPrefix and addressPrefixType (IPPrefix, ServiceTag, NetworkGroup)
  sources []dict
  // Destination address prefixes; each entry carries addressPrefix and addressPrefixType (IPPrefix, ServiceTag, NetworkGroup)
  destinations []dict
}

// Network manager connectivity configuration
//
// A configuration that builds hub-and-spoke or mesh connectivity across the
// virtual networks in the targeted network groups. Surfaces the connectivity
// topology, whether the mesh is global, whether existing peerings are removed,
// the hub resources, and the network groups it applies to. Select by the
// configuration's Azure resource ID.
private azure.subscription.networkService.networkManager.connectivityConfiguration @defaults("id name") {
  // Connectivity configuration ID
  id string
  // Connectivity configuration name
  name string
  // Connectivity configuration resource type
  type string
  // Connectivity configuration etag
  etag string
  // Provisioning state of the configuration
  provisioningState string
  // Description of the configuration
  description string
  // Connectivity topology (HubAndSpoke, Mesh)
  connectivityTopology string
  // Whether the mesh connectivity is global across regions
  isGlobal bool
  // Whether existing peerings are removed when the configuration is applied
  deleteExistingPeering bool
  // Network groups the configuration applies to
  appliesToGroups() []azure.subscription.networkService.networkManager.networkGroup
  // Hub resources in the topology; each entry carries resourceId and resourceType
  hubs []dict
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure IP group
//
// A reusable, named collection of IP addresses and CIDR prefixes that firewall
// and firewall-policy rules reference in bulk instead of listing individual
// addresses. Surfaces the contained addresses and prefixes along with the
// firewalls and firewall policies that consume the group. Select by the IP
// group's Azure resource ID.
azure.subscription.networkService.ipGroup @defaults("id name location") {
  // IP group ID
  id string
  // IP group name
  name string
  // IP group location
  location string
