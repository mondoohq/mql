// Log category of a diagnostic setting
//
// One log stream a diagnostic setting can forward, named either by category
// or by category group, together with whether it is turned on and the legacy
// per-setting retention that Azure now manages at the destination instead.
private azure.subscription.monitorService.diagnosticsetting.logSetting @defaults("category categoryGroup enabled") {
  // Whether this log category is forwarded
  enabled bool
  // Diagnostic log category name, empty when the setting names a category group instead
  category string
  // Diagnostic log category group name ("allLogs" or "audit"), empty when the setting names a single category
  //
  // A setting written against a group forwards every category in it,
  // including categories added to the group later, so a group and a
  // hand-listed set of categories are not interchangeable.
  categoryGroup string
  // Whether the legacy per-setting retention policy is enabled
  //
  // Retention is now set on the destination (the storage account or Log
  // Analytics workspace), so this is false on a setting created since
  // that change.
  retentionEnabled bool
  // Days the legacy per-setting retention policy keeps events; 0 keeps them indefinitely
  retentionDays int
}

// Metric category of a diagnostic setting
//
// One metric stream a diagnostic setting can forward, together with whether
// it is turned on, its aggregation interval, and the legacy per-setting
// retention that Azure now manages at the destination instead.
private azure.subscription.monitorService.diagnosticsetting.metricSetting @defaults("category enabled timeGrain") {
  // Whether this metric category is forwarded
  enabled bool
  // Diagnostic metric category name
  category string
  // Aggregation interval of the metric, in ISO 8601 duration form (for example "PT1M")
  timeGrain string
  // Whether the legacy per-setting retention policy is enabled
  //
  // Retention is now set on the destination, so this is false on a
  // setting created since that change.
  retentionEnabled bool
  // Days the legacy per-setting retention policy keeps metrics; 0 keeps them indefinitely
  retentionDays int
}

// Azure Monitor diagnostic settings category
//
// One log or metric category that a resource is capable of emitting
// through diagnostic settings, independent of whether any diagnostic
// setting currently collects it. Comparing the available categories
