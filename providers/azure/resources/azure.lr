  rules []dict
}

// Azure network firewall NAT rule
private azure.subscription.networkService.firewall.natRule @defaults("name action priority") {
  // Firewall NAT rule ID
  id string
  // Firewall NAT rule name
  name string
  // Firewall NAT rule etag
  etag string
  // NAT action applied by this collection ("Dnat" or "Snat")
  action string
  // Evaluation priority of the rule collection; lower numbers are evaluated first
  priority int
  // Individual NAT rules in the collection, each with its name, protocols, source/destination addresses, translated address, and ports
  rules []dict
}

// Azure Firewall policy
//
// Reusable Azure Firewall policy, the rule-set parent that
// firewall instances reference. Surfaces the policy SKU, threat-intel
// mode and allow-list, DNS settings, intrusion detection settings,
// TLS inspection certificate, the explicit-proxy configuration, the
// child policy chain (`basePolicy`), and the rule collection groups
// that hold the actual application/network/NAT rules.
azure.subscription.networkService.firewallPolicy @defaults("id name location") {
  // Firewall policy ID
  id string
  // Firewall policy name
  name string
  // Firewall policy location
  location string
  // Firewall policy tags
  tags map[string]string
  // Firewall policy type
  type string
  // Firewall policy etag
  etag string
  // Firewall policy properties
  properties dict
  // Firewall policy provisioning state
  provisioningState string
  // Threat intelligence filtering mode
  //
  // One of Off, Alert, or Deny. Alert logs traffic to and from domains
  // and addresses Microsoft's feed flags as malicious but still lets it
  // through; only Deny blocks it. Off disables the feed entirely, which
  // is the setting a policy audit is looking for.
  threatIntelMode string
  // Domains exempted from threat intelligence filtering
  //
  // Traffic to these fully qualified domain names bypasses the threat
  // intelligence feed regardless of threatIntelMode, so an entry here
  // is a hole punched through the feed.
  threatIntelAllowedFqdns []string
  // Addresses exempted from threat intelligence filtering
  threatIntelAllowedIpAddresses []string
  // Name of the CA certificate used for TLS inspection
  //
  // Empty when TLS inspection is not configured, in which case the
  // firewall cannot see inside HTTPS traffic and application rules
  // match on SNI alone.
  transportSecurityCertificateName string
  // Key Vault secret ID holding the TLS inspection CA certificate
  //
  // The intermediate CA the firewall signs interception certificates
  // with. Whoever can read this secret can mint certificates every
  // client behind the firewall trusts.
  transportSecurityKeyVaultSecretId string
  // Whether the firewall acts as a DNS proxy
  //
  // When enabled the firewall resolves DNS on behalf of the virtual
  // network, which is what makes FQDN-based network rules resolve
  // consistently. FQDN rules are unreliable without it.
  dnsProxyEnabled bool
  // Whether network rules require the DNS proxy
  dnsRequireProxyForNetworkRules bool
  // Custom DNS servers the policy resolves through
  //
  // Empty when the firewall uses Azure-provided DNS. A custom resolver
  // decides what every FQDN rule evaluates against.
  dnsServers []string
  // Whether explicit proxy mode is enabled
  //
  // When enabled, clients send traffic to the firewall as an HTTP proxy
  // rather than routing through it, which changes which client
  // addresses appear in rule matches.
  explicitProxyEnabled bool
  // Port the explicit proxy listens on for HTTP
  explicitProxyHttpPort int
  // Port the explicit proxy listens on for HTTPS
  explicitProxyHttpsPort int
  // Whether a proxy auto-configuration file is served
  explicitProxyPacFileEnabled bool
  // Location of the proxy auto-configuration file
  //
  // SAS URL of the PAC file clients fetch their proxy configuration
  // from. Empty when no PAC file is configured.
  explicitProxyPacFile string
  // Port the proxy auto-configuration file is served on
  explicitProxyPacFilePort int
  // Whether policy analytics logging is enabled
  //
  // Policy analytics records which rules traffic actually hits, which
  // is what identifies rules that never match and can be removed.
  insightsEnabled bool
  // Days of policy analytics data retained
  insightsRetentionDays int
  // Address ranges excluded from source NAT
  //
  // Traffic to these ranges keeps its original source address instead
  // of being translated to the firewall's. Ranges listed here reach
  // their destination with the client address intact, which is what
  // downstream address-based rules see.
  snatPrivateRanges []string
  // The parent firewall policy from which rules are inherited
  basePolicy() azure.subscription.networkService.firewallPolicy
  // List of child policies this policy is associated with
  childPolicies() []azure.subscription.networkService.firewallPolicy
  // List of firewalls the policy is associated with
  firewalls() []azure.subscription.networkService.firewall
  // Intrusion detection mode (Off, Alert, Deny)
  intrusionDetectionMode() string
  // Intrusion detection profile (Off, Emerging, Core, Extended)
  intrusionDetectionProfile() string
  // IDPS signature overrides (signatures with non-default modes)
  intrusionDetectionSignatureOverrides() []dict
  // IDPS bypass traffic rules
  intrusionDetectionBypassRules() []azure.subscription.networkService.firewallPolicy.idpsBypassRule
  // Rule collection groups that hold the policy's network, NAT, and application rules
  ruleCollectionGroups() []azure.subscription.networkService.firewallPolicy.ruleCollectionGroup
}

// Azure Firewall policy rule collection group
//
// A named, priority-ordered group of rule collections within a firewall
// policy. Each rule collection applies an allow or deny action (filter
// collections) or a DNAT or SNAT translation (NAT collections) to the
// network, application, and NAT rules it holds, so this is where a
// policy's effective traffic rules live. Select by the group's Azure
// resource ID.
private azure.subscription.networkService.firewallPolicy.ruleCollectionGroup @defaults("name priority") {
  // Rule collection group ID
  id string
  // Rule collection group name
  name string
  // Rule collection group etag
  etag string
  // Evaluation priority of the group; lower numbers are evaluated first
  priority int
  // Provisioning state of the rule collection group
  provisioningState string
  // Rule collections in the group
  //
  // Each entry carries ruleCollectionType (FirewallPolicyFilterRuleCollection
  // or FirewallPolicyNatRuleCollection), name, priority, and action, plus a
  // rules list whose shape varies by ruleType: network rules carry
  // ipProtocols, source/destination addresses, and destination ports;
  // application rules carry protocols, source addresses, target FQDNs, and
  // web categories; NAT rules carry the translated address and port.
  ruleCollections []dict
}

// Azure Firewall Policy IDPS bypass traffic rule
private azure.subscription.networkService.firewallPolicy.idpsBypassRule @defaults("name protocol") {
  // Unique ID (firewallPolicyId + rule name)
  id string
  // Rule name
  name string
  // Description of the bypass rule
  description string
  // Protocol (TCP, UDP, ICMP, ANY)
  protocol string
  // Source IP addresses or ranges
  sourceAddresses []string
  // Source IP groups referenced by the bypass rule
  sourceIpGroupRefs() []azure.subscription.networkService.ipGroup
  // Destination IP addresses or ranges
  destinationAddresses []string
  // Destination IP groups referenced by the bypass rule
  destinationIpGroupRefs() []azure.subscription.networkService.ipGroup
  // Destination ports or ranges
  destinationPorts []string
}

