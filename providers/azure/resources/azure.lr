}

// Synapse workspace IP firewall rule
//
// A single allowed IP range on a Synapse workspace, selected by `name`.
// Rules are additive, so the workspace's exposure is the union of every
// rule. The two derived flags distinguish the two ranges that look alike
// but mean very different things: a rule covering all of IPv4, and the
// start-equals-end 0.0.0.0 rule Azure uses to mean "allow Azure
// services".
private azure.subscription.synapseService.workspace.firewallRule @defaults("name startIpAddress endIpAddress") {
  // Rule name
  name string
  // First address of the allowed range
  startIpAddress string
  // Last address of the allowed range
  endIpAddress string
  // Provisioning state of the rule
  provisioningState string
  // Whether the rule allows the entire IPv4 address space
  //
  // True when the range spans 0.0.0.0 to 255.255.255.255, which makes the
  // workspace endpoints reachable from any address on the internet.
  allowsAllIpv4 bool
  // Whether the rule is the "allow Azure services" rule
  //
  // True for the 0.0.0.0 to 0.0.0.0 range, which Azure interprets not as a
  // single host but as permission for Azure-internal services to reach the
  // workspace. It is far narrower than allowsAllIpv4 and the two are
  // commonly confused.
  allowsAzureServices bool
}

// Synapse dedicated SQL pool
//
// A provisioned SQL pool (formerly SQL Data Warehouse) inside a Synapse
// workspace, selected by `name`. Carries the pool's size and lifecycle
// state along with the two controls a data-warehouse audit turns on:
// whether data at rest is encrypted, and whether database activity is
// being recorded.
private azure.subscription.synapseService.workspace.sqlPool @defaults("name status skuName") {
  // Full resource ID of the pool
  id string
  // Pool name
  name string
  // Pool location
  location string
  // Pool tags
  tags map[string]string
  // Performance level of the pool (for example "DW100c")
  skuName string
  // Service tier of the pool
  skuTier string
  // Current status of the pool (for example "Online", "Paused", or "Scaling")
  status string
  // Database collation
  collation string
  // Maximum size of the pool in bytes
  maxSizeBytes int
  // How the pool was created (for example "Default", "Restore", or "Recovery")
  createMode string
  // When the pool was created
  creationDate time
  // Provisioning state of the pool
  provisioningState string
  // Transparent data encryption state
  //
  // One of "Enabled" or "Disabled", or empty when the setting could not be
  // read. Disabled leaves the pool's data files unencrypted at rest.
  transparentDataEncryptionStatus() string
  // Auditing state of the pool
  //
  // One of "Enabled" or "Disabled", or empty when no auditing policy is
  // configured. Without auditing there is no record of queries against the
  // warehouse.
  auditingState() string
  // Days audit records are retained, or 0 for unlimited retention
  auditingRetentionDays() int
}

