// ===== Azure Front Door / CDN Service =====

// Azure Front Door and CDN service
private azure.subscription.frontDoorService {
  // Subscription identifier
  subscriptionId string
  // List of Front Door and CDN profiles
  profiles() []azure.subscription.frontDoorService.profile
