// Azure Virtual Desktop
//
// Azure Virtual Desktop deployment in the subscription and the entry
// point for auditing virtual desktop infrastructure. The `hostPools`
// field lists every host pool, each of which governs RDP redirection
// settings, session limits, public network exposure, and single sign-on
// for the session hosts that deliver desktops and applications to users.
private azure.subscription.desktopVirtualizationService {
  // Subscription identifier
  subscriptionId string
  // Azure Virtual Desktop host pools in the subscription
  hostPools() []azure.subscription.desktopVirtualizationService.hostPool
}

// Azure Virtual Desktop host pool
//
// Group of session hosts that deliver virtual desktops and remote
// applications to users, and the primary control point for the pool's
// security posture. The raw `customRdpProperty` string carries the RDP
// redirection rules (clipboard, drive, and device access) that decide how
// data can move between the session host and the client, while
// `publicNetworkAccess` and `ssoSecretType` govern network reachability
// and how the single sign-on secret is stored. Audit these to confirm a
// pool does not leak data through unrestricted redirection or exposure.
azure.subscription.desktopVirtualizationService.hostPool @defaults("id name location hostPoolType") {
  // Host pool resource ID
  id string
  // Host pool name
  name string
  // Host pool location
  location string
  // Host pool tags
  tags map[string]string
  // Managed identity assigned to the host pool
  //
  // Deprecated in favor of resourceIdentity, which carries the managed
  // identity members as typed fields.
  identity @maturity("deprecated") @replaced_by("azure.subscription.desktopVirtualizationService.hostPool.resourceIdentity") dict
  // Managed identity attached to the resource
  resourceIdentity azure.subscription.resourceIdentity
  // Host pool type ("Personal", "Pooled", or "BYODesktop")
  hostPoolType string
  // Load-balancing algorithm ("BreadthFirst", "DepthFirst", or "Persistent")
  loadBalancerType string
  // Preferred application group type ("Desktop", "RailApplications", or "None")
  preferredAppGroupType string
  // Raw custom RDP property string applied to sessions (redirection and device-access settings)
  customRdpProperty string
  // Maximum number of concurrent sessions allowed per session host
  maxSessionLimit int
  // Assignment model for personal host pools ("Automatic" or "Direct")
  personalDesktopAssignmentType string
  // Whether session-host VMs are started automatically when a user connects
  startVMOnConnect bool
  // Whether the host pool is a validation environment receiving pre-release agent updates
  validationEnvironment bool
  // AD FS authority URL used for single sign-on, if configured
  ssoadfsAuthority string
  // Update ring the host pool belongs to
  ring int
  // Public network access setting
  //
  // Controls whether the host pool is reachable from the public internet.
  // One of "Enabled", "Disabled", "EnabledForSessionHostsOnly", or
  // "EnabledForClientsOnly".
  publicNetworkAccess string
  // How the single-sign-on secret is stored ("SharedKey", "Certificate", "SharedKeyInKeyVault", or "CertificateInKeyVault")
  ssoSecretType string
  // Whether a session-host registration token is currently outstanding
  //
  // A registration token lets any machine holding it join the host pool
  // as a session host. True means one exists and has not expired, so
  // the pool can still be joined by whoever holds the token. The token
  // value itself is deliberately not reported.
  registrationTokenActive bool
  // When the outstanding registration token expires
  //
  // Null when no token has been issued. A time in the past means the
  // token can no longer be used; Azure keeps the record until the token
  // is removed.
  registrationTokenExpirationTime time
  // Most recent registration token operation ("Delete", "None", or "Update")
  registrationTokenOperation string
  // How session host components are updated ("Default" or "Scheduled")
  //
  // Default lets Azure choose when to update the agent, side-by-side
  // stack, and monitoring agent. Scheduled pins updates to the windows
  // in agentUpdateMaintenanceWindows.
  agentUpdateType string
  // Whether agent update windows use each session host's local time
  agentUpdateUseSessionHostLocalTime bool
  // Time zone the agent update windows are expressed in
  agentUpdateMaintenanceWindowTimeZone string
  // Scheduled agent update windows
  //
  // Each entry carries a `dayOfWeek` and an `hour`. Empty when
  // agentUpdateType is Default.
  agentUpdateMaintenanceWindows []dict
  // Host pool description
  description string
  // Host pool friendly name
  friendlyName string
  // Resource ID of the template session-host VMs are built from
  vmTemplate string
  // Number of approved private endpoint connections to the host pool
  privateEndpointConnectionCount int
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure Data Protection
private azure.subscription.dataProtectionService {
  // Subscription identifier
  subscriptionId string
  // Backup vaults in the subscription
  backupVaults() []azure.subscription.dataProtectionService.backupVault
}

// Azure Backup vault
//
// Vault of the Data Protection resource provider, holding backups of disks,
// blobs, database workloads, and Kubernetes clusters. This is a different
// service from the Recovery Services vault modelled as
// `azure.subscription.recoveryServicesService.vault`, and a subscription can
// hold both.
//
// Fields cover the protections that decide whether a backup survives an
// attacker who already holds write access: whether soft delete retains a
// deleted backup and for how long, whether immutability prevents a retention
// policy from being shortened, whether the data is encrypted with a
// customer-managed key on top of infrastructure encryption, and whether
// restores may cross a region or a subscription boundary.
azure.subscription.dataProtectionService.backupVault @defaults("id name location softDeleteState immutabilityState") {
  // Backup vault resource ID
  id string
  // Backup vault name
  name string
  // Azure region the vault lives in
  location string
  // Resource type
  type string
  // Backup vault tags
  tags map[string]string
  // Entity tag of the vault
  etag string
  // Provisioning state ("Succeeded", "Failed", "Provisioning", "Updating", "Unknown", or "Deleting")
  provisioningState string
  // Managed identity configuration
  //
  // Deprecated in favor of resourceIdentity, which carries the managed
  // identity members as typed fields.
  identity @maturity("deprecated") @replaced_by("azure.subscription.dataProtectionService.backupVault.resourceIdentity") dict
  // Managed identity attached to the resource
  resourceIdentity azure.subscription.resourceIdentity
  // User-assigned managed identities associated with the vault
  userAssignedIdentities() []azure.subscription.managedIdentity
  // Soft delete state ("AlwaysOn", "On", or "Off")
  //
  // Soft delete retains a deleted backup for the retention period rather than
  // removing it immediately, so a deletion can be reversed. "AlwaysOn" cannot
  // be turned back off.
  softDeleteState string
  // Days a soft-deleted backup is retained before permanent removal
  softDeleteRetentionPeriodInDays float
  // Immutability state ("Disabled", "Unlocked", or "Locked")
  //
  // Immutability stops a retention policy from being shortened or a backup
  // from being deleted before it expires. "Unlocked" can still be turned off,
  // "Locked" cannot.
  immutabilityState string
  // Encryption state of the vault ("Enabled", "Disabled", or "Inconsistent")
  //
  // Says whether a customer-managed key is in effect. "Inconsistent" means
  // the vault was configured for one but not every backup datastore has
  // picked it up yet.
  encryptionState string
  // Infrastructure encryption state ("Enabled" or "Disabled")
  //
  // A second encryption pass at the storage layer, underneath the vault's own
  // encryption. It can only be set when the vault is created.
  infrastructureEncryption string
  // URI of the Key Vault key encrypting the vault
  //
  // Empty when the vault is encrypted with the platform key rather than a
  // customer-managed one.
  encryptionKeyUri string
  // Key Vault key encrypting the vault
  encryptionKey() azure.subscription.keyVaultService.key
  // Type of identity used to reach the encryption key ("SystemAssigned" or "UserAssigned")
  encryptionKeyIdentityType string
  // User-assigned managed identity used to reach the encryption key
  //
  // Null when the vault authenticates to the key with its system-assigned
  // identity instead.
  encryptionKeyIdentity() azure.subscription.managedIdentity
  // Cross-region restore state ("Enabled" or "Disabled")
  //
  // Empty when the vault carries no explicit setting. When enabled, backups
  // replicate to the paired region and can be restored there while the
  // primary region is unavailable.
  crossRegionRestoreState string
  // Cross-subscription restore state ("Enabled", "Disabled", or "PermanentlyDisabled")
  //
  // Empty when the vault carries no explicit setting, which Azure treats as
  // enabled. When restores are allowed across subscriptions, backup data held
  // here can be recovered into a subscription that does not own the vault.
  // "PermanentlyDisabled" cannot be reversed.
  crossSubscriptionRestoreState string
  // Regions the vault's backup data is replicated to
  replicatedRegions []string
  // Storage redundancy of the vault, by datastore
  //
  // Keys are the datastore the setting applies to ("VaultStore",
  // "OperationalStore", or "ArchiveStore") and values the redundancy in force
  // for it ("LocallyRedundant", "ZoneRedundant", or "GeoRedundant").
  storageRedundancy map[string]string
  // Business continuity and disaster recovery security level ("Excellent", "Good", "Fair", "Poor", or "NotSupported")
  bcdrSecurityLevel string
  // Secure score of the vault ("Maximum", "Adequate", "Minimum", "None", or "NotSupported")
  secureScore string
  // Whether a Resource Guard authorizes destructive operations on the vault
  //
  // A Resource Guard makes deleting the vault or weakening its protections
  // require a second approval outside the vault's own RBAC.
  isVaultProtectedByResourceGuard bool
  // Resource Guard operation requests configured on the vault
  //
  // Each entry pairs a Resource Guard resource ID with the operation it
  // guards.
  resourceGuardOperationRequests []string
  // Whether an alert is raised for every backup job failure ("Enabled" or "Disabled")
  alertsForAllJobFailures string
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure NetApp Files
private azure.subscription.netAppService {
  // Subscription identifier
  subscriptionId string
  // NetApp accounts in the subscription
  accounts() []azure.subscription.netAppService.account
}

// Azure NetApp Files account
//
// Top-level container for Azure NetApp Files in a subscription, holding the
// capacity pools that carry volumes and the Active Directory connections
// those volumes authenticate against. Query an account to read whether its
// data at rest is encrypted with a customer-managed key rather than the
// platform key, which identity reaches that key, and how SMB and LDAP
// traffic to the domain controller is protected.
azure.subscription.netAppService.account @defaults("id name location provisioningState") {
  // Account resource ID
  id string
  // Account name
  name string
  // Azure region the account lives in
  location string
  // Resource type
  type string
  // Account tags
  tags map[string]string
  // Provisioning state
  provisioningState string
  // Managed identity configuration
  //
  // Deprecated in favor of resourceIdentity, which carries the managed
  // identity members as typed fields.
  identity @maturity("deprecated") @replaced_by("azure.subscription.netAppService.account.resourceIdentity") dict
  // Managed identity attached to the resource
  resourceIdentity azure.subscription.resourceIdentity
  // User-assigned managed identities associated with the account
  userAssignedIdentities() []azure.subscription.managedIdentity
  // Domain used for NFSv4 user ID mapping
  //
  // Applies to every non-LDAP NFSv4 volume in the account. Empty when the
  // account uses the service default.
  nfsV4IdDomain string
  // Whether showmount is disabled for volumes under the account
  //
  // Showmount lets any client on the network enumerate the NFS exports a
  // volume offers. True means that enumeration is turned off.
  disableShowmount bool
  // Multi Active Directory status of the account
  multiAdStatus string
  // Encryption settings for data at rest
  encryption() azure.subscription.netAppService.account.encryption
  // Active Directory connections configured on the account
  activeDirectories() []azure.subscription.netAppService.account.activeDirectory
  // Capacity pools in the account
  capacityPools() []azure.subscription.netAppService.account.capacityPool
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure Files
private azure.subscription.fileSharesService {
  // Subscription identifier
  subscriptionId string
  // File shares in the subscription
  fileShares() []azure.subscription.fileSharesService.fileShare
}

// Azure file share
//
// File share of the Microsoft.FileShares resource provider, a standalone
// resource rather than a share hosted inside a storage account. The classic
// kind, which lives under a storage account, is modelled separately as
// `azure.subscription.storageService.account.fileShare`, and a subscription
// can hold both.
//
// Fields cover how the share is reached and what protects the traffic:
// whether it answers on the public endpoint at all, which subnets are
// admitted when access is restricted, whether NFS traffic is encrypted in
// transit, and how root users on mounting clients are squashed.
azure.subscription.fileSharesService.fileShare @defaults("id name location publicNetworkAccess rootSquash") @maturity("preview") {
  // File share resource ID
  id string
  // File share name
  name string
  // Azure region the share lives in
  location string
  // Resource type
  type string
  // File share tags
  tags map[string]string
  // Provisioning state
  //
  // For example "Succeeded", "Failed", "Canceled", "Creating", "Updating",
  // "Deleting", or "TransientFailure".
  provisioningState string
  // File sharing protocol the share is served over ("NFS")
  protocol string
  // Name the share is mounted under
  //
  // The name an end user sees when mounting the share, as it appears in a
  // URI or UNC path. Not necessarily the resource name.
  mountName string
  // Host name the share is reached at
  hostName string
  // Storage media tier of the share ("SSD")
  mediaTier string
  // Redundancy level of the share ("Local" or "Zone")
  redundancy string
  // Public network access to the share ("Enabled" or "Disabled")
  //
  // Disabled means the share is reachable only through a private endpoint.
  // Empty when the share carries no explicit setting.
  publicNetworkAccess string
  // Subnets admitted when public access is restricted
  //
  // Empty when no subnet restriction is configured, which leaves the public
  // endpoint open to any network that can reach it rather than to a chosen
  // set.
  allowedSubnets() []azure.subscription.networkService.subnet
  // Whether NFS traffic to the share must be encrypted in transit ("Enabled" or "Disabled")
  //
  // Empty when the share carries no explicit setting. Disabled leaves NFS
  // traffic readable to anything on the path between client and share.
  encryptionInTransitRequired string
  // Root squash mode for NFS clients ("NoRootSquash", "RootSquash", or "AllSquash")
  //
  // Squashing maps a client's root user to an unprivileged identity.
  // "NoRootSquash" leaves a client that mounts as root holding root on the
  // share, "RootSquash" squashes only root, and "AllSquash" squashes every
  // user.
  rootSquash string
  // Provisioned storage size of the share in GiB
  //
  // Null when the API does not report a provisioned size, which is not the
  // same as a share provisioned at zero.
  provisionedStorageGiB int
  // Provisioned IO per second
  //
  // Null when the API does not report it.
  provisionedIoPerSec int
  // Provisioned throughput in MiB/s
  //
  // Null when the API does not report it.
  provisionedThroughputMibPerSec int
  // Burst IO per second included on top of the provisioned IOPS
  //
  // Null when the API does not report it.
  includedBurstIoPerSec int
  // Maximum burst IOPS credits the share can accumulate
  //
  // Null when the API does not report it.
  maxBurstIoPerSecCredits int
  // Private endpoint connections to the share
  privateEndpointConnections() []azure.subscription.privateEndpointConnection
  // Snapshots of the share
  snapshots() []azure.subscription.fileSharesService.fileShare.snapshot
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure Elastic SAN
private azure.subscription.elasticSanService {
  // Subscription identifier
  subscriptionId string
  // Elastic SANs in the subscription
  elasticSans() []azure.subscription.elasticSanService.elasticSan
}

// Azure Elastic SAN
//
// Block storage array presented over iSCSI to compute in the subscription's
// virtual networks. The SAN itself decides whether it answers on a public
// endpoint at all; the volume groups inside it decide how their data is
// encrypted and which networks may reach them, so an exposure or
// encryption-at-rest review reads both levels.
azure.subscription.elasticSanService.elasticSan @defaults("id name location publicNetworkAccess") {
  // Elastic SAN resource ID
  id string
  // Elastic SAN name
  name string
  // Azure region the SAN lives in
  location string
  // Resource type
  type string
  // Elastic SAN tags
  tags map[string]string
  // Provisioning state ("Invalid", "Succeeded", "Failed", "Canceled", "Pending", "Creating", "Updating", "Deleting", "Restoring", or "Deleted")
  provisioningState string
  // Public network access to the SAN ("Enabled" or "Disabled")
  //
  // Disabled means the SAN answers only through private endpoints on its
  // volume groups. Empty when the SAN carries no explicit setting, which
  // Azure treats as enabled.
  publicNetworkAccess string
  // SKU name of the SAN ("Premium_LRS" or "Premium_ZRS")
  skuName string
  // SKU tier of the SAN
  skuTier string
  // Base provisioned capacity in TiB
  baseSizeTiB int
  // Additional provisioned capacity in TiB
  extendedCapacitySizeTiB int
  // Total provisioned capacity in TiB
  totalSizeTiB int
  // Total capacity allocated to volumes in GiB
  totalVolumeSizeGiB int
  // Total provisioned IOPS
  totalIops int
  // Total provisioned throughput in MB/s
  totalMBps int
  // Number of volume groups in the SAN
  volumeGroupCount int
  // Availability zones the SAN is pinned to
  availabilityZones []string
  // Whether automatic capacity scale-up is enforced ("None" or "Automatic")
  //
  // Empty when the SAN has no auto-scale policy configured.
  autoScalePolicyEnforcement string
  // Capacity in TiB scale-up will not grow the SAN past
  //
  // Null when the SAN has no auto-scale policy configured, which is not the
  // same as a policy that caps growth at zero.
  autoScaleCapacityUnitScaleUpLimitTiB int
  // Capacity in TiB each scale-up step adds
  //
  // Null when the SAN has no auto-scale policy configured.
  autoScaleIncreaseCapacityUnitByTiB int
  // Unused capacity in TiB that triggers a scale-up
  //
  // Null when the SAN has no auto-scale policy configured.
  autoScaleUnusedSizeTiB int
  // Private endpoint connections to the SAN
  privateEndpointConnections() []azure.subscription.privateEndpointConnection
  // Volume groups in the SAN
  volumeGroups() []azure.subscription.elasticSanService.elasticSan.volumeGroup
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Azure Data Box
private azure.subscription.dataBoxService {
  // Subscription identifier
  subscriptionId string
  // Data Box jobs in the subscription
  jobs() []azure.subscription.dataBoxService.job
}

// Azure Data Box job
//
// One physical data transfer between the subscription and Azure, carried on a
// device Microsoft ships. Fields cover how the data on that device is
// protected in transit: whether software double encryption is applied on top
// of the device's hardware encryption, and whether the passkey protecting it
// is Microsoft-managed or held in the customer's own Key Vault.
//
// Jobs exist only while a transfer is in flight and are removed afterwards,
// so this list is empty in most subscriptions most of the time. A check over
// it should say what an empty list means rather than passing by default.
//
// Contact details, shipping addresses, and the SAS keys the job carries for
// chain-of-custody and shipment labels are deliberately not reported.
azure.subscription.dataBoxService.job @defaults("id name status transferType") {
  // Job resource ID
  id string
  // Job name
  name string
  // Azure region the job lives in
  location string
  // Resource type
  type string
  // Job tags
  tags map[string]string
  // Stage the job has reached
  //
  // For example "DeviceOrdered", "DevicePrepared", "Dispatched", "Delivered",
  // "PickedUp", "AtAzureDC", "DataCopy", "Completed", "Cancelled", or
  // "Failed_IssueReportedAtCustomer".
  status string
  // Direction of the transfer ("ImportToAzure" or "ExportFromAzure")
  transferType string
  // How the device is delivered ("NonScheduled" or "Scheduled")
  deliveryType string
  // When the job was started
  startTime time
  // Whether the job can still be cancelled
  isCancellable bool
  // Whether the job can be deleted
  isDeletable bool
  // Whether every device in the job has been reported lost
  allDevicesLost bool
  // Reason the job was cancelled; empty when it was not
  cancellationReason string
  // SKU name of the device ("DataBox", "DataBoxDisk", "DataBoxHeavy", or "DataBoxCustomerDisk")
  skuName string
  // Display name of the device SKU
  skuDisplayName string
  // Family of the device SKU
  skuFamily string
  // Model of the device
  skuModel string
  // Managed identity configuration
  //
  // Deprecated in favor of resourceIdentity, which carries the managed
  // identity members as typed fields.
  identity @maturity("deprecated") @replaced_by("azure.subscription.dataBoxService.job.resourceIdentity") dict
  // Managed identity attached to the resource
  resourceIdentity azure.subscription.resourceIdentity
  // User-assigned managed identities associated with the job
  userAssignedIdentities() []azure.subscription.managedIdentity
  // Kind of job details Azure returned ("DataBox", "DataBoxDisk", "DataBoxHeavy", or "DataBoxCustomerDisk")
  jobDetailsType() string
  // Expected size of the transfer in TB
  expectedDataSizeInTeraBytes() int
  // Software double encryption state ("Enabled" or "Disabled")
  //
  // Double encryption applies a software encryption pass on top of the
  // device's hardware encryption. Empty when the job carries no explicit
  // preference, which Azure treats as disabled.
  doubleEncryption() string
  // Hardware encryption state on the device ("Enabled" or "Disabled")
  hardwareEncryption() string
  // Type of key protecting the device passkey ("MicrosoftManaged" or "CustomerManaged")
  kekType() string
  // URL of the Key Vault key protecting the device passkey
  //
  // Empty when the passkey is Microsoft-managed rather than held in the
  // customer's own Key Vault.
  kekUrl() string
  // Key Vault key protecting the device passkey
  kek() azure.subscription.keyVaultService.key
  // Key Vault holding the key that protects the device passkey
  kekVault() azure.subscription.keyVaultService.vault
  // Code of the datacenter the device is shipped to or from
  dataCenterCode() string
  // Status of the device erasure performed after the transfer
  deviceErasureStatus() string
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Encryption settings of an Azure NetApp Files account
//
// Which key protects the account's data at rest, and which identity is used
// to reach it. keySource is "Microsoft.NetApp" when the platform key is in
// use and "Microsoft.KeyVault" when a customer-managed key is, in which case
// the key, its vault, and the authenticating identity are also reported.
private azure.subscription.netAppService.account.encryption @defaults("keySource keyVaultStatus") {
  // Encryption key source ("Microsoft.NetApp" or "Microsoft.KeyVault")
  keySource string
  // Name of the Key Vault key encrypting the account
  keyName string
  // URI of the Key Vault holding the encryption key
  keyVaultUri string
  // Key Vault key used to encrypt the account
  key() azure.subscription.keyVaultService.key
  // Key Vault holding the encryption key
  vault() azure.subscription.keyVaultService.vault
  // Status of the Key Vault connection ("Created", "InUse", "Deleted", "Error", or "Updating")
  keyVaultStatus string
  // Principal ID of the identity used to reach the Key Vault
  identityPrincipalId string
  // User-assigned managed identity used to reach the Key Vault
  //
  // Null when the account authenticates to the vault with its
  // system-assigned identity instead.
  identity() azure.subscription.managedIdentity
  // Client ID of the multi-tenant application used to reach a cross-tenant Key Vault
  federatedClientId string
}

// Active Directory connection of an Azure NetApp Files account
//
// Domain the account's SMB and LDAP-enabled volumes authenticate against.
// Fields cover how that traffic is protected: whether AES is negotiated for
// SMB, whether the connection to the domain controller is encrypted, and
// whether LDAP is signed and carried over TLS. The privileged group
// memberships the connection grants are also listed, since they decide who
// holds administrator, backup and security-privilege rights on the volumes.
private azure.subscription.netAppService.account.activeDirectory @defaults("activeDirectoryId domain status") {
  // Identifier of the Active Directory connection
  activeDirectoryId string
  // Name of the Active Directory domain
  domain string
  // DNS server IP addresses for the domain, comma separated
  dns string
  // NetBIOS name registered in the domain for the SMB server
  smbServerName string
  // Organizational unit the computer account is created in
  organizationalUnit string
  // Active Directory site domain controller discovery is limited to
  site string
  // Name of the Active Directory machine account used for Kerberos volumes
  adName string
  // KDC server IP address used for Kerberos volumes
  kdcIp string
  // Whether AES encryption is negotiated for SMB communication
  aesEncryption bool
  // Whether traffic between the SMB server and the domain controller is encrypted
  encryptDcConnections bool
  // Whether LDAP traffic is carried over TLS
  ldapOverTls bool
  // Whether LDAP traffic is signed
  ldapSigning bool
  // Whether NFS client local users may access NFS volumes alongside LDAP users
  allowLocalNfsUsersWithLdap bool
  // LDAP search scope
  //
  // Keys `userDN`, `groupDN`, and `groupMembershipFilter`, which narrow the
  // part of the directory the LDAP client searches. Null when the default
  // scope is in use.
