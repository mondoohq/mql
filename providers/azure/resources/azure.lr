private azure.subscription.networkService.firewall.networkRule @defaults("name action priority") {
  // Firewall network rule ID
  id string
  // Firewall network rule name
  name string
  // Firewall network rule etag
  etag string
  // Action applied to traffic matching a rule in this collection ("Allow" or "Deny")
  action string
  // Evaluation priority of the rule collection; lower numbers are evaluated first
  priority int
  // Individual network rules in the collection, each with its name, protocols, source/destination addresses, and ports
  rules []dict
}

// Azure network firewall application rule
private azure.subscription.networkService.firewall.applicationRule @defaults("name action priority") {
  // Firewall application rule ID
