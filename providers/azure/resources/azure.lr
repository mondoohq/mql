}

// Azure Front Door web application firewall policy
//
// Firewall policy attached to a Front Door profile through a security
// policy, governing the requests Front Door forwards to its origins. The
// `mode` field decides whether matching requests are blocked or only
// logged, and the managed rule sets and custom rules carry what is
// actually enforced: a policy in Prevention mode with a current rule set
// can still pass an attack class through, if a rule group override
// disabled the rules that would have caught it or a custom Allow rule
// matched first.
azure.subscription.frontDoorService.wafPolicy @defaults("name mode enabled sku") {
  // Full resource ID of the policy
  id string
  // Policy name
  name string
  // Policy location
  location string
  // Policy tags
  tags map[string]string
  // Front Door tier the policy applies to
  //
  // One of "Classic_AzureFrontDoor", "Standard_AzureFrontDoor", or
  // "Premium_AzureFrontDoor". Managed rule sets and bot protection
  // require the Premium tier, so a Standard policy enforces only its
  // custom rules.
  sku string
  // Enforcement mode
  //
  // "Prevention" blocks matching requests; "Detection" only logs them, so
  // a policy in Detection mode provides visibility and no protection.
  mode string
  // Whether the policy is enabled
  enabled bool
  // Whether managed rules inspect the request body
  requestBodyCheck bool
  // Status code returned when the policy blocks a request
  customBlockResponseStatusCode int
  // Response body returned when the policy blocks a request
  //
  // Base64-encoded, as Azure stores it. Empty when the policy returns the
  // default block page instead of an authored one.
  customBlockResponseBody string
  // URL clients are redirected to when a rule's action is redirect
  redirectUrl string
  // JavaScript challenge cookie lifetime, in minutes (Premium tier)
  javascriptChallengeExpirationInMinutes int
  // CAPTCHA cookie lifetime, in minutes (Premium tier)
  //
  // How long a client stays exempt after solving a CAPTCHA challenge. A
  // long lifetime widens the window in which a solved challenge can be
  // replayed from a stolen cookie.
  captchaExpirationInMinutes int
  // Log scrubbing state, which removes matched fields from firewall logs
  //
  // One of "Enabled" or "Disabled", or empty when no scrubbing is
  // configured. Scrubbing protects sensitive values but also removes them
  // from the record an investigation would rely on.
  logScrubbingState string
