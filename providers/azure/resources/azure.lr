// long a stale answer can survive. `minimumTtl` is the negative-caching
// TTL, so it sets how long a resolver remembers that a name does not
// exist.
private azure.subscription.dnsService.zone.recordSet.soaRecord @defaults("host email serialNumber") {
  // Primary name server for the zone
  host string
  // Email address of the zone administrator, in DNS dotted form
  email string
  // Serial number secondaries compare to detect that the zone changed
  serialNumber int
  // Seconds a secondary waits before checking for a zone update
  refreshTime int
  // Seconds a secondary waits before retrying a failed zone update check
  retryTime int
  // Seconds a secondary keeps serving the zone when it cannot reach the primary
  expireTime int
  // Seconds a resolver caches a negative answer for a name in the zone
  minimumTtl int
}

