// Security rule applied to a network interface after NSG merging
//
// One rule from the merged set across the NSG on an interface, the NSG on its
// subnet, and any application security group rules. `networkSecurityGroup`
// names which NSG in the chain contributed the rule, and `priority` with
// `access` decides it against the others: Azure applies the lowest-priority
// number that matches, so a Deny at a lower number closes an Allow above it.
// Address and port fields come in both a singular and a plural form and Azure
// populates one or the other, so read both; the expanded prefix lists resolve
// service tags and application security groups into the concrete ranges they
// stand for.
private azure.subscription.networkService.interface.effectiveSecurityRule @defaults("name direction access protocol priority") {
  // Rule name, prefixed with defaultSecurityRules/ for the rules Azure supplies
  name string
  // Traffic direction the rule covers: Inbound or Outbound
  direction string
  // Whether the rule permits or blocks matching traffic: Allow or Deny
  access string
  // Protocol the rule covers: Tcp, Udp, or All
  protocol string
  // Evaluation order
  //
  // Lower numbers are evaluated first, and the first matching rule decides the
  // traffic, so a Deny at a lower priority closes an Allow at a higher one.
  priority int
  // Source port range the rule covers, as a single port, a range, or * for any
  sourcePortRange string
  // Source port ranges the rule covers, when the rule states more than one
  sourcePortRanges []string
  // Destination port range the rule covers, as a single port, a range, or * for any
  destinationPortRange string
  // Destination port ranges the rule covers, when the rule states more than one
  destinationPortRanges []string
  // Source the rule covers, as a CIDR block, * for any, or a service tag such as Internet or VirtualNetwork
  sourceAddressPrefix string
  // Sources the rule covers, when the rule states more than one
  sourceAddressPrefixes []string
  // Destination the rule covers, as a CIDR block, * for any, or a service tag
  destinationAddressPrefix string
  // Destinations the rule covers, when the rule states more than one
  destinationAddressPrefixes []string
  // Concrete source ranges the rule resolves to
  //
