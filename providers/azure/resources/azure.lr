  // Security admin configuration etag
  etag string
  // Provisioning state of the configuration
  provisioningState string
  // Description of the configuration
  description string
  // Network intent policy based services the configuration applies on (for example All, None)
  applyOnNetworkIntentPolicyBasedServices []string
  // Rule collections in the configuration
  ruleCollections() []azure.subscription.networkService.networkManager.securityAdminConfiguration.ruleCollection
  // Creation and last-modification provenance recorded by Azure Resource Manager
  systemMetadata() azure.subscription.systemData
}

// Network manager admin rule collection
//
// A priority-ordered set of security admin rules within a security admin
// configuration, applied to one or more network groups. Surfaces the network
// groups the collection applies to and the admin rules it holds. Select by the
// collection's Azure resource ID.
private azure.subscription.networkService.networkManager.securityAdminConfiguration.ruleCollection @defaults("id name") {
  // Rule collection ID
  id string
  // Rule collection name
  name string
  // Rule collection resource type
  type string
  // Rule collection etag
  etag string
  // Provisioning state of the collection
  provisioningState string
  // Description of the collection
  description string
  // Network groups the collection applies to
