import core

option provider = "go.mondoo.com/mql/providers/mssql"
option go_package = "go.mondoo.com/mql/providers/mssql/resources"
option root = "mssql"

// Microsoft SQL Server
//
// Root namespace for all Microsoft SQL Server resources. Query `mssql.server`
// for the connected instance: its version and edition, authentication mode,
// encryption settings, server principals (logins and roles), permissions,
// databases, credentials, linked servers, SQL Agent proxies, audit
// specifications, and surface-area configuration options.
mssql @root {}

// SQL Server instance
//
// A single Microsoft SQL Server installation: the database engine that hosts
// databases and server-level objects. Exposes version and edition metadata,
// the authentication mode (`isMixedModeAuthEnabled`), transport hardening
// (`forceEncryption`, `extendedProtection`, `hideInstance`), the Windows
// service identity (`serviceAccount`, `servicePrincipalNames`), and the full
// set of server principals, permissions, databases, credentials, linked
// servers, proxy accounts, and audits. Surface-area sp_configure options are
// available through `configurations`.
mssql.server @defaults("name version edition") {
  // Configured instance name reported by SERVERPROPERTY('ServerName')
  name string
  // Windows host the instance runs on
  machineName string
  // Instance name, or MSSQLSERVER for the default instance
  instanceName string
  // TCP port the instance listens on
  //
  // Read from sys.dm_exec_connections for the scanning session, so it is the
  // port the instance actually accepts connections on rather than the port the
  // scan dialed (they differ whenever a proxy or container port mapping sits in
  // between). Falls back to the connection's port when the DMV is unavailable.
  port() int
  // Full version banner from @@VERSION
  version @maturity("deprecated") @replaced_by("asset.version") string
  // Product version number, for example 16.0.1000.6
  productVersion string
  // Service pack or cumulative update level
  productLevel string
  // Product edition, for example Enterprise or Developer
  edition string
  // Whether the instance is part of a failover cluster
  isClustered bool
  // Whether mixed-mode (SQL and Windows) authentication is enabled
  //
  // True when both SQL logins and Windows logins may connect. False when only
  // Windows authentication is permitted. Derived as the negation of
  // SERVERPROPERTY('IsIntegratedSecurityOnly').
  isMixedModeAuthEnabled bool
  // Whether the server mandates client-side encryption (Force Encryption)
  //
  // Reads the SuperSocketNetLib\ForceEncryption registry value via
  // xp_instance_regread. Null when the value cannot be read (for example on
  // Linux or without sufficient privileges) rather than a misleading false.
  forceEncryption() bool
  // Extended Protection for Authentication (EPA) setting
  //
  // One of Off, Allowed, or Required. Allowed and Required both defend against
  // authentication relay to the instance. Null when the value cannot be read.
  extendedProtection() string
  // Whether the instance is hidden from SQL Browser broadcasts
  //
  // Reads the SuperSocketNetLib\HideInstance registry value via
  // xp_instance_regread. Null when the value cannot be read.
  hideInstance() bool
  // Windows account the SQL Server service runs as
  serviceAccount() string
  // Security identifier of the SQL Server service account
  //
  // Canonical SID (S-1-5-...) of the Windows service account, resolved via
  // SUSER_SID. Null when the account cannot be resolved (for example on Linux
  // or for a non-domain account). Use it to join the service account to an
  // Active Directory principal.
  serviceAccountSid() string
  // Service principal names registered for this instance
  servicePrincipalNames() []string
  // Maximum number of SQL Server error log files retained
  errorLogFileCount() int
  // Login auditing level
  //
  // One of None, Failed, Successful, or All. Controls which login attempts are
  // written to the SQL Server error log. Read from the AuditLevel registry value.
  loginAuditLevel() string
  // Server configuration options from sp_configure
  configurations() []mssql.server.configuration
  // Server logins (SQL and Windows server principals)
  logins() []mssql.login
  // Server roles (fixed and user-defined)
  roles() []mssql.serverRole
  // Server-level permissions (GRANT and DENY rows)
  permissions() []mssql.permission
  // Databases hosted on the instance
  databases() []mssql.database
  // Server-level credentials
  credentials() []mssql.credential
  // Linked servers configured on this instance
  linkedServers() []mssql.linkedServer
  // SQL Server Agent proxy accounts
  proxyAccounts() []mssql.proxyAccount
  // Server audits defined on the instance
  audits() []mssql.audit
  // Server-level audit specifications
  serverAuditSpecifications() []mssql.auditSpecification
}

// SQL Server configuration option
//
// A single sp_configure server setting, keyed by `name` (for example
// "clr enabled", "Ad Hoc Distributed Queries", or "default trace enabled").
// `valueInUse` is the running value and is what most surface-area audits
// should assert on, since `value` may be a pending change that has not been
// reconfigured. For example
// `mssql.server.configurations.where(name == "clr enabled").first.valueInUse`.
mssql.server.configuration @defaults("name valueInUse") {
  // Option name as reported by sys.configurations
  name string
  // Configured value (may be pending a RECONFIGURE)
  value int
  // Currently running value
  valueInUse int
  // Minimum permitted value
  minimum int
  // Maximum permitted value
  maximum int
  // Whether the option takes effect without a server restart
  isDynamic bool
  // Whether the option is only visible with "show advanced options" enabled
  isAdvanced bool
}

// SQL Server login
//
// A server principal that can be granted server-level permissions and added to
// server roles. Logins are either local to the instance (`SQL_LOGIN`) or mapped
// to a Windows account or group (`WINDOWS_LOGIN`, `WINDOWS_GROUP`), or mapped to
// a certificate or asymmetric key. Select disabled or over-privileged logins,
// verify SQL-login password policy (`isPolicyChecked`, `isExpirationChecked`),
// and follow `databaseUsers` to see where a login lands inside databases.
mssql.login @defaults("name type") {
  // Login name, for example CONTOSO\sqladmin or sa
  name string
  // Principal id the instance uses to reference this login
  principalId int
  // Login type
  //
  // One of SQL_LOGIN, WINDOWS_LOGIN, WINDOWS_GROUP, CERTIFICATE_MAPPED_LOGIN,
  // or ASYMMETRIC_KEY_MAPPED_LOGIN.
  type string
  // Security identifier of the login
  sid string
  // Whether the login is disabled
  isDisabled bool
  // Whether this is a built-in fixed role masquerading as a principal
  isFixedRole bool
  // Default database the login connects to
  defaultDatabase string
  // When the login was created
  createDate time
  // When the login was last modified
  modifyDate time
  // Whether the login maps to an Active Directory principal
  isActiveDirectoryPrincipal bool
  // Name of the Active Directory principal the login maps to
  activeDirectoryPrincipal string
  // SID of the Active Directory principal the login maps to
  activeDirectorySid string
  // Whether Windows password policy is enforced (CHECK_POLICY)
  //
  // Only meaningful for SQL_LOGIN principals. Null for Windows and mapped logins,
  // which do not carry a SQL-managed password.
  isPolicyChecked bool
  // Whether password expiration is enforced (CHECK_EXPIRATION)
  //
  // Only meaningful for SQL_LOGIN principals. Null for Windows and mapped logins.
  isExpirationChecked bool
  // Whether the login must change its password at next login (MUST_CHANGE)
  //
  // Only meaningful for SQL_LOGIN principals. Reads LOGINPROPERTY(name,
  // 'IsMustChange'). Null for Windows and mapped logins.
  mustChange bool
  // When the login's password was last set
  passwordLastSetTime time
  // Server permissions granted or denied directly to this login
  //
  // Direct grants only. Does not include permissions inherited through server
  // role membership.
  explicitPermissions() []mssql.permission
  // Server roles this login is a direct member of
  memberOfRoles() []mssql.serverRole
  // Database users mapped to this login across databases
  databaseUsers() []mssql.databaseUser
}

// SQL Server role
//
// A server principal that bundles server-level permissions. Fixed roles such
// as sysadmin, securityadmin, and public ship with the instance
// (`isFixedRole`); user-defined roles are created by administrators. Follow
// `members` for the logins and roles granted the role, and `explicitPermissions`
// for what the role itself is granted.
mssql.serverRole @defaults("name") {
  // Role name, for example sysadmin or public
  name string
  // Principal id the instance uses to reference this role
  principalId int
  // Whether the role is a built-in fixed role
  isFixedRole bool
  // Principal id that owns the role
  owningPrincipalId int
  // When the role was created
  createDate time
  // When the role was last modified
  modifyDate time
  // Logins and roles that are direct members of this role
  members() []mssql.login
  // Roles this role is itself a direct member of
  memberOfRoles() []mssql.serverRole
  // Server permissions granted or denied directly to this role
  explicitPermissions() []mssql.permission
}

// SQL Server permission grant
//
// A single row from sys.server_permissions or sys.database_permissions
// describing a permission granted or denied to a principal. `state` is GRANT,
// DENY, or GRANT_WITH_GRANT, `permissionName` is the permission (for example
// CONTROL SERVER or CONNECT), and `class` names the securable class the
// permission applies to.
mssql.permission @defaults("permissionName state") {
  // Permission name, for example CONTROL SERVER, IMPERSONATE, or CONNECT
  permissionName string
  // Grant state: GRANT, DENY, or GRANT_WITH_GRANT
  state string
  // Securable class, for example SERVER, DATABASE, or OBJECT_OR_COLUMN
  class string
  // Name of the principal the permission applies to
  granteeName string
}

// SQL Server database
//
// A database hosted on the instance: a collection of schemas, database
// principals (users and roles), and securable objects. Exposes ownership
// (`ownerName`), security-relevant flags (`isTrustworthy`, `isEncrypted` for
// TDE, `containment`, `isAutoCloseOn`), and the database principals,
// permissions, scoped credentials, encryption keys, and CLR assemblies it
// contains. Selected by `name`, for example
// `mssql.server.databases.where(name == "msdb").first`.
mssql.database @defaults("name") {
  // Database name
  name string
  // Database id within the instance
  databaseId int
  // Name of the login that owns the database
  ownerName string
  // Canonical SID (S-1-5-...) of the database owner
  ownerSid string
  // Principal id of the database owner within the instance
  ownerPrincipalId int
  // When the database was created
  createDate time
  // Compatibility level, for example 160 for SQL Server 2022
  compatibilityLevel int
  // Default collation of the database
  collation string
  // Whether the database is read-only
  isReadOnly bool
  // Whether the TRUSTWORTHY property is on
  //
  // When true, principals with control of the database can execute server-level
  // actions in the context of the database owner, allowing privilege escalation
  // if the owner is highly privileged.
  isTrustworthy bool
  // Whether Transparent Data Encryption (TDE) is enabled
  isEncrypted bool
  // Whether AUTO_CLOSE is on
  isAutoCloseOn bool
  // Containment mode: NONE or PARTIAL
  containment string
  // Database state, for example ONLINE or OFFLINE
  stateDesc string
  // Whether Service Broker is enabled
  isBrokerEnabled bool
  // Database users
  users() []mssql.databaseUser
  // Database roles (fixed and user-defined)
  roles() []mssql.databaseRole
  // Application roles defined in the database
  applicationRoles() []mssql.applicationRole
  // Database-level permissions (GRANT and DENY rows)
  permissions() []mssql.permission
  // Database-scoped credentials
  scopedCredentials() []mssql.databaseScopedCredential
  // Symmetric keys defined in the database
  symmetricKeys() []mssql.symmetricKey
  // Asymmetric keys defined in the database
  asymmetricKeys() []mssql.asymmetricKey
  // CLR assemblies registered in the database
  clrAssemblies() []mssql.clrAssembly
  // Database-level audit specifications
  auditSpecifications() []mssql.auditSpecification
  // Backup history recorded for this database
  backups() []mssql.backup
}

// SQL Server database user
//
// A principal scoped to a single database. Users may map to a server login, to
// a Windows account, or exist without a login (contained or loginless users).
// `login` resolves the mapped server login and is null for orphaned or
// loginless users, which is the signal for the CIS orphaned-user check.
// `authenticationType` distinguishes contained-database authentication
// (DATABASE) from instance authentication.
mssql.databaseUser @defaults("name type") {
  // User name within the database
  name string
  // Principal id within the database
  principalId int
  // User type
  //
  // One of SQL_USER, WINDOWS_USER, WINDOWS_GROUP, CERTIFICATE_MAPPED_USER, or
  // ASYMMETRIC_KEY_MAPPED_USER.
  type string
  // Authentication scope: NONE, INSTANCE, DATABASE, or WINDOWS
  authenticationType string
  // Default schema used when the user connects
  defaultSchema string
  // Canonical SID (S-1-5-...) of the user
  sid string
  // Whether the user maps to an Active Directory principal
  isActiveDirectoryPrincipal bool
  // Name of the Active Directory principal the user maps to
  activeDirectoryPrincipal string
  // Canonical SID (S-1-5-...) of the Active Directory principal the user maps to
  activeDirectorySid string
  // When the user was created
  createDate time
  // When the user was last modified
  modifyDate time
  // Server login this user maps to
  //
  // Null when the user has no matching login (an orphaned user) or was created
  // without a login.
  login() mssql.login
  // Database permissions granted or denied directly to this user
  explicitPermissions() []mssql.permission
  // Database roles this user is a direct member of
  memberOfRoles() []mssql.databaseRole
}

// SQL Server database role
//
// A principal that bundles database-level permissions. Fixed roles such as
// db_owner, db_datareader, and public ship with every database
// (`isFixedRole`). Follow `members` for the users and roles granted the role.
mssql.databaseRole @defaults("name") {
  // Role name, for example db_owner or public
  name string
  // Principal id within the database
  principalId int
  // Whether the role is a built-in fixed role
  isFixedRole bool
  // Principal id that owns the role
  owningPrincipalId int
  // When the role was created
  createDate time
  // When the role was last modified
  modifyDate time
  // Users and roles that are direct members of this role
  members() []mssql.databaseUser
  // Roles this role is itself a direct member of
  memberOfRoles() []mssql.databaseRole
  // Database permissions granted or denied directly to this role
  explicitPermissions() []mssql.permission
}

// SQL Server application role
//
// A password-activated database principal not tied to any user. Applications
// activate the role with sp_setapprole to acquire the role's permissions for
// the session. Exposes the role's default schema, timestamps, and the
// permissions granted to it.
mssql.applicationRole @defaults("name") {
  // Application role name
  name string
  // Principal id within the database
  principalId int
  // Principal id that owns the application role
  owningPrincipalId int
  // Default schema used when the role is active
  defaultSchema string
  // When the role was created
  createDate time
  // When the role was last modified
  modifyDate time
  // Database roles this application role is a direct member of
  memberOfRoles() []mssql.databaseRole
  // Database permissions granted or denied directly to this role
  explicitPermissions() []mssql.permission
}

// SQL Server credential
//
// A server-level credential (sys.credentials) that stores an identity and
// secret used to authenticate outside SQL Server, for example to a proxy
// account or an external resource. `mappedLogins` lists the logins this
// credential is attached to.
mssql.credential @defaults("name identity") {
  // Credential name
  name string
  // Identity (typically a Windows account) the credential authenticates as
  identity string
  // When the credential was created
  createDate time
  // When the credential was last modified
  modifyDate time
  // Logins this credential is mapped to
  mappedLogins() []mssql.login
}

// Database-scoped credential
//
// A credential defined within a single database (sys.database_scoped_credentials),
// used by that database to authenticate to external resources such as external
// data sources.
mssql.databaseScopedCredential @defaults("name identity") {
  // Credential name
  name string
  // Identity the credential authenticates as
  identity string
  // When the credential was created
  createDate time
  // When the credential was last modified
  modifyDate time
}

// SQL Server Agent proxy account
//
// A proxy (msdb.dbo.sysproxies) that lets SQL Server Agent job steps run under
// a stored Windows credential. `authorizedLogins` lists the logins permitted to
// use the proxy and `subsystems` lists the job-step subsystems it is enabled
// for. Over-broad proxy authorization is a privilege-escalation path.
mssql.proxyAccount @defaults("name") {
  // Proxy account name
  name string
  // Name of the credential the proxy runs under
  credentialName string
  // Whether the proxy is enabled
  isEnabled bool
  // Whether the msdb public role can use this proxy
  //
  // True when the public role in msdb is granted use of the proxy, which lets
  // any login run job steps under the proxy's stored credential.
  isAccessibleToPublic bool
  // Job-step subsystems the proxy is authorized for, for example CmdExec or PowerShell
  subsystems []string
  // Logins authorized to use the proxy
  authorizedLogins() []mssql.login
}

// SQL Server linked server
//
// A remote data source (sys.servers) that this instance can query through
// distributed queries. `linkedLogins` maps local logins to the remote
// credentials used when the link is traversed, and `isRpcOutEnabled` /
// `isDataAccessEnabled` gate what the link can do. Linked servers configured
// with a highly privileged self-mapping are a lateral-movement path.
mssql.linkedServer @defaults("name product") {
  // Linked server name
  name string
  // Product name of the remote data source, for example SQL Server
  product string
  // OLE DB provider used to reach the remote source
  provider string
  // Data source (connection string endpoint) of the remote server
  dataSource string
  // Whether outbound RPC is enabled on the link
  isRpcOutEnabled bool
  // Whether distributed queries against the link are permitted
  isDataAccessEnabled bool
  // Local-to-remote login mappings for this link
  linkedLogins() []mssql.linkedServer.login
}

// Linked-server login mapping
//
// A single mapping (sys.linked_logins) from a local login to the credential
// used against the remote server. `usesSelfCredential` marks mappings that
// forward the caller's own login rather than a fixed remote account.
mssql.linkedServer.login @defaults("localLogin remoteName") {
  // Local login the mapping applies to, or empty for the default mapping
  localLogin string
  // Remote login name used against the linked server
  remoteName string
  // Whether the caller's own credentials are forwarded to the remote server
  usesSelfCredential bool
}

// SQL Server audit
//
// A server audit object (sys.server_audits) that defines where audit records
// are written and how the instance behaves on audit failure. Audit
// specifications (`mssql.auditSpecification`) reference an audit by
// `name` to determine which events are captured.
mssql.audit @defaults("name isEnabled") {
  // Audit name
  name string
  // Whether the audit is currently running
  isEnabled bool
  // Behavior when a record cannot be written: CONTINUE, SHUTDOWN, or FAIL_OPERATION
  onFailure string
  // Destination of audit records: FILE, APPLICATION_LOG, or SECURITY_LOG
  destination string
}

// SQL Server audit specification
//
// A server-level or database-level specification (sys.server_audit_specifications
// or sys.database_audit_specifications) that binds a set of audited actions to
// an audit. `auditName` names the parent audit, `isEnabled` reports whether the
// specification is active, and `details` lists the audited action groups.
mssql.auditSpecification @defaults("name isEnabled") {
  // Specification name
  name string
  // Whether the specification is enabled
  isEnabled bool
  // Name of the audit this specification writes to
  auditName string
  // Audited action groups mapped to their state
  //
  // Keys are audited action group names (for example SUCCESSFUL_LOGIN_GROUP or
  // FAILED_LOGIN_GROUP) and values are the recorded audit-action state.
  actionGroups map[string]string
}

// SQL Server symmetric key
//
// A symmetric encryption key (sys.symmetric_keys) defined within a database.
// `algorithm` and `keyLength` report the key's cipher and strength, which the
// CIS benchmark checks against a minimum of AES_128.
mssql.symmetricKey @defaults("name algorithm") {
  // Key name
  name string
  // Encryption algorithm, for example AES_256
  algorithm string
  // Key length in bits
  keyLength int
  // When the key was created
  createDate time
}

// SQL Server asymmetric key
//
// An asymmetric encryption key (sys.asymmetric_keys) defined within a database.
// `keyLength` reports the modulus size in bits, which the CIS benchmark checks
// against a minimum of 2048.
mssql.asymmetricKey @defaults("name algorithm") {
  // Key name
  name string
  // Encryption algorithm, for example RSA_2048
  algorithm string
  // Key length in bits
  keyLength int
}

// SQL Server backup record
//
// A single backup set from the instance's backup history
// (msdb.dbo.backupset), selected by `backupSetUuid`. Reports the backup
// `type` (full, differential, or log), whether the backup set is encrypted
// (`isEncrypted` plus the `keyAlgorithm`), and the start and finish times.
// Auditing this surfaces databases whose backups are unencrypted.
mssql.backup @defaults("databaseName type backupFinishDate") {
  // Unique identifier of the backup set
  backupSetUuid string
  // Name of the database the backup was taken from
  databaseName string
  // Backup type, for example DATABASE, DIFFERENTIAL, LOG, or FILE
  type string
  // Whether the backup set is encrypted
  isEncrypted bool
  // Encryption algorithm, or empty when the backup is not encrypted
  keyAlgorithm string
  // Whether this is a copy-only backup
  isCopyOnly bool
  // When the backup started
  backupStartDate time
  // When the backup finished
  backupFinishDate time
}

// SQL Server CLR assembly
//
// A managed-code assembly (sys.assemblies) registered in a database.
// `permissionSet` reports the trust level the assembly runs with; the CIS
// benchmark requires SAFE_ACCESS for all user assemblies, since EXTERNAL_ACCESS
// and UNSAFE grant the assembly access outside the database.
mssql.clrAssembly @defaults("name permissionSet") {
  // Assembly name
  name string
  // Trust level: SAFE_ACCESS, EXTERNAL_ACCESS, or UNSAFE_ACCESS
  permissionSet string
  // Whether the assembly is user-defined rather than a system assembly
  isUserDefined bool
}
